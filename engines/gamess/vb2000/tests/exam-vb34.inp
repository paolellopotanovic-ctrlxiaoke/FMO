! GAMESS/VB2000 Test 34
!
! This illustrates the use of $NOVBPROP by a RHF Hessian
! calculation followed by a VB calculation.
!
 $CONTRL SCFTYP=RHF VBTYP=VB2000 COORD=UNIQUE
   RUNTYP=HESSIAN $END
 $FORCE METHOD=ANALYTIC $END
 $STATPT OPTTOL=0.00001 $END
 $SYSTEM TIMLIM=200 MEMORY=2000000 $END
 $BASIS  GBASIS=N31 NGAUSS=6 $END
 $GUESS  GUESS=HUCKEL $END
 $DATA
Water 6-31G VB2000 Test
C1
O     8.0   0.0000000000   0.0000000000  -0.0349528670
H     1.0   0.0000000000   0.7852216655  -0.5690590902
H     1.0   0.0000000000  -0.7852216655  -0.5690590902
 $END
 $VB2000
#! VB(4)/6-31G PRINTALL 

Water 6-31G VB2000 Test

 $CMAXCUT
 0.05

 $NOVBPROP

 $END



