! GAMESS/VB2000 Test 37
!
! This tests the ability to calculate a VB function and energy at 
! each point of the Intrinsic Reaction Coordinate (IRC) using the 
! standard GAMESS test exam 11 as a start.
!
!   1A' HCN       RHF Intrinsic Reaction Coordinate
!   This job tests the reaction path finder.  The reaction
!   is followed back to the HNC isomer.  Four points on the
!   IRC (counting the saddle point) are found,
!  Pt.   R(N-C)   R(N-H)   A(HNC)     Energy   distance   VB Energy
!  T.S.  1.22136  1.43764  52.993  -91.5648510  0.0      -91.5865970
!   1    1.22533  1.33296  58.476  -91.5673097  0.29994  -91.5867587
!   2    1.22802  1.23827  64.747  -91.5735346  0.59986  -91.5926455
!   3    1.22974  1.16350  72.039  -91.5814775  0.89968  -91.5997184
!
! To make things absolutely clear, the IRC path is still calculated
! at the HF level, but we calculate a VB energy at each IRC point.
! This is similar to work by Peter Karadakov and David Cooper, who
! calculate reaction paths at MP2 or higher and then illustrate the 
! reaction by displaying spin coupled orbitals at each point.
!
! Take a look at exam-vb36 as this uses the same VB data and there
! are more notes there.
!
 $CONTRL SCFTYP=RHF RUNTYP=IRC VBTYP=VB2000 GRDTST=.T. $END
 $IRC    PACE=GS2 SADDLE=.TRUE. TSENGY=.TRUE. 
         FORWRD=.FALSE. NPOINT=14 $END
 $GUESS  GUESS=HUCKEL $END
 $BASIS  GBASIS=STO NGAUSS=3 $END
 $DATA
HYDROGEN CYANIDE...STO-3G...INTRINSIC REACTION COORDINATE
C1
NITROGEN    7.0   -.0004620071    .0002821165    .0000000000
CARBON      6.0   1.2208931990   -.0003427488    .0000000000
HYDROGEN    1.0    .8654562191   1.1478852258    .0000000000
 $END
 $VB2000
#! VB(2)/STO-3G PRINTALL

HYDROGEN CYANIDE...STO-3G..IRC

0 1

 $NOVBPROP

 $DAMPROT
 0.5

 $ROTATION
 3

 $MACROITER
 200

 $ECONV
 7

 $LMOGRPMODIFY
 2
 6,2
 7,1

 $02VBORB
 AO 9
 0.8 AO 11 + 0.2 AO 4

 $VECONLY

 $END
 $HESS
ENERGY IS      -91.5648510306 E(NUC) IS       23.4154954113
 1  1 1.10665699E+00 1.58941062E-02 0.00000000E+00-1.09175970E+00-7.45660744E-03
 1  2 0.00000000E+00-1.48973431E-02-8.43722961E-03 0.00000000E+00
 2  1 1.58941062E-02-2.42593102E-02 0.00000000E+00-6.70422620E-02 1.06160713E-01
 2  2 0.00000000E+00 5.11482160E-02-8.19015341E-02 0.00000000E+00
 3  1 0.00000000E+00 0.00000000E+00-2.03549053E-08 0.00000000E+00 0.00000000E+00
 3  2-1.24975592E-07 0.00000000E+00 0.00000000E+00 6.27416934E-07
 4  1-1.09175970E+00-6.70422620E-02 0.00000000E+00 1.02817225E+00 4.01661646E-02
 4  2 0.00000000E+00 6.35874444E-02 2.68754881E-02 0.00000000E+00
 5  1-7.45660744E-03 1.06160713E-01 0.00000000E+00 4.01661646E-02 1.52947465E-01
 5  2 0.00000000E+00-3.27095315E-02-2.59108001E-01 0.00000000E+00
 6  1 0.00000000E+00 0.00000000E+00-1.24975592E-07 0.00000000E+00 0.00000000E+00
 6  2-1.60761912E-07 0.00000000E+00 0.00000000E+00-4.12640476E-07
 7  1-1.48973431E-02 5.11482160E-02 0.00000000E+00 6.35874444E-02-3.27095315E-02
 7  2 0.00000000E+00-4.86900429E-02-1.84383444E-02 0.00000000E+00
 8  1-8.43722961E-03-8.19015341E-02 0.00000000E+00 2.68754881E-02-2.59108001E-01
 8  2 0.00000000E+00-1.84383444E-02 3.41009491E-01 0.00000000E+00
 9  1 0.00000000E+00 0.00000000E+00 6.27416934E-07 0.00000000E+00 0.00000000E+00
