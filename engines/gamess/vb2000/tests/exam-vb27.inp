! GAMESS/VB2000 Test 27
! This is one of several examples using this system and
! this basis set, but with different GAMESS runs for the
! initial orbitals.
!
! This uses DFT/B3LYP to get the initial VB guess.
!
! R-B3LYP ENERGY IS -76.3775214384 AFTER  15 ITERATIONS
!
! ENERGY AND DIFF OF MACROITER   13 =    -76.0581391871
!
 $CONTRL SCFTYP=RHF COORD=UNIQUE VBTYP=VB2000
  DFTTYP=B3LYP $END
 $SYSTEM TIMLIM=20 MEMORY=2000000 $END
 $BASIS GBASIS=N31 NGAUSS=6 NDFUNC=2 $END
 $GUESS  GUESS=HUCKEL $END
 $DATA
Water 6-31G
C1  
OXYGEN    8.0    0.0000000000    0.0000000000   0.0000000000
HYDROGEN  1.0    0.0000000000    0.7572153434  -0.5865355237
HYDROGEN  1.0    0.0000000000   -0.7572153434  -0.5865355237
 $END
 $VB2000
#! VB(4)/6-31G PRINTALL
 
Water
  
0 1
8    0.0000000000    0.0000000000   0.0000000000
1    0.0000000000    0.7572153434  -0.5865355237
1    0.0000000000   -0.7572153434  -0.5865355237

 $MACROITER
 20

 $ECONV
 8

 $02VBORB
 1->2
 2->1
 1->3
 3->1

 $END

