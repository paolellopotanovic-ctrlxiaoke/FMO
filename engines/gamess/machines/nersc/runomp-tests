#SBATCH -J gamess-omp-tests
#SBATCH -o %x-%j.out
#SBATCH --time 04:00:00
#SBATCH --constraint cpu
#SBATCH --nodes=1
#SBATCH --qos=regular
#SBATCH --account=XXXX

cd $SLURM_SUBMIT_DIR

## Load your module environment
##

OMP_NUM_THREADS=4  ./rungms-dev tests/rimp2grd-mpiomp/Br2.inp 00 4 4 &> tests/rimp2grd-mpiomp/Br2.log
OMP_NUM_THREADS=4  ./rungms-dev tests/rimp2grd-mpiomp/I2.inp 00 4 4 &> tests/rimp2grd-mpiomp/I2.log
