OMP_NUM_THREADS=32  ./rungms-dev tests/rimp2grd-mpiomp/benz_optimize.inp 00 4 4 &> tests/rimp2grd-mpiomp/benz_optimize.log
OMP_NUM_THREADS=32  ./rungms-dev tests/rimp2grd-mpiomp/cor.inp 00 4 4 &> tests/rimp2grd-mpiomp/cor.log
OMP_NUM_THREADS=32  ./rungms-dev tests/rimp2grd-mpiomp/w2o2.hess.ecp.inp 00 4 4 &> tests/rimp2grd-mpiomp/w2o2.hess.ecp.log
OMP_NUM_THREADS=32  ./rungms-dev tests/rimp2grd-mpiomp/c60.inp 00 4 4  &> tests/rimp2grd-mpiomp/c60.log

cd tests
./checkgms.py
./checkgms.py -v -p
