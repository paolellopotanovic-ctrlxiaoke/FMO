module ccsd3a_sum_mod
  implicit none
  public
contains
!*MODULE CCSD3A DECK SUM*
!> @brief Multi-dimensional AXPYs with permutation
!>
!> @author Jun Shen
!> - April, 2018
!>
!> @param K* starting index (per dimension)
!> @param L* ending index (per dimension)
!> @param A,B,C,... double precision array
  subroutine sum12(K1,L1,K2,L2,A,B,C)
!
    integer,intent(in)    :: K2,L1,L2,K1
    real(8),intent(in)    :: C,B(K1+1:L1,K2+1:L2)
    real(8),intent(inout) :: A(K1+1:L1,K2+1:L2)
!
    integer :: I1,I2
!
    forall(I1=K1+1:L1,I2=K2+1:L2)
      A(I1,I2)=A(I1,I2)+C*B(I1,I2)
    endforall
!
  endsubroutine sum12
!
  subroutine sum21(K1,L1,K2,L2,A,B,C)
!
    integer,intent(in)    :: K2,L1,L2,K1
    real(8),intent(in)    :: C,B(K2+1:L2,K1+1:L1)
    real(8),intent(inout) :: A(K1+1:L1,K2+1:L2)
!
    integer :: I1,I2
!
    forall(I1=K1+1:L1,I2=K2+1:L2)
      A(I1,I2)=A(I1,I2)+C*B(I2,I1)
    endforall
!
  endsubroutine sum21
!
  subroutine sum123(K1,L1,K2,L2,K3,L3,A,B,C)
!
    integer,intent(in)    :: K2,K3,L3,L1,L2,K1
    real(8),intent(in)    :: C,B(K1+1:L1,K2+1:L2,K3+1:L3)
    real(8),intent(inout) :: A(K1+1:L1,K2+1:L2,K3+1:L3)
!
    integer :: I3,I1,I2
!
    forall(I1=K1+1:L1,I2=K2+1:L2,I3=K3+1:L3)
      A(I1,I2,I3)=A(I1,I2,I3)+C*B(I1,I2,I3)
    endforall
!
  endsubroutine sum123
!
