C*MODULE DEAEOMDIP DECK DEAEOMDIP_FOCK
C> @brief REFORM THE FOCK MATRIX AND CALCULATE reference energy, IF NREF !=0
C>
C> @author Jun Shen
C>
C> @param EREF ROHF REFERENCE ENERGY
C> @param NREF OPTION TO CHOOSE REFERENCE ORBITALS TO USE
C>
      SUBROUTINE DEAEOMDIP_FOCK(EREF,NREF,NOA)
       use mx_limits, only: mxatm,mxao
       use comm_IOFILE, only: IW,IDAF,IODA
       USE comm_PAR, ONLY: MASWRK
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
C
      IMPLICIT NONE
      INTEGER IA,NOA
      INTEGER NAT,ICH,MUL,NUM,NQMT,NE,NA,NB,IAN
      real*8 ZAN,C,PACK2E
      INTEGER NINTMX,NHEX,NTUPL,INTTYP,IGRDTYP
      INTEGER NPRINT,ITOL,ICUT,NORMF,NORMP,NOPK
      COMMON /IJPAIR/ IA(MXAO)
      COMMON /INFOA / NAT,ICH,MUL,NUM,NQMT,NE,NA,NB,
     *                ZAN(MXATM),C(3,MXATM),IAN(MXATM)
      COMMON /INTFIL/ NINTMX,NHEX,NTUPL,PACK2E,INTTYP,IGRDTYP
      COMMON /OUTPUT/ NPRINT,ITOL,ICUT,NORMF,NORMP,NOPK
      real*8 EREF,TRACEP
      INTEGER NREF,L1,L2,L3,I,II
      real*8,ALLOCATABLE:: BUF(:)
C     real*8,ALLOCATABLE:: IBUF(:)
      INTEGER,ALLOCATABLE:: IBUF(:)
      real*8,ALLOCATABLE:: DEN(:)
      real*8,ALLOCATABLE:: VEC(:,:)
      real*8,ALLOCATABLE:: H1(:)
      real*8,ALLOCATABLE:: FAO(:)
      real*8,ALLOCATABLE:: FMO(:)
      real*8,ALLOCATABLE:: OCC(:)
C
      L1 = NUM
      L2 = (L1*L1+L1)/2
      L3 = L1*L1
      IF(MASWRK)
     &WRITE(IW,'(/1X,A,1X,I3)')'REFORM THE FOCK MATRIX IN AO BASIS WITH'
     &      //' NO. OF OCCUP. ORBS. =',NOA
      CALL FLSHBF(IW)
      ALLOCATE(DEN(L2),SOURCE=0.0D0)
      ALLOCATE(VEC(L1,L1),SOURCE=0.0D0)
      ALLOCATE(OCC(L1),SOURCE=0.0D0)
      DO I = 1,NOA
         OCC(I) = 1.0D0
      ENDDO
      CALL DAREAD(IDAF,IODA,VEC,L3,15,0)
      CALL DMTX(DEN,VEC,OCC,NOA,L1,L1)
      DEALLOCATE(VEC,OCC)
C
      ALLOCATE(H1(L2),SOURCE=0.0D0)
      ALLOCATE(FAO(L2),SOURCE=0.0D0)
      ALLOCATE(FMO(L2),SOURCE=0.0D0)
      CALL DAREAD(IDAF,IODA,H1,L2,11,0)
C
      ALLOCATE(BUF(NINTMX),IBUF(NINTMX))
      II = 0
      DO I = 1,L1
         IA(I) = II
         II = II + I
      ENDDO
      CALL HSTAR(DEN,FAO,BUF,IBUF,NINTMX,IA,NOPK,.FALSE.)
      CALL SYMH(FAO,FMO,IA)
C     CALL VADD(FAO,1,H1,1,FAO,1,L2)
      FAO=FAO*2.0D0+H1
      IF(MASWRK.AND.NPRINT.EQ.5)THEN
       WRITE(IW,*) 'REFORMED ALPHA/BETA FOCK MATRIX (AO BASIS)'
       CALL PRTRIL(FAO,L1)
       WRITE(IW,'()')
      ENDIF
      EREF = EREF+TRACEP(DEN,H1,L1) + TRACEP(DEN,FAO,L1)
      IF(MASWRK)THEN
       IF(NREF.GT.0)THEN
        WRITE(IW,'(1X,A,1X,F14.9)')
     * 'SINGLET N-2 ELECTRON REFERENCE ENERGY =',EREF
       ELSEIF(NREF.LT.0)THEN
        WRITE(IW,'(1X,A,1X,F14.9)')
     * 'SINGLET N+2 ELECTRON REFERENCE ENERGY =',EREF
       ENDIF
      ENDIF
      CALL DAWRIT(IDAF,IODA,FAO,L2,14,0)
      CALL DAWRIT(IDAF,IODA,FAO,L2,18,0)
      DEALLOCATE(BUF,IBUF)
      DEALLOCATE(DEN,H1,FAO)
C
      END
