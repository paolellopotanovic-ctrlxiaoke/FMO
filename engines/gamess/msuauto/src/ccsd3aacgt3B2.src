       call reorder2431(N0,N2,N0,N2,N0,N2,N2,N3,
     & N0,N2,N2,N3,N0,N2,N0,N2,S124,D1)
       allocate(B2(N0+1:N2,N2+1:N3))
       call reorder21(N2,N3,N0,N2,
     & N0,N2,N2,N3,t1B,B2)
       allocate(Q30(N0+1:N2,N0+1:N2))
       I1=K2*K2
       I3=K4*K2
       call EGEMM1(I1,I3,D1,B2,Q30)
       deallocate(D1)
       deallocate(B2)
C
       X10=X10-Q30
       deallocate(Q30)
C
       call
     &sum21(N0,N2,N0,N2,X10,FBHH, 1.0_dp)
C
       allocate(F2(N0+1:N2,N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       call reorder412356(N2,N3,N1,N3,N1,N3,N0,N2,N0,N1,N0,N1,
     & N0,N2,N2,N3,N1,N3,N1,N3,N0,N1,N0,N1,t3B,F2)
       allocate(Z10(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N2))
       I1=K2
       I2=K1*K1*K3*K3*K4
       I3=K2
       call EGEMM(I1,I2,I3,X10,F2,Z10)
       deallocate(F2)
C
       forall(i=N0+1:N1,j=N0+1:N1,j>i)
         forall(a=N1+1:N3,b=N1+1:N3,b>a)
           forall(k=N0+1:N2,c=N2+1:N3)
             V3B(c,b,a,k,j,i)= V3B(c,b,a,k,j,i)
     &                    -Z10(c,b,a,j,i,k)
           endforall
         endforall
       endforall
       deallocate(Z10)
       deallocate(X10)
C
       allocate(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       call reorder3142(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       allocate(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       call reorder3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,t2C,D2)
       allocate(S77(N2+1:N3,N0+1:N2,N0+1:N2,N2+1:N3))
       I1=K4*K2
       I2=K2*K4
       I3=K4*K2
       call EGEMM(I1,I2,I3,D1,D2,S77)
       deallocate(D1)
       deallocate(D2)
C
       call
     &sum3412(N0,N2,N2,N3,N2,N3,N0,N2,X17,S77,-1.0_dp)
       deallocate(S77)
C
       call
     &sum2431(N0,N2,N2,N3,N2,N3,N0,N2,X17,VCHPHP, 1.0_dp)
C
       allocate(F2(N0+1:N2,N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       call reorder412356(N2,N3,N1,N3,N1,N3,N0,N2,N0,N1,N0,N1,
     & N0,N2,N2,N3,N1,N3,N1,N3,N0,N1,N0,N1,t3B,F2)
       allocate(Z17(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1,N2+1:N3,N0+1:N2))
       I1=K2*K4
       I2=K1*K1*K3*K3
       I3=K4*K2
       call EGEMM(I1,I2,I3,X17,F2,Z17)
       deallocate(F2)
C
       forall(i=N0+1:N1,j=N0+1:N1,j>i)
         forall(a=N1+1:N3,b=N1+1:N3,b>a)
           forall(k=N0+1:N2,c=N2+1:N3)
             V3B(c,b,a,k,j,i)= V3B(c,b,a,k,j,i)
     &                    -Z17(b,a,j,i,c,k)
           endforall
         endforall
       endforall
       deallocate(Z17)
       deallocate(X17)
C
       allocate(D1(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1))
       call reorder3412(N2,N3,N0,N1,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N0,N1,VBHHHP,D1)
       allocate(D2(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       call reorder3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,t2B,D2)
       allocate(S53(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1))
       I1=K1*K4
       I2=K3*K4
       I3=K1*K2
       call EGEMM(I1,I2,I3,D1,D2,S53)
       deallocate(D1)
       deallocate(D2)
C
       call
     &sum2314(N2,N3,N2,N3,N1,N3,N0,N1,X6,S53, 1.0_dp)
       deallocate(S53)
C
       call
     &sum2314(N2,N3,N2,N3,N1,N3,N0,N1,X6,VBHPPP, 1.0_dp)
C
       allocate(Z6(N1+1:N3,N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K4
       I2=K1*K2*K3
       I3=K4
       call EGEMM(I1,I2,I3,X6,t2B,Z6)
C
       forall(i=N0+1:N1,j=N0+1:N1,j>i)
         forall(a=N1+1:N3,b=N1+1:N3,b>a)
           forall(k=N0+1:N2,c=N2+1:N3)
             V3B(c,b,a,k,j,i)= V3B(c,b,a,k,j,i)
     &                    -Z6(a,k,j,c,b,i)
     &                    +Z6(b,k,j,c,a,i)
     &                    +Z6(a,k,i,c,b,j)
     &                    -Z6(b,k,i,c,a,j)
           endforall
         endforall
       endforall
       deallocate(Z6)
       deallocate(X6)
C
       end
C
       subroutine t3B_update(N0,N1,N2,N3,shift,
     & K3,K4,NFT848,
     & FAHH,FAPP,FBHH,FBPP,
     & t1A,t1B,t2A,t2B,t3B,V3B)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       integer a,b,c,e,f,g,h,i,j,k,m,n,o,p
       real*8 CoeLeft,shift,PP
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 t1A(N1+1:N3,N0+1:N1)
       real*8 t1B(N2+1:N3,N0+1:N2)
       real*8 t2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 t2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 t3B(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1)
       real*8 V3B(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1)
C
       real*8,allocatable::VPPP(:,:,:),C2(:,:,:)
       real*8,allocatable::tt3B(:,:,:,:)
       real*8,allocatable::U(:,:,:)
C
       N3B=0
       do i=N0+1,N1-1;do j=i+1,N1;do k=N0+1,N2
        N3B=N3B+1
       enddo;enddo;enddo
       allocate(tt3B(N1+1:N3,N1+1:N3,N2+1:N3,N3B))
       tt3B=0.0d0
       I3B=0
       do i=N0+1,N1-1;do j=i+1,N1;do k=N0+1,N2
        I3B=I3B+1
        do c=N2+1,N3;do e=N1+1,N3;do f=N1+1,N3
         tt3B(f,e,c,I3B)=0.5d0*t3B(c,f,e,k,j,i)
     &                  +t1A(e,i)*t2B(c,f,k,j)
     &                  +t1A(f,j)*t2B(c,e,k,i)
        enddo;enddo;enddo
       enddo;enddo;enddo
C
       allocate(VPPP(N1+1:N3,N1+1:N3,N1+1:N3),
     &          source=0.0d0)
       do a=N1+1,N3-1
        read(NFT848,rec=a-N1)VPPP
        allocate(C2(N1+1:N3,N1+1:N3,a+1:N3))
        do b=a+1,N3;do e=N1+1,N3;do f=N1+1,N3
         C2(f,e,b)=VPPP(f,e,b)
        enddo;enddo;enddo
C
        allocate(U(a+1:N3,N2+1:N3,N3B))
        I1=N3B*K4
        I2=N3-a
        I3=K3*K3
        call EGEMM(I1,I2,I3,tt3B,C2,U)
        I3B=0
        do i=N0+1,N1-1;do j=i+1,N1;do k=N0+1,N2
         I3B=I3B+1
         do b=a+1,N3;do c=N2+1,N3
           V3B(c,b,a,k,j,i)=V3B(c,b,a,k,j,i)+U(b,c,I3B)
         enddo;enddo
        enddo;enddo;enddo
       deallocate(C2,U)
       enddo
       deallocate(tt3B,VPPP)
C
       allocate(tt3B(N2+1:N3,N1+1:N3,N1+1:N3,N3B))
       tt3B=0.0d0
       I3B=0
       do i=N0+1,N1-1;do j=i+1,N1;do k=N0+1,N2
        I3B=I3B+1
        do a=N1+1,N3;do e=N1+1,N3;do f=N2+1,N3
         tt3B(f,e,a,I3B)=t3B(f,e,a,k,j,i)
     &                  -t1A(e,i)*t2B(f,a,k,j)
     &                  +t1A(e,j)*t2B(f,a,k,i)
     &                  +t1B(f,k)*t2A(e,a,j,i)
        enddo;enddo;enddo
       enddo;enddo;enddo
C
       I1=N3B*K3
       I2=K3
       I3=K3*K4
       allocate(VPPP(N2+1:N3,N1+1:N3,N1+1:N3),
     &          source=0.0d0)
       allocate(U(N1+1:N3,N1+1:N3,N3B))
       do c=N2+1,N3
        read(NFT848,rec=c-N2+K3+K4)
     &  (((VPPP(f,e,b),e=N1+1,N3),f=N2+1,N3),b=N1+1,N3)
C
        call EGEMM(I1,I2,I3,tt3B,VPPP,U)
        I3B=0
        do i=N0+1,N1-1;do j=i+1,N1;do k=N0+1,N2
         I3B=I3B+1
!        do a=N1+1,N3;do b=N1+1,N3
         do a=N1+1,N3-1;do b=a+1,N3
          V3B(c,b,a,k,j,i)=V3B(c,b,a,k,j,i)+U(b,a,I3B)
     &                                     -U(a,b,I3B)
         enddo;enddo
        enddo;enddo;enddo
       enddo
       deallocate(tt3B,VPPP,U)
C
       do i=N0+1,N1-1;do j=i+1,N1;do k=N0+1,N2
       do a=N1+1,N3-1;do b=a+1,N3;do c=N2+1,N3
        CoeLeft=FBPP(c,c)+FAPP(b,b)+FAPP(a,a)
     &         -FBHH(k,k)-FAHH(j,j)-FAHH(i,i)
     &         +shift
        t3B(c,b,a,k,j,i)= t3B(c,b,a,k,j,i)-V3B(c,b,a,k,j,i)/CoeLeft
        t3B(c,b,a,K,i,j)=-t3B(c,b,a,K,j,i)
        t3B(c,a,b,K,j,i)=-t3B(c,b,a,K,j,i)
        t3B(c,a,b,K,i,j)= t3B(c,b,a,K,j,i)
       enddo;enddo;enddo
       enddo;enddo;enddo
C
       end
