module ccsd3a_reorder_mod
  implicit none
  public
contains
!*MODULE CCSD3A DECK REORDER*
!> @brief Multi-dimensional transpositions
!>
!> @author Jun Shen
!> - April, 2018
!>
!> @param M* starting index (per dimension)
!> @param N* ending index (per dimension)
!> @param K* starting index (per dimension)
!> @param L* ending index (per dimension)
!> @param A,B,C,... double precision array
  subroutine reorder12(M1,N1,M2,N2,K1,L1,K2,L2,A,B)
!
    integer,intent(in)    :: L2,K1,K2,N1,N2,M1,L1,M2
    real(8),intent(in)    :: A(M1+1:N1,M2+1:N2)
    real(8),intent(out)   :: B(K1+1:L1,K2+1:L2)
!
    integer :: I1,I2
!
    forall(I1=K1+1:L1,I2=K2+1:L2)
      B(I1,I2)=A(I1,I2)
    endforall
!
  endsubroutine reorder12
!
  subroutine reorder21(M1,N1,M2,N2,K2,L2,K1,L1,A,B)
!
    integer,intent(in)    :: L2,K2,K1,N1,N2,M1,L1,M2
    real(8),intent(in)    :: A(M1+1:N1,M2+1:N2)
    real(8),intent(out)   :: B(K2+1:L2,K1+1:L1)
!
    integer :: I1,I2
!
    forall(I1=K1+1:L1,I2=K2+1:L2)
      B(I2,I1)=A(I1,I2)
    endforall
!
  endsubroutine reorder21
!
  subroutine reorder123(M1,N1,M2,N2,M3,N3,K1,L1,K2,L2,K3,L3,A,B)
!
    integer,intent(in)    :: N3,L2,K1,K2,N1,N2,M1,M3,L1,L3,M2,K3
    real(8),intent(in)    :: A(M1+1:N1,M2+1:N2,M3+1:N3)
    real(8),intent(out)   :: B(K1+1:L1,K2+1:L2,K3+1:L3)
!
    integer :: I1,I3,I2
!
    forall(I1=K1+1:L1,I2=K2+1:L2,I3=K3+1:L3)
      B(I1,I2,I3)=A(I1,I2,I3)
    endforall
!
  endsubroutine reorder123
!
  subroutine reorder132(M1,N1,M2,N2,M3,N3,K1,L1,K3,L3,K2,L2,A,B)
!
    integer,intent(in)    :: N3,K1,K2,L2,N1,N2,M1,M3,L1,L3,M2,K3
    real(8),intent(in)    :: A(M1+1:N1,M2+1:N2,M3+1:N3)
    real(8),intent(out)   :: B(K1+1:L1,K3+1:L3,K2+1:L2)
!
    integer :: I1,I3,I2
!
    forall(I1=K1+1:L1,I2=K2+1:L2,I3=K3+1:L3)
      B(I1,I3,I2)=A(I1,I2,I3)
    endforall
!
  endsubroutine reorder132
