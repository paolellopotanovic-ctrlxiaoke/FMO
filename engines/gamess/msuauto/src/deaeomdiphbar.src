     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HCHHHP
        WRITE(NFT891,REC=15)((((V1B3D(A,K,J,I)+VCHHHP(A,I,K,J),
     & J=N0+1,N2),K=N0+1,N2),I=N0+1,N2),A=N2+1,N3)
       DEALLOCATE(V1B3D)
C
       ALLOCATE(V1B3D(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
C
       CALL HBAR1B3D(N0,N1,N2,N3,V1B3D,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
C
!HCHPHH
        WRITE(NFT891,REC=11)((((-V1B3D(A,K,J,I)+VCHHHP(A,I,K,J),
     & J=N0+1,N2),K=N0+1,N2),I=N0+1,N2),A=N2+1,N3)
       DEALLOCATE(V1B3D)
C
!HCHHPP=VCHHPP
C
       ALLOCATE(V2C2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
C
       CALL HBAR2C2C(N0,N1,N2,N3,V2C2C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HCHPHP
         WRITE(NFT892,REC=2)((((-V2C2C(B,A,J,I)+VCHPHP(B,I,A,J),
     & A=N2+1,N3),I=N0+1,N2),B=N2+1,N3),J=N0+1,N2)
       DEALLOCATE(V2C2C)
C
       ALLOCATE(V3D1B(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2),SOURCE=0.0D0)
C
       CALL HBAR3D1B0(N0,N1,N2,N3,V3D1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HCHPPP
       WRITE(NFT892,REC=12)((((-V3D1B(C,B,A,I)+VCHPPP(C,B,A,I),
     & I=N0+1,N2),C=N2+1,N3),B=N2+1,N3),A=N2+1,N3)
       DEALLOCATE(V3D1B)
C
       ALLOCATE(V3D1B(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2),SOURCE=0.0D0)
C
       CALL HBAR3D1B(NFT848,N0,N1,N2,N3,V3D1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
C
!HCPPHP
        WRITE(NFT892,REC=8)((((V3D1B(C,B,A,I)+VCHPPP(C,A,B,I),
     & A=N2+1,N3),C=N2+1,N3),B=N2+1,N3),I=N0+1,N2)
       DEALLOCATE(V3D1B)
C
       ALLOCATE(V4E0A(N2+1:N3,N2+1:N3,N2+1:N3))
       DO A=N2+1,N3
       READ(NFT848,REC=A-N2+K3)V4E0A
C
       CALL HBAR4E0A(N0,N1,N2,N3,V4E0A,A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HCPPPP
       WRITE(NFT899,REC=A-N2+K3)V4E0A
       ENDDO
       DEALLOCATE(V4E0A)
      IF(MASWRK)WRITE(IO,*)'H2C FINISHED'
       CALL FLSHBF(IO)
C
2000   IF(MASWRK)WRITE(IO,*)'DELETE 1e- AND 2e- INTEGER FILES '
       CLOSE(NFT820,STATUS='DELETE')
       CLOSE(NFT821,STATUS='DELETE')
       CLOSE(NFT822,STATUS='DELETE')
       CLOSE(NFT826,STATUS='DELETE')
       CLOSE(NFT827,STATUS='DELETE')
       CLOSE(NFT828,STATUS='DELETE')
       CLOSE(NFT831,STATUS='DELETE')
       CLOSE(NFT832,STATUS='DELETE')
       CLOSE(NFT834,STATUS='DELETE')
       CLOSE(NFT835,STATUS='DELETE')
       CLOSE(NFT836,STATUS='DELETE')
       CLOSE(NFT837,STATUS='DELETE')
       CLOSE(NFT838,STATUS='DELETE')
       CLOSE(NFT839,STATUS='DELETE')
       CLOSE(NFT848,STATUS='DELETE')
C
       END
C
C*MODULE DEAEOMDIP DECK GAMESS_READ
C> @brief READ CCSD cluster components from NFT825
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param T1A one-body alpha CCSD cluster components
C> @param T1B one-body beta CCSD cluster components
C> @param T2A two-body alpha-alpha CCSD cluster components
C> @param T2B two-body alpha-beta CCSD cluster components
C> @param T2C two-body beta-beta CCSD cluster components
C>
       SUBROUTINE GAMESS_READ(IO,NFT825,N0,N1,N2,N3,T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
      LOGICAL GOPARR,DSKWRK,MASWRK
      INTEGER ME,MASTER,NPROC,IBTYP,IPTIM
      COMMON /PAR   / ME,MASTER,NPROC,IBTYP,IPTIM,GOPARR,DSKWRK,MASWRK
C
       READ(NFT825,REC=1)((T1A(A,I),
     & I=N0+1,N1),A=N1+1,N3)
       READ(NFT825,REC=2)((T1B(A,I),
     & I=N0+1,N2),A=N2+1,N3)
       READ(NFT825,REC=3)(((( T2A(B,A,J,I),
     & I=N0+1,N1),A=N1+1,N3),B=N1+1,N3),J=N0+1,N1)
       READ(NFT825,REC=4)(((( T2C(B,A,J,I),
     & I=N0+1,N2),A=N2+1,N3),B=N2+1,N3),J=N0+1,N2)
       READ(NFT825,REC=5)((((T2B(B,A,J,I),
     & I=N0+1,N1),A=N1+1,N3),B=N2+1,N3),J=N0+1,N2)
C
       IF(IO.EQ.0)RETURN
       IF(.NOT.MASWRK)RETURN
C
       WRITE(IO,*)'THE LARGEST T1 AND T2 AMPLITUDES ARE'
       TOL=2.5D-2
       DO I=N0+1,N1;DO A=N1+1,N3
        IF(DABS(T1A(A,I)).LE.TOL)CYCLE
        WRITE(IO,101)'T1= ',T1A(A,I),'FOR IA -> AA =',I,A
       ENDDO;ENDDO
       DO I=N0+1,N2;DO A=N2+1,N3
        IF(DABS(T1B(A,I)).LE.TOL)CYCLE
        WRITE(IO,101)'T1= ',T1B(A,I),'FOR IB -> AB =',I,A
       ENDDO;ENDDO
       DO I=N0+1,N1-1;DO J=I+1,N1; DO A=N1+1,N3-1; DO B=A+1,N3
        IF(DABS(T2A(B,A,J,I)).LE.TOL)CYCLE
        WRITE(IO,102)'T2= ',T2A(B,A,J,I),'FOR IA,JA -> AA,BA =',I,J,A,B
       ENDDO;ENDDO;ENDDO;ENDDO
       DO I=N0+1,N2-1;DO J=I+1,N2; DO A=N2+1,N3-1; DO B=A+1,N3
        IF(DABS(T2C(B,A,J,I)).LE.TOL)CYCLE
        WRITE(IO,102)'T2= ',T2C(B,A,J,I),'FOR IB,JB -> AB,BB =',I,J,A,B
       ENDDO;ENDDO;ENDDO;ENDDO
       DO I=N0+1,N1;DO J=N0+1,N2; DO A=N1+1,N3; DO B=N2+1,N3
        IF(DABS(T2B(B,A,J,I)).LE.TOL)CYCLE
        WRITE(IO,102)'T2= ',T2B(B,A,J,I),'FOR IA,JB -> AA,BB =',I,J,A,B
       ENDDO;ENDDO;ENDDO;ENDDO
101    FORMAT(1X,A,F15.10,1X,A,2I3)
102    FORMAT(1X,A,F15.10,1X,A,4I3)
C
      END
C
C*MODULE DEAEOMDIP DECK HBAR0A2A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR0A2A(N0,N1,N2,N3,V0A2A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V0A2A(N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::Q4(:,:)
       real*8,ALLOCATABLE::Q8(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:)
       real*8,ALLOCATABLE::U2(:,:)
       real*8,ALLOCATABLE::U3(:,:)
       real*8,ALLOCATABLE::U6(:,:)
       real*8,ALLOCATABLE::U7(:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q4(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q4)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N1+1:N3,N0+1:N1),SOURCE=0.0D0)
       X1=X1+Q4
       DEALLOCATE(Q4)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q8(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q8)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q8
       DEALLOCATE(Q8)
C
       X1=X1+FAHP
C
       ALLOCATE(U1(N0+1:N1,N0+1:N1))
       I1=K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,X1,T1A,U1)
C
       V0A2A=V0A2A+U1
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1))
       CALL REORDER3124(N1,N3,N0,N1,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N1,N0,N1,VAHHHP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N0+1:N1,N0+1:N1))
       I1=K1*K1
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V0A2A=V0A2A+U2
       DEALLOCATE(U2)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U3(N0+1:N1,N0+1:N1))
       I1=K1
       I2=K1
       I3=K3*K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       V0A2A=V0A2A+0.5_dp*U3
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N1,N0+1:N1))
       CALL REORDER3124(N2,N3,N0,N1,N0,N2,N0,N1,
     & N0,N2,N2,N3,N0,N1,N0,N1,VBHHHP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U6(N0+1:N1,N0+1:N1))
       I1=K1*K1
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,U6)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V0A2A=V0A2A+U6
       DEALLOCATE(U6)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U7(N0+1:N1,N0+1:N1))
       I1=K1
       I2=K1
       I3=K3*K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U7)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       V0A2A=V0A2A+U7
       DEALLOCATE(U7)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR0A2C
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR0A2C(N0,N1,N2,N3,V0A2C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V0A2C(N0+1:N2,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::Q4(:,:)
       real*8,ALLOCATABLE::Q8(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:)
       real*8,ALLOCATABLE::U2(:,:)
       real*8,ALLOCATABLE::U3(:,:)
       real*8,ALLOCATABLE::U6(:,:)
       real*8,ALLOCATABLE::U7(:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q4(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q4)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N2+1:N3,N0+1:N2),SOURCE=0.0D0)
       X1=X1+Q4
       DEALLOCATE(Q4)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q8(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q8)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q8
       DEALLOCATE(Q8)
C
       X1=X1+FBHP
C
       ALLOCATE(U1(N0+1:N2,N0+1:N2))
       I1=K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,X1,T1B,U1)
C
       V0A2C=V0A2C+U1
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N2))
       CALL REORDER4213(N0,N2,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N0,N2,N0,N2,VBHHPH,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N0+1:N2,N0+1:N2))
       I1=K2*K2
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V0A2C=V0A2C+U2
       DEALLOCATE(U2)
C
       ALLOCATE(D1(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,T2B,D2)
       ALLOCATE(U3(N0+1:N2,N0+1:N2))
       I1=K2
       I2=K2
       I3=K3*K4*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       V0A2C=V0A2C+U3
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2))
       CALL REORDER3124(N2,N3,N0,N2,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N0,N2,VCHHHP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U6(N0+1:N2,N0+1:N2))
       I1=K2*K2
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,U6)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V0A2C=V0A2C+U6
       DEALLOCATE(U6)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U7(N0+1:N2,N0+1:N2))
       I1=K2
       I2=K2
       I3=K4*K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U7)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       V0A2C=V0A2C+0.5_dp*U7
       DEALLOCATE(U7)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR0A4A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR0A4A(N0,N1,N2,N3,V0A4A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V0A4A(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S3(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       CALL REORDER2134(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N1,N3,N0,N1,N0,N1,VAHHPP,D1)
       ALLOCATE(S3(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1))
       I1=K1*K1*K3
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S3)
       DEALLOCATE(D1)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       CALL REORDER2341(N0,N1,N1,N3,N0,N1,N0,N1,
     & N1,N3,N0,N1,N0,N1,N0,N1,S3,D1)
       ALLOCATE(U4(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U4)
       DEALLOCATE(D1)
C
       CALL
     & SUM3124(N0,N1,N0,N1,N0,N1,N0,N1,V0A4A,U4, 1.0_dp)
       DEALLOCATE(U4)
       DEALLOCATE(S3)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       CALL REORDER1342(N1,N3,N0,N1,N0,N1,N0,N1,
     & N1,N3,N0,N1,N0,N1,N0,N1,VAHHHP,D1)
       ALLOCATE(U1(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U1)
       DEALLOCATE(D1)
C
       CALL
     & SUM3124(N0,N1,N0,N1,N0,N1,N0,N1,V0A4A,U1, 1.0_dp)
       CALL
     & SUM4123(N0,N1,N0,N1,N0,N1,N0,N1,V0A4A,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(U2(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1
       I2=K1*K1
       I3=K3*K3
       CALL EGEMM(I1,I2,I3,VAHHPP,T2A,U2)
C
       CALL
     & SUM3412(N0,N1,N0,N1,N0,N1,N0,N1,V0A4A,U2, 0.5_dp)
       DEALLOCATE(U2)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR0A4C
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR0A4C(N0,N1,N2,N3,V0A4C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V0A4C(N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       CALL REORDER2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,VBHHPP,D1)
       ALLOCATE(S4(N0+1:N1,N2+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S4)
       DEALLOCATE(D1)
C
       ALLOCATE(X1(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N2,N3,N0,N2,N0,N1,N0,N1,X1,S4, 1.0_dp)
       DEALLOCATE(S4)
C
       CALL SUM1423(N2,N3,N0,N2,N0,N1,N0,N1,X1,VBHHHP, 1.0_dp)
C
       ALLOCATE(U2(N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1*K1*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,X1,T1B,U2)
C
       CALL
     & SUM2134(N0,N2,N0,N2,N0,N1,N0,N1,V0A4C,U2, 1.0_dp)
       DEALLOCATE(U2)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1))
       CALL REORDER2314(N0,N2,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N2,N0,N2,N0,N1,VBHHPH,D1)
       ALLOCATE(U1(N0+1:N1,N0+1:N2,N0+1:N2,N0+1:N1))
       I1=K1*K2*K2
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U1)
       DEALLOCATE(D1)
C
       CALL
     & SUM4123(N0,N2,N0,N2,N0,N1,N0,N1,V0A4C,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(U3(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1))
       I1=K1*K2
       I2=K1*K2
       I3=K3*K4
       CALL EGEMM(I1,I2,I3,VBHHPP,T2B,U3)
C
       CALL
     & SUM2413(N0,N2,N0,N2,N0,N1,N0,N1,V0A4C,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR0A4E
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR0A4E(N0,N1,N2,N3,V0A4E,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V0A4E(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S3(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
C
       ALLOCATE(D1(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2))
       CALL REORDER2134(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N2,N3,N0,N2,N0,N2,VCHHPP,D1)
       ALLOCATE(S3(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S3)
       DEALLOCATE(D1)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       CALL REORDER2341(N0,N2,N2,N3,N0,N2,N0,N2,
     & N2,N3,N0,N2,N0,N2,N0,N2,S3,D1)
       ALLOCATE(U4(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,U4)
       DEALLOCATE(D1)
C
       CALL
     & SUM3124(N0,N2,N0,N2,N0,N2,N0,N2,V0A4E,U4, 1.0_dp)
       DEALLOCATE(U4)
       DEALLOCATE(S3)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       CALL REORDER1342(N2,N3,N0,N2,N0,N2,N0,N2,
     & N2,N3,N0,N2,N0,N2,N0,N2,VCHHHP,D1)
       ALLOCATE(U1(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,U1)
       DEALLOCATE(D1)
C
       CALL
     & SUM3124(N0,N2,N0,N2,N0,N2,N0,N2,V0A4E,U1, 1.0_dp)
       CALL
     & SUM4123(N0,N2,N0,N2,N0,N2,N0,N2,V0A4E,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(U2(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2
       I2=K2*K2
       I3=K4*K4
       CALL EGEMM(I1,I2,I3,VCHHPP,T2C,U2)
C
       CALL
     & SUM3412(N0,N2,N0,N2,N0,N2,N0,N2,V0A4E,U2, 0.5_dp)
       DEALLOCATE(U2)
C
       END
C
       subroutine HBar1A1A(N0,N1,N2,N3,V1A1A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & t1A,t1B,t2A,t2B,t2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       integer a,b,c,e,f,g,h,i,j,k,m,n,o,p
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 t1A(N1+1:N3,N0+1:N1)
       real*8 t1B(N2+1:N3,N0+1:N2)
       real*8 t2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 t2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 t2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1A1A(N1+1:N3,N0+1:N1)
C
       real*8,allocatable::B1(:,:)
       real*8,allocatable::B2(:,:)
       real*8,allocatable::C1(:,:,:)
       real*8,allocatable::C2(:,:,:)
       real*8,allocatable::D1(:,:,:,:)
       real*8,allocatable::D2(:,:,:,:)
       real*8,allocatable::F2(:,:,:,:,:,:)
C
       real*8,allocatable::U1(:,:)
       real*8,allocatable::U2(:,:)
C
       allocate(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       call reorder3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       allocate(B2(N0+1:N1,N1+1:N3))
       call reorder21(N1,N3,N0,N1,
     & N0,N1,N1,N3,t1A,B2)
       allocate(U1(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K3*K1
       call EGEMM1(I1,I3,D1,B2,U1)
       deallocate(D1)
       deallocate(B2)
C
       V1A1A=V1A1A+U1
       deallocate(U1)
C
       allocate(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       call reorder3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       allocate(B2(N0+1:N2,N2+1:N3))
       call reorder21(N2,N3,N0,N2,
     & N0,N2,N2,N3,t1B,B2)
       allocate(U2(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K4*K2
       call EGEMM1(I1,I3,D1,B2,U2)
       deallocate(D1)
       deallocate(B2)
C
       V1A1A=V1A1A+U2
       deallocate(U2)
C
       end
C
C*MODULE DEAEOMDIP DECK HBAR1A3A0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1A3A0(N0,N1,N2,N3,V1A3A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1A3A(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(U1(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1))
       I1=K1*K1*K3
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,VAHHPP,T1A,U1)
C
       CALL
     & SUM4123(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1A3A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1A3A(N0,N1,N2,N3,V1A3A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1A3A(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S6(:,:,:,:)
       real*8,ALLOCATABLE::S8(:,:,:,:)
       real*8,ALLOCATABLE::S10(:,:,:,:)
       real*8,ALLOCATABLE::S15(:,:,:,:)
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S12(:,:,:,:)
       real*8,ALLOCATABLE::S18(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
       real*8,ALLOCATABLE::U5(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:,:)
       real*8,ALLOCATABLE::U9(:,:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U17(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       CALL REORDER1423(N1,N3,N0,N1,N0,N1,N0,N1,
     & N1,N3,N0,N1,N0,N1,N0,N1,VAHHHP,D1)
       ALLOCATE(S6(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S6)
       DEALLOCATE(D1)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       CALL REORDER2134(N0,N1,N0,N1,N0,N1,N0,N1,
     & N0,N1,N0,N1,N0,N1,N0,N1,S6,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U7(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1*K1
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,U7)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V1A3A=V1A3A-U7
       CALL
     & SUM1324(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U7, 1.0_dp)
       DEALLOCATE(U7)
       DEALLOCATE(S6)
C
       ALLOCATE(D1(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER2134(N1,N3,N1,N3,N1,N3,N0,N1,
     & N1,N3,N1,N3,N1,N3,N0,N1,VAHPPP,D1)
       ALLOCATE(S8(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K3
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S8)
       DEALLOCATE(D1)
C
       ALLOCATE(D1(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       CALL REORDER2314(N0,N1,N1,N3,N1,N3,N0,N1,
     & N1,N3,N1,N3,N0,N1,N0,N1,S8,D1)
       ALLOCATE(U9(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1))
       I1=K1*K1*K3
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U9)
       DEALLOCATE(D1)
C
       CALL
     & SUM2134(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U9,-1.0_dp)
       DEALLOCATE(U9)
       DEALLOCATE(S8)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       CALL REORDER1423(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N0,N1,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(S10(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S10)
       DEALLOCATE(D1)
C
       ALLOCATE(X3(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM3124(N0,N1,N1,N3,N0,N1,N0,N1,X3,S10,-1.0_dp)
C
       CALL SUM2341(N0,N1,N1,N3,N0,N1,N0,N1,X3,VAHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U4(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,X3,D2,U4)
       DEALLOCATE(D2)
C
       V1A3A=V1A3A+U4
       CALL
     & SUM1324(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U4,-1.0_dp)
       DEALLOCATE(U4)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       CALL REORDER3214(N0,N1,N0,N1,N1,N3,N0,N1,
     & N1,N3,N0,N1,N0,N1,N0,N1,S10,D1)
       ALLOCATE(S15(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S15)
       DEALLOCATE(D1)
C
       ALLOCATE(X2(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM2134(N0,N1,N0,N1,N0,N1,N0,N1,X2,S15,-1.0_dp)
       DEALLOCATE(S15)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N1+1:N3,N0+1:N1),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       CALL REORDER1243(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N1,N3,N0,N1,N0,N1,VAHHPP,D1)
       ALLOCATE(S12(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1
       I2=K1*K1
       I3=K3*K3
       CALL EGEMM(I1,I2,I3,D1,T2A,S12)
       DEALLOCATE(D1)
C
       CALL SUM2314(N0,N1,N0,N1,N0,N1,N0,N1,X2,S12, 0.5_dp)
       DEALLOCATE(S12)
C
       CALL SUM2341(N0,N1,N0,N1,N0,N1,N0,N1,X2,VAHHHH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1*K1
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X2,B2,U2)
       DEALLOCATE(B2)
C
       V1A3A=V1A3A-U2
       DEALLOCATE(U2)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N2,N2+1:N3,N0+1:N1))
       CALL REORDER2314(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N2,N2,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(S18(N0+1:N1,N0+1:N2,N2+1:N3,N0+1:N1))
       I1=K1*K4*K2
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S18)
       DEALLOCATE(D1)
C
       ALLOCATE(X4(N0+1:N2,N2+1:N3,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM3124(N0,N2,N2,N3,N0,N1,N0,N1,X4,S18, 1.0_dp)
       DEALLOCATE(S18)
C
       CALL SUM2314(N0,N2,N2,N3,N0,N1,N0,N1,X4,VBHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U17(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1*K1
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,X4,D2,U17)
       DEALLOCATE(D2)
C
       V1A3A=V1A3A-U17
       CALL
     & SUM1324(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U17, 1.0_dp)
       DEALLOCATE(U17)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       X1=X1+FAHP
C
       ALLOCATE(U1(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       I1=K1
       I2=K1*K1*K3
       I3=K3
       CALL EGEMM(I1,I2,I3,X1,T2A,U1)
C
       V1A3A=V1A3A+U1
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       CALL REORDER1324(N1,N3,N0,N1,N1,N3,N0,N1,
     & N1,N3,N1,N3,N0,N1,N0,N1,VAHPHP,D1)
       ALLOCATE(U3(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1))
       I1=K1*K1*K3
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U3)
       DEALLOCATE(D1)
C
       CALL
     & SUM2134(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U3,-1.0_dp)
       CALL
     & SUM3124(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(U5(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3
       I2=K1*K1
       I3=K3*K3
       CALL EGEMM(I1,I2,I3,VAHPPP,T2A,U5)
C
       CALL
     & SUM2314(N1,N3,N0,N1,N0,N1,N0,N1,V1A3A,U5,-0.5_dp)
       DEALLOCATE(U5)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1A3C0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1A3C0(N0,N1,N2,N3,V1A3C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1A3C(N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(U1(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K3
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,VBHHPP,T1B,U1)
C
       CALL
     & SUM3124(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1A3C
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1A3C(N0,N1,N2,N3,V1A3C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1A3C(N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S8(:,:,:,:)
       real*8,ALLOCATABLE::S10(:,:,:,:)
       real*8,ALLOCATABLE::S12(:,:,:,:)
       real*8,ALLOCATABLE::S14(:,:,:,:)
       real*8,ALLOCATABLE::S21(:,:,:,:)
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S19(:,:,:,:)
       real*8,ALLOCATABLE::S16(:,:,:,:)
       real*8,ALLOCATABLE::S24(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U5(:,:,:,:)
       real*8,ALLOCATABLE::X5(:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:,:)
       real*8,ALLOCATABLE::X6(:,:,:,:)
       real*8,ALLOCATABLE::U23(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N0+1:N2,N0+1:N2))
       CALL REORDER2431(N0,N2,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N1,N0,N2,N0,N2,VBHHPH,D1)
       ALLOCATE(S8(N0+1:N1,N0+1:N1,N0+1:N2,N0+1:N2))
       I1=K2*K2*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S8)
       DEALLOCATE(D1)
C
       ALLOCATE(X2(N0+1:N1,N0+1:N2,N0+1:N2,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N0,N2,N0,N2,N0,N1,X2,S8, 1.0_dp)
       DEALLOCATE(S8)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1))
       CALL REORDER1432(N2,N3,N0,N1,N0,N2,N0,N1,
     & N2,N3,N0,N1,N0,N2,N0,N1,VBHHHP,D1)
       ALLOCATE(S10(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1))
       I1=K1*K2*K1
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S10)
       DEALLOCATE(D1)
C
       CALL SUM3124(N0,N1,N0,N2,N0,N2,N0,N1,X2,S10, 1.0_dp)
       DEALLOCATE(S10)
C
       ALLOCATE(D1(N1+1:N3,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER2143(N2,N3,N1,N3,N0,N2,N1,N3,
     & N1,N3,N2,N3,N1,N3,N0,N2,VBPHPP,D1)
       ALLOCATE(S12(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S12)
       DEALLOCATE(D1)
C
       ALLOCATE(X3(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N2,N3,N1,N3,N0,N2,N0,N1,X3,S12, 1.0_dp)
       DEALLOCATE(S12)
C
       CALL SUM3214(N2,N3,N1,N3,N0,N2,N0,N1,X3,VBHPPH, 1.0_dp)
C
       ALLOCATE(U4(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K3
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,X3,T1B,U4)
C
       CALL
     & SUM3124(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U4, 1.0_dp)
       DEALLOCATE(U4)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N2+1:N3,N0+1:N2))
       CALL REORDER2413(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N1,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(S14(N0+1:N1,N0+1:N1,N2+1:N3,N0+1:N2))
       I1=K2*K4*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S14)
       DEALLOCATE(D1)
C
       ALLOCATE(X5(N0+1:N1,N2+1:N3,N0+1:N2,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N2,N3,N0,N2,N0,N1,X5,S14, 1.0_dp)
C
       CALL SUM2431(N0,N1,N2,N3,N0,N2,N0,N1,X5,VBHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,T2B,D2)
       ALLOCATE(U6(N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1))
       I1=K1*K2
       I2=K2*K3
       I3=K4*K1
       CALL EGEMM(I1,I2,I3,X5,D2,U6)
       DEALLOCATE(D2)
C
       CALL
     & SUM1324(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U6,-1.0_dp)
       DEALLOCATE(U6)
       DEALLOCATE(X5)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1))
       CALL REORDER3241(N0,N1,N0,N1,N2,N3,N0,N2,
     & N2,N3,N0,N1,N0,N2,N0,N1,S14,D1)
       ALLOCATE(S21(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1))
       I1=K1*K2*K1
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S21)
       DEALLOCATE(D1)
C
       CALL SUM3124(N0,N1,N0,N2,N0,N2,N0,N1,X2,S21, 1.0_dp)
       DEALLOCATE(S21)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N2+1:N3,N0+1:N2),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N1,N1+1:N3,N0+1:N2))
       CALL REORDER1423(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N0,N1,N1,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(S19(N0+1:N2,N0+1:N1,N1+1:N3,N0+1:N2))
       I1=K2*K3*K1
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S19)
       DEALLOCATE(D1)
C
       ALLOCATE(X4(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N1,N3,N0,N2,N0,N2,X4,S19, 1.0_dp)
       DEALLOCATE(S19)
C
       CALL SUM4231(N0,N1,N1,N3,N0,N2,N0,N2,X4,VBHHPH, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U5(N1+1:N3,N0+1:N1,N0+1:N2,N0+1:N2))
       I1=K2*K2
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,X4,D2,U5)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U5, 1.0_dp)
       DEALLOCATE(U5)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N2+1:N3,N1+1:N3,N0+1:N1,N0+1:N2))
       CALL REORDER1243(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N1,N3,N0,N1,N0,N2,VBHHPP,D1)
       ALLOCATE(S16(N0+1:N2,N0+1:N1,N0+1:N1,N0+1:N2))
       I1=K2*K1
       I2=K1*K2
       I3=K3*K4
       CALL EGEMM(I1,I2,I3,D1,T2B,S16)
       DEALLOCATE(D1)
C
       CALL SUM3412(N0,N1,N0,N2,N0,N2,N0,N1,X2,S16, 1.0_dp)
       DEALLOCATE(S16)
C
       CALL SUM3421(N0,N1,N0,N2,N0,N2,N0,N1,X2,VBHHHH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1))
       I1=K1*K2*K2
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X2,B2,U2)
       DEALLOCATE(B2)
C
       V1A3C=V1A3C-U2
       DEALLOCATE(U2)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       CALL REORDER1423(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N0,N2,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(S24(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S24)
       DEALLOCATE(D1)
C
       ALLOCATE(X6(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N2,N3,N0,N2,N0,N2,X6,S24,-1.0_dp)
       DEALLOCATE(S24)
C
       CALL SUM2431(N0,N2,N2,N3,N0,N2,N0,N2,X6,VCHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U23(N1+1:N3,N0+1:N1,N0+1:N2,N0+1:N2))
       I1=K2*K2
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,X6,D2,U23)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U23,-1.0_dp)
       DEALLOCATE(U23)
       DEALLOCATE(X6)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       X1=X1+FBHP
C
       ALLOCATE(U1(N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N2))
       I1=K2
       I2=K1*K2*K3
       I3=K4
       CALL EGEMM(I1,I2,I3,X1,T2B,U1)
C
       CALL
     & SUM1342(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U1, 1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N2))
       CALL REORDER2431(N0,N2,N1,N3,N0,N2,N1,N3,
     & N1,N3,N1,N3,N0,N2,N0,N2,VBPHPH,D1)
       ALLOCATE(U3(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K3
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U3)
       DEALLOCATE(D1)
C
       CALL
     & SUM4123(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER1243(N2,N3,N1,N3,N0,N2,N1,N3,
     & N2,N3,N1,N3,N1,N3,N0,N2,VBPHPP,D1)
       ALLOCATE(U7(N0+1:N2,N0+1:N1,N1+1:N3,N0+1:N2))
       I1=K2*K3
       I2=K1*K2
       I3=K3*K4
       CALL EGEMM(I1,I2,I3,D1,T2B,U7)
       DEALLOCATE(D1)
C
       CALL
     & SUM3412(N1,N3,N0,N2,N0,N2,N0,N1,V1A3C,U7, 1.0_dp)
       DEALLOCATE(U7)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1B1B
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1B1B(N0,N1,N2,N3,V1B1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1B1B(N2+1:N3,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:)
       real*8,ALLOCATABLE::U2(:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V1B1B=V1B1B+U1
       DEALLOCATE(U1)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U2(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V1B1B=V1B1B+U2
       DEALLOCATE(U2)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1B3B0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1B3B0(N0,N1,N2,N3,V1B3B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1B3B(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       CALL REORDER2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,VBHHPP,D1)
       ALLOCATE(U1(N0+1:N1,N2+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U1)
       DEALLOCATE(D1)
C
       CALL
     & SUM4123(N2,N3,N0,N2,N0,N1,N0,N1,V1B3B,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1B3B
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1B3B(N0,N1,N2,N3,V1B3B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1B3B(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S3(:,:,:,:)
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S12(:,:,:,:)
       real*8,ALLOCATABLE::S14(:,:,:,:)
       real*8,ALLOCATABLE::S16(:,:,:,:)
       real*8,ALLOCATABLE::S25(:,:,:,:)
       real*8,ALLOCATABLE::S20(:,:,:,:)
       real*8,ALLOCATABLE::S22(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::S18(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U8(:,:,:,:)
       real*8,ALLOCATABLE::X5(:,:,:,:)
       real*8,ALLOCATABLE::U9(:,:,:,:)
       real*8,ALLOCATABLE::U10(:,:,:,:)
       real*8,ALLOCATABLE::X6(:,:,:,:)
       real*8,ALLOCATABLE::U11(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       CALL REORDER2314(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N0,N1,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(S3(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S3)
       DEALLOCATE(D1)
C
       ALLOCATE(X2(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N1,N3,N0,N1,N0,N1,X2,S3, 1.0_dp)
       DEALLOCATE(S3)
C
       CALL SUM2413(N0,N1,N1,N3,N0,N1,N0,N1,X2,VAHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(U2(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1*K1
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,X2,D2,U2)
       DEALLOCATE(D2)
C
       V1B3B=V1B3B+U2
       DEALLOCATE(U2)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N1+1:N3,N0+1:N1),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1))
       CALL REORDER2314(N0,N2,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N2,N0,N2,N0,N1,VBHHPH,D1)
       ALLOCATE(S12(N0+1:N1,N0+1:N2,N0+1:N2,N0+1:N1))
       I1=K1*K2*K2
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S12)
       DEALLOCATE(D1)
C
       ALLOCATE(X3(N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N0,N2,N0,N1,N0,N1,X3,S12, 1.0_dp)
       DEALLOCATE(S12)
C
       ALLOCATE(D1(N1+1:N3,N2+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER2134(N2,N3,N1,N3,N2,N3,N0,N1,
     & N1,N3,N2,N3,N2,N3,N0,N1,VBHPPP,D1)
       ALLOCATE(S14(N0+1:N1,N2+1:N3,N2+1:N3,N0+1:N1))
       I1=K1*K4*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S14)
       DEALLOCATE(D1)
C
       ALLOCATE(X4(N2+1:N3,N2+1:N3,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N2,N3,N2,N3,N0,N1,N0,N1,X4,S14, 1.0_dp)
       DEALLOCATE(S14)
C
       CALL SUM1423(N2,N3,N2,N3,N0,N1,N0,N1,X4,VBHPHP, 1.0_dp)
C
       ALLOCATE(U8(N0+1:N2,N2+1:N3,N0+1:N1,N0+1:N1))
       I1=K1*K1*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,X4,T1B,U8)
C
       CALL
     & SUM2134(N2,N3,N0,N2,N0,N1,N0,N1,V1B3B,U8, 1.0_dp)
       DEALLOCATE(U8)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N2,N2+1:N3,N0+1:N1))
       CALL REORDER2314(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N2,N2,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(S16(N0+1:N1,N0+1:N2,N2+1:N3,N0+1:N1))
       I1=K1*K4*K2
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S16)
       DEALLOCATE(D1)
C
       ALLOCATE(X6(N0+1:N2,N2+1:N3,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N2,N3,N0,N1,N0,N1,X6,S16, 1.0_dp)
C
       CALL SUM2413(N0,N2,N2,N3,N0,N1,N0,N1,X6,VBHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U11(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1*K1
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,X6,D2,U11)
       DEALLOCATE(D2)
C
       V1B3B=V1B3B+U11
       DEALLOCATE(U11)
       DEALLOCATE(X6)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1))
       CALL REORDER3241(N0,N1,N0,N2,N2,N3,N0,N1,
     & N2,N3,N0,N2,N0,N1,N0,N1,S16,D1)
       ALLOCATE(S25(N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1*K1*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S25)
       DEALLOCATE(D1)
C
       CALL SUM2134(N0,N2,N0,N2,N0,N1,N0,N1,X3,S25, 1.0_dp)
       DEALLOCATE(S25)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N1+1:N3,N0+1:N1))
       CALL REORDER1324(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N0,N2,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(S20(N0+1:N2,N0+1:N2,N1+1:N3,N0+1:N1))
       I1=K1*K3*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S20)
       DEALLOCATE(D1)
C
       ALLOCATE(X5(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1),SOURCE=0.0D0)
       CALL SUM3124(N0,N2,N1,N3,N0,N2,N0,N1,X5,S20, 1.0_dp)
       DEALLOCATE(S20)
C
       CALL SUM3214(N0,N2,N1,N3,N0,N2,N0,N1,X5,VBHHPH, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER3214(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N1,N3,N2,N3,N0,N1,T2B,D2)
       ALLOCATE(U9(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1))
       I1=K1*K2
       I2=K1*K4
       I3=K3*K2
       CALL EGEMM(I1,I2,I3,X5,D2,U9)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N2,N3,N0,N2,N0,N1,N0,N1,V1B3B,U9,-1.0_dp)
       DEALLOCATE(U9)
       DEALLOCATE(X5)
C
       ALLOCATE(S22(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1))
       I1=K1*K2
       I2=K1*K2
       I3=K3*K4
       CALL EGEMM(I1,I2,I3,VBHHPP,T2B,S22)
C
       CALL SUM2413(N0,N2,N0,N2,N0,N1,N0,N1,X3,S22, 1.0_dp)
       DEALLOCATE(S22)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N1+1:N3,N0+1:N1))
       I1=K1*K3
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       X1=X1+FAHP
C
       ALLOCATE(D2(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       CALL REORDER2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,T2B,D2)
       ALLOCATE(U1(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1
       I2=K1*K2*K4
       I3=K3
       CALL EGEMM(I1,I2,I3,X1,D2,U1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1243(N2,N3,N0,N2,N0,N1,N0,N1,V1B3B,U1, 1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1))
       CALL REORDER1342(N2,N3,N0,N1,N0,N2,N0,N1,
     & N2,N3,N0,N2,N0,N1,N0,N1,VBHHHP,D1)
       ALLOCATE(S18(N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1*K1*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S18)
       DEALLOCATE(D1)
C
       CALL SUM2134(N0,N2,N0,N2,N0,N1,N0,N1,X3,S18, 1.0_dp)
       DEALLOCATE(S18)
C
       CALL SUM2413(N0,N2,N0,N2,N0,N1,N0,N1,X3,VBHHHH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U7(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1*K1*K2
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X3,B2,U7)
       DEALLOCATE(B2)
C
       V1B3B=V1B3B-U7
       DEALLOCATE(U7)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       CALL REORDER2314(N0,N2,N1,N3,N2,N3,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,VBHPPH,D1)
       ALLOCATE(U6(N0+1:N1,N2+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U6)
       DEALLOCATE(D1)
C
       CALL
     & SUM4123(N2,N3,N0,N2,N0,N1,N0,N1,V1B3B,U6, 1.0_dp)
       DEALLOCATE(U6)
C
       ALLOCATE(U10(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1))
       I1=K1*K4
       I2=K1*K2
       I3=K3*K4
       CALL EGEMM(I1,I2,I3,VBHPPP,T2B,U10)
C
       CALL
     & SUM2413(N2,N3,N0,N2,N0,N1,N0,N1,V1B3B,U10, 1.0_dp)
       DEALLOCATE(U10)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1B3D0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1B3D0(N0,N1,N2,N3,V1B3D,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1B3D(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(U1(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,VCHHPP,T1B,U1)
C
       CALL
     & SUM4123(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR1B3D
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR1B3D(N0,N1,N2,N3,V1B3D,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V1B3D(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::S10(:,:,:,:)
       real*8,ALLOCATABLE::S12(:,:,:,:)
       real*8,ALLOCATABLE::S14(:,:,:,:)
       real*8,ALLOCATABLE::S19(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::S16(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U8(:,:,:,:)
       real*8,ALLOCATABLE::U9(:,:,:,:)
       real*8,ALLOCATABLE::U11(:,:,:,:)
       real*8,ALLOCATABLE::U13(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N2+1:N3,N0+1:N2),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N1,N1+1:N3,N0+1:N2))
       CALL REORDER1423(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N0,N1,N1,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(S4(N0+1:N2,N0+1:N1,N1+1:N3,N0+1:N2))
       I1=K2*K3*K1
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S4)
       DEALLOCATE(D1)
C
       ALLOCATE(X2(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
       CALL SUM3124(N0,N1,N1,N3,N0,N2,N0,N2,X2,S4, 1.0_dp)
       DEALLOCATE(S4)
C
       CALL SUM3241(N0,N1,N1,N3,N0,N2,N0,N2,X2,VBHHPH, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(U2(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,X2,D2,U2)
       DEALLOCATE(D2)
C
       V1B3D=V1B3D-U2
       CALL
     & SUM1324(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U2, 1.0_dp)
       DEALLOCATE(U2)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       CALL REORDER1423(N2,N3,N0,N2,N0,N2,N0,N2,
     & N2,N3,N0,N2,N0,N2,N0,N2,VCHHHP,D1)
       ALLOCATE(S10(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S10)
       DEALLOCATE(D1)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       CALL REORDER2134(N0,N2,N0,N2,N0,N2,N0,N2,
     & N0,N2,N0,N2,N0,N2,N0,N2,S10,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U11(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2*K2
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,D1,B2,U11)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V1B3D=V1B3D-U11
       CALL
     & SUM1324(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U11, 1.0_dp)
       DEALLOCATE(U11)
       DEALLOCATE(S10)
C
       ALLOCATE(D1(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER2134(N2,N3,N2,N3,N2,N3,N0,N2,
     & N2,N3,N2,N3,N2,N3,N0,N2,VCHPPP,D1)
       ALLOCATE(S12(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S12)
       DEALLOCATE(D1)
C
       ALLOCATE(D1(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2))
       CALL REORDER2314(N0,N2,N2,N3,N2,N3,N0,N2,
     & N2,N3,N2,N3,N0,N2,N0,N2,S12,D1)
       ALLOCATE(U13(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,U13)
       DEALLOCATE(D1)
C
       CALL
     & SUM2134(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U13,-1.0_dp)
       DEALLOCATE(U13)
       DEALLOCATE(S12)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       CALL REORDER1423(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N0,N2,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(S14(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S14)
       DEALLOCATE(D1)
C
       ALLOCATE(X4(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
       CALL SUM3124(N0,N2,N2,N3,N0,N2,N0,N2,X4,S14,-1.0_dp)
C
       CALL SUM2341(N0,N2,N2,N3,N0,N2,N0,N2,X4,VCHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U8(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,X4,D2,U8)
       DEALLOCATE(D2)
C
       V1B3D=V1B3D+U8
       CALL
     & SUM1324(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U8,-1.0_dp)
       DEALLOCATE(U8)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       CALL REORDER3214(N0,N2,N0,N2,N2,N3,N0,N2,
     & N2,N3,N0,N2,N0,N2,N0,N2,S14,D1)
       ALLOCATE(S19(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S19)
       DEALLOCATE(D1)
C
       ALLOCATE(X3(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
       CALL SUM2134(N0,N2,N0,N2,N0,N2,N0,N2,X3,S19,-1.0_dp)
       DEALLOCATE(S19)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N2+1:N3,N0+1:N2))
       I1=K2*K4
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       X1=X1+FBHP
C
       ALLOCATE(U1(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2
       I2=K2*K2*K4
       I3=K4
       CALL EGEMM(I1,I2,I3,X1,T2C,U1)
C
       V1B3D=V1B3D+U1
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2))
       CALL REORDER1243(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N2,N3,N0,N2,N0,N2,VCHHPP,D1)
       ALLOCATE(S16(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2
       I2=K2*K2
       I3=K4*K4
       CALL EGEMM(I1,I2,I3,D1,T2C,S16)
       DEALLOCATE(D1)
C
       CALL SUM2314(N0,N2,N0,N2,N0,N2,N0,N2,X3,S16, 0.5_dp)
       DEALLOCATE(S16)
C
       CALL SUM2341(N0,N2,N0,N2,N0,N2,N0,N2,X3,VCHHHH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U6(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2*K2
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X3,B2,U6)
       DEALLOCATE(B2)
C
       V1B3D=V1B3D-U6
       DEALLOCATE(U6)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2))
       CALL REORDER1324(N2,N3,N0,N2,N2,N3,N0,N2,
     & N2,N3,N2,N3,N0,N2,N0,N2,VCHPHP,D1)
       ALLOCATE(U7(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,U7)
       DEALLOCATE(D1)
C
       CALL
     & SUM2134(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U7,-1.0_dp)
       CALL
     & SUM3124(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U7, 1.0_dp)
       DEALLOCATE(U7)
C
       ALLOCATE(U9(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4
       I2=K2*K2
       I3=K4*K4
       CALL EGEMM(I1,I2,I3,VCHPPP,T2C,U9)
C
       CALL
     & SUM2314(N2,N3,N0,N2,N0,N2,N0,N2,V1B3D,U9,-0.5_dp)
       DEALLOCATE(U9)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2A0A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2A0A(N0,N1,N2,N3,V2A0A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2A0A(N1+1:N3,N1+1:N3)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::Q4(:,:)
       real*8,ALLOCATABLE::Q8(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:)
       real*8,ALLOCATABLE::U2(:,:)
       real*8,ALLOCATABLE::U3(:,:)
       real*8,ALLOCATABLE::U6(:,:)
       real*8,ALLOCATABLE::U7(:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N1,N1,N3,VAHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q4(N0+1:N1,N1+1:N3))
       I1=K3*K1
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q4)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N0+1:N1,N1+1:N3),SOURCE=0.0D0)
       X1=X1+Q4
       DEALLOCATE(Q4)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N0,N1,N1,N3,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q8(N0+1:N1,N1+1:N3))
       I1=K3*K1
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q8)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q8
       DEALLOCATE(Q8)
C
       CALL SUM21(N0,N1,N1,N3,X1,FAHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N1+1:N3,N1+1:N3))
       I1=K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X1,B2,U1)
       DEALLOCATE(B2)
C
       CALL
     & SUM21(N1,N3,N1,N3,V2A0A,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER4123(N1,N3,N1,N3,N1,N3,N0,N1,
     & N0,N1,N1,N3,N1,N3,N1,N3,VAHPPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N1+1:N3,N1+1:N3))
       I1=K3*K3
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V2A0A=V2A0A-U2
       DEALLOCATE(U2)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N1,N1+1:N3,N1+1:N3))
       CALL REORDER3421(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N0,N1,N1,N3,N1,N3,VAHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N0+1:N1,N1+1:N3,N1+1:N3))
       CALL REORDER3412(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N0,N1,N1,N3,N1,N3,T2A,D2)
       ALLOCATE(U3(N1+1:N3,N1+1:N3))
       I1=K3
       I2=K3
       I3=K3*K1*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM21(N1,N3,N1,N3,V2A0A,U3, 0.5_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N1,N3,
     & N0,N2,N2,N3,N1,N3,N1,N3,VBPHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U6(N1+1:N3,N1+1:N3))
       I1=K3*K3
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,U6)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V2A0A=V2A0A+U6
       DEALLOCATE(U6)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       CALL REORDER3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       CALL REORDER3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,T2B,D2)
       ALLOCATE(U7(N1+1:N3,N1+1:N3))
       I1=K3
       I2=K3
       I3=K4*K1*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U7)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM21(N1,N3,N1,N3,V2A0A,U7,-1.0_dp)
       DEALLOCATE(U7)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2A2A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2A2A(N0,N1,N2,N3,V2A2A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2A2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       CALL REORDER1423(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N0,N1,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(S4(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S4)
       DEALLOCATE(D1)
C
       ALLOCATE(X1(N0+1:N1,N1+1:N3,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N1,N3,N0,N1,N0,N1,X1,S4,-1.0_dp)
       DEALLOCATE(S4)
C
       CALL SUM2431(N0,N1,N1,N3,N0,N1,N0,N1,X1,VAHHHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       I1=K1*K1*K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X1,B2,U1)
       DEALLOCATE(B2)
C
       CALL
     & SUM2134(N1,N3,N1,N3,N0,N1,N0,N1,V2A2A,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(U2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K3
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,VAHPPP,T1A,U2)
C
       CALL
     & SUM4123(N1,N3,N1,N3,N0,N1,N0,N1,V2A2A,U2, 1.0_dp)
       DEALLOCATE(U2)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER4213(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U3(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM2413(N1,N3,N1,N3,N0,N1,N0,N1,V2A2A,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U6(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U6)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM2413(N1,N3,N1,N3,N0,N1,N0,N1,V2A2A,U6, 1.0_dp)
       DEALLOCATE(U6)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2A2C
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2A2C(N0,N1,N2,N3,V2A2C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2A2C(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N1,N1+1:N3,N0+1:N2))
       CALL REORDER1423(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N0,N1,N1,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(S4(N0+1:N2,N0+1:N1,N1+1:N3,N0+1:N2))
       I1=K2*K3*K1
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S4)
       DEALLOCATE(D1)
C
       ALLOCATE(X1(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
       CALL SUM3124(N0,N1,N1,N3,N0,N2,N0,N2,X1,S4, 1.0_dp)
       DEALLOCATE(S4)
C
       CALL SUM3241(N0,N1,N1,N3,N0,N2,N0,N2,X1,VBHHPH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X1,B2,U1)
       DEALLOCATE(B2)
C
       CALL
     & SUM2134(N1,N3,N1,N3,N0,N2,N0,N2,V2A2C,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER1243(N2,N3,N1,N3,N0,N2,N1,N3,
     & N2,N3,N1,N3,N1,N3,N0,N2,VBPHPP,D1)
       ALLOCATE(U2(N0+1:N2,N1+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3*K3
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,U2)
       DEALLOCATE(D1)
C
       CALL
     & SUM3124(N1,N3,N1,N3,N0,N2,N0,N2,V2A2C,U2, 1.0_dp)
       DEALLOCATE(U2)
C
       ALLOCATE(D1(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,T2B,D2)
       ALLOCATE(U3(N1+1:N3,N0+1:N2,N1+1:N3,N0+1:N2))
       I1=K2*K3
       I2=K2*K3
       I3=K4*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM2314(N1,N3,N1,N3,N0,N2,N0,N2,V2A2C,U3,-1.0_dp)
       DEALLOCATE(U3)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2B2B0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2B2B0(N0,N1,N2,N3,V2B2B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2B2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N2+1:N3,N0+1:N2))
       CALL REORDER2413(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N1,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(S4(N0+1:N1,N0+1:N1,N2+1:N3,N0+1:N2))
       I1=K2*K4*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S4)
       DEALLOCATE(D1)
C
       ALLOCATE(X1(N0+1:N1,N2+1:N3,N0+1:N2,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N2,N3,N0,N2,N0,N1,X1,S4, 1.0_dp)
       DEALLOCATE(S4)
C
       CALL SUM2431(N0,N1,N2,N3,N0,N2,N0,N1,X1,VBHHHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K4
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X1,B2,U1)
       DEALLOCATE(B2)
C
       CALL
     & SUM2134(N2,N3,N1,N3,N0,N2,N0,N1,V2B2B,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N1+1:N3,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER2143(N2,N3,N1,N3,N0,N2,N1,N3,
     & N1,N3,N2,N3,N1,N3,N0,N2,VBPHPP,D1)
       ALLOCATE(U2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U2)
       DEALLOCATE(D1)
C
       CALL
     & SUM4123(N2,N3,N1,N3,N0,N2,N0,N1,V2B2B,U2, 1.0_dp)
       DEALLOCATE(U2)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U3(N1+1:N3,N0+1:N1,N2+1:N3,N0+1:N2))
       I1=K2*K4
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM2413(N2,N3,N1,N3,N0,N2,N0,N1,V2B2B,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U6(N1+1:N3,N0+1:N1,N2+1:N3,N0+1:N2))
       I1=K2*K4
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U6)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM2413(N2,N3,N1,N3,N0,N2,N0,N1,V2B2B,U6, 1.0_dp)
       DEALLOCATE(U6)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2B2B
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2B2B(N0,N1,N2,N3,V2B2B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2B2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S5(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N1+1:N3,N0+1:N1))
       CALL REORDER1324(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N0,N2,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(S5(N0+1:N2,N0+1:N2,N1+1:N3,N0+1:N1))
       I1=K1*K3*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S5)
       DEALLOCATE(D1)
C
       ALLOCATE(X1(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1),SOURCE=0.0D0)
       CALL SUM3124(N0,N2,N1,N3,N0,N2,N0,N1,X1,S5, 1.0_dp)
       DEALLOCATE(S5)
C
       CALL SUM3214(N0,N2,N1,N3,N0,N2,N0,N1,X1,VBHHPH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U2(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K3
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X1,B2,U2)
       DEALLOCATE(B2)
C
       V2B2B=V2B2B-U2
       DEALLOCATE(U2)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(U1(N2+1:N3,N0+1:N2,N1+1:N3,N0+1:N1))
       I1=K1*K3
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1324(N2,N3,N1,N3,N0,N2,N0,N1,V2B2B,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(D1(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER1324(N2,N3,N1,N3,N2,N3,N0,N1,
     & N2,N3,N2,N3,N1,N3,N0,N1,VBHPPP,D1)
       ALLOCATE(U3(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,U3)
       DEALLOCATE(D1)
C
       CALL
     & SUM3124(N2,N3,N1,N3,N0,N2,N0,N1,V2B2B,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U4(N2+1:N3,N0+1:N2,N1+1:N3,N0+1:N1))
       I1=K1*K3
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U4)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1324(N2,N3,N1,N3,N0,N2,N0,N1,V2B2B,U4, 1.0_dp)
       DEALLOCATE(U4)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2C0A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2C0A(N0,N1,N2,N3,V2C0A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2C0A(N2+1:N3,N2+1:N3)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::Q4(:,:)
       real*8,ALLOCATABLE::Q8(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:)
       real*8,ALLOCATABLE::U2(:,:)
       real*8,ALLOCATABLE::U3(:,:)
       real*8,ALLOCATABLE::U6(:,:)
       real*8,ALLOCATABLE::U7(:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER4231(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N0,N2,N2,N3,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q4(N0+1:N2,N2+1:N3))
       I1=K4*K2
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q4)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N0+1:N2,N2+1:N3),SOURCE=0.0D0)
       X1=X1+Q4
       DEALLOCATE(Q4)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER3142(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q8(N0+1:N2,N2+1:N3))
       I1=K4*K2
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q8)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q8
       DEALLOCATE(Q8)
C
       CALL SUM21(N0,N2,N2,N3,X1,FBHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U1(N2+1:N3,N2+1:N3))
       I1=K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X1,B2,U1)
       DEALLOCATE(B2)
C
       CALL
     & SUM21(N2,N3,N2,N3,V2C0A,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4213(N2,N3,N1,N3,N2,N3,N0,N1,
     & N0,N1,N1,N3,N2,N3,N2,N3,VBHPPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N2+1:N3,N2+1:N3))
       I1=K4*K4
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V2C0A=V2C0A+U2
       DEALLOCATE(U2)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N1,N1+1:N3,N2+1:N3))
       CALL REORDER3421(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N1,N3,N2,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N0+1:N1,N1+1:N3,N2+1:N3))
       CALL REORDER3421(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N1,N3,N2,N3,T2B,D2)
       ALLOCATE(U3(N2+1:N3,N2+1:N3))
       I1=K4
       I2=K4
       I3=K3*K1*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM21(N2,N3,N2,N3,V2C0A,U3,-1.0_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4123(N2,N3,N2,N3,N2,N3,N0,N2,
     & N0,N2,N2,N3,N2,N3,N2,N3,VCHPPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U6(N2+1:N3,N2+1:N3))
       I1=K4*K4
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,U6)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       V2C0A=V2C0A-U6
       DEALLOCATE(U6)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3))
       CALL REORDER3421(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N0,N2,N2,N3,N2,N3,VCHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3))
       CALL REORDER3412(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N0,N2,N2,N3,N2,N3,T2C,D2)
       ALLOCATE(U7(N2+1:N3,N2+1:N3))
       I1=K4
       I2=K4
       I3=K4*K2*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U7)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM21(N2,N3,N2,N3,V2C0A,U7, 0.5_dp)
       DEALLOCATE(U7)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2C2A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2C2A(N0,N1,N2,N3,V2C2A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2C2A(N2+1:N3,N2+1:N3,N0+1:N1,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N2,N2+1:N3,N0+1:N1))
       CALL REORDER2314(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N2,N2,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(S4(N0+1:N1,N0+1:N2,N2+1:N3,N0+1:N1))
       I1=K1*K4*K2
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S4)
       DEALLOCATE(D1)
C
       ALLOCATE(X1(N0+1:N2,N2+1:N3,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N2,N3,N0,N1,N0,N1,X1,S4, 1.0_dp)
       DEALLOCATE(S4)
C
       CALL SUM2413(N0,N2,N2,N3,N0,N1,N0,N1,X1,VBHHHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U2(N2+1:N3,N2+1:N3,N0+1:N1,N0+1:N1))
       I1=K1*K1*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X1,B2,U2)
       DEALLOCATE(B2)
C
       V2C2A=V2C2A-U2
       DEALLOCATE(U2)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N1+1:N3,N2+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER2314(N2,N3,N1,N3,N2,N3,N0,N1,
     & N1,N3,N2,N3,N2,N3,N0,N1,VBHPPP,D1)
       ALLOCATE(U1(N0+1:N1,N2+1:N3,N2+1:N3,N0+1:N1))
       I1=K1*K4*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,U1)
       DEALLOCATE(D1)
C
       CALL
     & SUM4123(N2,N3,N2,N3,N0,N1,N0,N1,V2C2A,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(D1(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER3214(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N1,N3,N2,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER3214(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N1,N3,N2,N3,N0,N1,T2B,D2)
       ALLOCATE(U3(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1))
       I1=K1*K4
       I2=K1*K4
       I3=K3*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N2,N3,N2,N3,N0,N1,N0,N1,V2C2A,U3,-1.0_dp)
       DEALLOCATE(U3)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR2C2C
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR2C2C(N0,N1,N2,N3,V2C2C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V2C2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S5(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       CALL REORDER1423(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N0,N2,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(S5(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S5)
       DEALLOCATE(D1)
C
       ALLOCATE(X1(N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N2),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N2,N3,N0,N2,N0,N2,X1,S5,-1.0_dp)
       DEALLOCATE(S5)
C
       CALL SUM2431(N0,N2,N2,N3,N0,N2,N0,N2,X1,VCHHHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U2(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X1,B2,U2)
       DEALLOCATE(B2)
C
       CALL
     & SUM2134(N2,N3,N2,N3,N0,N2,N0,N2,V2C2C,U2,-1.0_dp)
       DEALLOCATE(U2)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(U1(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM2413(N2,N3,N2,N3,N0,N2,N0,N2,V2C2C,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(U3(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,VCHPPP,T1B,U3)
C
       CALL
     & SUM4123(N2,N3,N2,N3,N0,N2,N0,N2,V2C2C,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U4(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U4)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM2413(N2,N3,N2,N3,N0,N2,N0,N2,V2C2C,U4, 1.0_dp)
       DEALLOCATE(U4)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3A1A0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3A1A0(N0,N1,N2,N3,V3A1A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3A1A(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER4123(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,VAHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3A1A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3A1A(NFT848,N0,N1,N2,N3,V3A1A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3A1A(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
C
       real*8,ALLOCATABLE::VAPPP(:,:,:)
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S7(:,:,:,:)
       real*8,ALLOCATABLE::S9(:,:,:,:)
       real*8,ALLOCATABLE::S11(:,:,:,:)
       real*8,ALLOCATABLE::S18(:,:,:,:)
       real*8,ALLOCATABLE::S15(:,:,:,:)
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S13(:,:,:,:)
       real*8,ALLOCATABLE::S21(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
       real*8,ALLOCATABLE::U5(:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U8(:,:,:,:)
       real*8,ALLOCATABLE::U16(:,:,:,:)
       real*8,ALLOCATABLE::U20(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1))
       CALL REORDER4312(N1,N3,N0,N1,N0,N1,N0,N1,
     & N0,N1,N0,N1,N1,N3,N0,N1,VAHHHP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(S7(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3*K1
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,S7)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X4(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1),SOURCE=0.0D0)
       CALL SUM3124(N0,N1,N1,N3,N1,N3,N0,N1,X4,S7, 1.0_dp)
       DEALLOCATE(S7)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3))
       CALL REORDER1432(N1,N3,N1,N3,N1,N3,N0,N1,
     & N1,N3,N0,N1,N1,N3,N1,N3,VAHPPP,D1)
       ALLOCATE(S9(N0+1:N1,N0+1:N1,N1+1:N3,N1+1:N3))
       I1=K3*K3*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S9)
       DEALLOCATE(D1)
C
       ALLOCATE(X2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N1,N3,N1,N3,N0,N1,X2,S9,-1.0_dp)
       DEALLOCATE(S9)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N0+1:N1,N1+1:N3))
       CALL REORDER1342(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N0,N1,N0,N1,N1,N3,VAHHPP,D1)
       ALLOCATE(S11(N0+1:N1,N0+1:N1,N0+1:N1,N1+1:N3))
       I1=K3*K1*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S11)
       DEALLOCATE(D1)
C
       ALLOCATE(X3(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N0,N1,N1,N3,N0,N1,X3,S11,-1.0_dp)
C
       CALL SUM3412(N0,N1,N0,N1,N1,N3,N0,N1,X3,VAHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N0+1:N1,N1+1:N3,N1+1:N3))
       CALL REORDER3412(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N0,N1,N1,N3,N1,N3,T2A,D2)
       ALLOCATE(U4(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3
       I2=K3*K3
       I3=K1*K1
       CALL EGEMM(I1,I2,I3,X3,D2,U4)
       DEALLOCATE(D2)
C
       CALL
     & SUM1324(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U4, 0.5_dp)
       DEALLOCATE(U4)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1))
       CALL REORDER3241(N0,N1,N0,N1,N0,N1,N1,N3,
     & N0,N1,N0,N1,N1,N3,N0,N1,S11,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(S18(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       I1=K1*K3*K1
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,S18)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL SUM3124(N0,N1,N1,N3,N1,N3,N0,N1,X4,S18,-1.0_dp)
       DEALLOCATE(S18)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N1,N1,N3,VAHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(S15(N1+1:N3,N0+1:N1,N0+1:N1,N1+1:N3))
       I1=K3*K1
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,S15)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3142(N1,N3,N0,N1,N0,N1,N1,N3,
     & N0,N1,N1,N3,N1,N3,N0,N1,S15,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U16(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,U16)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U16, 1.0_dp)
       DEALLOCATE(U16)
       DEALLOCATE(S15)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N1,N1,N3,VAHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N0+1:N1,N1+1:N3))
       I1=K3*K1
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N0+1:N1,N1+1:N3),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER4231(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N1,N1,N3,VAHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(S13(N1+1:N3,N0+1:N1,N0+1:N1,N1+1:N3))
       I1=K3*K1
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,S13)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM3412(N0,N1,N1,N3,N1,N3,N0,N1,X4,S13,-1.0_dp)
       DEALLOCATE(S13)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U8(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X4,B2,U8)
       DEALLOCATE(B2)
C
       V3A1A=V3A1A+U8
       DEALLOCATE(U8)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N0,N1,N1,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(S21(N1+1:N3,N0+1:N1,N0+1:N1,N1+1:N3))
       I1=K3*K1
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,S21)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM2413(N0,N1,N1,N3,N1,N3,N0,N1,X2,S21,-1.0_dp)
       DEALLOCATE(S21)
C
       CALL SUM3421(N0,N1,N1,N3,N1,N3,N0,N1,X2,VAHPHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X2,B2,U2)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U2,-1.0_dp)
       CALL
     & SUM1324(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U2, 1.0_dp)
       DEALLOCATE(U2)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N0,N1,N1,N3,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N0+1:N1,N1+1:N3))
       I1=K3*K1
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       CALL SUM21(N0,N1,N1,N3,X1,FAHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U1(N1+1:N3,N1+1:N3,N0+1:N1,N1+1:N3))
       I1=K3
       I2=K1*K3*K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X1,D2,U1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1342(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(VAPPP(N1+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(U3(N0+1:N1,N1+1:N3,N1+1:N3))
       DO A=N1+1,N3
        READ(NFT848,REC=A-N1)
     &  (((VAPPP(E,C,B),E=N1+1,N3),B=N1+1,N3),C=N1+1,N3)
        I1=K3*K3
        I2=K1
        I3=K3
        CALL EGEMM(I1,I2,I3,VAPPP,T1A,U3)
C
        DO I=N0+1,N1;DO B=N1+1,N3;DO C=N1+1,N3
         V3A1A(C,B,A,I)=V3A1A(C,B,A,I)-U3(I,C,B)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(U3)
       DEALLOCATE(VAPPP)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER4231(N1,N3,N1,N3,N1,N3,N0,N1,
     & N0,N1,N1,N3,N1,N3,N1,N3,VAHPPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U5(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3))
       I1=K3*K3
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U5)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM3412(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U5, 1.0_dp)
       DEALLOCATE(U5)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER4123(N1,N3,N1,N3,N1,N3,N0,N1,
     & N0,N1,N1,N3,N1,N3,N1,N3,VAHPPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U6(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3))
       I1=K3*K3
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U6)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U6, 1.0_dp)
       DEALLOCATE(U6)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER3142(N2,N3,N1,N3,N0,N2,N1,N3,
     & N0,N2,N2,N3,N1,N3,N1,N3,VBPHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U20(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3))
       I1=K3*K3
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U20)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM3412(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U20, 1.0_dp)
       CALL
     & SUM1432(N1,N3,N1,N3,N1,N3,N0,N1,V3A1A,U20,-1.0_dp)
       DEALLOCATE(U20)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3B1B0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3B1B0(N0,N1,N2,N3,V3B1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3B1B(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N1+1:N3,N2+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3*K4
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N2,N3,N1,N3,N1,N3,N0,N2,V3B1B,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3B1B
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3B1B(NFT848,N0,N1,N2,N3,V3B1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3B1B(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2)
       real*8,ALLOCATABLE::VBPPP(:,:,:)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S3(:,:,:,:)
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S12(:,:,:,:)
       real*8,ALLOCATABLE::S14(:,:,:,:)
       real*8,ALLOCATABLE::S16(:,:,:,:)
       real*8,ALLOCATABLE::S18(:,:,:,:)
       real*8,ALLOCATABLE::S20(:,:,:,:)
       real*8,ALLOCATABLE::S25(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::S22(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:,:)
       real*8,ALLOCATABLE::U8(:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U9(:,:,:,:)
       real*8,ALLOCATABLE::U10(:,:,:,:)
       real*8,ALLOCATABLE::U11(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N1,N1,N3,VAHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(S3(N2+1:N3,N0+1:N2,N0+1:N1,N1+1:N3))
       I1=K3*K1
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,S3)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       ALLOCATE(X2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2),SOURCE=0.0D0)
       CALL SUM2413(N0,N1,N2,N3,N1,N3,N0,N2,X2,S3, 1.0_dp)
       DEALLOCATE(S3)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N1,N1,N3,VAHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N0+1:N1,N1+1:N3))
       I1=K3*K1
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N0+1:N1,N1+1:N3),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N2,N1+1:N3,N0+1:N2))
       CALL REORDER4321(N0,N2,N1,N3,N0,N2,N0,N1,
     & N0,N1,N0,N2,N1,N3,N0,N2,VBHHPH,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(S12(N1+1:N3,N0+1:N2,N1+1:N3,N0+1:N2))
       I1=K2*K3*K2
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,S12)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X3(N0+1:N2,N1+1:N3,N1+1:N3,N0+1:N2),SOURCE=0.0D0)
       CALL SUM3124(N0,N2,N1,N3,N1,N3,N0,N2,X3,S12,-1.0_dp)
       DEALLOCATE(S12)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3))
       CALL REORDER1432(N2,N3,N1,N3,N2,N3,N0,N1,
     & N2,N3,N0,N1,N2,N3,N1,N3,VBHPPP,D1)
       ALLOCATE(S14(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       I1=K3*K4*K1
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S14)
       DEALLOCATE(D1)
C
       CALL SUM4123(N0,N1,N2,N3,N1,N3,N0,N2,X2,S14, 1.0_dp)
       DEALLOCATE(S14)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N0,N1,N1,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(S16(N2+1:N3,N0+1:N2,N0+1:N1,N1+1:N3))
       I1=K3*K1
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,S16)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM2413(N0,N1,N2,N3,N1,N3,N0,N2,X2,S16, 1.0_dp)
       DEALLOCATE(S16)
C
       CALL SUM4321(N0,N1,N2,N3,N1,N3,N0,N2,X2,VBHPPH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U4(N1+1:N3,N2+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3*K4
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X2,B2,U4)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N2,N3,N1,N3,N1,N3,N0,N2,V3B1B,U4,-1.0_dp)
       DEALLOCATE(U4)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N1+1:N3,N1+1:N3))
       CALL REORDER1324(N2,N3,N1,N3,N0,N2,N1,N3,
     & N2,N3,N0,N2,N1,N3,N1,N3,VBPHPP,D1)
       ALLOCATE(S18(N0+1:N2,N0+1:N2,N1+1:N3,N1+1:N3))
       I1=K3*K3*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S18)
       DEALLOCATE(D1)
C
       CALL SUM4123(N0,N2,N1,N3,N1,N3,N0,N2,X3,S18, 1.0_dp)
       DEALLOCATE(S18)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N1,N1+1:N3))
       CALL REORDER1342(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N0,N2,N0,N1,N1,N3,VBHHPP,D1)
       ALLOCATE(S20(N0+1:N2,N0+1:N2,N0+1:N1,N1+1:N3))
       I1=K3*K1*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S20)
       DEALLOCATE(D1)
C
       ALLOCATE(X4(N0+1:N2,N0+1:N1,N1+1:N3,N0+1:N2),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N0,N1,N1,N3,N0,N2,X4,S20, 1.0_dp)
C
       CALL SUM4312(N0,N2,N0,N1,N1,N3,N0,N2,X4,VBHHPH, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       CALL REORDER3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,T2B,D2)
       ALLOCATE(U9(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3
       I2=K3*K4
       I3=K1*K2
       CALL EGEMM(I1,I2,I3,X4,D2,U9)
       DEALLOCATE(D2)
C
       CALL
     & SUM1324(N2,N3,N1,N3,N1,N3,N0,N2,V3B1B,U9, 1.0_dp)
       DEALLOCATE(U9)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N2,N1+1:N3,N0+1:N2))
       CALL REORDER3241(N0,N2,N0,N2,N0,N1,N1,N3,
     & N0,N1,N0,N2,N1,N3,N0,N2,S20,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(S25(N1+1:N3,N0+1:N2,N1+1:N3,N0+1:N2))
       I1=K2*K3*K2
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,S25)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL SUM3124(N0,N2,N1,N3,N1,N3,N0,N2,X3,S25,-1.0_dp)
       DEALLOCATE(S25)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N1,N1+1:N3))
       CALL REORDER3142(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N0,N1,N1,N3,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N0+1:N1,N1+1:N3))
       I1=K3*K1
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       CALL SUM21(N0,N1,N1,N3,X1,FAHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,T2B,D2)
       ALLOCATE(U1(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3))
       I1=K3
       I2=K2*K3*K4
       I3=K1
       CALL EGEMM(I1,I2,I3,X1,D2,U1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1342(N2,N3,N1,N3,N1,N3,N0,N2,V3B1B,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N1,N2+1:N3,N0+1:N2,N1+1:N3))
       CALL REORDER4132(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N0,N2,N1,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,T2B,D2)
       ALLOCATE(S22(N1+1:N3,N0+1:N2,N0+1:N2,N1+1:N3))
       I1=K3*K2
       I2=K2*K3
       I3=K4*K1
       CALL EGEMM(I1,I2,I3,D1,D2,S22)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM3412(N0,N2,N1,N3,N1,N3,N0,N2,X3,S22,-1.0_dp)
       DEALLOCATE(S22)
C
       CALL SUM4213(N0,N2,N1,N3,N1,N3,N0,N2,X3,VBPHPH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U7(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3*K3
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X3,B2,U7)
       DEALLOCATE(B2)
C
       V3B1B=V3B1B-U7
       DEALLOCATE(U7)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER4123(N1,N3,N1,N3,N1,N3,N0,N1,
     & N0,N1,N1,N3,N1,N3,N1,N3,VAHPPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(U2(N2+1:N3,N0+1:N2,N1+1:N3,N1+1:N3))
       I1=K3*K3
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N2,N3,N1,N3,N1,N3,N0,N2,V3B1B,U2,-1.0_dp)
       DEALLOCATE(U2)
C
       ALLOCATE(VBPPP(N2+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(U8(N0+1:N2,N1+1:N3,N1+1:N3))
       DO C=N2+1,N3
        READ(NFT848,REC=C-N2+K3+K4)
     &  (((VBPPP(E,B,A),B=N1+1,N3),E=N2+1,N3),A=N1+1,N3)
       I1=K3*K3
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,VBPPP,T1B,U8)
C
        DO I=N0+1,N2;DO A=N1+1,N3;DO B=N1+1,N3
         V3B1B(C,B,A,I)=V3B1B(C,B,A,I)+U8(I,B,A)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(U8)
       DEALLOCATE(VBPPP)
C
       ALLOCATE(D1(N0+1:N1,N2+1:N3,N2+1:N3,N1+1:N3))
       CALL REORDER4132(N2,N3,N1,N3,N2,N3,N0,N1,
     & N0,N1,N2,N3,N2,N3,N1,N3,VBHPPP,D1)
       ALLOCATE(D2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,T2B,D2)
       ALLOCATE(U10(N1+1:N3,N0+1:N2,N2+1:N3,N1+1:N3))
       I1=K3*K4
       I2=K2*K3
       I3=K4*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U10)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM3412(N2,N3,N1,N3,N1,N3,N0,N2,V3B1B,U10,-1.0_dp)
       DEALLOCATE(U10)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N1,N3,
     & N0,N2,N2,N3,N1,N3,N1,N3,VBPHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U11(N2+1:N3,N0+1:N2,N1+1:N3,N1+1:N3))
       I1=K3*K3
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U11)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N2,N3,N1,N3,N1,N3,N0,N2,V3B1B,U11, 1.0_dp)
       DEALLOCATE(U11)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3C1A0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3C1A0(N0,N1,N2,N3,V3C1A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3C1A(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N1)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U1(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,D1,B2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL
     & SUM2134(N2,N3,N2,N3,N1,N3,N0,N1,V3C1A,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3C1A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3C1A(NFT848,N0,N1,N2,N3,V3C1A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3C1A(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N1)
       real*8,ALLOCATABLE::VBPPP(:,:,:)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S8(:,:,:,:)
       real*8,ALLOCATABLE::S10(:,:,:,:)
       real*8,ALLOCATABLE::S12(:,:,:,:)
       real*8,ALLOCATABLE::S14(:,:,:,:)
       real*8,ALLOCATABLE::S21(:,:,:,:)
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S19(:,:,:,:)
       real*8,ALLOCATABLE::S16(:,:,:,:)
       real*8,ALLOCATABLE::S24(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:)
       real*8,ALLOCATABLE::U5(:,:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:,:)
       real*8,ALLOCATABLE::U23(:,:,:,:)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N1,N2+1:N3,N2+1:N3))
       CALL REORDER2431(N2,N3,N1,N3,N2,N3,N0,N1,
     & N1,N3,N0,N1,N2,N3,N2,N3,VBHPPP,D1)
       ALLOCATE(S8(N0+1:N1,N0+1:N1,N2+1:N3,N2+1:N3))
       I1=K4*K4*K1
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S8)
       DEALLOCATE(D1)
C
       ALLOCATE(X2(N0+1:N1,N2+1:N3,N2+1:N3,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N1,N2,N3,N2,N3,N0,N1,X2,S8, 1.0_dp)
       DEALLOCATE(S8)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N2,N2+1:N3,N0+1:N1))
       CALL REORDER4312(N2,N3,N0,N1,N0,N2,N0,N1,
     & N0,N1,N0,N2,N2,N3,N0,N1,VBHHHP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(S10(N1+1:N3,N0+1:N2,N2+1:N3,N0+1:N1))
       I1=K1*K4*K2
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,S10)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X3(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1),SOURCE=0.0D0)
       CALL SUM3124(N0,N2,N2,N3,N1,N3,N0,N1,X3,S10,-1.0_dp)
       DEALLOCATE(S10)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N2,N2+1:N3,N1+1:N3))
       CALL REORDER2314(N2,N3,N1,N3,N0,N2,N1,N3,
     & N1,N3,N0,N2,N2,N3,N1,N3,VBPHPP,D1)
       ALLOCATE(S12(N0+1:N1,N0+1:N2,N2+1:N3,N1+1:N3))
       I1=K3*K4*K2
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S12)
       DEALLOCATE(D1)
C
       CALL SUM4123(N0,N2,N2,N3,N1,N3,N0,N1,X3,S12, 1.0_dp)
       DEALLOCATE(S12)
C
       ALLOCATE(D1(N1+1:N3,N0+1:N2,N0+1:N1,N2+1:N3))
       CALL REORDER2341(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N0,N2,N0,N1,N2,N3,VBHHPP,D1)
       ALLOCATE(S14(N0+1:N1,N0+1:N2,N0+1:N1,N2+1:N3))
       I1=K4*K1*K2
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,D1,T1A,S14)
       DEALLOCATE(D1)
C
       ALLOCATE(X4(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N0,N1,N2,N3,N0,N1,X4,S14, 1.0_dp)
C
       CALL SUM3412(N0,N2,N0,N1,N2,N3,N0,N1,X4,VBHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       CALL REORDER3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,T2B,D2)
       ALLOCATE(U6(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1))
       I1=K1*K4
       I2=K3*K4
       I3=K1*K2
       CALL EGEMM(I1,I2,I3,X4,D2,U6)
       DEALLOCATE(D2)
C
       CALL
     & SUM1324(N2,N3,N2,N3,N1,N3,N0,N1,V3C1A,U6, 1.0_dp)
       DEALLOCATE(U6)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N2,N2+1:N3,N0+1:N1))
       CALL REORDER3241(N0,N1,N0,N2,N0,N1,N2,N3,
     & N0,N1,N0,N2,N2,N3,N0,N1,S14,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(S21(N1+1:N3,N0+1:N2,N2+1:N3,N0+1:N1))
       I1=K1*K4*K2
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,S21)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL SUM3124(N0,N2,N2,N3,N1,N3,N0,N1,X3,S21,-1.0_dp)
       DEALLOCATE(S21)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER4231(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N0,N2,N2,N3,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N0+1:N2,N2+1:N3))
       I1=K4*K2
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N0+1:N2,N2+1:N3),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER4231(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N0,N2,N2,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(S19(N1+1:N3,N0+1:N1,N0+1:N2,N2+1:N3))
       I1=K4*K2
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,S19)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM3412(N0,N2,N2,N3,N1,N3,N0,N1,X3,S19, 1.0_dp)
       DEALLOCATE(S19)
C
       ALLOCATE(D1(N0+1:N2,N1+1:N3,N0+1:N1,N2+1:N3))
       CALL REORDER3241(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N1,N3,N0,N1,N2,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER3214(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N1,N3,N2,N3,N0,N1,T2B,D2)
       ALLOCATE(S16(N2+1:N3,N0+1:N1,N0+1:N1,N2+1:N3))
       I1=K4*K1
       I2=K1*K4
       I3=K3*K2
       CALL EGEMM(I1,I2,I3,D1,D2,S16)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM2413(N0,N1,N2,N3,N2,N3,N0,N1,X2,S16,-1.0_dp)
       DEALLOCATE(S16)
C
       CALL SUM3421(N0,N1,N2,N3,N2,N3,N0,N1,X2,VBHPHP, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U2(N1+1:N3,N2+1:N3,N2+1:N3,N0+1:N1))
       I1=K1*K4*K4
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,X2,B2,U2)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N2,N3,N2,N3,N1,N3,N0,N1,V3C1A,U2,-1.0_dp)
       DEALLOCATE(U2)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER4231(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(S24(N1+1:N3,N0+1:N1,N0+1:N2,N2+1:N3))
       I1=K4*K2
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,S24)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM3412(N0,N2,N2,N3,N1,N3,N0,N1,X3,S24, 1.0_dp)
       DEALLOCATE(S24)
C
       CALL SUM1324(N0,N2,N2,N3,N1,N3,N0,N1,X3,VBHPPH, 1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U4(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X3,B2,U4)
       DEALLOCATE(B2)
C
       V3C1A=V3C1A-U4
       DEALLOCATE(U4)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER3142(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N0+1:N2,N2+1:N3))
       I1=K4*K2
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       CALL SUM21(N0,N2,N2,N3,X1,FBHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U1(N2+1:N3,N1+1:N3,N0+1:N1,N2+1:N3))
       I1=K4
       I2=K1*K3*K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X1,D2,U1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1342(N2,N3,N2,N3,N1,N3,N0,N1,V3C1A,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(VBPPP(N1+1:N3,N2+1:N3,N1+1:N3))
       ALLOCATE(U3(N0+1:N1,N2+1:N3,N1+1:N3))
       DO C=N2+1,N3
        READ(NFT848,REC=C-N2+K3+K4)
     &  (((VBPPP(E,B,A),E=N1+1,N3),B=N2+1,N3),A=N1+1,N3)
       I1=K3*K4
       I2=K1
       I3=K3
       CALL EGEMM(I1,I2,I3,VBPPP,T1A,U3)
C
        DO I=N0+1,N1;DO A=N1+1,N3;DO B=N2+1,N3
         V3C1A(C,B,A,I)=V3C1A(C,B,A,I)+U3(I,B,A)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(U3)
       DEALLOCATE(VBPPP)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4231(N2,N3,N1,N3,N2,N3,N0,N1,
     & N0,N1,N1,N3,N2,N3,N2,N3,VBHPPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N1,N3,N1,N3,N0,N1,T2A,D2)
       ALLOCATE(U5(N1+1:N3,N0+1:N1,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K1*K3
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U5)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM3412(N2,N3,N2,N3,N1,N3,N0,N1,V3C1A,U5, 1.0_dp)
       DEALLOCATE(U5)
C
       ALLOCATE(D1(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3))
       CALL REORDER3214(N2,N3,N1,N3,N0,N2,N1,N3,
     & N0,N2,N1,N3,N2,N3,N1,N3,VBPHPP,D1)
       ALLOCATE(D2(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER3214(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N1,N3,N2,N3,N0,N1,T2B,D2)
       ALLOCATE(U7(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3))
       I1=K3*K4
       I2=K1*K4
       I3=K3*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U7)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N2,N3,N2,N3,N1,N3,N0,N1,V3C1A,U7,-1.0_dp)
       DEALLOCATE(U7)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4231(N2,N3,N2,N3,N2,N3,N0,N2,
     & N0,N2,N2,N3,N2,N3,N2,N3,VCHPPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       CALL REORDER3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,T2B,D2)
       ALLOCATE(U23(N1+1:N3,N0+1:N1,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K1*K3
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U23)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM3412(N2,N3,N2,N3,N1,N3,N0,N1,V3C1A,U23, 1.0_dp)
       DEALLOCATE(U23)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3D1B0
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3D1B0(N0,N1,N2,N3,V3D1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3D1B(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U1(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4123(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U1(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,D1,B2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR3D1B
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR3D1B(NFT848,N0,N1,N2,N3,V3D1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V3D1B(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8,ALLOCATABLE::VCPPP(:,:,:)
C
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::Q1(:,:)
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::S11(:,:,:,:)
       real*8,ALLOCATABLE::S13(:,:,:,:)
       real*8,ALLOCATABLE::S15(:,:,:,:)
       real*8,ALLOCATABLE::S22(:,:,:,:)
       real*8,ALLOCATABLE::S19(:,:,:,:)
       real*8,ALLOCATABLE::Q2(:,:)
       real*8,ALLOCATABLE::S17(:,:,:,:)
       real*8,ALLOCATABLE::X1(:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:)
       real*8,ALLOCATABLE::X2(:,:,:,:)
       real*8,ALLOCATABLE::U5(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:)
       real*8,ALLOCATABLE::X3(:,:,:,:)
       real*8,ALLOCATABLE::U8(:,:,:,:)
       real*8,ALLOCATABLE::U9(:,:,:,:)
       real*8,ALLOCATABLE::U10(:,:,:,:)
       real*8,ALLOCATABLE::X4(:,:,:,:)
       real*8,ALLOCATABLE::U12(:,:,:,:)
       real*8,ALLOCATABLE::U20(:,:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER4231(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N0,N2,N2,N3,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(Q1(N0+1:N2,N2+1:N3))
       I1=K4*K2
       I3=K3*K1
       CALL EGEMM1(I1,I3,D1,B2,Q1)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N0+1:N2,N2+1:N3),SOURCE=0.0D0)
       X1=X1+Q1
       DEALLOCATE(Q1)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER4231(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N0,N2,N2,N3,VBHHPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(S4(N2+1:N3,N0+1:N2,N0+1:N2,N2+1:N3))
       I1=K4*K2
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,S4)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       ALLOCATE(X2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2),SOURCE=0.0D0)
       CALL SUM3412(N0,N2,N2,N3,N2,N3,N0,N2,X2,S4, 1.0_dp)
       DEALLOCATE(S4)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2))
       CALL REORDER4312(N2,N3,N0,N2,N0,N2,N0,N2,
     & N0,N2,N0,N2,N2,N3,N0,N2,VCHHHP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(S11(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4*K2
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,D1,B2,S11)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X4(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2),SOURCE=0.0D0)
       CALL SUM3124(N0,N2,N2,N3,N2,N3,N0,N2,X4,S11, 1.0_dp)
       DEALLOCATE(S11)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3))
       CALL REORDER1432(N2,N3,N2,N3,N2,N3,N0,N2,
     & N2,N3,N0,N2,N2,N3,N2,N3,VCHPPP,D1)
       ALLOCATE(S13(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3))
       I1=K4*K4*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S13)
       DEALLOCATE(D1)
C
       CALL SUM4132(N0,N2,N2,N3,N2,N3,N0,N2,X2,S13, 1.0_dp)
       DEALLOCATE(S13)
C
       CALL SUM2431(N0,N2,N2,N3,N2,N3,N0,N2,X2,VCHPHP,-1.0_dp)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U5(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X2,B2,U5)
       DEALLOCATE(B2)
C
       V3D1B=V3D1B-U5
       CALL
     & SUM3214(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U5, 1.0_dp)
       DEALLOCATE(U5)
       DEALLOCATE(X2)
C
       ALLOCATE(D1(N2+1:N3,N0+1:N2,N0+1:N2,N2+1:N3))
       CALL REORDER1342(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N0,N2,N0,N2,N2,N3,VCHHPP,D1)
       ALLOCATE(S15(N0+1:N2,N0+1:N2,N0+1:N2,N2+1:N3))
       I1=K4*K2*K2
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,D1,T1B,S15)
       DEALLOCATE(D1)
C
       ALLOCATE(X3(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N0,N2,N2,N3,N0,N2,X3,S15,-1.0_dp)
C
       CALL SUM3412(N0,N2,N0,N2,N2,N3,N0,N2,X3,VCHHHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3))
       CALL REORDER3412(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N0,N2,N2,N3,N2,N3,T2C,D2)
       ALLOCATE(U8(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4
       I2=K4*K4
       I3=K2*K2
       CALL EGEMM(I1,I2,I3,X3,D2,U8)
       DEALLOCATE(D2)
C
       CALL
     & SUM1324(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U8, 0.5_dp)
       DEALLOCATE(U8)
       DEALLOCATE(X3)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2))
       CALL REORDER3241(N0,N2,N0,N2,N0,N2,N2,N3,
     & N0,N2,N0,N2,N2,N3,N0,N2,S15,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(S22(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       I1=K2*K4*K2
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,D1,B2,S22)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL SUM3124(N0,N2,N2,N3,N2,N3,N0,N2,X4,S22,-1.0_dp)
       DEALLOCATE(S22)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER3142(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(S19(N2+1:N3,N0+1:N2,N0+1:N2,N2+1:N3))
       I1=K4*K2
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,S19)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3142(N2,N3,N0,N2,N0,N2,N2,N3,
     & N0,N2,N2,N3,N2,N3,N0,N2,S19,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U20(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,D1,B2,U20)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       CALL
     & SUM3124(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U20, 1.0_dp)
       DEALLOCATE(U20)
       DEALLOCATE(S19)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER3142(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(Q2(N0+1:N2,N2+1:N3))
       I1=K4*K2
       I3=K4*K2
       CALL EGEMM1(I1,I3,D1,B2,Q2)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       X1=X1+Q2
       DEALLOCATE(Q2)
C
       CALL SUM21(N0,N2,N2,N3,X1,FBHP, 1.0_dp)
C
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U1(N2+1:N3,N2+1:N3,N0+1:N2,N2+1:N3))
       I1=K4
       I2=K2*K4*K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X1,D2,U1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1342(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U1,-1.0_dp)
       DEALLOCATE(U1)
       DEALLOCATE(X1)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       CALL REORDER4231(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(S17(N2+1:N3,N0+1:N2,N0+1:N2,N2+1:N3))
       I1=K4*K2
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,S17)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL SUM3412(N0,N2,N2,N3,N2,N3,N0,N2,X4,S17,-1.0_dp)
       DEALLOCATE(S17)
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U12(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,X4,B2,U12)
       DEALLOCATE(B2)
C
       V3D1B=V3D1B+U12
       DEALLOCATE(U12)
       DEALLOCATE(X4)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4231(N2,N3,N1,N3,N2,N3,N0,N1,
     & N0,N1,N1,N3,N2,N3,N2,N3,VBHPPP,D1)
       ALLOCATE(D2(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER4213(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,T2B,D2)
       ALLOCATE(U2(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K2*K4
       I3=K3*K1
       CALL EGEMM(I1,I2,I3,D1,D2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM3412(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U2, 1.0_dp)
       CALL
     & SUM1432(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U2,-1.0_dp)
       DEALLOCATE(U2)
C
       ALLOCATE(VCPPP(N2+1:N3,N2+1:N3,N2+1:N3))
       ALLOCATE(U7(N0+1:N2,N2+1:N3,N2+1:N3))
       DO A=N2+1,N3
        READ(NFT848,REC=A-N2+K3)
     &  (((VCPPP(E,C,B),E=N2+1,N3),B=N2+1,N3),C=N2+1,N3)
       I1=K4*K4
       I2=K2
       I3=K4
       CALL EGEMM(I1,I2,I3,VCPPP,T1B,U7)
C
        DO I=N0+1,N2;DO B=N2+1,N3;DO C=N2+1,N3
         V3D1B(C,B,A,I)=V3D1B(C,B,A,I)-U7(I,C,B)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(U7)
       DEALLOCATE(VCPPP)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4231(N2,N3,N2,N3,N2,N3,N0,N2,
     & N0,N2,N2,N3,N2,N3,N2,N3,VCHPPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U9(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U9)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM3412(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U9, 1.0_dp)
       DEALLOCATE(U9)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4123(N2,N3,N2,N3,N2,N3,N0,N2,
     & N0,N2,N2,N3,N2,N3,N2,N3,VCHPPP,D1)
       ALLOCATE(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,T2C,D2)
       ALLOCATE(U10(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K2*K4
       I3=K4*K2
       CALL EGEMM(I1,I2,I3,D1,D2,U10)
       DEALLOCATE(D1)
       DEALLOCATE(D2)
C
       CALL
     & SUM1423(N2,N3,N2,N3,N2,N3,N0,N2,V3D1B,U10, 1.0_dp)
       DEALLOCATE(U10)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR4A0A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR4A0A(N0,N1,N2,N3,V4A0A,A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V4A0A(N1+1:N3,N1+1:N3,N1+1:N3)
C
       real*8,ALLOCATABLE::A2(:)
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S3(:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N1,N1+1:N3,N1+1:N3))
       CALL REORDER4312(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N0,N1,N1,N3,N1,N3,VAHHPP,D1)
       ALLOCATE(A2(N0+1:N1))
       DO M=N0+1,N1
        A2(M)=T1A(A,M)
       ENDDO
       ALLOCATE(S3(N0+1:N1,N1+1:N3,N1+1:N3))
       I1=K3*K3*K1
       I3=K1
       CALL EGEMM1(I1,I3,D1,A2,S3)
       DEALLOCATE(D1)
C
       DO M=N0+1,N1;DO C=N1+1,N3;DO D=N1+1,N3
        S3(M,D,C)=S3(M,D,C)+VAHPPP(D,C,A,M)
       ENDDO;ENDDO;ENDDO
C
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U4(N1+1:N3,N1+1:N3,N1+1:N3))
       I1=K3*K3
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,S3,B2,U4)
       DEALLOCATE(B2)
C
       CALL
     & SUM312(N1,N3,N1,N3,N1,N3,V4A0A,U4, 1.0_dp)
       DEALLOCATE(U4)
       DEALLOCATE(S3)
C
       ALLOCATE(D1(N0+1:N1,N1+1:N3,N1+1:N3,N1+1:N3))
       CALL REORDER4123(N1,N3,N1,N3,N1,N3,N0,N1,
     & N0,N1,N1,N3,N1,N3,N1,N3,VAHPPP,D1)
       ALLOCATE(U1(N1+1:N3,N1+1:N3,N1+1:N3))
       I1=K3*K3*K3
       I3=K1
       CALL EGEMM1(I1,I3,D1,A2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(A2)
C
       V4A0A=V4A0A-U1
!      CALL
!    & SUM123(N1,N3,N1,N3,N1,N3,V4A0A,U1,-1.0_dp)
!      CALL
!    & SUM312(N1,N3,N1,N3,N1,N3,V4A0A,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N1,N1+1:N3,N1+1:N3))
       CALL REORDER3412(N1,N3,N1,N3,N0,N1,N0,N1,
     & N0,N1,N0,N1,N1,N3,N1,N3,VAHHPP,D1)
       ALLOCATE(C2(N0+1:N1,N0+1:N1,N1+1:N3))
       DO B=N1+1,N3;DO M=N0+1,N1;DO N=N0+1,N1
        C2(N,M,B)=T2A(B,A,N,M)
       ENDDO;ENDDO;ENDDO
       ALLOCATE(U2(N1+1:N3,N1+1:N3,N1+1:N3))
       I1=K3*K3
       I2=K3
       I3=K1*K1
       CALL EGEMM(I1,I2,I3,D1,C2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(C2)
C
       CALL
     & SUM312(N1,N3,N1,N3,N1,N3,V4A0A,U2, 0.5_dp)
       DEALLOCATE(U2)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR4C0A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR4C0A(N0,N1,N2,N3,V4C0A,C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V4C0A(N2+1:N3,N1+1:N3,N1+1:N3)
C
       real*8,ALLOCATABLE::A2(:)
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S4(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:)
       real*8,ALLOCATABLE::X1(:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:)
C
       ALLOCATE(D1(N0+1:N1,N0+1:N2,N2+1:N3,N1+1:N3))
       CALL REORDER4312(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N0,N2,N2,N3,N1,N3,VBHHPP,D1)
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(S4(N1+1:N3,N0+1:N2,N2+1:N3,N1+1:N3))
       I1=K3*K4*K2
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,D1,B2,S4)
       DEALLOCATE(D1)
       DEALLOCATE(B2)
C
       ALLOCATE(X1(N0+1:N2,N2+1:N3,N1+1:N3,N1+1:N3),SOURCE=0.0D0)
       CALL SUM4123(N0,N2,N2,N3,N1,N3,N1,N3,X1,S4,-1.0_dp)
       DEALLOCATE(S4)
C
       CALL SUM2314(N0,N2,N2,N3,N1,N3,N1,N3,X1,VBPHPP, 1.0_dp)
C
       ALLOCATE(A2(N0+1:N2))
       DO M=N0+1,N2
        A2(M)=T1B(C,M)
       ENDDO
       ALLOCATE(U2(N2+1:N3,N1+1:N3,N1+1:N3))
       I1=K3*K3*K4
       I3=K2
       CALL EGEMM1(I1,I3,X1,A2,U2)
       DEALLOCATE(A2)
C
       V4C0A=V4C0A-U2
       DEALLOCATE(U2)
       DEALLOCATE(X1)
C
       ALLOCATE(C1(N0+1:N1,N2+1:N3,N1+1:N3))
       DO B=N1+1,N3;DO D=N2+1,N3;DO M=N0+1,N1
        C1(M,D,B)=VBHPPP(D,B,C,M)
       ENDDO;ENDDO;ENDDO
       ALLOCATE(B2(N0+1:N1,N1+1:N3))
       CALL REORDER21(N1,N3,N0,N1,
     & N0,N1,N1,N3,T1A,B2)
       ALLOCATE(U1(N1+1:N3,N2+1:N3,N2+1:N3))
       I1=K3*K4
       I2=K3
       I3=K1
       CALL EGEMM(I1,I2,I3,C1,B2,U1)
       DEALLOCATE(C1)
       DEALLOCATE(B2)
C
       CALL
     & SUM312(N2,N3,N1,N3,N1,N3,V4C0A,U1,-1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       CALL REORDER3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,VBHHPP,D1)
       ALLOCATE(C2(N0+1:N2,N0+1:N1,N1+1:N3))
       DO A=N1+1,N3;DO M=N0+1,N1;DO N=N0+1,N2
        C2(N,M,A)=T2B(C,A,N,M)
       ENDDO;ENDDO;ENDDO
       ALLOCATE(U3(N1+1:N3,N2+1:N3,N1+1:N3))
       I1=K3*K4
       I2=K3
       I3=K1*K2
       CALL EGEMM(I1,I2,I3,D1,C2,U3)
       DEALLOCATE(D1)
       DEALLOCATE(C2)
C
       CALL
     & SUM312(N2,N3,N1,N3,N1,N3,V4C0A,U3, 1.0_dp)
       DEALLOCATE(U3)
C
       END
C
C*MODULE DEAEOMDIP DECK HBAR4E0A
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param FAHH Fock alpha HH array
C> @param FAHP Fock alpha HP array
C> @param FAPP Fock alpha PP array
C> @param FBHH Fock beta HH array
C> @param FBHP Fock beta HP array
C> @param FBPP Fock beta PP array
C> @param VAHHHH Twobody alpha-alpha HHHH array
C> @param VAHHHP Twobody alpha-alpha HHHP array
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VAHPHP Twobody alpha-alpha HPHP array
C> @param VAHPPP Twobody alpha-alpha HPPP array
C> @param VBHHHH Twobody alpha-beta HHHH array
C> @param VBHHHP Twobody alpha-beta HHHP array
C> @param VBHHPH Twobody alpha-beta HHPH array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VBHPHP Twobody alpha-beta HPHP array
C> @param VBHPPH Twobody alpha-beta HPPH array
C> @param VBPHPH Twobody alpha-beta PHPH array
C> @param VBHPPP Twobody alpha-beta HPPP array
C> @param VBPHPP Twobody alpha-beta HPPP array
C> @param VCHHHH Twobody beta-beta HHHH array
C> @param VCHHHP Twobody beta-beta HHHP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param VCHPHP Twobody beta-beta HPHP array
C> @param VCHPPP Twobody beta-beta HPPP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C>
       SUBROUTINE HBAR4E0A(N0,N1,N2,N3,V4E0A,A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T1A,T1B,T2A,T2B,T2C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,G,H,I,J,K,M,N,O,P
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAHP(N1+1:N3,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBHP(N2+1:N3,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
C
       real*8 V4E0A(N2+1:N3,N2+1:N3,N2+1:N3)
C
       real*8,ALLOCATABLE::A2(:)
       real*8,ALLOCATABLE::B1(:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::D1(:,:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::S3(:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3))
       CALL REORDER4312(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N0,N2,N2,N3,N2,N3,VCHHPP,D1)
       ALLOCATE(A2(N0+1:N2))
       DO M=N0+1,N2
        A2(M)=T1B(A,M)
       ENDDO
       ALLOCATE(S3(N0+1:N2,N2+1:N3,N2+1:N3))
       I1=K4*K4*K2
       I3=K2
       CALL EGEMM1(I1,I3,D1,A2,S3)
       DEALLOCATE(D1)
C
       DO M=N0+1,N2;DO C=N2+1,N3;DO D=N2+1,N3
        S3(M,D,C)=S3(M,D,C)+VAHPPP(D,C,A,M)
       ENDDO;ENDDO;ENDDO
C
       ALLOCATE(B2(N0+1:N2,N2+1:N3))
       CALL REORDER21(N2,N3,N0,N2,
     & N0,N2,N2,N3,T1B,B2)
       ALLOCATE(U4(N2+1:N3,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K4
       I3=K2
       CALL EGEMM(I1,I2,I3,S3,B2,U4)
       DEALLOCATE(B2)
C
       CALL
     & SUM312(N2,N3,N2,N3,N2,N3,V4E0A,U4, 1.0_dp)
       DEALLOCATE(U4)
       DEALLOCATE(S3)
C
       ALLOCATE(D1(N0+1:N2,N2+1:N3,N2+1:N3,N2+1:N3))
       CALL REORDER4123(N2,N3,N2,N3,N2,N3,N0,N2,
     & N0,N2,N2,N3,N2,N3,N2,N3,VCHPPP,D1)
       ALLOCATE(U1(N2+1:N3,N2+1:N3,N2+1:N3))
       I1=K4*K4*K4
       I3=K2
       CALL EGEMM1(I1,I3,D1,A2,U1)
       DEALLOCATE(D1)
       DEALLOCATE(A2)
C
       V4E0A=V4E0A-U1
!      CALL
!    & SUM123(N2,N3,N2,N3,N2,N3,V4E0A,U1,-1.0_dp)
!      CALL
!    & SUM312(N2,N3,N2,N3,N2,N3,V4E0A,U1, 1.0_dp)
       DEALLOCATE(U1)
C
       ALLOCATE(D1(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3))
       CALL REORDER3412(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N0,N2,N2,N3,N2,N3,VCHHPP,D1)
       ALLOCATE(C2(N0+1:N2,N0+1:N2,N2+1:N3))
       DO B=N2+1,N3;DO M=N0+1,N2;DO N=N0+1,N2
        C2(N,M,B)=T2C(B,A,N,M)
       ENDDO;ENDDO;ENDDO
       ALLOCATE(U2(N2+1:N3,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K4
       I3=K2*K2
       CALL EGEMM(I1,I2,I3,D1,C2,U2)
       DEALLOCATE(D1)
       DEALLOCATE(C2)
C
       CALL
     & SUM312(N2,N3,N2,N3,N2,N3,V4E0A,U2, 0.5_dp)
       DEALLOCATE(U2)
C
       END
