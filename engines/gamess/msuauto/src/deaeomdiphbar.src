C*MODULE DEAEOMDIP DECK DEAEOMDIP_HBAR
C> @brief CALCULATE HBAR
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param NOA number of occupied alpha orbitals (excluding frozen core)
C> @param NOB number of occupied beta orbitals (excluding frozen core)
C> @param NUA number of virtual orbitals
C> @param EREF ROHF REFERENCE ENERGY
C> @param ENRG CCSD correlation energy
C>
      SUBROUTINE DEAEOMDIP_HBAR(IO,NOA,NOB,NUA,EREF,ENRG)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
      use mx_limits, only: mxatm,mxao
      use modcc, only: AMPTSH,METHCC,NCCTOT,NCCOCC,NCCFZC,NCCFZV,
     *                 MXCCIT,MXRLEIT,MWRDCC,ICCCNV,ICCRST,IDSKCC
C
      IMPLICIT NONE
      INTEGER NFT820,NFT821,NFT822,NFT823,NFT825,NFT826,NFT827,
     *                NFT828,NFT829,NFT830,NFT831,NFT832,NFT833,NFT834,
     *                NFT835,NFT836,NFT837,NFT838,NFT839,NFT843,NFT848,
     *                NFT858,NFT859,NFT891,NFT892,NFT899
      INTEGER IO,NOA,NOB,NUA,NREF,NSAVE,IREF
      real*8 EREF,ENRG
      COMMON /CCOPIO/ NFT820,NFT821,NFT822,NFT823,NFT825,NFT826,NFT827,
     *                NFT828,NFT829,NFT830,NFT831,NFT832,NFT833,NFT834,
     *                NFT835,NFT836,NFT837,NFT838,NFT839,NFT843,NFT848,
     *                NFT858,NFT859,NFT891,NFT892,NFT899
      COMMON /DEAIPPAR / NREF,NSAVE
      CHARACTER*800 FNAME
      PARAMETER(IREF=124)
      LOGICAL GOPARR,DSKWRK,MASWRK
      INTEGER ME,MASTER,NPROC,IBTYP,IPTIM
      COMMON /PAR   / ME,MASTER,NPROC,IBTYP,IPTIM,GOPARR,DSKWRK,MASWRK
C
        INTEGER A,B,C,D,I,J,K,L,I0,KKK
        INTEGER K1A,K1B,K2A,K2B,K2C
        INTEGER N0,N1,N2,N3,K1,K2,K3,K4
        real*8,ALLOCATABLE:: T(:)
        real*8,ALLOCATABLE:: FAHH(:,:)
        real*8,ALLOCATABLE:: FAHP(:,:)
        real*8,ALLOCATABLE:: FAPP(:,:)
        real*8,ALLOCATABLE:: FBHH(:,:)
        real*8,ALLOCATABLE:: FBHP(:,:)
        real*8,ALLOCATABLE:: FBPP(:,:)
        real*8,ALLOCATABLE:: VAHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: VAHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: VAHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: VAHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: VAHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: VBHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: VBHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: VBHHPH(:,:,:,:)
        real*8,ALLOCATABLE:: VBHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: VBHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: VBHPPH(:,:,:,:)
        real*8,ALLOCATABLE:: VBPHPH(:,:,:,:)
        real*8,ALLOCATABLE:: VBHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: VBPHPP(:,:,:,:)
        real*8,ALLOCATABLE:: VCHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: VCHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: VCHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: VCHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: VCHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: HAHH(:,:)
        real*8,ALLOCATABLE:: HAHP(:,:)
        real*8,ALLOCATABLE:: HAPP(:,:)
        real*8,ALLOCATABLE:: HBHH(:,:)
        real*8,ALLOCATABLE:: HBHP(:,:)
        real*8,ALLOCATABLE:: HBPP(:,:)
        real*8,ALLOCATABLE:: HAHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HAHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HAHPHH(:,:,:,:)
        real*8,ALLOCATABLE:: HAHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: HAHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HAHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: HAPPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPHH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHHPH(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPPH(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHPH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHPP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPPPH(:,:,:,:)
        real*8,ALLOCATABLE:: HCHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HCHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HCHPHH(:,:,:,:)
        real*8,ALLOCATABLE:: HCHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: HCHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HCHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: HCPPHP(:,:,:,:)
C
        real*8,ALLOCATABLE:: V0A2A(:,:)
        real*8,ALLOCATABLE:: V1A1A(:,:)
        real*8,ALLOCATABLE:: V2A0A(:,:)
        real*8,ALLOCATABLE:: V0A2C(:,:)
        real*8,ALLOCATABLE:: V1B1B(:,:)
        real*8,ALLOCATABLE:: V2C0A(:,:)
        real*8,ALLOCATABLE:: V0A4A(:,:,:,:)
        real*8,ALLOCATABLE:: V0A4C(:,:,:,:)
        real*8,ALLOCATABLE:: V0A4E(:,:,:,:)
        real*8,ALLOCATABLE:: V1A3A(:,:,:,:)
        real*8,ALLOCATABLE:: V1A3C(:,:,:,:)
        real*8,ALLOCATABLE:: V1B3B(:,:,:,:)
        real*8,ALLOCATABLE:: V1B3D(:,:,:,:)
        real*8,ALLOCATABLE:: V2A2A(:,:,:,:)
        real*8,ALLOCATABLE:: V2A2C(:,:,:,:)
        real*8,ALLOCATABLE:: V2B2B(:,:,:,:)
        real*8,ALLOCATABLE:: V2C2A(:,:,:,:)
        real*8,ALLOCATABLE:: V2C2C(:,:,:,:)
        real*8,ALLOCATABLE:: V3A1A(:,:,:,:)
        real*8,ALLOCATABLE:: V3B1B(:,:,:,:)
        real*8,ALLOCATABLE:: V3C1A(:,:,:,:)
        real*8,ALLOCATABLE:: V3D1B(:,:,:,:)
        real*8,ALLOCATABLE:: V4A0A(:,:,:)
        real*8,ALLOCATABLE:: V4C0A(:,:,:)
        real*8,ALLOCATABLE:: V4E0A(:,:,:)
C
       N0=NCCFZC
       N1=NOA+N0
       N2=NOB+N0
       N3=N1+NUA
       K1=N1-N0;K3=N3-N1 !OCC
       K2=N2-N0;K4=N3-N2 !VIR
       KKK=0
       K1A =KKK+1;KKK=KKK+K1*K3
       K1B =KKK+1;KKK=KKK+K2*K4
       K2A =KKK+1;KKK=KKK+K1*K1*K3*K3
       K2B =KKK+1;KKK=KKK+K1*K2*K3*K4
       K2C =KKK+1;KKK=KKK+K2*K2*K4*K4
C
       IF(NSAVE.NE.0)THEN
        CALL GMS_GETENV("CCSD3AA", FNAME)
        OPEN(IREF,FILE=TRIM(FNAME)//'.REF',FORM='UNFORMATTED')
        IF(NSAVE.EQ.2)THEN
         READ(IREF)NOA,NOB,NUA,EREF,ENRG
         IF(MASWRK)WRITE(IO,96) EREF,ENRG+EREF,ENRG
         ALLOCATE(T(KKK))
         CALL GAMESS_READ
     &   (IO,NFT825,N0,N1,N2,N3,T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
         DEALLOCATE(T)
         CALL FLSHBF(IO)
         RETURN
        ELSEIF(NSAVE.EQ.1)THEN
         WRITE(IREF)NOA,NOB,NUA,EREF,ENRG
        ENDIF
        CLOSE(IREF)
       ENDIF
       IF(MASWRK)WRITE(IO,1000)
       CALL FLSHBF(IO)
   96 FORMAT(/25X,'SUMMARY OF PREVIOUS CCSD RESULTS',//
     *        5X,'REFERENCE ENERGY:',F20.10,/
     *        10X,'CCSD ENERGY:',F20.10,3X,'CORR. E=',F15.10, /)
 1000 FORMAT(/8X,34(1H-)/
     *        8X,'CALCULATE HBAR FOR DEA/DIP EOMCC'/,
     *        8X,34(1H-))
C
       ALLOCATE(FAHH(N0+1:N1,N0+1:N1))
       ALLOCATE(FAHP(N1+1:N3,N0+1:N1))
       ALLOCATE(FAPP(N1+1:N3,N1+1:N3))
       ALLOCATE(FBHH(N0+1:N2,N0+1:N2))
       ALLOCATE(FBHP(N2+1:N3,N0+1:N2))
       ALLOCATE(FBPP(N2+1:N3,N2+1:N3))
       ALLOCATE(VAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       ALLOCATE(VAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       ALLOCATE(VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       ALLOCATE(VAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       ALLOCATE(VAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       ALLOCATE(VBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1))
       ALLOCATE(VBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1))
       ALLOCATE(VBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1))
       ALLOCATE(VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1))
       ALLOCATE(VBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1))
       ALLOCATE(VBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1))
       ALLOCATE(VBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3))
       ALLOCATE(VBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1))
       ALLOCATE(VBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3))
       ALLOCATE(VCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       ALLOCATE(VCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       ALLOCATE(VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2))
       ALLOCATE(VCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       ALLOCATE(VCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
C
       READ(NFT843,REC=7)FAHH
       READ(NFT843,REC=5)FAHP
       READ(NFT843,REC=9)FAPP
       READ(NFT843,REC=8)FBHH
       READ(NFT843,REC=6)FBHP
       READ(NFT843,REC=10)FBPP
C
       I0=0
       DO I=N0+1,N1;DO J=N0+1,N1
        I0=I0+1
        READ(NFT820,REC=I0)((VAHHHH(I,J,K,L),L=N0+1,N1),K=N0+1,N1)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N0+1,N2
        I0=I0+1
        READ(NFT821,REC=I0)((VCHHHH(I,J,K,L),L=N0+1,N2),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N0+1,N1
        I0=I0+1
        READ(NFT822,REC=I0)((VBHHHH(I,J,K,L),L=N0+1,N1),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N1+1,N3;DO J=N0+1,N1
        I0=I0+1
        READ(NFT823,REC=I0)((VAHHHP(I,J,K,L),L=N0+1,N1),K=N0+1,N1)
       ENDDO;ENDDO
       I0=0
       DO I=N2+1,N3;DO J=N0+1,N2
        I0=I0+1
        READ(NFT826,REC=I0)((VCHHHP(I,J,K,L),L=N0+1,N2),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N1+1,N3
        I0=I0+1
        READ(NFT827,REC=I0)((VBHHPH(I,J,K,L),L=N0+1,N1),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N2+1,N3;DO J=N0+1,N1
        I0=I0+1
        READ(NFT828,REC=I0)((VBHHHP(I,J,K,L),L=N0+1,N1),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N1;DO J=N1+1,N3
        I0=I0+1
        READ(NFT829,REC=I0)((VAHHPP(L,J,K,I),L=N1+1,N3),K=N0+1,N1)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N2+1,N3
        I0=I0+1
        READ(NFT830,REC=I0)((VCHHPP(L,J,K,I),L=N2+1,N3),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N2+1,N3
        I0=I0+1
        READ(NFT833,REC=I0)((VBHHPP(J,L,I,K),L=N1+1,N3),K=N0+1,N1)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N1;DO J=N1+1,N3
        I0=I0+1
        READ(NFT831,REC=I0)((VAHPHP(J,K,L,I),L=N1+1,N3),K=N0+1,N1)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N2+1,N3
        I0=I0+1
        READ(NFT832,REC=I0)((VCHPHP(J,K,L,I),L=N2+1,N3),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N1+1,N3
        I0=I0+1
        READ(NFT834,REC=I0)((VBPHPH(I,J,K,L),L=N1+1,N3),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N1;DO J=N2+1,N3
        I0=I0+1
        READ(NFT835,REC=I0)((VBHPHP(L,K,J,I),L=N2+1,N3),K=N0+1,N1)
       ENDDO;ENDDO
       DO I=N0+1,N1;DO J=N0+1,N2;DO K=N1+1,N3;DO L=N2+1,N3
        VBHPPH(J,K,L,I)= VBHHPP(L,K,J,I)
       ENDDO;ENDDO;ENDDO;ENDDO
       I0=0
       DO I=N0+1,N1;DO J=N1+1,N3
        I0=I0+1
        READ(NFT836,REC=I0)((VAHPPP(L,K,J,I),L=N1+1,N3),K=N1+1,N3)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N2+1,N3
        I0=I0+1
        READ(NFT837,REC=I0)((VCHPPP(L,K,J,I),L=N2+1,N3),K=N2+1,N3)
       ENDDO;ENDDO
       I0=0
       DO I=N2+1,N3;DO J=N0+1,N1
        I0=I0+1
        READ(NFT838,REC=I0)((VBHPPP(K,L,I,J),L=N1+1,N3),K=N2+1,N3)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N1+1,N3
        I0=I0+1
        READ(NFT839,REC=I0)((VBPHPP(K,L,I,J),L=N1+1,N3),K=N2+1,N3)
       ENDDO;ENDDO
C
       ALLOCATE(T(KKK))
       CALL GAMESS_READ
     & (0,NFT825,N0,N1,N2,N3,T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
C
       ALLOCATE(V0A2A(N0+1:N1,N0+1:N1),SOURCE=FAHH)
C
       CALL HBAR0A2A(N0,N1,N2,N3,V0A2A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HAHH
       WRITE(NFT891,REC=3)V0A2A
       DEALLOCATE(V0A2A)
C
       ALLOCATE(V1A1A(N1+1:N3,N0+1:N1),SOURCE=FAHP)
C
       CALL HBAR1A1A(N0,N1,N2,N3,V1A1A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HAHP
       WRITE(NFT891,REC=5)((V1A1A(A,I),I=N0+1,N1),A=N1+1,N3)
       DEALLOCATE(V1A1A)
C
       ALLOCATE(V2A0A(N1+1:N3,N1+1:N3),SOURCE=FAPP)
C
       CALL HBAR2A0A(N0,N1,N2,N3,V2A0A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HAPP
       WRITE(NFT891,REC=1)V2A0A
       DEALLOCATE(V2A0A)
      IF(MASWRK)WRITE(IO,*)'H1A FINISHED'
       CALL FLSHBF(IO)
C
       ALLOCATE(V0A2C(N0+1:N2,N0+1:N2),SOURCE=FBHH)
C
       CALL HBAR0A2C(N0,N1,N2,N3,V0A2C,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HBHH
       WRITE(NFT891,REC=4)V0A2C
       DEALLOCATE(V0A2C)
C
       ALLOCATE(V1B1B(N2+1:N3,N0+1:N2),SOURCE=FBHP)
C
       CALL HBAR1B1B(N0,N1,N2,N3,V1B1B,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HBHP
       WRITE(NFT891,REC=6)((V1B1B(A,I),I=N0+1,N2),A=N2+1,N3)
       DEALLOCATE(V1B1B)
C
       ALLOCATE(V2C0A(N2+1:N3,N2+1:N3),SOURCE=FBPP)
C
       CALL HBAR2C0A(N0,N1,N2,N3,V2C0A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
     & VCHHHH,VCHHHP,VCHHPP,VCHPHP,VCHPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
!HBPP
       WRITE(NFT891,REC=2)V2C0A
       DEALLOCATE(V2C0A)
      IF(MASWRK)WRITE(IO,*)'H1B FINISHED'
       CALL FLSHBF(IO)
C
       ALLOCATE(V0A4A(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1),SOURCE=0.0D0)
C
       CALL HBAR0A4A(N0,N1,N2,N3,V0A4A,
     & K1,K2,K3,K4,
     & FAHH,FAHP,FAPP,FBHH,FBHP,FBPP,
     & VAHHHH,VAHHHP,VAHHPP,VAHPHP,VAHPPP,
     & VBHHHH,VBHHHP,VBHHPH,VBHHPP,VBHPHP,VBHPPH,
     & VBPHPH,VBHPPP,VBPHPP,
