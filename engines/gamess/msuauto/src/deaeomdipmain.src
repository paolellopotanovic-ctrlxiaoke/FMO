     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.1.AND.K7.GE.1.AND.K8.GE.2)THEN
       CALL EOMDIP3AHR2C4D1110(N0,N1,N2,N3,M1,HR(K2C4D),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K7.GE.1.AND.K8.GE.3)THEN
       CALL EOMDIP3AHR2C4D1111(N0,N1,N2,N3,M1,HR(K2C4D),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       CALL EOMDIP3A_PPPP(N0,N1,N2,N3,M1,NFT899,
     & K1,K2,K3,K4,K5,K7,K8,
     & HR(K2A4B),HR(K2A4B1),HR(K2B4C),HR(K2B4C1),HR(K2B4C2),
     & HR(K2C4D),HR(K2C4D1),
     & R(K2A4B),R(K2A4B1),R(K2B4C),R(K2B4C1),R(K2B4C2),
     & R(K2C4D),R(K2C4D1))
C
      CALL EOMDIP_R3_SYM(N0,N1,N2,N3,M1,HR(K1A3B),HR(K1B3C))
C
!      WRITE(IHR,REC=ITER)HR
       CALL DEAEOM_WRITE(IHR,ITER,LLL,HR)
       DEALLOCATE(HR,R)
       END
C
C*MODULE DEAEOMDIP DECK EOMDIP_R3_SYM
C> @brief symmetrize (H*R)_a^ijk
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M1 index of last unactive occupied orbital
C> @param HR1A3B 1p3h <|HR|>_a^ijk alpha,alpha-alpha-beta components
C> @param HR1B3C 1p3h <|HR|>_a^ijk beta,alpha-beta-beta components
C>
       SUBROUTINE EOMDIP_R3_SYM(N0,N1,N2,N3,M1,HR1A3B,HR1B3C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
       real*8 HR1A3B(N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1)
       real*8 HR1B3C(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N1)
       INTEGER A
C
       DO I=M1+1,N1;DO J=N0+1,M1;DO K=N0+1,N2;DO A=N1+1,N3
        HR1A3B(A,K,I,J)=-HR1A3B(A,K,J,I)
       ENDDO;ENDDO;ENDDO;ENDDO
C
       DO I=N0+1,N1;DO J=M1+1,N2;DO K=N0+1,M1;DO A=N2+1,N3
        HR1B3C(A,J,K,I)=-HR1B3C(A,K,J,I)
       ENDDO;ENDDO;ENDDO;ENDDO
C
       END
C
C
C*MODULE DEAEOMDIP DECK EOMDIP3A_PPPP
C> @brief Calculate four-partical two-body HBar part of H*R
C>
C> @author Jun Shen
C>
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M1 index of last unactive occupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K5 number of non-active occupied orbitals
C> @param K7 number of active occupied alpha orbitals
C> @param K8 number of active occupied beta orbitals
C> @param V2A4B 4h2p HR_ab^IJkl
C> alpha-alpha,(active-alpha)-(active-alpha)-alpha-beta components
C> @param V2A4B1 4h2p HR_ab^IjkL
C> alpha-alpha,(active-alpha)-(non-active-alpha)(non-active-alpha)-(active-beta) components
C> @param V2B4C 4h2p HR_ab^IjKl
C> alpha-beta,(active-alpha)-alpha-(active-beta)-beta components
C> @param V2B4C1 4h2p HR_ab^IJkl
C> alpha-beta,(active-alpha)-(active-alpha)-(non-active-beta)-(non-active-beta) components
C> @param V2B4C2 4h2p HR_ab^ijKL
C> alpha-beta,(non-active-alpha)-(non-active-alpha)-(active-beta)-(active-beta) components
C> @param V2C4D 4h2p HR_ab^iJKl
C> beta-beta,alpha-(active-beta)-(active-beta)-beta components
C> @param V2C4D1 4h2p HR_ab^IJkl
C> beta-beta,(active-alpha)-(active-beta)-(non-active-beta)-(non-active-beta) components
C> @param R2A4B 4h2p R_ab^IJkl
C> alpha-alpha,(active-alpha)-(active-alpha)-alpha-beta components
C> @param R2A4B1 4h2p R_ab^IjkL
C> alpha-alpha,(active-alpha)-(non-active-alpha)(non-active-alpha)-(active-beta) components
C> @param R2B4C 4h2p R_ab^IjKl
C> alpha-beta,(active-alpha)-alpha-(active-beta)-beta components
C> @param R2B4C1 4h2p R_ab^IJkl
C> alpha-beta,(active-alpha)-(active-alpha)-(non-active-beta)-(non-active-beta) components
C> @param R2B4C2 4h2p R_ab^ijKL
C> alpha-beta,(non-active-alpha)-(non-active-alpha)-(active-beta)-(active-beta) components
C> @param R2C4D 4h2p R_ab^iJKl
C> beta-beta,alpha-(active-beta)-(active-beta)-beta components
C> @param R2C4D1 4h2p R_ab^IJkl
C> beta-beta,(active-alpha)-(active-beta)-(non-active-beta)-(non-active-beta) components
C>
      SUBROUTINE EOMDIP3A_PPPP(N0,N1,N2,N3,M1,NFT899,
     &K1,K2,K3,K4,K5,K7,K8,
     &V2A4B,V2A4B1,V2B4C,V2B4C1,V2B4C2,V2C4D,V2C4D1,
     &R2A4B,R2A4B1,R2B4C,R2B4C1,R2B4C2,R2C4D,R2C4D1)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
      INTEGER A,B,C,D
      real*8
     *R2A4B(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1,M1+1:N1,M1+1:N1)
      real*8
     *R2A4B1(N1+1:N3,N1+1:N3,M1+1:N2,N0+1:M1,N0+1:M1,M1+1:N1)
      real*8
     *R2B4C(N2+1:N3,N1+1:N3,N0+1:N2,M1+1:N2,N0+1:N1,M1+1:N1)
      real*8
     *R2B4C1(N2+1:N3,N1+1:N3,N0+1:M1,N0+1:M1,M1+1:N1,M1+1:N1)
      real*8
     *R2B4C2(N2+1:N3,N1+1:N3,M1+1:N2,M1+1:N2,N0+1:M1,N0+1:M1)
      real*8
     *R2C4D(N2+1:N3,N2+1:N3,N0+1:N2,M1+1:N2,M1+1:N2,N0+1:N1)
      real*8
     *R2C4D1(N2+1:N3,N2+1:N3,N0+1:M1,N0+1:M1,M1+1:N2,M1+1:N1)
      real*8
     *V2A4B(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1,M1+1:N1,M1+1:N1)
      real*8
     *V2A4B1(N1+1:N3,N1+1:N3,M1+1:N2,N0+1:M1,N0+1:M1,M1+1:N1)
      real*8
     *V2B4C(N2+1:N3,N1+1:N3,N0+1:N2,M1+1:N2,N0+1:N1,M1+1:N1)
      real*8
     *V2B4C1(N2+1:N3,N1+1:N3,N0+1:M1,N0+1:M1,M1+1:N1,M1+1:N1)
      real*8
     *V2B4C2(N2+1:N3,N1+1:N3,M1+1:N2,M1+1:N2,N0+1:M1,N0+1:M1)
      real*8
     *V2C4D(N2+1:N3,N2+1:N3,N0+1:N2,M1+1:N2,M1+1:N2,N0+1:N1)
      real*8
     *V2C4D1(N2+1:N3,N2+1:N3,N0+1:M1,N0+1:M1,M1+1:N2,M1+1:N1)
      real*8 ,ALLOCATABLE::HPPP(:,:,:)
      real*8 ,ALLOCATABLE::U1(:,:,:,:,:)
C
C H2A
C
       ALLOCATE(HPPP(N1+1:N3,N1+1:N3,N1+1:N3))
C
       DO A=N1+1,N3
        READ(NFT899,REC=A-N1)HPPP
C
C V2A4B(IJKLAB):1/2*H2A(ABEF)*R2A4B(IJKLEF)
        ALLOCATE(U1(N0+1:N2,N0+1:N1,M1+1:N1,M1+1:N1,N1+1:N3))
        I1=K3
        I2=K7*K7*K1*K2
        I3=K3*K3
        CALL EGEMM(I1,I2,I3,HPPP,R2A4B,U1)
        DO I=M1+1,N1;DO J=M1+1,N1;DO K=N0+1,N1;DO L=N0+1,N2;DO B=N1+1,N3
         V2A4B(B,A,L,K,J,I)=V2A4B(B,A,L,K,J,I)+0.5*U1(L,K,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U1)
C
C V2A4B1(IJKLAB):1/2*H2A(ABEF)*R2A4B1(IJKLEF)
        ALLOCATE(U1(M1+1:N2,N0+1:M1,N0+1:M1,M1+1:N1,N1+1:N3))
        I1=K3
        I2=K7*K5*K5*K8
        I3=K3*K3
        CALL EGEMM(I1,I2,I3,HPPP,R2A4B1,U1)
        DO I=M1+1,N1;DO J=N0+1,M1;DO K=N0+1,M1;DO L=M1+1,N2;DO B=N1+1,N3
         V2A4B1(B,A,L,K,J,I)=V2A4B1(B,A,L,K,J,I)+0.5*U1(L,K,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U1)
       ENDDO
       DEALLOCATE(HPPP)
C
C H2C
C
       ALLOCATE(HPPP(N2+1:N3,N2+1:N3,N2+1:N3))
C
       DO A=N2+1,N3
        READ(NFT899,REC=A-N2+K3)HPPP
C
C V2C4D(IJKLAB):1/2*H2C(ABEF)*R2C4D(IJKLEF)
        ALLOCATE(U1(N0+1:N2,M1+1:N2,M1+1:N2,N0+1:N1,N2+1:N3))
        I1=K4
        I2=K1*K8*K8*K2
        I3=K4*K4
        CALL EGEMM(I1,I2,I3,HPPP,R2C4D,U1)
        DO I=N0+1,N1;DO J=M1+1,N2;DO K=M1+1,N2;DO L=N0+1,N2;DO B=N2+1,N3
         V2C4D(B,A,L,K,J,I)=V2C4D(B,A,L,K,J,I)+0.5*U1(L,K,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U1)
C
C V2C4D1(IJKLAB):1/2*H2C(ABEF)*R2C4D1(IJKLEF)
        ALLOCATE(U1(N0+1:M1,N0+1:M1,M1+1:N2,M1+1:N1,N2+1:N3))
        I1=K4
        I2=K7*K8*K5*K5
        I3=K4*K4
        CALL EGEMM(I1,I2,I3,HPPP,R2C4D1,U1)
        DO I=M1+1,N1;DO J=M1+1,N2;DO K=N0+1,M1;DO L=N0+1,M1;DO B=N2+1,N3
         V2C4D1(B,A,L,K,J,I)=V2C4D1(B,A,L,K,J,I)+0.5*U1(L,K,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U1)
       ENDDO
       DEALLOCATE(HPPP)
C
C H2B
C
       ALLOCATE(HPPP(N2+1:N3,N1+1:N3,N1+1:N3))
C
       DO B=N2+1,N3
        READ(NFT899,REC=B-N2+K3+K4)HPPP
C
C V2B4C(IJKLAB):H2B(ABEF)*R2B4C(IJKLEF)
        ALLOCATE(U1(N0+1:N2,M1+1:N2,N0+1:N1,M1+1:N1,N1+1:N3))
        I1=K3
        I2=K7*K1*K8*K2
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,HPPP,R2B4C,U1)
        DO I=M1+1,N1;DO J=N0+1,N1;DO K=M1+1,N2;DO L=N0+1,N2;DO A=N1+1,N3
         V2B4C(B,A,L,K,J,I)=V2B4C(B,A,L,K,J,I)+U1(L,K,J,I,A)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U1)
C
C V2B4C1(IJKLAB):H2B(ABEF)*R2B4C1(IJKLEF)
        ALLOCATE(U1(N0+1:M1,N0+1:M1,M1+1:N1,M1+1:N1,N1+1:N3))
        I1=K3
        I2=K7*K7*K5*K5
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,HPPP,R2B4C1,U1)
        DO I=M1+1,N1;DO J=M1+1,N1;DO K=N0+1,M1;DO L=N0+1,M1;DO A=N1+1,N3
         V2B4C1(B,A,L,K,J,I)=V2B4C1(B,A,L,K,J,I)+U1(L,K,J,I,A)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U1)
C
C V2B4C2(IJKLAB):H2B(ABEF)*R2B4C2(IJKLEF)
        ALLOCATE(U1(M1+1:N2,M1+1:N2,N0+1:M1,N0+1:M1,N1+1:N3))
        I1=K3
        I2=K5*K5*K8*K8
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,HPPP,R2B4C2,U1)
        DO I=N0+1,M1;DO J=N0+1,M1;DO K=M1+1,N2;DO L=M1+1,N2;DO A=N1+1,N3
         V2B4C2(B,A,L,K,J,I)=V2B4C2(B,A,L,K,J,I)+U1(L,K,J,I,A)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U1)
       ENDDO
       DEALLOCATE(HPPP)
C
      END
C
C
C*MODULE DEAEOMDIP DECK EOMDIP3_HR
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param ITER number of iteration
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param K0A2B first number of 2h R^ij alpha-beta components
C> @param K1A3B first number of 3h1p R_a^ijk alpha,alpha-alpha-beta components
C> @param K1B3C first number of 3h1p R_a^ijk beta,alpha-beta-beta components
C> @param K2A4B first number of 4h2p R_ab^ijkl
C> alpha-alpha,alpha-alpha-alpha-beta components
C> @param K2B4C first number of 4h2p R_ab^ijkl
C> alpha-beta,alpha-alpha-beta-beta components
C> @param K2C4D first number of 4h2p R_ab^ijkl
C> beta-beta,alpha-beta-beta-beta components
C> @param KKK number size of the CCSD cluster vector
C> @param LLL number size of the DIP(4h2p) vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C>
       SUBROUTINE EOMDIP3_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL,
     & K0A2B,K1A3B,K1B3C,K2A4B,K2B4C,K2C4D,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 T(KKK)
       real*8,ALLOCATABLE::HR(:),R(:)
C
       ALLOCATE(HR(LLL),SOURCE=0.0D0)
       ALLOCATE(R(LLL),SOURCE=0.0D0)
!      READ(IR,REC=ITER)R
        CALL DEAEOM_READ(IR,ITER,LLL,R)
C
       CALL EOMDIP3HR0A2B(N0,N1,N2,N3,HR(K0A2B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2B4C),R(K2C4D))
C
       CALL EOMDIP3HR1A3B(N0,N1,N2,N3,HR(K1A3B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2B4C),R(K2C4D))
C
       CALL EOMDIP3HR1B3C(N0,N1,N2,N3,HR(K1B3C),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2B4C),R(K2C4D))
C
       CALL EOMDIP3HR2A4B(N0,N1,N2,N3,HR(K2A4B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2B4C),R(K2C4D))
C
       CALL EOMDIP3HR2B4C(N0,N1,N2,N3,HR(K2B4C),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2B4C),R(K2C4D))
C
       CALL EOMDIP3HR2C4D(N0,N1,N2,N3,HR(K2C4D),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2B4C),R(K2C4D))
C
       CALL EOMDIP3_PPPP(N0,N1,N2,N3,NFT899,
     & K1,K2,K3,K4,
     & HR(K2A4B),HR(K2B4C),HR(K2C4D),
     & R(K2A4B),R(K2B4C),R(K2C4D))
C
!      WRITE(IHR,REC=ITER)HR
       CALL DEAEOM_WRITE(IHR,ITER,LLL,HR)
       DEALLOCATE(HR,R)
       END
C
C
C*MODULE DEAEOMDIP DECK EOMDIP3_PPPP
C> @brief Calculate four-partical two-body HBar part of H*R
C>
C> @author Jun Shen
C>
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param V2A4B 4h2p HR_ab^ijkl
C> alpha-alpha,alpha-alpha-alpha-beta components
C> @param V2B4C 4h2p HR_ab^ijkl
C> alpha-beta,alpha-alpha-beta-beta components
C> @param V2C4D 4h2p HR_ab^ijkl
C> beta-beta,alpha-beta-beta-beta components
C> @param R2A4B 4h2p R_ab^ijkl
C> alpha-alpha,alpha-alpha-alpha-beta components
C> @param R2B4C 4h2p R_ab^ijkl
C> alpha-beta,alpha-alpha-beta-beta components
C> @param R2C4D 4h2p R_ab^ijkl
C> beta-beta,alpha-beta-beta-beta components
C>
      SUBROUTINE EOMDIP3_PPPP(N0,N1,N2,N3,NFT899,
     &K1,K2,K3,K4,
     &V2A4B,V2B4C,V2C4D,
     &R2A4B,R2B4C,R2C4D)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
      INTEGER A,B,C,D
      real*8
     *V2A4B(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1,N0+1:N1)
      real*8
     *V2B4C(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1)
      real*8
     *V2C4D(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1)
      real*8
     *R2A4B(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1,N0+1:N1)
      real*8
     *R2B4C(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1)
      real*8
     *R2C4D(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1)
      real*8,ALLOCATABLE::HPPP(:,:,:)
      real*8,ALLOCATABLE::U1(:,:,:,:,:)
C
C H2A
C
       ALLOCATE(HPPP(N1+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(U1(N0+1:N2,N0+1:N1,N0+1:N1,N0+1:N1,N1+1:N3))
C
       DO A=N1+1,N3
        READ(NFT899,REC=A-N1)HPPP
C
C V2A4B(IJKLAB):1/2*H2A(ABEF)*R2A4B(IJKLEF)
        I1=K3
        I2=K1*K1*K1*K2
        I3=K3*K3
        CALL EGEMM(I1,I2,I3,HPPP,R2A4B,U1)
        DO I=N0+1,N1;DO J=N0+1,N1;DO K=N0+1,N1;DO L=N0+1,N2;DO B=N1+1,N3
         V2A4B(B,A,L,K,J,I)=V2A4B(B,A,L,K,J,I)+0.5*U1(L,K,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(U1)
C
C H2C
C
       ALLOCATE(HPPP(N2+1:N3,N2+1:N3,N2+1:N3))
       ALLOCATE(U1(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1,N2+1:N3))
C
       DO A=N2+1,N3
        READ(NFT899,REC=A-N2+K3)HPPP
C
C V2C4D(IJKLAB):1/2*H2C(ABEF)*R2C4D(IJKLEF)
        I1=K4
        I2=K1*K2*K2*K2
        I3=K4*K4
        CALL EGEMM(I1,I2,I3,HPPP,R2C4D,U1)
        DO I=N0+1,N1;DO J=N0+1,N2;DO K=N0+1,N2;DO L=N0+1,N2;DO B=N2+1,N3
         V2C4D(B,A,L,K,J,I)=V2C4D(B,A,L,K,J,I)+0.5*U1(L,K,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(U1)
C
C H2B
C
       ALLOCATE(HPPP(N2+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(U1(N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1,N1+1:N3))
C
       DO B=N2+1,N3
        READ(NFT899,REC=B-N2+K3+K4)HPPP
C
C V2B4C(IJKLAB):H2B(ABEF)*R2B4C(IJKLEF)
        I1=K3
        I2=K1*K1*K2*K2
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,HPPP,R2B4C,U1)
        DO I=N0+1,N1;DO J=N0+1,N1;DO K=N0+1,N2;DO L=N0+1,N2;DO A=N1+1,N3
         V2B4C(B,A,L,K,J,I)=V2B4C(B,A,L,K,J,I)+U1(L,K,J,I,A)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(U1)
       DEALLOCATE(HPPP)
C
      END
C
C
C*MODULE DEAEOMDIP DECK DEAEOM2_HR
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param ITER number of iteration
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param K2B0A first number of 2p R_ab alpha-beta components
C> @param K3B1A first number of 3p1h R_abc^i alpha-alpha-beta,alpha components
C> @param K3C1B first number of 3p1h R_abc^i alpha-beta-beta,beta components
C> @param KKK number size of the CCSD cluster vector
C> @param LLL number size of the DEA(3p1h) vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C>
       SUBROUTINE DEAEOM2_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL,
     & K2B0A,K3B1A,K3C1B,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 T(KKK)
       real*8,ALLOCATABLE::HR(:),R(:)
C
       ALLOCATE(HR(LLL),SOURCE=0.0D0)
       ALLOCATE(R(LLL),SOURCE=0.0D0)
!      READ(IR,REC=ITER)R
       CALL DEAEOM_READ(IR,ITER,LLL,R)
C
       CALL DEAEOM2HR2B0A(N0,N1,N2,N3,HR(K2B0A),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B))
C
       CALL DEAEOM2HR3B1A(N0,N1,N2,N3,HR(K3B1A),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B))
C
       CALL DEAEOM2HR3C1B(N0,N1,N2,N3,HR(K3C1B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B))
C
       CALL DEAEOM2_PPPP(N0,N1,N2,N3,NFT899,
     & K1,K2,K3,K4,
     & HR(K2B0A),HR(K3B1A),HR(K3C1B),
     & R(K2B0A),R(K3B1A),R(K3C1B))
C
!      WRITE(IHR,REC=ITER)HR
       CALL DEAEOM_WRITE(IHR,ITER,LLL,HR)
       DEALLOCATE(HR,R)
       END
C
C*MODULE DEAEOMDIP DECK DEAEOM2_PPPP
C> @brief Calculate four-partical two-body HBar part of H*R
C>
C> @author Jun Shen
C>
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param V2B0A 2p HR_ab alpha-beta components
C> @param V3B1A 3p1h HR_abc^i alpha-alpha-beta,alpha components
C> @param V3C1B 3p1h HR_abc^i alpha-beta-beta,beta components
C> @param R2B0A 2p R_ab alpha-beta components
C> @param R3B1A 3p1h R_abc^i alpha-alpha-beta,alpha components
C> @param R3C1B 3p1h R_abc^i alpha-beta-beta,beta components
C>
       SUBROUTINE DEAEOM2_PPPP(N0,N1,N2,N3,NFT899,
     & K1,K2,K3,K4,
     & V2B0A,V3B1A,V3C1B,
     & R2B0A,R3B1A,R3C1B)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,X
       real*8 V2B0A(N2+1:N3,N1+1:N3)
       real*8 V3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 V3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2)
       real*8 R2B0A(N2+1:N3,N1+1:N3)
       real*8 R3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 R3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2)
C
       real*8,ALLOCATABLE::HPPP(:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::U2B0A(:)
       real*8,ALLOCATABLE::U3B1A(:,:,:)
       real*8,ALLOCATABLE::U3C1B(:,:,:)
C
C H2A
C
       ALLOCATE(HPPP(N1+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(D2(N1+1:N3,N1+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER2314(N2,N3,N1,N3,N1,N3,N0,N1,
     & N1,N3,N1,N3,N2,N3,N0,N1,R3B1A,D2)
       ALLOCATE(U3B1A(N2+1:N3,N0+1:N1,N1+1:N3))
C
       DO X=N1+1,N3
        READ(NFT899,REC=X-N1)HPPP
C
C V3B1A(IAB*):1/2*H2A(ABEF)*R3B1A(IEF*),*:(N2+1:N3)
        I1=K3
        I2=K1*K4
        I3=K3*K3
        CALL EGEMM(I1,I2,I3,HPPP,D2,U3B1A)
        DO B=N1+1,N3;DO I=N0+1,N1;DO C=N2+1,N3
         V3B1A(C,B,X,I)=V3B1A(C,B,X,I)+0.5*U3B1A(C,I,B)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(D2)
       DEALLOCATE(U3B1A)
C
C H2C
       ALLOCATE(HPPP(N2+1:N3,N2+1:N3,N2+1:N3))
       ALLOCATE(U3C1B(N1+1:N3,N0+1:N2,N2+1:N3))
       DO X=N2+1,N3
        READ(NFT899,REC=X-N2+K3)HPPP
C
C V3C1B(IABC):1/2*H2C(BCEF)*R3C1B(IAEF)
        I1=K4
        I2=K2*K3
        I3=K4*K4
        CALL EGEMM(I1,I2,I3,HPPP,R3C1B,U3C1B)
        DO C=N2+1,N3;DO I=N0+1,N2;DO A=N1+1,N3
         V3C1B(C,X,A,I)=V3C1B(C,X,A,I)+0.5*U3C1B(A,I,C)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(U3C1B)
C
C H2B
       ALLOCATE(HPPP(N2+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(D2(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N2))
       CALL REORDER1324(N2,N3,N2,N3,N1,N3,N0,N2,
     & N2,N3,N1,N3,N2,N3,N0,N2,R3C1B,D2)
       DO X=N2+1,N3
        READ(NFT899,REC=X-N2+K3+K4)HPPP
C
C V2B0A: H2B(ABEF)*R2B0A(EF)
        ALLOCATE(U2B0A(N1+1:N3))
        I1=K3
        I3=K3*K4
        CALL EGEMM1(I1,I3,HPPP,R2B0A,U2B0A)
        DO A=N1+1,N3
         V2B0A(X,A)=V2B0A(X,A)+U2B0A(A)
        ENDDO
        DEALLOCATE(U2B0A)
C
C V3B1A(C,B,A,I):H2B(B,C,E,F)*R3B1A(IAEF)-H2B(A,C,E,F)*R3B1A(IBEF)
        ALLOCATE(U3B1A(N1+1:N3,N0+1:N1,N1+1:N3))
        I1=K3
        I2=K1*K3
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,HPPP,R3B1A,U3B1A)
        DO B=N1+1,N3;DO I=N0+1,N1;DO A=N1+1,N3
         V3B1A(X,B,A,I)=V3B1A(X,B,A,I)+U3B1A(A,I,B)-U3B1A(B,I,A)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(U3B1A)
C
C V3C1B(C,B,A,I):H2B(A,C,E,F)*R3C1B(IBEF)
        ALLOCATE(U3C1B(N2+1:N3,N0+1:N2,N1+1:N3))
        I1=K3
        I2=K2*K4
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,HPPP,D2,U3C1B)
        DO A=N1+1,N3;DO I=N0+1,N1;DO B=N2+1,N3
         V3C1B(X,B,A,I)=V3C1B(X,B,A,I)+U3C1B(B,I,A)
         V3C1B(B,X,A,I)=V3C1B(B,X,A,I)-U3C1B(B,I,A)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(U3C1B)
C
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(D2)
C
       END
C
C
C*MODULE DEAEOMDIP DECK DEAEOM2A_HR
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param ITER number of iteration
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M2 index of the last active unoccupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K6 number of non-active unoccupied orbitals
C> @param K9 number of active unoccupied alpha orbitals
C> @param K0 number of active unoccupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param K2B0A first number of 2p R_ab alpha-beta components
C> @param K3B1A first number of 3p1h R_Abc^i (active-alpha)-alpha-beta,alpha components
C> @param K3B1A1 first number of 3p1h R_abC^i (non-active-alpha)-(non-active-alpha)-(active-beta),alpha components
C> @param K3C1B first number of 3p1h R_aBc^i alpha-(active-beta)-beta,beta components
C> @param K3C1B1 first number of 3p1h R_Abc^i (active-alpha)-(non-active-beta)-(non-active-beta),beta components
C> @param KKK number size of the CCSD cluster vector
C> @param LLL number size of the DEA(3p1h){Nu} vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C> @param HAAPPP Twobody Hamiltonian alpha-alpha (AP)PPP array
C> @param HAPPAP Twobody Hamiltonian alpha-alpha PP(AP)P array
C> @param HBAPPP Twobody Hamiltonian alpha-beta (AP)PPP array
C> @param HBPAPP Twobody Hamiltonian alpha-beta P(AP)PP array
C> @param HBPPAP Twobody Hamiltonian alpha-beta PP(AP)P array
C> @param HBPPPA Twobody Hamiltonian alpha-beta PPP(AP) array
C> @param HCAPPP Twobody Hamiltonian beta-beta (AP)PPP array
C> @param HCPPAP Twobody Hamiltonian beta-beta PP(AP)P array
C>
       SUBROUTINE DEAEOM2A_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,M2,T,
     & K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,LLL,
     & K2B0A,K3B1A,K3B1A1,K3C1B,K3C1B1,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & NFT899)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 HAAPPP(N1+1:N3,N1+1:N3,N1+1:N3,N1+1:M2)
       real*8 HAPPAP(N1+1:N3,N1+1:M2,N1+1:N3,N1+1:N3)
       real*8 HBAPPP(N2+1:N3,N1+1:N3,N2+1:N3,N1+1:M2)
       real*8 HBPAPP(N2+1:N3,N1+1:N3,N2+1:M2,N1+1:N3)
       real*8 HBPPAP(N2+1:N3,N1+1:M2,N2+1:N3,N1+1:N3)
       real*8 HBPPPA(N2+1:M2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCAPPP(N2+1:N3,N2+1:N3,N2+1:N3,N2+1:M2)
       real*8 HCPPAP(N2+1:N3,N2+1:M2,N2+1:N3,N2+1:N3)
       real*8 T(KKK)
       real*8,ALLOCATABLE::HR(:),R(:)
C
       ALLOCATE(HR(LLL),SOURCE=0.0D0)
       ALLOCATE(R(LLL),SOURCE=0.0D0)
C
!      READ(IR,REC=ITER)R
       CALL DEAEOM_READ(IR,ITER,LLL,R)
C
       IF(K6.GE.1)THEN
       CALL DEAEOM2AHR2B0A00(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K0.GE.1)THEN
       CALL DEAEOM2AHR2B0A01(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.1)THEN
       CALL DEAEOM2AHR2B0A10(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K9.GT.0.AND.K0.GT.0)THEN
       CALL DEAEOM2AHR2B0A11(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.2.AND.K0.GE.1)THEN
       CALL DEAEOM2AHR3B1A001(N0,N1,N2,N3,M2,HR(K3B1A1),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.1)THEN
       CALL DEAEOM2AHR3B1A100(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.1.AND.K0.GE.1)THEN
       CALL DEAEOM2AHR3B1A101(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.2)THEN
       CALL DEAEOM2AHR3B1A110(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K9.GE.2.AND.K0.GE.1)THEN
       CALL DEAEOM2AHR3B1A111(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K0.GE.1)THEN
       CALL DEAEOM2AHR3C1B010(N0,N1,N2,N3,M2,HR(K3C1B),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K0.GE.2)THEN
       CALL DEAEOM2AHR3C1B011(N0,N1,N2,N3,M2,HR(K3C1B),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.2.AND.K9.GE.1)THEN
       CALL DEAEOM2AHR3C1B100(N0,N1,N2,N3,M2,HR(K3C1B1),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.1.AND.K0.GE.1)THEN
       CALL DEAEOM2AHR3C1B110(N0,N1,N2,N3,M2,HR(K3C1B),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
       IF(K9.GE.1.AND.K0.GE.2)THEN
       CALL DEAEOM2AHR3C1B111(N0,N1,N2,N3,M2,HR(K3C1B),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       ENDIF
C
      CALL DEAEOM2A_PPPP(N0,N1,N2,N3,M2,NFT899,
     & K1,K2,K3,K4,K6,K9,K0,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & HR(K2B0A),HR(K3B1A),HR(K3B1A1),HR(K3C1B),HR(K3C1B1),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
C
!      WRITE(IHR,REC=ITER)HR
       CALL DEAEOM_WRITE(IHR,ITER,LLL,HR)
       DEALLOCATE(HR,R)
       END
C
C*MODULE DEAEOMDIP DECK DEAEOM2A_PPPP
C> @brief Calculate four-partical two-body HBar part of H*R
C>
C> @author Jun Shen
C>
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M2 index of the last active unoccupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K6 number of non-active unoccupied orbitals
C> @param K9 number of active unoccupied alpha orbitals
C> @param K0 number of active unoccupied beta orbitals
C> @param T1A one-body alpha CCSD cluster components
C> @param T1B one-body beta CCSD cluster components
C> @param T2A two-body alpha-alpha CCSD cluster components
C> @param T2B two-body alpha-beta CCSD cluster components
C> @param T2C two-body beta-beta CCSD cluster components
C> @param V2B0A 2p HR_ab alpha-beta components
C> @param V3B1A 3p1h HR_Abc^i (active-alpha)-alpha-beta,alpha components
C> @param V3B1A1 3p1h HR_abC^i (non-active-alpha)-(non-active-alpha)-(active-beta),alpha components
C> @param V3C1B 3p1h HR_aBc^i alpha-(active-beta)-beta,beta components
C> @param V3C1B1 3p1h HR_Abc^i (active-alpha)-(non-active-beta)-(non-active-beta),beta components
C> @param R2B0A 2p R_ab alpha-beta components
C> @param R3B1A 3p1h R_Abc^i (active-alpha)-alpha-beta,alpha components
C> @param R3B1A1 3p1h R_abC^i (non-active-alpha)-(non-active-alpha)-(active-beta),alpha components
C> @param R3C1B 3p1h R_aBc^i alpha-(active-beta)-beta,beta components
C> @param R3C1B1 3p1h R_Abc^i (active-alpha)-(non-active-beta)-(non-active-beta),beta components
C>
       SUBROUTINE DEAEOM2A_PPPP(N0,N1,N2,N3,M2,NFT899,
     & K1,K2,K3,K4,K6,K9,K0,
     & T1A,T1B,T2A,T2B,T2C,
     & V2B0A,V3B1A,V3B1A1,V3C1B,V3C1B1,
     & R2B0A,R3B1A,R3B1A1,R3C1B,R3C1B1)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,R,X
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 V2B0A(N2+1:N3,N1+1:N3)
       real*8 V3B1A(N2+1:N3,N1+1:N3,N1+1:M2,N0+1:N1)
       real*8 V3B1A1(N2+1:M2,M2+1:N3,M2+1:N3,N0+1:N1)
       real*8 V3C1B(N2+1:N3,N2+1:M2,N1+1:N3,N0+1:N2)
       real*8 V3C1B1(M2+1:N3,M2+1:N3,N1+1:M2,N0+1:N2)
       real*8 R2B0A(N2+1:N3,N1+1:N3)
       real*8 R3B1A(N2+1:N3,N1+1:N3,N1+1:M2,N0+1:N1)
       real*8 R3B1A1(N2+1:M2,M2+1:N3,M2+1:N3,N0+1:N1)
       real*8 R3C1B(N2+1:N3,N2+1:M2,N1+1:N3,N0+1:N2)
       real*8 R3C1B1(M2+1:N3,M2+1:N3,N1+1:M2,N0+1:N2)
C
       real*8,ALLOCATABLE::HPPP(:,:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::D21(:,:,:,:)
       real*8,ALLOCATABLE::U2B0A(:)
       real*8,ALLOCATABLE::S1(:,:,:)
       real*8,ALLOCATABLE::S2(:,:,:)
       real*8,ALLOCATABLE::S3(:,:,:)
       real*8,ALLOCATABLE::S4(:,:,:)
C
C H2A
C
       ALLOCATE(HPPP(N1+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(C1(M2+1:N3,M2+1:N3,M2+1:N3))
       ALLOCATE(D2(M2+1:N3,M2+1:N3,N2+1:M2,N0+1:N1))
       ALLOCATE(S1(N2+1:M2,N0+1:N1,M2+1:N3))
       CALL REORDER2314(N2,M2,M2,N3,M2,N3,N0,N1,
     & M2,N3,M2,N3,N2,M2,N0,N1,R3B1A1,D2)
C
       DO X=M2+1,N3
        READ(NFT899,REC=X-N1)HPPP
        CALL REORDER123(N1,N3,N1,N3,N1,N3,
     &  M2,N3,M2,N3,M2,N3,HPPP,C1)
C
C V3B1A(IABC):1/2*H2A(ABGH)*R3B1A(IGHC),X=A
        I1=K6
        I2=K1*K0
        I3=K6*K6
        CALL EGEMM(I1,I2,I3,C1,D2,S1)
        DO B=M2+1,N3;DO I=N0+1,N1;DO C=N2+1,M2
         V3B1A1(C,B,X,I)=V3B1A1(C,B,X,I)+0.5*S1(C,I,B)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(C1)
       DEALLOCATE(D2)
       DEALLOCATE(S1)
C
C H2C
       ALLOCATE(HPPP(N2+1:N3,N2+1:N3,N2+1:N3))
       ALLOCATE(C1(M2+1:N3,M2+1:N3,M2+1:N3))
       ALLOCATE(S2(N1+1:M2,N0+1:N2,M2+1:N3))
       DO X=M2+1,N3
        READ(NFT899,REC=X-N2+K3)HPPP
        CALL REORDER123(N2,N3,N2,N3,N2,N3,
     &  M2,N3,M2,N3,M2,N3,HPPP,C1)
C
C V3C1B(IABC):1/2*H2C(BCGH)*R3C1B(IAGH),X=B
        I1=K6
        I2=K2*K9
        I3=K6*K6
        CALL EGEMM(I1,I2,I3,C1,R3C1B1,S2)
        DO C=M2+1,N3;DO I=N0+1,N2;DO A=N1+1,M2
         V3C1B1(C,X,A,I)=V3C1B1(C,X,A,I)+0.5*S2(A,I,C)
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(C1)
       DEALLOCATE(S2)
C
C H2B
       ALLOCATE(HPPP(N2+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(D2(M2+1:N3,M2+1:N3,N1+1:M2,N0+1:N1))
       CALL REORDER1234(N2,N3,N1,N3,N1,M2,N0,N1,
     & M2,N3,M2,N3,N1,M2,N0,N1,R3B1A,D2)
       ALLOCATE(D21(M2+1:N3,M2+1:N3,N2+1:M2,N0+1:N2))
       CALL REORDER1324(N2,N3,N2,M2,N1,N3,N0,N2,
     & M2,N3,M2,N3,N2,M2,N0,N2,R3C1B,D21)
       DO X=M2+1,N3
        READ(NFT899,REC=X-N2+K3+K4)HPPP
C
        ALLOCATE(C1(N2+1:N3,N1+1:N3,M2+1:N3))
        CALL REORDER123(N2,N3,N1,N3,N1,N3,
     & N2,N3,N1,N3,M2,N3,HPPP,C1)
C
C V2B0A: H2B(ABEF)*R2B0A(EF),X=B
        ALLOCATE(U2B0A(M2+1:N3))
        I1=K6
        I3=K3*K4
        CALL EGEMM1(I1,I3,C1,R2B0A,U2B0A)
        DO A=M2+1,N3
         V2B0A(X,A)=V2B0A(X,A)+U2B0A(A)
        ENDDO
        DEALLOCATE(U2B0A)
        DEALLOCATE(C1)
C
        ALLOCATE(C1(M2+1:N3,M2+1:N3,M2+1:N3))
        CALL REORDER123(N2,N3,N1,N3,N1,N3,
     &  M2,N3,M2,N3,M2,N3,HPPP,C1)
C
C V3B1A(C,B,A,I):H2B(BCGH)*R3B1A(IAGH),X=C
        I1=K6
        I2=K1*K9
        I3=K6*K6
        ALLOCATE(S3(N1+1:M2,N0+1:N1,M2+1:N3))
        CALL EGEMM(I1,I2,I3,C1,D2,S3)
        DO B=M2+1,N3;DO I=N0+1,N1;DO A=N1+1,M2
         V3B1A(X,B,A,I)=V3B1A(X,B,A,I)+S3(A,I,B)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S3)
C
C V3C1B(C,B,A,I):H2B(ACGH)*R3C1B(IGBH),X=C
        ALLOCATE(S4(N2+1:M2,N0+1:N2,M2+1:N3))
        I1=K6
        I2=K2*K0
        I3=K6*K6
        CALL EGEMM(I1,I2,I3,C1,D21,S4)
        DO A=M2+1,N3;DO I=N0+1,N2;DO B=N2+1,M2
         V3C1B(X,B,A,I)=V3C1B(X,B,A,I)+S4(B,I,A)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S4)
        DEALLOCATE(C1)
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(D2)
       DEALLOCATE(D21)
C
       END
C
C
C*MODULE DEAEOMDIP DECK DEAEOM3A_HR
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param ITER number of iteration
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M2 index of the last active unoccupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K6 number of non-active unoccupied orbitals
C> @param K9 number of active unoccupied alpha orbitals
C> @param K0 number of active unoccupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param K2B0A first number of 2p R_ab alpha-beta components
C> @param K3B1A first number of 3p1h R_Abc^i (active-alpha)-alpha-beta,alpha components
C> @param K3B1A1 first number of 3p1h R_abC^i (non-active-alpha)-(non-active-alpha)-(active-beta),alpha components
C> @param K3C1B first number of 3p1h R_aBc^i alpha-(active-beta)-beta,beta components
C> @param K3C1B1 first number of 3p1h R_Abc^i (active-alpha)-(non-active-beta)-(non-active-beta),beta components
C> @param K4B2A first number of 4p2h R_ABcd^ij
C> (active-alpha)-(active-alpha)-alpha-beta,alpha-alpha components
C> @param K4B2A1 first number of 4p2h R_AbcD^ij
C> (active-alpha)-(non-active-alpha)-(non-active-alpha)-(active-beta),alpha-alpha components
C> @param K4C2B first number of 4p2h R_AbCd^ij
C> (active-alpha)-(active-alpha)-(non-active-beta)-(non-active-beta),alpha-beta components
C> @param K4C2B1 first number of 4p2h R_ABcd^ij
C> (active-alpha)-alpha-(active-beta)-beta,alpha-beta components
C> @param K4C2B2 first number of 4p2h R_abCD^ij
C> (non-active-alpha)-(non-active-alpha)-(active-beta)-(active-beta),alpha-beta components
C> @param K4D2C first number of 4p2h R_aBCd^ij
C> alpha-(active-beta)-(active-beta)-beta,beta-beta components
C> @param K4D2C1 first number of 4p2h R_ABcd^ij
C> (active-alpha)-(active-beta)-(non-active-beta)-(non-active-beta),beta-beta components
C> @param KKK number size of the CCSD cluster vector
C> @param LLL number size of the DEA(4p2h,3p1h){Nu} vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C> @param HAAPPP Twobody Hamiltonian alpha-alpha (AP)PPP array
C> @param HAPPAP Twobody Hamiltonian alpha-alpha PP(AP)P array
C> @param HBAPPP Twobody Hamiltonian alpha-beta (AP)PPP array
C> @param HBPAPP Twobody Hamiltonian alpha-beta P(AP)PP array
C> @param HBPPAP Twobody Hamiltonian alpha-beta PP(AP)P array
C> @param HBPPPA Twobody Hamiltonian alpha-beta PPP(AP) array
C> @param HCAPPP Twobody Hamiltonian beta-beta (AP)PPP array
C> @param HCPPAP Twobody Hamiltonian beta-beta PP(AP)P array
C>
       SUBROUTINE DEAEOM3A_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,M2,T,
     & K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,LLL,
     & K2B0A,K3B1A,K3B1A1,K3C1B,K3C1B1,
     & K4B2A,K4B2A1,K4C2B,K4C2B1,K4C2B2,K4D2C,K4D2C1,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & NFT899)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 HAAPPP(N1+1:N3,N1+1:N3,N1+1:N3,N1+1:M2)
       real*8 HAPPAP(N1+1:N3,N1+1:M2,N1+1:N3,N1+1:N3)
       real*8 HBAPPP(N2+1:N3,N1+1:N3,N2+1:N3,N1+1:M2)
       real*8 HBPAPP(N2+1:N3,N1+1:N3,N2+1:M2,N1+1:N3)
       real*8 HBPPAP(N2+1:N3,N1+1:M2,N2+1:N3,N1+1:N3)
       real*8 HBPPPA(N2+1:M2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCAPPP(N2+1:N3,N2+1:N3,N2+1:N3,N2+1:M2)
       real*8 HCPPAP(N2+1:N3,N2+1:M2,N2+1:N3,N2+1:N3)
       real*8 T(KKK)
       real*8,ALLOCATABLE::HR(:),R(:)
C
       ALLOCATE(HR(LLL),SOURCE=0.0D0)
       ALLOCATE(R(LLL),SOURCE=0.0D0)
!      READ(IR,REC=ITER)R
       CALL DEAEOM_READ(IR,ITER,LLL,R)
C
       IF(K6.GE.1)THEN
       CALL DEAEOM3AHR2B0A00(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K6.GE.1.AND.K0.GE.1)THEN
       CALL DEAEOM3AHR2B0A01(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.1)THEN
       CALL DEAEOM3AHR2B0A10(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K9.GT.0.AND.K0.GT.0)THEN
       CALL DEAEOM3AHR2B0A11(N0,N1,N2,N3,M2,HR(K2B0A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K6.GE.2.AND.K0.GE.1)THEN
       CALL DEAEOM3AHR3B1A001(N0,N1,N2,N3,M2,HR(K3B1A1),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.1)THEN
       CALL DEAEOM3AHR3B1A100(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.1.AND.K0.GE.1)THEN
       CALL DEAEOM3AHR3B1A101(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K6.GE.1.AND.K9.GE.2)THEN
       CALL DEAEOM3AHR3B1A110(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
       IF(K9.GE.2.AND.K0.GE.1)THEN
       CALL DEAEOM3AHR3B1A111(N0,N1,N2,N3,M2,HR(K3B1A),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),
     & R(K4B2A),R(K4B2A1),R(K4C2B),R(K4C2B1),R(K4C2B2),
     & R(K4D2C),R(K4D2C1))
       ENDIF
C
