       ENDIF
C
       IF(K9.GE.1.AND.K0.GE.3)THEN
        CALL DEAEOM3BHR4D2C1111(N0,N1,N2,N3,M2,HR(K4D2C),
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4B2A1),
     & R(K4C2B),R(K4C2B1),R(K4C2B2),R(K4D2C),R(K4D2C1))
       ENDIF
C
       CALL DEAEOM3B_PPPP(N0,N1,N2,N3,M2,NFT899,
     & K1,K2,K3,K4,K6,K9,K0,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & HR(K2B0A),HR(K3B1A),HR(K3C1B),HR(K4B2A),HR(K4B2A1),
     & HR(K4C2B),HR(K4C2B1),HR(K4C2B2),HR(K4D2C),HR(K4D2C1),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4B2A1),
     & R(K4C2B),R(K4C2B1),R(K4C2B2),R(K4D2C),R(K4D2C1))
C
      CALL DEAEOM3B_R3_SYM(N0,N1,N2,N3,M2,HR(K3B1A),HR(K3C1B))
 
C
!      WRITE(IHR,REC=ITER)HR
       CALL DEAEOM_WRITE(IHR,ITER,LLL,HR)
       DEALLOCATE(HR,R)
       END
C
C*MODULE DEAEOMDIP DECK DEAEOM3B_R3_SYM
C> @brief Symmetrize (H*R)_abc^i
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M2 index of the last active unoccupied orbital
C> @param HR3B1A 3p1h <|HR|>_abc^i alpha-alpha-beta,alpha components
C> @param HR3C1B 3p1h <|HR|>_abc^i alpha-beta-beta,beta components
C
       SUBROUTINE DEAEOM3B_R3_SYM(N0,N1,N2,N3,M2,HR3B1A,HR3C1B)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
       real*8 HR3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HR3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2)
       INTEGER A,B,C
C
       DO I=N0+1,N1;DO A=N1+1,M2;DO B=M2+1,N3;DO C=N2+1,N3
        HR3B1A(C,A,B,I)=-HR3B1A(C,B,A,I)
       ENDDO;ENDDO;ENDDO;ENDDO
C
       DO I=N0+1,N2;DO A=N1+1,N3;DO B=N2+1,M2;DO C=M2+1,N3
        HR3C1B(B,C,A,I)=-HR3C1B(C,B,A,I)
       ENDDO;ENDDO;ENDDO;ENDDO
C
       END
C
C*MODULE DEAEOMDIP DECK DEAEOM3B_PPPP
C> @brief Calculate four-partical two-body HBar part of H*R
C>
C> @author Jun Shen
C>
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M2 index of the last active unoccupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K6 number of non-active unoccupied orbitals
C> @param K9 number of active unoccupied alpha orbitals
C> @param K0 number of active unoccupied beta orbitals
C> @param V2B0A 2p HR_ab alpha-beta components
C> @param V3B1A 3p1h HR_abc^i alpha-alpha-beta,alpha components
C> @param V3C1B 3p1h HR_abc^i alpha-beta-beta,beta components
C> @param V4B2A 4p2h HR_ABcd^ij
C> (active-alpha)-(active-alpha)-alpha-beta,alpha-alpha components
C> @param V4B2A1 4p2h HR_AbcD^ij
C> (active-alpha)-(non-active-alpha)-(non-active-alpha)-(active-beta),alpha-alpha components
C> @param V4C2B 4p2h HR_AbCd^ij
C> (active-alpha)-(active-alpha)-(non-active-beta)-(non-active-beta),alpha-beta components
C> @param V4C2B1 4p2h HR_ABcd^ij
C> (active-alpha)-alpha-(active-beta)-beta,alpha-beta components
C> @param V4C2B2 4p2h HR_abCD^ij
C> (non-active-alpha)-(non-active-alpha)-(active-beta)-(active-beta),alpha-beta components
C> @param V4D2C 4p2h HR_aBCd^ij
C> alpha-(active-beta)-(active-beta)-beta,beta-beta components
C> @param V4D2C1 4p2h HR_ABcd^ij
C> (active-alpha)-(active-beta)-(non-active-beta)-(non-active-beta),beta-beta components
C> @param R2B0A 2p R_ab alpha-beta components
C> @param R3B1A 3p1h R_abc^i alpha-alpha-beta,alpha components
C> @param R3C1B 3p1h R_abc^i alpha-beta-beta,beta components
C> @param R4B2A 4p2h R_ABcd^ij
C> (active-alpha)-(active-alpha)-alpha-beta,alpha-alpha components
C> @param R4B2A1 4p2h R_AbcD^ij
C> (active-alpha)-(non-active-alpha)-(non-active-alpha)-(active-beta),alpha-alpha components
C> @param R4C2B 4p2h R_AbCd^ij
C> (active-alpha)-(active-alpha)-(non-active-beta)-(non-active-beta),alpha-beta components
C> @param R4C2B1 4p2h R_ABcd^ij
C> (active-alpha)-alpha-(active-beta)-beta,alpha-beta components
C> @param R4C2B2 4p2h R_abCD^ij
C> (non-active-alpha)-(non-active-alpha)-(active-beta)-(active-beta),alpha-beta components
C> @param R4D2C 4p2h R_aBCd^ij
C> alpha-(active-beta)-(active-beta)-beta,beta-beta components
C> @param R4D2C1 4p2h R_ABcd^ij
C> (active-alpha)-(active-beta)-(non-active-beta)-(non-active-beta),beta-beta components
C>
       SUBROUTINE DEAEOM3B_PPPP(N0,N1,N2,N3,M2,NFT899,
     & K1,K2,K3,K4,K6,K9,K0,
     & T1A,T1B,T2A,T2B,T2C,
     & V2B0A,V3B1A,V3C1B,V4B2A,V4B2A1,V4C2B,V4C2B1,V4C2B2,V4D2C,V4D2C1,
     & R2B0A,R3B1A,R3C1B,R4B2A,R4B2A1,R4C2B,R4C2B1,R4C2B2,R4D2C,R4D2C1)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       INTEGER A,B,C,D,E,F,R,X
       real*8 T1A(N1+1:N3,N0+1:N1)
       real*8 T1B(N2+1:N3,N0+1:N2)
       real*8 T2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 T2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 T2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 V2B0A(N2+1:N3,N1+1:N3)
       real*8 V3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 V3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2)
       real*8
     *V4B2A(N2+1:N3,N1+1:N3,N1+1:M2,N1+1:M2,N0+1:N1,N0+1:N1)
       real*8
     *V4B2A1(N2+1:M2,M2+1:N3,M2+1:N3,N1+1:M2,N0+1:N1,N0+1:N1)
       real*8
     *V4C2B(N2+1:N3,N2+1:M2,N1+1:N3,N1+1:M2,N0+1:N2,N0+1:N1)
       real*8
     *V4C2B1(M2+1:N3,M2+1:N3,N1+1:M2,N1+1:M2,N0+1:N2,N0+1:N1)
       real*8
     *V4C2B2(N2+1:M2,N2+1:M2,M2+1:N3,M2+1:N3,N0+1:N2,N0+1:N1)
       real*8
     *V4D2C(N2+1:N3,N2+1:M2,N2+1:M2,N1+1:N3,N0+1:N2,N0+1:N2)
       real*8
     *V4D2C1(M2+1:N3,M2+1:N3,N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N2)
       real*8 R2B0A(N2+1:N3,N1+1:N3)
       real*8 R3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 R3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2)
       real*8
     *R4B2A(N2+1:N3,N1+1:N3,N1+1:M2,N1+1:M2,N0+1:N1,N0+1:N1)
       real*8
     *R4B2A1(N2+1:M2,M2+1:N3,M2+1:N3,N1+1:M2,N0+1:N1,N0+1:N1)
       real*8
     *R4C2B(N2+1:N3,N2+1:M2,N1+1:N3,N1+1:M2,N0+1:N2,N0+1:N1)
       real*8
     *R4C2B1(M2+1:N3,M2+1:N3,N1+1:M2,N1+1:M2,N0+1:N2,N0+1:N1)
       real*8
     *R4C2B2(N2+1:M2,N2+1:M2,M2+1:N3,M2+1:N3,N0+1:N2,N0+1:N1)
       real*8
     *R4D2C(N2+1:N3,N2+1:M2,N2+1:M2,N1+1:N3,N0+1:N2,N0+1:N2)
       real*8
     *R4D2C1(M2+1:N3,M2+1:N3,N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N2)
C
       real*8,ALLOCATABLE::HPPP(:,:,:)
       real*8,ALLOCATABLE::B2(:,:)
       real*8,ALLOCATABLE::B21(:,:)
       real*8,ALLOCATABLE::C1(:,:,:)
       real*8,ALLOCATABLE::C2(:,:,:)
       real*8,ALLOCATABLE::C3(:,:,:)
       real*8,ALLOCATABLE::D2(:,:,:,:)
       real*8,ALLOCATABLE::D21(:,:,:,:)
       real*8,ALLOCATABLE::D22(:,:,:,:)
       real*8,ALLOCATABLE::D23(:,:,:,:)
       real*8,ALLOCATABLE::F2(:,:,:,:,:,:)
       real*8,ALLOCATABLE::F21(:,:,:,:,:,:)
       real*8,ALLOCATABLE::F22(:,:,:,:,:,:)
C
       real*8,ALLOCATABLE::U2B0A(:)
       real*8,ALLOCATABLE::S1(:,:,:)
       real*8,ALLOCATABLE::S2(:,:,:)
       real*8,ALLOCATABLE::S3(:,:,:)
       real*8,ALLOCATABLE::S4(:,:,:)
       real*8,ALLOCATABLE::S5(:,:,:)
       real*8,ALLOCATABLE::S6(:,:,:)
       real*8,ALLOCATABLE::S7(:,:,:,:)
       real*8,ALLOCATABLE::U1(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U5(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U2(:,:,:,:,:)
       real*8,ALLOCATABLE::S8(:,:,:,:)
       real*8,ALLOCATABLE::U3(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U8(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U4(:,:,:,:,:)
       real*8,ALLOCATABLE::U6(:,:,:,:,:)
       real*8,ALLOCATABLE::S9(:,:,:,:)
       real*8,ALLOCATABLE::U7(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U12(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U9(:,:,:,:,:)
       real*8,ALLOCATABLE::S10(:,:,:,:)
       real*8,ALLOCATABLE::U10(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U14(:,:,:,:,:,:)
       real*8,ALLOCATABLE::U11(:,:,:,:,:)
       real*8,ALLOCATABLE::U13(:,:,:,:,:)
       real*8,ALLOCATABLE::U15(:,:,:,:,:)
C
C H2A
C
       ALLOCATE(HPPP(N1+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(D2(N1+1:N3,N1+1:N3,N2+1:N3,N0+1:N1))
       CALL REORDER2314(N2,N3,N1,N3,N1,N3,N0,N1,
     & N1,N3,N1,N3,N2,N3,N0,N1,R3B1A,D2)
C
       ALLOCATE(B2(N1+1:N3,N2+1:M2))
       CALL REORDER21(N2,N3,N1,N3,
     & N1,N3,N2,M2,R2B0A,B2)
       ALLOCATE(S7(N1+1:N3,N2+1:M2,M2+1:N3,M2+1:N3))
C
       ALLOCATE(F2(M2+1:N3,M2+1:N3,N2+1:M2,N1+1:M2,N0+1:N1,N0+1:N1))
       CALL REORDER231456(N2,M2,M2,N3,M2,N3,N1,M2,N0,N1,N0,N1,
     & M2,N3,M2,N3,N2,M2,N1,M2,N0,N1,N0,N1,R4B2A1,F2)
C
       ALLOCATE(F21(M2+1:N3,M2+1:N3,N2+1:M2,N2+1:M2,N0+1:N2,N0+1:N1))
       CALL REORDER341256(N2,M2,N2,M2,M2,N3,M2,N3,N0,N2,N0,N1,
     & M2,N3,M2,N3,N2,M2,N2,M2,N0,N2,N0,N1,R4C2B2,F21)
C
       DO X=M2+1,N3
        READ(NFT899,REC=X-N1)HPPP
        ALLOCATE(C1(N1+1:N3,N1+1:N3,M2+1:N3))
        CALL REORDER123(N1,N3,N1,N3,N1,N3,
     &  N1,N3,N1,N3,M2,N3,HPPP,C1)
C
C V3B1A(IABX):1/2*H2A(ABEF)*R3B1A(IEFR),R:(N2+1:N3),X=A
        ALLOCATE(S1(N2+1:N3,N0+1:N1,M2+1:N3))
        I1=K6
        I2=K1*K4
        I3=K3*K3
        CALL EGEMM(I1,I2,I3,C1,D2,S1)
        DO B=M2+1,N3;DO I=N0+1,N1;DO R=N2+1,N3
         V3B1A(R,B,X,I)=V3B1A(R,B,X,I)+0.5*S1(R,I,B)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S1)
C
C S7(BCDE)=H2A(BCEF)*R2B0A(FD),X=B
        ALLOCATE(C3(N2+1:M2,N1+1:N3,M2+1:N3))
        I1=K6*K3
        I2=K0
        I3=K3
        CALL EGEMM(I1,I2,I3,C1,B2,C3)
        DO C=M2+1,N3;DO E=N1+1,N3;DO D=N2+1,M2
         S7(E,D,C,X)=C3(D,E,C)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(C3)
        DEALLOCATE(C1)
C
        ALLOCATE(C1(M2+1:N3,M2+1:N3,M2+1:N3))
        CALL REORDER123(N1,N3,N1,N3,N1,N3,
     &  M2,N3,M2,N3,M2,N3,HPPP,C1)
C
C V4B2A(IJABCD):1/2*H2A(BCGH)*R4B2A(IJAGHD),X=B
        ALLOCATE(U2(N2+1:M2,N1+1:M2,N0+1:N1,N0+1:N1,M2+1:N3))
        I1=K6
        I2=K1*K1*K9*K0
        I3=K6*K6
        CALL EGEMM(I1,I2,I3,C1,F2,U2)
        DO C=M2+1,N3;DO I=N0+1,N1;DO J=N0+1,N1;DO A=N1+1,M2;DO D=N2+1,M2
         V4B2A1(D,C,X,A,J,I)=V4B2A1(D,C,X,A,J,I)+0.5*U2(D,A,J,I,C)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U2)
C
C V4C2B(IJABCD):1/2*H2A(ABGH)*R4B2A(IJGHCD),X=A
        ALLOCATE(U6(N2+1:M2,N2+1:M2,N0+1:N2,N0+1:N1,M2+1:N3))
        I1=K6
        I2=K1*K2*K0*K0
        I3=K6*K6
        CALL EGEMM(I1,I2,I3,C1,F21,U6)
        DO B=M2+1,N3;DO I=N0+1,N1;DO J=N0+1,N1;DO C=N2+1,M2;DO D=N2+1,M2
         V4C2B2(D,C,B,X,J,I)=V4C2B2(D,C,B,X,J,I)+0.5*U6(D,C,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U6)
        DEALLOCATE(C1)
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(D2)
       DEALLOCATE(B2)
       DEALLOCATE(F2)
       DEALLOCATE(F21)
C
C V4B2A(IJABCD):S7(BCDE)*T2A(IJAE)
       ALLOCATE(D2(N1+1:N3,N1+1:M2,N0+1:N1,N0+1:N1))
       CALL REORDER1234(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N1,M2,N0,N1,N0,N1,T2A,D2)
       ALLOCATE(U1(N1+1:M2,N0+1:N1,N0+1:N1,N2+1:M2,M2+1:N3,M2+1:N3))
       I1=K6*K6*K0
       I2=K1*K1*K9
       I3=K3
       CALL EGEMM(I1,I2,I3,S7,D2,U1)
       DEALLOCATE(D2)
       CALL
     & SUM456123(N2,M2,M2,N3,M2,N3,N1,M2,N0,N1,N0,N1,V4B2A1,U1,1.0_dp)
       DEALLOCATE(U1)
C
C V4C2B(IJABCD):S7(ABCE)*T2A(IJED)-S7(ABDE)*T2A(IJEC)
       ALLOCATE(D2(N1+1:N3,N2+1:M2,N0+1:N2,N0+1:N1))
       CALL REORDER2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,M2,N0,N2,N0,N1,T2B,D2)
       ALLOCATE(U5(N2+1:M2,N0+1:N2,N0+1:N1,N2+1:M2,M2+1:N3,M2+1:N3))
       I1=K6*K6*K0
       I2=K1*K2*K0
       I3=K3
       CALL EGEMM(I1,I2,I3,S7,D2,U5)
       DEALLOCATE(S7)
       DEALLOCATE(D2)
C
       CALL
     & SUM156234(N2,M2,N2,M2,M2,N3,M2,N3,N0,N2,N0,N1,V4C2B2,U5, 1.0_dp)
       CALL
     & SUM256134(N2,M2,N2,M2,M2,N3,M2,N3,N0,N2,N0,N1,V4C2B2,U5,-1.0_dp)
       DEALLOCATE(U5)
C
C H2C
       ALLOCATE(HPPP(N2+1:N3,N2+1:N3,N2+1:N3))
       ALLOCATE(B2(N2+1:N3,N1+1:M2))
       CALL REORDER12(N2,N3,N1,N3,
     & N2,N3,N1,M2,R2B0A,B2)
       ALLOCATE(S10(N2+1:N3,M2+1:N3,M2+1:N3,N1+1:M2))
C
       ALLOCATE(F2(M2+1:N3,M2+1:N3,N1+1:M2,N1+1:M2,N0+1:N2,N0+1:N1))
       CALL REORDER123456(M2,N3,M2,N3,N1,M2,N1,M2,N0,N2,N0,N1,
     & M2,N3,M2,N3,N1,M2,N1,M2,N0,N2,N0,N1,R4C2B1,F2)
C
       ALLOCATE(F21(M2+1:N3,M2+1:N3,N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N2))
       CALL REORDER123456(M2,N3,M2,N3,N2,M2,N1,M2,N0,N2,N0,N2,
     & M2,N3,M2,N3,N2,M2,N1,M2,N0,N2,N0,N2,R4D2C1,F21)
C
       DO X=M2+1,N3
        READ(NFT899,REC=X-N2+K3)HPPP
        ALLOCATE(C1(N2+1:N3,N2+1:N3,M2+1:N3))
        CALL REORDER123(N2,N3,N2,N3,N2,N3,
     &  N2,N3,N2,N3,M2,N3,HPPP,C1)
C
C V3C1B(I*BC):1/2*H2C(BCEF)*R3C1B(IREF),R:(N1+1:N3),X=B
        ALLOCATE(S6(N1+1:N3,N0+1:N2,M2+1:N3))
        I1=K6
        I2=K2*K3
        I3=K4*K4
        CALL EGEMM(I1,I2,I3,C1,R3C1B,S6)
        DO C=M2+1,N3;DO I=N0+1,N2;DO R=N1+1,N3
         V3C1B(C,X,R,I)=V3C1B(C,X,R,I)+0.5*S6(R,I,C)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S6)
C
C S10(ACDF)=H2C(CDEF)*R2B0A(AF),X=C
        ALLOCATE(C3(N1+1:M2,N2+1:N3,M2+1:N3))
        I1=K6*K4
        I2=K9
        I3=K4
        CALL EGEMM(I1,I2,I3,C1,B2,C3)
        DO D=M2+1,N3;DO E=N2+1,N3;DO A=N1+1,M2
         S10(E,D,X,A)=C3(A,E,D)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(C3)
        DEALLOCATE(C1)
C
        ALLOCATE(C1(M2+1:N3,M2+1:N3,M2+1:N3))
        CALL REORDER123(N2,N3,N2,N3,N2,N3,
     &  M2,N3,M2,N3,M2,N3,HPPP,C1)
C
C V4C2B(IJABCD):1/2*H2C(CDGH)*R4C2B(IJABGH),X=D
        ALLOCATE(U11(N1+1:M2,N1+1:M2,N0+1:N2,N0+1:N1,M2+1:N3))
        I1=K6
        I2=K1*K2*K9*K9
        I3=K6*K6
        CALL EGEMM(I1,I2,I3,C1,F2,U11)
        DO D=M2+1,N3;DO I=N0+1,N1;DO J=N0+1,N2;DO A=N1+1,M2;DO B=N1+1,M2
         V4C2B1(D,X,B,A,J,I)=V4C2B1(D,X,B,A,J,I)+0.5*U11(B,A,J,I,D)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U11)
C
C V4D2C(IJABCD):1/2*H2C(CDGH)*R4D2C(IJABGH),X=D
        ALLOCATE(U15(N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N2,M2+1:N3))
        I1=K6
        I2=K2*K2*K9*K0
        I3=K6*K6
        CALL EGEMM(I1,I2,I3,C1,F21,U15)
        DO D=M2+1,N3;DO I=N0+1,N2;DO J=N0+1,N2;DO A=N1+1,M2;DO B=N2+1,M2
         V4D2C1(D,X,B,A,J,I)=V4D2C1(D,X,B,A,J,I)+0.5*U15(B,A,J,I,D)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U15)
        DEALLOCATE(C1)
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(B2)
       DEALLOCATE(F2)
       DEALLOCATE(F21)
C
C V4C2B(IJABCD):S(ACDF)*T2B(IJBF)-S(BCDE)*T2B(IJAE)
       ALLOCATE(D2(N2+1:N3,N1+1:M2,N0+1:N2,N0+1:N1))
       CALL REORDER1234(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N1,M2,N0,N2,N0,N1,T2B,D2)
       ALLOCATE(U10(N1+1:M2,N0+1:N2,N0+1:N1,M2+1:N3,M2+1:N3,N1+1:M2))
       I1=K9*K6*K6
       I2=K1*K2*K9
       I3=K4
       CALL EGEMM(I1,I2,I3,S10,D2,U10)
       DEALLOCATE(D2)
       CALL
     & SUM356124(M2,N3,M2,N3,N1,M2,N1,M2,N0,N2,N0,N1,V4C2B1,U10, 1.0_dp)
       CALL
     & SUM456123(M2,N3,M2,N3,N1,M2,N1,M2,N0,N2,N0,N1,V4C2B1,U10,-1.0_dp)
       DEALLOCATE(U10)
C
C V4D2C(IJABCD):S10(ACDF)*T2C(IJBF)
       ALLOCATE(D2(N2+1:N3,N2+1:M2,N0+1:N2,N0+1:N2))
       CALL REORDER1234(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N2,M2,N0,N2,N0,N2,T2C,D2)
       ALLOCATE(U14(N2+1:M2,N0+1:N2,N0+1:N2,M2+1:N3,M2+1:N3,N1+1:M2))
       I1=K9*K6*K6
       I2=K2*K2*K0
       I3=K4
       CALL EGEMM(I1,I2,I3,S10,D2,U14)
       DEALLOCATE(S10)
       DEALLOCATE(D2)
       CALL
     & SUM356124(M2,N3,M2,N3,N2,M2,N1,M2,N0,N2,N0,N2,V4D2C1,U14, 1.0_dp)
       DEALLOCATE(U14)
C
C H2B
       ALLOCATE(HPPP(N2+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(D2(N2+1:N3,N1+1:N3,M2+1:N3,N0+1:N1))
       CALL REORDER1234(N2,N3,N1,N3,N1,N3,N0,N1,
     & N2,N3,N1,N3,M2,N3,N0,N1,R3B1A,D2)
       ALLOCATE(D21(N2+1:N3,N1+1:N3,N1+1:M2,N0+1:N1))
       CALL REORDER1234(N2,N3,N1,N3,N1,N3,N0,N1,
     & N2,N3,N1,N3,N1,M2,N0,N1,R3B1A,D21)
       ALLOCATE(D22(N2+1:N3,N1+1:N3,M2+1:N3,N0+1:N2))
       CALL REORDER1324(N2,N3,N2,N3,N1,N3,N0,N2,
     & N2,N3,N1,N3,M2,N3,N0,N2,R3C1B,D22)
       ALLOCATE(D23(N2+1:N3,N1+1:N3,N2+1:M2,N0+1:N2))
       CALL REORDER1324(N2,N3,N2,N3,N1,N3,N0,N2,
     & N2,N3,N1,N3,N2,M2,N0,N2,R3C1B,D23)
       ALLOCATE(F2(M2+1:N3,M2+1:N3,N1+1:M2,N1+1:M2,N0+1:N1,N0+1:N1))
       CALL REORDER123456(N2,N3,N1,N3,N1,M2,N1,M2,N0,N1,N0,N1,
     & M2,N3,M2,N3,N1,M2,N1,M2,N0,N1,N0,N1,R4B2A,F2)
       ALLOCATE(F21(M2+1:N3,M2+1:N3,N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N1))
       CALL REORDER132456(N2,N3,N2,M2,N1,N3,N1,M2,N0,N2,N0,N1,
     & M2,N3,M2,N3,N2,M2,N1,M2,N0,N2,N0,N1,R4C2B,F21)
       ALLOCATE(F22(M2+1:N3,M2+1:N3,N2+1:M2,N2+1:M2,N0+1:N2,N0+1:N2))
       CALL REORDER142356(N2,N3,N2,M2,N2,M2,N1,N3,N0,N2,N0,N2,
     & M2,N3,M2,N3,N2,M2,N2,M2,N0,N2,N0,N2,R4D2C,F22)
       ALLOCATE(B2(N2+1:N3,N1+1:M2))
       CALL REORDER12(N2,N3,N1,N3,
     & N2,N3,N1,M2,R2B0A,B2)
       ALLOCATE(S8(N1+1:N3,M2+1:N3,M2+1:N3,N1+1:M2))
       ALLOCATE(B21(N1+1:N3,N2+1:M2))
       CALL REORDER21(N2,N3,N1,N3,
     & N1,N3,N2,M2,R2B0A,B21)
       ALLOCATE(S9(N2+1:N3,M2+1:N3,N2+1:M2,M2+1:N3))
       DO X=M2+1,N3
        READ(NFT899,REC=X-N2+K3+K4)HPPP
C
        ALLOCATE(C1(N2+1:N3,N1+1:N3,M2+1:N3))
        CALL REORDER123(N2,N3,N1,N3,N1,N3,
     & N2,N3,N1,N3,M2,N3,HPPP,C1)
C
C V2B0A: H2B(ABEF)*R2B0A(EF),X=B
        ALLOCATE(U2B0A(M2+1:N3))
        I1=K6
        I3=K3*K4
        CALL EGEMM1(I1,I3,C1,R2B0A,U2B0A)
        DO A=M2+1,N3
         V2B0A(X,A)=V2B0A(X,A)+U2B0A(A)
        ENDDO
        DEALLOCATE(U2B0A)
C
C V3B1A(C,B,A,I):H2B(B,C,E,F)*R3B1A(IAEF)-H2B(A,C,E,F)*R3B1A(IBEF),X=C
        ALLOCATE(S2(M2+1:N3,N0+1:N1,M2+1:N3))
        I1=K6
        I2=K1*K6
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,C1,D2,S2)
        DO B=M2+1,N3;DO I=N0+1,N1;DO A=M2+1,N3
         V3B1A(X,B,A,I)=V3B1A(X,B,A,I)+S2(A,I,B)-S2(B,I,A)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S2)
C
C V3B1A(C,B,A,I):H2B(B,C,E,F)*R3B1A(IAEF),X=C
        I1=K6
        I2=K1*K9
        I3=K3*K4
        ALLOCATE(S3(N1+1:M2,N0+1:N1,M2+1:N3))
        CALL EGEMM(I1,I2,I3,C1,D21,S3)
        DO B=M2+1,N3;DO I=N0+1,N1;DO A=N1+1,M2
         V3B1A(X,B,A,I)=V3B1A(X,B,A,I)+S3(A,I,B)
!        V3B1A(X,A,B,I)=V3B1A(X,A,B,I)-S3(A,I,B)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S3)
C
C V3C1B(C,B,A,I):H2B(A,C,E,F)*R3C1B(IEBF)-H2B(A,B,E,F)*R3C1B(IECF),X=C
        I1=K6
        I2=K2*K6
        I3=K3*K4
        ALLOCATE(S4(M2+1:N3,N0+1:N2,M2+1:N3))
        CALL EGEMM(I1,I2,I3,C1,D22,S4)
        DO A=M2+1,N3;DO I=N0+1,N1;DO B=M2+1,N3
         V3C1B(X,B,A,I)=V3C1B(X,B,A,I)+S4(B,I,A)
         V3C1B(B,X,A,I)=V3C1B(B,X,A,I)-S4(B,I,A)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S4)
C
C V3C1B(C,B,A,I):H2B(A,C,E,F)*R3C1B(IEBF),X=C
        ALLOCATE(S5(N2+1:M2,N0+1:N2,M2+1:N3))
        I1=K6
        I2=K2*K0
        I3=K3*K4
        CALL EGEMM(I1,I2,I3,C1,D23,S5)
        DO A=M2+1,N3;DO I=N0+1,N2;DO B=N2+1,M2
         V3C1B(X,B,A,I)=V3C1B(X,B,A,I)+S5(B,I,A)
!        V3C1B(B,X,A,I)=V3C1B(B,X,A,I)-S5(B,I,A)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(S5)
C
C S8(ACDE)=H2B(CDEF)*R2B0A(AF),X=D
        ALLOCATE(C3(N1+1:M2,N1+1:N3,M2+1:N3))
        I1=K6*K3
        I2=K9
        I3=K4
        CALL EGEMM(I1,I2,I3,C1,B2,C3)
        DO C=M2+1,N3;DO E=N1+1,N3;DO A=N1+1,M2
         S8(E,X,C,A)=C3(A,E,C)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(C3)
        DEALLOCATE(C1)
C
        ALLOCATE(C1(M2+1:N3,M2+1:N3,M2+1:N3))
        CALL REORDER123(N2,N3,N1,N3,N1,N3,
     &  M2,N3,M2,N3,M2,N3,HPPP,C1)
C
C V4B2A(IJABCD):H2B(CDGH)*R4B2A(IJABGH),X=D
        I1=K6
        I2=K1*K1*K9*K9
        I3=K6*K6
        ALLOCATE(U4(N1+1:M2,N1+1:M2,N0+1:N1,N0+1:N1,M2+1:N3))
        CALL EGEMM(I1,I2,I3,C1,F2,U4)
        DO C=M2+1,N3;DO I=N0+1,N1;DO J=N0+1,N1;DO A=N1+1,M2;DO B=N1+1,M2
         V4B2A(X,C,B,A,J,I)=V4B2A(X,C,B,A,J,I)+U4(B,A,J,I,C)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U4)
C
C V4C2B(IJABCD):H2B(BDGH)*R4C2B(IJAGCH),X=D
        I1=K6
        I2=K1*K2*K9*K0
        I3=K6*K6
        ALLOCATE(U9(N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N1,M2+1:N3))
        CALL EGEMM(I1,I2,I3,C1,F21,U9)
        DO B=M2+1,N3;DO I=N0+1,N1;DO J=N0+1,N2;DO A=N1+1,M2;DO C=N2+1,M2
         V4C2B(X,C,B,A,J,I)=V4C2B(X,C,B,A,J,I)+U9(C,A,J,I,B)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U9)
C
C V4D2C(IJABCD):H2B(ADGH)*R4C2B(IJGBCH),X=D
        I1=K6
        I2=K2*K2*K0*K0
        I3=K6*K6
        ALLOCATE(U13(N2+1:M2,N2+1:M2,N0+1:N2,N0+1:N2,M2+1:N3))
        CALL EGEMM(I1,I2,I3,C1,F22,U13)
        DO A=M2+1,N3;DO I=N0+1,N2;DO J=N0+1,N2;DO B=N2+1,M2;DO C=N2+1,M2
         V4D2C(X,C,B,A,J,I)=V4D2C(X,C,B,A,J,I)+U13(C,B,J,I,A)
        ENDDO;ENDDO;ENDDO;ENDDO;ENDDO
        DEALLOCATE(U13)
        DEALLOCATE(C1)
C
C S9(BDCF)=H2B(BDEF)*R2B0A(EC),X=D
        ALLOCATE(C1(N1+1:N3,N2+1:N3,M2+1:N3))
        CALL REORDER213(N2,N3,N1,N3,N1,N3,
     &  N1,N3,N2,N3,M2,N3,HPPP,C1)
        ALLOCATE(C3(N2+1:M2,N2+1:N3,M2+1:N3))
        I1=K6*K4
        I2=K0
        I3=K3
        CALL EGEMM(I1,I2,I3,C1,B21,C3)
        DO B=M2+1,N3;DO F=N2+1,N3;DO C=N2+1,M2
         S9(F,X,C,B)=C3(C,F,B)
        ENDDO;ENDDO;ENDDO
        DEALLOCATE(C1)
        DEALLOCATE(C3)
       ENDDO
       DEALLOCATE(HPPP)
       DEALLOCATE(D2)
       DEALLOCATE(D21)
       DEALLOCATE(D22)
       DEALLOCATE(D23)
       DEALLOCATE(F2)
       DEALLOCATE(F21)
       DEALLOCATE(F22)
       DEALLOCATE(B2)
       DEALLOCATE(B21)
C
C V4B2A(IJABCD): S8(ACDE)*T2A(IJBE)-S8(BCDE)*T2A(IJAE)
       ALLOCATE(D2(N1+1:N3,N1+1:M2,N0+1:N1,N0+1:N1))
       CALL REORDER1234(N1,N3,N1,N3,N0,N1,N0,N1,
     & N1,N3,N1,M2,N0,N1,N0,N1,T2A,D2)
       ALLOCATE(U3(N1+1:M2,N0+1:N1,N0+1:N1,M2+1:N3,M2+1:N3,N1+1:M2))
       I1=K9*K6*K6
       I2=K1*K1*K9
       I3=K3
       CALL EGEMM(I1,I2,I3,S8,D2,U3)
       DEALLOCATE(D2)
       DO A=N1+1,M2;DO C=M2+1,N3;DO D=M2+1,N3
       DO I=N0+1,N1;DO J=N0+1,N1;DO B=N1+1,M2
        V4B2A(D,C,B,A,J,I)=V4B2A(D,C,B,A,J,I)+U3(B,J,I,D,C,A)
        V4B2A(D,C,B,A,J,I)=V4B2A(D,C,B,A,J,I)-U3(A,J,I,D,C,B)
       ENDDO;ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO
       DEALLOCATE(U3)
C
C V4C2B(IJABCD): S8(ABDE)*T2B(IJEC)
       ALLOCATE(D2(N1+1:N3,N2+1:M2,N0+1:N2,N0+1:N1))
       CALL REORDER2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,M2,N0,N2,N0,N1,T2B,D2)
       ALLOCATE(U8(N2+1:M2,N0+1:N2,N0+1:N1,M2+1:N3,M2+1:N3,N1+1:M2))
       I1=K9*K6*K6
       I2=K1*K2*K0
       I3=K3
       CALL EGEMM(I1,I2,I3,S8,D2,U8)
       DEALLOCATE(S8)
       DEALLOCATE(D2)
       DO B=M2+1,N3;DO C=N2+1,M2;DO D=M2+1,N3
       DO I=N0+1,N1;DO J=N0+1,N2;DO A=N1+1,M2
        V4C2B(D,C,B,A,J,I)=V4C2B(D,C,B,A,J,I)+U8(C,J,I,D,B,A)
       ENDDO;ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO
       DEALLOCATE(U8)
C
C V4C2B(IJABCD): S9(BCDF)*T2B(IJAF)
       ALLOCATE(D2(N2+1:N3,N1+1:M2,N0+1:N2,N0+1:N1))
       CALL REORDER1234(N2,N3,N1,N3,N0,N2,N0,N1,
     & N2,N3,N1,M2,N0,N2,N0,N1,T2B,D2)
       ALLOCATE(U7(N1+1:M2,N0+1:N2,N0+1:N1,M2+1:N3,N2+1:M2,M2+1:N3))
       I1=K6*K0*K6
       I2=K1*K2*K9
       I3=K4
       CALL EGEMM(I1,I2,I3,S9,D2,U7)
       DEALLOCATE(D2)
       DO B=M2+1,N3;DO C=N2+1,M2;DO D=M2+1,N3
       DO I=N0+1,N1;DO J=N0+1,N2;DO A=N1+1,M2
        V4C2B(D,C,B,A,J,I)=V4C2B(D,C,B,A,J,I)+U7(A,J,I,D,C,B)
       ENDDO;ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO
       DEALLOCATE(U7)
C
C V4D2C(IJABCD): S9(ABDF)*T2B(IJCF)-S9(ACDF)*T2B(IJBF)
       ALLOCATE(D2(N2+1:N3,N2+1:M2,N0+1:N2,N0+1:N2))
       CALL REORDER1234(N2,N3,N2,N3,N0,N2,N0,N2,
     & N2,N3,N2,M2,N0,N2,N0,N2,T2C,D2)
       ALLOCATE(U12(N2+1:M2,N0+1:N2,N0+1:N2,M2+1:N3,N2+1:M2,M2+1:N3))
       I1=K6*K0*K6
       I2=K2*K2*K0
       I3=K4
       CALL EGEMM(I1,I2,I3,S9,D2,U12)
       DEALLOCATE(S9)
       DEALLOCATE(D2)
       DO C=N2+1,M2;DO J=N0+1,N2;DO I=N0+1,N2
       DO D=M2+1,N3;DO B=N2+1,M2;DO A=M2+1,N3
        V4D2C(D,C,B,A,J,I)=V4D2C(D,C,B,A,J,I)+U12(C,J,I,D,B,A)
        V4D2C(D,C,B,A,J,I)=V4D2C(D,C,B,A,J,I)-U12(B,J,I,D,C,A)
       ENDDO;ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO
       DEALLOCATE(U12)
C
       END
C
C
C*MODULE DEAEOMDIP DECK DEAEOM3_HR
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param ITER number of iteration
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param K2B0A first number of 2p R_ab alpha-beta components
C> @param K3B1A first number of 3p1h R_abc^i alpha-alpha-beta,alpha components
C> @param K3C1B first number of 3p1h R_abc^i alpha-beta-beta,beta components
C> @param K4B2A first number of 4p2h R_abcd^ij
C> alpha-alpha-alpha-beta,alpha-alpha components
C> @param K4C2B first number of 4p2h R_abcd^ij
C> alpha-alpha-beta-beta,alpha-beta components
C> @param K4D2C first number of 4p2h R_abcd^ij
C> alpha-beta-beta-beta,beta-beta components
C> @param KKK number size of the CCSD cluster vector
C> @param LLL number size of the DEA(4p2h) vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C>
       SUBROUTINE DEAEOM3_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL,
     & K2B0A,K3B1A,K3C1B,K4B2A,K4C2B,K4D2C,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HAPPPP(N1+1:N3,N1+1:N3,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HBPPPP(N2+1:N3,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 HCPPPP(N2+1:N3,N2+1:N3,N2+1:N3,N2+1:N3)
       real*8 T(KKK)
       real*8,ALLOCATABLE::HR(:),R(:)
C
       ALLOCATE(HR(LLL),SOURCE=0.0D0)
       ALLOCATE(R(LLL),SOURCE=0.0D0)
!      READ(IR,REC=ITER)R
       CALL DEAEOM_READ(IR,ITER,LLL,R)
C
        CALL DEAEOM3HR2B0A(N0,N1,N2,N3,HR(K2B0A),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4C2B),R(K4D2C))
C
       CALL DEAEOM3HR3B1A(N0,N1,N2,N3,HR(K3B1A),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4C2B),R(K4D2C))
C
       CALL DEAEOM3HR3C1B(N0,N1,N2,N3,HR(K3C1B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4C2B),R(K4D2C))
C
       CALL DEAEOM3HR4B2A(N0,N1,N2,N3,HR(K4B2A),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4C2B),R(K4D2C))
C
       CALL DEAEOM3HR4C2B(N0,N1,N2,N3,HR(K4C2B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4C2B),R(K4D2C))
C
       CALL DEAEOM3HR4D2C(N0,N1,N2,N3,HR(K4D2C),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K2B0A),R(K3B1A),R(K3C1B),R(K4B2A),R(K4C2B),R(K4D2C))
C
!      WRITE(IHR,REC=ITER)HR
       CALL DEAEOM_WRITE(IHR,ITER,LLL,HR)
       DEALLOCATE(HR,R)
       END
C
C*MODULE DEAEOMDIP DECK DEAEOM_INI
C> @brief generate the DEA-EOMCC initial guess
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR0 .R0 file unit number
C> @param NROOT number of excited states to be calculated
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param INDROOT excited states to be calculated
C> @param MULT multiplicity of the excited states to be calculated
C> @param MINIT option for initial guess
C> @param MACT option for initial guess
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M3 index of last unactive occupied orbital for initial guess
C> @param M4 index of the last active unoccupied orbital for initial guess
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param KKK number size of the DEA(3p1h) vector
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C
       SUBROUTINE DEAEOM_INI(N0,N1,N2,N3,K3,K4,KKK,M3,M4,IO,IR0,NROOT,
     & K2B0A,K3B1A,K3C1B,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899,INDROOT,MULT,MINIT,MACT)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
      LOGICAL GOPARR,DSKWRK,MASWRK
      INTEGER ME,MASTER,NPROC,IBTYP,IPTIM
      COMMON /PAR   / ME,MASTER,NPROC,IBTYP,IPTIM,GOPARR,DSKWRK,MASWRK
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 PP,NS2
       real*8,ALLOCATABLE::HM(:,:),HM1(:,:)
       real*8,ALLOCATABLE::S2(:,:)
       real*8,ALLOCATABLE::HPPP(:,:,:)
       INTEGER,ALLOCATABLE::INDALL(:),ID1(:),ID2(:)
       INTEGER,ALLOCATABLE::IND2B0A(:,:)
       INTEGER,ALLOCATABLE::IND3B1A(:,:,:,:)
       INTEGER,ALLOCATABLE::IND3C1B(:,:,:,:)
       INTEGER,ALLOCATABLE::INDA2B0A(:,:)
       INTEGER,ALLOCATABLE::INDA3B1A(:,:,:,:)
       INTEGER,ALLOCATABLE::INDA3C1B(:,:,:,:)
       INTEGER A,B,C,D,E,F,X,INDROOT(NROOT)
       real*8,ALLOCATABLE:: WR(:),WI(:),WORK(:)
       real*8,ALLOCATABLE:: VR(:,:),VL(:,:),VR0(:)
       CHARACTER*1 JOBVL,JOBVR
C
       ALLOCATE(INDALL(KKK),SOURCE=0)
       ALLOCATE(IND2B0A(N2+1:N3,N1+1:N3),SOURCE=0)
       ALLOCATE(IND3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1),SOURCE=0)
       ALLOCATE(IND3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2),SOURCE=0)
       ALLOCATE(INDA2B0A(N2+1:N3,N1+1:N3),SOURCE=0)
       ALLOCATE(INDA3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1),SOURCE=0)
       ALLOCATE(INDA3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2),SOURCE=0)
C
       LLL=0
       DO A=N1+1,N3;DO B=N2+1,N3
        LLL=LLL+1
        IND2B0A(B,A)=LLL
       ENDDO;ENDDO
       DO I=N0+1,N1;DO A=N1+1,N3;DO B=N1+1,N3;DO C=N2+1,N3
        LLL=LLL+1
        IND3B1A(C,B,A,I)=LLL
       ENDDO;ENDDO;ENDDO;ENDDO
       DO I=N0+1,N2;DO A=N1+1,N3;DO B=N2+1,N3;DO C=N2+1,N3
        LLL=LLL+1
        IND3C1B(C,B,A,I)=LLL
       ENDDO;ENDDO;ENDDO;ENDDO
       IF(LLL.NE.KKK)THEN
        IF(MASWRK)WRITE(IO,*)'LLL != KKK'
        CALL ABRT
       ENDIF
C
       LLLA=0
       DO A=N1+1,N3;DO B=N2+1,N3
        IF(MACT.GT.0.AND.NUMA_DEAEOM(A,B,M4+1,M4).LT.MACT)CYCLE
        LLLA=LLLA+1
        INDA2B0A(B,A)=LLLA
        INDALL(IND2B0A(B,A))=LLLA
       ENDDO;ENDDO
       IF(MINIT.EQ.2)GOTO 111
       IA=3
       DO I=M3+1,N1;DO A=N1+1,N3-1;DO B=A+1,N3;DO C=N2+1,N3
        IF(NUMA_DEAEOM(A,B,C,M4).LT.IA)CYCLE
        LLLA=LLLA+1
        INDA3B1A(C,B,A,I)=LLLA
        INDALL(IND3B1A(C,B,A,I))=LLLA
        INDA3B1A(C,A,B,I)=-LLLA
        INDALL(IND3B1A(C,A,B,I))=-LLLA
       ENDDO;ENDDO;ENDDO;ENDDO
       DO I=M3+1,N2;DO A=N1+1,N3;DO B=N2+1,N3-1;DO C=B+1,N3
        IF(NUMA_DEAEOM(A,B,C,M4).LT.IA)CYCLE
        LLLA=LLLA+1
        INDA3C1B(C,B,A,I)=LLLA
        INDALL(IND3C1B(C,B,A,I))=LLLA
        INDA3C1B(B,C,A,I)=-LLLA
        INDALL(IND3C1B(B,C,A,I))=-LLLA
       ENDDO;ENDDO;ENDDO;ENDDO
C
111    CONTINUE
       ALLOCATE(HM(LLLA,LLLA),SOURCE=0.0D0)
C
! R2B0A
C
       DO A=N1+1,N3;DO B=N2+1,N3
        I1=INDA2B0A(B,A)
        IF(I1.EQ.0)CYCLE
        DO E=N1+1,N3
         I3=INDA2B0A(B,E)
         I2=ABS(INDA2B0A(B,E))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAPP(E,A)*I2/I3
        ENDDO
        DO E=N2+1,N3
         I3=INDA2B0A(E,A)
         I2=ABS(INDA2B0A(E,A))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPP(E,B)*I2/I3
        ENDDO
        IF(MINIT.EQ.2)CYCLE
        DO E=N1+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(B,E,A,M)
         I2=ABS(INDA3B1A(B,E,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHP(E,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,N3;DO F=N1+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(B,F,E,M)
         I2=ABS(INDA3B1A(B,F,E,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAHPPP(F,E,A,M)*I2/I3*0.5_dp
        ENDDO;ENDDO;ENDDO
        DO E=N1+1,N3;DO F=N2+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(F,E,A,M)
         I2=ABS(INDA3B1A(F,E,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHPPP(F,E,B,M)*I2/I3
        ENDDO;ENDDO;ENDDO
        DO E=N2+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(E,B,A,M)
         I2=ABS(INDA3C1B(E,B,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHP(E,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,N3;DO F=N2+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(F,B,E,M)
         I2=ABS(INDA3C1B(F,B,E,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPHPP(F,E,M,A)*I2/I3
        ENDDO;ENDDO;ENDDO
        DO E=N2+1,N3;DO F=N2+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(F,E,A,M)
         I2=ABS(INDA3C1B(F,E,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HCHPPP(F,E,B,M)*I2/I3*0.5_dp
        ENDDO;ENDDO;ENDDO
       ENDDO;ENDDO
C
        IF(MINIT.EQ.2)GOTO 222
! R3B1A
       DO I=M3+1,N1;DO A=N1+1,N3-1;DO B=A+1,N3;DO C=N2+1,N3
        I1=INDA3B1A(C,B,A,I)
        IF(I1.EQ.0)CYCLE
        DO E=N1+1,N3
         I3=INDA2B0A(C,E)
         I2=ABS(INDA2B0A(C,E))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAPPHP(E,I,B,A)*I2/I3
        ENDDO
        DO E=N2+1,N3
         I3=INDA2B0A(E,A)
         I2=ABS(INDA2B0A(E,A))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPPHP(E,I,C,B)*I2/I3
        ENDDO
        DO E=N2+1,N3
         I3=INDA2B0A(E,B)
         I2=ABS(INDA2B0A(E,B))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPPHP(E,I,C,A)*I2/I3
        ENDDO
        DO M=M3+1,N1
         I3=INDA3B1A(C,B,A,M)
         I2=ABS(INDA3B1A(C,B,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHH(I,M)*I2/I3
        ENDDO
        DO E=N1+1,N3
         I3=INDA3B1A(C,E,A,I)
         I2=ABS(INDA3B1A(C,E,A,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAPP(E,B)*I2/I3
        ENDDO
        DO E=N1+1,N3
         I3=INDA3B1A(C,E,B,I)
         I2=ABS(INDA3B1A(C,E,B,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAPP(E,A)*I2/I3
        ENDDO
        DO E=N2+1,N3
         I3=INDA3B1A(E,B,A,I)
         I2=ABS(INDA3B1A(E,B,A,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPP(E,C)*I2/I3
        ENDDO
        DO E=N1+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(C,E,A,M)
         I2=ABS(INDA3B1A(C,E,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHPHP(E,I,B,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(C,E,B,M)
         I2=ABS(INDA3B1A(C,E,B,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAHPHP(E,I,A,M)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(E,B,A,M)
         I2=ABS(INDA3B1A(E,B,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHPHP(E,I,C,M)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(E,C,A,M)
         I2=ABS(INDA3C1B(E,C,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPHHP(E,I,M,B)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(E,C,B,M)
         I2=ABS(INDA3C1B(E,C,B,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPHHP(E,I,M,A)*I2/I3
        ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO;ENDDO
C
! R3C1B
       DO I=M3+1,N2;DO A=N1+1,N3;DO B=N2+1,N3-1;DO C=B+1,N3
        I1=INDA3C1B(C,B,A,I)
        IF(I1.EQ.0)CYCLE
        DO E=N1+1,N3
         I3=INDA2B0A(B,E)
         I2=ABS(INDA2B0A(B,E))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPPPH(I,E,C,A)*I2/I3
        ENDDO
        DO E=N1+1,N3
         I3=INDA2B0A(C,E)
         I2=ABS(INDA2B0A(C,E))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPPPH(I,E,B,A)*I2/I3
        ENDDO
        DO E=N2+1,N3
         I3=INDA2B0A(E,A)
         I2=ABS(INDA2B0A(E,A))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HCPPHP(E,I,C,B)*I2/I3
        ENDDO
        DO E=N1+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(B,E,A,M)
         I2=ABS(INDA3B1A(B,E,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHPPH(I,E,C,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,N3;DO M=M3+1,N1
         I3=INDA3B1A(C,E,A,M)
         I2=ABS(INDA3B1A(C,E,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHPPH(I,E,B,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,N3
         I3=INDA3C1B(C,B,E,I)
         I2=ABS(INDA3C1B(C,B,E,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAPP(E,A)*I2/I3
        ENDDO
        DO M=M3+1,N2
         I3=INDA3C1B(C,B,A,M)
         I2=ABS(INDA3C1B(C,B,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHH(I,M)*I2/I3
        ENDDO
        DO E=N2+1,N3
         I3=INDA3C1B(E,B,A,I)
         I2=ABS(INDA3C1B(E,B,A,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPP(E,C)*I2/I3
        ENDDO
        DO E=N2+1,N3
         I3=INDA3C1B(E,C,A,I)
         I2=ABS(INDA3C1B(E,C,A,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPP(E,B)*I2/I3
        ENDDO
        DO E=N1+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(C,B,E,M)
         I2=ABS(INDA3C1B(C,B,E,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPHPH(I,E,M,A)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(E,B,A,M)
         I2=ABS(INDA3C1B(E,B,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HCHPHP(E,I,C,M)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,N3;DO M=M3+1,N2
         I3=INDA3C1B(E,C,A,M)
         I2=ABS(INDA3C1B(E,C,A,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HCHPHP(E,I,B,M)*I2/I3
        ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO;ENDDO
C
       ALLOCATE(HPPP(N1+1:N3,N1+1:N3,N1+1:N3))
       DO A=N1+1,N3-1
        READ(NFT899,REC=A-N1)HPPP
        DO B=A+1,N3;DO I=M3+1,N1;DO C=N2+1,N3
         I1=INDA3B1A(C,B,A,I)
         IF(I1.EQ.0)CYCLE
         DO E=N1+1,N3;DO F=N1+1,N3
          I3=INDA3B1A(C,F,E,I)
          I2=ABS(INDA3B1A(C,F,E,I))
          IF(I2.EQ.0)CYCLE
          HM(I1,I2)=HM(I1,I2)+HPPP(F,E,B)*I2/I3*0.5_dp
         ENDDO;ENDDO
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
C
       ALLOCATE(HPPP(N2+1:N3,N2+1:N3,N2+1:N3))
       DO B=N2+1,N3-1
        READ(NFT899,REC=B-N2+K3)HPPP
        DO C=B+1,N3;DO I=M3+1,N2;DO A=N1+1,N3
         I1=INDA3C1B(C,B,A,I)
         IF(I1.EQ.0)CYCLE
         DO E=N2+1,N3;DO F=N2+1,N3
          I3=INDA3C1B(F,E,A,I)
          I2=ABS(INDA3C1B(F,E,A,I))
          IF(I2.EQ.0)CYCLE
          HM(I1,I2)=HM(I1,I2)+HPPP(F,E,C)*I2/I3*0.5_dp
         ENDDO;ENDDO
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
C
222    CONTINUE
       ALLOCATE(HPPP(N2+1:N3,N1+1:N3,N1+1:N3))
       DO X=N2+1,N3
        READ(NFT899,REC=X-N2+K3+K4)HPPP
        DO A=N1+1,N3
         I1=INDA2B0A(X,A)
         IF(I1.EQ.0)CYCLE
         DO E=N1+1,N3;DO F=N2+1,N3
          I3=INDA2B0A(F,E)
          I2=ABS(INDA2B0A(F,E))
          IF(I2.EQ.0)CYCLE
          HM(I1,I2)=HM(I1,I2)+HPPP(F,E,A)*I2/I3
         ENDDO;ENDDO
        ENDDO
        IF(MINIT.EQ.2)CYCLE
C
        DO I=M3+1,N1;DO A=N1+1,N3-1;DO B=A+1,N3
         I1=INDA3B1A(X,B,A,I)
         IF(I1.EQ.0)CYCLE
         DO E=N1+1,N3;DO F=N2+1,N3
          I3=INDA3B1A(F,E,A,I)
          I2=ABS(INDA3B1A(F,E,A,I))
          IF(I2.EQ.0)CYCLE
          HM(I1,I2)=HM(I1,I2)+HPPP(F,E,B)*I2/I3
         ENDDO;ENDDO
         DO E=N1+1,N3;DO F=N2+1,N3
          I3=INDA3B1A(F,E,B,I)
          I2=ABS(INDA3B1A(F,E,B,I))
          IF(I2.EQ.0)CYCLE
          HM(I1,I2)=HM(I1,I2)-HPPP(F,E,A)*I2/I3
         ENDDO;ENDDO
        ENDDO;ENDDO;ENDDO
C
        DO B=N2+1,X-1;DO I=M3+1,N2;DO A=N1+1,N3
         I1=INDA3C1B(X,B,A,I)
         IF(I1.EQ.0)CYCLE
         DO E=N1+1,N3;DO F=N2+1,N3
          I3=INDA3C1B(F,B,E,I)
          I2=ABS(INDA3C1B(F,B,E,I))
          IF(I2.EQ.0)CYCLE
          HM(I1,I2)=HM(I1,I2)+HPPP(F,E,A)*I2/I3
         ENDDO;ENDDO
        ENDDO;ENDDO;ENDDO
        DO C=X+1,N3;DO I=M3+1,N2;DO A=N1+1,N3
         I1=INDA3C1B(C,X,A,I)
         IF(I1.EQ.0)CYCLE
         DO E=N1+1,N3;DO F=N2+1,N3
          I3=INDA3C1B(F,C,E,I)
          I2=ABS(INDA3C1B(F,C,E,I))
          IF(I2.EQ.0)CYCLE
          HM(I1,I2)=HM(I1,I2)-HPPP(F,E,A)*I2/I3
         ENDDO;ENDDO
        ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(HPPP)
C
       ALLOCATE(WR(LLLA),WI(LLLA),WORK(4*LLLA))
       ALLOCATE(VR(LLLA,LLLA),VL(LLLA,LLLA))
       LWORK=4*LLLA
       JOBVL='N'
       JOBVR='V'
       CALL DGEEV(JOBVL,JOBVR,LLLA,HM,LLLA,WR,WI,VL,LLLA,
     &            VR,LLLA,WORK,LWORK,INFO)
       IF(INFO.NE.0) THEN
        WRITE(IO,*)'PROBLEMS WITH SOLVING SMALL EIGENVALUE PROBLEM!!!'
        WRITE(IO,*)'INFO = ',INFO
        CALL ABRT
       END IF
C
       DO I=1,LLLA
        IF(DABS(WI(I)).LE.1.0D-7)CYCLE
        WR(I)=0.0D0
       ENDDO
       CALL DEAEOMDIP_SORT(LLLA,WR,VR)
C
       CALL FLSHBF(IO)
       ALLOCATE(VR0(LLL))
        I0=0;J0=0;II=0
       DO I=1,LLLA
        IF(DABS(WR(I)).LE.1.0D-7)CYCLE
        VR0=0.0D0
        DO J=1,LLL
         JJ=ABS(INDALL(J))
         IF(JJ.EQ.0)CYCLE
         VR0(J)=VR(JJ,I)*INDALL(J)/JJ
        ENDDO
        PP=0.0D0
        DO J=1,LLL
         PP=PP+VR0(J)*VR0(J)
        ENDDO
        IF(DABS(PP).LT.1.0D-8)CYCLE
        CALL DEAEOM_SPIN(N0,N1,N2,N3,ISPIN,
     &  VR0(K2B0A),VR0(K3B1A),VR0(K3C1B),1.0D-7)
        IF(MULT.NE.-1.AND.ISPIN.NE.MULT)CYCLE
        IF(MASWRK.AND.MULT.EQ.-1)WRITE(IO,'(A,I2)')'SPIN MULT: ',ISPIN
        II=II+1
        VR0=VR0/DSQRT(PP)
        IF(I0.EQ.NROOT)J0=J0+1
        IF(J0.GT.8)EXIT
        IF(I0.EQ.NROOT)GOTO 2000
        DO IROOT=1,NROOT
         IF(II.EQ.INDROOT(IROOT))GOTO 1000
        ENDDO
2000    IF(MASWRK)WRITE(IO,'(I5,1X,F15.9)')II,WR(I)
        PP=1.0D-1
        CALL DEAEOM_PRINT_INI(IO,N0,N1,N2,N3,VR0,LLL,PP)
        CYCLE
1000    I0=I0+1
        IF(MASWRK)
     * WRITE(IO,'(1X,A,I3,A,1X,I3,1X,A,F15.9/,1X,A)')'NO. ',I0,
     * ' SELECTED STATE: ',II,'EIGENVALUE: ',WR(I),'VECTORS:'
        PP=1.0D-1
        CALL DEAEOM_PRINT_INI(IO,N0,N1,N2,N3,VR0,LLL,PP)
!       WRITE(IR0,REC=II)VR0
        CALL DEAEOM_WRITE(IR0,II,LLL,VR0)
       ENDDO
       IF(I0.LT.NROOT)THEN
         IF(MASWRK)WRITE(IO,'(I3,A,I2)')
     *   I0,' STATES FOUND FOR MULTIPLICITY: ', MULT
         IF(I0.EQ.0)CALL ABRT
       ENDIF
       CALL FLSHBF(IO)
       DEALLOCATE(VR0,WR,WI)
C
       DEALLOCATE(INDALL)
      END
C
C*MODULE DEAEOMDIP DECK NUMA_DEAEOM
C> @brief calculate number of active unoccupied orbitals
C>
C> @author Jun Shen
C>
C> @param I index of unoccupied orbital
C> @param J index of unoccupied orbital
C> @param K index of unoccupied orbital
C> @param M4 index of the last active unoccupied orbital for initial guess
C
      FUNCTION NUMA_DEAEOM(I,J,K,M4)
        NUMA_DEAEOM=0
        IF(I.LE.M4)NUMA_DEAEOM=NUMA_DEAEOM+1
        IF(J.LE.M4)NUMA_DEAEOM=NUMA_DEAEOM+1
        IF(K.LE.M4)NUMA_DEAEOM=NUMA_DEAEOM+1
      END
C
C*MODULE DEAEOMDIP DECK EOMDIP_INI
C> @brief generate the DIP-EOMCC initial guess
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR0 .R0 file unit number
C> @param NROOT number of excited states to be calculated
C> @param INDROOT excited states to be calculated
C> @param MULT multiplicity of the excited states to be calculated
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M3 index of last unactive occupied orbital for initial guess
C> @param M4 index of the last active unoccupied orbital for initial guess
C> @param KKK number size of the DIP(1p3h) vector
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C
       SUBROUTINE EOMDIP_INI(N0,N1,N2,N3,KKK,M3,M4,IO,IR0,NROOT,
     & K0A2B,K1A3B,K1B3C,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & INDROOT,MULT)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
      LOGICAL GOPARR,DSKWRK,MASWRK
      INTEGER ME,MASTER,NPROC,IBTYP,IPTIM
      COMMON /PAR   / ME,MASTER,NPROC,IBTYP,IPTIM,GOPARR,DSKWRK,MASWRK
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 PP,NS2
       real*8,ALLOCATABLE::HM(:,:),HM1(:,:)
       real*8,ALLOCATABLE::S2(:,:)
       INTEGER,ALLOCATABLE::INDALL(:),ID1(:),ID2(:)
       INTEGER,ALLOCATABLE::IND0A2B(:,:)
       INTEGER,ALLOCATABLE::IND1A3B(:,:,:,:)
       INTEGER,ALLOCATABLE::IND1B3C(:,:,:,:)
       INTEGER,ALLOCATABLE::INDA1A3B(:,:,:,:)
       INTEGER,ALLOCATABLE::INDA1B3C(:,:,:,:)
       INTEGER A,B,C,D,E,F,INDROOT(NROOT)
       real*8,ALLOCATABLE:: WR(:),WI(:),WORK(:)
       real*8,ALLOCATABLE:: VR(:,:),VL(:,:),VR0(:)
       CHARACTER*1 JOBVL,JOBVR
C
       ALLOCATE(INDALL(KKK),SOURCE=0)
       ALLOCATE(IND0A2B(N0+1:N2,N0+1:N1),SOURCE=0)
       ALLOCATE(IND1A3B(N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1),SOURCE=0)
       ALLOCATE(IND1B3C(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N1),SOURCE=0)
       ALLOCATE(INDA1A3B(N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1),SOURCE=0)
       ALLOCATE(INDA1B3C(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N1),SOURCE=0)
C
       LLL=0
       DO I=N0+1,N1;DO J=N0+1,N2
        LLL=LLL+1
        IND0A2B(J,I)=LLL
        INDALL(LLL)=LLL
       ENDDO;ENDDO
       LLLA=LLL
       DO I=N0+1,N1;DO J=N0+1,N1;DO K=N0+1,N2;DO A=N1+1,N3
        LLL=LLL+1
        IND1A3B(A,K,J,I)=LLL
       ENDDO;ENDDO;ENDDO;ENDDO
       DO I=N0+1,N1;DO J=N0+1,N2;DO K=N0+1,N2;DO A=N2+1,N3
        LLL=LLL+1
        IND1B3C(A,K,J,I)=LLL
       ENDDO;ENDDO;ENDDO;ENDDO
       IF(LLL.NE.KKK)THEN
        IF(MASWRK)WRITE(IO,*)'LLL != KKK'
        CALL ABRT
       ENDIF
C
       IA=3
       DO I=N0+1,N1-1;DO J=I+1,N1;DO K=N0+1,N2;DO A=N1+1,M4
        IF(NUMA_EOMDIP(I,J,K,M3).LT.IA)CYCLE
        LLLA=LLLA+1
        INDA1A3B(A,K,J,I)=LLLA
        INDALL(IND1A3B(A,K,J,I))=LLLA
        INDA1A3B(A,K,I,J)=-LLLA
        INDALL(IND1A3B(A,K,I,J))=-LLLA
       ENDDO;ENDDO;ENDDO;ENDDO
       DO I=N0+1,N1;DO J=N0+1,N2-1;DO K=J+1,N2;DO A=N2+1,M4
        IF(NUMA_EOMDIP(I,J,K,M3).LT.IA)CYCLE
        LLLA=LLLA+1
        INDA1B3C(A,K,J,I)=LLLA
        INDALL(IND1B3C(A,K,J,I))=LLLA
        INDA1B3C(A,J,K,I)=-LLLA
        INDALL(IND1B3C(A,J,K,I))=-LLLA
       ENDDO;ENDDO;ENDDO;ENDDO
C
       ALLOCATE(HM(LLLA,LLLA),SOURCE=0.0D0)
! R0A2B
       DO I=N0+1,N1;DO J=N0+1,N2
        I1=IND0A2B(J,I)
        IF(I1.EQ.0)CYCLE
        DO M=N0+1,N1
         I3=IND0A2B(J,M)
         I2=ABS(IND0A2B(J,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHH(I,M)*I2/I3
        ENDDO
        DO M=N0+1,N2
         I3=IND0A2B(M,I)
         I2=ABS(IND0A2B(M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHH(J,M)*I2/I3
        ENDDO
        DO M=N0+1,N1;DO N=N0+1,N2
         I3=IND0A2B(N,M)
         I2=ABS(IND0A2B(N,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHHHH(J,I,N,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,M4;DO M=N0+1,N1
         I3=INDA1A3B(E,J,M,I)
         I2=ABS(INDA1A3B(E,J,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHP(E,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,M4;DO M=N0+1,N1;DO N=N0+1,N1
         I3=INDA1A3B(E,J,N,M)
         I2=ABS(INDA1A3B(E,J,N,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAHHHP(E,I,N,M)*I2/I3*0.5_dp
        ENDDO;ENDDO;ENDDO
        DO E=N1+1,M4;DO M=N0+1,N1;DO N=N0+1,N2
         I3=INDA1A3B(E,N,M,I)
         I2=ABS(INDA1A3B(E,N,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHHPH(J,E,N,M)*I2/I3
        ENDDO;ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N2
         I3=INDA1B3C(E,M,J,I)
         I2=ABS(INDA1B3C(E,M,J,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHP(E,M)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N1;DO N=N0+1,N2
         I3=INDA1B3C(E,N,J,M)
         I2=ABS(INDA1B3C(E,N,J,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHHHP(E,I,N,M)*I2/I3
        ENDDO;ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N2;DO N=N0+1,N2
         I3=INDA1B3C(E,N,M,I)
         I2=ABS(INDA1B3C(E,N,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HCHHHP(E,J,N,M)*I2/I3*0.5_dp
        ENDDO;ENDDO;ENDDO
       ENDDO;ENDDO
C
! R1A3B
       DO I=N0+1,N1-1;DO J=I+1,N1;DO K=N0+1,N2;DO A=N1+1,M4
        I1=INDA1A3B(A,K,J,I)
        IF(I1.EQ.0)CYCLE
        DO M=N0+1,N1
         I3=IND0A2B(K,M)
         I2=ABS(IND0A2B(K,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAHPHH(J,I,A,M)*I2/I3
        ENDDO
        DO M=N0+1,N2
         I3=IND0A2B(M,J)
         I2=ABS(IND0A2B(M,J))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPHHH(K,I,M,A)*I2/I3
        ENDDO
        DO M=N0+1,N2
         I3=IND0A2B(M,I)
         I2=ABS(IND0A2B(M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPHHH(K,J,M,A)*I2/I3
        ENDDO
        DO M=N0+1,N1
         I3=INDA1A3B(A,K,M,J)
         I2=ABS(INDA1A3B(A,K,M,J))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAHH(I,M)*I2/I3
        ENDDO
        DO M=N0+1,N1
         I3=INDA1A3B(A,K,M,I)
         I2=ABS(INDA1A3B(A,K,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHH(J,M)*I2/I3
        ENDDO
        DO E=N1+1,M4
         I3=INDA1A3B(E,K,J,I)
         I2=ABS(INDA1A3B(E,K,J,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAPP(E,A)*I2/I3
        ENDDO
        DO M=N0+1,N2
         I3=INDA1A3B(A,M,J,I)
         I2=ABS(INDA1A3B(A,M,J,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHH(K,M)*I2/I3
        ENDDO
        DO M=N0+1,N1;DO N=N0+1,N1
         I3=INDA1A3B(A,K,N,M)
         I2=ABS(INDA1A3B(A,K,N,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAHHHH(J,I,N,M)*I2/I3*0.5_dp
        ENDDO;ENDDO
        DO E=N1+1,M4;DO M=N0+1,N1
         I3=INDA1A3B(E,K,M,J)
         I2=ABS(INDA1A3B(E,K,M,J))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HAHPHP(E,I,A,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,M4;DO M=N0+1,N1
         I3=INDA1A3B(E,K,M,I)
         I2=ABS(INDA1A3B(E,K,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHPHP(E,J,A,M)*I2/I3
        ENDDO;ENDDO
        DO M=N0+1,N1;DO N=N0+1,N2
         I3=INDA1A3B(A,N,M,J)
         I2=ABS(INDA1A3B(A,N,M,J))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHHHH(K,I,N,M)*I2/I3
        ENDDO;ENDDO
        DO M=N0+1,N1;DO N=N0+1,N2
         I3=INDA1A3B(A,N,M,I)
         I2=ABS(INDA1A3B(A,N,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHHHH(K,J,N,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,M4;DO M=N0+1,N2
         I3=INDA1A3B(E,M,J,I)
         I2=ABS(INDA1A3B(E,M,J,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPHPH(K,E,M,A)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N2
         I3=INDA1B3C(E,M,K,J)
         I2=ABS(INDA1B3C(E,M,K,J))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPHHP(E,I,M,A)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N2
         I3=INDA1B3C(E,M,K,I)
         I2=ABS(INDA1B3C(E,M,K,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBPHHP(E,J,M,A)*I2/I3
        ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO;ENDDO
C
! R1B3C
       DO I=N0+1,N1;DO J=N0+1,N2-1;DO K=J+1,N2;DO A=N2+1,M4
        I1=INDA1B3C(A,K,J,I)
        IF(I1.EQ.0)CYCLE
        DO M=N0+1,N1
         I3=IND0A2B(K,M)
         I2=ABS(IND0A2B(K,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHPHH(J,I,A,M)*I2/I3
        ENDDO
        DO M=N0+1,N1
         I3=IND0A2B(J,M)
         I2=ABS(IND0A2B(J,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHPHH(K,I,A,M)*I2/I3
        ENDDO
        DO M=N0+1,N2
         I3=IND0A2B(M,I)
         I2=ABS(IND0A2B(M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HCHPHH(K,J,A,M)*I2/I3
        ENDDO
        DO E=N1+1,M4;DO M=N0+1,N1
         I3=INDA1A3B(E,K,M,I)
         I2=ABS(INDA1A3B(E,K,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHPPH(J,E,A,M)*I2/I3
        ENDDO;ENDDO
        DO E=N1+1,M4;DO M=N0+1,N1
         I3=INDA1A3B(E,J,M,I)
         I2=ABS(INDA1A3B(E,J,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHPPH(K,E,A,M)*I2/I3
        ENDDO;ENDDO
        DO M=N0+1,N1
         I3=INDA1B3C(A,K,J,M)
         I2=ABS(INDA1B3C(A,K,J,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HAHH(I,M)*I2/I3
        ENDDO
        DO M=N0+1,N2
         I3=INDA1B3C(A,M,K,I)
         I2=ABS(INDA1B3C(A,M,K,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHH(J,M)*I2/I3
        ENDDO
        DO M=N0+1,N2
         I3=INDA1B3C(A,M,J,I)
         I2=ABS(INDA1B3C(A,M,J,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHH(K,M)*I2/I3
        ENDDO
        DO E=N2+1,M4
         I3=INDA1B3C(E,K,J,I)
         I2=ABS(INDA1B3C(E,K,J,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBPP(E,A)*I2/I3
        ENDDO
        DO M=N0+1,N1;DO N=N0+1,N2
         I3=INDA1B3C(A,N,K,M)
         I2=ABS(INDA1B3C(A,N,K,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHHHH(J,I,N,M)*I2/I3
        ENDDO;ENDDO
        DO M=N0+1,N1;DO N=N0+1,N2
         I3=INDA1B3C(A,N,J,M)
         I2=ABS(INDA1B3C(A,N,J,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HBHHHH(K,I,N,M)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N1
         I3=INDA1B3C(E,K,J,M)
         I2=ABS(INDA1B3C(E,K,J,M))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HBHPHP(E,I,A,M)*I2/I3
        ENDDO;ENDDO
        DO M=N0+1,N2;DO N=N0+1,N2
         I3=INDA1B3C(A,N,M,I)
         I2=ABS(INDA1B3C(A,N,M,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HCHHHH(K,J,N,M)*I2/I3*0.5_dp
        ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N2
         I3=INDA1B3C(E,M,K,I)
         I2=ABS(INDA1B3C(E,M,K,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)+HCHPHP(E,J,A,M)*I2/I3
        ENDDO;ENDDO
        DO E=N2+1,M4;DO M=N0+1,N2
         I3=INDA1B3C(E,M,J,I)
         I2=ABS(INDA1B3C(E,M,J,I))
         IF(I2.EQ.0)CYCLE
         HM(I1,I2)=HM(I1,I2)-HCHPHP(E,K,A,M)*I2/I3
        ENDDO;ENDDO
       ENDDO;ENDDO;ENDDO;ENDDO
      DEALLOCATE(IND0A2B,IND1A3B,IND1B3C)
      DEALLOCATE(INDA1A3B,INDA1B3C)
C
       ALLOCATE(WR(LLLA),WI(LLLA),WORK(4*LLLA))
       ALLOCATE(VR(LLLA,LLLA),VL(LLLA,LLLA))
       LWORK=4*LLLA
       JOBVL='N'
       JOBVR='V'
       CALL DGEEV(JOBVL,JOBVR,LLLA,HM,LLLA,WR,WI,VL,LLLA,
     &            VR,LLLA,WORK,LWORK,INFO)
       IF(INFO.NE.0) THEN
        WRITE(IO,*)'PROBLEMS WITH SOLVING SMALL EIGENVALUE PROBLEM!!!'
        WRITE(IO,*)'INFO = ',INFO
        CALL ABRT
       END IF
       DO I=1,LLLA
        IF(DABS(WI(I)).LE.1.0D-7)CYCLE
        WR(I)=0.0D0
       ENDDO
       CALL DEAEOMDIP_SORT(LLLA,WR,VR)
C
       ALLOCATE(VR0(LLL))
        I0=0;J0=0;II=0
       DO I=1,LLLA
        IF(DABS(WR(I)).LE.1.0D-7)CYCLE
        VR0=0.0D0
        DO J=1,LLL
         JJ=ABS(INDALL(J))
         IF(JJ.EQ.0)CYCLE
         VR0(J)=VR(JJ,I)*INDALL(J)/JJ
        ENDDO
        PP=0.0D0
        DO J=1,LLL
         PP=PP+VR0(J)*VR0(J)
        ENDDO
        IF(DABS(PP).LT.1.0D-7)CYCLE
        CALL EOMDIP_SPIN(N0,N1,N2,N3,ISPIN,
     &  VR0(K0A2B),VR0(K1A3B),VR0(K1B3C),1.0D-7)
        IF(MULT.NE.-1.AND.ISPIN.NE.MULT)CYCLE
        IF(MASWRK.AND.MULT.EQ.-1)WRITE(IO,'(A,I2)')'SPIN MULT: ',ISPIN
        II=II+1
        VR0=VR0/DSQRT(PP)
        IF(I0.EQ.NROOT)J0=J0+1
        IF(J0.GT.8)EXIT
        IF(I0.EQ.NROOT)GOTO 2000
        DO IROOT=1,NROOT
         IF(II.EQ.INDROOT(IROOT))GOTO 1000
        ENDDO
2000    IF(MASWRK)WRITE(IO,'(I5,1X,F15.9)')II,WR(I)
        PP=1.0D-1
        CALL EOMDIP_PRINT_INI(IO,N0,N1,N2,N3,VR0,LLL,PP)
        CYCLE
1000    I0=I0+1
        IF(MASWRK)
     * WRITE(IO,'(1X,A,I3,A,1X,I3,1X,A,F15.9/,1X,A)')'NO. ',I0,
     * ' SELECTED STATE: ',II,'EIGENVALUE: ',WR(I),'VECTORS:'
        PP=1.0D-1
        CALL EOMDIP_PRINT_INI(IO,N0,N1,N2,N3,VR0,LLL,PP)
       CALL DEAEOM_WRITE(IR0,II,LLL,VR0)
       ENDDO
       IF(I0.LT.NROOT)THEN
         IF(MASWRK)WRITE(IO,'(I3,A,I2)')
     *   I0,' STATES FOUND FOR MULTIPLICITY: ', MULT
         IF(I0.EQ.0)CALL ABRT
       ENDIF
       CALL FLSHBF(IO)
       DEALLOCATE(VR0)
C
       DEALLOCATE(INDALL)
      END
C
C*MODULE DEAEOMDIP DECK DRDEAEOM
C> @brief calculate number of active occupied orbitals
C>
C> @author Jun Shen
C>
C> @param I index of occupied orbital
C> @param J index of occupied orbital
C> @param K index of occupied orbital
C> @param M3 index of last unactive occupied orbital for initial guess
C
      FUNCTION NUMA_EOMDIP(I,J,K,M3)
        NUMA_EOMDIP=0
        IF(I.GT.M3)NUMA_EOMDIP=NUMA_EOMDIP+1
        IF(J.GT.M3)NUMA_EOMDIP=NUMA_EOMDIP+1
        IF(K.GT.M3)NUMA_EOMDIP=NUMA_EOMDIP+1
      END
C
