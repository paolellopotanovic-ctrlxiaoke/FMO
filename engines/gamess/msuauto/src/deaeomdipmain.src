C*MODULE DEAEOMDIP DECK DRDEAEOMDIP
C> @brief Drives the DEA/DIP-EOMCC calculation
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param NOA number of occupied alpha orbitals (excluding frozen core)
C> @param NOB number of occupied beta orbitals (excluding frozen core)
C> @param NUA number of virtual orbitals
C> @param EREF ROHF reference energy
C> @param ENRG CCSD correlation energy
C>
      SUBROUTINE DRDEAEOMDIP(BESTEOM,IO,NOA,NOB,NUA,EREF,ENRG,CCTYP)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
      use mx_limits, only: mxatm,mxao
      use modcc, only: AMPTSH,METHCC,NCCTOT,NCCOCC,NCCFZC,NCCFZV,
     *                 MXCCIT,MXRLEIT,MWRDCC,ICCCNV,ICCRST,IDSKCC
C
      IMPLICIT NONE
      INTEGER NFT820,NFT821,NFT822,NFT823,NFT825,NFT826,NFT827,
     *                NFT828,NFT829,NFT830,NFT831,NFT832,NFT833,NFT834,
     *                NFT835,NFT836,NFT837,NFT838,NFT839,NFT843,NFT848,
     *                NFT858,NFT859,NFT891,NFT892,NFT899
      INTEGER IO,NOA,NOB,NUA
      INTEGER NSTEOM,NOACT,NUACT,
     *                MOACTCC,MTHTRIP,MTHCI,MTHEOM,MTHINIT,
     *                MAXCI,MAXEOM,MICCI,MICEOM,IROOTCC,
     *                IPROPCC,IPROPCCE
      INTEGER MACT,MULTEOM,MREST,ISELCT
      INTEGER MULEAIP,JREST,NACTA,NACTB
      real*8 CCTYP,CVGCI,CVGEOM,GRPEOM,BESTEOM
      real*8 EREF,ENRG
      real*8 DEAEOM2,DEAEOM2A,DEAEOM3,DEAEOM3A,DEAEOM3B
      real*8 EOMDIP2,EOMDIP3,EOMDIP3A
      COMMON /CCOPIO/ NFT820,NFT821,NFT822,NFT823,NFT825,NFT826,NFT827,
     *                NFT828,NFT829,NFT830,NFT831,NFT832,NFT833,NFT834,
     *                NFT835,NFT836,NFT837,NFT838,NFT839,NFT843,NFT848,
     *                NFT858,NFT859,NFT891,NFT892,NFT899
      COMMON /EOMPAR/ CVGCI,CVGEOM,GRPEOM,NSTEOM(8),NOACT,NUACT,
     *                MOACTCC(MXAO),MTHTRIP,MTHCI,MTHEOM,MTHINIT,
     *                MAXCI,MAXEOM,MICCI,MICEOM,IROOTCC(2),
     *                IPROPCC,IPROPCCE
      COMMON /OPEOM / MACT,MULTEOM,MREST,ISELCT(100)
      COMMON /EAIP  / MULEAIP,JREST,NACTA,NACTB
      LOGICAL GOPARR,DSKWRK,MASWRK
      INTEGER ME,MASTER,NPROC,IBTYP,IPTIM
      COMMON /PAR   / ME,MASTER,NPROC,IBTYP,IPTIM,GOPARR,DSKWRK,MASWRK
      DATA DEAEOM2,DEAEOM2A,DEAEOM3,DEAEOM3A,DEAEOM3B
     *     /8HDEAEOM2 ,8HDEAEOM2A,8HDEAEOM3 ,8HDEAEOM3A,8HDEAEOM3B/
      DATA EOMDIP2,EOMDIP3,EOMDIP3A
     *     /8HDIPEOM2 ,8HDIPEOM3 ,8HDIPEOM3A/
C
        INTEGER IR,IR0,IHR,IR1,MULT
        INTEGER A,B,C,I,J,K,L,I0
        INTEGER K1A,K1B,K2A,K2B,K2C
        INTEGER N0,N1,N2,N3,K1,K2,K3,K4,K5,K6,K7,K8,K9,K0
        INTEGER M1,M2,M3,M4,KKK,LLL,ITEOM,NROOT,NEED
        real*8 TOL
        PARAMETER(IR=125,IR0=126,IHR=127,IR1=128)
        real*8,ALLOCATABLE:: T(:),OME(:)
        real*8,ALLOCATABLE:: VAHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: VBHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: VCHHPP(:,:,:,:)
        real*8,ALLOCATABLE:: HAHH(:,:)
        real*8,ALLOCATABLE:: HAHP(:,:)
        real*8,ALLOCATABLE:: HAPP(:,:)
        real*8,ALLOCATABLE:: HBHH(:,:)
        real*8,ALLOCATABLE:: HBHP(:,:)
        real*8,ALLOCATABLE:: HBPP(:,:)
        real*8,ALLOCATABLE:: HAHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HAHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HAHPHH(:,:,:,:)
        real*8,ALLOCATABLE:: HAHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HAHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: HAPPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPHH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHHPH(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPPH(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHPH(:,:,:,:)
        real*8,ALLOCATABLE:: HBHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPHPP(:,:,:,:)
        real*8,ALLOCATABLE:: HBPPPH(:,:,:,:)
        real*8,ALLOCATABLE:: HCHHHH(:,:,:,:)
        real*8,ALLOCATABLE:: HCHHHP(:,:,:,:)
        real*8,ALLOCATABLE:: HCHPHH(:,:,:,:)
        real*8,ALLOCATABLE:: HCHPHP(:,:,:,:)
        real*8,ALLOCATABLE:: HCHPPP(:,:,:,:)
        real*8,ALLOCATABLE:: HCPPHP(:,:,:,:)
        INTEGER,ALLOCATABLE::   IFDONE(:),INDROOT(:),ISPIN(:)
C
       N0=NCCFZC
       N1=NOA+N0
       N2=NOB+N0
       N3=N1+NUA
       ! K1 = # OF OCC ALPHA
       K1=N1-N0
       ! K2 = # OF OCC BETA
       K2=N2-N0
       ! K3 = # OF UNOCC ALPHA
       K3=N3-N1
       ! K4 = # OF UNOCC BETA
       K4=N3-N2
       IF(CCTYP.EQ.DEAEOM2A.AND.NACTB.GT.K3)THEN
        IF(MASWRK)WRITE(IO,'(A)')'NUMBER OF ACT VIR ORBS EXCEEDS,
     *  PLEASE USE SMALLER NACT OR CCTYP=DEAEOM2 !!!'
        CALL ABRT
       ENDIF
       IF((CCTYP.EQ.DEAEOM3A.OR.CCTYP.EQ.DEAEOM3B).AND.NACTB.GT.K3)THEN
        IF(MASWRK)WRITE(IO,'(A)')'NUMBER OF ACT VIR ORBS EXCEEDS,
     *  PLEASE USE SMALLER NACT OR CCTYP=DEAEOM3 !!!'
        CALL ABRT
       ENDIF
       IF(CCTYP.EQ.EOMDIP3A.AND.NACTB.GT.K2)THEN
        IF(MASWRK)WRITE(IO,'(A)')'NUMBER OF ACT OCC ORBS EXCEEDS,
     *  PLEASE USE SMALLER NACT OR CCTYP=EOMDIP3 !!!'
        CALL ABRT
       ENDIF
C
        IF(MASWRK)WRITE(IO,1000)
 1000 FORMAT(/8X,25(1H-)/
     *        8X,'DEA/DIP EOMCC PARAMETERS'/,
     *        8X,25(1H-))
        MULT=MULTEOM
        TOL=CVGEOM
        ITEOM=MAXEOM
        NROOT=NSTEOM(1)
        IF(NROOT.LE.0)NROOT=1
        ALLOCATE(INDROOT(NROOT))
        DO I=1,NROOT
         IF(ISELCT(I).EQ.0)GOTO 111
         INDROOT(I)=ISELCT(I)
        ENDDO
        GOTO 222
111     DO I=1,NROOT
         INDROOT(I)=I
        ENDDO
222     IF(MASWRK)THEN
         WRITE(IO,'(5X,A,I5)')'MULTIPLICITY OF EXCITED STATES: ',MULT
         WRITE(IO,'(5X,A,E12.3)')'COVERGENCE: ',TOL
         WRITE(IO,'(5X,A,I5)')'ITERATION SPACE',ITEOM
         WRITE(IO,'(5X,A,I5)')'NUMBER OF EXCITED STATES',NROOT
         WRITE(IO,'(5X,A)')'EXCITED STATES TO BE CALCULATED:'
         WRITE(IO,*)INDROOT
        ENDIF
        M3=NOACT
        IF(M3.GT.K2)M3=K2
        IF(MASWRK.AND.M3.GT.K2)
     *  WRITE(IO,'(A,I5)')'NUMBER OF ACT OCC FOR INI GUESS: ',M3
        M3=N2-M3
        IF(MASWRK.AND.M3.LT.N2)WRITE(IO,'(5X,A,I5,A,I5)')
     & 'ACT OCC FOR INI GUESS FROM',M3+1,' TO',N2
        M4=NUACT
        IF(M4.GT.K3)M4=K3
        IF(MASWRK.AND.M4.GT.0)
     *  WRITE(IO,'(5X,A,I5)')'NUMBER OF ACT VIR FOR INI GUESS',M4
        M4=N1+M4
        IF(MASWRK.AND.M4.GT.N1)WRITE(IO,'(5X,A,I5,A,I5)')
     & 'ACT VIR FOR INI GUESS FROM',N1+1,' TO',M4
        IF(CCTYP.EQ.EOMDIP3A)THEN
        M1=NACTB
        IF(MASWRK.AND.M1.GT.0)
     &  WRITE(IO,'(5X,A,I5)')'NUMBER OF ACT OCC ',M1
        M1=N2-M1
        IF(MASWRK.AND.M1.LT.N2)
     & WRITE(IO,'(5X,A,I5,A,I5)')'ACT OCC',M1+1,' TO',N2
       ! K5 = # OF NON-ACTIVE OCC
       K5=M1-N0
       ! K7 = # OF ACTIVE OCC ALPHA
       K7=N1-M1
       ! K8 = # OF ACTIVE OCC BETA
       K8=N2-M1
       ENDIF
       IF(CCTYP.EQ.DEAEOM2A.OR.CCTYP.EQ.DEAEOM3A
     *                     .OR.CCTYP.EQ.DEAEOM3B)THEN
        M2=NACTB
        IF(MASWRK.AND.M2.GT.0)
     &  WRITE(IO,'(5X,A,I5)')'NUMBER OF ACT VIR ',M2
        M2=N1+M2
        IF(MASWRK.AND.M2.GT.N1)
     *  WRITE(IO,'(5X,A,I5,A,I5)')'ACT VIR',N1+1,' TO',M2
       ! K6 = # OF NON-ACTIVE UNOCC
       K6=N3-M2
       ! K9 = # OF ACTIVE UNOCC ALPHA
       K9=M2-N1
       ! K0 = # OF ACTIVE UNOCC BETA
       K0=M2-N2
       ENDIF
C
        IF(MASWRK)WRITE(IO,2000)
 2000 FORMAT(/8X,23(1H-)/
     *        8X,'DEA/DIP EOMCC PROGRAM'/,
     *        8X,23(1H-))
       CALL FLSHBF(IO)
C
       KKK=0
       K1A =KKK+1;KKK=KKK+K1*K3
       K1B =KKK+1;KKK=KKK+K2*K4
       K2A =KKK+1;KKK=KKK+K1*K1*K3*K3
       K2B =KKK+1;KKK=KKK+K1*K2*K3*K4
       K2C =KKK+1;KKK=KKK+K2*K2*K4*K4
C
      NEED=KKK
      NEED=NEED+K1*K1*K3*K3      !VAHHPP
      NEED=NEED+K1*K2*K3*K4      !VBHHPP
      NEED=NEED+K2*K2*K4*K4      !VCHHPP
      NEED=NEED+K1*K1            !HAHH
      NEED=NEED+K1*K3            !HAHP
      NEED=NEED+K3*K3            !HAPP
      NEED=NEED+K2*K2            !HBHH
      NEED=NEED+K2*K4            !HBHP
      NEED=NEED+K4*K4            !HBPP
      NEED=NEED+K1*K1*K1*K1      !HAHHHH
      NEED=NEED+K1*K1*K1*K3      !HAHHHP
      NEED=NEED+K1*K3*K1*K1      !HAHPHH
      NEED=NEED+K1*K3*K1*K3      !HAHPHP
      NEED=NEED+K1*K3*K3*K3      !HAHPPP
      NEED=NEED+K3*K3*K1*K3      !HAPPHP
      NEED=NEED+K1*K2*K1*K2      !HBHHHH
      NEED=NEED+K1*K2*K1*K4      !HBHHHP
      NEED=NEED+K1*K2*K3*K2      !HBHHPH
      NEED=NEED+K3*K2*K1*K2      !HBPHHH
      NEED=NEED+K1*K4*K1*K4      !HBHPHP
      NEED=NEED+K1*K4*K3*K2      !HBHPPH
      NEED=NEED+K3*K2*K1*K4      !HBPHHP
      NEED=NEED+K3*K2*K3*K2      !HBPHPH
      NEED=NEED+K1*K4*K3*K4      !HBHPPP
      NEED=NEED+K3*K4*K1*K4      !HBPPHP
      NEED=NEED+K3*K2*K3*K4      !HBPHPP
      NEED=NEED+K3*K4*K3*K2      !HBPPPH
      NEED=NEED+K2*K2*K2*K2      !HCHHHH
      NEED=NEED+K2*K2*K2*K4      !HCHHHP
      NEED=NEED+K2*K4*K2*K2      !HCHPHH
      NEED=NEED+K2*K4*K2*K4      !HCHPHP
      NEED=NEED+K2*K4*K4*K4      !HCHPPP
      NEED=NEED+K4*K4*K2*K4      !HCPPHP
      IF(JREST.EQ.0)THEN
       IF(CCTYP.EQ.DEAEOM2.OR.CCTYP.EQ.DEAEOM2A.OR.CCTYP.EQ.DEAEOM3
     *.OR.CCTYP.EQ.DEAEOM3A.OR.CCTYP.EQ.DEAEOM3B)THEN
        LLL=K3*K4
        IF(MACT.EQ.1)LLL=NUACT*K4
        IF(MACT.EQ.2)LLL=NUACT*NUACT
        IF(MTHINIT.NE.2)LLL=LLL+NOACT*NUACT*NUACT*NUACT*2
       ENDIF
       IF(CCTYP.EQ.EOMDIP2.OR.CCTYP.EQ.EOMDIP3.OR.CCTYP.EQ.EOMDIP3A)THEN
        LLL=K1*K2
        LLL=LLL+NUACT*NOACT*NOACT*NOACT*2
       ENDIF
       IF(MASWRK)WRITE(IO,3000)(NEED+4*LLL*LLL)/1000000+1
 3000 FORMAT(1X,'MEMORY NEEDED BY INI DEA/DIP-EOMCC: ',I12,' MWORDS')
      ENDIF
      IF(CCTYP.EQ.DEAEOM2A
     *.OR.CCTYP.EQ.DEAEOM3A.OR.CCTYP.EQ.DEAEOM3B)THEN
       NEED=NEED+K4*K4*K4         !HPPP
       NEED=NEED+K9*K3*K3*K3*8    !H*APPP
      ENDIF
      IF(CCTYP.EQ.DEAEOM2)THEN
       LLL=K3*K4
       LLL=LLL+K1*K3*K3*K4
       LLL=LLL+K2*K3*K4*K4
      ELSEIF(CCTYP.EQ.DEAEOM2A)THEN
       LLL=K3*K4
       LLL=LLL+K1*K9*K3*K4
       LLL=LLL+K1*K6*K6*K0
       LLL=LLL+K2*K3*K0*K4
       LLL=LLL+K2*K9*K6*K6
      ELSEIF(CCTYP.EQ.DEAEOM3A)THEN
       LLL=K3*K4
       LLL=LLL+K1*K9*K3*K4
       LLL=LLL+K1*K6*K6*K0
       LLL=LLL+K2*K3*K0*K4
       LLL=LLL+K2*K9*K6*K6
       LLL=LLL+K4*K3*K9*K9*K1*K1
       LLL=LLL+K0*K6*K6*K9*K1*K1
       LLL=LLL+K4*K0*K3*K9*K2*K1
       LLL=LLL+K6*K6*K9*K9*K2*K1
       LLL=LLL+K0*K0*K6*K6*K2*K1
       LLL=LLL+K4*K0*K0*K3*K2*K2
       LLL=LLL+K6*K6*K0*K9*K2*K2
      ELSEIF(CCTYP.EQ.DEAEOM3B)THEN
       LLL=K3*K4
       LLL=LLL+K1*K3*K3*K4
       LLL=LLL+K2*K3*K4*K4
       LLL=LLL+K4*K3*K9*K9*K1*K1
       LLL=LLL+K0*K6*K6*K9*K1*K1
       LLL=LLL+K4*K0*K3*K9*K2*K1
       LLL=LLL+K6*K6*K9*K9*K2*K1
       LLL=LLL+K0*K0*K6*K6*K2*K1
       LLL=LLL+K4*K0*K0*K3*K2*K2
       LLL=LLL+K6*K6*K0*K9*K2*K2
      ELSEIF(CCTYP.EQ.DEAEOM3 )THEN
       NEED=NEED+K3*K3*K3*K3      !HAPPPP
       NEED=NEED+K3*K4*K3*K4      !HBPPPP
       NEED=NEED+K4*K4*K4*K4      !HCPPPP
       LLL=K3*K4
       LLL=LLL+K1*K3*K3*K4
       LLL=LLL+K2*K3*K4*K4
       LLL=LLL+K1*K1*K3*K3*K3*K4
       LLL=LLL+K1*K2*K3*K3*K4*K4
       LLL=LLL+K2*K2*K3*K4*K4*K4
      ELSEIF(CCTYP.EQ.EOMDIP2)THEN
       LLL=LLL+K2*K1
       LLL=LLL+K3*K2*K1*K1
       LLL=LLL+K4*K2*K2*K1
      ELSEIF(CCTYP.EQ.EOMDIP3A)THEN
       NEED=NEED+K4*K4*K4         !HPPP
       LLL=LLL+K2*K1
       LLL=LLL+K3*K2*K1*K1
       LLL=LLL+K4*K2*K2*K1
       LLL=LLL+K3*K3*K2*K1*K7*K7
       LLL=LLL+K3*K3*K8*K5*K5*K7
       LLL=LLL+K4*K3*K2*K8*K1*K7
       LLL=LLL+K4*K3*K5*K5*K7*K7
       LLL=LLL+K4*K3*K8*K8*K5*K5
       LLL=LLL+K4*K4*K2*K8*K8*K1
       LLL=LLL+K4*K4*K5*K5*K8*K7
      ELSEIF(CCTYP.EQ.EOMDIP3)THEN
       NEED=NEED+K4*K4*K4         !HPPP
       LLL=LLL+K2*K1
       LLL=LLL+K3*K2*K1*K1
       LLL=LLL+K4*K2*K2*K1
       LLL=LLL+K3*K3*K2*K1*K1*K1
       LLL=LLL+K4*K3*K2*K2*K1*K1
       LLL=LLL+K4*K4*K2*K2*K2*K1
      ENDIF
      IF(MASWRK)WRITE(IO,4000)(NEED+3*LLL)/1000000+1
 4000 FORMAT(1X,'MEMORY NEEDED BY DEA/DIP-EOMCC  : ',I12,' MWORDS')
      CALL FLSHBF(IO)
 
C
       ALLOCATE(VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1))
       ALLOCATE(VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1))
       ALLOCATE(VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2))
C
       I0=0
       DO I=N0+1,N1;DO J=N1+1,N3
        I0=I0+1
        READ(NFT829,REC=I0)((VAHHPP(L,J,K,I),L=N1+1,N3),K=N0+1,N1)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N2+1,N3
        I0=I0+1
        READ(NFT830,REC=I0)((VCHHPP(L,J,K,I),L=N2+1,N3),K=N0+1,N2)
       ENDDO;ENDDO
       I0=0
       DO I=N0+1,N2;DO J=N2+1,N3
        I0=I0+1
        READ(NFT833,REC=I0)((VBHHPP(J,L,I,K),L=N1+1,N3),K=N0+1,N1)
       ENDDO;ENDDO
C
       ALLOCATE(HAHH(N0+1:N1,N0+1:N1))
       ALLOCATE(HAHP(N1+1:N3,N0+1:N1))
       ALLOCATE(HAPP(N1+1:N3,N1+1:N3))
       ALLOCATE(HBHH(N0+1:N2,N0+1:N2))
       ALLOCATE(HBHP(N2+1:N3,N0+1:N2))
       ALLOCATE(HBPP(N2+1:N3,N2+1:N3))
       ALLOCATE(HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1))
       ALLOCATE(HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1))
       ALLOCATE(HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1))
       ALLOCATE(HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1))
       ALLOCATE(HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1))
       ALLOCATE(HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3))
       ALLOCATE(HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1))
       ALLOCATE(HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1))
       ALLOCATE(HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1))
       ALLOCATE(HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1))
       ALLOCATE(HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3))
       ALLOCATE(HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1))
       ALLOCATE(HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1))
       ALLOCATE(HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3))
       ALLOCATE(HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3))
       ALLOCATE(HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1))
       ALLOCATE(HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3))
       ALLOCATE(HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3))
       ALLOCATE(HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3))
       ALLOCATE(HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       ALLOCATE(HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       ALLOCATE(HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2))
       ALLOCATE(HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2))
       ALLOCATE(HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2))
       ALLOCATE(HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3))
C
       READ(NFT891,REC=3)HAHH
       READ(NFT891,REC=5)((HAHP(A,I),I=N0+1,N1),A=N1+1,N3)
       READ(NFT891,REC=1)HAPP
       READ(NFT891,REC=4)HBHH
       READ(NFT891,REC=6)((HBHP(A,I),I=N0+1,N2),A=N2+1,N3)
       READ(NFT891,REC=2)HBPP
       READ(NFT891,REC=7) HAHHHH
       READ(NFT891,REC=14)!HAHHHP
     &((((HAHHHP(A,K,J,I),I=N0+1,N1),J=N0+1,N1),K=N0+1,N1),A=N1+1,N3)
       READ(NFT891,REC=10)!HAHPHH
     &((((HAHPHH(K,J,A,I),J=N0+1,N1),K=N0+1,N1),I=N0+1,N1),A=N1+1,N3)
       READ(NFT892,REC=1)!HAHPHP
     &((((HAHPHP(B,J,A,I),A=N1+1,N3),J=N0+1,N1),B=N1+1,N3),I=N0+1,N1)
       READ(NFT892,REC=11)!HAHPPP
     &((((HAHPPP(C,B,A,I),I=N0+1,N1),C=N1+1,N3),B=N1+1,N3),A=N1+1,N3)
       READ(NFT892,REC=7)!HAPPHP
     &((((HAPPHP(C,I,B,A),A=N1+1,N3),B=N1+1,N3),C=N1+1,N3),I=N0+1,N1)
       READ(NFT891,REC=9) HBHHHH
       READ(NFT891,REC=16)!HBHHHP
     &((((HBHHHP(A,K,J,I),I=N0+1,N1),J=N0+1,N2),K=N0+1,N1),A=N2+1,N3)
       READ(NFT891,REC=17)!HBHHPH
     &((((HBHHPH(K,A,J,I),I=N0+1,N1),J=N0+1,N2),A=N1+1,N3),K=N0+1,N2)
       READ(NFT891,REC=12)!HBHPHH
     &((((HBHPHH(K,J,A,I),J=N0+1,N1),K=N0+1,N2),I=N0+1,N1),A=N2+1,N3)
       READ(NFT891,REC=13)!HBPHHH
     &((((HBPHHH(K,J,I,A),J=N0+1,N1),K=N0+1,N2),A=N1+1,N3),I=N0+1,N2)
       READ(NFT892,REC=3)!HBHPHP
     &((((HBHPHP(B,J,A,I),A=N2+1,N3),J=N0+1,N1),B=N2+1,N3),I=N0+1,N1)
       READ(NFT892,REC=6)!HBHPPH
     &((((HBHPPH(J,B,A,I),A=N2+1,N3),J=N0+1,N2),B=N1+1,N3),I=N0+1,N1)
       READ(NFT892,REC=5)!HBPHHP
     &((((HBPHHP(B,J,I,A),B=N2+1,N3),I=N0+1,N2),J=N0+1,N1),A=N1+1,N3)
       READ(NFT892,REC=4)!HBPHPH
     &((((HBPHPH(J,B,I,A),A=N1+1,N3),J=N0+1,N2),B=N1+1,N3),I=N0+1,N2)
       READ(NFT892,REC=14)!HBHPPP
     &((((HBHPPP(C,B,A,I),I=N0+1,N1),C=N2+1,N3),B=N1+1,N3),A=N2+1,N3)
       READ(NFT892,REC=13)!HBPHPP
     &((((HBPHPP(C,B,I,A),A=N1+1,N3),C=N2+1,N3),B=N1+1,N3),I=N0+1,N2)
       READ(NFT892,REC=10)!HBPPHP
     &((((HBPPHP(C,I,B,A),A=N1+1,N3),B=N2+1,N3),I=N0+1,N1),C=N2+1,N3)
       READ(NFT892,REC=9)!HBPPPH
     &((((HBPPPH(I,C,B,A),A=N1+1,N3),B=N2+1,N3),C=N1+1,N3),I=N0+1,N2)
       READ(NFT891,REC=8) HCHHHH
       READ(NFT891,REC=15)!HCHHHP
     &((((HCHHHP(A,K,J,I),I=N0+1,N2),J=N0+1,N2),K=N0+1,N2),A=N2+1,N3)
       READ(NFT891,REC=11)!HCHPHH
     &((((HCHPHH(K,J,A,I),J=N0+1,N2),K=N0+1,N2),I=N0+1,N2),A=N2+1,N3)
       READ(NFT892,REC=2)!HCHPHP
     &((((HCHPHP(B,J,A,I),A=N2+1,N3),J=N0+1,N2),B=N2+1,N3),I=N0+1,N2)
       READ(NFT892,REC=12)!HCHPPP
     &((((HCHPPP(C,B,A,I),I=N0+1,N2),C=N2+1,N3),B=N2+1,N3),A=N2+1,N3)
       READ(NFT892,REC=8)!HCPPHP
     &((((HCPPHP(C,I,B,A),A=N2+1,N3),B=N2+1,N3),C=N2+1,N3),I=N0+1,N2)
C
      ALLOCATE(T(KKK),SOURCE=0.0D0)
       CALL GAMESS_READ
     & (0,NFT825,N0,N1,N2,N3,T(K1A),T(K1B),T(K2A),T(K2B),T(K2C))
C
       ALLOCATE(OME(NROOT),SOURCE=0.0D0)
       ALLOCATE(IFDONE(NROOT),SOURCE=0)
       ALLOCATE(ISPIN(NROOT),SOURCE=0)
      IF(CCTYP.EQ.DEAEOM2.OR.CCTYP.EQ.DEAEOM2A.OR.CCTYP.EQ.DEAEOM3
     *.OR.CCTYP.EQ.DEAEOM3A.OR.CCTYP.EQ.DEAEOM3B)THEN
       CALL DRDEAEOM(N0,N1,N2,N3,IO,IR,IHR,IR0,IR1,M3,M4,NROOT,TOL,
     & K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,M2,OME,CCTYP,
     & IFDONE,T,ITEOM,INDROOT,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899,MULT,MTHINIT,MACT,ISPIN)
      IF(MASWRK)WRITE(IO,316)
      DO I=1,NROOT
      BESTEOM=EREF+ENRG+OME(I)
      IF(IFDONE(I).EQ.0)THEN
       IF(MASWRK)WRITE(IO,317)INDROOT(I),ISPIN(I),OME(I),BESTEOM
       CYCLE
      ENDIF
      IF(MASWRK)WRITE(IO,318)INDROOT(I),ISPIN(I),OME(I),BESTEOM
      ENDDO
      ENDIF
C
      IF(CCTYP.EQ.EOMDIP2.OR.CCTYP.EQ.EOMDIP3.OR.CCTYP.EQ.EOMDIP3A)THEN
       CALL DREOMDIP(N0,N1,N2,N3,IO,IR,IHR,IR0,IR1,M3,M4,NROOT,TOL,
     & K1,K2,K3,K4,K5,K7,K8,K1A,K1B,K2A,K2B,K2C,KKK,M1,OME,CCTYP,
     & IFDONE,T,ITEOM,INDROOT,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899,MULT,ISPIN)
      IF(MASWRK)WRITE(IO,319)
      DO I=1,NROOT
      BESTEOM=EREF+ENRG+OME(I)
      IF(IFDONE(I).EQ.0)THEN
       IF(MASWRK)WRITE(IO,317)INDROOT(I),ISPIN(I),OME(I),BESTEOM
       CYCLE
      ENDIF
      IF(MASWRK)WRITE(IO,318)INDROOT(I),ISPIN(I),OME(I),BESTEOM
      ENDDO
      ENDIF
C
!     CLOSE(IR0,STATUS='DELETE')
!     CLOSE(IR1,STATUS='DELETE')
      CLOSE(IR,STATUS='DELETE')
      CLOSE(IHR,STATUS='DELETE')
      DEALLOCATE(T)
      DEALLOCATE(VAHHPP,VBHHPP,VCHHPP)
      DEALLOCATE(HAHH,HAHP,HAPP,HBHH,HBHP,HBPP)
      DEALLOCATE(HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP)
      DEALLOCATE(HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH)
      DEALLOCATE(HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH)
      DEALLOCATE(HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP)
C
 316  FORMAT(/9X,'---- SUMMARY OF DEA-EOMCC CALCULATIONS ----',/
     *        23X,'DOUBLY ELECTRON',/
     *        13X,'SPIN',9X,'ATTACHMENT',13X,'TOTAL',/
     *        2X,'STATE',6X,'MULT',9X,'ENERGY (H)',11X,'ENERGY (H)',7X,
     *        'ITERATIONS')
 317  FORMAT(2X,I2,9X,I2,7X,F15.10,2X,F20.10,5X,'UNCONVERGED')
 318  FORMAT(2X,I2,9X,I2,7X,F15.10,2X,F20.10,5X,'CONVERGED')
 319  FORMAT(/9X,'---- SUMMARY OF DIP-EOMCC CALCULATIONS ----',/
     *        27X,'DOUBLED',/
     *        13X,'SPIN',9X,'IONIZATION',13X,'TOTAL',/
     *        2X,'STATE',6X,'MULT',9X,'ENERGY (H)',11X,'ENERGY (H)',7X,
     *        'ITERATIONS')
C
      END
C
C*MODULE DEAEOMDIP DECK DRDEAEOM
C> @brief Drives the DEA/DIP-EOMCC calculation
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param NROOT number of excited states to be calculated
C> @param TOL convergence tolerance
C> @param OME DEA-EOMCC excitation energy
C> @param IFDONE index to tell if the calculation for the root is done
C> @param ITEOM diagonal space of HBar
C> @param INDROOT excited states to be calculated
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param MULT multiplicity of the excited states to be calculated
C> @param MINIT option for initial guess
C> @param MACT option for initial guess
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M3 index of last unactive occupied orbital for initial guess
C> @param M4 index of the last active unoccupied orbital for initial guess
C> @param M2 index of the last active unoccupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K6 number of non-active unoccupied orbitals
C> @param K9 number of active unoccupied alpha orbitals
C> @param K0 number of active unoccupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param KKK number size of the CCSD cluster vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C>
       SUBROUTINE DRDEAEOM(N0,N1,N2,N3,IO,IR,IHR,IR0,IR1,M3,M4,NROOT,
     & TOL,K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,M2,OME,CCTYP,
     & IFDONE,T,ITEOM,INDROOT,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899,MULT,MINIT,MACT,ISPIN)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
      IMPLICIT NONE
      INTEGER N0,N1,N2,N3,IO,IR,IHR,IR0,IR1,M3,M4,NROOT,
     & K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,M2,
     & ITEOM,NFT899,MULT,MINIT,MACT
      INTEGER A,B,C,D,I,IROOT,IROOT0,ITER
      INTEGER LLL2,LLL2A,LLL3,LLL3A,LLL3B
      INTEGER K2B0A,K3B1A,K3B1A1,K3C1B,K3C1B1,K3C1B0,
     & K4B2A,K4B2A1,K4C2B,K4C2B1,K4C2B2,K4D2C,K4D2C1
      INTEGER MULEAIP,JREST,NACTA,NACTB
      INTEGER IFDONE(NROOT),INDROOT(NROOT),ISPIN(NROOT)
      real*8 TOL,CCTYP,RES
      real*8 DEAEOM2,DEAEOM2A,DEAEOM3,DEAEOM3A,DEAEOM3B
      real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
      real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
      real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
      real*8 HAHH(N0+1:N1,N0+1:N1)
      real*8 HAHP(N1+1:N3,N0+1:N1)
      real*8 HAPP(N1+1:N3,N1+1:N3)
      real*8 HBHH(N0+1:N2,N0+1:N2)
      real*8 HBHP(N2+1:N3,N0+1:N2)
      real*8 HBPP(N2+1:N3,N2+1:N3)
      real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
      real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
      real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
      real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
      real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
      real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
      real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
      real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
      real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
      real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
      real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
      real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
      real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
      real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
      real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
      real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
      real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
      real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
      real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
      real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
      real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
      real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
      real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
      real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
      real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
      real*8 T(KKK),PP
      real*8 OME(NROOT)
      real*8,ALLOCATABLE:: HAAPPP(:,:,:,:)
      real*8,ALLOCATABLE:: HAPPAP(:,:,:,:)
      real*8,ALLOCATABLE:: HBAPPP(:,:,:,:)
      real*8,ALLOCATABLE:: HBPAPP(:,:,:,:)
      real*8,ALLOCATABLE:: HBPPAP(:,:,:,:)
      real*8,ALLOCATABLE:: HBPPPA(:,:,:,:)
      real*8,ALLOCATABLE:: HCAPPP(:,:,:,:)
      real*8,ALLOCATABLE:: HCPPAP(:,:,:,:)
      real*8,ALLOCATABLE:: VPPP(:,:,:)
      real*8,ALLOCATABLE:: HAPPPP(:,:,:,:)
      real*8,ALLOCATABLE:: HBPPPP(:,:,:,:)
      real*8,ALLOCATABLE:: HCPPPP(:,:,:,:)
      real*8,ALLOCATABLE:: R(:),MTS(:,:),WI(:),R0(:)
      COMMON /EAIP  / MULEAIP,JREST,NACTA,NACTB
      DATA DEAEOM2,DEAEOM2A,DEAEOM3,DEAEOM3A,DEAEOM3B
     *     /8HDEAEOM2 ,8HDEAEOM2A,8HDEAEOM3 ,8HDEAEOM3A,8HDEAEOM3B/
      LOGICAL FILE_EXISTS
        CHARACTER*800 FNAME
      LOGICAL GOPARR,DSKWRK,MASWRK
      INTEGER ME,MASTER,NPROC,IBTYP,IPTIM
      COMMON /PAR   / ME,MASTER,NPROC,IBTYP,IPTIM,GOPARR,DSKWRK,MASWRK
C
        CALL GMS_GETENV("CCSD3AA", FNAME)
C
       IF(CCTYP.EQ.DEAEOM2.OR.CCTYP.EQ.DEAEOM3)GOTO 1000
       ALLOCATE(HAAPPP(N1+1:N3,N1+1:N3,N1+1:N3,N1+1:M2))
       ALLOCATE(HAPPAP(N1+1:N3,N1+1:M2,N1+1:N3,N1+1:N3))
       ALLOCATE(HBAPPP(N2+1:N3,N1+1:N3,N2+1:N3,N1+1:M2))
       ALLOCATE(HBPAPP(N2+1:N3,N1+1:N3,N2+1:M2,N1+1:N3))
       ALLOCATE(HBPPAP(N2+1:N3,N1+1:M2,N2+1:N3,N1+1:N3))
       ALLOCATE(HBPPPA(N2+1:M2,N1+1:N3,N2+1:N3,N1+1:N3))
       ALLOCATE(HCAPPP(N2+1:N3,N2+1:N3,N2+1:N3,N2+1:M2))
       ALLOCATE(HCPPAP(N2+1:N3,N2+1:M2,N2+1:N3,N2+1:N3))
       ALLOCATE(VPPP(N1+1:N3,N1+1:N3,N1+1:N3))
       DO A=N1+1,N3
         READ(NFT899,REC=A-N1)VPPP
         DO B=N1+1,N3;DO C=N1+1,M2;DO D=N1+1,N3
          HAPPAP(D,C,B,A)=VPPP(D,C,B)
         ENDDO;ENDDO;ENDDO
         IF(A.GT.M2)CYCLE
         DO B=N1+1,N3;DO C=N1+1,N3;DO D=N1+1,N3
          HAAPPP(D,C,B,A)=VPPP(D,C,B)
         ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(VPPP)
       ALLOCATE(VPPP(N2+1:N3,N2+1:N3,N2+1:N3))
       DO A=N2+1,N3
         READ(NFT899,REC=A-N2+K3)VPPP
         DO B=N2+1,N3;DO C=N2+1,M2;DO D=N2+1,N3
          HCPPAP(D,C,B,A)=VPPP(D,C,B)
         ENDDO;ENDDO;ENDDO
         IF(A.GT.M2)CYCLE
         DO B=N2+1,N3;DO C=N2+1,N3;DO D=N2+1,N3
          HCAPPP(D,C,B,A)=VPPP(D,C,B)
         ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(VPPP)
       ALLOCATE(VPPP(N1+1:N3,N2+1:N3,N1+1:N3))
       DO B=N2+1,N3
         READ(NFT899,REC=B-N2+K3+K4)VPPP
         DO A=N1+1,M2;DO C=N1+1,N3;DO D=N2+1,N3
          HBAPPP(D,C,B,A)=VPPP(D,C,A)
         ENDDO;ENDDO;ENDDO
         DO A=N1+1,N3;DO C=N1+1,M2;DO D=N2+1,N3
          HBPPAP(D,C,B,A)=VPPP(D,C,A)
         ENDDO;ENDDO;ENDDO
         DO A=N1+1,N3;DO C=N1+1,N3;DO D=N2+1,M2
          HBPPPA(D,C,B,A)=VPPP(D,C,A)
         ENDDO;ENDDO;ENDDO
         IF(B.GT.M2)CYCLE
         DO A=N1+1,N3;DO C=N1+1,N3;DO D=N2+1,N3
          HBPAPP(D,C,B,A)=VPPP(D,C,A)
         ENDDO;ENDDO;ENDDO
       ENDDO
       DEALLOCATE(VPPP)
C
1000   LLL2=0
       K2B0A=LLL2+1;LLL2=LLL2+K3*K4
       K3B1A=LLL2+1;LLL2=LLL2+K1*K3*K3*K4
       K3C1B=LLL2+1;LLL2=LLL2+K2*K3*K4*K4
       K3C1B0=K3C1B
C
       IF(JREST.EQ.1) THEN
         INQUIRE(FILE=TRIM(FNAME)//'.R1',EXIST=FILE_EXISTS)
         IF(.NOT. FILE_EXISTS) THEN
           IF(MASWRK)
     &     WRITE(IO,'(A)')'ERROR. RESTART FILE .R1 NOT FOUND.'
           CALL ABRT
         ENDIF
         IF(MASWRK)
     &   WRITE(IO,'(A)') 'RESTART FROM SAVED VECTORS FILE .R1'
         GOTO 2000
       ENDIF
C
!      OPEN(IR0,FILE=TRIM(FNAME)//'.R0',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR0,LLL2,FNAME,'.R0')
       IF(JREST.EQ.2) THEN
         INQUIRE(FILE=TRIM(FNAME)//'.R0',EXIST=FILE_EXISTS)
         IF(.NOT. FILE_EXISTS) THEN
           IF(MASWRK)
     &     WRITE(IO,'(A)') 'ERROR. INI GUESS FILE .R0 NOT FOUND.'
           CALL ABRT
         ENDIF
         IF(MASWRK)
     &   WRITE(IO,'(A)') 'START FROM EXSIT INI VECTORS FILE .R0'
         GOTO 2000
       ENDIF
       IF(MASWRK)WRITE(IO,'(A)')' DEA INITIAL START CALCULATION'
       CALL FLSHBF(IO)
       CALL DEAEOM_INI(N0,N1,N2,N3,K3,K4,LLL2,M3,M4,IO,IR0,NROOT,
     & K2B0A,K3B1A,K3C1B,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899,INDROOT,MULT,MINIT,MACT)
       IF(MASWRK)
     & WRITE(IO,'(A)')' DONE WITH DEA INITIAL START CALCULATION'
       CALL TIMIT(1)
       CALL FLSHBF(IO)
C
       IF(JREST.EQ.-1)THEN
        IF(MASWRK)WRITE(IO,'(/A/)')
     * '!!!SELECT TARGET STATES FROM PRINTED INI VECTORS!!!'
        CALL ABRT
       ENDIF
C
2000   OME=0.0D0
       IFDONE=0
       ALLOCATE(MTS(ITEOM,ITEOM))
C
C    DEAEOM2 : DEA-EOMCC(3P1H)
C    DEAEOM2A: DEA-EOMCC(3P1H){NU}
       IF(CCTYP.EQ.DEAEOM2A)GOTO 3000
C    DEAEOM3A: DEA-EOMCC(4P2H,3P1H){NU}
       IF(CCTYP.EQ.DEAEOM3A)GOTO 4000
C    DEAEOM3B: DEA-EOMCC(4P2H){NU}
       IF(CCTYP.EQ.DEAEOM3B)GOTO 5000
C    DEAEOM3 : DEA-EOMCC(4P2H)
       IF(CCTYP.EQ.DEAEOM3 )GOTO 6000
C
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR,LLL2,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IR1,LLL2,FNAME,'.R1')
       CALL DEAEOM_OPEN(IO,IHR,LLL2,FNAME,'.HR')
C
       DO IROOT=1,NROOT
       IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R(LLL2),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R
        CALL DEAEOM_READ(IR1,IROOT0,LLL2,R)
       ELSE
!       READ(IR0,REC=IROOT0)R
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R)
       ENDIF
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL2,R)
       DEALLOCATE(R)
C
       MTS=0.0D0
      IF(MASWRK)THEN
       WRITE(IO,'(/6x,A,1X,I5)')
     *'BEGINNING DEA-EOMCC(3P1H) ITERATIONS FOR STATE',IROOT0
        IF(JREST.NE.0)THEN
         WRITE(IO,'(1X,A)')'STARTING VECTORS:'
         CALL DEAEOM_PRINT_R(IR,IO,1,N0,N1,N2,N3,LLL2,LLL2,1.0D-1)
        ENDIF
        CALL FLSHBF(IO)
       ENDIF
       DO  ITER=1,ITEOM
C
       CALL DEAEOM2_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL2,
     & K2B0A,K3B1A,K3C1B,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL2,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL DEAEOM2_R(IO,IHR,IR,IR1,LLL2,ITER,ITEOM,RES,WI,OME(IROOT),
     & K2B0A,K3B1A,K3C1B,
     & N0,N1,N2,N3,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
1001  FORMAT(1X,'ITERATION:',1X,I3,2X,'DEA ENERGY=',1X,F15.10,2X,
     *       'CONV:',1X,F15.9)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 200
       CALL R_ORTH(IR,LLL2,ITER)
!      CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,LLL2,1.0D-1)
C
       ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
200    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     *  'DEA ENERGY= ',OME(IROOT),'VECTORS:'
        CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,LLL2,1.0D-1)
        CALL FLSHBF(IO)
       ENDIF
      ALLOCATE(R(LLL2))
      CALL DEAEOM_READ(IR1,IROOT0,LLL2,R)
      CALL DEAEOM_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K2B0A),R(K3B1A),R(K3C1B),10*TOL)
      DEALLOCATE(R)
C
      ENDDO
      GOTO 7000
C
3000   LLL2A=0
       K2B0A=LLL2A+1; LLL2A=LLL2A+K3*K4
       K3B1A=LLL2A+1; LLL2A=LLL2A+K1*K9*K3*K4
       K3B1A1=LLL2A+1;LLL2A=LLL2A+K1*K6*K6*K0
       K3C1B=LLL2A+1; LLL2A=LLL2A+K2*K3*K0*K4
       K3C1B1=LLL2A+1;LLL2A=LLL2A+K2*K9*K6*K6
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL2A*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL2A*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR,LLL2A,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IR1,LLL2,FNAME,'.R1')
       CALL DEAEOM_OPEN(IO,IHR,LLL2A,FNAME,'.HR')
C
       DO IROOT=1,NROOT
        IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R0(LLL2),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R0
        CALL DEAEOM_READ(IR1,IROOT0,LLL2,R0)
       ELSE
!       READ(IR0,REC=IROOT0)R0
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R0)
       ENDIF
C
       ALLOCATE(R(LLL2A),SOURCE=0.0D0)
       CALL DEAEOM2A_READ_INI(N0,N1,N2,N3,M2,
     & R0(K2B0A),R0(K3B1A),R0(K3C1B0),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1))
       PP=0.0D0
       DO I=1,LLL2A
        PP=PP+R(I)*R(I)
       ENDDO
       PP=DSQRT(PP)
       R=R/PP
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL2A,R)
!      DEALLOCATE(R,R0)
C
      IF(MASWRK)THEN
       WRITE(IO,'(/6x,A,1X,I5)')
     * 'BEGINNING DEA-EOMCC(3P1H){NU} ITERATIONS FOR STATE',IROOT0
        IF(JREST.NE.0)THEN
         WRITE(IO,'(1X,A)')'STARTING VECTORS:'
         CALL DEAEOM_PRINT_INI(IO,N0,N1,N2,N3,R0,LLL2,1.0D-1)
        ENDIF
        CALL FLSHBF(IO)
       ENDIF
       DEALLOCATE(R,R0)
       MTS=0.0D0
       DO  ITER=1,ITEOM
C
       CALL DEAEOM2A_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,M2,T,
     & K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,LLL2A,
     & K2B0A,K3B1A,K3B1A1,K3C1B,K3C1B1,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & NFT899)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL2A,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL DEAEOM2A_R(IO,IHR,IR,IR1,LLL2A,ITER,ITEOM,RES,WI,OME(IROOT),
     & K2B0A,K3B1A,K3B1A1,K3C1B,K3C1B1,
     & N0,N1,N2,N3,M2,K3C1B0,LLL2,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 300
       CALL R_ORTH(IR,LLL2A,ITER)
!      CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,LLL2,1.0D-1)
C
       ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
300    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     *  'DEA ENERGY= ',OME(IROOT),'VECTORS:'
        CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,LLL2,1.0D-1)
        CALL FLSHBF(IO)
       ENDIF
      ALLOCATE(R(LLL2))
      CALL DEAEOM_READ(IR1,IROOT0,LLL2,R)
      CALL DEAEOM_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K2B0A),R(K3B1A),R(K3C1B0),10*TOL)
      DEALLOCATE(R)
      ENDDO
C
      GOTO 7000
C
4000   LLL3A=0
       K2B0A=LLL3A+1; LLL3A=LLL3A+K3*K4
       K3B1A=LLL3A+1; LLL3A=LLL3A+K1*K9*K3*K4
       K3B1A1=LLL3A+1;LLL3A=LLL3A+K1*K6*K6*K0
       K3C1B=LLL3A+1; LLL3A=LLL3A+K2*K3*K0*K4
       K3C1B1=LLL3A+1;LLL3A=LLL3A+K2*K9*K6*K6
       K4B2A=LLL3A+1; LLL3A=LLL3A+K4*K3*K9*K9*K1*K1
       K4B2A1=LLL3A+1;LLL3A=LLL3A+K0*K6*K6*K9*K1*K1
       K4C2B=LLL3A+1; LLL3A=LLL3A+K4*K0*K3*K9*K2*K1
       K4C2B1=LLL3A+1;LLL3A=LLL3A+K6*K6*K9*K9*K2*K1
       K4C2B2=LLL3A+1;LLL3A=LLL3A+K0*K0*K6*K6*K2*K1
       K4D2C=LLL3A+1; LLL3A=LLL3A+K4*K0*K0*K3*K2*K2
       K4D2C1=LLL3A+1;LLL3A=LLL3A+K6*K6*K0*K9*K2*K2
       LLL3B=LLL2+LLL3A-(K4B2A-1)
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL3A*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL3A*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL3B*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR, LLL3A,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IHR,LLL3A,FNAME,'.HR')
       CALL DEAEOM_OPEN(IO,IR1,LLL3B,FNAME,'.R1')
       DO IROOT=1,NROOT
        IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R0(LLL3B),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R0
        CALL DEAEOM_READ(IR1,IROOT0,LLL3B,R0)
       ELSE
!       READ(IR0,REC=IROOT0)(R0(I),I=1,LLL2)
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R0)
       ENDIF
C
       ALLOCATE(R(LLL3A),SOURCE=0.0D0)
       CALL DEAEOM3A_READ_INI(N0,N1,N2,N3,M2,K3B1A-1,LLL3B-LLL2,
     & R0(K2B0A),R0(K3B1A),R0(K3C1B0),R0(LLL2+1),
     & R(K2B0A),R(K3B1A),R(K3B1A1),R(K3C1B),R(K3C1B1),R(K4B2A))
       PP=0.0D0
       DO I=1,LLL3A
        PP=PP+R(I)*R(I)
       ENDDO
       PP=DSQRT(PP)
       R=R/PP
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL3A,R)
!      DEALLOCATE(R,R0)
C
      IF(MASWRK)THEN
       WRITE(IO,'(/6x,A,1X,I5)')
     *'BEGINNING DEA-EOMCC(4P2H,3P1H){NU} ITERATIONS FOR STATE',IROOT0
        IF(JREST.NE.0)THEN
         WRITE(IO,'(1X,A)')'STARTING VECTORS:'
         CALL DEAEOM_PRINT_INI(IO,N0,N1,N2,N3,R0,LLL2,1.0D-1)
        ENDIF
        CALL FLSHBF(IO)
       ENDIF
       DEALLOCATE(R,R0)
       MTS=0.0D0
       DO  ITER=1,ITEOM
C
       CALL DEAEOM3A_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,M2,T,
     & K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,LLL3A,
     & K2B0A,K3B1A,K3B1A1,K3C1B,K3C1B1,
     & K4B2A,K4B2A1,K4C2B,K4C2B1,K4C2B2,K4D2C,K4D2C1,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & NFT899)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL3A,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL DEAEOM3A_R(IO,IHR,IR,IR1,LLL3A,ITER,ITEOM,RES,WI,OME(IROOT),
     & K2B0A,K3B1A,K3B1A1,K3C1B,K3C1B1,
     & K4B2A,K4B2A1,K4C2B,K4C2B1,K4C2B2,K4D2C,K4D2C1,
     & N0,N1,N2,N3,M2,K3C1B0,LLL2,LLL3B,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 400
       CALL R_ORTH(IR,LLL3A,ITER)
!      CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3B,LLL2,1.0D-1)
C
       ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
400    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     *  'DEA ENERGY= ',OME(IROOT),'VECTORS:'
        CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3B,LLL2,1.0D-1)
        CALL FLSHBF(IO)
       ENDIF
      ALLOCATE(R(LLL3B))
      CALL DEAEOM_READ(IR1,IROOT0,LLL3B,R)
      CALL DEAEOM_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K2B0A),R(K3B1A),R(K3C1B0),10*TOL)
      DEALLOCATE(R)
C
      ENDDO
      GOTO 7000
C
5000   LLL3B=0
       K2B0A =LLL3B+1;LLL3B=LLL3B+K3*K4
       K3B1A =LLL3B+1;LLL3B=LLL3B+K1*K3*K3*K4
       K3C1B =LLL3B+1;LLL3B=LLL3B+K2*K3*K4*K4
       K4B2A =LLL3B+1;LLL3B=LLL3B+K4*K3*K9*K9*K1*K1
       K4B2A1=LLL3B+1;LLL3B=LLL3B+K0*K6*K6*K9*K1*K1
       K4C2B =LLL3B+1;LLL3B=LLL3B+K4*K0*K3*K9*K2*K1
       K4C2B1=LLL3B+1;LLL3B=LLL3B+K6*K6*K9*K9*K2*K1
       K4C2B2=LLL3B+1;LLL3B=LLL3B+K0*K0*K6*K6*K2*K1
       K4D2C =LLL3B+1;LLL3B=LLL3B+K4*K0*K0*K3*K2*K2
       K4D2C1=LLL3B+1;LLL3B=LLL3B+K6*K6*K0*K9*K2*K2
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL3B*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL3B*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL3B*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR, LLL3B,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IR1,LLL3B,FNAME,'.R1')
       CALL DEAEOM_OPEN(IO,IHR,LLL3B,FNAME,'.HR')
C
       DO IROOT=1,NROOT
        IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R(LLL3B),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R
        CALL DEAEOM_READ(IR1,IROOT0,LLL3B,R)
       ELSE
!       READ(IR0,REC=IROOT0)(R(I),I=1,LLL2)
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R)
       ENDIF
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL3B,R)
       DEALLOCATE(R)
C
      IF(MASWRK)THEN
       WRITE(IO,'(/6x,A,1X,I5)')
     * 'BEGINNING DEA-EOMCC(4P2H){NU} ITERATIONS FOR STATE',IROOT0
        IF(JREST.NE.0)THEN
         WRITE(IO,'(1X,A)')'STARTING VECTORS:'
         CALL DEAEOM_PRINT_R(IR,IO,1,N0,N1,N2,N3,LLL3B,LLL2,1.0D-1)
        ENDIF
       CALL FLSHBF(IO)
       ENDIF
       MTS=0.0D0
       DO  ITER=1,ITEOM
       CALL DEAEOM3B_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,M2,T,
     & K1,K2,K3,K4,K6,K9,K0,K1A,K1B,K2A,K2B,K2C,KKK,LLL3B,
     & K2B0A,K3B1A,K3C1B,K4B2A,K4B2A1,K4C2B,K4C2B1,K4C2B2,K4D2C,K4D2C1,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & NFT899)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL3B,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL DEAEOM3B_R(IO,IHR,IR,IR1,LLL3B,ITER,ITEOM,RES,WI,OME(IROOT),
     & K2B0A,K3B1A,K3C1B,K4B2A,K4B2A1,K4C2B,K4C2B1,K4C2B2,K4D2C,K4D2C1,
     & N0,N1,N2,N3,M2,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 500
       CALL R_ORTH(IR,LLL3B,ITER)
!      CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3B,LLL2,1.0D-1)
C
      ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
500    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     *  'DEA ENERGY= ',OME(IROOT),'VECTORS:'
        CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3B,LLL2,1.0D-1)
        CALL FLSHBF(IO)
      ENDIF
      ALLOCATE(R(LLL3B))
      CALL DEAEOM_READ(IR1,IROOT0,LLL3B,R)
      CALL DEAEOM_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K2B0A),R(K3B1A),R(K3C1B0),10*TOL)
      DEALLOCATE(R)
      ENDDO
      GOTO 7000
C
6000   LLL3=0
       K2B0A=LLL3+1;LLL3=LLL3+K3*K4
       K3B1A=LLL3+1;LLL3=LLL3+K1*K3*K3*K4
       K3C1B=LLL3+1;LLL3=LLL3+K2*K3*K4*K4
       K4B2A=LLL3+1;LLL3=LLL3+K1*K1*K3*K3*K3*K4
       K4C2B=LLL3+1;LLL3=LLL3+K1*K2*K3*K3*K4*K4
       K4D2C=LLL3+1;LLL3=LLL3+K2*K2*K3*K4*K4*K4
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL3*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL3*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL3*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR, LLL3,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IR1,LLL3,FNAME,'.R1')
       CALL DEAEOM_OPEN(IO,IHR,LLL3,FNAME,'.HR')
C
       ALLOCATE(HAPPPP(N1+1:N3,N1+1:N3,N1+1:N3,N1+1:N3))
       ALLOCATE(HBPPPP(N2+1:N3,N1+1:N3,N2+1:N3,N1+1:N3))
       ALLOCATE(HCPPPP(N2+1:N3,N2+1:N3,N2+1:N3,N2+1:N3))
       DO A=N1+1,N3
        READ(NFT899,REC=A-N1)
     &(((HAPPPP(D,C,B,A),D=N1+1,N3),C=N1+1,N3),B=N1+1,N3)
       ENDDO
       DO A=N2+1,N3
        READ(NFT899,REC=A-N2+K3)
     &(((HCPPPP(D,C,B,A),D=N2+1,N3),C=N2+1,N3),B=N2+1,N3)
       ENDDO
       DO B=N2+1,N3
        READ(NFT899,REC=B-N2+K3+K4)
     &(((HBPPPP(D,C,B,A),D=N2+1,N3),C=N1+1,N3),A=N1+1,N3)
       ENDDO
C
       DO IROOT=1,NROOT
       IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R(LLL3),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R
        CALL DEAEOM_READ(IR1,IROOT0,LLL3,R)
       ELSE
!       READ(IR0,REC=IROOT0)(R(I),I=1,LLL2)
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R)
       ENDIF
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL3,R)
       DEALLOCATE(R)
C
      IF(MASWRK)THEN
       WRITE(IO,'(/6x,A,1X,I5)')
     * 'BEGINNING DEA-EOMCC(4P2H) ITERATIONS FOR STATE',IROOT0
        IF(JREST.NE.0)THEN
         WRITE(IO,'(1X,A)')'STARTING VECTORS:'
         CALL DEAEOM_PRINT_R(IR,IO,1,N0,N1,N2,N3,LLL3,LLL2,1.0D-1)
        ENDIF
        CALL FLSHBF(IO)
       ENDIF
       MTS=0.0D0
       DO  ITER=1,ITEOM
C
       CALL DEAEOM3_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL3,
     & K2B0A,K3B1A,K3C1B,K4B2A,K4C2B,K4D2C,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,HAPPPP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,HBPPPP,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,HCPPPP)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL3,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL DEAEOM3_R(IO,IHR,IR,IR1,LLL3,ITER,ITEOM,RES,WI,OME(IROOT),
     & K2B0A,K3B1A,K3C1B,K4B2A,K4C2B,K4D2C,
     & N0,N1,N2,N3,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 600
       CALL R_ORTH(IR,LLL3,ITER)
!      CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3,LLL2,1.0D-1)
C
       ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
600    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     *  'DEA ENERGY= ',OME(IROOT),'VECTORS:'
        CALL DEAEOM_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3,LLL2,1.0D-1)
        CALL FLSHBF(IO)
       ENDIF
      ALLOCATE(R(LLL3))
      CALL DEAEOM_READ(IR1,IROOT0,LLL3,R)
      CALL DEAEOM_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K2B0A),R(K3B1A),R(K3C1B),10*TOL)
      DEALLOCATE(R)
C
      ENDDO
 
7000  IF(MASWRK)
     *WRITE(IO,'(/A)')' ITERATIONS FOR ALL STATES HAVE FINISHED'
C
       END
C
C*MODULE DEAEOMDIP DECK DREOMDIP
C> @brief Drives the DIP-EOMCC calculation
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param TOL convergence tolerance
C> @param OME DIP-EOMCC excitation energy
C> @param IFDONE index to tell if the calculation for the root is done
C> @param ITEOM diagonal space of HBar
C> @param INDROOT excited states to be calculated
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param MULT multiplicity of the excited states to be calculated
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M3 index of last unactive occupied orbital for initial guess
C> @param M4 index of the last active unoccupied orbital for initial guess
C> @param M1 index of last unactive occupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K5 number of non-active occupied orbitals
C> @param K7 number of active occupied alpha orbitals
C> @param K8 number of active occupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param KKK number size of the CCSD cluster vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C>
       SUBROUTINE DREOMDIP(N0,N1,N2,N3,IO,IR,IHR,IR0,IR1,M3,M4,NROOT,
     & TOL,K1,K2,K3,K4,K5,K7,K8,K1A,K1B,K2A,K2B,K2C,KKK,M1,OME,CCTYP,
     & IFDONE,T,ITEOM,INDROOT,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899,MULT,ISPIN)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
      IMPLICIT NONE
      LOGICAL GOPARR,DSKWRK,MASWRK
      INTEGER ME,MASTER,NPROC,IBTYP,IPTIM
      COMMON /PAR   / ME,MASTER,NPROC,IBTYP,IPTIM,GOPARR,DSKWRK,MASWRK
      INTEGER N0,N1,N2,N3,IO,IR,IHR,IR0,IR1,M3,M4,NROOT,
     & K1,K2,K3,K4,K5,K7,K8,K1A,K1B,K2A,K2B,K2C,KKK,M1,
     & ITEOM,NFT899,MULT
      INTEGER IROOT,IROOT0,ITER
      INTEGER LLL2,LLL3,LLL3A
      INTEGER K0A2B,K1A3B,K1B3C,K2A4B,K2A4B1,K2B4C,K2B4C1,
     &K2B4C2,K2C4D,K2C4D1
      INTEGER MULEAIP,JREST,NACTA,NACTB
      INTEGER IFDONE(NROOT),INDROOT(NROOT),ISPIN(NROOT)
      real*8 TOL,CCTYP,RES
      real*8 EOMDIP2,EOMDIP3,EOMDIP3A
      real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
      real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
      real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
      real*8 HAHH(N0+1:N1,N0+1:N1)
      real*8 HAHP(N1+1:N3,N0+1:N1)
      real*8 HAPP(N1+1:N3,N1+1:N3)
      real*8 HBHH(N0+1:N2,N0+1:N2)
      real*8 HBHP(N2+1:N3,N0+1:N2)
      real*8 HBPP(N2+1:N3,N2+1:N3)
      real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
      real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
      real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
      real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
      real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
      real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
      real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
      real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
      real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
      real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
      real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
      real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
      real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
      real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
      real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
      real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
      real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
      real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
      real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
      real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
      real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
      real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
      real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
      real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
      real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
      real*8 T(KKK)
      real*8 OME(NROOT)
      real*8,ALLOCATABLE:: R(:),MTS(:,:),WI(:)
      COMMON /EAIP  / MULEAIP,JREST,NACTA,NACTB
      DATA EOMDIP2,EOMDIP3,EOMDIP3A
     *     /8HDIPEOM2 ,8HDIPEOM3 ,8HDIPEOM3A/
      LOGICAL FILE_EXISTS
        CHARACTER*800 FNAME
C
        CALL GMS_GETENV("CCSD3AA", FNAME)
C
       LLL2=0
       K0A2B=LLL2+1;LLL2=LLL2+K2*K1
       K1A3B=LLL2+1;LLL2=LLL2+K3*K2*K1*K1
       K1B3C=LLL2+1;LLL2=LLL2+K4*K2*K2*K1
C
       IF(JREST.EQ.1) THEN
         INQUIRE(FILE=TRIM(FNAME)//'.R1',EXIST=FILE_EXISTS)
         IF(.NOT. FILE_EXISTS) THEN
           IF(MASWRK)
     *     WRITE(IO,'(A)') 'ERROR. RESTART FILE .R1 NOT FOUND.'
           CALL ABRT
         ENDIF
         IF(MASWRK)WRITE(IO,'(A)')'RESTART FROM SAVED VECTORS FILE .R1'
         GOTO 1000
       ENDIF
C
!      OPEN(IR0,FILE=TRIM(FNAME)//'.R0',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR0,LLL2,FNAME,'.R0')
       IF(JREST.EQ.2) THEN
         INQUIRE(FILE=TRIM(FNAME)//'.R0',EXIST=FILE_EXISTS)
         IF(.NOT. FILE_EXISTS) THEN
           IF(MASWRK)
     &     WRITE(IO,'(A)') 'ERROR. INI GUESS FILE .R0 NOT FOUND.'
           CALL ABRT
         ENDIF
         IF(MASWRK)
     &   WRITE(IO,'(A)') 'START FROM EXSIT INI VECTORS FILE .R0'
         GOTO 1000
       ENDIF
       IF(MASWRK)WRITE(IO,'(A)')' DIP INITIAL START CALCULATION'
       CALL FLSHBF(IO)
       CALL EOMDIP_INI(N0,N1,N2,N3,LLL2,M3,M4,IO,IR0,NROOT,
     & K0A2B,K1A3B,K1B3C,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & INDROOT,MULT)
       IF(MASWRK)
     & WRITE(IO,'(A)')' DONE WITH DIP INITIAL START CALCULATION'
       CALL TIMIT(1)
       CALL FLSHBF(IO)
C
       IF(JREST.EQ.-1)THEN
        IF(MASWRK)WRITE(IO,'(/A/)')
     * '!!!SELECT TARGET STATES FROM PRINTED INI VECTORS!!!'
        CALL ABRT
       ENDIF
C
1000   OME=0.0D0
       IFDONE=0
       ALLOCATE(MTS(ITEOM,ITEOM))
C    EOMDIP2 : DIP-EOMCC(3H1P)
       IF(CCTYP.EQ.EOMDIP3A)GOTO 2000
C    EOMDIP3A: DIP-EOMCC(4H2P){NO}
       IF(CCTYP.EQ.EOMDIP3)GOTO 3000
C    EOMDIP3 : DIP-EOMCC(4H2P)
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL2*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR,LLL2,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IR1,LLL2,FNAME,'.R1')
       CALL DEAEOM_OPEN(IO,IHR,LLL2,FNAME,'.HR')
       DO IROOT=1,NROOT
        IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R(LLL2),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R
        CALL DEAEOM_READ(IR1,IROOT0,LLL2,R)
       ELSE
!       READ(IR0,REC=IROOT0)R
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R)
       ENDIF
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL2,R)
       DEALLOCATE(R)
C
       MTS=0.0D0
      IF(MASWRK)WRITE(IO,'(/6x,A,1X,I5)')
     *'BEGINNING DIP-EOMCC(3H1P) ITERATIONS FOR STATE',IROOT0
       IF(JREST.NE.0)THEN
        IF(MASWRK)WRITE(IO,'(1X,A)')'STARTING VECTORS:'
        CALL EOMDIP_PRINT_R(IR,IO,1,N0,N1,N2,N3,LLL2,LLL2,1.0D-1)
       ENDIF
       CALL FLSHBF(IO)
       DO  ITER=1,ITEOM
C
       CALL EOMDIP2_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL2,
     & K0A2B,K1A3B,K1B3C,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL2,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL EOMDIP2_R(IO,IHR,IR,IR1,LLL2,ITER,ITEOM,RES,WI,OME(IROOT),
     & K0A2B,K1A3B,K1B3C,
     & N0,N1,N2,N3,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
1001  FORMAT(1X,'ITERATION:',1X,I3,2X,'DIP ENERGY=',1X,F15.10,2X,
     *       'CONV:',1X,F15.9)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 100
       CALL R_ORTH(IR,LLL2,ITER)
!      CALL EOMDIP_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,1.0D-1)
       ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
100    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     *  'DIP ENERGY= ',OME(IROOT),'VECTORS:'
        CALL EOMDIP_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,LLL2,1.0D-1)
        CALL FLSHBF(IO)
       ENDIF
      ALLOCATE(R(LLL2))
      CALL DEAEOM_READ(IR1,IROOT0,LLL2,R)
      CALL EOMDIP_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K0A2B),R(K1A3B),R(K1B3C),10*TOL)
      DEALLOCATE(R)
C
      ENDDO
      GOTO 4000
C
2000   LLL3A=0
       K0A2B =LLL3A+1;LLL3A=LLL3A+K2*K1
       K1A3B =LLL3A+1;LLL3A=LLL3A+K3*K2*K1*K1
       K1B3C =LLL3A+1;LLL3A=LLL3A+K4*K2*K2*K1
       K2A4B =LLL3A+1;LLL3A=LLL3A+K3*K3*K2*K1*K7*K7
       K2A4B1=LLL3A+1;LLL3A=LLL3A+K3*K3*K8*K5*K5*K7
       K2B4C =LLL3A+1;LLL3A=LLL3A+K4*K3*K2*K8*K1*K7
       K2B4C1=LLL3A+1;LLL3A=LLL3A+K4*K3*K5*K5*K7*K7
       K2B4C2=LLL3A+1;LLL3A=LLL3A+K4*K3*K8*K8*K5*K5
       K2C4D =LLL3A+1;LLL3A=LLL3A+K4*K4*K2*K8*K8*K1
       K2C4D1=LLL3A+1;LLL3A=LLL3A+K4*K4*K5*K5*K8*K7
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL3A*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL3A*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL3A*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR,LLL3A,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IR1,LLL3A,FNAME,'.R1')
       CALL DEAEOM_OPEN(IO,IHR,LLL3A,FNAME,'.HR')
C
       DO IROOT=1,NROOT
        IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R(LLL3A),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R
        CALL DEAEOM_READ(IR1,IROOT0,LLL3A,R)
       ELSE
!       READ(IR0,REC=IROOT0)(R(I),I=1,LLL2)
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R)
       ENDIF
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL3A,R)
       DEALLOCATE(R)
C
      IF(MASWRK)WRITE(IO,'(/6x,A,1X,I5)')
     *'BEGINNING DIP-EOMCC(4H2P){NO} ITERATIONS FOR STATE',IROOT0
       IF(JREST.NE.0)THEN
        IF(MASWRK)WRITE(IO,'(1X,A)')'STARTING VECTORS:'
        CALL EOMDIP_PRINT_R(IR,IO,1,N0,N1,N2,N3,LLL3A,LLL2,1.0D-1)
       ENDIF
       CALL FLSHBF(IO)
       MTS=0.0D0
       DO  ITER=1,ITEOM
C
       CALL EOMDIP3A_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,M1,T,
     & K1,K2,K3,K4,K5,K7,K8,K1A,K1B,K2A,K2B,K2C,KKK,LLL3A,
     & K0A2B,K1A3B,K1B3C,K2A4B,K2A4B1,K2B4C,K2B4C1,K2B4C2,K2C4D,K2C4D1,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL3A,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL EOMDIP3A_R(IO,IHR,IR,IR1,LLL3A,ITER,ITEOM,RES,WI,OME(IROOT),
     & K0A2B,K1A3B,K1B3C,K2A4B,K2A4B1,K2B4C,K2B4C1,K2B4C2,K2C4D,K2C4D1,
     & N0,N1,N2,N3,M1,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 200
       CALL R_ORTH(IR,LLL3A,ITER)
!      CALL EOMDIP_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,1.0D-1)
C
       ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
200    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     * 'DIP ENERGY= ',OME(IROOT),'VECTORS:'
        CALL EOMDIP_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3A,LLL2,1.0D-1)
        CALL FLSHBF(IO)
       ENDIF
      ALLOCATE(R(LLL3A))
      CALL DEAEOM_READ(IR1,IROOT0,LLL3A,R)
      CALL EOMDIP_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K0A2B),R(K1A3B),R(K1B3C),10*TOL)
      DEALLOCATE(R)
      ENDDO
C
      GOTO 4000
3000   LLL3=0
       K0A2B=LLL3+1;LLL3=LLL3+K2*K1
       K1A3B=LLL3+1;LLL3=LLL3+K3*K2*K1*K1
       K1B3C=LLL3+1;LLL3=LLL3+K4*K2*K2*K1
       K2A4B=LLL3+1;LLL3=LLL3+K3*K3*K2*K1*K1*K1
       K2B4C=LLL3+1;LLL3=LLL3+K4*K3*K2*K2*K1*K1
       K2C4D=LLL3+1;LLL3=LLL3+K4*K4*K2*K2*K2*K1
C
!      OPEN(IR,FILE=TRIM(FNAME)//'.R2',RECL=LLL3*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IR1,FILE=TRIM(FNAME)//'.R1',RECL=LLL3*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
!      OPEN(IHR,FILE=TRIM(FNAME)//'.HR',RECL=LLL3*8,ACCESS='DIRECT',
!    & FORM='UNFORMATTED')
       CALL DEAEOM_OPEN(IO,IR,LLL3,FNAME,'.R2')
       CALL DEAEOM_OPEN(IO,IR1,LLL3,FNAME,'.R1')
       CALL DEAEOM_OPEN(IO,IHR,LLL3,FNAME,'.HR')
C
       DO IROOT=1,NROOT
        IROOT0=INDROOT(IROOT)
C
       ALLOCATE(R(LLL3),SOURCE=0.0D0)
       IF(JREST.EQ.1)THEN
!       READ(IR1,REC=IROOT0)R
        CALL DEAEOM_READ(IR1,IROOT0,LLL3,R)
       ELSE
!       READ(IR0,REC=IROOT0)(R(I),I=1,LLL2)
        CALL DEAEOM_READ(IR0,IROOT0,LLL2,R)
       ENDIF
!      WRITE(IR,REC=1)R
       CALL DEAEOM_WRITE(IR,1,LLL3,R)
       DEALLOCATE(R)
C
      IF(MASWRK)WRITE(IO,'(/6x,A,1X,I5)')
     *'BEGINNING DIP-EOMCC(4H2P) ITERATIONS FOR STATE',IROOT0
       IF(JREST.NE.0)THEN
        IF(MASWRK)WRITE(IO,'(1X,A)')'STARTING VECTORS:'
        CALL EOMDIP_PRINT_R(IR,IO,1,N0,N1,N2,N3,LLL3,LLL2,1.0D-1)
       ENDIF
       CALL FLSHBF(IO)
       MTS=0.0D0
       DO  ITER=1,ITEOM
       CALL EOMDIP3_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL3,
     & K0A2B,K1A3B,K1B3C,K2A4B,K2B4C,K2C4D,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899)
C
      ALLOCATE(WI(ITEOM),SOURCE=0.0D0)
      CALL
     * DEAEOMDIP_SOLVER(IO,IHR,IR,LLL3,ITER,ITEOM,MTS,OME(IROOT),WI)
C
      CALL EOMDIP3_R(IO,IHR,IR,IR1,LLL3,ITER,ITEOM,RES,WI,OME(IROOT),
     & K0A2B,K1A3B,K1B3C,K2A4B,K2B4C,K2C4D,
     & N0,N1,N2,N3,
     & HAHH,HAPP,HBHH,HBPP,IROOT0)
       IF(MASWRK)WRITE(IO,1001)ITER,OME(IROOT),RES
       CALL FLSHBF(IO)
       DEALLOCATE(WI)
       IF(RES.LT.TOL)GOTO 300
       CALL R_ORTH(IR,LLL3,ITER)
!      CALL EOMDIP_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL2,1.0D-1)
       ENDDO
       IF(MASWRK)WRITE(IO,*)'STATE',IROOT0,'NOT CONVERGED'
       CALL FLSHBF(IO)
       CYCLE
300    IFDONE(IROOT)=1
       IF(MASWRK)THEN
        WRITE(IO,'(/5X,A,I5,A)')
     *  'INTERATIONS FOR STATE',IROOT0,' HAVE CONVERGED'
        WRITE(IO,'(5X,A,F15.9,/5X,A)')
     * 'DIP ENERGY= ',OME(IROOT),'VECTORS:'
        CALL EOMDIP_PRINT_R(IR1,IO,IROOT0,N0,N1,N2,N3,LLL3,LLL2,1.0D-1)
        CALL FLSHBF(IO)
       ENDIF
      ALLOCATE(R(LLL3))
      CALL DEAEOM_READ(IR1,IROOT0,LLL3,R)
      CALL EOMDIP_SPIN(N0,N1,N2,N3,ISPIN(IROOT),
     &R(K0A2B),R(K1A3B),R(K1B3C),10*TOL)
      DEALLOCATE(R)
C
      ENDDO
C
4000  IF(MASWRK)
     * WRITE(IO,'(/A)')'ITERATIONS FOR ALL STATES HAVE FINISHED'
C
       END
C
C*MODULE DEAEOMDIP DECK EOMDIP2_HR
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param ITER number of iteration
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param K0A2B first number of 2h alpha-beta R^ij components
C> @param K1A3B first number of 3h1p alpha-alpha-alpha-beta R_a^ijk components
C> @param K1B3C first number of 3h1p beta-alpha-beta-beta R_a^ijk components
C> @param KKK number size of the CCSD cluster vector
C> @param LLL number size of the DIP(3h1p) vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C>
       SUBROUTINE EOMDIP2_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,T,
     & K1,K2,K3,K4,K1A,K1B,K2A,K2B,K2C,KKK,LLL,
     & K0A2B,K1A3B,K1B3C,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 T(KKK)
       real*8,ALLOCATABLE::HR(:),R(:)
C
       ALLOCATE(HR(LLL),SOURCE=0.0D0)
       ALLOCATE(R(LLL),SOURCE=0.0D0)
!      READ(IR,REC=ITER)R
        CALL DEAEOM_READ(IR,ITER,LLL,R)
C
       CALL EOMDIP2HR0A2B(N0,N1,N2,N3,HR(K0A2B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C))
C
       CALL EOMDIP2HR1A3B(N0,N1,N2,N3,HR(K1A3B),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C))
C
       CALL EOMDIP2HR1B3C(N0,N1,N2,N3,HR(K1B3C),
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C))
C
!      WRITE(IHR,REC=ITER)HR
       CALL DEAEOM_WRITE(IHR,ITER,LLL,HR)
       DEALLOCATE(HR,R)
C
       END
C
C
C*MODULE DEAEOMDIP DECK EOMDIP3A_HR
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param IO output file unit number
C> @param IR .R file unit number
C> @param IHR .HR file unit number
C> @param IR0 .R0 file unit number
C> @param IR1 .R1 file unit number
C> @param ITER number of iteration
C> @param NFT899 file number to store two-body Hamiltonian PPPP
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M1 index of last unactive occupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K5 number of non-active occupied orbitals
C> @param K7 number of active occupied alpha orbitals
C> @param K8 number of active occupied beta orbitals
C> @param K1A first number of one-body alpha cluster components
C> @param K1B first number of one-body beta cluster components
C> @param K2A first number of two-body alpha-alpha cluster components
C> @param K2B first number of two-body alpha-beta cluster components
C> @param K2C first number of two-body beta-beta cluster components
C> @param K0A2B first number of 2h R^ij alpha-beta components
C> @param K1A3B first number of 3h1p R_a^ijk alpha,alpha-alpha-beta components
C> @param K1B3C first number of 3h1p R_a^ijk beta,alpha-beta-beta components
C> @param K2A4B first number of 4h2p R_ab^IJkl
C> alpha-alpha,(active-alpha)-(active-alpha)-alpha-beta components
C> @param K2A4B1 first number of 4h2p R_ab^IjkL
C> alpha-alpha,(active-alpha)-(non-active-alpha)(non-active-alpha)-(active-beta) components
C> @param K2B4C first number of 4h2p R_ab^IjKl
C> alpha-beta,(active-alpha)-alpha-(active-beta)-beta components
C> @param K2B4C1 first number of 4h2p R_ab^IJkl
C> alpha-beta,(active-alpha)-(active-alpha)-(non-active-beta)-(non-active-beta) components
C> @param K2B4C2 first number of 4h2p R_ab^ijKL
C> alpha-beta,(non-active-alpha)-(non-active-alpha)-(active-beta)-(active-beta) components
C> @param K2C4D first number of 4h2p R_ab^iJKl
C> beta-beta,alpha-(active-beta)-(active-beta)-beta components
C> @param K2C4D1 first number of 4h2p R_ab^IJkl
C> beta-beta,(active-alpha)-(active-beta)-(non-active-beta)-(non-active-beta) components
C> @param KKK number size of the CCSD cluster vector
C> @param LLL number size of the DIP(4h2p){Nu} vector
C> @param T CCSD amplitudes
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C>
       SUBROUTINE EOMDIP3A_HR(N0,N1,N2,N3,IO,IHR,IR,ITER,M1,T,
     & K1,K2,K3,K4,K5,K7,K8,K1A,K1B,K2A,K2B,K2C,KKK,LLL,
     & K0A2B,K1A3B,K1B3C,K2A4B,K2A4B1,K2B4C,K2B4C1,K2B4C2,K2C4D,K2C4D1,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & NFT899)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 T(KKK)
       real*8,ALLOCATABLE::HR(:),R(:)
C
       ALLOCATE(HR(LLL),SOURCE=0.0D0)
       ALLOCATE(R(LLL),SOURCE=0.0D0)
!      READ(IR,REC=ITER)R
        CALL DEAEOM_READ(IR,ITER,LLL,R)
C
       IF(K5.GE.1)THEN
       CALL EOMDIP3AHR0A2B00(N0,N1,N2,N3,M1,HR(K0A2B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.1.AND.K8.GE.1)THEN
       CALL EOMDIP3AHR0A2B01(N0,N1,N2,N3,M1,HR(K0A2B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.1.AND.K7.GE.1)THEN
       CALL EOMDIP3AHR0A2B10(N0,N1,N2,N3,M1,HR(K0A2B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K7.GT.0.AND.K8.GT.0)THEN
       CALL EOMDIP3AHR0A2B11(N0,N1,N2,N3,M1,HR(K0A2B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.2)THEN
       CALL EOMDIP3AHR1A3B000(N0,N1,N2,N3,M1,HR(K1A3B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.2.AND.K8.GE.1)THEN
       CALL EOMDIP3AHR1A3B001(N0,N1,N2,N3,M1,HR(K1A3B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.1.AND.K7.GE.1)THEN
       CALL EOMDIP3AHR1A3B100(N0,N1,N2,N3,M1,HR(K1A3B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.1.AND.K7.GE.1.AND.K8.GE.1)THEN
       CALL EOMDIP3AHR1A3B101(N0,N1,N2,N3,M1,HR(K1A3B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & T(K1A),T(K1B),T(K2A),T(K2B),T(K2C),
     & R(K0A2B),R(K1A3B),R(K1B3C),R(K2A4B),R(K2A4B1),
     & R(K2B4C),R(K2B4C1),R(K2B4C2),R(K2C4D),R(K2C4D1))
       ENDIF
C
       IF(K5.GE.1.AND.K7.GE.2)THEN
       CALL EOMDIP3AHR1A3B110(N0,N1,N2,N3,M1,HR(K1A3B),
     & K1,K2,K3,K4,K5,K7,K8,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
