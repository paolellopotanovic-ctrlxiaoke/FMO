       real*8,allocatable::V4D2C(:,:,:,:,:,:)
       allocate(V4D2C(M2+1:N3,N2+1:M2,N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N2),
     &          source=0.0d0)
C
       allocate(D1(N1+1:N3,N0+1:N1,M2+1:N3,N0+1:N2))
       call reorder2431(N0,N2,N1,N3,N2,N3,N0,N1,
     & N1,N3,N0,N1,M2,N3,N0,N2,HBHPPH,D1)
       allocate(B2(N1+1:N3,N2+1:M2))
       call reorder21(N2,N3,N1,N3,
     & N1,N3,N2,M2,r2B0A,B2)
       allocate(S1(N2+1:M2,N0+1:N1,M2+1:N3,N0+1:N2))
       I1=K2*K6*K1
       I2=K0
       I3=K3
       call EGEMM(I1,I2,I3,D1,B2,S1)
       deallocate(D1)
