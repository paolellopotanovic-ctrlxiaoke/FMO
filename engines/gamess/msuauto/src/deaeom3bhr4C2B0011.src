C*MODULE DEAEOMDIP DECK deaeom3bhr4C2B0011
C> @brief Calculate H*R
C>
C> @author Jun Shen
C>
C> @param N0 number of frozen core orbitals
C> @param N1 number of occupied alpha orbitals (including frozen core)
C> @param N2 number of occupied beta orbitals (including frozen core)
C> @param N3 number of orbitals (including frozen core and virtual)
C> @param M2 index of the last active unoccupied orbital
C> @param K1 number of occupied alpha orbitals
C> @param K2 number of occupied beta orbitals
C> @param K3 number of unoccupied alpha orbitals
C> @param K4 number of unoccupied beta orbitals
C> @param K6 number of non-active unoccupied orbitals
C> @param K9 number of active unoccupied alpha orbitals
C> @param K0 number of active unoccupied beta orbitals
C> @param VAHHPP Twobody alpha-alpha HHPP array
C> @param VBHHPP Twobody alpha-beta HHPP array
C> @param VCHHPP Twobody beta-beta HHPP array
C> @param HAHH One-body Hamiltonian alpha HH array
C> @param HAHP One-body Hamiltonian alpha HP array
C> @param HAPP One-body Hamiltonian alpha PP array
C> @param HBHH One-body Hamiltonian beta HH array
C> @param HBHP One-body Hamiltonian beta HP array
C> @param HBPP One-body Hamiltonian beta PP array
C> @param HAHHHH Twobody Hamiltonian alpha-alpha HHHH array
C> @param HAHHHP Twobody Hamiltonian alpha-alpha HHHP array
C> @param HAHPHH Twobody Hamiltonian alpha-alpha HPHH array
C> @param HAHPHP Twobody Hamiltonian alpha-alpha HPHP array
C> @param HAHPPP Twobody Hamiltonian alpha-alpha HPPP array
C> @param HAPPHP Twobody Hamiltonian alpha-alpha PPHP array
C> @param HBHHHH Twobody Hamiltonian alpha-beta HHHH array
C> @param HBHHHP Twobody Hamiltonian alpha-beta HHHP array
C> @param HBHHPH Twobody Hamiltonian alpha-beta HHPH array
C> @param HBHPHH Twobody Hamiltonian alpha-beta HPHH array
C> @param HBPHHH Twobody Hamiltonian alpha-beta PHHH array
C> @param HBHPHP Twobody Hamiltonian alpha-beta HPHP array
C> @param HBHPPH Twobody Hamiltonian alpha-beta HPPH array
C> @param HBPHHP Twobody Hamiltonian alpha-beta PHHP array
C> @param HBPHPH Twobody Hamiltonian alpha-beta PHPH array
C> @param HBHPPP Twobody Hamiltonian alpha-beta HPPP array
C> @param HBPHPP Twobody Hamiltonian alpha-beta PHPP array
C> @param HBPPHP Twobody Hamiltonian alpha-beta PPHP array
C> @param HBPPPH Twobody Hamiltonian alpha-beta PPPH array
C> @param HCHHHH Twobody Hamiltonian beta-beta HHHH array
C> @param HCHHHP Twobody Hamiltonian beta-beta HHHP array
C> @param HCHPHH Twobody Hamiltonian beta-beta HPHH array
C> @param HCHPHP Twobody Hamiltonian beta-beta HPHP array
C> @param HCHPPP Twobody Hamiltonian beta-beta HPPP array
C> @param HCPPHP Twobody Hamiltonian beta-beta PPHP array
C> @param T1A one-body alpha cluster components
C> @param T1B one-body beta cluster components
C> @param T2A two-body alpha-alpha cluster components
C> @param T2B two-body alpha-beta cluster components
C> @param T2C two-body beta-beta cluster components
C> @param R2B0A 2p R_ab alpha-beta components
C> @param R3B1A 3p1h R_abc^i alpha-alpha-beta,alpha components
C> @param R3C1B 3p1h R_abc^i alpha-beta-beta,beta components
C> @param R4B2A 4p2h R_ABcd^ij
C> (active-alpha)-(active-alpha)-alpha-beta,alpha-alpha components
C> @param R4B2A1 4p2h R_AbcD^ij
C> (active-alpha)-(non-active-alpha)-(non-active-alpha)-(active-beta),alpha-alpha components
C> @param R4C2B 4p2h R_AbCd^ij
C> (active-alpha)-(active-alpha)-(non-active-beta)-(non-active-beta),alpha-beta components
C> @param R4C2B1 4p2h R_ABcd^ij
C> (active-alpha)-alpha-(active-beta)-beta,alpha-beta components
C> @param R4C2B2 4p2h R_abCD^ij
C> (non-active-alpha)-(non-active-alpha)-(active-beta)-(active-beta),alpha-beta components
C> @param R4D2C 4p2h R_aBCd^ij
C> alpha-(active-beta)-(active-beta)-beta,beta-beta components
C> @param R4D2C1 4p2h R_ABcd^ij
C> (active-alpha)-(active-beta)-(non-active-beta)-(non-active-beta),beta-beta components
C>
       subroutine deaeom3bhr4C2B0011(N0,N1,N2,N3,M2,HR4C2B,
     & K1,K2,K3,K4,K6,K9,K0,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & HAAPPP,HAPPAP,HBAPPP,HBPAPP,HBPPAP,HBPPPA,HCAPPP,HCPPAP,
     & t1A,t1B,t2A,t2B,t2C,
     & r2B0A,r3B1A,r3C1B,r4B2A,r4B2A1,r4C2B,r4C2B1,r4C2B2,r4D2C,r4D2C1)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 HAAPPP(N1+1:N3,N1+1:N3,N1+1:N3,N1+1:M2)
       real*8 HAPPAP(N1+1:N3,N1+1:M2,N1+1:N3,N1+1:N3)
       real*8 HBAPPP(N2+1:N3,N1+1:N3,N2+1:N3,N1+1:M2)
       real*8 HBPAPP(N2+1:N3,N1+1:N3,N2+1:M2,N1+1:N3)
       real*8 HBPPAP(N2+1:N3,N1+1:M2,N2+1:N3,N1+1:N3)
       real*8 HBPPPA(N2+1:M2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCAPPP(N2+1:N3,N2+1:N3,N2+1:N3,N2+1:M2)
       real*8 HCPPAP(N2+1:N3,N2+1:M2,N2+1:N3,N2+1:N3)
       real*8 t1A(N1+1:N3,N0+1:N1)
       real*8 t1B(N2+1:N3,N0+1:N2)
       real*8 t2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 t2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 t2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 r2B0A(N2+1:N3,N1+1:N3)
       real*8 r3B1A(N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 r3C1B(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2)
       real*8
     & r4B2A(N2+1:N3,N1+1:N3,N1+1:M2,N1+1:M2,N0+1:N1,N0+1:N1)
       real*8
     & r4B2A1(N2+1:M2,M2+1:N3,M2+1:N3,N1+1:M2,N0+1:N1,N0+1:N1)
       real*8
     & r4C2B(N2+1:N3,N2+1:M2,N1+1:N3,N1+1:M2,N0+1:N2,N0+1:N1)
       real*8
     & r4C2B1(M2+1:N3,M2+1:N3,N1+1:M2,N1+1:M2,N0+1:N2,N0+1:N1)
       real*8
     & r4C2B2(N2+1:M2,N2+1:M2,M2+1:N3,M2+1:N3,N0+1:N2,N0+1:N1)
       real*8
     & r4D2C(N2+1:N3,N2+1:M2,N2+1:M2,N1+1:N3,N0+1:N2,N0+1:N2)
       real*8
     & r4D2C1(M2+1:N3,M2+1:N3,N2+1:M2,N1+1:M2,N0+1:N2,N0+1:N2)
       real*8
     & HR4C2B(N2+1:M2,N2+1:M2,M2+1:N3,M2+1:N3,N0+1:N2,N0+1:N1)
C
       real*8,allocatable::B1(:,:)
       real*8,allocatable::B2(:,:)
       real*8,allocatable::C1(:,:,:)
       real*8,allocatable::C2(:,:,:)
       real*8,allocatable::D1(:,:,:,:)
       real*8,allocatable::D2(:,:,:,:)
       real*8,allocatable::F2(:,:,:,:,:,:)
C
       real*8,allocatable::S1(:,:,:,:)
       real*8,allocatable::S2(:,:,:,:)
       real*8,allocatable::S3(:,:,:,:)
       real*8,allocatable::S4(:,:,:,:)
       real*8,allocatable::S5(:,:,:,:)
       real*8,allocatable::S6(:,:,:,:)
       real*8,allocatable::S7(:,:,:,:)
       real*8,allocatable::S8(:,:,:,:)
       real*8,allocatable::S9(:,:,:,:)
       real*8,allocatable::Q1(:,:)
       real*8,allocatable::S11(:,:,:,:)
       real*8,allocatable::S10(:,:,:,:)
       real*8,allocatable::S12(:,:,:,:)
       real*8,allocatable::S13(:,:,:,:)
       real*8,allocatable::S14(:,:,:,:)
       real*8,allocatable::S15(:,:,:,:)
       real*8,allocatable::S16(:,:,:,:)
       real*8,allocatable::S17(:,:,:,:)
       real*8,allocatable::S18(:,:,:,:)
       real*8,allocatable::S19(:,:,:,:)
       real*8,allocatable::S20(:,:,:,:)
       real*8,allocatable::S21(:,:,:,:)
       real*8,allocatable::S22(:,:,:,:)
       real*8,allocatable::S23(:,:,:,:)
       real*8,allocatable::S24(:,:,:,:)
       real*8,allocatable::S25(:,:,:,:)
       real*8,allocatable::S26(:,:,:,:)
       real*8,allocatable::S27(:,:,:,:)
       real*8,allocatable::S28(:,:,:,:)
       real*8,allocatable::S29(:,:,:,:)
       real*8,allocatable::S30(:,:,:,:)
       real*8,allocatable::S31(:,:,:,:)
       real*8,allocatable::S32(:,:,:,:)
       real*8,allocatable::S33(:,:,:,:)
       real*8,allocatable::S34(:,:,:,:)
       real*8,allocatable::S35(:,:,:,:)
       real*8,allocatable::S36(:,:,:,:)
       real*8,allocatable::S37(:,:,:,:)
       real*8,allocatable::S38(:,:,:,:)
       real*8,allocatable::S39(:,:,:,:)
       real*8,allocatable::S40(:,:,:,:)
       real*8,allocatable::S41(:,:,:,:)
       real*8,allocatable::S42(:,:,:,:)
       real*8,allocatable::S43(:,:,:,:)
       real*8,allocatable::S44(:,:,:,:)
       real*8,allocatable::S45(:,:,:,:)
       real*8,allocatable::S46(:,:,:,:)
       real*8,allocatable::S47(:,:,:,:)
       real*8,allocatable::S48(:,:,:,:)
       real*8,allocatable::S49(:,:,:,:)
       real*8,allocatable::S50(:,:,:,:)
       real*8,allocatable::S51(:,:,:,:)
       real*8,allocatable::S52(:,:,:,:)
       real*8,allocatable::S53(:,:,:,:)
       real*8,allocatable::S54(:,:,:,:)
       real*8,allocatable::S55(:,:,:,:)
       real*8,allocatable::S56(:,:,:,:)
       real*8,allocatable::X1(:,:,:,:)
       real*8,allocatable::U1(:,:,:,:,:,:)
       real*8,allocatable::X2(:,:,:,:)
       real*8,allocatable::U2(:,:,:,:,:,:)
       real*8,allocatable::X3(:,:,:,:)
       real*8,allocatable::U3(:,:,:,:,:,:)
       real*8,allocatable::X4(:,:,:,:)
       real*8,allocatable::U4(:,:,:,:,:,:)
       real*8,allocatable::X5(:,:,:,:)
       real*8,allocatable::U5(:,:,:,:,:,:)
       real*8,allocatable::U6(:,:,:,:,:,:)
       real*8,allocatable::X6(:,:,:,:)
       real*8,allocatable::U7(:,:,:,:,:,:)
       real*8,allocatable::X7(:,:,:,:)
       real*8,allocatable::U8(:,:,:,:,:,:)
       real*8,allocatable::X8(:,:,:,:)
       real*8,allocatable::U9(:,:,:,:,:,:)
       real*8,allocatable::X9(:,:,:,:)
       real*8,allocatable::U10(:,:,:,:,:,:)
       real*8,allocatable::U12(:,:,:,:,:,:)
       real*8,allocatable::U13(:,:,:,:,:,:)
       real*8,allocatable::U14(:,:,:,:,:,:)
       real*8,allocatable::X10(:,:,:,:)
       real*8,allocatable::U16(:,:,:,:,:,:)
       real*8,allocatable::U20(:,:,:,:,:,:)
       real*8,allocatable::X11(:,:,:,:)
       real*8,allocatable::U21(:,:,:,:,:,:)
       real*8,allocatable::U24(:,:,:,:,:,:)
       real*8,allocatable::U25(:,:,:,:,:,:)
       real*8,allocatable::U26(:,:,:,:,:,:)
       real*8,allocatable::U36(:,:,:,:,:,:)
       real*8,allocatable::X12(:,:,:,:)
       real*8,allocatable::U37(:,:,:,:,:,:)
       real*8,allocatable::U41(:,:,:,:,:,:)
       real*8,allocatable::U42(:,:,:,:,:,:)
       real*8,allocatable::U43(:,:,:,:,:,:)
       real*8,allocatable::U44(:,:,:,:,:,:)
       real*8,allocatable::U45(:,:,:,:,:,:)
       real*8,allocatable::U46(:,:,:,:,:,:)
       real*8,allocatable::U47(:,:,:,:,:,:)
       real*8,allocatable::U48(:,:,:,:,:,:)
       real*8,allocatable::U49(:,:,:,:,:,:)
       real*8,allocatable::U50(:,:,:,:,:,:)
       real*8,allocatable::U51(:,:,:,:,:,:)
       real*8,allocatable::U52(:,:,:,:,:,:)
       real*8,allocatable::U53(:,:,:,:,:,:)
       real*8,allocatable::U54(:,:,:,:,:,:)
       real*8,allocatable::U55(:,:,:,:,:,:)
       real*8,allocatable::U56(:,:,:,:,:,:)
       real*8,allocatable::U57(:,:,:,:,:,:)
       real*8,allocatable::U58(:,:,:,:,:,:)
       real*8,allocatable::U72(:,:,:,:,:,:)
       real*8,allocatable::U73(:,:,:,:,:,:)
       real*8,allocatable::X13(:,:,:,:)
       real*8,allocatable::U78(:,:,:,:,:,:)
       real*8,allocatable::X14(:,:,:,:)
       real*8,allocatable::U80(:,:,:,:,:,:)
C
       real*8,allocatable::V4C2B(:,:,:,:,:,:)
       allocate(V4C2B(N2+1:M2,N2+1:M2,M2+1:N3,M2+1:N3,N0+1:N2,N0+1:N1),
     &          source=0.0d0)
C
       allocate(D1(N1+1:N3,N0+1:N1,M2+1:N3,N0+1:N1))
       call reorder1432(N1,N3,N0,N1,N1,N3,N0,N1,
     & N1,N3,N0,N1,M2,N3,N0,N1,HAHPHP,D1)
       allocate(B2(N1+1:N3,N2+1:M2))
       call reorder21(N2,N3,N1,N3,
     & N1,N3,N2,M2,r2B0A,B2)
       allocate(S1(N2+1:M2,N0+1:N1,M2+1:N3,N0+1:N1))
       I1=K1*K6*K1
       I2=K0
       I3=K3
       call EGEMM(I1,I2,I3,D1,B2,S1)
       deallocate(D1)
       deallocate(B2)
C
       allocate(X1(N0+1:N1,N2+1:M2,M2+1:N3,N0+1:N1),
     &          source=0.0d0)
       call
     &sum2134(N0,N1,N2,M2,M2,N3,N0,N1,X1,S1, 1.0_dp)
       deallocate(S1)
C
       allocate(D1(N1+1:N3,N0+1:N1,N2+1:M2,N0+1:N2))
       call reorder2431(N0,N2,N1,N3,N2,N3,N0,N1,
     & N1,N3,N0,N1,N2,M2,N0,N2,HBHPPH,D1)
       allocate(B2(N1+1:N3,N2+1:M2))
       call reorder21(N2,N3,N1,N3,
     & N1,N3,N2,M2,r2B0A,B2)
       allocate(S2(N2+1:M2,N0+1:N1,N2+1:M2,N0+1:N2))
       I1=K2*K0*K1
       I2=K0
       I3=K3
       call EGEMM(I1,I2,I3,D1,B2,S2)
       deallocate(D1)
       deallocate(B2)
C
       allocate(X2(N0+1:N1,N2+1:M2,N2+1:M2,N0+1:N2),
     &          source=0.0d0)
       call
     &sum3124(N0,N1,N2,M2,N2,M2,N0,N2,X2,S2, 1.0_dp)
       deallocate(S2)
C
       allocate(D1(N1+1:N3,N0+1:N2,M2+1:N3,N0+1:N2))
       call reorder2341(N0,N2,N1,N3,N0,N2,N1,N3,
     & N1,N3,N0,N2,M2,N3,N0,N2,HBPHPH,D1)
       allocate(B2(N1+1:N3,N2+1:M2))
       call reorder21(N2,N3,N1,N3,
     & N1,N3,N2,M2,r2B0A,B2)
       allocate(S3(N2+1:M2,N0+1:N2,M2+1:N3,N0+1:N2))
       I1=K2*K6*K2
       I2=K0
       I3=K3
       call EGEMM(I1,I2,I3,D1,B2,S3)
       deallocate(D1)
       deallocate(B2)
C
       allocate(X3(N0+1:N2,N2+1:M2,M2+1:N3,N0+1:N2),
     &          source=0.0d0)
       call
     &sum2134(N0,N2,N2,M2,M2,N3,N0,N2,X3,S3, 1.0_dp)
       deallocate(S3)
C
       allocate(D1(N1+1:N3,N2+1:N3,N2+1:M2,M2+1:N3))
       call reorder2134(N2,N3,N1,N3,N2,M2,N1,N3,
     & N1,N3,N2,N3,N2,M2,M2,N3,HBPAPP,D1)
       allocate(B2(N1+1:N3,N2+1:M2))
