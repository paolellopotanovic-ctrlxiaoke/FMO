       allocate(U10(M1+1:N2,M1+1:N1))
       I2=K7*K8
       I3=K3*K3*K5*K5
       call EGEMM2(I2,I3,D1,F2,U10)
       deallocate(D1)
       deallocate(F2)
C
       V0A2B=V0A2B+0.25_dp*U10
       deallocate(U10)
C
       allocate(D1(N0+1:M1,M1+1:N1,N1+1:N3,N1+1:N3))
       call reorder3412(N1,N3,N1,N3,N0,N1,N0,N1,
