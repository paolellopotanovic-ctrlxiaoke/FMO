       allocate(F2(N0+1:M1,M1+1:N1,N1+1:N3,N1+1:N3,M1+1:N2,M1+1:N1))
       call reorder451236(N1,N3,N1,N3,N0,N2,N0,N1,M1,N1,M1,N1,
