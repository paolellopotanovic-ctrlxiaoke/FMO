     &                    -Z10(c,b,a,j,i,k)
           endforall
         endforall
       endforall
       deallocate(Z10)
       deallocate(X10)
C
       allocate(D1(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       call reorder4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,VBHHPP,D1)
       allocate(F2(N0+1:N1,N2+1:N3,N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1))
       call reorder512346(N2,N3,N1,N3,N1,N3,N0,N2,N0,N1,N0,N1,
     & N0,N1,N2,N3,N1,N3,N1,N3,N0,N2,N0,N1,t3B,F2)
       allocate(S72(N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N2))
       I1=K2
       I2=K1*K2*K3
       I3=K3*K4*K1
       call EGEMM(I1,I2,I3,D1,F2,S72)
       deallocate(D1)
       deallocate(F2)
C
       call
     &sum2341(N0,N2,N1,N3,N0,N2,N0,N1,X5,S72, 1.0_dp)
       deallocate(S72)
C
       allocate(D1(N0+1:N2,N2+1:N3,N0+1:N2,N2+1:N3))
       call reorder3142(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N0,N2,N2,N3,VCHHPP,D1)
       allocate(B2(N0+1:N2,N2+1:N3))
       call reorder21(N2,N3,N0,N2,
     & N0,N2,N2,N3,t1B,B2)
       allocate(Q31(N0+1:N2,N2+1:N3))
       I1=K4*K2
       I3=K4*K2
       call EGEMM1(I1,I3,D1,B2,Q31)
       deallocate(D1)
       deallocate(B2)
C
       allocate(B1(N2+1:N3,N0+1:N2))
       call reorder21(N0,N2,N2,N3,
     & N2,N3,N0,N2,Q31,B1)
       allocate(S130(N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N2))
       I1=K2
       I2=K1*K2*K3
       I3=K4
       call EGEMM(I1,I2,I3,B1,t2B,S130)
       deallocate(B1)
C
       call
     &sum2341(N0,N2,N1,N3,N0,N2,N0,N1,X5,S130, 1.0_dp)
       deallocate(S130)
C
       X5=X5+VBHHPH
C
       allocate(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       call reorder3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,t2C,D2)
       allocate(Z5(N2+1:N3,N2+1:N3,N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K3
       I2=K2*K4*K4
       I3=K2
       call EGEMM(I1,I2,I3,X5,D2,Z5)
       deallocate(D2)
C
       forall(i=N0+1:N1,a=N1+1:N3)
         forall(j=N0+1:N2,k=N0+1:N2,k>j)
           forall(b=N2+1:N3,c=N2+1:N3,c>b)
             V3C(c,b,a,k,j,i)= V3C(c,b,a,k,j,i)
     &                    +Z5(c,b,k,a,j,i)
     &                    -Z5(c,b,j,a,k,i)
           endforall
         endforall
       endforall
       deallocate(Z5)
       deallocate(X5)
C
       allocate(B2(N0+1:N2,N2+1:N3))
       call reorder21(N2,N3,N0,N2,
     & N0,N2,N2,N3,t1B,B2)
       allocate(Q32(N2+1:N3,N2+1:N3))
       I1=K4
       I2=K4
       I3=K2
       call EGEMM(I1,I2,I3,Q31,B2,Q32)
       deallocate(B2)
C
       call
     &sum21(N2,N3,N2,N3,X11,Q32,-1.0_dp)
       deallocate(Q32)
C
       X11=X11+FBPP
C
       allocate(Z11(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1,N2+1:N3))
       I1=K4
       I2=K1*K2*K2*K3*K4
       I3=K4
       call EGEMM(I1,I2,I3,X11,t3C,Z11)
C
       forall(i=N0+1:N1,a=N1+1:N3)
         forall(j=N0+1:N2,k=N0+1:N2,k>j)
           forall(b=N2+1:N3,c=N2+1:N3,c>b)
             V3C(c,b,a,k,j,i)= V3C(c,b,a,k,j,i)
     &                    +Z11(b,a,k,j,i,c)
     &                    -Z11(c,a,k,j,i,b)
           endforall
         endforall
       endforall
       deallocate(Z11)
       deallocate(X11)
C
       allocate(B1(N2+1:N3,N0+1:N2))
       call reorder21(N0,N2,N2,N3,
     & N2,N3,N0,N2,Q31,B1)
       allocate(S133(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2
       I2=K2*K2*K4
       I3=K4
       call EGEMM(I1,I2,I3,B1,t2C,S133)
       deallocate(B1)
C
       call
     &sum2341(N0,N2,N2,N3,N0,N2,N0,N2,X3,S133,-1.0_dp)
       deallocate(S133)
C
       call
     &sum2134(N0,N2,N2,N3,N0,N2,N0,N2,X3,VCHHHP, 1.0_dp)
C
       allocate(D2(N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       call reorder3124(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N2,N3,N1,N3,N0,N1,t2B,D2)
       allocate(Z3(N2+1:N3,N1+1:N3,N0+1:N1,N2+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K4
       I2=K1*K3*K4
       I3=K2
       call EGEMM(I1,I2,I3,X3,D2,Z3)
       deallocate(D2)
C
       forall(i=N0+1:N1,a=N1+1:N3)
         forall(j=N0+1:N2,k=N0+1:N2,k>j)
           forall(b=N2+1:N3,c=N2+1:N3,c>b)
             V3C(c,b,a,k,j,i)= V3C(c,b,a,k,j,i)
     &                    -Z3(b,a,i,c,k,j)
     &                    +Z3(c,a,i,b,k,j)
           endforall
         endforall
       endforall
       deallocate(Z3)
       deallocate(X3)
C
       allocate(D1(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3))
       call reorder3421(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N0,N2,N2,N3,N2,N3,VCHHPP,D1)
       allocate(F2(N0+1:N2,N0+1:N2,N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N1))
       call reorder451236(N2,N3,N2,N3,N1,N3,N0,N2,N0,N2,N0,N1,
     & N0,N2,N0,N2,N2,N3,N2,N3,N1,N3,N0,N1,t3C,F2)
       allocate(S74(N2+1:N3,N1+1:N3,N0+1:N1,N2+1:N3))
       I1=K4
       I2=K1*K3*K4
       I3=K4*K2*K2
       call EGEMM(I1,I2,I3,D1,F2,S74)
       deallocate(D1)
       deallocate(F2)
C
       call
     &sum2341(N2,N3,N2,N3,N1,N3,N0,N1,X6,S74, 0.5_dp)
       deallocate(S74)
C
       call
     &sum2314(N2,N3,N2,N3,N1,N3,N0,N1,X6,VBHPPP, 1.0_dp)
C
       allocate(Z6(N2+1:N3,N0+1:N2,N0+1:N2,N2+1:N3,N1+1:N3,N0+1:N1))
       I1=K1*K3*K4
       I2=K2*K2*K4
       I3=K4
       call EGEMM(I1,I2,I3,X6,t2C,Z6)
C
       forall(i=N0+1:N1,a=N1+1:N3)
         forall(j=N0+1:N2,k=N0+1:N2,k>j)
           forall(b=N2+1:N3,c=N2+1:N3,c>b)
             V3C(c,b,a,k,j,i)= V3C(c,b,a,k,j,i)
     &                    +Z6(b,k,j,c,a,i)
     &                    -Z6(c,k,j,b,a,i)
           endforall
         endforall
       endforall
       deallocate(Z6)
       deallocate(X6)
C
       allocate(D1(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       call reorder3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,VBHHPP,D1)
       allocate(F2(N0+1:N2,N0+1:N1,N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2))
       call reorder461235(N2,N3,N2,N3,N1,N3,N0,N2,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N2,N3,N1,N3,N0,N2,t3C,F2)
       allocate(S59(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3))
       I1=K3
       I2=K2*K3*K4
       I3=K4*K1*K2
       call EGEMM(I1,I2,I3,D1,F2,S59)
       deallocate(D1)
       deallocate(F2)
C
       call
     &sum2341(N1,N3,N2,N3,N1,N3,N0,N2,X2,S59,-1.0_dp)
       deallocate(S59)
C
       call
     &sum2341(N1,N3,N2,N3,N1,N3,N0,N2,X2,VBPHPP, 1.0_dp)
C
       allocate(D2(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       call reorder2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,t2B,D2)
       allocate(Z2(N2+1:N3,N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       I1=K2*K3*K4
       I2=K1*K2*K4
       I3=K3
       call EGEMM(I1,I2,I3,X2,D2,Z2)
       deallocate(D2)
C
       forall(i=N0+1:N1,a=N1+1:N3)
         forall(j=N0+1:N2,k=N0+1:N2,k>j)
           forall(b=N2+1:N3,c=N2+1:N3,c>b)
             V3C(c,b,a,k,j,i)= V3C(c,b,a,k,j,i)
     &                    -Z2(b,k,i,c,a,j)
     &                    +Z2(c,k,i,b,a,j)
     &                    +Z2(b,j,i,c,a,k)
     &                    -Z2(c,j,i,b,a,k)
           endforall
         endforall
       endforall
       deallocate(Z2)
       deallocate(X2)
C
       allocate(D1(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1))
       call reorder3412(N0,N2,N0,N1,N0,N2,N0,N1,
     & N0,N2,N0,N1,N0,N2,N0,N1,VBHHHH,D1)
       allocate(B2(N0+1:N2,N2+1:N3))
       call reorder21(N2,N3,N0,N2,
     & N0,N2,N2,N3,t1B,B2)
       allocate(S13(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1))
       I1=K1*K2*K1
       I2=K4
       I3=K2
       call EGEMM(I1,I2,I3,D1,B2,S13)
       deallocate(D1)
       deallocate(B2)
C
       call
     &sum2134(N0,N1,N2,N3,N0,N2,N0,N1,X1,S13,-1.0_dp)
       deallocate(S13)
C
       allocate(D2(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       call reorder2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,t2B,D2)
       allocate(S33(N2+1:N3,N0+1:N2,N0+1:N1,N0+1:N1))
       I1=K1
       I2=K1*K2*K4
       I3=K3
       call EGEMM(I1,I2,I3,FAHP,D2,S33)
       deallocate(D2)
C
       call
     &sum2341(N0,N1,N2,N3,N0,N2,N0,N1,X1,S33, 1.0_dp)
       deallocate(S33)
C
       call
     &sum2134(N0,N1,N2,N3,N0,N2,N0,N1,X1,VBHHHP, 1.0_dp)
C
       allocate(D2(N0+1:N1,N2+1:N3,N1+1:N3,N0+1:N2))
       call reorder4123(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N1,N2,N3,N1,N3,N0,N2,t2B,D2)
       allocate(Z1(N2+1:N3,N1+1:N3,N0+1:N2,N2+1:N3,N0+1:N2,N0+1:N1))
       I1=K1*K2*K4
       I2=K2*K3*K4
       I3=K1
       call EGEMM(I1,I2,I3,X1,D2,Z1)
       deallocate(D2)
C
       forall(i=N0+1:N1,a=N1+1:N3)
         forall(j=N0+1:N2,k=N0+1:N2,k>j)
           forall(b=N2+1:N3,c=N2+1:N3,c>b)
             V3C(c,b,a,k,j,i)= V3C(c,b,a,k,j,i)
     &                    +Z1(b,a,k,c,j,i)
     &                    -Z1(c,a,k,b,j,i)
     &                    -Z1(b,a,j,c,k,i)
     &                    +Z1(c,a,j,b,k,i)
           endforall
         endforall
       endforall
       deallocate(Z1)
       deallocate(X1)
C
       end
C
       subroutine t3C_update(N0,N1,N2,N3,shift,
     & K3,K4,NFT848,
     & FAHH,FAPP,FBHH,FBPP,
     & t1A,t1B,t2B,t2C,t3C,V3C)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       integer a,b,c,e,f,g,h,i,j,k,m,n,o,p
       real*8 CoeLeft,shift,PP
       real*8 FAHH(N0+1:N1,N0+1:N1)
       real*8 FAPP(N1+1:N3,N1+1:N3)
       real*8 FBHH(N0+1:N2,N0+1:N2)
       real*8 FBPP(N2+1:N3,N2+1:N3)
       real*8 t1A(N1+1:N3,N0+1:N1)
       real*8 t1B(N2+1:N3,N0+1:N2)
       real*8 t2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 t2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 t3C(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1)
       real*8 V3C(N2+1:N3,N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1)
C
       real*8,allocatable::VPPP(:,:,:),C2(:,:,:)
       real*8,allocatable::tt3C(:,:,:,:)
       real*8,allocatable::U(:,:,:)
C
       N3C=0
       do i=N0+1,N1;do j=N0+1,N2-1;do k=j+1,N2
        N3C=N3C+1
       enddo;enddo;enddo
       allocate(tt3C(N2+1:N3,N2+1:N3,N1+1:N3,N3C))
       tt3C=0.0d0
       I3C=0
       do i=N0+1,N1;do j=N0+1,N2-1;do k=j+1,N2
        I3C=I3C+1
        do a=N1+1,N3;do e=N2+1,N3;do f=N2+1,N3
         tt3C(f,e,a,I3C)=0.5d0*t3C(f,e,a,k,j,i)
     &                  -t1B(f,j)*t2B(e,a,k,i)
     &                  +t1B(f,k)*t2B(e,a,j,i)
        enddo;enddo;enddo
       enddo;enddo;enddo
C
       allocate(VPPP(N2+1:N3,N2+1:N3,N2+1:N3),
     &          source=0.0d0)
       IBC=0
       do b=N2+1,N3-1
        read(NFT848,rec=b-N2+K3)VPPP
        allocate(C2(N2+1:N3,N2+1:N3,b+1:N3))
        do c=b+1,N3;do e=N2+1,N3;do f=N2+1,N3
         C2(f,e,c)=VPPP(f,e,c)
        enddo;enddo;enddo
C
        allocate(U(b+1:N3,N1+1:N3,N3C))
        I1=N3C*K3
        I2=N3-b
        I3=K4*K4
        call EGEMM(I1,I2,I3,tt3C,C2,U)
        I3C=0
        do i=N0+1,N1;do j=N0+1,N2-1;do k=j+1,N2
         I3C=I3C+1
         do a=N1+1,N3;do c=b+1,N3
          V3C(c,b,a,k,j,i)=V3C(c,b,a,k,j,i)+U(c,a,I3C)
         enddo;enddo
        enddo;enddo;enddo
        deallocate(C2,U)
       enddo
       deallocate(tt3C,VPPP)
C
       allocate(tt3C(N2+1:N3,N1+1:N3,N2+1:N3,N3C))
       tt3C=0.0d0
       I3C=0
       do i=N0+1,N1;do j=N0+1,N2-1;do k=j+1,N2
        I3C=I3C+1
        do c=N2+1,N3;do e=N1+1,N3;do f=N2+1,N3
         tt3C(f,e,c,I3C)=t3C(f,c,e,k,j,i)
     &                  +t1A(e,i)*t2C(f,c,k,j)
     &                  -t1B(f,j)*t2B(c,e,k,i)
     &                  +t1B(f,k)*t2B(c,e,j,i)
        enddo;enddo;enddo
       enddo;enddo;enddo
C
       I1=N3C*K4
       I2=K3
       I3=K3*K4
       allocate(VPPP(N2+1:N3,N1+1:N3,N1+1:N3),
     &          source=0.0d0)
       allocate(U(N1+1:N3,N2+1:N3,N3C))
       do c=N2+1,N3
        read(NFT848,rec=c-N2+K3+K4)
     &  (((VPPP(f,e,a),e=N1+1,N3),f=N2+1,N3),a=N1+1,N3)
C
        call EGEMM(I1,I2,I3,tt3C,VPPP,U)
        I3C=0
        do i=N0+1,N1;do j=N0+1,N2-1;do k=j+1,N2
         I3C=I3C+1
         do a=N1+1,N3;do b=N2+1,N3
          V3C(c,b,a,k,j,i)=V3C(c,b,a,k,j,i)+U(a,b,I3C)
          V3C(b,c,a,k,j,i)=V3C(b,c,a,k,j,i)-U(a,b,I3C)
         enddo;enddo
        enddo;enddo;enddo
       enddo
       deallocate(tt3C,VPPP,U)
C
       do i=N0+1,N1;do j=N0+1,N2-1;do k=j+1,N2
       do a=N1+1,N3;do b=N2+1,N3-1;do c=b+1,N3
        CoeLeft=FBPP(c,c)+FBPP(b,b)+FAPP(a,a)
     &         -FBHH(k,k)-FBHH(j,j)-FAHH(i,i)
     &         +shift
        t3C(c,b,a,k,j,i)= t3C(c,b,a,k,j,i)-V3C(c,b,a,k,j,i)/CoeLeft
        t3C(c,b,a,j,k,i)=-t3C(c,b,a,k,j,i)
        t3C(b,c,a,k,j,i)=-t3C(c,b,a,k,j,i)
        t3C(b,c,a,j,k,i)= t3C(c,b,a,k,j,i)
       enddo;enddo;enddo
       enddo;enddo;enddo
C
       end
