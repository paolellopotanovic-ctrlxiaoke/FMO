       subroutine eomdip3hr2C4D(N0,N1,N2,N3,V2C4D,
     & K1,K2,K3,K4,
     & VAHHPP,VBHHPP,VCHHPP,
     & HAHH,HAHP,HAPP,HBHH,HBHP,HBPP,
     & HAHHHH,HAHHHP,HAHPHH,HAHPHP,HAHPPP,HAPPHP,
     & HBHHHH,HBHHHP,HBHHPH,HBHPHH,HBPHHH,HBHPHP,HBHPPH,
     & HBPHHP,HBPHPH,HBHPPP,HBPHPP,HBPPHP,HBPPPH,
     & HCHHHH,HCHHHP,HCHPHH,HCHPHP,HCHPPP,HCPPHP,
     & t1A,t1B,t2A,t2B,t2C,
     & r0A2B,r1A3B,r1B3C,r2A4B,r2B4C,r2C4D)
       use ccsd3a_reorder_mod
       use ccsd3a_sum_mod
       use prec, only: dp
C
       real*8 VAHHPP(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 VBHHPP(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 VCHHPP(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 HAHH(N0+1:N1,N0+1:N1)
       real*8 HAHP(N1+1:N3,N0+1:N1)
       real*8 HAPP(N1+1:N3,N1+1:N3)
       real*8 HBHH(N0+1:N2,N0+1:N2)
       real*8 HBHP(N2+1:N3,N0+1:N2)
       real*8 HBPP(N2+1:N3,N2+1:N3)
       real*8 HAHHHH(N0+1:N1,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHHHP(N1+1:N3,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8 HAHPHH(N0+1:N1,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPHP(N1+1:N3,N0+1:N1,N1+1:N3,N0+1:N1)
       real*8 HAHPPP(N1+1:N3,N1+1:N3,N1+1:N3,N0+1:N1)
       real*8 HAPPHP(N1+1:N3,N0+1:N1,N1+1:N3,N1+1:N3)
       real*8 HBHHHH(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHHHP(N2+1:N3,N0+1:N1,N0+1:N2,N0+1:N1)
       real*8 HBHPHH(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHHPH(N0+1:N2,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 HBPHHH(N0+1:N2,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBHPHP(N2+1:N3,N0+1:N1,N2+1:N3,N0+1:N1)
       real*8 HBHPPH(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPHHP(N2+1:N3,N0+1:N1,N0+1:N2,N1+1:N3)
       real*8 HBPHPH(N0+1:N2,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBHPPP(N2+1:N3,N1+1:N3,N2+1:N3,N0+1:N1)
       real*8 HBPPHP(N2+1:N3,N0+1:N1,N2+1:N3,N1+1:N3)
       real*8 HBPHPP(N2+1:N3,N1+1:N3,N0+1:N2,N1+1:N3)
       real*8 HBPPPH(N0+1:N2,N1+1:N3,N2+1:N3,N1+1:N3)
       real*8 HCHHHH(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHHHP(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2)
       real*8 HCHPHH(N0+1:N2,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPHP(N2+1:N3,N0+1:N2,N2+1:N3,N0+1:N2)
       real*8 HCHPPP(N2+1:N3,N2+1:N3,N2+1:N3,N0+1:N2)
       real*8 HCPPHP(N2+1:N3,N0+1:N2,N2+1:N3,N2+1:N3)
       real*8 t1A(N1+1:N3,N0+1:N1)
       real*8 t1B(N2+1:N3,N0+1:N2)
       real*8 t2A(N1+1:N3,N1+1:N3,N0+1:N1,N0+1:N1)
       real*8 t2B(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N1)
       real*8 t2C(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2)
       real*8 r0A2B(N0+1:N2,N0+1:N1)
       real*8 r1A3B(N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1)
       real*8 r1B3C(N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N1)
       real*8
     & r2A4B(N1+1:N3,N1+1:N3,N0+1:N2,N0+1:N1,N0+1:N1,N0+1:N1)
       real*8
     & r2B4C(N2+1:N3,N1+1:N3,N0+1:N2,N0+1:N2,N0+1:N1,N0+1:N1)
       real*8
     & r2C4D(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1)
       real*8
     & V2C4D(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1)
C
       real*8,allocatable::B1(:,:)
       real*8,allocatable::B2(:,:)
       real*8,allocatable::C1(:,:,:)
       real*8,allocatable::C2(:,:,:)
       real*8,allocatable::D1(:,:,:,:)
       real*8,allocatable::D2(:,:,:,:)
       real*8,allocatable::F2(:,:,:,:,:,:)
C
       real*8,allocatable::S1(:,:,:,:)
       real*8,allocatable::S2(:,:,:,:)
       real*8,allocatable::S3(:,:,:,:)
       real*8,allocatable::S4(:,:,:,:)
       real*8,allocatable::S5(:,:,:,:)
       real*8,allocatable::Q1(:,:)
       real*8,allocatable::S6(:,:,:,:)
       real*8,allocatable::S7(:,:,:,:)
       real*8,allocatable::S8(:,:,:,:)
       real*8,allocatable::S9(:,:,:,:)
       real*8,allocatable::S10(:,:,:,:)
       real*8,allocatable::S11(:,:,:,:)
       real*8,allocatable::S12(:,:,:,:)
       real*8,allocatable::S13(:,:,:,:)
       real*8,allocatable::S14(:,:,:,:)
       real*8,allocatable::S15(:,:,:,:)
       real*8,allocatable::S16(:,:,:,:)
       real*8,allocatable::S17(:,:,:,:)
       real*8,allocatable::S18(:,:,:,:)
       real*8,allocatable::S19(:,:,:,:)
       real*8,allocatable::S20(:,:,:,:)
       real*8,allocatable::S21(:,:,:,:)
       real*8,allocatable::X1(:,:,:,:)
       real*8,allocatable::U1(:,:,:,:,:,:)
       real*8,allocatable::X2(:,:,:,:)
       real*8,allocatable::U2(:,:,:,:,:,:)
       real*8,allocatable::X3(:,:,:,:)
       real*8,allocatable::U3(:,:,:,:,:,:)
       real*8,allocatable::U4(:,:,:,:,:,:)
       real*8,allocatable::X4(:,:,:,:)
       real*8,allocatable::U5(:,:,:,:,:,:)
       real*8,allocatable::U9(:,:,:,:,:,:)
       real*8,allocatable::U10(:,:,:,:,:,:)
       real*8,allocatable::U11(:,:,:,:,:,:)
       real*8,allocatable::X5(:,:,:,:)
       real*8,allocatable::U14(:,:,:,:,:,:)
       real*8,allocatable::X6(:,:,:,:)
       real*8,allocatable::U15(:,:,:,:,:,:)
       real*8,allocatable::U19(:,:,:,:,:,:)
       real*8,allocatable::U23(:,:,:,:,:,:)
       real*8,allocatable::U24(:,:,:,:,:,:)
       real*8,allocatable::U25(:,:,:,:,:,:)
       real*8,allocatable::U26(:,:,:,:,:,:)
       real*8,allocatable::U27(:,:,:,:,:,:)
       real*8,allocatable::U28(:,:,:,:,:,:)
       real*8,allocatable::U29(:,:,:,:,:,:)
C
       allocate(D1(N0+1:N1,N1+1:N3,N2+1:N3,N0+1:N2))
       call reorder4231(N0,N2,N1,N3,N2,N3,N0,N1,
     & N0,N1,N1,N3,N2,N3,N0,N2,HBHPPH,D1)
       allocate(B2(N0+1:N1,N0+1:N2))
       call reorder21(N0,N2,N0,N1,
     & N0,N1,N0,N2,r0A2B,B2)
       allocate(S1(N0+1:N2,N1+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K3
       I2=K2
       I3=K1
       call EGEMM(I1,I2,I3,D1,B2,S1)
       deallocate(D1)
       deallocate(B2)
C
       allocate(X1(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N2),
     &          source=0.0d0)
       call
     &sum3124(N1,N3,N2,N3,N0,N2,N0,N2,X1,S1, 1.0_dp)
       deallocate(S1)
C
       allocate(D1(N0+1:N1,N0+1:N2,N0+1:N2,N0+1:N1))
       call reorder4312(N0,N2,N0,N1,N0,N2,N0,N1,
     & N0,N1,N0,N2,N0,N2,N0,N1,HBHHHH,D1)
       allocate(B2(N0+1:N1,N0+1:N2))
       call reorder21(N0,N2,N0,N1,
     & N0,N1,N0,N2,r0A2B,B2)
       allocate(S2(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1))
       I1=K1*K2*K2
       I2=K2
       I3=K1
       call EGEMM(I1,I2,I3,D1,B2,S2)
       deallocate(D1)
       deallocate(B2)
C
       allocate(X2(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1),
     &          source=0.0d0)
       call
     &sum2134(N0,N2,N0,N2,N0,N2,N0,N1,X2,S2, 1.0_dp)
       deallocate(S2)
C
       allocate(D1(N0+1:N1,N2+1:N3,N2+1:N3,N0+1:N1))
       call reorder4132(N2,N3,N0,N1,N2,N3,N0,N1,
     & N0,N1,N2,N3,N2,N3,N0,N1,HBHPHP,D1)
       allocate(B2(N0+1:N1,N0+1:N2))
       call reorder21(N0,N2,N0,N1,
     & N0,N1,N0,N2,r0A2B,B2)
       allocate(S3(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N1))
       I1=K1*K4*K4
       I2=K2
       I3=K1
       call EGEMM(I1,I2,I3,D1,B2,S3)
       deallocate(D1)
       deallocate(B2)
C
       allocate(X3(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N1),
     &          source=0.0d0)
       call
     &sum3124(N2,N3,N2,N3,N0,N2,N0,N1,X3,S3, 1.0_dp)
       deallocate(S3)
C
       allocate(D1(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N2))
       call reorder3412(N0,N2,N0,N2,N0,N2,N0,N2,
     & N0,N2,N0,N2,N0,N2,N0,N2,HCHHHH,D1)
       allocate(B2(N0+1:N2,N0+1:N1))
       call reorder12(N0,N2,N0,N1,
     & N0,N2,N0,N1,r0A2B,B2)
       allocate(S4(N0+1:N1,N0+1:N2,N0+1:N2,N0+1:N2))
       I1=K2*K2*K2
       I2=K1
       I3=K2
       call EGEMM(I1,I2,I3,D1,B2,S4)
       deallocate(D1)
       deallocate(B2)
C
       allocate(D1(N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1))
       call reorder2341(N0,N1,N0,N2,N0,N2,N0,N2,
     & N0,N2,N0,N2,N0,N2,N0,N1,S4,D1)
       allocate(D2(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       call reorder3124(N2,N3,N2,N3,N0,N2,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,t2C,D2)
       allocate(U4(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N2,N0+1:N2,N0+1:N1))
       I1=K1*K2*K2
       I2=K2*K4*K4
       I3=K2
       call EGEMM(I1,I2,I3,D1,D2,U4)
       deallocate(D1)
       deallocate(D2)
C
       V2C4D=V2C4D+U4
       call
     &sum124356(N2,N3,N2,N3,N0,N2,N0,N2,N0,N2,N0,N1,V2C4D,U4,-1.0_dp)
       call
     &sum125346(N2,N3,N2,N3,N0,N2,N0,N2,N0,N2,N0,N1,V2C4D,U4, 1.0_dp)
       deallocate(U4)
       deallocate(S4)
C
       allocate(D1(N0+1:N2,N2+1:N3,N2+1:N3,N0+1:N2))
       call reorder4132(N2,N3,N0,N2,N2,N3,N0,N2,
     & N0,N2,N2,N3,N2,N3,N0,N2,HCHPHP,D1)
       allocate(B2(N0+1:N2,N0+1:N1))
       call reorder12(N0,N2,N0,N1,
     & N0,N2,N0,N1,r0A2B,B2)
       allocate(S5(N0+1:N1,N2+1:N3,N2+1:N3,N0+1:N2))
       I1=K2*K4*K4
       I2=K1
       I3=K2
       call EGEMM(I1,I2,I3,D1,B2,S5)
       deallocate(D1)
       deallocate(B2)
C
       allocate(X4(N2+1:N3,N2+1:N3,N0+1:N2,N0+1:N1),
     &          source=0.0d0)
       call
     &sum4123(N2,N3,N2,N3,N0,N2,N0,N1,X4,S5, 1.0_dp)
       deallocate(S5)
C
       allocate(D1(N0+1:N2,N0+1:N1,N2+1:N3,N1+1:N3))
       call reorder3412(N2,N3,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N1,N3,VBHHPP,D1)
       allocate(B2(N0+1:N2,N0+1:N1))
       call reorder12(N0,N2,N0,N1,
     & N0,N2,N0,N1,r0A2B,B2)
       allocate(Q1(N2+1:N3,N1+1:N3))
       I1=K3*K4
       I3=K1*K2
       call EGEMM1(I1,I3,D1,B2,Q1)
       deallocate(D1)
       deallocate(B2)
C
       allocate(B1(N1+1:N3,N2+1:N3))
       call reorder21(N2,N3,N1,N3,
     & N1,N3,N2,N3,Q1,B1)
       allocate(D2(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       call reorder2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,t2B,D2)
       allocate(S6(N2+1:N3,N0+1:N2,N0+1:N1,N2+1:N3))
       I1=K4
       I2=K1*K2*K4
       I3=K3
       call EGEMM(I1,I2,I3,B1,D2,S6)
       deallocate(B1)
       deallocate(D2)
C
       call
     &sum2341(N2,N3,N2,N3,N0,N2,N0,N1,X4,S6, 1.0_dp)
       deallocate(S6)
C
       allocate(D1(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N2))
       call reorder4231(N0,N2,N1,N3,N0,N2,N0,N1,
     & N0,N1,N1,N3,N0,N2,N0,N2,HBHHPH,D1)
       allocate(D2(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N1))
       call reorder3124(N1,N3,N0,N2,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N2,N0,N1,r1A3B,D2)
       allocate(S7(N0+1:N2,N0+1:N1,N0+1:N2,N0+1:N2))
       I1=K2*K2
       I2=K1*K2
       I3=K3*K1
       call EGEMM(I1,I2,I3,D1,D2,S7)
       deallocate(D1)
       deallocate(D2)
C
       call
     &sum2413(N0,N2,N0,N2,N0,N2,N0,N1,X2,S7, 1.0_dp)
       deallocate(S7)
C
       allocate(D1(N0+1:N1,N1+1:N3,N2+1:N3,N2+1:N3))
       call reorder4213(N2,N3,N1,N3,N2,N3,N0,N1,
     & N0,N1,N1,N3,N2,N3,N2,N3,HBHPPP,D1)
       allocate(D2(N0+1:N1,N1+1:N3,N0+1:N2,N0+1:N1))
       call reorder3124(N1,N3,N0,N2,N0,N1,N0,N1,
     & N0,N1,N1,N3,N0,N2,N0,N1,r1A3B,D2)
       allocate(S8(N0+1:N2,N0+1:N1,N2+1:N3,N2+1:N3))
       I1=K4*K4
       I2=K1*K2
       I3=K3*K1
       call EGEMM(I1,I2,I3,D1,D2,S8)
       deallocate(D1)
       deallocate(D2)
C
       call
     &sum3412(N2,N3,N2,N3,N0,N2,N0,N1,X3,S8, 1.0_dp)
       deallocate(S8)
C
       allocate(D1(N0+1:N2,N0+1:N1,N1+1:N3,N0+1:N2))
       call reorder3421(N0,N2,N1,N3,N0,N2,N0,N1,
     & N0,N2,N0,N1,N1,N3,N0,N2,HBHHPH,D1)
       allocate(D2(N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N2))
       call reorder2413(N2,N3,N0,N2,N0,N2,N0,N1,
     & N0,N2,N0,N1,N2,N3,N0,N2,r1B3C,D2)
       allocate(S9(N2+1:N3,N0+1:N2,N1+1:N3,N0+1:N2))
       I1=K2*K3
       I2=K2*K4
       I3=K1*K2
       call EGEMM(I1,I2,I3,D1,D2,S9)
       deallocate(D1)
       deallocate(D2)
C
       call
     &sum2314(N1,N3,N2,N3,N0,N2,N0,N2,X1,S9,-1.0_dp)
       deallocate(S9)
C
       allocate(D2(N1+1:N3,N2+1:N3,N0+1:N2,N0+1:N1))
       call reorder2134(N2,N3,N1,N3,N0,N2,N0,N1,
     & N1,N3,N2,N3,N0,N2,N0,N1,t2B,D2)
       allocate(U1(N2+1:N3,N0+1:N2,N0+1:N1,N2+1:N3,N0+1:N2,N0+1:N2))
       I1=K2*K2*K4
       I2=K1*K2*K4
       I3=K3
       call EGEMM(I1,I2,I3,X1,D2,U1)
       deallocate(D2)
C
       call
     &sum246135(N2,N3,N2,N3,N0,N2,N0,N2,N0,N2,N0,N1,V2C4D,U1, 1.0_dp)
       call
     &sum146235(N2,N3,N2,N3,N0,N2,N0,N2,N0,N2,N0,N1,V2C4D,U1,-1.0_dp)
       call
     &sum256134(N2,N3,N2,N3,N0,N2,N0,N2,N0,N2,N0,N1,V2C4D,U1,-1.0_dp)
       call
     &sum156234(N2,N3,N2,N3,N0,N2,N0,N2,N0,N2,N0,N1,V2C4D,U1, 1.0_dp)
       call
     &sum236145(N2,N3,N2,N3,N0,N2,N0,N2,N0,N2,N0,N1,V2C4D,U1,-1.0_dp)
       call
