#!/bin/{{shell}}
#
# Version 6 of install.info template :  : Sarom Leang : sarom.leang@epanalytics.com
#
# This file is used by:
# - Continous-Integration methods (Travis-CI and Jenkins)
# - Container deployment (Dockers, NVIDIA-Dockers, and Singularity)
#
# This file was automatically generated by the following command:
#
# {{cmdline}}

setenv GMS_VERSION                 {{version}}

#      GAMESS Paths
setenv GMS_PATH                    {{path}}
setenv GMS_BUILD_DIR               {{build_path}}

#      Machine Type
setenv GMS_TARGET                  {{target}}
setenv GMS_HPC_SYSTEM_TARGET       {{system_target}}
setenv GMS_ARCH                    `uname -p`
#      FORTRAN Compiler Setup
setenv GMS_FORTRAN                 {{fortran}}
{% if system_target == "summit" -%}
#      IBM XLF Compiler Setup
setenv GMS_XL_PATH                 {{xl_path}}
{% endif -%}
{% if fortran == "gfortran" -%}
#      GNU Fortran Compiler Setup
setenv GMS_GFORTRAN_VERNO          {{gfortran_verno}}
{% endif -%}
{% if fortran == "ifort" or fortran == "oneapi-ifort" or fortran == "oneapi-ifx" -%}
#      Intel Compiler Setup
setenv GMS_IFORT_VERNO             {{ifort_verno}}
  {% if target == "win64" -%}
setenv GMS_INT_OPT                 {{intel_optimization_flags}}
setenv GMS_IPO_OPT                 {{intel_ipo_flags}}
  {% endif -%}
{% endif -%}
{% if fortran == "pgfortran" -%}
#      PGFORTRAN Compiler Setup
setenv GMS_PGI_OPT                 {{pgi_optimization_flags}}
setenv GMS_IPA_OPT                 {{pgi_ipa_flags}}
setenv GMS_L64_OPT                 {{linux64_optimization_flags}}
  {% if mathlib == "mkl" -%}
setenv GMS_LIN_FLAGS               "-ldl"
  {% else -%}
setenv GMS_LIN_FLAGS               {{linux64_compiler_flags}}
  {% endif -%}
{% endif -%}
{% if fortran == "xlf" -%}
{% if system_target != "summit" -%}
#      IBM XLF Compiler Setup
setenv GMS_XL_PATH                 {{xlf_path}}
{% endif -%}
{% endif -%}
{% if target == "win64" -%}
#      Windows Compiler Setup
setenv GMS_WIN_OPT                 {{windows_optimization_flags}}
setenv GMS_WIN_FLAGS               {{windows_compiler_flags}}
setenv GMS_WIN_TP                  {{windows_target_platform_flags}}
{% endif %}
#      Mathematical Library Setup
setenv GMS_MATHLIB                 {{mathlib}}
setenv GMS_MATHLIB_PATH            {{mathlib_path}}
{% if mathlib == "aocl" -%}
setenv GMS_AMD_FLAME_PATH          {{libflame_path}}
{% endif -%}
setenv GMS_MATHLIB_INCLUDE_PATH    {{mathlib_include_path}}
setenv GMS_MKL_VERNO               {{mkl_verno}}
setenv GMS_THREADED_BLAS           {{threaded_blas}}
setenv GMS_LAPACK_LINK_LINE        {{lapack_link_line}}
{% if mathlib == "libflame" -%}
setenv GMS_AMD_BLIS_PATH           {{mathlib_path}}
{% endif -%}
#      Parallel Message Passing Model Setup
setenv GMS_DDI_COMM                {{ddi_comm}}
{% if ddi_comm == "mpi" -%}
setenv GMS_MPI_LIB                 {{mpi_lib}}
{% if "hpe-cray" not in target -%}
setenv GMS_MPI_PATH                {{mpi_path}}
{% endif -%}
{% if mpi_version != "None" -%}
{% if "mvapich" in mpi_lib -%}
setenv GMS_MPI_SOFTWARE_VERNO      {{mpi_version}}
{% endif -%}
{% endif -%}
{% endif %}
#      LIBCCHEM CPU/GPU Code Interface
setenv GMS_LIBCCHEM                {{libcchem}}
setenv GMS_LIBCCHEM_GPU_SUPPORT    {{libcchem_gpu_support}}
setenv GMS_LIBCCHEM_LIBS           {{'"' + libcchem_libs + ' -lrt' + '"'}}
setenv GMS_HDF5_PATH               {{hdf5_path}}
setenv GMS_CUDA_BOARD              {{cuda_board}}
setenv GMS_CUDA_PATH               {{cuda_path}}
setenv GMS_EIGEN_PATH              {{eigen_path}}
setenv GMS_BOOST_PATH              {{boost_path}}
setenv GMS_GA_PATH                 {{ga_path}}

setenv GMS_HPCCHEM                  {{libcchem2}}
setenv GMS_HPCCHEM_USE_DATA_SERVERS {{libcchem2_use_data_servers}}
setenv GMS_HPCCHEM_CUDA             {{libcchem2_use_cuda}}
setenv GMS_HPCCHEM_MAGMA            {{libcchem2_magma_support}}
setenv GMS_HPCCHEM_PATH             {{libcchem2_path}}
setenv GMS_HPC_ROCM_PATH            {{rocm_path}}
setenv GMS_HPC_MAGMA_PATH           {{magma_path}}
setenv GMS_HPC_CUDA_PATH            {{cuda_path}}

#      Intel Xeon Phi Build: none/knc/knl
setenv GMS_PHI                     {{phi}}

#      Shared Memory Type: sysv/posix
setenv GMS_SHMTYPE                 {{shmtype}}

#      OpenMP Support: true/false
setenv GMS_OPENMP                  {{openmp}}
#      OpenMP Offload Support: true/false
setenv GMS_OPENMP_OFFLOAD          {{openmp_offload}}
setenv GMS_USE_HIPFORT             {{hipfort}}
{% if hipfort == "true" -%}
{% if "/" in hipfort_path -%}
setenv HIPFORT_HOME                {{hipfort_path}}
{% else -%}
setenv HIPFORT_HOME                /define/path/to/hipfort/home
{% endif -%}
{% endif -%}
setenv USE_CUBLAS                  {{cublas}}
{% if openmp_offload == "true" and cublas == "true" -%}
setenv NVCOMPILER_ACC_POOL_SIZE    0
{% endif -%}
setenv USE_HIPBLAS                 {{hipblas}}
{% if openmp_offload == "true" and "hpe" in target -%}
setenv CRAY_ACC_REUSE_MEM_LIMIT    0
{% endif -%}

#      GAMESS LibXC library: true/false
setenv GMS_LIBXC                   {{libxc}}

#      GAMESS MDI library: true/false
setenv GMS_MDI                     {{mdi}}

#      Build Michigan State University Coupled Cluster: true/false
setenv GMS_MSUAUTO                 {{msucc}}

#      VM2 library: true/false
{% if verachem == "true" -%}
setenv GMS_VM2                    true
setenv VM2LIB                     {{vm2_path}}
{% else -%}
setenv GMS_VM2                    false
{% endif %}
#       Tinker: true/false
setenv  TINKER                    {{tinker}}

#       VB2000: true/false
setenv  VB2000                    {{vb2000}}

#       XMVB: true/false
setenv  XMVB                      {{xmvb}}

#       NEO: true/false
setenv  NEO                       {{neo}}

#       NBO: true/false
setenv  NBO                       {{nbo}}
{% if nbo == "true" -%}
setenv  NBOLIB                    {{nbolib_path}}
{% endif %}
#       RISM: true/false
setenv  RISM                      {{rism}}

################################################
# Add any additional environmental variables   #
# or module loads below if needed.             #
################################################

# Capture floating-point exceptions
setenv GMS_FPE_FLAGS              "{{fpe}}"

{% if openmp == "true" or libcchem == "true" -%}
#      OpenMP / LIBCCHEM Options
{% if system_target == "summit" -%}
if (! $?OMP_NUM_THREADS ) setenv OMP_NUM_THREADS 7
{% elif system_target == "frontier" or system_target == "crusher" -%}
if (! $?OMP_NUM_THREADS ) setenv OMP_NUM_THREADS 6
{% elif system_target == "aurora" or system_target == "sunspot" or system_target == "grace-hopper" -%}
if (! $?OMP_NUM_THREADS ) setenv OMP_NUM_THREADS 8
{% elif system_target == "perlmutter" -%}
if (! $?OMP_NUM_THREADS ) setenv OMP_NUM_THREADS 16
{% elif system_target == "polaris" -%}
if (! $?OMP_NUM_THREADS ) setenv OMP_NUM_THREADS 8
{% else -%}
if (! $?OMP_NUM_THREADS ) setenv OMP_NUM_THREADS {{omp_num_threads}}
{% endif -%}
if (! $?OMP_STACKSIZE ) setenv OMP_STACKSIZE   {{omp_stacksize}}
{% endif -%}

{% if libcchem == "true" -%}
#      LIBCCHEM Options
{% if libcchem_gpu_support == "true" -%}
{% if libcchem_ahfock_off == "true" -%}
setenv GMS_CCHEM_AHFOCK           false
{% if libcchem_hf_off == "true" -%}
setenv GMS_CCHEM_HF               false
{% else -%}
setenv GMS_CCHEM_HF               true
{% endif -%}
{% if libcchem_mp2_off == "true" -%}
setenv GMS_CCHEM_MP2              false
{% else -%}
setenv GMS_CCHEM_MP2              true
{% endif -%}
{% if libcchem_ri_off == "true" -%}
setenv GMS_CCHEM_RI               false
{% else -%}
setenv GMS_CCHEM_RI               true
{% endif -%}
{% if libcchem_cc_off == "true" -%}
setenv GMS_CCHEM_CC               false
{% else -%}
setenv GMS_CCHEM_CC               true
{% endif -%}
{% else -%}
setenv GMS_CCHEM_AHFOCK           true
setenv GMS_CCHEM_HF               false
setenv GMS_CCHEM_MP2              false
setenv GMS_CCHEM_RI               false
setenv GMS_CCHEM_CC               false
{% endif -%}
{% else -%}
setenv GMS_CCHEM_AHFOCK           false
{% if libcchem_hf_off == "true" -%}
setenv GMS_CCHEM_HF               false
{% else -%}
setenv GMS_CCHEM_HF               true
{% endif -%}
{% if libcchem_mp2_off == "true" -%}
setenv GMS_CCHEM_MP2              false
{% else -%}
setenv GMS_CCHEM_MP2              true
{% endif -%}
{% if libcchem_ri_off == "true" -%}
setenv GMS_CCHEM_RI               false
{% else -%}
setenv GMS_CCHEM_RI               true
{% endif -%}
{% if libcchem_cc_off == "true" -%}
setenv GMS_CCHEM_CC               false
{% else -%}
setenv GMS_CCHEM_CC               true
{% endif -%}
{% endif -%}
{% endif -%}
{% if gms_debug_flag != "None" -%}
setenv GMS_DEBUG_FLAGS            "{{debug_flags}}"
{% endif -%}
{% if gms_debug_link_flag != "None" -%}
setenv GMS_DEBUG_LINK_FLAGS       "{{debug_link_flags}}"
{% endif -%}

