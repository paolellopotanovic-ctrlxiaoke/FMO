            --mca btl vader,self,tcp \
          -np $NPROCS \
          --bind-to none \
          -map-by ppr:${PPN2}:socket \
          --report-bindings \
          $GMS_PATH/gamess.$VERNO.x < /dev/null
        else
          $OPENMPI_EXE --mca orte_base_help_aggregate 0 \
            --mca orte_tmpdir_base /tmp \
            --mca btl vader,self,tcp \
          -np $NPROCS \
          --bind-to none \
          -map-by ppr:${PPN2}:node \
          --report-bindings \
          $GMS_PATH/gamess.$VERNO.x < /dev/null
        endif
      else
        if ($GMS_TARGET == singularity) then
          $OPENMPI_EXE \
            --mca orte_base_help_aggregate 0 \
            --mca orte_tmpdir_base /tmp \
