        else
          $OPENMPI_EXE \
            --mca orte_base_help_aggregate 0 \
            --mca orte_tmpdir_base /tmp \
            --mca btl vader,self,tcp \
          -np $NPROCS \
          --bind-to none \
          --oversubscribe \
#         --map-by ppr:${PPN2}:node \
          --report-bindings \
          $GMS_PATH/gamess.$VERNO.x < /dev/null
        endif
      endif
#     rm -r /dev/shm/*shm*
      unset echo
      breaksw
   case jsrun:
      module load job-step-viewer
      if ($GMS_OPENMP == true) then
         #
         # cores per resource set = number of gamess compute * number of threads
         #
         @ CPRS = $NCPUS * $OMP_NUM_THREADS
         set echo
         jsrun    -n $NNODES -c $CPRS -a $PPN2 \
                  -b packed:$OMP_NUM_THREADS \
                 --latency_priority cpu-cpu \
                 --launch_distribution cyclic \
                   $GMS_PATH/gamess.$VERNO.x
         unset echo
      else
