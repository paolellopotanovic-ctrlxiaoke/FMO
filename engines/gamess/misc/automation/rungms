   case hpcx:
      (set echo; mpiexec --hostfile $PROCFILE -n $NPROCS $GMSPATH/gamess.$VERNO.x < /dev/null)
      breaksw
   case default:
      echo "rungms: No valid DDI-over-MPI startup procedure was chosen." >> /dev/stderr
      exit
   endsw
