      SUBROUTINE RIMP2_X_FORM_I32_X012 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib
      use gpuGlobalRimp2Eng,only: zero,half,one,eight
      use gpuGlobalRimp2Eng,only: MXATM,ITOLRI,RLN10,LOCSPH,PI252,DAux
      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL,N_S_SHL,N_P_SHL,N_D_SHL
      use shellProcessing,only: CCP,CCD
      use shellpairs,only: pd_PAV_PRE,pd_P_PRE, pd_DUM0_PRE,pd_DUM_PRE, &
                           pd_AB_PRE,pd_VAL_PRE,LOCpd,N_pd_PRE
      implicit none

      double precision :: I32(NBASIS,NBASIS,NddiChunk)
      double precision,intent(in) :: EX(MXEX),EXAUX(MXEXAUX)
      double precision,intent(in) :: C(3,MXATM)
      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd

      logical :: FlgSphAux


      double precision :: XX,U(2),W(2)
      double precision :: CC(3),PAV(3),CPV(3),A1(3,2),B1(2)
      double precision :: GGID(24),G3ID(36),DBID(24),VAL(3),DK

      double precision :: TOL,DUM,RR,DUM0,DUM2,AK,AIINV,AIINV2,VAL1,AB,AIJINVSQ

      integer*4 :: LOCKT_INIT,MINJ,NJ,ISH,JSH,MINI,NI,NGI,LOCI,NGJ, &
                 LOCJ,KAUXSH,KAT,NGK,K1,IAUXSTART,IG,JG,IJ,JI,III, &
                 JJJ,IBF,JBF,LIJ,ISIZE,IIJJ,I_ELSE,II,I,J,KG,IR,JJ,NROOTS

      logical :: isL

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN




NJ=6
MINJ=5
NROOTS=2


!$omp parallel do default(none) &
!$omp shared(KMIN,KNG,KLOC,KAUXAT,C,KAUXNG,KAUXST,LOCSPH) &
!$omp shared(LOCKT_INIT,DAUX,TOL,EXAUX,I32,I_P_SHL,I_D_SHL) &
!$omp shared(MINJ,PD_VAL_PRE,KAUX_ELSE,NJ,LOCPD,PD_DUM_PRE) &
!$omp shared(PD_P_PRE,PD_PAV_PRE,PD_DUM0_PRE,PD_AB_PRE) &
!$omp shared(CCP,CCD,NROOTS,N_ELSE,N_P_SHL,N_D_SHL) &
!$omp private(ISH,JSH,MINI,NI,NGI,LOCI,NGJ,LOCJ,VAL,KAUXSH,KAT,CC,NGK,K1) &
!$omp private(IAUXSTART,DK,GGID,IJ,DBID,G3ID,ISL,JI,DUM,CPV,PAV,RR,DUM0) &
!$omp private(DUM2,AK,XX,U,AIINV,AIINV2,VAL1,A1,B1) &
!$omp private(III,JJJ,AB,W,AIJINVSQ,IBF,JBF,LIJ)


DO iijj = 1, N_P_SHL*N_D_SHL
   III = (iijj-1)/N_D_SHL + 1
   JJJ = mod(iijj-1,N_D_SHL) + 1
   ISH = I_P_SHL(III)
   JSH = I_D_SHL(JJJ)

   MINI  = KMIN(ISH)
   isL = (MINI.EQ.1)
   NI=3
   IF(isL) NI=4

   NGI   = KNG(ISH)
   LOCI  = KLOC(ISH)-1

   NGJ   = KNG(JSH)
   LOCJ  = KLOC(JSH)-1

   VAL(1:3) = pd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
   ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
   DO I_ELSE=1,N_ELSE
      ! DO ISH = 1,NSHELL
      KAUXSH = KAUX_ELSE(I_ELSE)

      KAT = KAUXAT(KAUXSH)
      CC(1) = C(1,KAT)
      CC(2) = C(2,KAT)
      CC(3) = C(3,KAT)

      NGK   = KAUXNG(KAUXSH)
      K1    = KAUXST(KAUXSH)

      ! AUX POINTER FOR I32
      IauxStart = LOCSPH(KAUXSH)
      IauxStart = IauxStart-LOCKT_init+1

         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH
           
      ! DENSITY FACTOR
      DK=PI252*DAux(KAUXSH,1,1)

      ! ZERO OUT INTEGRAL ARRAY
      DO II=1,NI*NJ
         GGID(II)=zero
      ENDDO

      JI=0
      DO IG = 1, NGI
         DO JG = 1, NGJ
            JI=JI+1
            AB = pd_AB_PRE(LOCpd(iijj)+JI)
            DUM = pd_DUM_PRE(LOCpd(iijj)+JI)
            IF (DUM > TOL) CYCLE
            CPV(1:3)= pd_P_PRE(1:3,LOCpd(iijj)+JI)
            PAV(1:3) = CPV(1:3)-CC(1:3)
            PAV(1:3) = pd_PAV_PRE(1:3,LOCpd(iijj)+JI)
            CPV(1:3) = CC(1:3)-CPV(1:3)
            RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
            DUM0 = pd_DUM0_PRE(LOCpd(iijj)+JI)

            IJ = 0
            DO I=1,NI
               DUM2 = DUM0*CCP(I,IG,III)
               DO J=1,NJ
                  IJ = IJ+1
                  DBID(IJ) = DK*DUM2*CCD(J,JG,JJJ)
               ENDDO
            ENDDO !I

            ! PRIMITIVE IN K-SHELL
            DO KG = 1, NGK
               AK = EXAUX(K1+KG-1)
               XX = AB*AK/(AB+AK)
               XX = XX*RR

               ! RYS ROOTS AND WEIGHT
               CALL RT2_gpu(XX,U,W,NROOTS)

               AIJINVSQ = one/(AB+AK)
               XX = AB*AK*AIJINVSQ
               AIINV  = one/AB
               AIINV2 = half*AIINV
               AIJINVSQ = SQRT(AIJINVSQ)

               DO IR = 1, NROOTS
                  U(IR) = U(IR)*XX
                  U(IR) = U(IR)/(XX+U(IR))
                  VAL1 = XX*AIINV*U(IR)
                  A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                  B1(IR) = AIINV2-AIINV2*VAL1
                  G3ID(3*IR) = AIJINVSQ*W(IR)
               ENDDO


DO IR=1,2
  G3ID(4+IR*3) = A1(1,IR)
  G3ID(5+IR*3) = A1(2,IR)
  G3ID(6+IR*3) = A1(3,IR)*G3ID(3*IR)
ENDDO
DO IR=1,2
  G3ID(28+IR*3) = A1(1,IR)*G3ID(4+IR*3) +  B1(IR)
  G3ID(29+IR*3) = A1(2,IR)*G3ID(5+IR*3) +  B1(IR)
  G3ID(30+IR*3) = A1(3,IR)*G3ID(6+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,2
  G3ID(22+IR*3) = A1(1,IR)*G3ID(28+IR*3) +  2*B1(IR)*G3ID(4+IR*3)
  G3ID(23+IR*3) = A1(2,IR)*G3ID(29+IR*3) +  2*B1(IR)*G3ID(5+IR*3)
  G3ID(24+IR*3) = A1(3,IR)*G3ID(30+IR*3) +  2*B1(IR)*G3ID(6+IR*3)
ENDDO
DO IR=1,2
  G3ID(10+IR*3) = VAL(1)  +  G3ID(4+IR*3)
  G3ID(11+IR*3) = VAL(2)  +  G3ID(5+IR*3)
  G3ID(12+IR*3) = VAL(3)*G3ID(IR*3) +  G3ID(6+IR*3)
ENDDO
DO IR=1,2
  G3ID(16+IR*3) = VAL(1)*G3ID(4+IR*3) +  G3ID(28+IR*3)
  G3ID(17+IR*3) = VAL(2)*G3ID(5+IR*3) +  G3ID(29+IR*3)
  G3ID(18+IR*3) = VAL(3)*G3ID(6+IR*3) +  G3ID(30+IR*3)
ENDDO
DO IR=1,2
  G3ID(28+IR*3) = VAL(1)*G3ID(28+IR*3) +  G3ID(22+IR*3)
  G3ID(29+IR*3) = VAL(2)*G3ID(29+IR*3) +  G3ID(23+IR*3)
  G3ID(30+IR*3) = VAL(3)*G3ID(30+IR*3) +  G3ID(24+IR*3)
ENDDO
DO IR=1,2
  G3ID(22+IR*3) = VAL(1)*G3ID(10+IR*3) +  G3ID(16+IR*3)
  G3ID(23+IR*3) = VAL(2)*G3ID(11+IR*3) +  G3ID(17+IR*3)
  G3ID(24+IR*3) = VAL(3)*G3ID(12+IR*3) +  G3ID(18+IR*3)
ENDDO
DO IR=1,2
  G3ID(28+IR*3) = VAL(1)*G3ID(16+IR*3) +  G3ID(28+IR*3)
  G3ID(29+IR*3) = VAL(2)*G3ID(17+IR*3) +  G3ID(29+IR*3)
  G3ID(30+IR*3) = VAL(3)*G3ID(18+IR*3) +  G3ID(30+IR*3)
ENDDO

IF(isL) THEN
XX = G3ID(25)*G3ID(3) + G3ID(28)*G3ID(6)
GGID(1) = GGID(1) + DBID(1)*XX
XX = G3ID(26)*G3ID(3) + G3ID(29)*G3ID(6)
GGID(2) = GGID(2) + DBID(2)*XX
XX = G3ID(27) + G3ID(30)
GGID(3) = GGID(3) + DBID(3)*XX
XX = G3ID(13)*G3ID(14)*G3ID(3) + G3ID(16)*G3ID(17)*G3ID(6)
GGID(4) = GGID(4) + DBID(4)*XX
XX = G3ID(13)*G3ID(15) + G3ID(16)*G3ID(18)
GGID(5) = GGID(5) + DBID(5)*XX
XX = G3ID(14)*G3ID(15) + G3ID(17)*G3ID(18)
GGID(6) = GGID(6) + DBID(6)*XX
XX = G3ID(31)*G3ID(3) + G3ID(34)*G3ID(6)
GGID(7) = GGID(7) + DBID(7)*XX
XX = G3ID(7)*G3ID(26)*G3ID(3) + G3ID(10)*G3ID(29)*G3ID(6)
GGID(8) = GGID(8) + DBID(8)*XX
XX = G3ID(7)*G3ID(27) + G3ID(10)*G3ID(30)
GGID(9) = GGID(9) + DBID(9)*XX
XX = G3ID(19)*G3ID(14)*G3ID(3) + G3ID(22)*G3ID(17)*G3ID(6)
GGID(10) = GGID(10) + DBID(10)*XX
XX = G3ID(19)*G3ID(15) + G3ID(22)*G3ID(18)
GGID(11) = GGID(11) + DBID(11)*XX
XX = G3ID(7)*G3ID(14)*G3ID(15) + G3ID(10)*G3ID(17)*G3ID(18)
GGID(12) = GGID(12) + DBID(12)*XX
XX = G3ID(25)*G3ID(8)*G3ID(3) + G3ID(28)*G3ID(11)*G3ID(6)
GGID(13) = GGID(13) + DBID(13)*XX
XX = G3ID(32)*G3ID(3) + G3ID(35)*G3ID(6)
GGID(14) = GGID(14) + DBID(14)*XX
XX = G3ID(8)*G3ID(27) + G3ID(11)*G3ID(30)
GGID(15) = GGID(15) + DBID(15)*XX
XX = G3ID(13)*G3ID(20)*G3ID(3) + G3ID(16)*G3ID(23)*G3ID(6)
GGID(16) = GGID(16) + DBID(16)*XX
XX = G3ID(13)*G3ID(8)*G3ID(15) + G3ID(16)*G3ID(11)*G3ID(18)
GGID(17) = GGID(17) + DBID(17)*XX
XX = G3ID(20)*G3ID(15) + G3ID(23)*G3ID(18)
GGID(18) = GGID(18) + DBID(18)*XX
XX = G3ID(25)*G3ID(9) + G3ID(28)*G3ID(12)
GGID(19) = GGID(19) + DBID(19)*XX
XX = G3ID(26)*G3ID(9) + G3ID(29)*G3ID(12)
GGID(20) = GGID(20) + DBID(20)*XX
XX = G3ID(33) + G3ID(36)
GGID(21) = GGID(21) + DBID(21)*XX
XX = G3ID(13)*G3ID(14)*G3ID(9) + G3ID(16)*G3ID(17)*G3ID(12)
GGID(22) = GGID(22) + DBID(22)*XX
XX = G3ID(13)*G3ID(21) + G3ID(16)*G3ID(24)
GGID(23) = GGID(23) + DBID(23)*XX
XX = G3ID(14)*G3ID(21) + G3ID(17)*G3ID(24)
GGID(24) = GGID(24) + DBID(24)*XX
ELSE
XX = G3ID(31)*G3ID(3) + G3ID(34)*G3ID(6)
GGID(1) = GGID(1) + DBID(1)*XX
XX = G3ID(7)*G3ID(26)*G3ID(3) + G3ID(10)*G3ID(29)*G3ID(6)
GGID(2) = GGID(2) + DBID(2)*XX
XX = G3ID(7)*G3ID(27) + G3ID(10)*G3ID(30)
GGID(3) = GGID(3) + DBID(3)*XX
XX = G3ID(19)*G3ID(14)*G3ID(3) + G3ID(22)*G3ID(17)*G3ID(6)
GGID(4) = GGID(4) + DBID(4)*XX
XX = G3ID(19)*G3ID(15) + G3ID(22)*G3ID(18)
GGID(5) = GGID(5) + DBID(5)*XX
XX = G3ID(7)*G3ID(14)*G3ID(15) + G3ID(10)*G3ID(17)*G3ID(18)
GGID(6) = GGID(6) + DBID(6)*XX
XX = G3ID(25)*G3ID(8)*G3ID(3) + G3ID(28)*G3ID(11)*G3ID(6)
GGID(7) = GGID(7) + DBID(7)*XX
XX = G3ID(32)*G3ID(3) + G3ID(35)*G3ID(6)
GGID(8) = GGID(8) + DBID(8)*XX
XX = G3ID(8)*G3ID(27) + G3ID(11)*G3ID(30)
GGID(9) = GGID(9) + DBID(9)*XX
XX = G3ID(13)*G3ID(20)*G3ID(3) + G3ID(16)*G3ID(23)*G3ID(6)
GGID(10) = GGID(10) + DBID(10)*XX
XX = G3ID(13)*G3ID(8)*G3ID(15) + G3ID(16)*G3ID(11)*G3ID(18)
GGID(11) = GGID(11) + DBID(11)*XX
XX = G3ID(20)*G3ID(15) + G3ID(23)*G3ID(18)
GGID(12) = GGID(12) + DBID(12)*XX
XX = G3ID(25)*G3ID(9) + G3ID(28)*G3ID(12)
GGID(13) = GGID(13) + DBID(13)*XX
XX = G3ID(26)*G3ID(9) + G3ID(29)*G3ID(12)
GGID(14) = GGID(14) + DBID(14)*XX
XX = G3ID(33) + G3ID(36)
GGID(15) = GGID(15) + DBID(15)*XX
XX = G3ID(13)*G3ID(14)*G3ID(9) + G3ID(16)*G3ID(17)*G3ID(12)
GGID(16) = GGID(16) + DBID(16)*XX
XX = G3ID(13)*G3ID(21) + G3ID(16)*G3ID(24)
GGID(17) = GGID(17) + DBID(17)*XX
XX = G3ID(14)*G3ID(21) + G3ID(17)*G3ID(24)
GGID(18) = GGID(18) + DBID(18)*XX
ENDIF
                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG

           
               DO II=1,NI
                  DO JJ=1,NJ
                     IBF = LOCI + II
                     JBF = LOCJ + JJ
                     LIJ = JJ+(II-1)*NJ
                     I32(IBF,JBF,IauxStart) = GGID(LIJ) 
                     I32(JBF,IBF,IauxStart) = GGID(LIJ) 
                  ENDDO
               ENDDO


           ENDDO !ISH
         ! ENDDO !JSH
      ENDDO !KSH
!$omp end parallel do



      END SUBROUTINE




      SUBROUTINE RIMP2_X_FORM_I32_X112 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib
      use gpuGlobalRimp2Eng,only: zero,half,one,eight
      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCP,CCD
      use shellpairs,only: pd_PAV_PRE, &
                           pd_P_PRE,   &
                           pd_DUM0_PRE,&
                           pd_DUM_PRE, &
                           pd_AB_PRE,  &
                           pd_VAL_PRE, &
                           LOCpd,   &
                           N_pd_PRE
      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(3),W(3)
      integer :: NROOTS
      

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:MXLTOT),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,3),B1(3),C1(3),           &
                          A2(3,3),B2(3),F00(3)

      double precision :: GGID(72)
      double precision :: DK(3)
      double precision :: G3ID(108)
      double precision :: DBID(24)
                        
      double precision :: TMP(3),VAL(3),VALL

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,MAXI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ,MAXJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,LB,NLJ


      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj_tmp, iijj
      logical :: isL

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN


NROOTS=3
MINJ=5
NJ=6
NK=3
NKS=3

!$omp parallel do default(none) &
!$omp shared(KMIN,KNG,KLOC,KAUXAT,C,KAUXNG,KAUXST,LOCSPH) &
!$omp shared(LOCKT_INIT,DAUX,TOL,EXAUX,I32,I_P_SHL,I_D_SHL) &
!$omp shared(MINJ,PD_VAL_PRE,KAUX_ELSE,NJ,LOCPD,PD_DUM_PRE) &
!$omp shared(PD_P_PRE,PD_PAV_PRE,PD_DUM0_PRE,PD_AB_PRE) &
!$omp shared(CCP,CCD,NROOTS,N_ELSE,N_P_SHL,N_D_SHL,NK,NKS) &
!$omp private(ISH,JSH,MINI,NI,NGI,LOCI,NGJ,LOCJ,VAL,KAUXSH,KAT,CC,NGK) &
!$omp private(K1,IAUXSTART,DK,GGID,IJ,DBID,G3ID,ISL,JI,DUM,CPV,PAV,RR) &
!$omp private(DUM0,DUM2,AK,XX,U,AIINV,AJINV,AIINV2,AJINV2,B1,B2,A1,A2) &
!$omp private(III,JJJ,AB,W,AIJINVSQ,AIJINV2,NLJ,IBF,JBF,LIJ)




DO iijj = 1, N_P_SHL*N_D_SHL
   III = (iijj-1)/N_D_SHL + 1
   JJJ = mod(iijj-1,N_D_SHL) + 1
   ISH = I_P_SHL(III)
   JSH = I_D_SHL(JJJ)

   MINI  = KMIN(ISH)
   isL = (MINI.EQ.1)
   NI=3
   IF(isL) NI=4

   NGI   = KNG(ISH)
   LOCI  = KLOC(ISH)-1

   NGJ   = KNG(JSH)
   LOCJ  = KLOC(JSH)-1

   VAL(1:3) = pd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
   ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
   DO I_ELSE=1,N_ELSE
      ! DO ISH = 1,NSHELL
      KAUXSH = KAUX_ELSE(I_ELSE)

      KAT = KAUXAT(KAUXSH)
      CC(1) = C(1,KAT)
      CC(2) = C(2,KAT)
      CC(3) = C(3,KAT)

      NGK   = KAUXNG(KAUXSH)
      K1    = KAUXST(KAUXSH)
      
      ! AUX POINTER FOR I32
      IauxStart = LOCSPH(KAUXSH)         
      IauxStart = IauxStart-LOCKT_init+1

   ! DO ISH = 1,NSHELL
   !    DO JSH = 1,ISH

      ! DENSITY FACTOR
      DO K=1,NK
         DK(K) = PI252 * DAux(KAUXSH,1,K)
      ENDDO

      ! ZERO OUT INTEGRAL ARRAY
      DO II=1,NI*NJ*NK
         GGID(II)=zero
      ENDDO
      JI=0
      DO IG = 1, NGI                
         DO JG = 1, NGJ
            JI=JI+1
            AB = pd_AB_PRE(LOCpd(iijj)+JI)
            DUM = pd_DUM_PRE(LOCpd(iijj)+JI)
            IF (DUM > TOL) CYCLE
            CPV(1:3)= pd_P_PRE(1:3,LOCpd(iijj)+JI)
            PAV(1:3) = CPV(1:3)-CC(1:3)
            PAV(1:3) = pd_PAV_PRE(1:3,LOCpd(iijj)+JI)
            CPV(1:3) = CC(1:3)-CPV(1:3)
            RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
            DUM0 = pd_DUM0_PRE(LOCpd(iijj)+JI)

            IJ = 0
            DO I=1,NI
               DUM2 = DUM0*CCP(I,IG,III)
               DO J=1,NJ
                  IJ = IJ+1
                  DBID(IJ) = DUM2*CCD(J,JG,JJJ)
               ENDDO
            ENDDO !I

            DO KG = 1, NGK
               AK = EXAUX(K1+KG-1)
               XX = AB*AK/(AB+AK)
               XX = XX*RR

               ! RYS ROOTS AND WEIGHT
               CALL RT3_gpu(XX,U,W,NROOTS)

               AIJINVSQ = one/(AB+AK)
               XX = AB*AK*AIJINVSQ
               AIINV  = one/AB
               AJINV  = one/AK
               AIINV2 = half*AIINV
               AJINV2 = half*AJINV
               AIJINV2 = half*AIJINVSQ
               AIJINVSQ = SQRT(AIJINVSQ)

               DO IR = 1, NROOTS
                  U(IR) = U(IR)*XX
                  U(IR) = U(IR)/(XX+U(IR))
                  B1(IR) = XX*AIINV*U(IR)
                  B2(IR) = XX*AJINV*U(IR)
                  A1(1:3,IR) = PAV(1:3)+B1(IR)*CPV(1:3)
                  A2(1:3,IR) = -B2(IR)*CPV(1:3)
                  B1(IR) = AIINV2-AIINV2*B1(IR)
                  B2(IR) = AJINV2-AJINV2*B2(IR)
                  U(IR) = AIJINV2*U(IR)
                  G3ID(3*IR) = AIJINVSQ*W(IR)
               ENDDO

DO IR=1,3
  G3ID(7+IR*3) = A1(1,IR)
  G3ID(8+IR*3) = A1(2,IR)
  G3ID(9+IR*3) = A1(3,IR)*G3ID(3*IR)
ENDDO
DO IR=1,3
  G3ID(43+IR*3) = A1(1,IR)*G3ID(7+IR*3) +  B1(IR)
  G3ID(44+IR*3) = A1(2,IR)*G3ID(8+IR*3) +  B1(IR)
  G3ID(45+IR*3) = A1(3,IR)*G3ID(9+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
  G3ID(34+IR*3) = A1(1,IR)*G3ID(43+IR*3) +  2*B1(IR)*G3ID(7+IR*3)
  G3ID(35+IR*3) = A1(2,IR)*G3ID(44+IR*3) +  2*B1(IR)*G3ID(8+IR*3)
  G3ID(36+IR*3) = A1(3,IR)*G3ID(45+IR*3) +  2*B1(IR)*G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(52+IR*3) = A2(1,IR)
  G3ID(53+IR*3) = A2(2,IR)
  G3ID(54+IR*3) = A2(3,IR)*G3ID(3*IR)
ENDDO
DO IR=1,3
  G3ID(61+IR*3) =A1(1,IR)*G3ID(52+IR*3) +  U(IR)
  G3ID(62+IR*3) =A1(2,IR)*G3ID(53+IR*3) +  U(IR)
  G3ID(63+IR*3) =A1(3,IR)*G3ID(54+IR*3) +  U(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
  G3ID(97+IR*3) = A1(1,IR)*G3ID(61+IR*3) +  B1(IR)*G3ID(52+IR*3) +  U(IR)*G3ID(7+IR*3)
  G3ID(98+IR*3) = A1(2,IR)*G3ID(62+IR*3) +  B1(IR)*G3ID(53+IR*3) +  U(IR)*G3ID(8+IR*3)
  G3ID(99+IR*3) = A1(3,IR)*G3ID(63+IR*3) +  B1(IR)*G3ID(54+IR*3) +  U(IR)*G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(88+IR*3) = A1(1,IR)*G3ID(97+IR*3) +  2*B1(IR)*G3ID(61+IR*3) +  U(IR)*G3ID(43+IR*3)
  G3ID(89+IR*3) = A1(2,IR)*G3ID(98+IR*3) +  2*B1(IR)*G3ID(62+IR*3) +  U(IR)*G3ID(44+IR*3)
  G3ID(90+IR*3) = A1(3,IR)*G3ID(99+IR*3) +  2*B1(IR)*G3ID(63+IR*3) +  U(IR)*G3ID(45+IR*3)
ENDDO
DO IR=1,3
  G3ID(16+IR*3) = VAL(1) +  G3ID(7+IR*3)
  G3ID(17+IR*3) = VAL(2) +  G3ID(8+IR*3)
  G3ID(18+IR*3) = VAL(3)*G3ID(IR*3) +  G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(25+IR*3) = VAL(1)*G3ID(7+IR*3) +  G3ID(43+IR*3)
  G3ID(26+IR*3) = VAL(2)*G3ID(8+IR*3) +  G3ID(44+IR*3)
  G3ID(27+IR*3) = VAL(3)*G3ID(9+IR*3) +  G3ID(45+IR*3)
