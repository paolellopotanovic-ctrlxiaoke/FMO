  GGID(175) = GGID(175) + DBID(18)*DK(5)*XX
  XX = G3ID(73)*G3ID(170)*G3ID(39) + G3ID(76)*G3ID(173)*G3ID(42) + G3ID(79)*G3ID(176)*G3ID(45) + G3ID(82)*G3ID(179)*G3ID(48)
  GGID(176) = GGID(176) + DBID(18)*DK(6)*XX
  XX = G3ID(170)*G3ID(111) + G3ID(173)*G3ID(114) + G3ID(176)*G3ID(117) + G3ID(179)*G3ID(120)
  GGID(177) = GGID(177) + DBID(18)*DK(7)*XX
  XX = G3ID(73)*G3ID(26)*G3ID(183) + G3ID(76)*G3ID(29)*G3ID(186) + G3ID(79)*G3ID(32)*G3ID(189) + G3ID(82)*G3ID(35)*G3ID(192)
  GGID(178) = GGID(178) + DBID(18)*DK(8)*XX
  XX = G3ID(98)*G3ID(183) + G3ID(101)*G3ID(186) + G3ID(104)*G3ID(189) + G3ID(107)*G3ID(192)
  GGID(179) = GGID(179) + DBID(18)*DK(9)*XX
  XX = G3ID(73)*G3ID(98)*G3ID(111) + G3ID(76)*G3ID(101)*G3ID(114) + G3ID(79)*G3ID(104)*G3ID(117) + G3ID(82)*G3ID(107)*G3ID(120)
  GGID(180) = GGID(180) + DBID(18)*DK(10)*XX
ENDIF

                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG


DO II=1,18
   T1(II*7-6) = a1114*GGID(II*10-9) - a4714*GGID(II*10-4)
   T1(II*7-5) = a5214*(GGID(II*10-5) - GGID(II*10-3))
   T1(II*7-4) = a1314*GGID(II*10-9) + a6314*GGID(II*10-4) + a8314*GGID(II*10-2)
   T1(II*7-3) = GGID(3+(II-1)*10) + a5414* (GGID(II*10-5) + GGID(II*10-3))
   T1(II*7-2) = a1314*GGID(II*10-8) + a6314*GGID(II*10-6) + a8314*GGID(II*10-1)
   T1(II*7-1) = GGID(10+(II-1)*10)
   T1(II*7  ) = - a1114*GGID(II*10-8) + a4714*GGID(II*10-6)
ENDDO
IF(isL) THEN
DO II=19,24
   T1(II*7-6) = a1114*GGID(II*10-9) - a4714*GGID(II*10-4)
   T1(II*7-5) = a5214*(GGID(II*10-5) - GGID(II*10-3))
   T1(II*7-4) = a1314*GGID(II*10-9) + a6314*GGID(II*10-4) + a8314*GGID(II*10-2)
   T1(II*7-3) = GGID(3+(II-1)*10) + a5414* (GGID(II*10-5) + GGID(II*10-3))
   T1(II*7-2) = a1314*GGID(II*10-8) + a6314*GGID(II*10-6) + a8314*GGID(II*10-1)
   T1(II*7-1) = GGID(10+(II-1)*10)
   T1(II*7  ) = - a1114*GGID(II*10-8) + a4714*GGID(II*10-6)
ENDDO
ENDIF

               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO II=1,NI
                     DO JJ=1,NJ
                        IBF = LOCI+II
                        JBF = LOCJ+JJ
                        LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                        I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                        I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                     ENDDO
                  ENDDO
               ENDDO

           ENDDO !ISH
         ! ENDDO !JSH
      ENDDO !KSH
!$omp end parallel do



      END SUBROUTINE














      SUBROUTINE RIMP2_X_FORM_I32_X12 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib
      use gpuGlobalRimp2Eng,only: zero,half,one,eight
      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCP,CCD
      use shellpairs,only: pd_PAV_PRE, &
                           pd_P_PRE,   &
                           pd_DUM0_PRE,&
                           pd_DUM_PRE, &
                           pd_AB_PRE,  &
                           pd_VAL_PRE, &
                           LOCpd,   &
                           N_pd_PRE
      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(13),W(13)
      integer :: NROOTS
      

      ! BUFFER
      double precision :: CC(3,3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:MXLTOT),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,13),B1(13),C1(13),           &
                          A2(3,13),B2(13),F00(13)

      double precision :: GGID(2000)
      double precision :: DK(100),T1(2000)
      double precision :: G2ID(728)
      double precision :: G3ID(2688)
      double precision :: DBID(24)
                        
      integer :: LLI(3,28),LLJ(3,28),LLK(3,28)

      double precision :: TMP(3),VAL(3),VALL

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,MAXI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ,MAXJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,LB,NLJ


      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj_tmp, iijj
      logical :: isL

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN

!$omp parallel do default(none) &
!$omp shared(EXAUX,KAUXAT,KAUXTY,KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO)    &
!$omp shared(EX,KATOM,C,KTYPE,KMIN,KMAX,KNG,KSTART,KLOC,NSHELL)         &
!$omp shared(MIXS,TLL,DAux,LOCSPH,TOL)     &
!$omp shared(LX,LY,LZ,LddiAuxShStart,LddiAuxShEnd,lockt_init)           &
!$omp shared(I32) &
!$omp shared(pd_VAL_PRE,pd_AB_PRE,pd_DUM_PRE,pd_P_PRE,pd_PAV_PRE,pd_DUM0_PRE,LOCpd) &
!$omp shared(KAUX_ELSE,N_ELSE,CCD,CCP,I_P_SHL,N_D_SHL,I_D_SHL,n_p_shl) &
!$omp private(G2ID,G3ID,GGID,DBID,VALL) &
!$omp private(CC,KAUXSH,KAT,LK,NK,NGK,MINK,MAXK,K1,LOCK,             &
!$omp         ISH,IAT,LI,MINI,MAXI,NI,NGI,I1,LOCI,                   &
!$omp         JSH,JAT,LJ,MINJ,MAXJ,NJ,NGJ,J1,LOCJ,                   &
!$omp         NKS,MINKT,MAXKT,LOCKT,                  &
!$omp         DK,T1,IauxStart,INDEX, &
!$omp        ILOC,JLOC,NLJ,LNKS,IBF,JBF,LIJ,KJ,IJ) &
!$omp private(       LB,LTOT) & 
!$omp private(CAB,VAL,RAB2,IG,AI,TMP,AIRAB) &
!$omp private(JG,AJ,AB,ABINV,EXPB,P,PAV,CPV,RR,DUM,DUM0,DUM2) &
!$omp private(XX,U,W,NROOTS,AK,RHO,A1,B1,C1,A2,B2,F00) &
!$omp private(LL,II,KG,I,J,K) &
!$omp private(U2,T2,VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2) &
!$omp private(LLI,LLJ,LLK) &
!$omp private(KNK,INI,JNJ,JI) &
!$omp private(ajinv2,aijinv2,aijinvsq,aiinv2,aijinv,aiinv,ajinv) &
!$omp private(NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ) &
!$omp private(I3,N3,N3I,N3B,N3IJ,IDX,IDZ,IDY,IJK,FACTOR) &
!$omp private(iijj,III,JJJ,isL)


DO iijj = 1, N_P_SHL*N_D_SHL
   III = (iijj-1)/N_D_SHL + 1
   JJJ = mod(iijj-1,N_D_SHL) + 1
      ISH = I_P_SHL(III)
      JSH = I_D_SHL(JJJ)



            
               IAT = KATOM(ISH)
               CC(1,1) = C(1,IAT)
               CC(2,1) = C(2,IAT)
               CC(3,1) = C(3,IAT)
               LI = KTYPE(ISH)-1
               MINI  = KMIN(ISH)
               isL = (MINI.EQ.1)
               MAXI  = KMAX(ISH)
               NI    = KMAX(ISH)-KMIN(ISH)+1
               NGI   = KNG(ISH)
               I1    = KSTART(ISH)
               LOCI  = KLOC(ISH)-1
   
               DO I=MINI,MAXI
                  INI=I-MINI+1
                  LLI(1,INI) = LX(I)
                  LLI(2,INI) = LY(I)
                  LLI(3,INI) = LZ(I)
               ENDDO

               JAT = KATOM(JSH)
               CC(1,2) = C(1,JAT)
               CC(2,2) = C(2,JAT)
               CC(3,2) = C(3,JAT)
               LJ = KTYPE(JSH)-1
               MINJ  = KMIN(JSH)
               MAXJ  = KMAX(JSH)
               NJ    = KMAX(JSH)-KMIN(JSH)+1
               NGJ   = KNG(JSH)
               J1    = KSTART(JSH)
               LOCJ  = KLOC(JSH)-1
   
               DO J=MINJ,MAXJ
                  JNJ=J-MINJ+1
                  LLJ(1,JNJ) = LX(J)
                  LLJ(2,JNJ) = LY(J)
                  LLJ(3,JNJ) = LZ(J)
               ENDDO
   
               ! VAL(1:3) = CC(1:3,1)-CC(1:3,2)
            VAL(1:3) = pd_VAL_PRE(1:3,iijj)
               ! RAB2 = VAL(1)*VAL(1) + VAL(2)*VAL(2) + VAL(3)*VAL(3)

               DO J = 0, LJ
                  CAB(1:3,J) = VAL(1:3)**J
               ENDDO



! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)

         KAT = KAUXAT(KAUXSH)
         CC(1,3) = C(1,KAT)
         CC(2,3) = C(2,KAT)
         CC(3,3) = C(3,KAT)
         LK = KAUXTY(KAUXSH)-1

         MINK  = KAUXMI(KAUXSH)
         MAXK  = KAUXMX(KAUXSH)
         NK    = MAXK-MINK+1
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)
         LOCK  = KAUXLO(KAUXSH)-MINK
         INDEX = MINK+LK

         DO K=MINK,MAXK
            KNK=K-MINK+1
            LLK(1,KNK) = LX(K)
            LLK(2,KNK) = LY(K)
            LLK(3,KNK) = LZ(K)
         ENDDO

         ! SPHERICAL TRANSFORMATION
         MINKT = MIXS(1,INDEX)
         MAXKT = MIXS(2,INDEX)
         NKS = MAXKT - MINKT + 1
         LOCKT = LOCSPH(KAUXSH)-MINKT

         ! AUX POINTER FOR I32
         IauxStart = LOCKT+MINKT-LOCKT_init+1

         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH

           
               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K)=DAux(KAUXSH,1,K)
               ENDDO

               ! TOTAL ANG MOM & ROOTS
               LB = LI+LJ
               LTOT = LB+LK
               NROOTS = LTOT/2+1

               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,NI*NJ*NK
                  GGID(II)=zero
               ENDDO
               
               JI=0
               DO IG = 1, NGI
                  DO JG = 1, NGJ
                     JI=JI+1
                     AB = pd_AB_PRE(LOCpd(iijj)+JI)
                     DUM = pd_DUM_PRE(LOCpd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3)= pd_P_PRE(1:3,LOCpd(iijj)+JI)
                     PAV(1:3) = CPV(1:3)-CC(1:3,1)
                     PAV(1:3) = pd_PAV_PRE(1:3,LOCpd(iijj)+JI)
                     CPV(1:3) = CC(1:3,3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = pd_DUM0_PRE(LOCpd(iijj)+JI)
                     IJ = 0
                     DO I=1,NI
                        DUM2 = DUM0*CCP(I,IG,III)
                        DO J=1,NJ
                           IJ = IJ+1
                           DBID(IJ) = DUM2*CCD(J,JG,JJJ)
                        ENDDO
                     ENDDO !I

                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        IF(NROOTS.EQ.2) THEN
                           CALL RT2_gpu(XX,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.3) THEN
                           CALL RT3_gpu(XX,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.4) THEN
                           CALL ROOT4_gpu(XX,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.5) THEN
                           CALL ROOT5_gpu(XX,U,W,NROOTS)                     
                        ELSEIF(NROOTS.GE.6) THEN
                           CALL ROOT6_gpu(XX,U,W,NROOTS)                     
                        ENDIF
! I32_AO_BOYS_gpu
                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AJINV2 = half*AJINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           B2(IR) = AJINV2-AJINV2*VAL2
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G2ID(1 + 3*(IR-1)) = one
                           G2ID(2 + 3*(IR-1)) = one
                           G2ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO

                        N3=3*NROOTS
                        N3B=N3*(LB+1)
                        N3=3*NROOTS
                        N3I=N3*(LI+1)
                        N3B=3*NROOTS*(LB+1)
                        N3IJ=N3I*(LJ+1)

                        DO IR = 1, NROOTS
                           G2ID(1+(IR-1)*3+3*NROOTS) = A1(1,IR)
                           G2ID(2+(IR-1)*3+3*NROOTS) = A1(2,IR)
                           G2ID(3+(IR-1)*3+3*NROOTS) = A1(3,IR)*F00(IR)
                        END DO

                        DO I = 2, LB
                           DO IR=1,NROOTS
                              DO K=1,3
                                 G2ID(K+3*(IR-1)+ 3*NROOTS*I) = &
                                          A1(K,IR)*G2ID(K+3*(IR-1)+3*NROOTS*(I-1)) &
                                    + (I-1)*B1(IR)*G2ID(K+3*(IR-1)+3*NROOTS*(I-2))
                              ENDDO
                           ENDDO
                        ENDDO

                        IF (LK.EQ.0) GOTO 333
                        !!!!!!!!!!!!!!!!!!!!!

                        DO IR = 1, NROOTS
                           G2ID(1+3*(IR-1)+N3B) = A2(1,IR)
                           G2ID(2+3*(IR-1)+N3B) = A2(2,IR)
                           G2ID(3+3*(IR-1)+N3B) = A2(3,IR)*F00(IR)
                           DO K=1,3
                               G2ID(K+3*(IR-1)+N3+N3B) = &
                                       A1(K,IR)*G2ID(K+3*(IR-1)+N3B) &
                                       + C1(IR)*G2ID(K+3*(IR-1))
                           ENDDO
                        ENDDO

                        DO I = 2, LB
                           DO IR=1,NROOTS
                              DO K=1,3
                                  G2ID(K+3*(IR-1)+N3*I+N3B) = &
                                          A1(K,IR)*G2ID(K+3*(IR-1)+N3*(I-1)+N3B) &
                                    + (I-1)*B1(IR)*G2ID(K+3*(IR-1)+N3*(I-2)+N3B) &
                                          + C1(IR)*G2ID(K+3*(IR-1)+N3*(I-1))
                              ENDDO
                           ENDDO
                        ENDDO

                        IF(LK.EQ.1) GOTO 333
                           
                        DO J=2,LK
                           DO IR=1,NROOTS
                              DO K=1,3
                                 G2ID(K+3*(IR-1)+N3B*J) = &
                                          A2(K,IR)*G2ID(K+3*(IR-1)+N3B*(J-1)) &
                                           + (J-1)*B2(IR)*G2ID(K+3*(IR-1)+N3B*(J-2))
                                 G2ID(K+3*(IR-1)+N3+N3B*J) = &
                                          A1(K,IR)*G2ID(K+3*(IR-1)+N3B*J) &
                                        + J*C1(IR)*G2ID(K+3*(IR-1)+N3B*(J-1))
                              ENDDO
                           ENDDO

                           DO I = 2, LB
                              DO IR=1,NROOTS
                                 DO K=1,3
                                    G2ID(K+3*(IR-1)+N3*I+N3B*J) = &
                                             A1(K,IR)*G2ID(K+3*(IR-1)+N3*(I-1)+N3B*J) &
                                       + (I-1)*B1(IR)*G2ID(K+3*(IR-1)+N3*(I-2)+N3B*J) &
                                           + J*C1(IR)*G2ID(K+3*(IR-1)+N3*(I-1)+N3B*(J-1))
                                 ENDDO
                              ENDDO
                           ENDDO
                        ENDDO
  333 CONTINUE
                        
                        DO KK = 0, LK
                           DO JJ = 0, LJ-1

                              DO IR=1,NROOTS
                                 DO II=0,LI               
                                    DO IA=1,3
                                       G3ID(IA+3*(IR-1)+N3*II+N3I*JJ+N3IJ*KK) = &
                                                G2ID(IA+3*(IR-1)+N3*II+N3B*KK)
                                    ENDDO
                                 ENDDO
                              ENDDO
                              
                              DO II = 0, LI+LJ-JJ-1
                                 DO IR=1,NROOTS
                                    DO IA=1,3
                                       G2ID(IA+3*(IR-1)+N3*II+N3B*KK) = &
                                                CAB(IA,1)*G2ID(IA+3*(IR-1)+N3*II+N3B*KK) &
                                              + G2ID(IA+3*(IR-1)+N3*(II+1)+N3B*KK)
                                    ENDDO
                                 ENDDO
                              ENDDO

                           ENDDO !JJ
                        ENDDO !KK

                        DO KK=0,LK
                           DO II=0,LI
                              DO IR=1,NROOTS
                                 DO IA=1,3
                                    G3ID(IA+3*(IR-1)+N3*II+N3I*LJ+N3IJ*KK) = &
                                             G2ID(IA+3*(IR-1)+N3*II+N3B*KK)
                                 ENDDO
                              ENDDO
                           ENDDO
                        ENDDO


                        IJ = 0
                        IJK = 0
                        DO I = 1, NI
                           NIX = LLI(1,I)
                           NIY = LLI(2,I)
                           NIZ = LLI(3,I)
                           DO J = 1, NJ
                              NJX = LLJ(1,J)
                              NJY = LLJ(2,J)
                              NJZ = LLJ(3,J)
                              IJ = IJ+1

                              FACTOR=PI252*DBID(IJ)

                              DO K = 1, NK
                                 NKX = LLK(1,K)
                                 NKY = LLK(2,K)
                                 NKZ = LLK(3,K)
                                 VALL = zero
                                 DO IR = 1, NROOTS
                                    I3=3*(IR-1)
                                    IDX = I3 + N3*NIX + N3I*NJX + N3IJ*NKX
                                    IDY = I3 + N3*NIY + N3I*NJY + N3IJ*NKY
                                    IDZ = I3 + N3*NIZ + N3I*NJZ + N3IJ*NKZ
                                    VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                                 ENDDO
                                 IJK = IJK+1
                                 GGID(IJK) = GGID(IJK) + FACTOR*DK(K)*VALL
                              ENDDO

                           ENDDO
                        ENDDO

                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG


               ! TRANSFORM TO SPHERICAL
               DO J = 1,NI*NJ
                  DO I=1,NKS               
                     IJ = (J-1)*NKS + I              
                     T1(IJ) = zero
                     DO K=1,NK
                        KJ = (J-1)*NK + K
                        T1(IJ) = T1(IJ) + TLL(K,I,INDEX)*GGID(KJ)
                     ENDDO
                  ENDDO
               ENDDO

            
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO II=1,NI
                     DO JJ=1,NJ
                        IBF = LOCI+II
                        JBF = LOCJ+JJ
                        LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                        I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                        I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                     ENDDO
                  ENDDO
               ENDDO

           ENDDO !ISH
         ! ENDDO !JSH
      ENDDO !KSH
!$omp end parallel do



      END SUBROUTINE






