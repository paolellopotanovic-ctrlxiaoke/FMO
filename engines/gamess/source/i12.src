                          P(3),PAV(3),CPV(3),               &
                          A1(3,4),B1(4),C1(4),           &
                          A2(3,4),B2(4),F00(4)

      double precision :: GGID(240)
      double precision :: DK(10),T1(168)
      double precision :: G3ID(288)
      double precision :: DBID(24)                      

      double precision :: TMP(3),VAL(3),VALL

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,MAXI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ,MAXJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,LB,NLJ


      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL
      double precision :: a1114,a5214,a1314,a6314,a8314,a3414,a5414,a4714

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj_tmp, iijj
      logical :: isL

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN


a1114 = TLL(1,1,14)
a5214 = TLL(5,2,14)
a1314 = TLL(1,3,14)
a6314 = TLL(6,3,14)
a8314 = TLL(8,3,14)
a3414 = TLL(3,4,14)
a5414 = TLL(5,4,14)
a4714 = TLL(4,7,14)


NROOTS=4
NJ=6
NK=10
NKS=7



!$omp parallel do default(none) &
!$omp shared(KMIN,KNG,KLOC,KAUXAT,C,KAUXNG,KAUXST,LOCSPH) &
!$omp shared(LOCKT_INIT,DAUX,TOL,EXAUX,I_P_SHL,I_D_SHL) &
!$omp shared(PD_VAL_PRE,KAUX_ELSE,NK,NJ,LOCPD,PD_DUM_PRE) &
!$omp shared(PD_P_PRE,PD_PAV_PRE,PD_DUM0_PRE,CCP,CCD,NROOTS) &
!$omp shared(NKS,I32,N_ELSE,N_P_SHL,N_D_SHL,PD_AB_PRE) &
!$omp shared(a1114,a5214,a1314,a6314,a8314,a3414,a5414,a4714) &
!$omp private(ISH,JSH,MINI,NI,NGI,LOCI,NGJ,LOCJ,VAL,KAUXSH,KAT) &
!$omp private(CC,NGK,K1,IAUXSTART,DK,GGID,IJ,DBID,G3ID,T1) &
!$omp private(ISL,JI,DUM,CPV,PAV,RR,DUM0,DUM2,AK,XX,U,AIINV) &
!$omp private(III,JJJ,AB,W,AIJINVSQ,AIJINV2,NLJ,IBF,JBF,LIJ) &
!$omp private(AJINV,AIINV2,AJINV2,B1,B2,A1,A2) 


DO iijj = 1, N_P_SHL*N_D_SHL
   III = (iijj-1)/N_D_SHL + 1
   JJJ = mod(iijj-1,N_D_SHL) + 1
   ISH = I_P_SHL(III)
   JSH = I_D_SHL(JJJ)

   MINI  = KMIN(ISH)
   isL = (MINI.EQ.1)
   NI=3
   IF(isL) NI=4
   NGI   = KNG(ISH)
   LOCI  = KLOC(ISH)-1

   NGJ   = KNG(JSH)
   LOCJ  = KLOC(JSH)-1

   VAL(1:3) = pd_VAL_PRE(1:3,iijj)


! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
   ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
   DO I_ELSE=1,N_ELSE
      ! DO ISH = 1,NSHELL
      KAUXSH = KAUX_ELSE(I_ELSE)

      KAT = KAUXAT(KAUXSH)
      CC(1) = C(1,KAT)
      CC(2) = C(2,KAT)
      CC(3) = C(3,KAT)

      NGK   = KAUXNG(KAUXSH)
      K1    = KAUXST(KAUXSH)

      ! AUX POINTER FOR I32
      IauxStart = LOCSPH(KAUXSH)
      IauxStart = IauxStart-LOCKT_init+1

! DO ISH = 1,NSHELL
!    DO JSH = 1,ISH
  
      ! DENSITY FACTOR
      DO K=1,NK
         DK(K) = PI252 * DAux(KAUXSH,1,K)
      ENDDO

      ! ZERO OUT INTEGRAL ARRAY
      DO II=1,NI*NJ*NK
         GGID(II)=zero
      ENDDO

      JI=0
      DO IG = 1, NGI  
         DO JG = 1, NGJ
            JI=JI+1
            AB = pd_AB_PRE(LOCpd(iijj)+JI)
            DUM = pd_DUM_PRE(LOCpd(iijj)+JI)
            IF (DUM > TOL) CYCLE
            CPV(1:3)= pd_P_PRE(1:3,LOCpd(iijj)+JI)
            PAV(1:3) = pd_PAV_PRE(1:3,LOCpd(iijj)+JI)
            CPV(1:3) = CC(1:3)-CPV(1:3)
            RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
            DUM0 = pd_DUM0_PRE(LOCpd(iijj)+JI)
            IJ = 0
            DO I=1,NI
               DUM2 = DUM0*CCP(I,IG,III)
               DO J=1,NJ
                  IJ = IJ+1
                  DBID(IJ) = DUM2*CCD(J,JG,JJJ)
               ENDDO
            ENDDO !I

            ! PRIMITIVE IN K-SHELL
            DO KG = 1, NGK
               AK = EXAUX(K1+KG-1)
               XX = AB*AK/(AB+AK)
               XX = XX*RR

               ! RYS ROOTS AND WEIGHT
               CALL ROOT4_gpu(XX,U,W,NROOTS)

               AIJINVSQ = one/(AB+AK)
               XX = AB*AK*AIJINVSQ
               AIINV  = one/AB
               AJINV  = one/AK
               AIINV2 = half*AIINV
               AJINV2 = half*AJINV
               AIJINV2 = half*AIJINVSQ
               AIJINVSQ = SQRT(AIJINVSQ)

               DO IR = 1, NROOTS
                  U(IR) = U(IR)*XX
                  U(IR) = U(IR)/(XX+U(IR))
                  B1(IR) = XX*AIINV*U(IR)
                  B2(IR) = XX*AJINV*U(IR)
                  A1(1:3,IR) = PAV(1:3)+B1(IR)*CPV(1:3)
                  A2(1:3,IR) = -B2(IR)*CPV(1:3)
                  B1(IR) = AIINV2-AIINV2*B1(IR)
                  B2(IR) = AJINV2-AJINV2*B2(IR)
                  U(IR) = AIJINV2*U(IR)
                  G3ID(3*IR) = AIJINVSQ*W(IR)
               ENDDO

DO IR=1,4
   G3ID(10+IR*3) = A1(1,IR)
   G3ID(11+IR*3) = A1(2,IR)
   G3ID(12+IR*3) = A1(3,IR)*G3ID(3*IR)
ENDDO
DO IR=1,4
   G3ID(58+IR*3) = A1(1,IR)*G3ID(10+IR*3) +  B1(IR)
   G3ID(59+IR*3) = A1(2,IR)*G3ID(11+IR*3) +  B1(IR)
   G3ID(60+IR*3) = A1(3,IR)*G3ID(12+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,4
   G3ID(46+IR*3) = A1(1,IR)*G3ID(58+IR*3) +  2*B1(IR)*G3ID(10+IR*3)
   G3ID(47+IR*3) = A1(2,IR)*G3ID(59+IR*3) +  2*B1(IR)*G3ID(11+IR*3)
   G3ID(48+IR*3) = A1(3,IR)*G3ID(60+IR*3) +  2*B1(IR)*G3ID(12+IR*3)
ENDDO
DO IR=1,4
   G3ID(70+IR*3) = A2(1,IR)
   G3ID(71+IR*3) = A2(2,IR)
   G3ID(72+IR*3) = A2(3,IR)*G3ID(3*IR)
ENDDO
DO IR=1,4
   G3ID(82+IR*3) =A1(1,IR)*G3ID(70+IR*3) +  U(IR)
   G3ID(83+IR*3) =A1(2,IR)*G3ID(71+IR*3) +  U(IR)
   G3ID(84+IR*3) =A1(3,IR)*G3ID(72+IR*3) +  U(IR)*G3ID(IR*3)
ENDDO
DO IR=1,4
   G3ID(130+IR*3) = A1(1,IR)*G3ID(82+IR*3) +  B1(IR)*G3ID(70+IR*3) +  U(IR)*G3ID(10+IR*3)
   G3ID(131+IR*3) = A1(2,IR)*G3ID(83+IR*3) +  B1(IR)*G3ID(71+IR*3) +  U(IR)*G3ID(11+IR*3)
   G3ID(132+IR*3) = A1(3,IR)*G3ID(84+IR*3) +  B1(IR)*G3ID(72+IR*3) +  U(IR)*G3ID(12+IR*3)
ENDDO
DO IR=1,4
   G3ID(118+IR*3) = A1(1,IR)*G3ID(130+IR*3) +  2*B1(IR)*G3ID(82+IR*3) +  U(IR)*G3ID(58+IR*3)
   G3ID(119+IR*3) = A1(2,IR)*G3ID(131+IR*3) +  2*B1(IR)*G3ID(83+IR*3) +  U(IR)*G3ID(59+IR*3)
   G3ID(120+IR*3) = A1(3,IR)*G3ID(132+IR*3) +  2*B1(IR)*G3ID(84+IR*3) +  U(IR)*G3ID(60+IR*3)
ENDDO
DO IR=1,4
   G3ID(142+IR*3) = A2(1,IR)*G3ID(70+IR*3) +  B2(IR)
   G3ID(143+IR*3) = A2(2,IR)*G3ID(71+IR*3) +  B2(IR)
   G3ID(144+IR*3) = A2(3,IR)*G3ID(72+IR*3) +  B2(IR)*G3ID(IR*3)
ENDDO
DO IR=1,4
   G3ID(154+IR*3) = A1(1,IR)*G3ID(142+IR*3) +  2*U(IR)*G3ID(70+IR*3)
   G3ID(155+IR*3) = A1(2,IR)*G3ID(143+IR*3) +  2*U(IR)*G3ID(71+IR*3)
   G3ID(156+IR*3) = A1(3,IR)*G3ID(144+IR*3) +  2*U(IR)*G3ID(72+IR*3)
ENDDO
DO IR=1,4
   G3ID(202+IR*3) = A1(1,IR)*G3ID(154+IR*3) +  B1(IR)*G3ID(142+IR*3) +  2*U(IR)*G3ID(82+IR*3)
   G3ID(203+IR*3) = A1(2,IR)*G3ID(155+IR*3) +  B1(IR)*G3ID(143+IR*3) +  2*U(IR)*G3ID(83+IR*3)
   G3ID(204+IR*3) = A1(3,IR)*G3ID(156+IR*3) +  B1(IR)*G3ID(144+IR*3) +  2*U(IR)*G3ID(84+IR*3)
ENDDO
DO IR=1,4
   G3ID(190+IR*3) = A1(1,IR)*G3ID(202+IR*3) +  2*B1(IR)*G3ID(154+IR*3) +  2*U(IR)*G3ID(130+IR*3)
   G3ID(191+IR*3) = A1(2,IR)*G3ID(203+IR*3) +  2*B1(IR)*G3ID(155+IR*3) +  2*U(IR)*G3ID(131+IR*3)
   G3ID(192+IR*3) = A1(3,IR)*G3ID(204+IR*3) +  2*B1(IR)*G3ID(156+IR*3) +  2*U(IR)*G3ID(132+IR*3)
ENDDO
DO IR=1,4
   G3ID(214+IR*3) = A2(1,IR)*G3ID(142+IR*3) +  2*B2(IR)*G3ID(70+IR*3)
   G3ID(215+IR*3) = A2(2,IR)*G3ID(143+IR*3) +  2*B2(IR)*G3ID(71+IR*3)
   G3ID(216+IR*3) = A2(3,IR)*G3ID(144+IR*3) +  2*B2(IR)*G3ID(72+IR*3)
ENDDO
DO IR=1,4
   G3ID(226+IR*3) = A1(1,IR)*G3ID(214+IR*3) +  3*U(IR)*G3ID(142+IR*3)
   G3ID(227+IR*3) = A1(2,IR)*G3ID(215+IR*3) +  3*U(IR)*G3ID(143+IR*3)
   G3ID(228+IR*3) = A1(3,IR)*G3ID(216+IR*3) +  3*U(IR)*G3ID(144+IR*3)
ENDDO
DO IR=1,4
   G3ID(274+IR*3) = A1(1,IR)*G3ID(226+IR*3) +  B1(IR)*G3ID(214+IR*3) +  3*U(IR)*G3ID(154+IR*3)
   G3ID(275+IR*3) = A1(2,IR)*G3ID(227+IR*3) +  B1(IR)*G3ID(215+IR*3) +  3*U(IR)*G3ID(155+IR*3)
   G3ID(276+IR*3) = A1(3,IR)*G3ID(228+IR*3) +  B1(IR)*G3ID(216+IR*3) +  3*U(IR)*G3ID(156+IR*3)
ENDDO
DO IR=1,4
   G3ID(262+IR*3) = A1(1,IR)*G3ID(274+IR*3) +  2*B1(IR)*G3ID(226+IR*3) +  3*U(IR)*G3ID(202+IR*3)
   G3ID(263+IR*3) = A1(2,IR)*G3ID(275+IR*3) +  2*B1(IR)*G3ID(227+IR*3) +  3*U(IR)*G3ID(203+IR*3)
   G3ID(264+IR*3) = A1(3,IR)*G3ID(276+IR*3) +  2*B1(IR)*G3ID(228+IR*3) +  3*U(IR)*G3ID(204+IR*3)
ENDDO
DO IR=1,4
   G3ID(22+IR*3) = VAL(1)  +  G3ID(10+IR*3)
   G3ID(23+IR*3) = VAL(2)  +  G3ID(11+IR*3)
   G3ID(24+IR*3) = VAL(3)*G3ID(IR*3) +  G3ID(12+IR*3)
ENDDO
DO IR=1,4
   G3ID(34+IR*3) = VAL(1)*G3ID(10+IR*3) +  G3ID(58+IR*3)
   G3ID(35+IR*3) = VAL(2)*G3ID(11+IR*3) +  G3ID(59+IR*3)
   G3ID(36+IR*3) = VAL(3)*G3ID(12+IR*3) +  G3ID(60+IR*3)
ENDDO
DO IR=1,4
   G3ID(58+IR*3) = VAL(1)*G3ID(58+IR*3) +  G3ID(46+IR*3)
   G3ID(59+IR*3) = VAL(2)*G3ID(59+IR*3) +  G3ID(47+IR*3)
   G3ID(60+IR*3) = VAL(3)*G3ID(60+IR*3) +  G3ID(48+IR*3)
ENDDO
DO IR=1,4
   G3ID(46+IR*3) = VAL(1)*G3ID(22+IR*3) +  G3ID(34+IR*3)
   G3ID(47+IR*3) = VAL(2)*G3ID(23+IR*3) +  G3ID(35+IR*3)
   G3ID(48+IR*3) = VAL(3)*G3ID(24+IR*3) +  G3ID(36+IR*3)
ENDDO
DO IR=1,4
   G3ID(58+IR*3) = VAL(1)*G3ID(34+IR*3) +  G3ID(58+IR*3)
   G3ID(59+IR*3) = VAL(2)*G3ID(35+IR*3) +  G3ID(59+IR*3)
   G3ID(60+IR*3) = VAL(3)*G3ID(36+IR*3) +  G3ID(60+IR*3)
ENDDO
DO IR=1,4
   G3ID(94+IR*3) = VAL(1)*G3ID(70+IR*3) +  G3ID(82+IR*3)
   G3ID(95+IR*3) = VAL(2)*G3ID(71+IR*3) +  G3ID(83+IR*3)
   G3ID(96+IR*3) = VAL(3)*G3ID(72+IR*3) +  G3ID(84+IR*3)
ENDDO
DO IR=1,4
   G3ID(106+IR*3) = VAL(1)*G3ID(82+IR*3) +  G3ID(130+IR*3)
   G3ID(107+IR*3) = VAL(2)*G3ID(83+IR*3) +  G3ID(131+IR*3)
   G3ID(108+IR*3) = VAL(3)*G3ID(84+IR*3) +  G3ID(132+IR*3)
ENDDO
DO IR=1,4
   G3ID(130+IR*3) = VAL(1)*G3ID(130+IR*3) +  G3ID(118+IR*3)
   G3ID(131+IR*3) = VAL(2)*G3ID(131+IR*3) +  G3ID(119+IR*3)
   G3ID(132+IR*3) = VAL(3)*G3ID(132+IR*3) +  G3ID(120+IR*3)
ENDDO
DO IR=1,4
   G3ID(118+IR*3) = VAL(1)*G3ID(94+IR*3) +  G3ID(106+IR*3)
   G3ID(119+IR*3) = VAL(2)*G3ID(95+IR*3) +  G3ID(107+IR*3)
   G3ID(120+IR*3) = VAL(3)*G3ID(96+IR*3) +  G3ID(108+IR*3)
ENDDO
DO IR=1,4
   G3ID(130+IR*3) = VAL(1)*G3ID(106+IR*3) +  G3ID(130+IR*3)
   G3ID(131+IR*3) = VAL(2)*G3ID(107+IR*3) +  G3ID(131+IR*3)
   G3ID(132+IR*3) = VAL(3)*G3ID(108+IR*3) +  G3ID(132+IR*3)
ENDDO
DO IR=1,4
   G3ID(166+IR*3) = VAL(1)*G3ID(142+IR*3) +  G3ID(154+IR*3)
   G3ID(167+IR*3) = VAL(2)*G3ID(143+IR*3) +  G3ID(155+IR*3)
   G3ID(168+IR*3) = VAL(3)*G3ID(144+IR*3) +  G3ID(156+IR*3)
ENDDO
DO IR=1,4
   G3ID(178+IR*3) = VAL(1)*G3ID(154+IR*3) +  G3ID(202+IR*3)
   G3ID(179+IR*3) = VAL(2)*G3ID(155+IR*3) +  G3ID(203+IR*3)
   G3ID(180+IR*3) = VAL(3)*G3ID(156+IR*3) +  G3ID(204+IR*3)
ENDDO
DO IR=1,4
   G3ID(202+IR*3) = VAL(1)*G3ID(202+IR*3) +  G3ID(190+IR*3)
   G3ID(203+IR*3) = VAL(2)*G3ID(203+IR*3) +  G3ID(191+IR*3)
   G3ID(204+IR*3) = VAL(3)*G3ID(204+IR*3) +  G3ID(192+IR*3)
ENDDO
DO IR=1,4
   G3ID(190+IR*3) = VAL(1)*G3ID(166+IR*3) +  G3ID(178+IR*3)
   G3ID(191+IR*3) = VAL(2)*G3ID(167+IR*3) +  G3ID(179+IR*3)
   G3ID(192+IR*3) = VAL(3)*G3ID(168+IR*3) +  G3ID(180+IR*3)
ENDDO
DO IR=1,4
   G3ID(202+IR*3) = VAL(1)*G3ID(178+IR*3) +  G3ID(202+IR*3)
   G3ID(203+IR*3) = VAL(2)*G3ID(179+IR*3) +  G3ID(203+IR*3)
   G3ID(204+IR*3) = VAL(3)*G3ID(180+IR*3) +  G3ID(204+IR*3)
ENDDO
DO IR=1,4
   G3ID(238+IR*3) = VAL(1)*G3ID(214+IR*3) +  G3ID(226+IR*3)
   G3ID(239+IR*3) = VAL(2)*G3ID(215+IR*3) +  G3ID(227+IR*3)
   G3ID(240+IR*3) = VAL(3)*G3ID(216+IR*3) +  G3ID(228+IR*3)
ENDDO
DO IR=1,4
   G3ID(250+IR*3) = VAL(1)*G3ID(226+IR*3) +  G3ID(274+IR*3)
   G3ID(251+IR*3) = VAL(2)*G3ID(227+IR*3) +  G3ID(275+IR*3)
   G3ID(252+IR*3) = VAL(3)*G3ID(228+IR*3) +  G3ID(276+IR*3)
ENDDO
DO IR=1,4
   G3ID(274+IR*3) = VAL(1)*G3ID(274+IR*3) +  G3ID(262+IR*3)
   G3ID(275+IR*3) = VAL(2)*G3ID(275+IR*3) +  G3ID(263+IR*3)
   G3ID(276+IR*3) = VAL(3)*G3ID(276+IR*3) +  G3ID(264+IR*3)
ENDDO
DO IR=1,4
   G3ID(262+IR*3) = VAL(1)*G3ID(238+IR*3) +  G3ID(250+IR*3)
   G3ID(263+IR*3) = VAL(2)*G3ID(239+IR*3) +  G3ID(251+IR*3)
   G3ID(264+IR*3) = VAL(3)*G3ID(240+IR*3) +  G3ID(252+IR*3)
ENDDO
DO IR=1,4
   G3ID(274+IR*3) = VAL(1)*G3ID(250+IR*3) +  G3ID(274+IR*3)
   G3ID(275+IR*3) = VAL(2)*G3ID(251+IR*3) +  G3ID(275+IR*3)
   G3ID(276+IR*3) = VAL(3)*G3ID(252+IR*3) +  G3ID(276+IR*3)
ENDDO


IF(isL) THEN
  XX = G3ID(265)*G3ID(3) + G3ID(268)*G3ID(6) + G3ID(271)*G3ID(9) + G3ID(274)*G3ID(12)
  GGID(1) = GGID(1) + DBID(1)*DK(1)*XX
  XX = G3ID(49)*G3ID(218)*G3ID(3) + G3ID(52)*G3ID(221)*G3ID(6) + G3ID(55)*G3ID(224)*G3ID(9) + G3ID(58)*G3ID(227)*G3ID(12)
  GGID(2) = GGID(2) + DBID(1)*DK(2)*XX
  XX = G3ID(49)*G3ID(219) + G3ID(52)*G3ID(222) + G3ID(55)*G3ID(225) + G3ID(58)*G3ID(228)
  GGID(3) = GGID(3) + DBID(1)*DK(3)*XX
  XX = G3ID(193)*G3ID(74)*G3ID(3) + G3ID(196)*G3ID(77)*G3ID(6) + G3ID(199)*G3ID(80)*G3ID(9) + G3ID(202)*G3ID(83)*G3ID(12)
  GGID(4) = GGID(4) + DBID(1)*DK(4)*XX
