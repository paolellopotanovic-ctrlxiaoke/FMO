GGID(54) = GGID(54) + DBID(18)*DK(3)*XX
ENDIF
                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG

       
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO II=1,NI
                     DO JJ=1,NJ
                        IBF = LOCI + II
                        JBF = LOCJ + JJ
                        LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                        I32(IBF,JBF,IauxStart+LNKS-1) = GGID(LIJ) 
                        I32(JBF,IBF,IauxStart+LNKS-1) = GGID(LIJ) 
                     ENDDO
                  ENDDO
               ENDDO

           ENDDO !ISH
         ! ENDDO !JSH
      ENDDO !KSH
!$omp end parallel do



      END SUBROUTINE


      SUBROUTINE RIMP2_X_FORM_I32_X212 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib
      use gpuGlobalRimp2Eng,only: zero,half,one,eight
      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCP,CCD
      use shellpairs,only: pd_PAV_PRE, &
                           pd_P_PRE,   &
                           pd_DUM0_PRE,&
                           pd_DUM_PRE, &
                           pd_AB_PRE,  &
                           pd_VAL_PRE, &
                           LOCpd,   &
                           N_pd_PRE
      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(3),W(3)
      integer :: NROOTS
      

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:MXLTOT),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,3),B1(3),C1(3),           &
                          A2(3,3),B2(3),F00(3)

      double precision :: GGID(72)
      double precision :: DK(100),T1(120)
      double precision :: G3ID(162)
      double precision :: DBID(24)
                        
      integer :: LLI(3,28),LLJ(3,28),LLK(3,28)

      double precision :: TMP(3),VAL(3),VALL

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,MAXI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ,MAXJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,LB,NLJ


      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL,a127

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj_tmp, iijj
      logical :: isL

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN

a127 = TLL(1,2,7)

NROOTS=3
NJ=6
NK=6
NKS=5

!$omp parallel do default(none) &
!$omp shared(KMIN,KNG,KLOC,KAUXAT,C,KAUXNG,KAUXST,LOCSPH) &
!$omp shared(LOCKT_INIT,DAUX,TOL,EXAUX,I_P_SHL,I_D_SHL,MINJ) &
!$omp shared(PD_VAL_PRE,KAUX_ELSE,NK,NJ,LOCPD,PD_DUM_PRE) &
!$omp shared(PD_P_PRE,PD_PAV_PRE,PD_DUM0_PRE,CCP,CCD,NROOTS) &
!$omp shared(A127,NKS,I32,N_ELSE,N_P_SHL,N_D_SHL,PD_AB_PRE) &
!$omp private(ISH,JSH,MINI,NI,NGI,LOCI,NGJ,LOCJ,VAL,KAUXSH,KAT,CC) &
!$omp private(NGK,K1,IAUXSTART,DK,GGID,T1,IJ,DBID,G3ID,ISL,JI,DUM) &
!$omp private(CPV,PAV,RR,DUM0,DUM2,AK,XX,U,AIINV,AJINV,AIINV2,AJINV2) &
!$omp private(B1,B2,A1,A2,III,JJJ,AB,W,AIJINVSQ,AIJINV2,NLJ,IBF,JBF,LIJ) 

DO iijj = 1, N_P_SHL*N_D_SHL
   III = (iijj-1)/N_D_SHL + 1
   JJJ = mod(iijj-1,N_D_SHL) + 1
   ISH = I_P_SHL(III)
   JSH = I_D_SHL(JJJ)

   MINI  = KMIN(ISH)
   isL = (MINI.EQ.1)
   NI=3
   IF(isL) NI=4
   NGI   = KNG(ISH)
   LOCI  = KLOC(ISH)-1

   NGJ   = KNG(JSH)
   LOCJ  = KLOC(JSH)-1

   VAL(1:3) = pd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
   ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
   DO I_ELSE=1,N_ELSE
      ! DO ISH = 1,NSHELL
      KAUXSH = KAUX_ELSE(I_ELSE)

      KAT = KAUXAT(KAUXSH)
      CC(1) = C(1,KAT)
      CC(2) = C(2,KAT)
      CC(3) = C(3,KAT)

      NGK   = KAUXNG(KAUXSH)
      K1    = KAUXST(KAUXSH)

      ! AUX POINTER FOR I32
      IauxStart = LOCSPH(KAUXSH)         
      IauxStart = IauxStart-LOCKT_init+1

      ! DO ISH = 1,NSHELL
      !    DO JSH = 1,ISH

      ! DENSITY FACTOR
      DO K=1,NK
         DK(K) = PI252 * DAux(KAUXSH,1,K)
      ENDDO

      ! ZERO OUT INTEGRAL ARRAY
      DO II=1,72
         GGID(II)=zero
      ENDDO

      DO II=1,24
         T1(II*5-2)=zero
         T1(II*5-1)=zero
         T1(II*5  )=zero
      ENDDO

      JI=0
      ! PRIMITIVE IN I-SHELL
      DO IG = 1, NGI                 
         ! PRIMITIVE IN J-SHELL
         DO JG = 1, NGJ
            JI=JI+1
            AB = pd_AB_PRE(LOCpd(iijj)+JI)
            DUM = pd_DUM_PRE(LOCpd(iijj)+JI)
            IF (DUM > TOL) CYCLE
            CPV(1:3)= pd_P_PRE(1:3,LOCpd(iijj)+JI)
            PAV(1:3) = pd_PAV_PRE(1:3,LOCpd(iijj)+JI)
            CPV(1:3) = CC(1:3)-CPV(1:3)
            RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
            DUM0 = pd_DUM0_PRE(LOCpd(iijj)+JI)

            IJ = 0
            DO I=1,NI
               DUM2 = DUM0*CCP(I,IG,III)
               DO J=1,NJ
                  IJ = IJ+1
                  DBID(IJ) = DUM2*CCD(J,JG,JJJ)
               ENDDO
            ENDDO !I

            ! PRIMITIVE IN K-SHELL
            DO KG = 1, NGK
               AK = EXAUX(K1+KG-1)
               XX = AB*AK/(AB+AK)
               XX = XX*RR

               ! RYS ROOTS AND WEIGHT
               CALL RT3_gpu(XX,U,W,NROOTS)

               AIJINVSQ = one/(AB+AK)
               XX = AB*AK*AIJINVSQ
               AIINV  = one/AB
               AJINV  = one/AK
               AIINV2 = half*AIINV
               AJINV2 = half*AJINV
               AIJINV2 = half*AIJINVSQ
               AIJINVSQ = SQRT(AIJINVSQ)

               DO IR = 1, NROOTS
                  U(IR) = U(IR)*XX
                  U(IR) = U(IR)/(XX+U(IR))
                  B1(IR) = XX*AIINV*U(IR)
                  B2(IR) = XX*AJINV*U(IR)
                  A1(1:3,IR) = PAV(1:3)+B1(IR)*CPV(1:3)
                  A2(1:3,IR) = -B2(IR)*CPV(1:3)
                  B1(IR) = AIINV2-AIINV2*B1(IR)
                  B2(IR) = AJINV2-AJINV2*B2(IR)
                  U(IR) = AIJINV2*U(IR)
                  G3ID(3*IR) = AIJINVSQ*W(IR)
