
      SUBROUTINE RT1_gpu(X,U,W,NROOTS)

      implicit none
!
!     *****   VERSION FEBRUARY 13,1975   *****
!    buu REFACTORED FOR OPENMP GPU COMPATIBILITY
!

      double precision,parameter :: PIE4 =7.85398163397448D-01

      double precision :: X 
      double precision :: U
      double precision :: W
      integer :: NROOTS

      double precision :: F1, Y, E

         
         ! ~~~ Start ~~~


! 0.0 <= x < 3e-7
   IF (X .LE. 3.0D-07) THEN
      U= 0.5D+00 -X/5.0D+00
      W= 1.0D+00 -X/3.0D+00
      RETURN
   ENDIF

! 3e-7 < x <= 1.0
   IF (X .GT. 3.0D-07 .AND. X .LE. 1.0D+00) THEN
      F1 = ((((((((-8.36313918003957D-08*X+1.21222603512827D-06 )*X- &
           1.15662609053481D-05 )*X+9.25197374512647D-05 )*X- &
           6.40994113129432D-04 )*X+3.78787044215009D-03 )*X- &
           1.85185172458485D-02 )*X+7.14285713298222D-02 )*X- &
           1.99999999997023D-01 )*X+3.33333333333318D-01
      W= (X+X)*F1+EXP(-X)
      U= F1/(W-F1)
      RETURN
   ENDIF

! 1.0 < x <= 3.0
   IF (X .GT. 1.0D+00 .AND. X .LE. 3.0D+00) THEN
      Y = X-2.0D+00
      F1 = ((((((((((-1.61702782425558D-10*Y+1.96215250865776D-09 )*Y- &
           2.14234468198419D-08 )*Y+2.17216556336318D-07 )*Y- &
           1.98850171329371D-06 )*Y+1.62429321438911D-05 )*Y- &
           1.16740298039895D-04 )*Y+7.24888732052332D-04 )*Y- &
           3.79490003707156D-03 )*Y+1.61723488664661D-02 )*Y- &
           5.29428148329736D-02 )*Y+1.15702180856167D-01
      W= (X+X)*F1+EXP(-X)
      U= F1/(W-F1)
      RETURN
   ENDIF

! 3.0 < x <= 5.0
   IF (X .GT. 3.0D+00 .AND. X .LE. 5.0D+00) THEN
      Y = X-4.0D+00
      F1 = ((((((((((-2.62453564772299D-11*Y+3.24031041623823D-10 )*Y- &
           3.614965656163D-09)*Y+3.760256799971D-08)*Y- &
           3.553558319675D-07)*Y+3.022556449731D-06)*Y- &
           2.290098979647D-05)*Y+1.526537461148D-04)*Y- &
           8.81947375894379D-04 )*Y+4.33207949514611D-03 )*Y- &
           1.75257821619926D-02 )*Y+5.28406320615584D-02
      W= (X+X)*F1+EXP(-X)
      U= F1/(W-F1)
      RETURN
   ENDIF

! 5.0 < x <= 10.0
   IF (X .GT. 5.0D+00 .AND. X .LE. 10.0D+00) THEN
      E = EXP(-X)
      W= (((((( 4.6897511375022D-01/X-6.9955602298985D-01)/X + &
           5.3689283271887D-01)/X-3.2883030418398D-01)/X + &
           2.4645596956002D-01)/X-4.9984072848436D-01)/X - &
           3.1501078774085D-06)*E + SQRT(PIE4/X)
      F1 = (W-E)/(X+X)
      U= F1/(W-F1)
      RETURN
   ENDIF

! 10.0 < x <= 15.0
   IF (X .GT. 10.0D+00 .AND. X .LE. 15.0D+00) THEN
      E = EXP(-X)
      W= (((-1.8784686463512D-01/X+2.2991849164985D-01)/X - &
           4.9893752514047D-01)/X-2.1916512131607D-05)*E + SQRT(PIE4/X)
      F1 = (W-E)/(X+X)
      U= F1/(W-F1)
      RETURN
   ENDIF


! 15.0 < x <= 33.0
   IF (X .GT. 15.0D+00 .AND. X .LE. 33.0D+00) THEN
      E = EXP(-X)
      W= (( 1.9623264149430D-01/X-4.9695241464490D-01)/X - &
           6.0156581186481D-05)*E + SQRT(PIE4/X)
      F1 = (W-E)/(X+X)
      U= F1/(W-F1)
      RETURN
   ENDIF


! x > 33.0
   IF (X .GT. 33.0D+00) THEN
      W= SQRT(PIE4/X)
      U= 0.5D+00/(X-0.5D+00)
      RETURN
   ENDIF


   END
