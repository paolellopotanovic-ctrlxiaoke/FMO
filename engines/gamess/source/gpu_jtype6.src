! J= 3
            IJ=8+32 + 64
            GPOPLE(1+IJ)=+( RD3(4,6))
            GPOPLE(2+IJ)=+( RD4(4))+( RD3(4,7))*AQC( 5)
            GPOPLE(3+IJ)=+( RD4(7))+( RD2(4,26))
            GPOPLE(4+IJ)=+( RD4(8))+( RD3(4,7))*AQC( 6)
   
! J= 4
            IJ= 12+32 + 64
            GPOPLE(1+IJ)=+( RD3(5,6))+( RD2(4,24))*AQC( 6)
            GPOPLE(2+IJ)=+( RD4(5))+( RD3(2,8))*AQC( 6) &
