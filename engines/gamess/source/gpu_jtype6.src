            GPOPLE(3+IJ)=+(-RD2(6,6)+RD1(2,5))
            GPOPLE(4+IJ)=+(-RD2(3,6)+RD1(3,5))+(-RD1(3,22)+RD0(2,2))*AQC( 6)
   
