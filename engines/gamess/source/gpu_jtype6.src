            GPOPLE(3+IJ)=+( RD2(4,1))+( RD1(2,4))*AQC( 5)
            GPOPLE(4+IJ)=+( RD2(5,1))+( RD1(3,4))*AQC( 5) &
                         +( RD1(1,3))*AQC( 6) &
                         +( RD0(4,1))*AQC( 5)*AQC( 6)
   
! J= 3
            IJ= 8 
            GPOPLE(1+IJ)=+( RD1(2,2))
            GPOPLE(2+IJ)=+( RD2(4,1))+( RD1(2,3))*AQC( 5)
            GPOPLE(3+IJ)=+( RD2(2,1))+( RD0(5,1))
            GPOPLE(4+IJ)=+( RD2(6,1))+( RD1(2,3))*AQC( 6)
   
! J= 4
            IJ= 12
            GPOPLE(1+IJ)=+( RD1(3,2))+( RD0(3,1))*AQC( 6)
            GPOPLE(2+IJ)=+( RD2(5,1))+( RD1(1,4))*AQC( 6) &
