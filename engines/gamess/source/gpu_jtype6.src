            GPOPLE(4+IJ)=+(-RD3(5,3))+(-RD2(4,12))*AQC( 6)
   
! J= 4
            IJ= 12 + 64
            GPOPLE(1+IJ)=+(-RD2(5,11))+(-RD1(1,28))*AQC( 6)
            GPOPLE(2+IJ)=+(-RD3(3,3))+(-RD2(1,13))*AQC( 6) &
                         +(-RD2(5,12))*AQC( 5) &
