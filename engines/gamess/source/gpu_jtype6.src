            GPOPLE(1)=+( RD0(1,1))
            GPOPLE(2)=+( RD1(1,1))+( RD0(2,1))*AQC( 5)
            GPOPLE(3)=+( RD1(2,1))
            GPOPLE(4)=+( RD1(3,1))+( RD0(2,1))*AQC( 6)
   
