            GPOPLE(3+IJ)=+( RD4( 2)+RD2(4,5))+( RD3(2,8)+RD1(2,20))*AQC( 5)
            GPOPLE(4+IJ)=+( RD4( 3)+RD2(5,5))+( RD3(3,8)+RD1(3,20))*AQC( 5) &
                         +( RD3(1,7)+RD1(1,19))*AQC( 6) &
                         +( RD2(1,25)+RD0(4,5))*AQC( 5)*AQC( 6)
   
! J= 3
