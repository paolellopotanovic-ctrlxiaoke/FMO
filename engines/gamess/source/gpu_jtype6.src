            GPOPLE(3+IJ)=+(-RD3( 8,2)+RD2(2,2))+(-RD1(3,25)+RD0(5,2))
            GPOPLE(4+IJ)=+(-RD3( 9,2)+RD2(6,2))+(-RD2(6,8)+RD1(2,7))*AQC( 6)
   
