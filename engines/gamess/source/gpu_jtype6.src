            GPOPLE(2+IJ)=+(-RD3( 6,2)+RD2(5,2))+(-RD2(5,9)+RD1(1,8))*AQC( 6) &
                         +(-RD2(3,8)+RD1(3,7))*AQC( 5) &
                         +(-RD1(3,24)+RD0(4,2))*AQC( 6)*AQC( 5)
            GPOPLE(3+IJ)=+(-RD3( 9,2)+RD2(6,2))+(-RD2(6,9)+RD1(2,8))*AQC( 6)
            GPOPLE(4+IJ)=+(-RD3(10,2)+RD2(3,2))+(-RD1(3,25)+RD0(5,2))       &
                         +(-RD2(3,8)+RD1(3,7))*AQC( 6) &
                         +(-RD2(3,9)+RD1(3,8))*AQC( 6) &
                         +(-RD1(3,24)+RD0(4,2))*AQC( 6)*AQC( 6)
   
!   L-loop=2
