            GPOPLE(2+IJ)=+(-RD3( 3,2)+RD2(1,2))+(-RD1(3,25)+RD0(5,2))       &
                         +(-RD2(5,8)+RD1(1,7))*AQC( 5) &
                         +(-RD2(5,9)+RD1(1,8))*AQC( 5) &
                         +(-RD1(3,24)+RD0(4,2))*AQC( 5)*AQC( 5)
            GPOPLE(3+IJ)=+(-RD3( 5,2)+RD2(4,2))+(-RD2(6,9)+RD1(2,8))*AQC( 5)
            GPOPLE(4+IJ)=+(-RD3( 6,2)+RD2(5,2))+(-RD2(3,9)+RD1(3,8))*AQC( 5) &
                         +(-RD2(5,8)+RD1(1,7))*AQC( 6) &
                         +(-RD1(3,24)+RD0(4,2))*AQC( 5)*AQC( 6)
   
! J= 3
            IJ=8+48 
