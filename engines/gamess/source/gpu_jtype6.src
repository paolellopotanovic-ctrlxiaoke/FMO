            GPOPLE(2+IJ)=+( RD3(1,5)+RD1(1,17))+( RD2(1,23)+RD0(2,5))*AQC( 5)
            GPOPLE(3+IJ)=+( RD3(2,5)+RD1(2,17))
            GPOPLE(4+IJ)=+( RD3(3,5)+RD1(3,17))+( RD2(1,23)+RD0(2,5))*AQC( 6)
   
! J= 2
            IJ= 4+16 + 64
            GPOPLE(1+IJ)=+( RD3(1,6)+RD1(1,18))+( RD2(1,24)+RD0(3,5))*AQC( 5)
            GPOPLE(2+IJ)=+( RD4( 1)+RD2(1,5))+( RD2(1,26)+RD0(5,5))       &
                         +( RD3(1,7)+RD1(1,19))*AQC( 5) &
