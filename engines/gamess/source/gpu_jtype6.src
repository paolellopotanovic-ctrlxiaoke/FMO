            GPOPLE(3+IJ)=+( RD4( 5)+RD2(6,5))+( RD3(2,8)+RD1(2,20))*AQC( 6)
            GPOPLE(4+IJ)=+( RD4( 6)+RD2(3,5))+( RD2(1,26)+RD0(5,5))       &
                         +( RD3(3,7)+RD1(3,19))*AQC( 6) &
                         +( RD3(3,8)+RD1(3,20))*AQC( 6) &
                         +( RD2(1,25)+RD0(4,5))*AQC( 6)*AQC( 6)
   
            IJ= 32 + 64
            GPOPLE(1+IJ)=+( RD2(4,22))
            GPOPLE(2+IJ)=+( RD3(2,5))+( RD2(4,23))*AQC( 5)
            GPOPLE(3+IJ)=+( RD3(4,5))
            GPOPLE(4+IJ)=+( RD3(5,5))+( RD2(4,23))*AQC( 6)
   
! J= 2
            IJ= 4+32 + 64
            GPOPLE(1+IJ)=+( RD3(2,6))+( RD2(4,24))*AQC( 5)
            GPOPLE(2+IJ)=+( RD4(2))+( RD2(4,26))       &
