            GPOPLE(2+IJ)=+( RD4( 2)+RD2(4,5))+( RD3(2,7)+RD1(2,19))*AQC( 5)
            GPOPLE(3+IJ)=+( RD4( 4)+RD2(2,5))+( RD2(1,26)+RD0(5,5))
            GPOPLE(4+IJ)=+( RD4( 5)+RD2(6,5))+( RD3(2,7)+RD1(2,19))*AQC( 6)
   
