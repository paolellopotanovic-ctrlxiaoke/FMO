            GPOPLE(3+IJ)=+(-RD2(2,6))
            GPOPLE(4+IJ)=+(-RD2(6,6))+(-RD1(2,22))*AQC( 6)
   
! J= 2
            IJ= 4+32 
            GPOPLE(1+IJ)=+(-RD2(4,7))+(-RD1(2,23))*AQC( 5)
            GPOPLE(2+IJ)=+(-RD3(2,2))+(-RD1(2,25))       &
                         +(-RD2(4,8))*AQC( 5) &
                         +(-RD2(4,9))*AQC( 5) &
