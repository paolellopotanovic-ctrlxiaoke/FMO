            GPOPLE(2+IJ)=+(-RD3(1,3))+(-RD1(1,30))       &
                         +(-RD2(1,12))*AQC( 5) &
                         +(-RD2(1,13))*AQC( 5) &
                         +(-RD1(1,29))*AQC( 5)*AQC( 5)
            GPOPLE(3+IJ)=+(-RD3(2,3))+(-RD2(4,13))*AQC( 5)
            GPOPLE(4+IJ)=+(-RD3(3,3))+(-RD2(5,13))*AQC( 5) &
                         +(-RD2(1,12))*AQC( 6) &
                         +(-RD1(1,29))*AQC( 5)*AQC( 6)
   
