            GPOPLE(2+IJ)=+(-RD3(4,2))+(-RD2(2,8))*AQC( 5)
            GPOPLE(3+IJ)=+(-RD3(7,2))+(-RD1(2,25))
            GPOPLE(4+IJ)=+(-RD3(8,2))+(-RD2(2,8))*AQC( 6)
   
! J= 4
