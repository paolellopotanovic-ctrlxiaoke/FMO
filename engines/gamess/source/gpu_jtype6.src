                         +(RD3( 6,8)-RD2(5,17)-RD2(5,21)+RD1(1,16)+RD1(1,20))*AQC( 6) &
                         +(RD3(10,7)-RD2(3,16)-RD2(3,20)+RD1(3,15)+RD1(3,19))*AQC( 5) &
                         +(RD2(3,25)-RD1(3,34)-RD1(3,39)+RD0(4,4)+RD0(4,5))*AQC( 6)*AQC( 5)
            GPOPLE(3+IJ)=+(RD4(14)-RD3( 9,1)-RD3( 9,4)+RD2(6,4)+RD2(6,5)) &
                         +(RD3( 9,8)-RD2(6,17)-RD2(6,21)+RD1(2,16)+RD1(2,20))*AQC( 6)
            GPOPLE(4+IJ)=+(RD4(15)-RD3(10,1)-RD3(10,4)+RD2(3,4)+RD2(3,5)) &
                         +(RD2(3,26)-RD1(3,35)-RD1(3,40)+RD0(5,4)+RD0(5,5))       &
                         +(RD3(10,7)-RD2(3,16)-RD2(3,20)+RD1(3,15)+RD1(3,19))*AQC( 6) &
                         +(RD3(10,8)-RD2(3,17)-RD2(3,21)+RD1(3,16)+RD1(3,20))*AQC( 6) &
                         +(RD2(3,25)-RD1(3,34)-RD1(3,39)+RD0(4,4)+RD0(4,5))*AQC( 6)*AQC( 6)
   
   
      !IF(.NOT.LSYM06) GOTO 060
! I=1-4, J=1-4:  IJ= 16*(K-1) + 64*(L-1)
      DO J=1,4
         DO I=1,4
            IJ= I + 4*(J-1)
            GPOPLE(IJ+144)= GPOPLE(IJ+96)
         ENDDO
      ENDDO
   
! sum integral TGPU_R30S1S_J6
! GPOPLE(I,J,K,L) to 1D --> i + 4*(j-1) + 16*(k-1) + 64*(l-1)
                   !T(IFT-1)= GPOPLE(I,J,K,IFT)
         DO K=1,4
            DO J=1,4
               DO I=1,4
                  IJ= I+ 4*(J-1)+ 16*(K-1)
                  T(1)= GPOPLE(IJ+ 64)
                  T(2)= GPOPLE(IJ+128)
                  T(3)= GPOPLE(IJ+192)
                  GPOPLE(IJ+ 64)= T(1)*P(1,1)+T(2)*P(2,1)+T(3)*P(3,1)
                  GPOPLE(IJ+128)= T(1)*P(1,2)+T(2)*P(2,2)+T(3)*P(3,2)
                  GPOPLE(IJ+192)= T(1)*P(1,3)+T(2)*P(2,3)+T(3)*P(3,3)
               ENDDO
            ENDDO
         ENDDO
         DO L=1,4
            DO J=1,4
               DO I=1,4
                  IJ= I +4*(J-1) +64*(L-1)
                  T(1)=GPOPLE(IJ+16) 
                  T(2)=GPOPLE(IJ+32) 
                  T(3)=GPOPLE(IJ+48) 

                  GPOPLE(IJ+16)= T(1)*P(1,1)+T(2)*P(2,1)+T(3)*P(3,1)
                  GPOPLE(IJ+32)= T(1)*P(1,2)+T(2)*P(2,2)+T(3)*P(3,2)
                  GPOPLE(IJ+48)= T(1)*P(1,3)+T(2)*P(2,3)+T(3)*P(3,3)
               ENDDO
            ENDDO
         ENDDO
         DO L=1,4
            DO K=1,4
               DO I=1,4
                  IJ= I +16*(K-1) +64*(L-1)
                  T(1)=GPOPLE(IJ+ 4)
                  T(2)=GPOPLE(IJ+ 8)
                  T(3)=GPOPLE(IJ+12)

                  GPOPLE(IJ+ 4)= T(1)*P(1,1)+T(2)*P(2,1)+T(3)*P(3,1)
                  GPOPLE(IJ+ 8)= T(1)*P(1,2)+T(2)*P(2,2)+T(3)*P(3,2)
                  GPOPLE(IJ+12)= T(1)*P(1,3)+T(2)*P(2,3)+T(3)*P(3,3)
               ENDDO
            ENDDO
         ENDDO
         DO L=1,4
            DO K=1,4
               DO J=1,4
                   IJ=  4*(J-1) +16*(K-1) +64*(L-1)
                  T(1)=GPOPLE(2+IJ)
                  T(2)=GPOPLE(3+IJ)
                  T(3)=GPOPLE(4+IJ)

                  GPOPLE(2+IJ)= T(1)*P(1,1)+T(2)*P(2,1)+T(3)*P(3,1)
                  GPOPLE(3+IJ)= T(1)*P(1,2)+T(2)*P(2,2)+T(3)*P(3,2)
                  GPOPLE(4+IJ)= T(1)*P(1,3)+T(2)*P(2,3)+T(3)*P(3,3)
               ENDDO
            ENDDO
         ENDDO

!--------------------------- END sum the integral  ------------------------------   
      RETURN
      END
 end module mod_jtype6
