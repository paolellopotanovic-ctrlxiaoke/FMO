T1(119) = T1(119) + DBID(24)*DK(5)*VALL
VALL = G3ID(13)*G3ID(158)*G3ID(147) + G3ID(16)*G3ID(161)*G3ID(150) + G3ID(19)*G3ID(164)*G3ID(153) + G3ID(22)*G3ID(167)*G3ID(156)
T1(120) = T1(120) + DBID(24)*DK(6)*VALL
VALL = G3ID(193)*G3ID(110)*G3ID(15) + G3ID(196)*G3ID(113)*G3ID(18) + G3ID(199)*G3ID(116)*G3ID(21) + G3ID(202)*G3ID(119)*G3ID(24)
T1(123) = T1(123) + DBID(25)*DK(4)*VALL
VALL = G3ID(193)*G3ID(123) + G3ID(196)*G3ID(126) + G3ID(199)*G3ID(129) + G3ID(202)*G3ID(132)
T1(124) = T1(124) + DBID(25)*DK(5)*VALL
VALL = G3ID(85)*G3ID(110)*G3ID(123) + G3ID(88)*G3ID(113)*G3ID(126) + G3ID(91)*G3ID(116)*G3ID(129) + G3ID(94)*G3ID(119)*G3ID(132)
T1(125) = T1(125) + DBID(25)*DK(6)*VALL
VALL = G3ID(121)*G3ID(182)*G3ID(15) + G3ID(124)*G3ID(185)*G3ID(18) + G3ID(127)*G3ID(188)*G3ID(21) + G3ID(130)*G3ID(191)*G3ID(24)
T1(128) = T1(128) + DBID(26)*DK(4)*VALL
VALL = G3ID(121)*G3ID(74)*G3ID(123) + G3ID(124)*G3ID(77)*G3ID(126) + G3ID(127)*G3ID(80)*G3ID(129) + G3ID(130)*G3ID(83)*G3ID(132)
T1(129) = T1(129) + DBID(26)*DK(5)*VALL
VALL = G3ID(13)*G3ID(182)*G3ID(123) + G3ID(16)*G3ID(185)*G3ID(126) + G3ID(19)*G3ID(188)*G3ID(129) + G3ID(22)*G3ID(191)*G3ID(132)
T1(130) = T1(130) + DBID(26)*DK(6)*VALL
VALL = G3ID(121)*G3ID(110)*G3ID(87) + G3ID(124)*G3ID(113)*G3ID(90) + G3ID(127)*G3ID(116)*G3ID(93) + G3ID(130)*G3ID(119)*G3ID(96)
T1(133) = T1(133) + DBID(27)*DK(4)*VALL
VALL = G3ID(121)*G3ID(195) + G3ID(124)*G3ID(198) + G3ID(127)*G3ID(201) + G3ID(130)*G3ID(204)
T1(134) = T1(134) + DBID(27)*DK(5)*VALL
VALL = G3ID(13)*G3ID(110)*G3ID(195) + G3ID(16)*G3ID(113)*G3ID(198) + G3ID(19)*G3ID(116)*G3ID(201) + G3ID(22)*G3ID(119)*G3ID(204)
T1(135) = T1(135) + DBID(27)*DK(6)*VALL
VALL = G3ID(157)*G3ID(146)*G3ID(15) + G3ID(160)*G3ID(149)*G3ID(18) + G3ID(163)*G3ID(152)*G3ID(21) + G3ID(166)*G3ID(155)*G3ID(24)
T1(138) = T1(138) + DBID(28)*DK(4)*VALL
VALL = G3ID(157)*G3ID(38)*G3ID(123) + G3ID(160)*G3ID(41)*G3ID(126) + G3ID(163)*G3ID(44)*G3ID(129) + G3ID(166)*G3ID(47)*G3ID(132)
T1(139) = T1(139) + DBID(28)*DK(5)*VALL
VALL = G3ID(49)*G3ID(146)*G3ID(123) + G3ID(52)*G3ID(149)*G3ID(126) + G3ID(55)*G3ID(152)*G3ID(129) + G3ID(58)*G3ID(155)*G3ID(132)
T1(140) = T1(140) + DBID(28)*DK(6)*VALL
VALL = G3ID(157)*G3ID(110)*G3ID(51) + G3ID(160)*G3ID(113)*G3ID(54) + G3ID(163)*G3ID(116)*G3ID(57) + G3ID(166)*G3ID(119)*G3ID(60)
T1(143) = T1(143) + DBID(29)*DK(4)*VALL
VALL = G3ID(157)*G3ID(159) + G3ID(160)*G3ID(162) + G3ID(163)*G3ID(165) + G3ID(166)*G3ID(168)
T1(144) = T1(144) + DBID(29)*DK(5)*VALL
VALL = G3ID(49)*G3ID(110)*G3ID(159) + G3ID(52)*G3ID(113)*G3ID(162) + G3ID(55)*G3ID(116)*G3ID(165) + G3ID(58)*G3ID(119)*G3ID(168)
T1(145) = T1(145) + DBID(29)*DK(6)*VALL
VALL = G3ID(121)*G3ID(146)*G3ID(51) + G3ID(124)*G3ID(149)*G3ID(54) + G3ID(127)*G3ID(152)*G3ID(57) + G3ID(130)*G3ID(155)*G3ID(60)
T1(148) = T1(148) + DBID(30)*DK(4)*VALL
VALL = G3ID(121)*G3ID(38)*G3ID(159) + G3ID(124)*G3ID(41)*G3ID(162) + G3ID(127)*G3ID(44)*G3ID(165) + G3ID(130)*G3ID(47)*G3ID(168)
T1(149) = T1(149) + DBID(30)*DK(5)*VALL
VALL = G3ID(13)*G3ID(146)*G3ID(159) + G3ID(16)*G3ID(149)*G3ID(162) + G3ID(19)*G3ID(152)*G3ID(165) + G3ID(22)*G3ID(155)*G3ID(168)
T1(150) = T1(150) + DBID(30)*DK(6)*VALL
VALL = G3ID(181)*G3ID(122)*G3ID(15) + G3ID(184)*G3ID(125)*G3ID(18) + G3ID(187)*G3ID(128)*G3ID(21) + G3ID(190)*G3ID(131)*G3ID(24)
T1(153) = T1(153) + DBID(31)*DK(4)*VALL
VALL = G3ID(181)*G3ID(14)*G3ID(123) + G3ID(184)*G3ID(17)*G3ID(126) + G3ID(187)*G3ID(20)*G3ID(129) + G3ID(190)*G3ID(23)*G3ID(132)
T1(154) = T1(154) + DBID(31)*DK(5)*VALL
VALL = G3ID(73)*G3ID(122)*G3ID(123) + G3ID(76)*G3ID(125)*G3ID(126) + G3ID(79)*G3ID(128)*G3ID(129) + G3ID(82)*G3ID(131)*G3ID(132)
T1(155) = T1(155) + DBID(31)*DK(6)*VALL
VALL = G3ID(109)*G3ID(194)*G3ID(15) + G3ID(112)*G3ID(197)*G3ID(18) + G3ID(115)*G3ID(200)*G3ID(21) + G3ID(118)*G3ID(203)*G3ID(24)
T1(158) = T1(158) + DBID(32)*DK(4)*VALL
VALL = G3ID(109)*G3ID(86)*G3ID(123) + G3ID(112)*G3ID(89)*G3ID(126) + G3ID(115)*G3ID(92)*G3ID(129) + G3ID(118)*G3ID(95)*G3ID(132)
T1(159) = T1(159) + DBID(32)*DK(5)*VALL
VALL = G3ID(194)*G3ID(123) + G3ID(197)*G3ID(126) + G3ID(200)*G3ID(129) + G3ID(203)*G3ID(132)
T1(160) = T1(160) + DBID(32)*DK(6)*VALL
VALL = G3ID(109)*G3ID(122)*G3ID(87) + G3ID(112)*G3ID(125)*G3ID(90) + G3ID(115)*G3ID(128)*G3ID(93) + G3ID(118)*G3ID(131)*G3ID(96)
T1(163) = T1(163) + DBID(33)*DK(4)*VALL
VALL = G3ID(109)*G3ID(14)*G3ID(195) + G3ID(112)*G3ID(17)*G3ID(198) + G3ID(115)*G3ID(20)*G3ID(201) + G3ID(118)*G3ID(23)*G3ID(204)
T1(164) = T1(164) + DBID(33)*DK(5)*VALL
VALL = G3ID(122)*G3ID(195) + G3ID(125)*G3ID(198) + G3ID(128)*G3ID(201) + G3ID(131)*G3ID(204)
T1(165) = T1(165) + DBID(33)*DK(6)*VALL
VALL = G3ID(145)*G3ID(158)*G3ID(15) + G3ID(148)*G3ID(161)*G3ID(18) + G3ID(151)*G3ID(164)*G3ID(21) + G3ID(154)*G3ID(167)*G3ID(24)
T1(168) = T1(168) + DBID(34)*DK(4)*VALL
VALL = G3ID(145)*G3ID(50)*G3ID(123) + G3ID(148)*G3ID(53)*G3ID(126) + G3ID(151)*G3ID(56)*G3ID(129) + G3ID(154)*G3ID(59)*G3ID(132)
T1(169) = T1(169) + DBID(34)*DK(5)*VALL
VALL = G3ID(37)*G3ID(158)*G3ID(123) + G3ID(40)*G3ID(161)*G3ID(126) + G3ID(43)*G3ID(164)*G3ID(129) + G3ID(46)*G3ID(167)*G3ID(132)
T1(170) = T1(170) + DBID(34)*DK(6)*VALL
VALL = G3ID(145)*G3ID(122)*G3ID(51) + G3ID(148)*G3ID(125)*G3ID(54) + G3ID(151)*G3ID(128)*G3ID(57) + G3ID(154)*G3ID(131)*G3ID(60)
T1(173) = T1(173) + DBID(35)*DK(4)*VALL
VALL = G3ID(145)*G3ID(14)*G3ID(159) + G3ID(148)*G3ID(17)*G3ID(162) + G3ID(151)*G3ID(20)*G3ID(165) + G3ID(154)*G3ID(23)*G3ID(168)
T1(174) = T1(174) + DBID(35)*DK(5)*VALL
VALL = G3ID(37)*G3ID(122)*G3ID(159) + G3ID(40)*G3ID(125)*G3ID(162) + G3ID(43)*G3ID(128)*G3ID(165) + G3ID(46)*G3ID(131)*G3ID(168)
T1(175) = T1(175) + DBID(35)*DK(6)*VALL
VALL = G3ID(109)*G3ID(158)*G3ID(51) + G3ID(112)*G3ID(161)*G3ID(54) + G3ID(115)*G3ID(164)*G3ID(57) + G3ID(118)*G3ID(167)*G3ID(60)
T1(178) = T1(178) + DBID(36)*DK(4)*VALL
VALL = G3ID(109)*G3ID(50)*G3ID(159) + G3ID(112)*G3ID(53)*G3ID(162) + G3ID(115)*G3ID(56)*G3ID(165) + G3ID(118)*G3ID(59)*G3ID(168)
T1(179) = T1(179) + DBID(36)*DK(5)*VALL
VALL = G3ID(158)*G3ID(159) + G3ID(161)*G3ID(162) + G3ID(164)*G3ID(165) + G3ID(167)*G3ID(168)
T1(180) = T1(180) + DBID(36)*DK(6)*VALL

                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG

               DO II=1,36
                  T1(II*5-4) = -half*(GGID(II*3-2)+GGID(II*3-1))+GGID(II*3)
                  T1(II*5-3) =  a127*(GGID(II*3-2)-GGID(II*3-1))
               ENDDO
            
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO II=1,NI
                     DO JJ=1,NJ
                        IBF = LOCI+II
                        JBF = LOCJ+JJ
                        LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                        I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                        I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                     ENDDO
                  ENDDO
               ENDDO

         ENDDO 
      ENDDO 
!$omp end parallel do


      END SUBROUTINE


      SUBROUTINE RIMP2_X_FORM_I32_X322 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAtm,DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCD
      use shellpairs,only: dd_PAV_PRE, &
                           dd_P_PRE,   &
                           dd_DUM0_PRE,&
                           dd_DUM_PRE, &
                           dd_AB_PRE,  &
                           dd_VAL_PRE, &
                           LOCdd,   &
                           N_dd_PRE
      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(4),W(4)
      integer :: NROOTS
      
      ! OUTPUT
      ! double precision :: GG(NI*NJ*NK)
      ! double precision :: GG(MXBSH*MXBSH*MXBSH)
      double precision :: VALL

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:MXLTOT),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,4),B1(4),C1(4),           &
                          A2(3,4),B2(4),F00(4)

      double precision :: GGID(360)
      double precision :: DK(10),T1(256)
      ! double precision :: G2ID(728) !3*nroots*(LI+LJ)*LK
      double precision :: G3ID(432) !3*nroots*LI*LJ*LK
      double precision :: DBID(36) 
                        
      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,NGI, &
                 LI,LOCI,I1,IG, &
                 JSH,JAT,NJ,&
                 NGJ,LJ,LOCJ,J1,JG

      integer :: LTOT,LB,NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL
      double precision :: a1114,a4714,a5214,a1314,a6314,a8314,a5414


      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,iijj,iijj_tmp,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN

a1114 = TLL(1,1,14)  
a4714 = TLL(4,7,14)  
a5214 = TLL(5,2,14)  
a1314 = TLL(1,3,14)  
a6314 = TLL(6,3,14)  
a8314 = TLL(8,3,14)  
a5414 = TLL(5,4,14)  




LI = 2
NI = 6
LJ = 2
NJ = 6

LK = 3
NKS = 7
NK = 10
NROOTS=4



!$omp parallel do default(none) &
!$omp shared(I_D_SHL,KNG,KLOC,DD_VAL_PRE,KAUX_ELSE,KAUXNG) &
!$omp shared(KAUXST,KAUXAT,C,LOCSPH,LOCKT_INIT,DAUX,LOCDD) &
!$omp shared(DD_DUM_PRE,TOL,DD_P_PRE,DD_PAV_PRE,DD_DUM0_PRE) &
!$omp shared(CCD,EXAUX,I32,N_ELSE,N_D_SHL,DD_AB_PRE) &
!$omp shared(LI,NI,LJ,NJ,NROOTS,NKS,NK) &
!$omp shared(a1114,a4714,a5214,a1314,a6314,a8314,a5414) &
!$omp private(T1,ISH,JSH,MINK,MAXK,MINKT,MAXKT,AJINV2,B2) &
!$omp private(NGI,LOCI,NGJ,LOCJ,KAUXSH,NGK,K1,KAT) &
!$omp private(CC,IAUXSTART,DK,GGID,IJ,DBID,G3ID,VALL,IBF,JBF,LIJ) &
!$omp private(VAL,AB,DUM,CPV,PAV,RR,DUM0,DUM2,AK,RHO,XX,U) &
!$omp private(VAL1,A1,B1,F00,III,JJJ,IIJJ,N3,N3B,N3I,N3IJ,JI,AIJINV) &
!$omp private(AIINV,AJINV,AIINV2,AIJINVSQ,W,AIJINV2,VAL2,A2,C1,NLJ)




         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH
DO iijj_tmp = 0, N_D_SHL*(N_D_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

      ISH = I_D_SHL(III)
      JSH = I_D_SHL(JJJ)

               NGI   = KNG(ISH)
               LOCI  = KLOC(ISH)-1

               NGJ   = KNG(JSH)
               LOCJ  = KLOC(JSH)-1

         VAL(1:3) = dd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)


         KAT = KAUXAT(KAUXSH)
         CC(1) = C(1,KAT)
         CC(2) = C(2,KAT)
         CC(3) = C(3,KAT)


               ! AUX POINTER FOR I32
               IauxStart = LOCSPH(KAUXSH)
               IauxStart = IauxStart-LOCKT_init+1

               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K) = PI252 * DAux(KAUXSH,1,K)
               ENDDO


               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,36*NK
                  GGID(II)=zero
               ENDDO
            JI=0
               ! PRIMITIVE IN I-SHELL
               DO IG = 1, NGI                 
                  ! PRIMITIVE IN J-SHELL
                  DO JG = 1, NGJ
                  JI = JI + 1
                     AB = dd_AB_PRE(LOCdd(iijj)+JI)
                     DUM = dd_DUM_PRE(LOCdd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3) = dd_P_PRE(1:3,LOCdd(iijj)+JI)
                     PAV(1:3) = dd_PAV_PRE(1:3,LOCdd(iijj)+JI)
                     CPV(1:3) = CC(1:3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = dd_DUM0_PRE(LOCdd(iijj)+JI)

                     IJ = 0
                     DO I=1,NI
                        DUM2 = DUM0*CCD(I,IG,III)
                        DO J=1,NJ
                           IJ = IJ+1
                           DBID(IJ) = DUM2*CCD(J,JG,JJJ)
                        ENDDO
                     ENDDO !I


                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        CALL ROOT4_gpu(XX,U,W,NROOTS)

                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AJINV2 = half*AJINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           B2(IR) = AJINV2-AJINV2*VAL2
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G3ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO
DO IR=1,4
   G3ID(10+IR*3) = A1(1,IR)
   G3ID(11+IR*3) = A1(2,IR)
   G3ID(12+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,4
   G3ID(22+IR*3) = A1(1,IR)*G3ID(10+IR*3) +  B1(IR)
   G3ID(23+IR*3) = A1(2,IR)*G3ID(11+IR*3) +  B1(IR)
   G3ID(24+IR*3) = A1(3,IR)*G3ID(12+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,4
   G3ID(94+IR*3) = A1(1,IR)*G3ID(22+IR*3) +  2*B1(IR)*G3ID(10+IR*3)
   G3ID(95+IR*3) = A1(2,IR)*G3ID(23+IR*3) +  2*B1(IR)*G3ID(11+IR*3)
   G3ID(96+IR*3) = A1(3,IR)*G3ID(24+IR*3) +  2*B1(IR)*G3ID(12+IR*3)
ENDDO
DO IR=1,4
