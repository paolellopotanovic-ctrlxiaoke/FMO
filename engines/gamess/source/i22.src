NK = 6
NROOTS=4


!$omp parallel do default(none) &
!$omp shared(I_D_SHL,KNG,KLOC,DD_VAL_PRE,KAUX_ELSE,KAUXNG) &
!$omp shared(KAUXST,KAUXAT,C,LOCSPH,LOCKT_INIT,DAUX,LOCDD) &
!$omp shared(DD_DUM_PRE,TOL,DD_P_PRE,DD_PAV_PRE,DD_DUM0_PRE) &
!$omp shared(CCD,EXAUX,I32,N_ELSE,N_D_SHL,DD_AB_PRE,A127) &
!$omp shared(LI,NI,LJ,NJ,NROOTS,NKS,NK) &
!$omp private(T1,ISH,JSH,MINK,MAXK,MINKT,MAXKT,AJINV2,B2) &
!$omp private(NGI,LOCI,NGJ,LOCJ,KAUXSH,NGK,K1,KAT) &
!$omp private(CC,IAUXSTART,DK,GGID,IJ,DBID,G3ID,VALL,IBF,JBF,LIJ) &
!$omp private(VAL,AB,DUM,CPV,PAV,RR,DUM0,DUM2,AK,RHO,XX,U) &
!$omp private(VAL1,A1,B1,F00,III,JJJ,IIJJ,N3,N3B,N3I,N3IJ,JI,AIJINV) &
!$omp private(AIINV,AJINV,AIINV2,AIJINVSQ,W,AIJINV2,VAL2,A2,C1,NLJ)

         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH
DO iijj_tmp = 0, N_D_SHL*(N_D_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

      ISH = I_D_SHL(III)
      JSH = I_D_SHL(JJJ)

               NGI   = KNG(ISH)
               LOCI  = KLOC(ISH)-1

               NGJ   = KNG(JSH)
               LOCJ  = KLOC(JSH)-1

         VAL(1:3) = dd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)


         KAT = KAUXAT(KAUXSH)
         CC(1) = C(1,KAT)
         CC(2) = C(2,KAT)
         CC(3) = C(3,KAT)

               ! AUX POINTER FOR I32
               IauxStart = LOCSPH(KAUXSH)
               IauxStart = IauxStart-LOCKT_init+1

               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K) = PI252 * DAux(KAUXSH,1,K)
               ENDDO

               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,108
                  GGID(II)=zero
               ENDDO

               DO II=1,36
                  T1(II*5-2) = zero
                  T1(II*5-1) = zero
                  T1(II*5  ) = zero
               ENDDO



            JI=0
               ! PRIMITIVE IN I-SHELL
               DO IG = 1, NGI                 
                  ! PRIMITIVE IN J-SHELL
                  DO JG = 1, NGJ
                  JI = JI + 1
                     AB = dd_AB_PRE(LOCdd(iijj)+JI)
                     DUM = dd_DUM_PRE(LOCdd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3) = dd_P_PRE(1:3,LOCdd(iijj)+JI)
                     PAV(1:3) = dd_PAV_PRE(1:3,LOCdd(iijj)+JI)
                     CPV(1:3) = CC(1:3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = dd_DUM0_PRE(LOCdd(iijj)+JI)

                     IJ = 0
                     DO I=1,NI
                        DUM2 = DUM0*CCD(I,IG,III)
                        DO J=1,NJ
                           IJ = IJ+1
                           DBID(IJ) = DUM2*CCD(J,JG,JJJ)
                        ENDDO
                     ENDDO !I


                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        CALL ROOT4_gpu(XX,U,W,NROOTS)

                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AJINV2 = half*AJINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           B2(IR) = AJINV2-AJINV2*VAL2
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G3ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO

DO IR=1,4
  G3ID(10+IR*3) = A1(1,IR)
  G3ID(11+IR*3) = A1(2,IR)
  G3ID(12+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,4
  G3ID(22+IR*3) = A1(1,IR)*G3ID(10+IR*3) +  B1(IR)
  G3ID(23+IR*3) = A1(2,IR)*G3ID(11+IR*3) +  B1(IR)
  G3ID(24+IR*3) = A1(3,IR)*G3ID(12+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,4
  G3ID(94+IR*3) = A1(1,IR)*G3ID(22+IR*3) +  2*B1(IR)*G3ID(10+IR*3)
  G3ID(95+IR*3) = A1(2,IR)*G3ID(23+IR*3) +  2*B1(IR)*G3ID(11+IR*3)
  G3ID(96+IR*3) = A1(3,IR)*G3ID(24+IR*3) +  2*B1(IR)*G3ID(12+IR*3)
ENDDO
DO IR=1,4
  G3ID(70+IR*3) = A1(1,IR)*G3ID(94+IR*3) +  3*B1(IR)*G3ID(22+IR*3)
  G3ID(71+IR*3) = A1(2,IR)*G3ID(95+IR*3) +  3*B1(IR)*G3ID(23+IR*3)
  G3ID(72+IR*3) = A1(3,IR)*G3ID(96+IR*3) +  3*B1(IR)*G3ID(24+IR*3)
ENDDO
DO IR=1,4
  G3ID(106+IR*3) = A2(1,IR)
  G3ID(107+IR*3) = A2(2,IR)
  G3ID(108+IR*3) = A2(3,IR)*F00(IR)
ENDDO
DO IR=1,4
  G3ID(118+IR*3) = A1(1,IR)*G3ID(106+IR*3) +  C1(IR)
  G3ID(119+IR*3) = A1(2,IR)*G3ID(107+IR*3) +  C1(IR)
  G3ID(120+IR*3) = A1(3,IR)*G3ID(108+IR*3) +  C1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,4
  G3ID(130+IR*3) = A1(1,IR)*G3ID(118+IR*3) +  B1(IR)*G3ID(106+IR*3) +  C1(IR)*G3ID(10+IR*3)
  G3ID(131+IR*3) = A1(2,IR)*G3ID(119+IR*3) +  B1(IR)*G3ID(107+IR*3) +  C1(IR)*G3ID(11+IR*3)
  G3ID(132+IR*3) = A1(3,IR)*G3ID(120+IR*3) +  B1(IR)*G3ID(108+IR*3) +  C1(IR)*G3ID(12+IR*3)
ENDDO
DO IR=1,4
  G3ID(202+IR*3) = A1(1,IR)*G3ID(130+IR*3) +  2*B1(IR)*G3ID(118+IR*3) +  C1(IR)*G3ID(22+IR*3)
  G3ID(203+IR*3) = A1(2,IR)*G3ID(131+IR*3) +  2*B1(IR)*G3ID(119+IR*3) +  C1(IR)*G3ID(23+IR*3)
  G3ID(204+IR*3) = A1(3,IR)*G3ID(132+IR*3) +  2*B1(IR)*G3ID(120+IR*3) +  C1(IR)*G3ID(24+IR*3)
ENDDO
DO IR=1,4
  G3ID(178+IR*3) = A1(1,IR)*G3ID(202+IR*3) +  3*B1(IR)*G3ID(130+IR*3) +  C1(IR)*G3ID(94+IR*3)
  G3ID(179+IR*3) = A1(2,IR)*G3ID(203+IR*3) +  3*B1(IR)*G3ID(131+IR*3) +  C1(IR)*G3ID(95+IR*3)
  G3ID(180+IR*3) = A1(3,IR)*G3ID(204+IR*3) +  3*B1(IR)*G3ID(132+IR*3) +  C1(IR)*G3ID(96+IR*3)
ENDDO
DO IR=1,4
  G3ID(214+IR*3) = A2(1,IR)*G3ID(106+IR*3) +  B2(IR)
  G3ID(215+IR*3) = A2(2,IR)*G3ID(107+IR*3) +  B2(IR)
  G3ID(216+IR*3) = A2(3,IR)*G3ID(108+IR*3) +  B2(IR)*G3ID(IR*3)
ENDDO
DO IR=1,4
  G3ID(226+IR*3) = A1(1,IR)*G3ID(214+IR*3) +  2*C1(IR)*G3ID(106+IR*3)
  G3ID(227+IR*3) = A1(2,IR)*G3ID(215+IR*3) +  2*C1(IR)*G3ID(107+IR*3)
  G3ID(228+IR*3) = A1(3,IR)*G3ID(216+IR*3) +  2*C1(IR)*G3ID(108+IR*3)
ENDDO
DO IR=1,4
  G3ID(238+IR*3) = A1(1,IR)*G3ID(226+IR*3) +  B1(IR)*G3ID(214+IR*3) +  2*C1(IR)*G3ID(118+IR*3)
  G3ID(239+IR*3) = A1(2,IR)*G3ID(227+IR*3) +  B1(IR)*G3ID(215+IR*3) +  2*C1(IR)*G3ID(119+IR*3)
  G3ID(240+IR*3) = A1(3,IR)*G3ID(228+IR*3) +  B1(IR)*G3ID(216+IR*3) +  2*C1(IR)*G3ID(120+IR*3)
ENDDO
DO IR=1,4
  G3ID(310+IR*3) = A1(1,IR)*G3ID(238+IR*3) +  2*B1(IR)*G3ID(226+IR*3) +  2*C1(IR)*G3ID(130+IR*3)
  G3ID(311+IR*3) = A1(2,IR)*G3ID(239+IR*3) +  2*B1(IR)*G3ID(227+IR*3) +  2*C1(IR)*G3ID(131+IR*3)
  G3ID(312+IR*3) = A1(3,IR)*G3ID(240+IR*3) +  2*B1(IR)*G3ID(228+IR*3) +  2*C1(IR)*G3ID(132+IR*3)
ENDDO
DO IR=1,4
  G3ID(286+IR*3) = A1(1,IR)*G3ID(310+IR*3) +  3*B1(IR)*G3ID(238+IR*3) +  2*C1(IR)*G3ID(202+IR*3)
  G3ID(287+IR*3) = A1(2,IR)*G3ID(311+IR*3) +  3*B1(IR)*G3ID(239+IR*3) +  2*C1(IR)*G3ID(203+IR*3)
  G3ID(288+IR*3) = A1(3,IR)*G3ID(312+IR*3) +  3*B1(IR)*G3ID(240+IR*3) +  2*C1(IR)*G3ID(204+IR*3)
ENDDO
DO IR=1,4
  G3ID(34+IR*3) = VAL(1)             +  G3ID(10+IR*3)
  G3ID(35+IR*3) = VAL(2)             +  G3ID(11+IR*3)
  G3ID(36+IR*3) = VAL(3)*G3ID(IR*3) +  G3ID(12+IR*3)
ENDDO
DO IR=1,4
  G3ID(46+IR*3) = VAL(1)*G3ID(10+IR*3) +  G3ID(22+IR*3)
  G3ID(47+IR*3) = VAL(2)*G3ID(11+IR*3) +  G3ID(23+IR*3)
  G3ID(48+IR*3) = VAL(3)*G3ID(12+IR*3) +  G3ID(24+IR*3)
ENDDO
DO IR=1,4
  G3ID(58+IR*3) = VAL(1)*G3ID(22+IR*3) +  G3ID(94+IR*3)
  G3ID(59+IR*3) = VAL(2)*G3ID(23+IR*3) +  G3ID(95+IR*3)
  G3ID(60+IR*3) = VAL(3)*G3ID(24+IR*3) +  G3ID(96+IR*3)
ENDDO
DO IR=1,4
  G3ID(94+IR*3) = VAL(1)*G3ID(94+IR*3) +  G3ID(70+IR*3)
  G3ID(95+IR*3) = VAL(2)*G3ID(95+IR*3) +  G3ID(71+IR*3)
  G3ID(96+IR*3) = VAL(3)*G3ID(96+IR*3) +  G3ID(72+IR*3)
ENDDO
DO IR=1,4
  G3ID(70+IR*3) = VAL(1)*G3ID(34+IR*3) +  G3ID(46+IR*3)
  G3ID(71+IR*3) = VAL(2)*G3ID(35+IR*3) +  G3ID(47+IR*3)
  G3ID(72+IR*3) = VAL(3)*G3ID(36+IR*3) +  G3ID(48+IR*3)
ENDDO
DO IR=1,4
  G3ID(82+IR*3) = VAL(1)*G3ID(46+IR*3) +  G3ID(58+IR*3)
  G3ID(83+IR*3) = VAL(2)*G3ID(47+IR*3) +  G3ID(59+IR*3)
  G3ID(84+IR*3) = VAL(3)*G3ID(48+IR*3) +  G3ID(60+IR*3)
ENDDO
DO IR=1,4
  G3ID(94+IR*3) = VAL(1)*G3ID(58+IR*3) +  G3ID(94+IR*3)
  G3ID(95+IR*3) = VAL(2)*G3ID(59+IR*3) +  G3ID(95+IR*3)
  G3ID(96+IR*3) = VAL(3)*G3ID(60+IR*3) +  G3ID(96+IR*3)
ENDDO
DO IR=1,4
  G3ID(142+IR*3) = VAL(1)*G3ID(106+IR*3) +  G3ID(118+IR*3)
  G3ID(143+IR*3) = VAL(2)*G3ID(107+IR*3) +  G3ID(119+IR*3)
  G3ID(144+IR*3) = VAL(3)*G3ID(108+IR*3) +  G3ID(120+IR*3)
ENDDO
DO IR=1,4
  G3ID(154+IR*3) = VAL(1)*G3ID(118+IR*3) +  G3ID(130+IR*3)
  G3ID(155+IR*3) = VAL(2)*G3ID(119+IR*3) +  G3ID(131+IR*3)
  G3ID(156+IR*3) = VAL(3)*G3ID(120+IR*3) +  G3ID(132+IR*3)
ENDDO
DO IR=1,4
  G3ID(166+IR*3) = VAL(1)*G3ID(130+IR*3) +  G3ID(202+IR*3)
  G3ID(167+IR*3) = VAL(2)*G3ID(131+IR*3) +  G3ID(203+IR*3)
  G3ID(168+IR*3) = VAL(3)*G3ID(132+IR*3) +  G3ID(204+IR*3)
ENDDO
DO IR=1,4
  G3ID(202+IR*3) = VAL(1)*G3ID(202+IR*3) +  G3ID(178+IR*3)
  G3ID(203+IR*3) = VAL(2)*G3ID(203+IR*3) +  G3ID(179+IR*3)
  G3ID(204+IR*3) = VAL(3)*G3ID(204+IR*3) +  G3ID(180+IR*3)
ENDDO
DO IR=1,4
  G3ID(178+IR*3) = VAL(1)*G3ID(142+IR*3) +  G3ID(154+IR*3)
  G3ID(179+IR*3) = VAL(2)*G3ID(143+IR*3) +  G3ID(155+IR*3)
  G3ID(180+IR*3) = VAL(3)*G3ID(144+IR*3) +  G3ID(156+IR*3)
ENDDO
DO IR=1,4
  G3ID(190+IR*3) = VAL(1)*G3ID(154+IR*3) +  G3ID(166+IR*3)
  G3ID(191+IR*3) = VAL(2)*G3ID(155+IR*3) +  G3ID(167+IR*3)
  G3ID(192+IR*3) = VAL(3)*G3ID(156+IR*3) +  G3ID(168+IR*3)
ENDDO
DO IR=1,4
  G3ID(202+IR*3) = VAL(1)*G3ID(166+IR*3) +  G3ID(202+IR*3)
  G3ID(203+IR*3) = VAL(2)*G3ID(167+IR*3) +  G3ID(203+IR*3)
  G3ID(204+IR*3) = VAL(3)*G3ID(168+IR*3) +  G3ID(204+IR*3)
ENDDO
DO IR=1,4
  G3ID(250+IR*3) = VAL(1)*G3ID(214+IR*3) +  G3ID(226+IR*3)
  G3ID(251+IR*3) = VAL(2)*G3ID(215+IR*3) +  G3ID(227+IR*3)
  G3ID(252+IR*3) = VAL(3)*G3ID(216+IR*3) +  G3ID(228+IR*3)
ENDDO
DO IR=1,4
  G3ID(262+IR*3) = VAL(1)*G3ID(226+IR*3) +  G3ID(238+IR*3)
  G3ID(263+IR*3) = VAL(2)*G3ID(227+IR*3) +  G3ID(239+IR*3)
  G3ID(264+IR*3) = VAL(3)*G3ID(228+IR*3) +  G3ID(240+IR*3)
ENDDO
DO IR=1,4
  G3ID(274+IR*3) = VAL(1)*G3ID(238+IR*3) +  G3ID(310+IR*3)
  G3ID(275+IR*3) = VAL(2)*G3ID(239+IR*3) +  G3ID(311+IR*3)
  G3ID(276+IR*3) = VAL(3)*G3ID(240+IR*3) +  G3ID(312+IR*3)
ENDDO
DO IR=1,4
  G3ID(310+IR*3) = VAL(1)*G3ID(310+IR*3) +  G3ID(286+IR*3)
  G3ID(311+IR*3) = VAL(2)*G3ID(311+IR*3) +  G3ID(287+IR*3)
  G3ID(312+IR*3) = VAL(3)*G3ID(312+IR*3) +  G3ID(288+IR*3)
ENDDO
DO IR=1,4
  G3ID(286+IR*3) = VAL(1)*G3ID(250+IR*3) +  G3ID(262+IR*3)
  G3ID(287+IR*3) = VAL(2)*G3ID(251+IR*3) +  G3ID(263+IR*3)
  G3ID(288+IR*3) = VAL(3)*G3ID(252+IR*3) +  G3ID(264+IR*3)
ENDDO
DO IR=1,4
  G3ID(298+IR*3) = VAL(1)*G3ID(262+IR*3) +  G3ID(274+IR*3)
  G3ID(299+IR*3) = VAL(2)*G3ID(263+IR*3) +  G3ID(275+IR*3)
  G3ID(300+IR*3) = VAL(3)*G3ID(264+IR*3) +  G3ID(276+IR*3)
ENDDO
DO IR=1,4
  G3ID(310+IR*3) = VAL(1)*G3ID(274+IR*3) +  G3ID(310+IR*3)
  G3ID(311+IR*3) = VAL(2)*G3ID(275+IR*3) +  G3ID(311+IR*3)
  G3ID(312+IR*3) = VAL(3)*G3ID(276+IR*3) +  G3ID(312+IR*3)
ENDDO

VALL = G3ID(313)*G3ID(3) + G3ID(316)*G3ID(6) + G3ID(319)*G3ID(9) + G3ID(322)*G3ID(12)
GGID(1)= GGID(1)+ DBID(1)*DK(1)*VALL
VALL = G3ID(97)*G3ID(218)*G3ID(3) + G3ID(100)*G3ID(221)*G3ID(6) + G3ID(103)*G3ID(224)*G3ID(9) + G3ID(106)*G3ID(227)*G3ID(12)
GGID(2)= GGID(2)+ DBID(1)*DK(2)*VALL
VALL = G3ID(97)*G3ID(219) + G3ID(100)*G3ID(222) + G3ID(103)*G3ID(225) + G3ID(106)*G3ID(228)
GGID(3)= GGID(3)+ DBID(1)*DK(3)*VALL
VALL = G3ID(241)*G3ID(74)*G3ID(3) + G3ID(244)*G3ID(77)*G3ID(6) + G3ID(247)*G3ID(80)*G3ID(9) + G3ID(250)*G3ID(83)*G3ID(12)
GGID(4)= GGID(4)+ DBID(2)*DK(1)*VALL
VALL = G3ID(25)*G3ID(290)*G3ID(3) + G3ID(28)*G3ID(293)*G3ID(6) + G3ID(31)*G3ID(296)*G3ID(9) + G3ID(34)*G3ID(299)*G3ID(12)
GGID(5)= GGID(5)+ DBID(2)*DK(2)*VALL
VALL = G3ID(25)*G3ID(74)*G3ID(219) + G3ID(28)*G3ID(77)*G3ID(222) + G3ID(31)*G3ID(80)*G3ID(225) + G3ID(34)*G3ID(83)*G3ID(228)
GGID(6)= GGID(6)+ DBID(2)*DK(3)*VALL
VALL = G3ID(241)*G3ID(75) + G3ID(244)*G3ID(78) + G3ID(247)*G3ID(81) + G3ID(250)*G3ID(84)
GGID(7)= GGID(7)+ DBID(3)*DK(1)*VALL
VALL = G3ID(25)*G3ID(218)*G3ID(75) + G3ID(28)*G3ID(221)*G3ID(78) + G3ID(31)*G3ID(224)*G3ID(81) + G3ID(34)*G3ID(227)*G3ID(84)
GGID(8)= GGID(8)+ DBID(3)*DK(2)*VALL
VALL = G3ID(25)*G3ID(291) + G3ID(28)*G3ID(294) + G3ID(31)*G3ID(297) + G3ID(34)*G3ID(300)
GGID(9)= GGID(9)+ DBID(3)*DK(3)*VALL
VALL = G3ID(277)*G3ID(38)*G3ID(3) + G3ID(280)*G3ID(41)*G3ID(6) + G3ID(283)*G3ID(44)*G3ID(9) + G3ID(286)*G3ID(47)*G3ID(12)
GGID(10)= GGID(10)+ DBID(4)*DK(1)*VALL
VALL = G3ID(61)*G3ID(254)*G3ID(3) + G3ID(64)*G3ID(257)*G3ID(6) + G3ID(67)*G3ID(260)*G3ID(9) + G3ID(70)*G3ID(263)*G3ID(12)
GGID(11)= GGID(11)+ DBID(4)*DK(2)*VALL
VALL = G3ID(61)*G3ID(38)*G3ID(219) + G3ID(64)*G3ID(41)*G3ID(222) + G3ID(67)*G3ID(44)*G3ID(225) + G3ID(70)*G3ID(47)*G3ID(228)
GGID(12)= GGID(12)+ DBID(4)*DK(3)*VALL
