      SUBROUTINE RIMP2_X_FORM_I32_X022 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAtm,DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCD
      use shellpairs,only: dd_PAV_PRE, &
                           dd_P_PRE,   &
                           dd_DUM0_PRE,&
                           dd_DUM_PRE, &
                           dd_AB_PRE,  &
                           dd_VAL_PRE, &
                           LOCdd,   &
                           N_dd_PRE
      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(3),W(3)
      integer :: NROOTS
      
      ! OUTPUT
      ! double precision :: GG(NI*NJ*NK)
      ! double precision :: GG(MXBSH*MXBSH*MXBSH)
      double precision :: VALL

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:MXLTOT),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,3),B1(3),C1(3),           &
                          A2(3,3),B2(3),F00(3)

      double precision :: GGID(36)
      double precision :: DK
      double precision :: G3ID(81)
      double precision :: DBID(36) 
                        
      double precision :: VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)
      ! double precision :: TL(NK*NKS)
      ! double precision :: TLL(15,9,25)

      ! double precision :: T1(NKS*NI*NJ)

      ! double precision :: TL(*)
      ! double precision :: T1(MXBSH*MXBSH*MXBSH)
      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,NGI, &
                 LI,LOCI,I1,IG, &
                 JSH,JAT,NJ,&
                 NGJ,LJ,LOCJ,J1,JG

      integer :: LTOT,LB,NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,iijj,iijj_tmp,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN


LI = 2
NI = 6
LJ = 2
NJ = 6
NROOTS=3

!$omp parallel do default(none) &
!$omp shared(I_D_SHL,KNG,KLOC,DD_VAL_PRE,KAUX_ELSE,KAUXNG) &
!$omp shared(KAUXST,KAUXAT,C,LOCSPH,LOCKT_INIT,DAUX,LOCDD) &
!$omp shared(DD_DUM_PRE,TOL,DD_P_PRE,DD_PAV_PRE,DD_DUM0_PRE) &
!$omp shared(CCD,EXAUX,I32,N_ELSE,N_D_SHL,DD_AB_PRE) &
!$omp shared(LI,NI,LJ,NJ,NROOTS) &
!$omp private(ISH,JSH,MINK,MAXK,MINKT,MAXKT) &
!$omp private(NGI,LOCI,NGJ,LOCJ,KAUXSH,NGK,K1,KAT) &
!$omp private(CC,IAUXSTART,DK,GGID,IJ,DBID,G3ID,VALL,IBF,JBF,LIJ) &
!$omp private(VAL,AB,DUM,CPV,PAV,RR,DUM0,DUM2,AK,RHO,XX,U) &
!$omp private(VAL1,A1,B1,F00,III,JJJ,IIJJ,N3,N3B,N3I,N3IJ,JI,AIJINV) &
!$omp private(AIINV,AJINV,AIINV2,AIJINVSQ,W)


         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH
DO iijj_tmp = 0, N_D_SHL*(N_D_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

      ISH = I_D_SHL(III)
      JSH = I_D_SHL(JJJ)


               NGI   = KNG(ISH)
               LOCI  = KLOC(ISH)-1

               NGJ   = KNG(JSH)
               LOCJ  = KLOC(JSH)-1

         VAL(1:3) = dd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)


         KAT = KAUXAT(KAUXSH)
         CC(1) = C(1,KAT)
         CC(2) = C(2,KAT)
         CC(3) = C(3,KAT)

         ! AUX POINTER FOR I32
         IauxStart = LOCSPH(KAUXSH)
         IauxStart = IauxStart-LOCKT_init+1

               DK = PI252 * DAux(KAUXSH,1,1)

               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,36
                  GGID(II)=zero
               ENDDO

            JI=0
               ! PRIMITIVE IN I-SHELL
               DO IG = 1, NGI                 
                  ! PRIMITIVE IN J-SHELL
                  DO JG = 1, NGJ
                  JI = JI + 1
                     AB = dd_AB_PRE(LOCdd(iijj)+JI)
                     DUM = dd_DUM_PRE(LOCdd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3) = dd_P_PRE(1:3,LOCdd(iijj)+JI)
                     PAV(1:3) = dd_PAV_PRE(1:3,LOCdd(iijj)+JI)
                     CPV(1:3) = CC(1:3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = dd_DUM0_PRE(LOCdd(iijj)+JI)

                     IJ = 0
                     DO I=1,NI
                        DUM2 = DUM0*CCD(I,IG,III)
                        DO J=1,NJ
                           IJ = IJ+1
                           DBID(IJ) = DUM2*CCD(J,JG,JJJ)
                        ENDDO
                     ENDDO !I


                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        CALL RT3_gpu(XX,U,W,NROOTS)
! I32_AO_BOYS_gpu
                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           F00(IR) = AIJINVSQ*W(IR)
                           G3ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO

DO IR=1,3
  G3ID(7+IR*3) = A1(1,IR)
  G3ID(8+IR*3) = A1(2,IR)
  G3ID(9+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,3
  G3ID(16+IR*3) = A1(1,IR)*G3ID(7+IR*3) +  (1)*B1(IR)
  G3ID(17+IR*3) = A1(2,IR)*G3ID(8+IR*3) +  (1)*B1(IR)
  G3ID(18+IR*3) = A1(3,IR)*G3ID(9+IR*3) +  (1)*B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
  G3ID(70+IR*3) = A1(1,IR)*G3ID(16+IR*3) +  (2)*B1(IR)*G3ID(7+IR*3)
  G3ID(71+IR*3) = A1(2,IR)*G3ID(17+IR*3) +  (2)*B1(IR)*G3ID(8+IR*3)
  G3ID(72+IR*3) = A1(3,IR)*G3ID(18+IR*3) +  (2)*B1(IR)*G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(52+IR*3) = A1(1,IR)*G3ID(70+IR*3) +  (3)*B1(IR)*G3ID(16+IR*3)
  G3ID(53+IR*3) = A1(2,IR)*G3ID(71+IR*3) +  (3)*B1(IR)*G3ID(17+IR*3)
  G3ID(54+IR*3) = A1(3,IR)*G3ID(72+IR*3) +  (3)*B1(IR)*G3ID(18+IR*3)
ENDDO
DO IR=1,3
  G3ID(25+IR*3) = VAL(1)  +  G3ID(7+IR*3)
  G3ID(26+IR*3) = VAL(2)  +  G3ID(8+IR*3)
  G3ID(27+IR*3) = VAL(3)*G3ID(IR*3) +  G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(34+IR*3) = VAL(1)*G3ID(7+IR*3) +  G3ID(16+IR*3)
  G3ID(35+IR*3) = VAL(2)*G3ID(8+IR*3) +  G3ID(17+IR*3)
  G3ID(36+IR*3) = VAL(3)*G3ID(9+IR*3) +  G3ID(18+IR*3)
ENDDO
DO IR=1,3
  G3ID(43+IR*3) = VAL(1)*G3ID(16+IR*3) +  G3ID(70+IR*3)
  G3ID(44+IR*3) = VAL(2)*G3ID(17+IR*3) +  G3ID(71+IR*3)
  G3ID(45+IR*3) = VAL(3)*G3ID(18+IR*3) +  G3ID(72+IR*3)
ENDDO
DO IR=1,3
  G3ID(70+IR*3) = VAL(1)*G3ID(70+IR*3) +  G3ID(52+IR*3)
  G3ID(71+IR*3) = VAL(2)*G3ID(71+IR*3) +  G3ID(53+IR*3)
  G3ID(72+IR*3) = VAL(3)*G3ID(72+IR*3) +  G3ID(54+IR*3)
ENDDO
DO IR=1,3
  G3ID(52+IR*3) = VAL(1)*G3ID(25+IR*3) +  G3ID(34+IR*3)
  G3ID(53+IR*3) = VAL(2)*G3ID(26+IR*3) +  G3ID(35+IR*3)
  G3ID(54+IR*3) = VAL(3)*G3ID(27+IR*3) +  G3ID(36+IR*3)
ENDDO
DO IR=1,3
  G3ID(61+IR*3) = VAL(1)*G3ID(34+IR*3) +  G3ID(43+IR*3)
  G3ID(62+IR*3) = VAL(2)*G3ID(35+IR*3) +  G3ID(44+IR*3)
  G3ID(63+IR*3) = VAL(3)*G3ID(36+IR*3) +  G3ID(45+IR*3)
ENDDO
DO IR=1,3
  G3ID(70+IR*3) = VAL(1)*G3ID(43+IR*3) +  G3ID(70+IR*3)
  G3ID(71+IR*3) = VAL(2)*G3ID(44+IR*3) +  G3ID(71+IR*3)
  G3ID(72+IR*3) = VAL(3)*G3ID(45+IR*3) +  G3ID(72+IR*3)
ENDDO

VALL = G3ID(73)*G3ID(3) + G3ID(76)*G3ID(6) + G3ID(79)*G3ID(9)
GGID(1) = GGID(1) + DBID(1)*DK*VALL
VALL = G3ID(19)*G3ID(56)*G3ID(3) + G3ID(22)*G3ID(59)*G3ID(6) + G3ID(25)*G3ID(62)*G3ID(9)
GGID(2) = GGID(2) + DBID(2)*DK*VALL
VALL = G3ID(19)*G3ID(57) + G3ID(22)*G3ID(60) + G3ID(25)*G3ID(63)
GGID(3) = GGID(3) + DBID(3)*DK*VALL
VALL = G3ID(46)*G3ID(29)*G3ID(3) + G3ID(49)*G3ID(32)*G3ID(6) + G3ID(52)*G3ID(35)*G3ID(9)
GGID(4) = GGID(4) + DBID(4)*DK*VALL
VALL = G3ID(46)*G3ID(30) + G3ID(49)*G3ID(33) + G3ID(52)*G3ID(36)
GGID(5) = GGID(5) + DBID(5)*DK*VALL
VALL = G3ID(19)*G3ID(29)*G3ID(30) + G3ID(22)*G3ID(32)*G3ID(33) + G3ID(25)*G3ID(35)*G3ID(36)
GGID(6) = GGID(6) + DBID(6)*DK*VALL
VALL = G3ID(55)*G3ID(20)*G3ID(3) + G3ID(58)*G3ID(23)*G3ID(6) + G3ID(61)*G3ID(26)*G3ID(9)
GGID(7) = GGID(7) + DBID(7)*DK*VALL
VALL = G3ID(74)*G3ID(3) + G3ID(77)*G3ID(6) + G3ID(80)*G3ID(9)
GGID(8) = GGID(8) + DBID(8)*DK*VALL
VALL = G3ID(20)*G3ID(57) + G3ID(23)*G3ID(60) + G3ID(26)*G3ID(63)
GGID(9) = GGID(9) + DBID(9)*DK*VALL
VALL = G3ID(28)*G3ID(47)*G3ID(3) + G3ID(31)*G3ID(50)*G3ID(6) + G3ID(34)*G3ID(53)*G3ID(9)
GGID(10) = GGID(10) + DBID(10)*DK*VALL
VALL = G3ID(28)*G3ID(20)*G3ID(30) + G3ID(31)*G3ID(23)*G3ID(33) + G3ID(34)*G3ID(26)*G3ID(36)
GGID(11) = GGID(11) + DBID(11)*DK*VALL
VALL = G3ID(47)*G3ID(30) + G3ID(50)*G3ID(33) + G3ID(53)*G3ID(36)
GGID(12) = GGID(12) + DBID(12)*DK*VALL
VALL = G3ID(55)*G3ID(21) + G3ID(58)*G3ID(24) + G3ID(61)*G3ID(27)
GGID(13) = GGID(13) + DBID(13)*DK*VALL
VALL = G3ID(56)*G3ID(21) + G3ID(59)*G3ID(24) + G3ID(62)*G3ID(27)
GGID(14) = GGID(14) + DBID(14)*DK*VALL
VALL = G3ID(75) + G3ID(78) + G3ID(81)
GGID(15) = GGID(15) + DBID(15)*DK*VALL
VALL = G3ID(28)*G3ID(29)*G3ID(21) + G3ID(31)*G3ID(32)*G3ID(24) + G3ID(34)*G3ID(35)*G3ID(27)
GGID(16) = GGID(16) + DBID(16)*DK*VALL
VALL = G3ID(28)*G3ID(48) + G3ID(31)*G3ID(51) + G3ID(34)*G3ID(54)
GGID(17) = GGID(17) + DBID(17)*DK*VALL
VALL = G3ID(29)*G3ID(48) + G3ID(32)*G3ID(51) + G3ID(35)*G3ID(54)
GGID(18) = GGID(18) + DBID(18)*DK*VALL
VALL = G3ID(64)*G3ID(11)*G3ID(3) + G3ID(67)*G3ID(14)*G3ID(6) + G3ID(70)*G3ID(17)*G3ID(9)
GGID(19) = GGID(19) + DBID(19)*DK*VALL
VALL = G3ID(10)*G3ID(65)*G3ID(3) + G3ID(13)*G3ID(68)*G3ID(6) + G3ID(16)*G3ID(71)*G3ID(9)
GGID(20) = GGID(20) + DBID(20)*DK*VALL
VALL = G3ID(10)*G3ID(11)*G3ID(57) + G3ID(13)*G3ID(14)*G3ID(60) + G3ID(16)*G3ID(17)*G3ID(63)
GGID(21) = GGID(21) + DBID(21)*DK*VALL
VALL = G3ID(37)*G3ID(38)*G3ID(3) + G3ID(40)*G3ID(41)*G3ID(6) + G3ID(43)*G3ID(44)*G3ID(9)
GGID(22) = GGID(22) + DBID(22)*DK*VALL
VALL = G3ID(37)*G3ID(11)*G3ID(30) + G3ID(40)*G3ID(14)*G3ID(33) + G3ID(43)*G3ID(17)*G3ID(36)
GGID(23) = GGID(23) + DBID(23)*DK*VALL
VALL = G3ID(10)*G3ID(38)*G3ID(30) + G3ID(13)*G3ID(41)*G3ID(33) + G3ID(16)*G3ID(44)*G3ID(36)
GGID(24) = GGID(24) + DBID(24)*DK*VALL
VALL = G3ID(64)*G3ID(12) + G3ID(67)*G3ID(15) + G3ID(70)*G3ID(18)
GGID(25) = GGID(25) + DBID(25)*DK*VALL
VALL = G3ID(10)*G3ID(56)*G3ID(12) + G3ID(13)*G3ID(59)*G3ID(15) + G3ID(16)*G3ID(62)*G3ID(18)
GGID(26) = GGID(26) + DBID(26)*DK*VALL
VALL = G3ID(10)*G3ID(66) + G3ID(13)*G3ID(69) + G3ID(16)*G3ID(72)
GGID(27) = GGID(27) + DBID(27)*DK*VALL
VALL = G3ID(37)*G3ID(29)*G3ID(12) + G3ID(40)*G3ID(32)*G3ID(15) + G3ID(43)*G3ID(35)*G3ID(18)
GGID(28) = GGID(28) + DBID(28)*DK*VALL
VALL = G3ID(37)*G3ID(39) + G3ID(40)*G3ID(42) + G3ID(43)*G3ID(45)
GGID(29) = GGID(29) + DBID(29)*DK*VALL
VALL = G3ID(10)*G3ID(29)*G3ID(39) + G3ID(13)*G3ID(32)*G3ID(42) + G3ID(16)*G3ID(35)*G3ID(45)
GGID(30) = GGID(30) + DBID(30)*DK*VALL
VALL = G3ID(55)*G3ID(11)*G3ID(12) + G3ID(58)*G3ID(14)*G3ID(15) + G3ID(61)*G3ID(17)*G3ID(18)
GGID(31) = GGID(31) + DBID(31)*DK*VALL
VALL = G3ID(65)*G3ID(12) + G3ID(68)*G3ID(15) + G3ID(71)*G3ID(18)
GGID(32) = GGID(32) + DBID(32)*DK*VALL
VALL = G3ID(11)*G3ID(66) + G3ID(14)*G3ID(69) + G3ID(17)*G3ID(72)
GGID(33) = GGID(33) + DBID(33)*DK*VALL
VALL = G3ID(28)*G3ID(38)*G3ID(12) + G3ID(31)*G3ID(41)*G3ID(15) + G3ID(34)*G3ID(44)*G3ID(18)
GGID(34) = GGID(34) + DBID(34)*DK*VALL
VALL = G3ID(28)*G3ID(11)*G3ID(39) + G3ID(31)*G3ID(14)*G3ID(42) + G3ID(34)*G3ID(17)*G3ID(45)
GGID(35) = GGID(35) + DBID(35)*DK*VALL
VALL = G3ID(38)*G3ID(39) + G3ID(41)*G3ID(42) + G3ID(44)*G3ID(45)
GGID(36) = GGID(36) + DBID(36)*DK*VALL



                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG

               ! COPY INTEGRAL GG(P|MN) TO I32
               DO II=1,NI
                  DO JJ=1,NJ
                     IBF = LOCI+II
                     JBF = LOCJ+JJ
                     LIJ = JJ+(II-1)*NJ
                     I32(IBF,JBF,IauxStart) = GGID(LIJ) 
                     I32(JBF,IBF,IauxStart) = GGID(LIJ) 
                  ENDDO
               ENDDO


         ENDDO 
      ENDDO 
!$omp end parallel do


      END SUBROUTINE



      SUBROUTINE RIMP2_X_FORM_I32_X122 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAtm,DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCD
      use shellpairs,only: dd_PAV_PRE, &
                           dd_P_PRE,   &
                           dd_DUM0_PRE,&
                           dd_DUM_PRE, &
                           dd_AB_PRE,  &
                           dd_VAL_PRE, &
                           LOCdd,   &
                           N_dd_PRE
      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(3),W(3)
      integer :: NROOTS
      
      ! OUTPUT
      double precision :: VALL

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:MXLTOT),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,3),B1(3),C1(3),           &
                          A2(3,3),B2(3),F00(3)

      double precision :: GGID(108)
      double precision :: DK(3)
      double precision :: G3ID(162) !3*nroots*LI*LJ*LK
      double precision :: DBID(36) 
                        
      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,NGI, &
                 LI,LOCI,I1,IG, &
                 JSH,JAT,NJ,&
                 NGJ,LJ,LOCJ,J1,JG

      integer :: LTOT,LB,NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,iijj,iijj_tmp,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN


LI=2
NI=6
LJ=2
NJ=6

LK = 1
NKS = 3
NK = 3
 
NROOTS=3


!$omp parallel do default(none) &
!$omp shared(I_D_SHL,KNG,KLOC,DD_VAL_PRE,KAUX_ELSE,KAUXNG) &
!$omp shared(KAUXST,KAUXAT,C,LOCSPH,LOCKT_INIT,DAUX,LOCDD) &
!$omp shared(DD_DUM_PRE,TOL,DD_P_PRE,DD_PAV_PRE,DD_DUM0_PRE) &
!$omp shared(CCD,EXAUX,I32,N_ELSE,N_D_SHL,DD_AB_PRE) &
!$omp shared(LI,NI,LJ,NJ,NROOTS,NKS,NK) &
!$omp private(ISH,JSH,MINK,MAXK,MINKT,MAXKT) &
!$omp private(NGI,LOCI,NGJ,LOCJ,KAUXSH,NGK,K1,KAT) &
!$omp private(CC,IAUXSTART,DK,GGID,IJ,DBID,G3ID,VALL,IBF,JBF,LIJ) &
!$omp private(VAL,AB,DUM,CPV,PAV,RR,DUM0,DUM2,AK,RHO,XX,U) &
!$omp private(VAL1,A1,B1,F00,III,JJJ,IIJJ,N3,N3B,N3I,N3IJ,JI,AIJINV) &
!$omp private(AIINV,AJINV,AIINV2,AIJINVSQ,W,AIJINV2,VAL2,A2,C1,NLJ)


         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH
DO iijj_tmp = 0, N_D_SHL*(N_D_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

      ISH = I_D_SHL(III)
      JSH = I_D_SHL(JJJ)


               NGI   = KNG(ISH)
               LOCI  = KLOC(ISH)-1

               NGJ   = KNG(JSH)
               LOCJ  = KLOC(JSH)-1

         VAL(1:3) = dd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)


         KAT = KAUXAT(KAUXSH)
         CC(1) = C(1,KAT)
         CC(2) = C(2,KAT)
         CC(3) = C(3,KAT)


         ! AUX POINTER FOR I32
         IauxStart = LOCSPH(KAUXSH)
         IauxStart = IauxStart-LOCKT_init+1
               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K) = PI252 * DAux(KAUXSH,1,K)
               ENDDO

               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,36*NK
                  GGID(II)=zero
               ENDDO
            JI=0
               ! PRIMITIVE IN I-SHELL
               DO IG = 1, NGI                 
                  ! PRIMITIVE IN J-SHELL
                  DO JG = 1, NGJ
                  JI = JI + 1
                     AB = dd_AB_PRE(LOCdd(iijj)+JI)
                     DUM = dd_DUM_PRE(LOCdd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3) = dd_P_PRE(1:3,LOCdd(iijj)+JI)
                     PAV(1:3) = dd_PAV_PRE(1:3,LOCdd(iijj)+JI)
                     CPV(1:3) = CC(1:3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = dd_DUM0_PRE(LOCdd(iijj)+JI)

                     IJ = 0
                     DO I=1,NI
                        DUM2 = DUM0*CCD(I,IG,III)
                        DO J=1,NJ
                           IJ = IJ+1
                           DBID(IJ) = DUM2*CCD(J,JG,JJJ)
                        ENDDO
                     ENDDO !I


                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        CALL RT3_gpu(XX,U,W,NROOTS)

                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G3ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO

DO IR=1,3
  G3ID(7+IR*3) = A1(1,IR)
  G3ID(8+IR*3) = A1(2,IR)
  G3ID(9+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,3
  G3ID(16+IR*3) = A1(1,IR)*G3ID(7+IR*3) +  B1(IR)
  G3ID(17+IR*3) = A1(2,IR)*G3ID(8+IR*3) +  B1(IR)
  G3ID(18+IR*3) = A1(3,IR)*G3ID(9+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
  G3ID(70+IR*3) = A1(1,IR)*G3ID(16+IR*3) +  2*B1(IR)*G3ID(7+IR*3)
  G3ID(71+IR*3) = A1(2,IR)*G3ID(17+IR*3) +  2*B1(IR)*G3ID(8+IR*3)
  G3ID(72+IR*3) = A1(3,IR)*G3ID(18+IR*3) +  2*B1(IR)*G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(52+IR*3) = A1(1,IR)*G3ID(70+IR*3) +  3*B1(IR)*G3ID(16+IR*3)
  G3ID(53+IR*3) = A1(2,IR)*G3ID(71+IR*3) +  3*B1(IR)*G3ID(17+IR*3)
  G3ID(54+IR*3) = A1(3,IR)*G3ID(72+IR*3) +  3*B1(IR)*G3ID(18+IR*3)
ENDDO
DO IR=1,3
  G3ID(79+IR*3) = A2(1,IR)
  G3ID(80+IR*3) = A2(2,IR)
  G3ID(81+IR*3) = A2(3,IR)*F00(IR)
ENDDO
DO IR=1,3
  G3ID(88+IR*3) = A1(1,IR)*G3ID(79+IR*3) +  C1(IR)
  G3ID(89+IR*3) = A1(2,IR)*G3ID(80+IR*3) +  C1(IR)
  G3ID(90+IR*3) = A1(3,IR)*G3ID(81+IR*3) +  C1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
  G3ID(97+IR*3) = A1(1,IR)*G3ID(88+IR*3) +  B1(IR)*G3ID(79+IR*3) +  C1(IR)*G3ID(7+IR*3)
  G3ID(98+IR*3) = A1(2,IR)*G3ID(89+IR*3) +  B1(IR)*G3ID(80+IR*3) +  C1(IR)*G3ID(8+IR*3)
  G3ID(99+IR*3) = A1(3,IR)*G3ID(90+IR*3) +  B1(IR)*G3ID(81+IR*3) +  C1(IR)*G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(151+IR*3) = A1(1,IR)*G3ID(97+IR*3) +  2*B1(IR)*G3ID(88+IR*3) +  C1(IR)*G3ID(16+IR*3)
  G3ID(152+IR*3) = A1(2,IR)*G3ID(98+IR*3) +  2*B1(IR)*G3ID(89+IR*3) +  C1(IR)*G3ID(17+IR*3)
  G3ID(153+IR*3) = A1(3,IR)*G3ID(99+IR*3) +  2*B1(IR)*G3ID(90+IR*3) +  C1(IR)*G3ID(18+IR*3)
ENDDO
DO IR=1,3
  G3ID(133+IR*3) = A1(1,IR)*G3ID(151+IR*3) +  3*B1(IR)*G3ID(97+IR*3) +  C1(IR)*G3ID(70+IR*3)
  G3ID(134+IR*3) = A1(2,IR)*G3ID(152+IR*3) +  3*B1(IR)*G3ID(98+IR*3) +  C1(IR)*G3ID(71+IR*3)
  G3ID(135+IR*3) = A1(3,IR)*G3ID(153+IR*3) +  3*B1(IR)*G3ID(99+IR*3) +  C1(IR)*G3ID(72+IR*3)
ENDDO
DO IR=1,3
  G3ID(25+IR*3) = VAL(1)          +  G3ID(7+IR*3)
  G3ID(26+IR*3) = VAL(2)          +  G3ID(8+IR*3)
  G3ID(27+IR*3) = VAL(3)*G3ID(IR*3) +  G3ID(9+IR*3)
ENDDO
DO IR=1,3
  G3ID(34+IR*3) = VAL(1)*G3ID(7+IR*3) +  G3ID(16+IR*3)
  G3ID(35+IR*3) = VAL(2)*G3ID(8+IR*3) +  G3ID(17+IR*3)
  G3ID(36+IR*3) = VAL(3)*G3ID(9+IR*3) +  G3ID(18+IR*3)
ENDDO
DO IR=1,3
  G3ID(43+IR*3) = VAL(1)*G3ID(16+IR*3) +  G3ID(70+IR*3)
  G3ID(44+IR*3) = VAL(2)*G3ID(17+IR*3) +  G3ID(71+IR*3)
  G3ID(45+IR*3) = VAL(3)*G3ID(18+IR*3) +  G3ID(72+IR*3)
ENDDO
DO IR=1,3
  G3ID(70+IR*3) = VAL(1)*G3ID(70+IR*3) +  G3ID(52+IR*3)
  G3ID(71+IR*3) = VAL(2)*G3ID(71+IR*3) +  G3ID(53+IR*3)
  G3ID(72+IR*3) = VAL(3)*G3ID(72+IR*3) +  G3ID(54+IR*3)
ENDDO
DO IR=1,3
  G3ID(52+IR*3) = VAL(1)*G3ID(25+IR*3) +  G3ID(34+IR*3)
  G3ID(53+IR*3) = VAL(2)*G3ID(26+IR*3) +  G3ID(35+IR*3)
  G3ID(54+IR*3) = VAL(3)*G3ID(27+IR*3) +  G3ID(36+IR*3)
ENDDO
DO IR=1,3
  G3ID(61+IR*3) = VAL(1)*G3ID(34+IR*3) +  G3ID(43+IR*3)
  G3ID(62+IR*3) = VAL(2)*G3ID(35+IR*3) +  G3ID(44+IR*3)
  G3ID(63+IR*3) = VAL(3)*G3ID(36+IR*3) +  G3ID(45+IR*3)
ENDDO
DO IR=1,3
  G3ID(70+IR*3) = VAL(1)*G3ID(43+IR*3) +  G3ID(70+IR*3)
  G3ID(71+IR*3) = VAL(2)*G3ID(44+IR*3) +  G3ID(71+IR*3)
  G3ID(72+IR*3) = VAL(3)*G3ID(45+IR*3) +  G3ID(72+IR*3)
ENDDO
DO IR=1,3
  G3ID(106+IR*3) = VAL(1)*G3ID(79+IR*3) +  G3ID(88+IR*3)
  G3ID(107+IR*3) = VAL(2)*G3ID(80+IR*3) +  G3ID(89+IR*3)
  G3ID(108+IR*3) = VAL(3)*G3ID(81+IR*3) +  G3ID(90+IR*3)
ENDDO
DO IR=1,3
  G3ID(115+IR*3) = VAL(1)*G3ID(88+IR*3) +  G3ID(97+IR*3)
  G3ID(116+IR*3) = VAL(2)*G3ID(89+IR*3) +  G3ID(98+IR*3)
  G3ID(117+IR*3) = VAL(3)*G3ID(90+IR*3) +  G3ID(99+IR*3)
ENDDO
DO IR=1,3
  G3ID(124+IR*3) = VAL(1)*G3ID(97+IR*3) +  G3ID(151+IR*3)
  G3ID(125+IR*3) = VAL(2)*G3ID(98+IR*3) +  G3ID(152+IR*3)
  G3ID(126+IR*3) = VAL(3)*G3ID(99+IR*3) +  G3ID(153+IR*3)
ENDDO
DO IR=1,3
  G3ID(151+IR*3) = VAL(1)*G3ID(151+IR*3) +  G3ID(133+IR*3)
  G3ID(152+IR*3) = VAL(2)*G3ID(152+IR*3) +  G3ID(134+IR*3)
  G3ID(153+IR*3) = VAL(3)*G3ID(153+IR*3) +  G3ID(135+IR*3)
ENDDO
DO IR=1,3
  G3ID(133+IR*3) = VAL(1)*G3ID(106+IR*3) +  G3ID(115+IR*3)
  G3ID(134+IR*3) = VAL(2)*G3ID(107+IR*3) +  G3ID(116+IR*3)
  G3ID(135+IR*3) = VAL(3)*G3ID(108+IR*3) +  G3ID(117+IR*3)
ENDDO
DO IR=1,3
  G3ID(142+IR*3) = VAL(1)*G3ID(115+IR*3) +  G3ID(124+IR*3)
  G3ID(143+IR*3) = VAL(2)*G3ID(116+IR*3) +  G3ID(125+IR*3)
  G3ID(144+IR*3) = VAL(3)*G3ID(117+IR*3) +  G3ID(126+IR*3)
ENDDO
DO IR=1,3
  G3ID(151+IR*3) = VAL(1)*G3ID(124+IR*3) +  G3ID(151+IR*3)
  G3ID(152+IR*3) = VAL(2)*G3ID(125+IR*3) +  G3ID(152+IR*3)
  G3ID(153+IR*3) = VAL(3)*G3ID(126+IR*3) +  G3ID(153+IR*3)
ENDDO

VALL = G3ID(154)*G3ID(3) + G3ID(157)*G3ID(6) + G3ID(160)*G3ID(9)
GGID(1) = GGID(1) + DBID(1)*DK(1)*VALL
VALL = G3ID( 73)*G3ID( 83)*G3ID(3) + G3ID( 76)*G3ID( 86)*G3ID(6) + G3ID( 79)*G3ID( 89)*G3ID(9)
GGID(2) = GGID(2) + DBID(1)*DK(2)*VALL
VALL = G3ID( 73)*G3ID(84) + G3ID( 76)*G3ID( 87) + G3ID( 79)*G3ID( 90)
GGID(3) = GGID(3) + DBID(1)*DK(3)*VALL
VALL = G3ID(100)*G3ID( 56)*G3ID(3) + G3ID(103)*G3ID( 59)*G3ID(6) + G3ID(106)*G3ID( 62)*G3ID(9)
GGID(4) = GGID(4) + DBID(2)*DK(1)*VALL
VALL = G3ID( 19)*G3ID(137)*G3ID(3) + G3ID( 22)*G3ID(140)*G3ID(6) + G3ID( 25)*G3ID(143)*G3ID(9)
GGID(5) = GGID(5) + DBID(2)*DK(2)*VALL
VALL = G3ID( 19)*G3ID( 56)*G3ID(84) + G3ID( 22)*G3ID( 59)*G3ID( 87) + G3ID( 25)*G3ID( 62)*G3ID( 90)
GGID(6) = GGID(6) + DBID(2)*DK(3)*VALL
VALL = G3ID(100)*G3ID(57) + G3ID(103)*G3ID( 60) + G3ID(106)*G3ID( 63)
GGID(7) = GGID(7) + DBID(3)*DK(1)*VALL
VALL = G3ID( 19)*G3ID( 83)*G3ID(57) + G3ID( 22)*G3ID( 86)*G3ID( 60) + G3ID( 25)*G3ID( 89)*G3ID( 63)
GGID(8) = GGID(8) + DBID(3)*DK(2)*VALL
VALL = G3ID( 19)*G3ID(138) + G3ID( 22)*G3ID(141) + G3ID( 25)*G3ID(144)
GGID(9) = GGID(9) + DBID(3)*DK(3)*VALL
VALL = G3ID(127)*G3ID( 29)*G3ID(3) + G3ID(130)*G3ID( 32)*G3ID(6) + G3ID(133)*G3ID( 35)*G3ID(9)
GGID( 10) = GGID( 10) + DBID(4)*DK(1)*VALL
VALL = G3ID( 46)*G3ID(110)*G3ID(3) + G3ID( 49)*G3ID(113)*G3ID(6) + G3ID( 52)*G3ID(116)*G3ID(9)
GGID( 11) = GGID( 11) + DBID(4)*DK(2)*VALL
VALL = G3ID( 46)*G3ID( 29)*G3ID(84) + G3ID( 49)*G3ID( 32)*G3ID( 87) + G3ID( 52)*G3ID( 35)*G3ID( 90)
GGID( 12) = GGID( 12) + DBID(4)*DK(3)*VALL
VALL = G3ID(127)*G3ID(30) + G3ID(130)*G3ID( 33) + G3ID(133)*G3ID( 36)
GGID( 13) = GGID( 13) + DBID(5)*DK(1)*VALL
VALL = G3ID( 46)*G3ID( 83)*G3ID(30) + G3ID( 49)*G3ID( 86)*G3ID( 33) + G3ID( 52)*G3ID( 89)*G3ID( 36)
GGID( 14) = GGID( 14) + DBID(5)*DK(2)*VALL
VALL = G3ID( 46)*G3ID(111) + G3ID( 49)*G3ID(114) + G3ID( 52)*G3ID(117)
GGID( 15) = GGID( 15) + DBID(5)*DK(3)*VALL
VALL = G3ID(100)*G3ID( 29)*G3ID(30) + G3ID(103)*G3ID( 32)*G3ID( 33) + G3ID(106)*G3ID( 35)*G3ID( 36)
GGID( 16) = GGID( 16) + DBID(6)*DK(1)*VALL
VALL = G3ID( 19)*G3ID(110)*G3ID(30) + G3ID( 22)*G3ID(113)*G3ID( 33) + G3ID( 25)*G3ID(116)*G3ID( 36)
GGID( 17) = GGID( 17) + DBID(6)*DK(2)*VALL
VALL = G3ID( 19)*G3ID( 29)*G3ID(111) + G3ID( 22)*G3ID( 32)*G3ID(114) + G3ID( 25)*G3ID( 35)*G3ID(117)
GGID( 18) = GGID( 18) + DBID(6)*DK(3)*VALL
VALL = G3ID(136)*G3ID( 20)*G3ID(3) + G3ID(139)*G3ID( 23)*G3ID(6) + G3ID(142)*G3ID( 26)*G3ID(9)
GGID( 19) = GGID( 19) + DBID(7)*DK(1)*VALL
VALL = G3ID( 55)*G3ID(101)*G3ID(3) + G3ID( 58)*G3ID(104)*G3ID(6) + G3ID( 61)*G3ID(107)*G3ID(9)
GGID( 20) = GGID( 20) + DBID(7)*DK(2)*VALL
VALL = G3ID( 55)*G3ID( 20)*G3ID(84) + G3ID( 58)*G3ID( 23)*G3ID( 87) + G3ID( 61)*G3ID( 26)*G3ID( 90)
GGID( 21) = GGID( 21) + DBID(7)*DK(3)*VALL
VALL = G3ID( 82)*G3ID( 74)*G3ID(3) + G3ID( 85)*G3ID( 77)*G3ID(6) + G3ID( 88)*G3ID( 80)*G3ID(9)
GGID( 22) = GGID( 22) + DBID(8)*DK(1)*VALL
VALL = G3ID(155)*G3ID(3) + G3ID(158)*G3ID(6) + G3ID(161)*G3ID(9)
GGID( 23) = GGID( 23) + DBID(8)*DK(2)*VALL
VALL = G3ID( 74)*G3ID(84) + G3ID( 77)*G3ID( 87) + G3ID( 80)*G3ID( 90)
GGID( 24) = GGID( 24) + DBID(8)*DK(3)*VALL
VALL = G3ID( 82)*G3ID( 20)*G3ID(57) + G3ID( 85)*G3ID( 23)*G3ID( 60) + G3ID( 88)*G3ID( 26)*G3ID( 63)
GGID( 25) = GGID( 25) + DBID(9)*DK(1)*VALL
VALL = G3ID(101)*G3ID(57) + G3ID(104)*G3ID( 60) + G3ID(107)*G3ID( 63)
GGID( 26) = GGID( 26) + DBID(9)*DK(2)*VALL
VALL = G3ID( 20)*G3ID(138) + G3ID( 23)*G3ID(141) + G3ID( 26)*G3ID(144)
GGID( 27) = GGID( 27) + DBID(9)*DK(3)*VALL
VALL = G3ID(109)*G3ID( 47)*G3ID(3) + G3ID(112)*G3ID( 50)*G3ID(6) + G3ID(115)*G3ID( 53)*G3ID(9)
GGID( 28) = GGID( 28) + DBID(10)*DK(1)*VALL
