VALL = G3ID(145)*G3ID(50)*G3ID(231) + G3ID(148)*G3ID(53)*G3ID(234) + G3ID(151)*G3ID(56)*G3ID(237) + G3ID(154)*G3ID(59)*G3ID(240)
GGID(338) = GGID(338) + DBID(34)*DK(8)*VALL
VALL = G3ID(37)*G3ID(158)*G3ID(231) + G3ID(40)*G3ID(161)*G3ID(234) + G3ID(43)*G3ID(164)*G3ID(237) + G3ID(46)*G3ID(167)*G3ID(240)
GGID(339) = GGID(339) + DBID(34)*DK(9)*VALL
VALL = G3ID(145)*G3ID(158)*G3ID(123) + G3ID(148)*G3ID(161)*G3ID(126) + G3ID(151)*G3ID(164)*G3ID(129) + G3ID(154)*G3ID(167)*G3ID(132)
GGID(340) = GGID(340) + DBID(34)*DK(10)*VALL
VALL = G3ID(361)*G3ID(14)*G3ID(51) + G3ID(364)*G3ID(17)*G3ID(54) + G3ID(367)*G3ID(20)*G3ID(57) + G3ID(370)*G3ID(23)*G3ID(60)
GGID(341) = GGID(341) + DBID(35)*DK(1)*VALL
VALL = G3ID(37)*G3ID(338)*G3ID(51) + G3ID(40)*G3ID(341)*G3ID(54) + G3ID(43)*G3ID(344)*G3ID(57) + G3ID(46)*G3ID(347)*G3ID(60)
GGID(342) = GGID(342) + DBID(35)*DK(2)*VALL
VALL = G3ID(37)*G3ID(14)*G3ID(375) + G3ID(40)*G3ID(17)*G3ID(378) + G3ID(43)*G3ID(20)*G3ID(381) + G3ID(46)*G3ID(23)*G3ID(384)
GGID(343) = GGID(343) + DBID(35)*DK(3)*VALL
VALL = G3ID(253)*G3ID(122)*G3ID(51) + G3ID(256)*G3ID(125)*G3ID(54) + G3ID(259)*G3ID(128)*G3ID(57) + G3ID(262)*G3ID(131)*G3ID(60)
GGID(344) = GGID(344) + DBID(35)*DK(4)*VALL
VALL = G3ID(253)*G3ID(14)*G3ID(159) + G3ID(256)*G3ID(17)*G3ID(162) + G3ID(259)*G3ID(20)*G3ID(165) + G3ID(262)*G3ID(23)*G3ID(168)
GGID(345) = GGID(345) + DBID(35)*DK(5)*VALL
VALL = G3ID(145)*G3ID(230)*G3ID(51) + G3ID(148)*G3ID(233)*G3ID(54) + G3ID(151)*G3ID(236)*G3ID(57) + G3ID(154)*G3ID(239)*G3ID(60)
GGID(346) = GGID(346) + DBID(35)*DK(6)*VALL
VALL = G3ID(37)*G3ID(230)*G3ID(159) + G3ID(40)*G3ID(233)*G3ID(162) + G3ID(43)*G3ID(236)*G3ID(165) + G3ID(46)*G3ID(239)*G3ID(168)
GGID(347) = GGID(347) + DBID(35)*DK(7)*VALL
VALL = G3ID(145)*G3ID(14)*G3ID(267) + G3ID(148)*G3ID(17)*G3ID(270) + G3ID(151)*G3ID(20)*G3ID(273) + G3ID(154)*G3ID(23)*G3ID(276)
GGID(348) = GGID(348) + DBID(35)*DK(8)*VALL
VALL = G3ID(37)*G3ID(122)*G3ID(267) + G3ID(40)*G3ID(125)*G3ID(270) + G3ID(43)*G3ID(128)*G3ID(273) + G3ID(46)*G3ID(131)*G3ID(276)
GGID(349) = GGID(349) + DBID(35)*DK(9)*VALL
VALL = G3ID(145)*G3ID(122)*G3ID(159) + G3ID(148)*G3ID(125)*G3ID(162) + G3ID(151)*G3ID(128)*G3ID(165) + G3ID(154)*G3ID(131)*G3ID(168)
GGID(350) = GGID(350) + DBID(35)*DK(10)*VALL
VALL = G3ID(325)*G3ID(50)*G3ID(51) + G3ID(328)*G3ID(53)*G3ID(54) + G3ID(331)*G3ID(56)*G3ID(57) + G3ID(334)*G3ID(59)*G3ID(60)
GGID(351) = GGID(351) + DBID(36)*DK(1)*VALL
VALL = G3ID(374)*G3ID(51) + G3ID(377)*G3ID(54) + G3ID(380)*G3ID(57) + G3ID(383)*G3ID(60)
GGID(352) = GGID(352) + DBID(36)*DK(2)*VALL
VALL = G3ID(50)*G3ID(375) + G3ID(53)*G3ID(378) + G3ID(56)*G3ID(381) + G3ID(59)*G3ID(384)
GGID(353) = GGID(353) + DBID(36)*DK(3)*VALL
VALL = G3ID(217)*G3ID(158)*G3ID(51) + G3ID(220)*G3ID(161)*G3ID(54) + G3ID(223)*G3ID(164)*G3ID(57) + G3ID(226)*G3ID(167)*G3ID(60)
GGID(354) = GGID(354) + DBID(36)*DK(4)*VALL
VALL = G3ID(217)*G3ID(50)*G3ID(159) + G3ID(220)*G3ID(53)*G3ID(162) + G3ID(223)*G3ID(56)*G3ID(165) + G3ID(226)*G3ID(59)*G3ID(168)
GGID(355) = GGID(355) + DBID(36)*DK(5)*VALL
VALL = G3ID(109)*G3ID(266)*G3ID(51) + G3ID(112)*G3ID(269)*G3ID(54) + G3ID(115)*G3ID(272)*G3ID(57) + G3ID(118)*G3ID(275)*G3ID(60)
GGID(356) = GGID(356) + DBID(36)*DK(6)*VALL
VALL = G3ID(266)*G3ID(159) + G3ID(269)*G3ID(162) + G3ID(272)*G3ID(165) + G3ID(275)*G3ID(168)
GGID(357) = GGID(357) + DBID(36)*DK(7)*VALL
VALL = G3ID(109)*G3ID(50)*G3ID(267) + G3ID(112)*G3ID(53)*G3ID(270) + G3ID(115)*G3ID(56)*G3ID(273) + G3ID(118)*G3ID(59)*G3ID(276)
GGID(358) = GGID(358) + DBID(36)*DK(8)*VALL
VALL = G3ID(158)*G3ID(267) + G3ID(161)*G3ID(270) + G3ID(164)*G3ID(273) + G3ID(167)*G3ID(276)
GGID(359) = GGID(359) + DBID(36)*DK(9)*VALL
VALL = G3ID(109)*G3ID(158)*G3ID(159) + G3ID(112)*G3ID(161)*G3ID(162) + G3ID(115)*G3ID(164)*G3ID(165) + G3ID(118)*G3ID(167)*G3ID(168)
GGID(360) = GGID(360) + DBID(36)*DK(10)*VALL


                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG


               DO II=1,36
                  T1(1+(II-1)*7) =  a1114*GGID(1+(II-1)*10) - a4714*GGID(6+(II-1)*10)
                  T1(2+(II-1)*7) =  a5214*(GGID(5+(II-1)*10)-GGID(7+(II-1)*10))
                  T1(3+(II-1)*7) = a1314*GGID(1+(II-1)*10) + a6314*GGID(6+(II-1)*10) + a8314*GGID(8+(II-1)*10)
                  T1(4+(II-1)*7) = GGID(3+(II-1)*10) + a5414 * (GGID(5+(II-1)*10)+GGID(7+(II-1)*10))
                  T1(5+(II-1)*7) = a1314*GGID(2+(II-1)*10) + a6314*GGID(4+(II-1)*10) + a8314*GGID(9+(II-1)*10)
                  T1(6+(II-1)*7) = GGID(10+(II-1)*10)
                  T1(7+(II-1)*7) = -a1114*GGID(2+(II-1)*10) + a4714*GGID(4+(II-1)*10)
               ENDDO
            
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO II=1,NI
                     DO JJ=1,NJ
                        IBF = LOCI+II
                        JBF = LOCJ+JJ
                        LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                        I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                        I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                     ENDDO
                  ENDDO
               ENDDO

         ENDDO 
      ENDDO 
!$omp end parallel do


      END SUBROUTINE


      SUBROUTINE RIMP2_X_FORM_I32_X22 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAtm,DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCD
      use shellpairs,only: dd_PAV_PRE, &
                           dd_P_PRE,   &
                           dd_DUM0_PRE,&
                           dd_DUM_PRE, &
                           dd_AB_PRE,  &
                           dd_VAL_PRE, &
                           LOCdd,   &
                           N_dd_PRE
      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(13),W(13)
      integer :: NROOTS
      
      ! OUTPUT
      ! double precision :: GG(NI*NJ*NK)
      ! double precision :: GG(MXBSH*MXBSH*MXBSH)
      double precision :: VALL

      ! BUFFER
      double precision :: CC(3,3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:MXLTOT),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,13),B1(13),C1(13),           &
                          A2(3,13),B2(13),F00(13)

      double precision :: GGID(1000)
      double precision :: DK(24),T1(1000)
      double precision :: G2ID(728) !3*nroots*(LI+LJ)*LK
      double precision :: G3ID(2688) !3*nroots*LI*LJ*LK
      double precision :: DBID(36) 
                        
      integer :: LLIJ(3,6),LLK(3,28)

      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)
      ! double precision :: TL(NK*NKS)
      ! double precision :: TLL(15,9,25)

      ! double precision :: T1(NKS*NI*NJ)

      ! double precision :: TL(*)
      ! double precision :: T1(MXBSH*MXBSH*MXBSH)
      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,NGI, &
                 LI,LOCI,I1,IG, &
                 JSH,JAT,NJ,&
                 NGJ,LJ,LOCJ,J1,JG

      integer :: LTOT,LB,NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,iijj,iijj_tmp,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN



      DO I=5,10
         INI=I-4
         LLIJ(1,INI) = LX(I)
         LLIJ(2,INI) = LY(I)
         LLIJ(3,INI) = LZ(I)
      ENDDO



!$omp parallel do default(none) &
!$omp shared(EXAUX,KAUXAT,KAUXTY,KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO)    &
!$omp shared(EX,KATOM,C,KTYPE,KNG,KSTART,KLOC,NSHELL)         &
!$omp shared(MIXS,TLL,DAtm,DAux,LOCSPH,TOL)     &
!$omp shared(LX,LY,LZ,lockt_init)           &
!$omp shared(I32) &
!$omp shared(dd_PAV_PRE,dd_P_PRE,dd_DUM0_PRE,dd_DUM_PRE) &
!$omp shared(dd_AB_PRE,dd_VAL_PRE,LOCdd,N_dd_PRE) &
!$omp shared(I_D_SHL,KAUX_ELSE,CCD,N_ELSE,N_D_SHL) &
!$omp private(G2ID,G3ID,GGID,DBID,VALL) &
!$omp private(CC,KAUXSH,KAT,LK,NK,NGK,MINK,MAXK,K1,LOCK,             &
!$omp         ISH,IAT,LI,NI,NGI,I1,LOCI,                   &
!$omp         JSH,JAT,LJ,NJ,NGJ,J1,LOCJ,                   &
!$omp         NKS,MINKT,MAXKT,LOCKT,                  &
!$omp         DK,T1,IauxStart,INDEX, &
!$omp        NLJ,LNKS,IBF,JBF,LIJ,KJ,IJ) &
!$omp private(       LB,LTOT) & 
!$omp private(CAB,VAL,RAB2,IG,AI,TMP,AIRAB) &
!$omp private(JG,AJ,AB,ABINV,EXPB,P,PAV,CPV,RR,DUM,DUM0,DUM2) &
!$omp private(XX,U,W,NROOTS,AK,RHO,A1,B1,C1,A2,B2,F00) &
!$omp private(LL,II,KG,I,J,K) &
!$omp private(U2,T2,VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2) &
!$omp private(LLK) &
!$omp shared(LLIJ) &
!$omp private(KNK,INI,JNJ) &
!$omp private(ajinv2,aijinv2,aijinvsq,aiinv2,aijinv,aiinv,ajinv) &
!$omp private(NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ) &
!$omp private(I3,N3,N3I,N3B,N3IJ,IDX,IDZ,IDY,IJK,FACTOR) &
!$omp private(III,JJJ,IIJJ,JI) 


         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH
DO iijj_tmp = 0, N_D_SHL*(N_D_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

      ISH = I_D_SHL(III)
      JSH = I_D_SHL(JJJ)

LI = 2
NI = 6
LJ = 2
NJ = 6
               NGI   = KNG(ISH)
               LOCI  = KLOC(ISH)-1

               NGJ   = KNG(JSH)
               LOCJ  = KLOC(JSH)-1

            
               IAT = KATOM(ISH)
               CC(1,1) = C(1,IAT)
               CC(2,1) = C(2,IAT)
               CC(3,1) = C(3,IAT)
               I1    = KSTART(ISH)

               JAT = KATOM(JSH)
               CC(1,2) = C(1,JAT)
               CC(2,2) = C(2,JAT)
               CC(3,2) = C(3,JAT)
               J1    = KSTART(JSH)

         VAL(1:3) = dd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)


         KAT = KAUXAT(KAUXSH)
         CC(1,3) = C(1,KAT)
         CC(2,3) = C(2,KAT)
         CC(3,3) = C(3,KAT)
         LK = KAUXTY(KAUXSH)-1
         MINK  = KAUXMI(KAUXSH)
         MAXK  = KAUXMX(KAUXSH)
         NK    = MAXK-MINK+1
         LOCK  = KAUXLO(KAUXSH)-MINK
         INDEX = MINK+LK
         DO K=MINK,MAXK
            KNK=K-MINK+1
            LLK(1,KNK) = LX(K)
            LLK(2,KNK) = LY(K)
            LLK(3,KNK) = LZ(K)
         ENDDO
         MINKT = MIXS(1,INDEX)
         MAXKT = MIXS(2,INDEX)
         NKS = MAXKT - MINKT + 1


         ! AUX POINTER FOR I32
         IauxStart = LOCSPH(KAUXSH)
         IauxStart = IauxStart-LOCKT_init+1
               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K) = PI252 * DAux(KAUXSH,1,K)
               ENDDO

               ! TOTAL ANG MOM & ROOTS
               LB = 4
               LTOT = LB+LK
               NROOTS = LTOT/2+1

N3=3*NROOTS
N3B=5*N3
N3=3*NROOTS
N3I=3*N3
N3B=15*NROOTS
N3IJ=3*N3I


               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,36*NK
                  GGID(II)=zero
               ENDDO
            JI=0
               ! PRIMITIVE IN I-SHELL
               DO IG = 1, NGI                 
                  ! PRIMITIVE IN J-SHELL
                  DO JG = 1, NGJ
                  JI = JI + 1
                     AB = dd_AB_PRE(LOCdd(iijj)+JI)
                     DUM = dd_DUM_PRE(LOCdd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3) = dd_P_PRE(1:3,LOCdd(iijj)+JI)
                     PAV(1:3) = dd_PAV_PRE(1:3,LOCdd(iijj)+JI)
                     CPV(1:3) = CC(1:3,3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = dd_DUM0_PRE(LOCdd(iijj)+JI)

                     IJ = 0
                     DO I=1,NI
                        DUM2 = DUM0*CCD(I,IG,III)
                        DO J=1,NJ
                           IJ = IJ+1
                           DBID(IJ) = DUM2*CCD(J,JG,JJJ)
                        ENDDO
                     ENDDO !I


                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        IF(NROOTS.EQ.3) THEN
                           CALL RT3_gpu(XX,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.4) THEN
                           CALL ROOT4_gpu(XX,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.5) THEN
                           CALL ROOT5_gpu(XX,U,W,NROOTS)                     
                        ELSEIF(NROOTS.GE.6) THEN
                           CALL ROOT6_gpu(XX,U,W,NROOTS)                     
                        ENDIF
! I32_AO_BOYS_gpu
                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AJINV2 = half*AJINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           B2(IR) = AJINV2-AJINV2*VAL2
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G2ID(1 + 3*(IR-1)) = one
                           G2ID(2 + 3*(IR-1)) = one
                           G2ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO

! I32_AO_R1_gpu
                        DO IR = 1, NROOTS
                           G2ID(1+(IR-1)*3+3*NROOTS) = A1(1,IR)
                           G2ID(2+(IR-1)*3+3*NROOTS) = A1(2,IR)
                           G2ID(3+(IR-1)*3+3*NROOTS) = A1(3,IR)*F00(IR)
                        END DO

                        DO I = 2, LB
                           DO IR=1,NROOTS
                              DO K=1,3
                                 G2ID(K+3*(IR-1)+ 3*NROOTS*I) = &
                                          A1(K,IR)*G2ID(K+3*(IR-1)+3*NROOTS*(I-1)) &
                                    + (I-1)*B1(IR)*G2ID(K+3*(IR-1)+3*NROOTS*(I-2))
                              ENDDO
                           ENDDO
                        ENDDO

! I32_AO_TRIPLET_gpu
                        IF (LK.EQ.0) GOTO 333
                        !!!!!!!!!!!!!!!!!!!!!


                        DO IR = 1, NROOTS
                           G2ID(1+3*(IR-1)+N3B) = A2(1,IR)
                           G2ID(2+3*(IR-1)+N3B) = A2(2,IR)
                           G2ID(3+3*(IR-1)+N3B) = A2(3,IR)*F00(IR)
                           DO K=1,3
                               G2ID(K+3*(IR-1)+N3+N3B) = &
                                       A1(K,IR)*G2ID(K+3*(IR-1)+N3B) &
                                       + C1(IR)*G2ID(K+3*(IR-1))
                           ENDDO
                        ENDDO

                        DO I = 2, LB
                           DO IR=1,NROOTS
                              DO K=1,3
                                  G2ID(K+3*(IR-1)+N3*I+N3B) = &
                                          A1(K,IR)*G2ID(K+3*(IR-1)+N3*(I-1)+N3B) &
                                    + (I-1)*B1(IR)*G2ID(K+3*(IR-1)+N3*(I-2)+N3B) &
                                          + C1(IR)*G2ID(K+3*(IR-1)+N3*(I-1))
                              ENDDO
                           ENDDO
                        ENDDO

                        IF(LK.EQ.1) GOTO 333
                        !!!!!!!!!!!!!!!!!!!!

                        DO J=2,LK
                           DO IR=1,NROOTS
                              DO K=1,3
                                 G2ID(K+3*(IR-1)+N3B*J) = &
                                          A2(K,IR)*G2ID(K+3*(IR-1)+N3B*(J-1)) &
                                           + (J-1)*B2(IR)*G2ID(K+3*(IR-1)+N3B*(J-2))
                                 G2ID(K+3*(IR-1)+N3+N3B*J) = &
                                          A1(K,IR)*G2ID(K+3*(IR-1)+N3B*J) &
                                        + J*C1(IR)*G2ID(K+3*(IR-1)+N3B*(J-1))
                              ENDDO
                           ENDDO

                           DO I = 2, LB
                              DO IR=1,NROOTS
                                 DO K=1,3
                                    G2ID(K+3*(IR-1)+N3*I+N3B*J) = &
                                             A1(K,IR)*G2ID(K+3*(IR-1)+N3*(I-1)+N3B*J) &
                                       + (I-1)*B1(IR)*G2ID(K+3*(IR-1)+N3*(I-2)+N3B*J) &
                                           + J*C1(IR)*G2ID(K+3*(IR-1)+N3*(I-1)+N3B*(J-1))
                                 ENDDO
                              ENDDO
                           ENDDO
                        ENDDO

  333 CONTINUE
! I32_AO_PRODXYZ_gpu

                        
                        DO KK = 0, LK
                           DO JJ = 0, LJ-1

                              DO IR=1,NROOTS
                                 DO II=0,LI               
                                    DO IA=1,3
                                       G3ID(IA+3*(IR-1)+N3*II+N3I*JJ+N3IJ*KK) = &
                                                G2ID(IA+3*(IR-1)+N3*II+N3B*KK)
                                    ENDDO
                                 ENDDO
                              ENDDO
                              
                              IF(LJ .GT. 0) THEN
                                 DO II = 0, 3-JJ
                                    DO IR=1,NROOTS
                                       DO IA=1,3
                                          G2ID(IA+3*(IR-1)+N3*II+N3B*KK) = &
                                                   VAL(IA)*G2ID(IA+3*(IR-1)+N3*II+N3B*KK) &
                                                 + G2ID(IA+3*(IR-1)+N3*(II+1)+N3B*KK)
                                       ENDDO
                                    ENDDO
                                 ENDDO
                              ENDIF

                           ENDDO !JJ
                        ENDDO !KK

                        DO KK=0,LK
                           DO II=0,LI
                              DO IR=1,NROOTS
                                 DO IA=1,3
                                    G3ID(IA+3*(IR-1)+N3*II+N3I*LJ+N3IJ*KK) = &
                                             G2ID(IA+3*(IR-1)+N3*II+N3B*KK)
                                 ENDDO
                              ENDDO
                           ENDDO
                        ENDDO

                        IJ = 0
                        IJK = 0
                        DO I = 1, NI
                           NIX = LLIJ(1,I)
                           NIY = LLIJ(2,I)
                           NIZ = LLIJ(3,I)
                           DO J = 1, NJ
                              NJX = LLIJ(1,J)
                              NJY = LLIJ(2,J)
                              NJZ = LLIJ(3,J)
                              IJ = IJ+1

                              DO K = 1, NK
                                 NKX = LLK(1,K)
                                 NKY = LLK(2,K)
                                 NKZ = LLK(3,K)
                                 VALL = zero
                                 DO IR = 1, NROOTS
                                    I3=3*(IR-1)
                                    IDX = I3 + N3*NIX + N3I*NJX + N3IJ*NKX
                                    IDY = I3 + N3*NIY + N3I*NJY + N3IJ*NKY
                                    IDZ = I3 + N3*NIZ + N3I*NJZ + N3IJ*NKZ
                                    VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                                 ENDDO
                                 IJK = IJK+1
                                 GGID(IJK) = GGID(IJK) + DBID(IJ)*DK(K)*VALL
                              ENDDO

                           ENDDO
                        ENDDO

                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG


               ! TRANSFORM TO SPHERICAL
               DO J = 1,36
                  DO I=1,NKS
                     IJ = (J-1)*NKS + I
                     T1(IJ) = zero
                     DO K=1,NK
                        KJ = (J-1)*NK + K
                        T1(IJ) = T1(IJ) + TLL(K,I,INDEX)*GGID(KJ)
                     ENDDO
                  ENDDO
               ENDDO
            
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO II=1,NI
                     DO JJ=1,NJ
                        IBF = LOCI+II
                        JBF = LOCJ+JJ
                        LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                        I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                        I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                     ENDDO
                  ENDDO
               ENDDO

         ENDDO 
      ENDDO 
!$omp end parallel do


      END SUBROUTINE
