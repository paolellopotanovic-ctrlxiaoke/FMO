
      SUBROUTINE RIMP2_X_FORM_I32_X011 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  LOCSPH

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      use shellProcessing,only: CCP

      use shellpairs,only: pp_PAV_PRE, &
                           pp_P_PRE,   &
                           pp_DUM0_PRE,&
                           pp_DUM_PRE, &
                           pp_AB_PRE,  &
                           pp_VAL_PRE, &
                           LOCpp,   &
                           N_pp_PRE

      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: X,U(2),W(2)
      integer :: NROOTS
      
      ! OUTPUT
      double precision :: GGID(16)
      double precision :: VALL
      double precision :: DK


      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,2),B1(2),C1(2),           &
                          A2(3,2),B2(2),F00(2)

      ! double precision :: G2ID(24) !G2(3,NROOTS,0:LI,0:LJ)
      ! double precision :: G3ID(2688) !G3(3,NROOTS,0:LI,0:LJ,0:LK)
      double precision :: G3ID(30) !G3(3,NROOTS,0:LI,0:LJ,0:LK)
      double precision :: DBID(16)
                        
      integer :: LLI(3,4),LLJ(3,4)

      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK, &
                 LOCK,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ, &
                 NGJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AIJINVSQ,AIINV2,AIJINV,AIINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ
      integer :: I_ELSE,ISIZE,IR,IJK,KNK,INI

      integer :: iijj,ji,iijj_tmp
         


      IF(N_ELSE.EQ.0) RETURN



! TOTAL ANG MOM & ROOTS
NROOTS = 2
N3 = 6
N3I = 18


!$omp parallel do default(none) &
!$omp shared(I_P_SHL,KMIN,KNG,KLOC,KAUXAT,C,KAUXNG,KAUXST,KAUXLO,LOCSPH,N3I) &
!$omp shared(DAUX,TOL,EXAUX,N_P_SHL,LX,LY,LZ,PP_VAL_PRE,KAUX_ELSE,LOCKT_INIT,pp_AB_PRE) &
!$omp shared(LOCPP,PP_DUM_PRE,PP_P_PRE,PP_PAV_PRE,PP_DUM0_PRE,CCP,NROOTS,N3,I32,N_ELSE) &
!$omp private(ISH,JSH,MINI,NI,NGI,LOCI,MINJ,NJ,NGJ,LOCJ,KAUXSH,KAT,CC,NGK,K1,LOCK) &
!$omp private(IAUXSTART,DK,GGID,IJ,DBID,G3ID,VALL,IBF,JBF,LIJ) &
!$omp private(VAL,AB,DUM,CPV,PAV,RR,DUM0,DUM2,AK,RHO,X,U,A1,B1,F00) &
!$omp private(INI,LLI,JNJ,LLJ,AIJINVSQ,AIINV,AIINV2,VAL1,III,JJJ,IIJJ) &
!$omp private(JI,IJK,NIX,NIY,NIZ,NJX,NJY,NJZ,I3,IDX,IDY,IDZ) &
!$omp private(IG,AI,TMP,AIRAB,W) 

   ! DO III =1, N_P_SHL
   !    DO JJJ = 1,III


DO iijj_tmp = 0, N_P_SHL*(N_P_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

         ISH = I_P_SHL(III)
         JSH = I_P_SHL(JJJ)

         iijj = JJJ + (III-1)*III/2

         MINI  = KMIN(ISH)
         NI    = 5-MINI
         NGI   = KNG(ISH)
         LOCI  = KLOC(ISH)-1

         DO I=MINI,4
            INI=I-MINI+1
            LLI(1,INI) = LX(I)
            LLI(2,INI) = LY(I)
            LLI(3,INI) = LZ(I)
         ENDDO

         MINJ  = KMIN(JSH)
         NJ    = 5-MINJ
         NGJ   = KNG(JSH)
         LOCJ  = KLOC(JSH)-1

         DO J=MINJ,4
            JNJ=J-MINJ+1
            LLJ(1,JNJ) = LX(J)
            LLJ(2,JNJ) = LY(J)
            LLJ(3,JNJ) = LZ(J)
         ENDDO
   
         VAL(1:3) = pp_VAL_PRE(1:3,iijj)
         


! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
         DO I_ELSE=1,N_ELSE
            ! DO ISH = 1,NSHELL
            KAUXSH = KAUX_ELSE(I_ELSE)

            KAT = KAUXAT(KAUXSH)
            CC(1) = C(1,KAT)
            CC(2) = C(2,KAT)
            CC(3) = C(3,KAT)

            NGK   = KAUXNG(KAUXSH)
            K1    = KAUXST(KAUXSH)
            LOCK  = KAUXLO(KAUXSH)-1

            ! AUX POINTER FOR I32
            IauxStart = LOCSPH(KAUXSH)
            IauxStart = IauxStart-LOCKT_init+1

            ! DENSITY FACTOR
            DK = PI252 * DAux(KAUXSH,1,1)

            ! ZERO OUT INTEGRAL ARRAY
            DO II=1,NI*NJ
               GGID(II)=zero
            ENDDO
            
            JI=0 
            ! PRIMITIVE IN I-SHELL
            DO IG = 1, NGI                 
               ! PRIMITIVE IN J-SHELL
               DO JG = 1, NGJ
                  JI=JI+1
                  AB = pp_AB_PRE(LOCpp(iijj)+JI)
                  DUM = pp_DUM_PRE(LOCpp(iijj)+JI)
                  IF (DUM > TOL) CYCLE
                  CPV(1:3) = pp_P_PRE(1:3,LOCpp(iijj)+JI)
                  PAV(1:3) = pp_PAV_PRE(1:3,LOCpp(iijj)+JI)
                  ! aux shell involved
                  CPV(1:3) = CC(1:3)-CPV(1:3)
                  RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                  DUM0 = pp_DUM0_PRE(LOCpp(iijj)+JI)

                  IJ = 0
                  DO I=1,NI
                     DUM2 = DUM0*CCP(I,IG,III)
                     DO J=1,NJ
                        IJ = IJ+1
                        DBID(IJ) = DUM2*CCP(J,JG,JJJ)
                     ENDDO
                  ENDDO !I


                  ! PRIMITIVE IN K-SHELL
                  DO KG = 1, NGK
                     AK = EXAUX(K1+KG-1)
                     RHO = AB*AK/(AB+AK)
                     X = RHO*RR

                     ! RYS ROOTS AND WEIGHT
                     CALL RT2_gpu(X,U,W,NROOTS)

                     AIJINVSQ = one/(AB+AK)
                     RHO = AB*AK*AIJINVSQ
                     AIINV  = one/AB
                     AIINV2 = half*AIINV
                     AIJINVSQ = SQRT(AIJINVSQ)

                     DO IR = 1, NROOTS
                        U(IR) = U(IR)*RHO
                        U(IR) = U(IR)/(RHO+U(IR))
                        VAL1 = RHO*AIINV*U(IR)
                        A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                        B1(IR) = AIINV2-AIINV2*VAL1
                        F00(IR) = AIJINVSQ*W(IR)
                        G3ID(1 + 3*(IR-1)) = one
                        G3ID(2 + 3*(IR-1)) = one
                        G3ID(3 + 3*(IR-1)) = F00(IR)
                     ENDDO

DO IR=1,2
   G3ID(4+IR*3) = A1(1,IR)
   G3ID(5+IR*3) = A1(2,IR)
   G3ID(6+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,2
   G3ID(16+IR*3) = VAL(1 )  +  G3ID(4+IR*3)
   G3ID(17+IR*3) = VAL(2 )  +  G3ID(5+IR*3)
   G3ID(18+IR*3) = VAL(3 )*G3ID(IR*3) +  G3ID(6+IR*3)
ENDDO
DO IR=1,2
   G3ID(22+IR*3) = A1(1,IR)*G3ID(4+IR*3) +  B1(IR)
   G3ID(23+IR*3) = A1(2,IR)*G3ID(5+IR*3) +  B1(IR)
   G3ID(24+IR*3) = A1(3,IR)*G3ID(6+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,2
   G3ID(22+IR*3) = VAL(1 )*G3ID(4+IR*3) +  G3ID(22+IR*3)
   G3ID(23+IR*3) = VAL(2 )*G3ID(5+IR*3) +  G3ID(23+IR*3)
   G3ID(24+IR*3) = VAL(3 )*G3ID(6+IR*3) +  G3ID(24+IR*3)
ENDDO


                     IJ = 0
                     IJK = 0
                     DO I = 1, NI
                        NIX = LLI(1,I)
                        NIY = LLI(2,I)
                        NIZ = LLI(3,I)
                        DO J = 1, NJ
                           NJX = LLJ(1,J)
                           NJY = LLJ(2,J)
                           NJZ = LLJ(3,J)
                           IJ = IJ+1
                           VALL = zero
                           DO IR = 1, NROOTS
                              I3=3*(IR-1)
                              IDX = I3 + N3*NIX + N3I*NJX
                              IDY = I3 + N3*NIY + N3I*NJY
                              IDZ = I3 + N3*NIZ + N3I*NJZ
                              VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                           ENDDO
                           IJK = IJK+1
                           GGID(IJK) = GGID(IJK) + DBID(IJ)*DK*VALL
                        ENDDO
                     ENDDO

                  ENDDO !KG
               ENDDO !JG
            ENDDO !IG


            ! COPY INTEGRAL GG(P|MN) TO I32
            DO II=1,NI
               DO JJ=1,NJ
                  IBF = LOCI+II
                  JBF = LOCJ+JJ
                  LIJ = JJ+(II-1)*NJ
                  I32(IBF,JBF,IauxStart) = GGID(LIJ) 
                  I32(JBF,IBF,IauxStart) = GGID(LIJ) 
               ENDDO
            ENDDO


        ENDDO !ISH
      ! ENDDO !JSH
   ENDDO !KSH
!$omp end parallel do


      END SUBROUTINE


      SUBROUTINE RIMP2_X_FORM_I32_X111 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      use shellProcessing,only: CCP

      use shellpairs,only: pp_PAV_PRE, &
                           pp_P_PRE,   &
                           pp_DUM0_PRE,&
                           pp_DUM_PRE, &
                           pp_AB_PRE,  &
                           pp_VAL_PRE, &
                           LOCpp,   &
                           N_pp_PRE

      implicit none


      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(2),W(2)
      integer :: NROOTS
      
      ! OUTPUT
      ! double precision :: GG(NI*NJ*NK)
      ! double precision :: GG(MXBSH*MXBSH*MXBSH)
      double precision :: GGID(48)
      double precision :: DK(3)
      double precision :: VALL


      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,2),B1(2),C1(2),           &
                          A2(3,2),F00(2)


      double precision :: G3ID(66)
      double precision :: DBID(16)
                        
      integer :: LLI(3,4),LLJ(3,4),LLK(3,3)

      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj,ji,iijj_tmp
         

      IF(N_ELSE.EQ.0) RETURN


NROOTS = 2
N3=6
N3B=18
N3I=18
N3IJ=36

MINKT=2
MAXKT=4
NKS=3

LK=1
MINK=2
MAXK=4
NK=3

IF(KAUXMI(KAUX_ELSE(1)).NE.MINK) CALL ABRT

DO K=MINK,MAXK
   KNK=K-MINK+1
   LLK(1,KNK) = LX(K)
   LLK(2,KNK) = LY(K)
   LLK(3,KNK) = LZ(K)
ENDDO



!$omp parallel do default(none) &
!$omp shared(N_P_SHL) &
!$omp shared(EXAUX,KAUXAT,KAUXTY,KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO)    &
!$omp shared(EX,C,KMIN,KNG,KSTART,KLOC,NSHELL)         &
!$omp shared(MIXS,TLL,DAux,LOCSPH,TOL)     &
!$omp shared(LX,LY,LZ,lockt_init)           &
!$omp shared(I32) &
!$omp shared(pp_PAV_PRE,pp_P_PRE,pp_DUM0_PRE,pp_DUM_PRE) &
!$omp shared(pp_AB_PRE,pp_VAL_PRE,LOCpp,N_pp_PRE) &
!$omp shared(I_P_SHL,CCP,KAUX_ELSE,N_ELSE) &
!$omp shared(NROOTS,N3,N3B,N3I,N3IJ) &
!$omp shared(LK,MINK,MAXK,NK) &
!$omp shared(LLK,MINKT,MAXKT,NKS) &
!$omp private(G3ID,GGID,DBID,VALL) &
!$omp private(CC,KAUXSH,KAT,NGK,K1,LOCK,             &
!$omp         ISH,IAT,MINI,NI,NGI,I1,LOCI,                   &
!$omp         JSH,JAT,MINJ,NJ,NGJ,J1,LOCJ,                   &
!$omp         DK,IauxStart,INDEX, &
!$omp        ILOC,JLOC,NLJ,LNKS,IBF,JBF,LIJ,KJ,IJ) &
!$omp private(LTOT) & 
!$omp private(VAL,IG,AI,TMP,AIRAB) &
!$omp private(JG,AJ,AB,ABINV,EXPB,P,PAV,CPV,RR,DUM,DUM0,DUM2) &
!$omp private(XX,U,W,AK,RHO,A1,B1,C1,A2,F00) &
!$omp private(LL,II,KG,I,J,K) &
!$omp private(U2,T2,VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2) &
!$omp private(LLI,LLJ) &
!$omp private(KNK,INI,JNJ) &
!$omp private(aijinv2,aijinvsq,aiinv2,aijinv,aiinv,ajinv) &
!$omp private(NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ) &
!$omp private(I3,IDX,IDZ,IDY,IJK,FACTOR) &
!$omp private(iijj,JI,iijj_tmp,III,JJJ) 

   ! DO III =1, N_P_SHL
   !    DO JJJ = 1,III


DO iijj_tmp = 0, N_P_SHL*(N_P_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

         ISH = I_P_SHL(III)
         JSH = I_P_SHL(JJJ)

         iijj = JJJ + (III-1)*III/2

         MINI  = KMIN(ISH)
         NI    = 5-MINI
         NGI   = KNG(ISH)
         LOCI  = KLOC(ISH)-1

         DO I=MINI,4
            INI=I-MINI+1
            LLI(1,INI) = LX(I)
            LLI(2,INI) = LY(I)
            LLI(3,INI) = LZ(I)
         ENDDO

         MINJ  = KMIN(JSH)
         NJ    = 5-MINJ
         NGJ   = KNG(JSH)
         LOCJ  = KLOC(JSH)-1

         DO J=MINJ,4
            JNJ=J-MINJ+1
            LLJ(1,JNJ) = LX(J)
            LLJ(2,JNJ) = LY(J)
            LLJ(3,JNJ) = LZ(J)
         ENDDO
   
         VAL(1:3) = pp_VAL_PRE(1:3,iijj)
         


! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
         DO I_ELSE=1,N_ELSE
            ! DO ISH = 1,NSHELL
            KAUXSH = KAUX_ELSE(I_ELSE)

            KAT = KAUXAT(KAUXSH)
            CC(1) = C(1,KAT)
            CC(2) = C(2,KAT)
            CC(3) = C(3,KAT)

            NGK   = KAUXNG(KAUXSH)
            K1    = KAUXST(KAUXSH)
            LOCK  = KAUXLO(KAUXSH)-MINK
            INDEX = MINK+LK

            ! SPHERICAL TRANSFORMATION
            IauxStart = LOCSPH(KAUXSH)
            ! AUX POINTER FOR I32
            IauxStart = IauxStart-LOCKT_init+1           
            ! DENSITY FACTOR
            DO K=1,NK
               DK(K) = PI252 * DAux(KAUXSH,1,K)
            ENDDO

            ! ZERO OUT INTEGRAL ARRAY
            DO II=1,NI*NJ*NK
               GGID(II)=zero
            ENDDO
            
            JI=0 
            ! PRIMITIVE IN I-SHELL
            DO IG = 1, NGI                 
               ! PRIMITIVE IN J-SHELL
               DO JG = 1, NGJ
                  JI=JI+1
                  AB = pp_AB_PRE(LOCpp(iijj)+JI)
                  DUM = pp_DUM_PRE(LOCpp(iijj)+JI)
                  IF (DUM > TOL) CYCLE
                  CPV(1:3) = pp_P_PRE(1:3,LOCpp(iijj)+JI)
                  PAV(1:3) = pp_PAV_PRE(1:3,LOCpp(iijj)+JI)
                  ! aux shell involved
                  CPV(1:3) = CC(1:3)-CPV(1:3)
                  RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                  DUM0 = pp_DUM0_PRE(LOCpp(iijj)+JI)

                  IJ = 0
                  DO I=1,NI
                     DUM2 = DUM0*CCP(I,IG,III)
                     DO J=1,NJ
                        IJ = IJ+1
                        DBID(IJ) = DUM2*CCP(J,JG,JJJ)
                     ENDDO
                  ENDDO !I



                  ! PRIMITIVE IN K-SHELL
                  DO KG = 1, NGK
                     AK = EXAUX(K1+KG-1)
                     RHO = AB*AK/(AB+AK)
                     XX = RHO*RR

                     ! RYS ROOTS AND WEIGHT
                     CALL RT2_gpu(XX,U,W,NROOTS)
! I32_AO_BOYS_gpu
                     AIJINV = one/(AB+AK)
                     RHO = AB*AK*AIJINV
                     AIINV  = one/AB
                     AJINV  = one/AK
                     AIINV2 = half*AIINV
                     AIJINV2 = half*AIJINV
                     AIJINVSQ = SQRT(AIJINV)

                     DO IR = 1, NROOTS
                        U2 = U(IR)*RHO
                        T2 = U2/(RHO+U2)
                        VAL1 = RHO*AIINV*T2
                        VAL2 = RHO*AJINV*T2
                        A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                        A2(1:3,IR) = -VAL2*CPV(1:3)
                        B1(IR) = AIINV2-AIINV2*VAL1
                        C1(IR) = AIJINV2*T2
                        F00(IR) = AIJINVSQ*W(IR)
                        G3ID(1 + 3*(IR-1)) = one
                        G3ID(2 + 3*(IR-1)) = one
                        G3ID(3 + 3*(IR-1)) = F00(IR)
                     ENDDO

DO IR=1,2
   G3ID(4+IR*3) = A1(1,IR)
   G3ID(5+IR*3) = A1(2,IR)
   G3ID(6+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,2
   G3ID(16+IR*3) = VAL(1)  +  G3ID(4+IR*3)
   G3ID(17+IR*3) = VAL(2)  +  G3ID(5+IR*3)
   G3ID(18+IR*3) = VAL(3)*G3ID(IR*3) +  G3ID(6+IR*3)
ENDDO
DO IR=1,2
   G3ID(22+IR*3) = A1(1,IR)*G3ID(4+IR*3) +  B1(IR)
   G3ID(23+IR*3) = A1(2,IR)*G3ID(5+IR*3) +  B1(IR)
   G3ID(24+IR*3) = A1(3,IR)*G3ID(6+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,2
   G3ID(22+IR*3) = VAL(1)*G3ID(4+IR*3) +  G3ID(22+IR*3)
   G3ID(23+IR*3) = VAL(2)*G3ID(5+IR*3) +  G3ID(23+IR*3)
   G3ID(24+IR*3) = VAL(3)*G3ID(6+IR*3) +  G3ID(24+IR*3)
ENDDO
DO IR=1,2
   G3ID(34+IR*3) = A2(1,IR)
   G3ID(35+IR*3) = A2(2,IR)
   G3ID(36+IR*3) = A2(3,IR)*F00(IR)
ENDDO
DO IR=1,2
   G3ID(40+IR*3) = A1(1,IR)*G3ID(34+IR*3) +  C1(IR)
   G3ID(41+IR*3) = A1(2,IR)*G3ID(35+IR*3) +  C1(IR)
   G3ID(42+IR*3) = A1(3,IR)*G3ID(36+IR*3) +  C1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,2
   G3ID(52+IR*3) = VAL(1)*G3ID(34+IR*3) +  G3ID(40+IR*3)
   G3ID(53+IR*3) = VAL(2)*G3ID(35+IR*3) +  G3ID(41+IR*3)
   G3ID(54+IR*3) = VAL(3)*G3ID(36+IR*3) +  G3ID(42+IR*3)
ENDDO
DO IR=1,2
   G3ID(58+IR*3) = A1(1,IR)*G3ID(40+IR*3) +  B1(IR)*G3ID(34+IR*3) +  C1(IR)*G3ID(4+IR*3)
   G3ID(59+IR*3) = A1(2,IR)*G3ID(41+IR*3) +  B1(IR)*G3ID(35+IR*3) +  C1(IR)*G3ID(5+IR*3)
   G3ID(60+IR*3) = A1(3,IR)*G3ID(42+IR*3) +  B1(IR)*G3ID(36+IR*3) +  C1(IR)*G3ID(6+IR*3)
ENDDO
DO IR=1,2
   G3ID(58+IR*3) = VAL(1)*G3ID(40+IR*3) +  G3ID(58+IR*3)
   G3ID(59+IR*3) = VAL(2)*G3ID(41+IR*3) +  G3ID(59+IR*3)
   G3ID(60+IR*3) = VAL(3)*G3ID(42+IR*3) +  G3ID(60+IR*3)
ENDDO



                     IJ = 0
                     IJK = 0
                     DO I = 1, NI
                        NIX = LLI(1,I)
                        NIY = LLI(2,I)
                        NIZ = LLI(3,I)
                        DO J = 1, NJ
                           NJX = LLJ(1,J)
                           NJY = LLJ(2,J)
                           NJZ = LLJ(3,J)
                           IJ = IJ+1
                           DO K = 1, NK
                              NKX = LLK(1,K)
                              NKY = LLK(2,K)
                              NKZ = LLK(3,K)
                              VALL = zero
                              DO IR = 1, NROOTS
                                 I3=3*(IR-1)
                                 IDX = I3 + N3*NIX + N3I*NJX + N3IJ*NKX
                                 IDY = I3 + N3*NIY + N3I*NJY + N3IJ*NKY
                                 IDZ = I3 + N3*NIZ + N3I*NJZ + N3IJ*NKZ
                                 VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                              ENDDO
                              IJK = IJK+1
                              GGID(IJK) = GGID(IJK) + DBID(IJ)*DK(K)*VALL
                           ENDDO

                        ENDDO
                     ENDDO

                  ENDDO !KG
               ENDDO !JG
            ENDDO !IG


            ! COPY INTEGRAL GG(P|MN) TO I32
            NLJ = NKS*NJ
            DO LNKS=1,NKS
               DO II=1,NI
                  DO JJ=1,NJ
                     IBF = LOCI+II
                     JBF = LOCJ+JJ
                     LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                     I32(IBF,JBF,IauxStart+LNKS-1) = GGID(LIJ) 
                     I32(JBF,IBF,IauxStart+LNKS-1) = GGID(LIJ) 
                  ENDDO
               ENDDO
            ENDDO

        ENDDO !ISH
      ! ENDDO !JSH
   ENDDO !KSH
!$omp end parallel do


      END SUBROUTINE


      SUBROUTINE RIMP2_X_FORM_I32_X211 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      use shellProcessing,only: CCP

      use shellpairs,only: pp_PAV_PRE, &
                           pp_P_PRE,   &
                           pp_DUM0_PRE,&
                           pp_DUM_PRE, &
                           pp_AB_PRE,  &
                           pp_VAL_PRE, &
                           LOCpp,   &
                           N_pp_PRE

      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(13),W(13)
      integer :: NROOTS
      
      ! OUTPUT
      ! double precision :: GG(NI*NJ*NK)
      ! double precision :: GG(MXBSH*MXBSH*MXBSH)
      double precision :: GGID(96)
      double precision :: DK(6)
      double precision :: T1(80)
      double precision :: VALL


      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,3),B1(3),C1(3),           &
                          A2(3,3),B2(3),F00(3)


      double precision :: G3ID(153)
      double precision :: DBID(16)
                        
      integer :: LLI(3,4),LLJ(3,4),LLK(3,6)

      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj,ji,iijj_tmp
         


      IF(N_ELSE.EQ.0) RETURN




NROOTS = 3
N3=9
N3B=27
N3I=27
N3IJ=54

LK=2
MINK=5
MAXK=10
NK=6

MINKT=5
MAXKT=9
NKS=5

DO K=MINK,MAXK
   KNK=K-MINK+1
   LLK(1,KNK) = LX(K)
   LLK(2,KNK) = LY(K)
   LLK(3,KNK) = LZ(K)
ENDDO


!$omp parallel do default(none) &
!$omp shared(N_P_SHL) &
!$omp shared(EXAUX,KAUXAT,KAUXNG,KAUXST,KAUXLO)    &
!$omp shared(EX,C,KMIN,KNG,KSTART,KLOC,NSHELL)         &
!$omp shared(TLL,DAux,LOCSPH,TOL)     &
!$omp shared(LX,LY,LZ,lockt_init)           &
!$omp shared(I32) &
!$omp shared(pp_PAV_PRE,pp_P_PRE,pp_DUM0_PRE,pp_DUM_PRE) &
!$omp shared(pp_AB_PRE,pp_VAL_PRE,LOCpp,N_pp_PRE) &
!$omp shared(I_P_SHL,CCP,KAUX_ELSE,N_ELSE) &
!$omp shared(NROOTS,N3,N3B,N3I,N3IJ) &
!$omp shared(LK,MINK,MAXK,NK) &
!$omp shared(LLK,MINKT,MAXKT,NKS) &
!$omp private(G3ID,GGID,DBID,VALL) &
!$omp private(CC,KAUXSH,KAT,NGK,K1,LOCK,             &
!$omp         ISH,IAT,MINI,NI,NGI,I1,LOCI,                   &
!$omp         JSH,JAT,MINJ,NJ,NGJ,J1,LOCJ,                   &
!$omp         DK,T1,IauxStart,INDEX, &
!$omp        ILOC,JLOC,NLJ,LNKS,IBF,JBF,LIJ,KJ,IJ) &
!$omp private(VAL,IG,AI,TMP,AIRAB) &
!$omp private(JG,AJ,AB,ABINV,EXPB,P,PAV,CPV,RR,DUM,DUM0,DUM2) &
!$omp private(XX,U,W,AK,RHO,A1,B1,C1,A2,B2,F00) &
!$omp private(LL,II,KG,I,J,K) &
!$omp private(U2,T2,VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2) &
!$omp private(LLI,LLJ) &
!$omp private(KNK,INI,JNJ) &
!$omp private(ajinv2,aijinv2,aijinvsq,aiinv2,aijinv,aiinv,ajinv) &
!$omp private(NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ) &
!$omp private(I3,IDX,IDZ,IDY,IJK,FACTOR) &
!$omp private(iijj,JI,iijj_tmp,III,JJJ) 

   ! DO III =1, N_P_SHL
   !    DO JJJ = 1,III


DO iijj_tmp = 0, N_P_SHL*(N_P_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

         ISH = I_P_SHL(III)
         JSH = I_P_SHL(JJJ)

         iijj = JJJ + (III-1)*III/2

         MINI  = KMIN(ISH)
         NI    = 5-MINI
         NGI   = KNG(ISH)
         LOCI  = KLOC(ISH)-1

         DO I=MINI,4
            INI=I-MINI+1
            LLI(1,INI) = LX(I)
            LLI(2,INI) = LY(I)
            LLI(3,INI) = LZ(I)
         ENDDO

         MINJ  = KMIN(JSH)
         NJ    = 5-MINJ
         NGJ   = KNG(JSH)
         LOCJ  = KLOC(JSH)-1

         DO J=MINJ,4
            JNJ=J-MINJ+1
            LLJ(1,JNJ) = LX(J)
            LLJ(2,JNJ) = LY(J)
            LLJ(3,JNJ) = LZ(J)
         ENDDO
   
         VAL(1:3) = pp_VAL_PRE(1:3,iijj)
         

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
         DO I_ELSE=1,N_ELSE
            ! DO ISH = 1,NSHELL
            KAUXSH = KAUX_ELSE(I_ELSE)

            KAT = KAUXAT(KAUXSH)
            CC(1) = C(1,KAT)
            CC(2) = C(2,KAT)
            CC(3) = C(3,KAT)

            NGK   = KAUXNG(KAUXSH)
            K1    = KAUXST(KAUXSH)
            LOCK  = KAUXLO(KAUXSH)-MINK
            INDEX = MINK+LK

            ! SPHERICAL TRANSFORMATION
            IauxStart = LOCSPH(KAUXSH)
            ! AUX POINTER FOR I32
            IauxStart = IauxStart-LOCKT_init+1           

            ! DENSITY FACTOR
            DO K=1,NK
               DK(K) = PI252 * DAux(KAUXSH,1,K)
            ENDDO

            ! ZERO OUT INTEGRAL ARRAY
            DO II=1,NI*NJ*NK
               GGID(II)=zero
            ENDDO
            
            JI=0 
            ! PRIMITIVE IN I-SHELL
            DO IG = 1, NGI                 
               ! PRIMITIVE IN J-SHELL
               DO JG = 1, NGJ
                  JI=JI+1
                  AB = pp_AB_PRE(LOCpp(iijj)+JI)
                  DUM = pp_DUM_PRE(LOCpp(iijj)+JI)
                  IF (DUM > TOL) CYCLE
                  CPV(1:3) = pp_P_PRE(1:3,LOCpp(iijj)+JI)
                  PAV(1:3) = pp_PAV_PRE(1:3,LOCpp(iijj)+JI)
                  CPV(1:3) = CC(1:3)-CPV(1:3)
                  RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                  DUM0 = pp_DUM0_PRE(LOCpp(iijj)+JI)

                  IJ = 0
                  DO I=1,NI
                     DUM2 = DUM0*CCP(I,IG,III)
                     DO J=1,NJ
                        IJ = IJ+1
                        DBID(IJ) = DUM2*CCP(J,JG,JJJ)
                     ENDDO
                  ENDDO !I


                  ! PRIMITIVE IN K-SHELL
                  DO KG = 1, NGK
                     AK = EXAUX(K1+KG-1)
                     RHO = AB*AK/(AB+AK)
                     XX = RHO*RR

                     ! RYS ROOTS AND WEIGHT
                     CALL RT3_gpu(XX,U,W,NROOTS)
! I32_AO_BOYS_gpu
                     AIJINV = one/(AB+AK)
                     RHO = AB*AK*AIJINV
                     AIINV  = one/AB
                     AJINV  = one/AK
                     AIINV2 = half*AIINV
                     AJINV2 = half*AJINV
                     AIJINV2 = half*AIJINV
                     AIJINVSQ = SQRT(AIJINV)

                     DO IR = 1, NROOTS
                        U2 = U(IR)*RHO
                        T2 = U2/(RHO+U2)
                        VAL1 = RHO*AIINV*T2
                        VAL2 = RHO*AJINV*T2
                        A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                        A2(1:3,IR) = -VAL2*CPV(1:3)
                        B1(IR) = AIINV2-AIINV2*VAL1
                        B2(IR) = AJINV2-AJINV2*VAL2
                        C1(IR) = AIJINV2*T2
                        F00(IR) = AIJINVSQ*W(IR)
                        G3ID(1 + 3*(IR-1)) = one
                        G3ID(2 + 3*(IR-1)) = one
                        G3ID(3 + 3*(IR-1)) = F00(IR)
                     ENDDO

DO IR=1,3
   G3ID(7+IR*3) = A1(1,IR)
   G3ID(8+IR*3) = A1(2,IR)
   G3ID(9+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,3
   G3ID(25+IR*3) = VAL(1)  +  G3ID(7+IR*3)
   G3ID(26+IR*3) = VAL(2)  +  G3ID(8+IR*3)
   G3ID(27+IR*3) = VAL(3)*G3ID(0+IR*3) +  G3ID(9+IR*3)
ENDDO
DO IR=1,3
   G3ID(34+IR*3) = A1(1,IR)*G3ID(7+IR*3) +  B1(IR)
   G3ID(35+IR*3) = A1(2,IR)*G3ID(8+IR*3) +  B1(IR)
   G3ID(36+IR*3) = A1(3,IR)*G3ID(9+IR*3) +  B1(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,3
   G3ID(34+IR*3) = VAL(1)*G3ID(7+IR*3) +  G3ID(34+IR*3)
   G3ID(35+IR*3) = VAL(2)*G3ID(8+IR*3) +  G3ID(35+IR*3)
   G3ID(36+IR*3) = VAL(3)*G3ID(9+IR*3) +  G3ID(36+IR*3)
ENDDO
DO IR=1,3
   G3ID(52+IR*3) = A2(1,IR)
   G3ID(53+IR*3) = A2(2,IR)
   G3ID(54+IR*3) = A2(3,IR)*F00(IR)
ENDDO
DO IR=1,3
   G3ID(61+IR*3) = A1(1,IR)*G3ID(52+IR*3) +  C1(IR)
   G3ID(62+IR*3) = A1(2,IR)*G3ID(53+IR*3) +  C1(IR)
   G3ID(63+IR*3) = A1(3,IR)*G3ID(54+IR*3) +  C1(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,3
   G3ID(79+IR*3) = VAL(1)*G3ID(52+IR*3) +  G3ID(61+IR*3)
   G3ID(80+IR*3) = VAL(2)*G3ID(53+IR*3) +  G3ID(62+IR*3)
   G3ID(81+IR*3) = VAL(3)*G3ID(54+IR*3) +  G3ID(63+IR*3)
ENDDO
DO IR=1,3
   G3ID(88+IR*3) = A1(1,IR)*G3ID(61+IR*3) +  B1(IR)*G3ID(52+IR*3) +  C1(IR)*G3ID(7+IR*3)
   G3ID(89+IR*3) = A1(2,IR)*G3ID(62+IR*3) +  B1(IR)*G3ID(53+IR*3) +  C1(IR)*G3ID(8+IR*3)
   G3ID(90+IR*3) = A1(3,IR)*G3ID(63+IR*3) +  B1(IR)*G3ID(54+IR*3) +  C1(IR)*G3ID(9+IR*3)
ENDDO
DO IR=1,3
   G3ID(88+IR*3) = VAL(1)*G3ID(61+IR*3) +  G3ID(88+IR*3)
   G3ID(89+IR*3) = VAL(2)*G3ID(62+IR*3) +  G3ID(89+IR*3)
   G3ID(90+IR*3) = VAL(3)*G3ID(63+IR*3) +  G3ID(90+IR*3)
ENDDO
DO IR=1,3
   G3ID(106+IR*3) = A2(1,IR)*G3ID(52+IR*3) +  B2(IR)
   G3ID(107+IR*3) = A2(2,IR)*G3ID(53+IR*3) +  B2(IR)
   G3ID(108+IR*3) = A2(3,IR)*G3ID(54+IR*3) +  B2(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,3
   G3ID(115+IR*3) = A1(1,IR)*G3ID(106+IR*3) +  2*C1(IR)*G3ID(52+IR*3)
   G3ID(116+IR*3) = A1(2,IR)*G3ID(107+IR*3) +  2*C1(IR)*G3ID(53+IR*3)
   G3ID(117+IR*3) = A1(3,IR)*G3ID(108+IR*3) +  2*C1(IR)*G3ID(54+IR*3)
ENDDO
DO IR=1,3
   G3ID(133+IR*3) = VAL(1)*G3ID(106+IR*3) +  G3ID(115+IR*3)
   G3ID(134+IR*3) = VAL(2)*G3ID(107+IR*3) +  G3ID(116+IR*3)
   G3ID(135+IR*3) = VAL(3)*G3ID(108+IR*3) +  G3ID(117+IR*3)
ENDDO
DO IR=1,3
   G3ID(142+IR*3) = A1(1,IR)*G3ID(115+IR*3) +  B1(IR)*G3ID(106+IR*3) +  2*C1(IR)*G3ID(61+IR*3)
   G3ID(143+IR*3) = A1(2,IR)*G3ID(116+IR*3) +  B1(IR)*G3ID(107+IR*3) +  2*C1(IR)*G3ID(62+IR*3)
   G3ID(144+IR*3) = A1(3,IR)*G3ID(117+IR*3) +  B1(IR)*G3ID(108+IR*3) +  2*C1(IR)*G3ID(63+IR*3)
ENDDO
DO IR=1,3
   G3ID(142+IR*3) = VAL(1)*G3ID(115+IR*3) +  G3ID(142+IR*3)
   G3ID(143+IR*3) = VAL(2)*G3ID(116+IR*3) +  G3ID(143+IR*3)
   G3ID(144+IR*3) = VAL(3)*G3ID(117+IR*3) +  G3ID(144+IR*3)
ENDDO

                     IJ = 0
                     IJK = 0
                     DO I = 1, NI
                        NIX = LLI(1,I)
                        NIY = LLI(2,I)
                        NIZ = LLI(3,I)
                        DO J = 1, NJ
                           NJX = LLJ(1,J)
                           NJY = LLJ(2,J)
                           NJZ = LLJ(3,J)
                           IJ = IJ+1
                           DO K = 1, NK
                              NKX = LLK(1,K)
                              NKY = LLK(2,K)
                              NKZ = LLK(3,K)
                              VALL = zero
                              DO IR = 1, NROOTS
                                 I3=3*(IR-1)
                                 IDX = I3 + N3*NIX + N3I*NJX + N3IJ*NKX
                                 IDY = I3 + N3*NIY + N3I*NJY + N3IJ*NKY
                                 IDZ = I3 + N3*NIZ + N3I*NJZ + N3IJ*NKZ
                                 VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                              ENDDO
                              IJK = IJK+1
                              GGID(IJK) = GGID(IJK) + DBID(IJ)*DK(K)*VALL
                           ENDDO

                        ENDDO
                     ENDDO

                  ENDDO !KG
               ENDDO !JG
            ENDDO !IG


            ! TRANSFORM TO SPHERICAL
            DO J = 1,NI*NJ
               DO I=1,NKS               
                  IJ = (J-1)*NKS + I              
                  T1(IJ) = zero
                  DO K=1,NK
                     KJ = (J-1)*NK + K
                     T1(IJ) = T1(IJ) + TLL(K,I,INDEX)*GGID(KJ)
                  ENDDO
               ENDDO
            ENDDO
         
            ! COPY INTEGRAL GG(P|MN) TO I32
            NLJ = NKS*NJ
            DO LNKS=1,NKS
               DO II=1,NI
                  DO JJ=1,NJ
                     IBF = LOCI+II
                     JBF = LOCJ+JJ
                     LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                     I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                     I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                  ENDDO
               ENDDO
            ENDDO

        ENDDO !ISH
      ! ENDDO !JSH
   ENDDO !KSH
!$omp end parallel do


      END SUBROUTINE


      SUBROUTINE RIMP2_X_FORM_I32_X311 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL,zero,one,half

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      use shellProcessing,only: CCP

      use shellpairs,only: pp_PAV_PRE, &
                           pp_P_PRE,   &
                           pp_DUM0_PRE,&
                           pp_DUM_PRE, &
                           pp_AB_PRE,  &
                           pp_VAL_PRE, &
                           LOCpp,   &
                           N_pp_PRE

      implicit none

      ! 
      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(13),W(13)
      integer :: NROOTS
      
      double precision :: GGID(4*4*10),T1(4*4*7)
      double precision :: DK(10)
      double precision :: VALL


      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,3),B1(3),C1(3),           &
                          A2(3,3),B2(3),F00(3)

      double precision :: G2ID(108)
      double precision :: G3ID(207)
      double precision :: DBID(16)
                        
      integer :: LLI(3,4),LLJ(3,4),LLK(3,10)

      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ, &
                 NGJ,LOCJ,J1,JLOC,JG

      integer :: NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj,ji,iijj_tmp
         

      IF(N_ELSE.EQ.0) RETURN



! TOTAL ANG MOM & ROOTS
NROOTS = 3
N3=9
N3B=27
N3I=27
N3IJ=54

MINK=11
MAXK=20
NK=10
LK = 3

MINKT=10
MAXKT=16
NKS=7

DO K=MINK,MAXK
   KNK=K-MINK+1
   LLK(1,KNK) = LX(K)
   LLK(2,KNK) = LY(K)
   LLK(3,KNK) = LZ(K)
ENDDO



!$omp parallel do default(none) &
!$omp shared(N_P_SHL) &
!$omp shared(EXAUX,KAUXAT,KAUXNG,KAUXST,KAUXLO)    &
!$omp shared(EX,C,KMIN,KNG,KSTART,KLOC,NSHELL)         &
!$omp shared(MIXS,TLL,DAux,LOCSPH,TOL)     &
!$omp shared(LX,LY,LZ,LddiAuxShStart,LddiAuxShEnd,lockt_init)           &
!$omp shared(I32) &
!$omp shared(pp_PAV_PRE,pp_P_PRE,pp_DUM0_PRE,pp_DUM_PRE) &
!$omp shared(pp_AB_PRE,pp_VAL_PRE,LOCpp,N_pp_PRE) &
!$omp shared(I_P_SHL,CCP,KAUX_ELSE,N_ELSE) &
!$omp shared(MINK,MAXK,NK,LK) &
!$omp shared(MINKT,MAXKT,NKS) &
!$omp shared(LLK) &
!$omp shared(NROOTS,N3,N3B,N3I,N3IJ) &
!$omp private(G3ID,GGID,DBID,VALL) &
!$omp private(CC,KAUXSH,KAT,NGK,K1,LOCK,             &
!$omp         ISH,IAT,MINI,NI,NGI,I1,LOCI,                   &
!$omp         JSH,JAT,MINJ,NJ,NGJ,J1,LOCJ,                   &
!$omp         DK,T1,IauxStart,INDEX, &
!$omp        ILOC,JLOC,NLJ,LNKS,IBF,JBF,LIJ,KJ,IJ) &
!$omp private(VAL,IG,AI,TMP,AIRAB) &
!$omp private(JG,AJ,AB,ABINV,EXPB,P,PAV,CPV,RR,DUM,DUM0,DUM2) &
!$omp private(XX,U,W,AK,RHO,A1,B1,C1,A2,B2,F00) &
!$omp private(LL,II,KG,I,J,K) &
!$omp private(VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2) &
!$omp private(LLI,LLJ) &
!$omp private(KNK,INI,JNJ) &
!$omp private(ajinv2,aijinv2,aijinvsq,aiinv2,aijinv,aiinv,ajinv) &
!$omp private(NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ) &
!$omp private(I3,IDX,IDZ,IDY,IJK,FACTOR) &
!$omp private(iijj,JI,iijj_tmp,III,JJJ) 

   ! DO III =1, N_P_SHL
   !    DO JJJ = 1,III


DO iijj_tmp = 0, N_P_SHL*(N_P_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

         ISH = I_P_SHL(III)
         JSH = I_P_SHL(JJJ)

         iijj = JJJ + (III-1)*III/2

         MINI  = KMIN(ISH)
         NI    = 5-MINI
         NGI   = KNG(ISH)
         LOCI  = KLOC(ISH)-1

         DO I=MINI,4
            INI=I-MINI+1
            LLI(1,INI) = LX(I)
            LLI(2,INI) = LY(I)
            LLI(3,INI) = LZ(I)
         ENDDO

         MINJ  = KMIN(JSH)
         NJ    = 5-MINJ
         NGJ   = KNG(JSH)
         LOCJ  = KLOC(JSH)-1

         DO J=MINJ,4
            JNJ=J-MINJ+1
            LLJ(1,JNJ) = LX(J)
            LLJ(2,JNJ) = LY(J)
            LLJ(3,JNJ) = LZ(J)
         ENDDO
   
         VAL(1:3) = pp_VAL_PRE(1:3,iijj)
         


! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
         DO I_ELSE=1,N_ELSE
            ! DO ISH = 1,NSHELL
            KAUXSH = KAUX_ELSE(I_ELSE)

            KAT = KAUXAT(KAUXSH)
            CC(1) = C(1,KAT)
            CC(2) = C(2,KAT)
            CC(3) = C(3,KAT)

            NGK   = KAUXNG(KAUXSH)
            K1    = KAUXST(KAUXSH)
            LOCK  = KAUXLO(KAUXSH)-MINK
            INDEX = MINK+LK

            IauxStart = LOCSPH(KAUXSH)

            ! AUX POINTER FOR I32
            IauxStart = IauxStart-LOCKT_init+1

            ! DENSITY FACTOR
            DO K=1,NK
               DK(K) = PI252 * DAux(KAUXSH,1,K)
            ENDDO

            ! ZERO OUT INTEGRAL ARRAY
            DO II=1,NI*NJ*NK
               GGID(II)=zero
            ENDDO
            
            JI=0 
            ! PRIMITIVE IN I-SHELL
            DO IG = 1, NGI                 
               ! PRIMITIVE IN J-SHELL
               DO JG = 1, NGJ
                  JI=JI+1
                  AB = pp_AB_PRE(LOCpp(iijj)+JI)
                  DUM = pp_DUM_PRE(LOCpp(iijj)+JI)
                  IF (DUM > TOL) CYCLE
                  CPV(1:3) = pp_P_PRE(1:3,LOCpp(iijj)+JI)
                  PAV(1:3) = pp_PAV_PRE(1:3,LOCpp(iijj)+JI)

                  CPV(1:3) = CC(1:3)-CPV(1:3)
                  RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                  DUM0 = pp_DUM0_PRE(LOCpp(iijj)+JI)

                  IJ = 0
                  DO I=1,NI
                     DUM2 = DUM0*CCP(I,IG,III)
                     DO J=1,NJ
                        IJ = IJ+1
                        DBID(IJ) = DUM2*CCP(J,JG,JJJ)
                     ENDDO
                  ENDDO !I


                  ! PRIMITIVE IN K-SHELL
                  DO KG = 1, NGK
                     AK = EXAUX(K1+KG-1)
                     RHO = AB*AK/(AB+AK)
                     XX = RHO*RR

                     ! RYS ROOTS AND WEIGHT
                     CALL RT3_gpu(XX,U,W,NROOTS)

! I32_AO_BOYS_gpu
                     AIJINV = one/(AB+AK)
                     RHO = AB*AK*AIJINV
                     AIINV  = one/AB
                     AJINV  = one/AK
                     AIINV2 = half*AIINV
                     AJINV2 = half*AJINV
                     AIJINV2 = half*AIJINV
                     AIJINVSQ = SQRT(AIJINV)

                     DO IR = 1, NROOTS
                        U(IR) = U(IR)*RHO
                        U(IR) = U(IR)/(RHO+U(IR))
                        VAL1 = RHO*AIINV*U(IR)
                        VAL2 = RHO*AJINV*U(IR)
                        A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                        A2(1:3,IR) = -VAL2*CPV(1:3)
                        B1(IR) = AIINV2-AIINV2*VAL1
                        B2(IR) = AJINV2-AJINV2*VAL2
                        C1(IR) = AIJINV2*U(IR)
                        F00(IR) = AIJINVSQ*W(IR)
                        G3ID(1 + 3*(IR-1)) = one
                        G3ID(2 + 3*(IR-1)) = one
                        G3ID(3 + 3*(IR-1)) = F00(IR)
                     ENDDO


DO IR=1,3
   G3ID(7+IR*3) = A1(1,IR)
   G3ID(8+IR*3) = A1(2,IR)
   G3ID(9+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,3
   G3ID(25+IR*3) =VAL(1)  +  G3ID(7+IR*3)
   G3ID(26+IR*3) =VAL(2)  +  G3ID(8+IR*3)
   G3ID(27+IR*3) =VAL(3)*G3ID(0+IR*3) +  G3ID(9+IR*3)
ENDDO
DO IR=1,3
   G3ID(34+IR*3) = A1(1,IR)*G3ID(7+IR*3) +  B1(IR)
   G3ID(35+IR*3) = A1(2,IR)*G3ID(8+IR*3) +  B1(IR)
   G3ID(36+IR*3) = A1(3,IR)*G3ID(9+IR*3) +  B1(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,3
   G3ID(34+IR*3) =VAL(1)*G3ID(7+IR*3) +  G3ID(34+IR*3)
   G3ID(35+IR*3) =VAL(2)*G3ID(8+IR*3) +  G3ID(35+IR*3)
   G3ID(36+IR*3) =VAL(3)*G3ID(9+IR*3) +  G3ID(36+IR*3)
ENDDO
DO IR=1,3
   G3ID(52+IR*3) = A2(1,IR)
   G3ID(53+IR*3) = A2(2,IR)
   G3ID(54+IR*3) = A2(3,IR)*F00(IR)
ENDDO
DO IR=1,3
   G3ID(61+IR*3) = A1(1,IR)*G3ID(52+IR*3) +  C1(IR)
   G3ID(62+IR*3) = A1(2,IR)*G3ID(53+IR*3) +  C1(IR)
   G3ID(63+IR*3) = A1(3,IR)*G3ID(54+IR*3) +  C1(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,3
   G3ID(79+IR*3) =VAL(1)*G3ID(52+IR*3) +  G3ID(61+IR*3)
   G3ID(80+IR*3) =VAL(2)*G3ID(53+IR*3) +  G3ID(62+IR*3)
   G3ID(81+IR*3) =VAL(3)*G3ID(54+IR*3) +  G3ID(63+IR*3)
ENDDO
DO IR=1,3
   G3ID(88+IR*3) = A1(1,IR)*G3ID(61+IR*3) +  B1(IR)*G3ID(52+IR*3) +  C1(IR)*G3ID(7+IR*3)
   G3ID(89+IR*3) = A1(2,IR)*G3ID(62+IR*3) +  B1(IR)*G3ID(53+IR*3) +  C1(IR)*G3ID(8+IR*3)
   G3ID(90+IR*3) = A1(3,IR)*G3ID(63+IR*3) +  B1(IR)*G3ID(54+IR*3) +  C1(IR)*G3ID(9+IR*3)
ENDDO
DO IR=1,3
   G3ID(88+IR*3) =VAL(1)*G3ID(61+IR*3) +  G3ID(88+IR*3)
   G3ID(89+IR*3) =VAL(2)*G3ID(62+IR*3) +  G3ID(89+IR*3)
   G3ID(90+IR*3) =VAL(3)*G3ID(63+IR*3) +  G3ID(90+IR*3)
ENDDO
DO IR=1,3
   G3ID(106+IR*3) = A2(1,IR)*G3ID(52+IR*3) +  B2(IR)
   G3ID(107+IR*3) = A2(2,IR)*G3ID(53+IR*3) +  B2(IR)
   G3ID(108+IR*3) = A2(3,IR)*G3ID(54+IR*3) +  B2(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,3
   G3ID(115+IR*3) = A1(1,IR)*G3ID(106+IR*3) +  2*C1(IR)*G3ID(52+IR*3)
   G3ID(116+IR*3) = A1(2,IR)*G3ID(107+IR*3) +  2*C1(IR)*G3ID(53+IR*3)
   G3ID(117+IR*3) = A1(3,IR)*G3ID(108+IR*3) +  2*C1(IR)*G3ID(54+IR*3)
ENDDO
DO IR=1,3
   G3ID(133+IR*3) =VAL(1)*G3ID(106+IR*3) +  G3ID(115+IR*3)
   G3ID(134+IR*3) =VAL(2)*G3ID(107+IR*3) +  G3ID(116+IR*3)
   G3ID(135+IR*3) =VAL(3)*G3ID(108+IR*3) +  G3ID(117+IR*3)
ENDDO
DO IR=1,3
   G3ID(142+IR*3) = A1(1,IR)*G3ID(115+IR*3) +  B1(IR)*G3ID(106+IR*3) +  2*C1(IR)*G3ID(61+IR*3)
   G3ID(143+IR*3) = A1(2,IR)*G3ID(116+IR*3) +  B1(IR)*G3ID(107+IR*3) +  2*C1(IR)*G3ID(62+IR*3)
   G3ID(144+IR*3) = A1(3,IR)*G3ID(117+IR*3) +  B1(IR)*G3ID(108+IR*3) +  2*C1(IR)*G3ID(63+IR*3)
ENDDO
DO IR=1,3
   G3ID(142+IR*3) =VAL(1)*G3ID(115+IR*3) +  G3ID(142+IR*3)
   G3ID(143+IR*3) =VAL(2)*G3ID(116+IR*3) +  G3ID(143+IR*3)
   G3ID(144+IR*3) =VAL(3)*G3ID(117+IR*3) +  G3ID(144+IR*3)
ENDDO
DO IR=1,3
   G3ID(160+IR*3) = A2(1,IR)*G3ID(106+IR*3) +  2*B2(IR)*G3ID(52+IR*3)
   G3ID(161+IR*3) = A2(2,IR)*G3ID(107+IR*3) +  2*B2(IR)*G3ID(53+IR*3)
   G3ID(162+IR*3) = A2(3,IR)*G3ID(108+IR*3) +  2*B2(IR)*G3ID(54+IR*3)
ENDDO
DO IR=1,3
   G3ID(169+IR*3) = A1(1,IR)*G3ID(160+IR*3) +  3*C1(IR)*G3ID(106+IR*3)
   G3ID(170+IR*3) = A1(2,IR)*G3ID(161+IR*3) +  3*C1(IR)*G3ID(107+IR*3)
   G3ID(171+IR*3) = A1(3,IR)*G3ID(162+IR*3) +  3*C1(IR)*G3ID(108+IR*3)
ENDDO
DO IR=1,3
   G3ID(187+IR*3) =VAL(1)*G3ID(160+IR*3) +  G3ID(169+IR*3)
   G3ID(188+IR*3) =VAL(2)*G3ID(161+IR*3) +  G3ID(170+IR*3)
   G3ID(189+IR*3) =VAL(3)*G3ID(162+IR*3) +  G3ID(171+IR*3)
ENDDO
DO IR=1,3
   G3ID(196+IR*3) = A1(1,IR)*G3ID(169+IR*3) +  B1(IR)*G3ID(160+IR*3) +  3*C1(IR)*G3ID(115+IR*3)
   G3ID(197+IR*3) = A1(2,IR)*G3ID(170+IR*3) +  B1(IR)*G3ID(161+IR*3) +  3*C1(IR)*G3ID(116+IR*3)
   G3ID(198+IR*3) = A1(3,IR)*G3ID(171+IR*3) +  B1(IR)*G3ID(162+IR*3) +  3*C1(IR)*G3ID(117+IR*3)
ENDDO
DO IR=1,3
   G3ID(196+IR*3) =VAL(1)*G3ID(169+IR*3) +  G3ID(196+IR*3)
   G3ID(197+IR*3) =VAL(2)*G3ID(170+IR*3) +  G3ID(197+IR*3)
   G3ID(198+IR*3) =VAL(3)*G3ID(171+IR*3) +  G3ID(198+IR*3)
ENDDO                   


                     IJ = 0
                     IJK = 0
                     DO I = 1, NI
                        NIX = LLI(1,I)
                        NIY = LLI(2,I)
                        NIZ = LLI(3,I)
                        DO J = 1, NJ
                           NJX = LLJ(1,J)
                           NJY = LLJ(2,J)
                           NJZ = LLJ(3,J)
                           IJ = IJ+1

                           DO K = 1, NK
                              NKX = LLK(1,K)
                              NKY = LLK(2,K)
                              NKZ = LLK(3,K)

                              VALL = zero
                              DO IR = 1, NROOTS
                                 I3=3*(IR-1)
                                 IDX = I3 + N3*NIX + N3I*NJX + N3IJ*NKX
                                 IDY = I3 + N3*NIY + N3I*NJY + N3IJ*NKY
                                 IDZ = I3 + N3*NIZ + N3I*NJZ + N3IJ*NKZ
                                 VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                              ENDDO
                              IJK = IJK+1
                              GGID(IJK) = GGID(IJK) + DBID(IJ)*DK(K)*VALL
                           ENDDO

                        ENDDO
                     ENDDO

                  ENDDO !KG
               ENDDO !JG
            ENDDO !IG


            ! TRANSFORM TO SPHERICAL
            DO J = 1,NI*NJ
               DO I=1,NKS               
                  IJ = (J-1)*NKS + I              
                  T1(IJ) = zero
                  DO K=1,NK
                     KJ = (J-1)*NK + K
                     T1(IJ) = T1(IJ) + TLL(K,I,INDEX)*GGID(KJ)
                  ENDDO
               ENDDO
            ENDDO
         
            ! COPY INTEGRAL GG(P|MN) TO I32
            NLJ = NKS*NJ
            DO LNKS=1,NKS
               DO II=1,NI
                  DO JJ=1,NJ
                     IBF = LOCI+II
                     JBF = LOCJ+JJ
                     LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                     I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                     I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                  ENDDO
               ENDDO
            ENDDO

        ENDDO !ISH
      ! ENDDO !JSH
   ENDDO !KSH
!$omp end parallel do

      ! DEALLOCATE(DK)

      END SUBROUTINE












      SUBROUTINE RIMP2_X_FORM_I32_X411 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one,eight

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL,zero,one,half

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      use shellProcessing,only: CCP

      use shellpairs,only: pp_PAV_PRE, &
                           pp_P_PRE,   &
                           pp_DUM0_PRE,&
                           pp_DUM_PRE, &
                           pp_AB_PRE,  &
                           pp_VAL_PRE, &
                           LOCpp,   &
                           N_pp_PRE

      implicit none



      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(13),W(13)
      integer :: NROOTS
      
      ! OUTPUT
      ! double precision :: GG(NI*NJ*NK)
      ! double precision :: GG(MXBSH*MXBSH*MXBSH)
      double precision :: GGID(240),T1(144)
      double precision :: DK(15)
      double precision :: VALL


      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,4),B1(13),C1(13),           &
                          A2(3,13),B2(13),F00(13)

      ! double precision :: G2ID(728) !G2(3,NROOTS,0:LI,0:LJ)
      ! double precision :: G3ID(2688) !G3(3,NROOTS,0:LI,0:LJ,0:LK)
      double precision :: G2ID(180) !G2(3,NROOTS,0:LI,0:LJ)
      double precision :: G3ID(348) !G3(3,NROOTS,0:LI,0:LJ,0:LK)

      double precision :: DBID(16)
                        
      integer :: LLI(3,4),LLJ(3,4),LLK(3,15)

      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)
      ! double precision :: TL(NK*NKS)
      ! double precision :: TLL(15,9,25)

      ! double precision :: T1(NKS*NI*NJ)

      ! double precision :: TL(*)
      ! double precision :: T1(MXBSH*MXBSH*MXBSH)
      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NI,MINI,NGI, &
                 LI,LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ,MINJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,NLJ

      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

      integer :: iijj,ji,iijj_tmp
         

      IF(N_ELSE.EQ.0) RETURN


NROOTS=4
N3=12
N3B=36
N3I=36
N3IJ=72

MINK=21
MAXK=35
NK=15
LK=4

DO K=MINK,MAXK
   KNK=K-MINK+1
   LLK(1,KNK) = LX(K)
   LLK(2,KNK) = LY(K)
   LLK(3,KNK) = LZ(K)
ENDDO

MINKT=17
MAXKT=25
NKS=9

!$omp parallel do default(none) &
!$omp shared(N_P_SHL) &
!$omp shared(EXAUX,KAUXAT,KAUXNG,KAUXST,KAUXLO)    &
!$omp shared(EX,C,KMIN,KNG,KSTART,KLOC,NSHELL)         &
!$omp shared(MIXS,TLL,DAux,LOCSPH,TOL)     &
!$omp shared(LX,LY,LZ,LddiAuxShStart,LddiAuxShEnd,lockt_init)           &
!$omp shared(I32) &
!$omp shared(pp_PAV_PRE,pp_P_PRE,pp_DUM0_PRE,pp_DUM_PRE) &
!$omp shared(pp_AB_PRE,pp_VAL_PRE,LOCpp,N_pp_PRE) &
!$omp shared(I_P_SHL,CCP,KAUX_ELSE,N_ELSE) &
!$omp shared(NROOTS,N3,N3B,N3I,N3IJ) &
!$omp shared(MINK,MAXK,NK,LK) &
!$omp shared(LLK) &
!$omp shared(MINKT,MAXKT,NKS) &
!$omp private(G3ID,GGID,DBID,VALL) &
!$omp private(CC,KAUXSH,KAT,NGK,K1,LOCK,             &
!$omp         ISH,IAT,LI,MINI,NI,NGI,I1,LOCI,                   &
!$omp         JSH,JAT,LJ,MINJ,NJ,NGJ,J1,LOCJ,                   &
!$omp         DK,T1,IauxStart,INDEX, &
!$omp        ILOC,JLOC,NLJ,LNKS,IBF,JBF,LIJ,KJ,IJ) &
!$omp private(VAL,IG,AI,TMP,AIRAB) &
!$omp private(JG,AJ,AB,ABINV,EXPB,P,PAV,CPV,RR,DUM,DUM0,DUM2) &
!$omp private(XX,U,W,AK,RHO,A1,B1,C1,A2,B2,F00) &
!$omp private(LL,II,KG,I,J,K) &
!$omp private(U2,T2,VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2) &
!$omp private(LLI,LLJ) &
!$omp private(KNK,INI,JNJ) &
!$omp private(ajinv2,aijinv2,aijinvsq,aiinv2,aijinv,aiinv,ajinv) &
!$omp private(NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ) &
!$omp private(I3,IDX,IDZ,IDY,IJK,FACTOR) &
!$omp private(iijj,JI,iijj_tmp,III,JJJ) 

   ! DO III =1, N_P_SHL
   !    DO JJJ = 1,III


DO iijj_tmp = 0, N_P_SHL*(N_P_SHL+1)/2-1

   III = (1 + sqrt(one+eight*iijj_tmp))/2
   JJJ = iijj_tmp - III*(III-1)/2 + 1
   iijj =  iijj_tmp + 1

         ISH = I_P_SHL(III)
         JSH = I_P_SHL(JJJ)

         iijj = JJJ + (III-1)*III/2

         LI = 1
         MINI  = KMIN(ISH)
         NI    = 5-MINI
         NGI   = KNG(ISH)
         I1    = KSTART(ISH)
         LOCI  = KLOC(ISH)-MINI

         DO I=MINI,4
            INI=I-MINI+1
            LLI(1,INI) = LX(I)
            LLI(2,INI) = LY(I)
            LLI(3,INI) = LZ(I)
         ENDDO

         LJ = 1
         MINJ  = KMIN(JSH)
         NJ    = 5-MINJ
         NGJ   = KNG(JSH)
         J1    = KSTART(JSH)
         LOCJ  = KLOC(JSH)-MINJ

         DO J=MINJ,4
            JNJ=J-MINJ+1
            LLJ(1,JNJ) = LX(J)
            LLJ(2,JNJ) = LY(J)
            LLJ(3,JNJ) = LZ(J)
         ENDDO
   
         VAL(1:3) = pp_VAL_PRE(1:3,iijj)
         

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
         DO I_ELSE=1,N_ELSE
            ! DO ISH = 1,NSHELL
            KAUXSH = KAUX_ELSE(I_ELSE)

            KAT = KAUXAT(KAUXSH)
            CC(1) = C(1,KAT)
            CC(2) = C(2,KAT)
            CC(3) = C(3,KAT)

            NGK   = KAUXNG(KAUXSH)
            K1    = KAUXST(KAUXSH)
            LOCK  = KAUXLO(KAUXSH)-MINK
            INDEX = MINK+LK

            IauxStart = LOCSPH(KAUXSH)

            ! AUX POINTER FOR I32
            IauxStart = IauxStart-LOCKT_init+1           
            ! DENSITY FACTOR
            DO K=1,NK
               DK(K)=DAux(KAUXSH,1,K)
            ENDDO


            ! ZERO OUT INTEGRAL ARRAY
            DO II=1,NI*NJ*NK
               GGID(II)=zero
            ENDDO
            
            JI=0 
            ! PRIMITIVE IN I-SHELL
            DO IG = 1, NGI                 
               ! PRIMITIVE IN J-SHELL
               DO JG = 1, NGJ
                  JI=JI+1
                  AB = pp_AB_PRE(LOCpp(iijj)+JI)
                  DUM = pp_DUM_PRE(LOCpp(iijj)+JI)
                  IF (DUM > TOL) CYCLE
                  P(1:3) = pp_P_PRE(1:3,LOCpp(iijj)+JI)
                  PAV(1:3) = pp_PAV_PRE(1:3,LOCpp(iijj)+JI)
                  ! aux shell involved
                  CPV(1:3) = CC(1:3)-P(1:3)
                  RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                  DUM0 = pp_DUM0_PRE(LOCpp(iijj)+JI)

                  IJ = 0
                  DO I=1,NI
                     DUM2 = DUM0*CCP(I,IG,III)
                     DO J=1,NJ
                        IJ = IJ+1
                        DBID(IJ) = DUM2*CCP(J,JG,JJJ)
                     ENDDO
                  ENDDO !I


! write(*,*) "li,lj,lk",li,lj,lk
! write(*,*) "ni,nj,nk,nks",ni,nj,nk,nks
! write(*,*) "LTOT,NROOTS",LTOT,NROOTS


                  ! PRIMITIVE IN K-SHELL
                  DO KG = 1, NGK
                     AK = EXAUX(K1+KG-1)
                     RHO = AB*AK/(AB+AK)
                     XX = RHO*RR

                     ! RYS ROOTS AND WEIGHT
                     CALL ROOT4_gpu(XX,U,W,NROOTS)
! I32_AO_BOYS_gpu
                     AIJINV = one/(AB+AK)
                     RHO = AB*AK*AIJINV
                     AIINV  = one/AB
                     AJINV  = one/AK
                     AIINV2 = half*AIINV
                     AJINV2 = half*AJINV
                     AIJINV2 = half*AIJINV
                     AIJINVSQ = SQRT(AIJINV)

                     DO IR = 1, NROOTS
                        U2 = U(IR)*RHO
                        T2 = U2/(RHO+U2)
                        VAL1 = RHO*AIINV*T2
                        VAL2 = RHO*AJINV*T2
                        A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                        A2(1:3,IR) = -VAL2*CPV(1:3)
                        B1(IR) = AIINV2-AIINV2*VAL1
                        B2(IR) = AJINV2-AJINV2*VAL2
                        C1(IR) = AIJINV2*T2
                        F00(IR) = AIJINVSQ*W(IR)
                        G3ID(1 + 3*(IR-1)) = one
                        G3ID(2 + 3*(IR-1)) = one
                        G3ID(3 + 3*(IR-1)) = F00(IR)
                     ENDDO


G3ID(13) = A1(1 ,1)
G3ID(14) = A1(2 ,1)
G3ID(15) = A1(3 ,1)*F00(1)
G3ID(16) = A1(1 ,2)
G3ID(17) = A1(2 ,2)
G3ID(18) = A1(3 ,2)*F00(2)
G3ID(19) = A1(1 ,3)
G3ID(20) = A1(2 ,3)
G3ID(21) = A1(3 ,3)*F00(3)
G3ID(22) = A1(1 ,4)
G3ID(23) = A1(2 ,4)
G3ID(24) = A1(3 ,4)*F00(4)

G3ID(37) =VAL(1)*G3ID( 1)+ G3ID(13)
G3ID(38) =VAL(2)*G3ID( 2)+ G3ID(14)
G3ID(39) =VAL(3)*G3ID( 3)+ G3ID(15)
G3ID(40) =VAL(1)*G3ID( 4)+ G3ID(16)
G3ID(41) =VAL(2)*G3ID( 5)+ G3ID(17)
G3ID(42) =VAL(3)*G3ID( 6)+ G3ID(18)
G3ID(43) =VAL(1)*G3ID( 7)+ G3ID(19)
G3ID(44) =VAL(2)*G3ID( 8)+ G3ID(20)
G3ID(45) =VAL(3)*G3ID( 9)+ G3ID(21)
G3ID(46) =VAL(1)*G3ID(10)+ G3ID(22)
G3ID(47) =VAL(2)*G3ID(11)+ G3ID(23)
G3ID(48) =VAL(3)*G3ID(12)+ G3ID(24)


G3ID(49) = A1(1,1)*G3ID(13) + B1(1)*G3ID( 1)
G3ID(50) = A1(2,1)*G3ID(14) + B1(1)*G3ID( 2)
G3ID(51) = A1(3,1)*G3ID(15) + B1(1)*G3ID( 3)
G3ID(52) = A1(1,2)*G3ID(16) + B1(2)*G3ID( 4)
G3ID(53) = A1(2,2)*G3ID(17) + B1(2)*G3ID( 5)
G3ID(54) = A1(3,2)*G3ID(18) + B1(2)*G3ID( 6)
G3ID(55) = A1(1,3)*G3ID(19) + B1(3)*G3ID( 7)
G3ID(56) = A1(2,3)*G3ID(20) + B1(3)*G3ID( 8)
G3ID(57) = A1(3,3)*G3ID(21) + B1(3)*G3ID( 9)
G3ID(58) = A1(1,4)*G3ID(22) + B1(4)*G3ID(10)
G3ID(59) = A1(2,4)*G3ID(23) + B1(4)*G3ID(11)
G3ID(60) = A1(3,4)*G3ID(24) + B1(4)*G3ID(12)

G3ID(49) =VAL(1)*G3ID(13)+ G3ID(49)
G3ID(50) =VAL(2)*G3ID(14)+ G3ID(50)
G3ID(51) =VAL(3)*G3ID(15)+ G3ID(51)
G3ID(52) =VAL(1)*G3ID(16)+ G3ID(52)
G3ID(53) =VAL(2)*G3ID(17)+ G3ID(53)
G3ID(54) =VAL(3)*G3ID(18)+ G3ID(54)
G3ID(55) =VAL(1)*G3ID(19)+ G3ID(55)
G3ID(56) =VAL(2)*G3ID(20)+ G3ID(56)
G3ID(57) =VAL(3)*G3ID(21)+ G3ID(57)
G3ID(58) =VAL(1)*G3ID(22)+ G3ID(58)
G3ID(59) =VAL(2)*G3ID(23)+ G3ID(59)
G3ID(60) =VAL(3)*G3ID(24)+ G3ID(60)


G3ID(73) = A2(1,1)
G3ID(74) = A2(2,1)
G3ID(75) = A2(3,1)*F00(1)
G3ID(76) = A2(1,2)
G3ID(77) = A2(2,2)
G3ID(78) = A2(3,2)*F00(2)
G3ID(79) = A2(1,3)
G3ID(80) = A2(2,3)
G3ID(81) = A2(3,3)*F00(3)
G3ID(82) = A2(1,4)
G3ID(83) = A2(2,4)
G3ID(84) = A2(3,4)*F00(4)
G3ID(85) = A1(1,1)*G3ID(73) + C1(1)*G3ID( 1)
G3ID(86) = A1(2,1)*G3ID(74) + C1(1)*G3ID( 2)
G3ID(87) = A1(3,1)*G3ID(75) + C1(1)*G3ID( 3) 
G3ID(88) = A1(1,2)*G3ID(76) + C1(2)*G3ID( 4)
G3ID(89) = A1(2,2)*G3ID(77) + C1(2)*G3ID( 5)
G3ID(90) = A1(3,2)*G3ID(78) + C1(2)*G3ID( 6)
G3ID(91) = A1(1,3)*G3ID(79) + C1(3)*G3ID( 7)
G3ID(92) = A1(2,3)*G3ID(80) + C1(3)*G3ID( 8)
G3ID(93) = A1(3,3)*G3ID(81) + C1(3)*G3ID( 9)
G3ID(94) = A1(1,4)*G3ID(82) + C1(4)*G3ID(10)
G3ID(95) = A1(2,4)*G3ID(83) + C1(4)*G3ID(11)
G3ID(96) = A1(3,4)*G3ID(84) + C1(4)*G3ID(12)



G3ID(109) = VAL(1)*G3ID(73) + G3ID(85)
G3ID(110) = VAL(2)*G3ID(74) + G3ID(86)
G3ID(111) = VAL(3)*G3ID(75) + G3ID(87)
G3ID(112) = VAL(1)*G3ID(76) + G3ID(88)
G3ID(113) = VAL(2)*G3ID(77) + G3ID(89)
G3ID(114) = VAL(3)*G3ID(78) + G3ID(90)
G3ID(115) = VAL(1)*G3ID(79) + G3ID(91)
G3ID(116) = VAL(2)*G3ID(80) + G3ID(92)
G3ID(117) = VAL(3)*G3ID(81) + G3ID(93)
G3ID(118) = VAL(1)*G3ID(82) + G3ID(94)
G3ID(119) = VAL(2)*G3ID(83) + G3ID(95)
G3ID(120) = VAL(3)*G3ID(84) + G3ID(96)

G3ID(121) = A1(1,1)*G3ID(85) + B1(1)*G3ID(73) + C1(1)*G3ID(13)
G3ID(122) = A1(2,1)*G3ID(86) + B1(1)*G3ID(74) + C1(1)*G3ID(14)
G3ID(123) = A1(3,1)*G3ID(87) + B1(1)*G3ID(75) + C1(1)*G3ID(15)
G3ID(124) = A1(1,2)*G3ID(88) + B1(2)*G3ID(76) + C1(2)*G3ID(16)
G3ID(125) = A1(2,2)*G3ID(89) + B1(2)*G3ID(77) + C1(2)*G3ID(17)
G3ID(126) = A1(3,2)*G3ID(90) + B1(2)*G3ID(78) + C1(2)*G3ID(18)
G3ID(127) = A1(1,3)*G3ID(91) + B1(3)*G3ID(79) + C1(3)*G3ID(19)
G3ID(128) = A1(2,3)*G3ID(92) + B1(3)*G3ID(80) + C1(3)*G3ID(20)
G3ID(129) = A1(3,3)*G3ID(93) + B1(3)*G3ID(81) + C1(3)*G3ID(21)
G3ID(130) = A1(1,4)*G3ID(94) + B1(4)*G3ID(82) + C1(4)*G3ID(22)
G3ID(131) = A1(2,4)*G3ID(95) + B1(4)*G3ID(83) + C1(4)*G3ID(23)
G3ID(132) = A1(3,4)*G3ID(96) + B1(4)*G3ID(84) + C1(4)*G3ID(24)

G3ID(121) = VAL(1)*G3ID(85) + G3ID(121)
G3ID(122) = VAL(2)*G3ID(86) + G3ID(122)
G3ID(123) = VAL(3)*G3ID(87) + G3ID(123)
G3ID(124) = VAL(1)*G3ID(88) + G3ID(124)
G3ID(125) = VAL(2)*G3ID(89) + G3ID(125)
G3ID(126) = VAL(3)*G3ID(90) + G3ID(126)
G3ID(127) = VAL(1)*G3ID(91) + G3ID(127)
G3ID(128) = VAL(2)*G3ID(92) + G3ID(128)
G3ID(129) = VAL(3)*G3ID(93) + G3ID(129)
G3ID(130) = VAL(1)*G3ID(94) + G3ID(130)
G3ID(131) = VAL(2)*G3ID(95) + G3ID(131)
G3ID(132) = VAL(3)*G3ID(96) + G3ID(132)


G3ID(145) = A2(1,1)*G3ID(73) + B2(1)*G3ID( 1)
G3ID(146) = A2(2,1)*G3ID(74) + B2(1)*G3ID( 2)
G3ID(147) = A2(3,1)*G3ID(75) + B2(1)*G3ID( 3)
G3ID(148) = A2(1,2)*G3ID(76) + B2(2)*G3ID( 4)
G3ID(149) = A2(2,2)*G3ID(77) + B2(2)*G3ID( 5)
G3ID(150) = A2(3,2)*G3ID(78) + B2(2)*G3ID( 6)
G3ID(151) = A2(1,3)*G3ID(79) + B2(3)*G3ID( 7)
G3ID(152) = A2(2,3)*G3ID(80) + B2(3)*G3ID( 8)
G3ID(153) = A2(3,3)*G3ID(81) + B2(3)*G3ID( 9)
G3ID(154) = A2(1,4)*G3ID(82) + B2(4)*G3ID(10)
G3ID(155) = A2(2,4)*G3ID(83) + B2(4)*G3ID(11)
G3ID(156) = A2(3,4)*G3ID(84) + B2(4)*G3ID(12)

G3ID(157) = A1(1,1)*G3ID(145) + 2*C1(1)*G3ID(73)
G3ID(158) = A1(2,1)*G3ID(146) + 2*C1(1)*G3ID(74)
G3ID(159) = A1(3,1)*G3ID(147) + 2*C1(1)*G3ID(75)
G3ID(160) = A1(1,2)*G3ID(148) + 2*C1(2)*G3ID(76)
G3ID(161) = A1(2,2)*G3ID(149) + 2*C1(2)*G3ID(77)
G3ID(162) = A1(3,2)*G3ID(150) + 2*C1(2)*G3ID(78)
G3ID(163) = A1(1,3)*G3ID(151) + 2*C1(3)*G3ID(79)
