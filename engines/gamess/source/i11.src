                     IJ = 0
                     IJK = 0
                     DO I = 1, NI
                        NIX = LLI(1,I)
                        NIY = LLI(2,I)
                        NIZ = LLI(3,I)
                        DO J = 1, NJ
                           NJX = LLJ(1,J)
                           NJY = LLJ(2,J)
                           NJZ = LLJ(3,J)
                           IJ = IJ+1

                           FACTOR=PI252*DBID(IJ)

                           DO K = 1, NK
                              NKX = LLK(1,K)
                              NKY = LLK(2,K)
                              NKZ = LLK(3,K)
                              VALL = zero
                              DO IR = 1, NROOTS
                                 I3=3*(IR-1)
                                 IDX = I3 + N3*NIX + N3I*NJX + N3IJ*NKX
                                 IDY = I3 + N3*NIY + N3I*NJY + N3IJ*NKY
                                 IDZ = I3 + N3*NIZ + N3I*NJZ + N3IJ*NKZ
                                 VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                              ENDDO
                              IJK = IJK+1
                              GGID(IJK) = GGID(IJK) + FACTOR*DK(K)*VALL
                           ENDDO

                        ENDDO
                     ENDDO

                  ENDDO !KG
               ENDDO !JG
            ENDDO !IG


            ILOC=LOCI+MINI-1
            JLOC=LOCJ+MINJ-1

            ! TRANSFORM TO SPHERICAL
            DO J = 1,NI*NJ
               DO I=1,NKS               
                  IJ = (J-1)*NKS + I              
                  T1(IJ) = zero
                  DO K=1,NK
                     KJ = (J-1)*NK + K
                     T1(IJ) = T1(IJ) + TLL(K,I,INDEX)*GGID(KJ)
                  ENDDO
               ENDDO
            ENDDO
         
            ! COPY INTEGRAL GG(P|MN) TO I32
            NLJ = NKS*NJ
            DO LNKS=1,NKS
               DO II=1,NI
                  DO JJ=1,NJ
                     IBF = ILOC+II
                     JBF = JLOC+JJ
                     LIJ = LNKS+(JJ-1)*NKS+(II-1)*NLJ
                     I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                     I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                  ENDDO
               ENDDO
            ENDDO

        ENDDO !ISH
