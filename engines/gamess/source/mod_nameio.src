  !*MODULE mod_nameio DECK get_string_array_alloc
  !> @brief  This subroutine is masked by get_value. It is needed for string array converting
  !> @author Igor S. Gerasimov
  !> @date   Sep, 2019 --Initial release--
  !> @date   Mar, 2021 Moving routine to input_group class
  !> @param  key    - (in)  key in group
  !> @param  value  - (out) converted string array values
  !> @param  error  - (out) 0 if OK, KEY_NOT_FOUND if key was not found
  !> @param  def    - (in, optional) setting default value
  subroutine get_string_array_alloc(this, key, value, error, def)
    character(len=1), parameter :: comma = ","
    class(input_group), intent(inout) :: this
    character(len=*), intent(in) :: key
    character(len=:), dimension(:), allocatable, intent(out) :: value
    integer, intent(out) :: error
    character(len=:), allocatable, optional, intent(in) :: def
    ! internal variables
    character(len=:), allocatable :: section_value
    character(len=:), allocatable :: tmp_str
    integer :: lenarr, maxlen, i, ind
    error = OK
    section_value = this%section_Pairs%get_value(key, error)
    ! this error is not critical; it is OK for input file
    if(error .eq. KEY_NOT_FOUND) return
    if(error .ne. OK) call this%show_error(section_value)
    maxlen = 0
    lenarr = count_substring(comma,section_value)
    value = ""
    if(present(def)) value = def
    if(present(def)) maxlen = max(maxlen,len(def))
    !read(section_value, *, iostat = ios) value
    tmp_str = section_value
    do i = 1, lenarr
      ind = INDEX(tmp_str,comma)
      if(ind .eq. 0) then
        ind = len(tmp_str) + 1
      end if
      tmp_str = tmp_str(ind+1:)
      maxlen = max(maxlen, ind-1)
    end do
    allocate(value(lenarr),source=repeat(" ",maxlen))
    tmp_str = section_value
    do i = 1, lenarr
      ind = INDEX(tmp_str,comma)
      if(ind .eq. 0) then
        ind = len(tmp_str) + 1
      end if
      value(i) = tmp_str(:ind - 1)
      tmp_str = tmp_str(ind+1:)
    end do
  end subroutine get_string_array_alloc
  !*MODULE mod_nameio DECK show_error
  !> @brief  Show critical error after get_value
  !> @author Igor S. Gerasimov
  !> @date   May, 2021 --Initial release--
  !> @date   Jul, 2021 Using messages module
  !> @param  message - (in) error message
  subroutine show_error(this, message)
    use messages, only: show_message, WITH_ABORT
    class(input_group),            intent(inout) :: this
    character(len=:), allocatable, intent(in)    :: message
    call show_message("$"//this%name//": "//message, WITH_ABORT)
  end subroutine show_error
end module mod_nameio
