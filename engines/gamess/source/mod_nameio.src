  !*MODULE mod_nameio DECK get_string
  !> @brief  This subroutine is masked by get_value. It is needed for string converting
  !> @author Igor S. Gerasimov
  !> @date   Sep, 2019 --Initial release--
  !> @date   Mar, 2021 Moving routine to input_group class
  !> @param  key    - (in)  key in group
  !> @param  value  - (out) converted string value
  !> @param  error  - (out) 0 if OK, KEY_NOT_FOUND if key was not found
  !> @param  def    - (in, optional) setting default value
  subroutine get_string(this, key, value, error, def)
    class(input_group), intent(inout) :: this
    character(len=*), intent(in) :: key
    character(len=:), allocatable, intent(out) :: value
    integer, intent(out) :: error
    character(len=:), allocatable, intent(in), optional :: def
    ! internal variables
    character(len=:), allocatable :: section_value
    error = OK
    value = ""
    if(present(def)) value = def
    section_value = this%section_Pairs%get_value(key, error)
    ! this error is not critical; it is OK for input file
    if(error .eq. KEY_NOT_FOUND) return
    if(error .ne. OK) call this%show_error(section_value)
    value = trim(section_value)
  end subroutine get_string
  !*MODULE mod_nameio DECK get_logical_array
  !> @brief  This subroutine is masked by get_value. It is needed for logical array converting
  !> @author Igor S. Gerasimov
  !> @date   May, 2021 --Initial release--
  !> @param  key    - (in)  key in group
  !> @param  value  - (out) converted logical array values, must have explicit size
  !> @param  error  - (out) 0 if OK, KEY_NOT_FOUND if key was not found
  !> @param  def    - (in, optional) setting default value
  subroutine get_logical_array(this, key, value, error, def)
    character(len=1), parameter :: comma = ","
    class(input_group), intent(inout) :: this
    character(len=*), intent(in) :: key
    logical, dimension(:), intent(inout) :: value
    integer, intent(out) :: error
    logical, intent(in), optional :: def
    ! internal variables
    character(len=:), allocatable :: section_value, tmp_str
    integer :: i, ind
    error = OK
    section_value = this%section_Pairs%get_value(key, error, size(value))
    ! this error is not critical; it is OK for input file
    if(error .eq. KEY_NOT_FOUND) return
    if(error .ne. OK) call this%show_error(section_value)
    value = .false.
    if(present(def)) value = def
    tmp_str = trim(section_value)
    do i = 1, size(value)
      ind = INDEX(tmp_str,comma)
      if(ind .eq. 0) then
        ind = len(tmp_str) + 1
      end if
      select case(tmp_str(:ind - 1))
        case ("")
          value(i) = .false.
          if(present(def)) value(i) = def
        case (".T.", ".TRUE.")
          value(i) = .true.
        case (".F.", ".FALSE.")
          value(i) = .false.
        case default
          error = TYPE_ERROR
          section_value = "The key '"//trim(key)//"' value can not be converted to logical array"
          call this%show_error(section_value)
          return
      end select
      tmp_str = tmp_str(ind+1:)
    end do
  end subroutine get_logical_array
  !*MODULE mod_nameio DECK get_integer_array
  !> @brief  This subroutine is masked by get_value. It is needed for integer array converting
