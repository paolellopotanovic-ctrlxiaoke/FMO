
      SUBROUTINE RIMP2_X_FORM_I32_X102 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCS,CCD
      use shellpairs,only: sd_PAV_PRE, &
                           sd_P_PRE,   &
                           sd_DUM0_PRE,&
                           sd_DUM_PRE, &
                           sd_AB_PRE,  &
                           sd_VAL_PRE, &
                           LOCsd,   &
                           N_sd_PRE

      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(2),W(2)
      integer :: NROOTS
      
      ! OUTPUT
      double precision :: VALL

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3,0:1),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,2),B1(2),C1(2),           &
                          A2(3,2),B2(2),F00(2)

      double precision :: GGID(18)
      double precision :: DK(3)
      double precision :: G2ID(6)
      double precision :: G3ID(36)
      double precision :: DBID(6)                       

      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NGI, &
                 LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ, &
                 NGJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,NLJ


      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,iijj,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN

NJ = 6
LK=1
NK=3
NROOTS=2
NKS=3

!$omp parallel do default(none) &
!$omp shared(I_S_SHL,I_D_SHL,KNG,KLOC,KAUX_ELSE) &
!$omp shared(KAUXAT,C,KAUXNG,KAUXST,LOCSPH,DAUX,TOL,CCS) &
!$omp shared(CCD,EXAUX,N_ELSE,N_D_SHL,N_S_SHL,SD_AB_PRE) &
!$omp shared(SD_VAL_PRE,LOCKT_INIT,LOCSD,SD_DUM_PRE) &
!$omp shared(SD_P_PRE,SD_PAV_PRE,SD_DUM0_PRE,I32) &
!$omp shared(NJ,LK,NK,NROOTS,NKS) &
!$omp private(ISH,JSH,NGI,I1,LOCI,NGJ,J1,LOCJ,KAUXSH) &
!$omp private(KAT,CC,NGK,K1,IAUXSTART,DK,GGID,VALL,VAL1,VAL2) &
!$omp private(IJ,DBID,G3ID,G2ID,JLOC,NLJ,JBF,LIJ) &
!$omp private(VAL,AB,ABINV,DUM,CPV,PAV,RR,DUM0) &
!$omp private(DUM2,AK,RHO,XX,U,A1,A2,B1,C1,F00) &
!$omp private(IIJJ,JI,W,AIJINV,AIINV,AJINV) &
!$omp private(AIINV2,AIJINV2,AIJINVSQ,FACTOR)


DO III =1, N_S_SHL
   DO JJJ = 1,N_D_SHL
      ISH = I_S_SHL(III)
      JSH = I_D_SHL(JJJ)

      iijj = (III-1) * N_D_SHL + JJJ

      NGI   = KNG(ISH)
      LOCI  = KLOC(ISH)

      NGJ   = KNG(JSH)
      LOCJ  = KLOC(JSH)-5

      VAL(1:3) = sd_VAL_PRE(1:3,iijj)


! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)

         KAT = KAUXAT(KAUXSH)
         CC(1) = C(1,KAT)
         CC(2) = C(2,KAT)
         CC(3) = C(3,KAT)
         
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)

         ! AUX POINTER FOR I32
         IauxStart = LOCSPH(KAUXSH)
         IauxStart = IauxStart-LOCKT_init+1

         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH

          
               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K) = PI252 * DAux(KAUXSH,1,K)
               ENDDO

               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,NJ*NK
                  GGID(II)=zero
               ENDDO

               JI=0
               DO IG = 1, NGI
                  DO JG = 1, NGJ
                     JI=JI+1
                     AB = sd_AB_PRE(LOCsd(iijj)+JI)
                     DUM = sd_DUM_PRE(LOCsd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3) = sd_P_PRE(1:3,LOCsd(iijj)+JI)
                     PAV(1:3) = sd_PAV_PRE(1:3,LOCsd(iijj)+JI)
                     CPV(1:3) = CC(1:3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = sd_DUM0_PRE(LOCsd(iijj)+JI)

                     DUM2 = DUM0*CCS(IG,III)
                     DO J=1,NJ
                        DBID(J) = DUM2*CCD(J,JG,JJJ)
                     ENDDO                     


                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        CALL RT2_gpu(XX,U,W,NROOTS)

                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G3ID(3*IR) = F00(IR)
                        ENDDO

DO IR=1,2
   G3ID(10+IR*3) = A1(1,IR)
   G3ID(11+IR*3) = A1(2,IR)
   G3ID(12+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,2
   G3ID(22+IR*3) = A1(1,IR)*G3ID(10+IR*3) +  B1(IR)
   G3ID(23+IR*3) = A1(2,IR)*G3ID(11+IR*3) +  B1(IR)
   G3ID(24+IR*3) = A1(3,IR)*G3ID(12+IR*3) +  B1(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,2
   G3ID(16+IR*3) = A2(1,IR)
   G3ID(17+IR*3) = A2(2,IR)
   G3ID(18+IR*3) = A2(3,IR)*F00(IR)
ENDDO
DO IR=1,2
   G3ID(28+IR*3) = A1(1,IR)*G3ID(16+IR*3) +  C1(IR)
   G3ID(29+IR*3) = A1(2,IR)*G3ID(17+IR*3) +  C1(IR)
   G3ID(30+IR*3) = A1(3,IR)*G3ID(18+IR*3) +  C1(IR)*G3ID(0+IR*3)
ENDDO
DO IR=1,2
   G2ID(-2+IR*3) = A1(1,IR)*G3ID(28+IR*3) +  B1(IR)*G3ID(16+IR*3) +  C1(IR)*G3ID(10+IR*3)
   G2ID(-1+IR*3) = A1(2,IR)*G3ID(29+IR*3) +  B1(IR)*G3ID(17+IR*3) +  C1(IR)*G3ID(11+IR*3)
   G2ID(0+IR*3) = A1(3,IR)*G3ID(30+IR*3) +  B1(IR)*G3ID(18+IR*3) +  C1(IR)*G3ID(12+IR*3)
ENDDO
DO IR=1,2
   G3ID(4+IR*3) = VAL(1)           +  G3ID(10+IR*3)
   G3ID(5+IR*3) = VAL(2)           +  G3ID(11+IR*3)
   G3ID(6+IR*3) = VAL(3)*G3ID(0+IR*3) +  G3ID(12+IR*3)
ENDDO
DO IR=1,2
   G3ID(10+IR*3) = VAL(1)*G3ID(10+IR*3) +  G3ID(22+IR*3)
   G3ID(11+IR*3) = VAL(2)*G3ID(11+IR*3) +  G3ID(23+IR*3)
   G3ID(12+IR*3) = VAL(3)*G3ID(12+IR*3) +  G3ID(24+IR*3)
ENDDO
DO IR=1,2
   G3ID(10+IR*3) = VAL(1)*G3ID(4+IR*3) +  G3ID(10+IR*3)
   G3ID(11+IR*3) = VAL(2)*G3ID(5+IR*3) +  G3ID(11+IR*3)
   G3ID(12+IR*3) = VAL(3)*G3ID(6+IR*3) +  G3ID(12+IR*3)
ENDDO
DO IR=1,2
   G3ID(22+IR*3) = VAL(1)*G3ID(16+IR*3) +  G3ID(28+IR*3)
   G3ID(23+IR*3) = VAL(2)*G3ID(17+IR*3) +  G3ID(29+IR*3)
   G3ID(24+IR*3) = VAL(3)*G3ID(18+IR*3) +  G3ID(30+IR*3)
ENDDO
DO IR=1,2
   G3ID(28+IR*3) = VAL(1)*G3ID(28+IR*3) +  G2ID(-2+IR*3)
   G3ID(29+IR*3) = VAL(2)*G3ID(29+IR*3) +  G2ID(-1+IR*3)
   G3ID(30+IR*3) = VAL(3)*G3ID(30+IR*3) +  G2ID(0+IR*3)
ENDDO
DO IR=1,2
   G3ID(28+IR*3) = VAL(1)*G3ID(22+IR*3) +  G3ID(28+IR*3)
   G3ID(29+IR*3) = VAL(2)*G3ID(23+IR*3) +  G3ID(29+IR*3)
   G3ID(30+IR*3) = VAL(3)*G3ID(24+IR*3) +  G3ID(30+IR*3)
ENDDO

VALL = G3ID(31)*G3ID(3) + G3ID(34)*G3ID(6)
GGID(1) = GGID(1) + DBID(1)*DK(1)*VALL
VALL = G3ID(13)*G3ID(20)*G3ID(3) + G3ID(16)*G3ID(23)*G3ID(6)
GGID(2) = GGID(2) + DBID(1)*DK(2)*VALL
VALL = G3ID(13)*G3ID(21) + G3ID(16)*G3ID(24)
GGID(3) = GGID(3) + DBID(1)*DK(3)*VALL
VALL = G3ID(19)*G3ID(14)*G3ID(3) + G3ID(22)*G3ID(17)*G3ID(6)
GGID(4) = GGID(4) + DBID(2)*DK(1)*VALL
VALL = G3ID(32)*G3ID(3) + G3ID(35)*G3ID(6)
GGID(5) = GGID(5) + DBID(2)*DK(2)*VALL
VALL = G3ID(14)*G3ID(21) + G3ID(17)*G3ID(24)
GGID(6) = GGID(6) + DBID(2)*DK(3)*VALL
VALL = G3ID(19)*G3ID(15) + G3ID(22)*G3ID(18)
GGID(7) = GGID(7) + DBID(3)*DK(1)*VALL
VALL = G3ID(20)*G3ID(15) + G3ID(23)*G3ID(18)
GGID(8) = GGID(8) + DBID(3)*DK(2)*VALL
VALL = G3ID(33) + G3ID(36)
GGID(9) = GGID(9) + DBID(3)*DK(3)*VALL
VALL = G3ID(25)*G3ID(8)*G3ID(3) + G3ID(28)*G3ID(11)*G3ID(6)
GGID(10) = GGID(10) + DBID(4)*DK(1)*VALL
VALL = G3ID(7)*G3ID(26)*G3ID(3) + G3ID(10)*G3ID(29)*G3ID(6)
GGID(11) = GGID(11) + DBID(4)*DK(2)*VALL
VALL = G3ID(7)*G3ID(8)*G3ID(21) + G3ID(10)*G3ID(11)*G3ID(24)
GGID(12) = GGID(12) + DBID(4)*DK(3)*VALL
VALL = G3ID(25)*G3ID(9) + G3ID(28)*G3ID(12)
GGID(13) = GGID(13) + DBID(5)*DK(1)*VALL
VALL = G3ID(7)*G3ID(20)*G3ID(9) + G3ID(10)*G3ID(23)*G3ID(12)
GGID(14) = GGID(14) + DBID(5)*DK(2)*VALL
VALL = G3ID(7)*G3ID(27) + G3ID(10)*G3ID(30)
GGID(15) = GGID(15) + DBID(5)*DK(3)*VALL
VALL = G3ID(19)*G3ID(8)*G3ID(9) + G3ID(22)*G3ID(11)*G3ID(12)
GGID(16) = GGID(16) + DBID(6)*DK(1)*VALL
VALL = G3ID(26)*G3ID(9) + G3ID(29)*G3ID(12)
GGID(17) = GGID(17) + DBID(6)*DK(2)*VALL
VALL = G3ID(8)*G3ID(27) + G3ID(11)*G3ID(30)
GGID(18) = GGID(18) + DBID(6)*DK(3)*VALL



                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG

               ! ILOC=LOCI
               JLOC=LOCJ+4
           
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO JJ=1,NJ
                     JBF = JLOC+JJ
                     LIJ = LNKS+(JJ-1)*NKS
                     I32(LOCI,JBF,IauxStart+LNKS-1) = GGID(LIJ) 
                     I32(JBF,LOCI,IauxStart+LNKS-1) = GGID(LIJ) 
                  ENDDO
               ENDDO

           ENDDO !ISH
         ENDDO !JSH
      ENDDO !KSH
!$omp end parallel do

      END SUBROUTINE




      SUBROUTINE RIMP2_X_FORM_I32_X302 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL
      
      use shellProcessing,only: CCS,CCD
      use shellpairs,only: sd_PAV_PRE, &
                           sd_P_PRE,   &
                           sd_DUM0_PRE,&
                           sd_DUM_PRE, &
                           sd_AB_PRE,  &
                           sd_VAL_PRE, &
                           LOCsd,   &
                           N_sd_PRE

      implicit none

      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: XX,U(3),W(3)
      integer :: NROOTS
      
      ! OUTPUT
      double precision :: VALL

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          CAB(3),                  &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,3),B1(3),C1(3),           &
                          A2(3,3),B2(3),F00(3)

      double precision :: G2ID(1060)

      double precision :: GGID(60)
      double precision :: DK(10),T1(42)
      ! double precision :: G2ID(54)
      double precision :: G3ID(108)
      double precision :: DBID(6)                       


      double precision :: TMP(3),VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,IAT,NGI, &
                 LOCI,I1,ILOC,IG, &
                 JSH,JAT,NJ, &
                 NGJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,NLJ


      double precision :: AK,AI,AJ,AB,AIRAB,ABINV,EXPB,RR,RAB2,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL
      double precision :: a1114,a6114,a5214,a1314,a6314,a8314,a5414

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NIX,NJX,NKX,NIY,NJY,NKY,NIZ,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,iijj,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN


a1114 = TLL(1,1,14)
a6114 = TLL(6,1,14)
a5214 = TLL(5,2,14)
a1314 = TLL(1,3,14)
a6314 = TLL(6,3,14)
a8314 = TLL(8,3,14)
a5414 = TLL(5,4,14)

NJ = 6
LK=3
NK=10
NROOTS=3
NKS=7


!$omp parallel do default(none) &
!$omp shared(I_S_SHL,I_D_SHL,KNG,KSTART,KLOC,KAUX_ELSE) &
!$omp shared(KAUXAT,C,KAUXNG,KAUXST,LOCSPH,LOCKT_INIT) &
!$omp shared(DAUX,TOL,CCS,CCD,EXAUX,I32,N_ELSE,N_D_SHL) &
!$omp shared(N_S_SHL,SD_VAL_PRE,NK,NJ,LOCSD,SD_DUM_PRE,SD_AB_PRE) &
!$omp shared(SD_P_PRE,SD_PAV_PRE,SD_DUM0_PRE,NROOTS,NKS) &
!$omp shared(a1114,a6114,a5214,a1314,a6314,a8314,a5414) &
!$omp private(ISH,JSH,NGI,I1,LOCI,NGJ,J1,LOCJ,KAUXSH,KAT) &
!$omp private(CC,NGK,K1,IAUXSTART,DK,GGID,DBID,G3ID,G2ID) &
!$omp private(T1,NLJ,JBF,LIJ,VAL,VALL,VAL1,VAL2,AB,ABINV,DUM,CPV,PAV) &
!$omp private(RR,DUM0,DUM2,AK,RHO,XX,U,A1,A2,B1,B2,C1,F00) &
!$omp private(IIJJ,JI,AIJINV,AIINV,AJINV) &
!$omp private(AIINV2,AJINV2,AIJINV2,AIJINVSQ,W)


DO III =1, N_S_SHL
   DO JJJ = 1,N_D_SHL
      ISH = I_S_SHL(III)
      JSH = I_D_SHL(JJJ)

         iijj = (III-1) * N_D_SHL + JJJ

               NGI   = KNG(ISH)
               I1    = KSTART(ISH)
               LOCI  = KLOC(ISH)
   
               NGJ   = KNG(JSH)
               J1    = KSTART(JSH)
               LOCJ  = KLOC(JSH)-1
   
            VAL(1:3) = sd_VAL_PRE(1:3,iijj)

! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)

         KAT = KAUXAT(KAUXSH)
         CC(1) = C(1,KAT)
         CC(2) = C(2,KAT)
         CC(3) = C(3,KAT)
         
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)

         ! AUX POINTER FOR I32
         IauxStart = LOCSPH(KAUXSH)
         IauxStart = IauxStart-LOCKT_init+1

         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH

           
               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K) = PI252 * DAux(KAUXSH,1,K)
               ENDDO

               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,NJ*NK
                  GGID(II)=zero
               ENDDO

               JI=0
               DO IG = 1, NGI
                  DO JG = 1, NGJ
                     JI=JI+1
                     AB = sd_AB_PRE(LOCsd(iijj)+JI)
                     DUM = sd_DUM_PRE(LOCsd(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                     CPV(1:3) = sd_P_PRE(1:3,LOCsd(iijj)+JI)
                     PAV(1:3) = sd_PAV_PRE(1:3,LOCsd(iijj)+JI)
                     CPV(1:3) = CC(1:3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                     DUM0 = sd_DUM0_PRE(LOCsd(iijj)+JI)
                     DUM2 = DUM0*CCS(IG,III)
                     DO J=1,NJ
                        DBID(J) = DUM2*CCD(J,JG,JJJ)
                     ENDDO                     

                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        XX = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        CALL RT3_gpu(XX,U,W,NROOTS)

                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AJINV2 = half*AJINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           B2(IR) = AJINV2-AJINV2*VAL2
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G3ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO
DO IR=1,3
   G3ID(16+IR*3) = A1(1,IR)
   G3ID(17+IR*3) = A1(2,IR)
   G3ID(18+IR*3) = A1(3,IR)*F00(IR)
ENDDO
DO IR=1,3
   G3ID(34+IR*3) = A1(1,IR)*G3ID(16+IR*3) +  B1(IR)
   G3ID(35+IR*3) = A1(2,IR)*G3ID(17+IR*3) +  B1(IR)
   G3ID(36+IR*3) = A1(3,IR)*G3ID(18+IR*3) +  B1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
   G3ID(25+IR*3) = A2(1,IR)
   G3ID(26+IR*3) = A2(2,IR)
   G3ID(27+IR*3) = A2(3,IR)*F00(IR)
ENDDO
DO IR=1,3
   G3ID(43+IR*3) = A1(1,IR)*G3ID(25+IR*3) +  C1(IR)
   G3ID(44+IR*3) = A1(2,IR)*G3ID(26+IR*3) +  C1(IR)
   G3ID(45+IR*3) = A1(3,IR)*G3ID(27+IR*3) +  C1(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
   G3ID(61+IR*3) = A1(1,IR)*G3ID(43+IR*3) +  B1(IR)*G3ID(25+IR*3) +  C1(IR)*G3ID(16+IR*3)
   G3ID(62+IR*3) = A1(2,IR)*G3ID(44+IR*3) +  B1(IR)*G3ID(26+IR*3) +  C1(IR)*G3ID(17+IR*3)
   G3ID(63+IR*3) = A1(3,IR)*G3ID(45+IR*3) +  B1(IR)*G3ID(27+IR*3) +  C1(IR)*G3ID(18+IR*3)
ENDDO
DO IR=1,3
   G3ID(52+IR*3) = A2(1,IR)*G3ID(25+IR*3) +  B2(IR)
   G3ID(53+IR*3) = A2(2,IR)*G3ID(26+IR*3) +  B2(IR)
   G3ID(54+IR*3) = A2(3,IR)*G3ID(27+IR*3) +  B2(IR)*G3ID(IR*3)
ENDDO
DO IR=1,3
   G3ID(70+IR*3) = A1(1,IR)*G3ID(52+IR*3) +  2*C1(IR)*G3ID(25+IR*3)
   G3ID(71+IR*3) = A1(2,IR)*G3ID(53+IR*3) +  2*C1(IR)*G3ID(26+IR*3)
   G3ID(72+IR*3) = A1(3,IR)*G3ID(54+IR*3) +  2*C1(IR)*G3ID(27+IR*3)
ENDDO
DO IR=1,3
   G3ID(88+IR*3) = A1(1,IR)*G3ID(70+IR*3) +  B1(IR)*G3ID(52+IR*3) +  2*C1(IR)*G3ID(43+IR*3)
   G3ID(89+IR*3) = A1(2,IR)*G3ID(71+IR*3) +  B1(IR)*G3ID(53+IR*3) +  2*C1(IR)*G3ID(44+IR*3)
   G3ID(90+IR*3) = A1(3,IR)*G3ID(72+IR*3) +  B1(IR)*G3ID(54+IR*3) +  2*C1(IR)*G3ID(45+IR*3)
ENDDO
DO IR=1,3
   G3ID(79+IR*3) = A2(1,IR)*G3ID(52+IR*3) +  2*B2(IR)*G3ID(25+IR*3)
   G3ID(80+IR*3) = A2(2,IR)*G3ID(53+IR*3) +  2*B2(IR)*G3ID(26+IR*3)
   G3ID(81+IR*3) = A2(3,IR)*G3ID(54+IR*3) +  2*B2(IR)*G3ID(27+IR*3)
ENDDO
DO IR=1,3
   G3ID(97+IR*3) = A1(1,IR)*G3ID(79+IR*3) +  3*C1(IR)*G3ID(52+IR*3)
   G3ID(98+IR*3) = A1(2,IR)*G3ID(80+IR*3) +  3*C1(IR)*G3ID(53+IR*3)
   G3ID(99+IR*3) = A1(3,IR)*G3ID(81+IR*3) +  3*C1(IR)*G3ID(54+IR*3)
ENDDO
DO IR=1,3
   G2ID(-2+IR*3) = A1(1,IR)*G3ID(97+IR*3) +  B1(IR)*G3ID(79+IR*3) +  3*C1(IR)*G3ID(70+IR*3)
   G2ID(-1+IR*3) = A1(2,IR)*G3ID(98+IR*3) +  B1(IR)*G3ID(80+IR*3) +  3*C1(IR)*G3ID(71+IR*3)
   G2ID(IR*3) = A1(3,IR)*G3ID(99+IR*3) +  B1(IR)*G3ID(81+IR*3) +  3*C1(IR)*G3ID(72+IR*3)
ENDDO
DO IR=1,3
   G3ID(7+IR*3) = VAL(1)  +  G3ID(16+IR*3)
