      !*** cusolverDnDpotrf ***!
      integer(c_int) function cusolverDnDpotrf &
         (cusolver_Hndl,uplo,n,d_A,lda,d_WS,Lwork,INFO) &
         bind(C, name="cusolverDnDpotrf")
         use iso_c_binding
         implicit none
         type(c_ptr),value::cusolver_Hndl
         integer(c_int), value::uplo
