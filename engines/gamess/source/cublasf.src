      !                  int ldb,
      !                  int *devInfo );

      integer(c_int) function cusolverDnDpotrf_bufferSize &
                             (cusolver_Hndl,uplo,n,d_A,lda,Lwork) &
                             bind(C,name="cusolverDnDpotrf_bufferSize") 
         ! use iso_c_binding
         use, intrinsic :: iso_c_binding
