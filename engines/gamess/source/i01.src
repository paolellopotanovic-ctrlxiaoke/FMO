GGID(20) = GGID(20) + DBID(2)*DK(10)*VALL
VALL = G3ID(82)*G3ID(12) + G3ID(85)*G3ID(15) + G3ID(88)*G3ID(18)
GGID(21) = GGID(21) + DBID(3)*DK(1)*VALL
VALL = G3ID(83)*G3ID(12) + G3ID(86)*G3ID(15) + G3ID(89)*G3ID(18)
GGID(22) = GGID(22) + DBID(3)*DK(2)*VALL
VALL = G3ID(93) + G3ID(96) + G3ID(99)
GGID(23) = GGID(23) + DBID(3)*DK(3)*VALL
VALL = G3ID(55)*G3ID(29)*G3ID(12) + G3ID(58)*G3ID(32)*G3ID(15) + G3ID(61)*G3ID(35)*G3ID(18)
GGID(24) = GGID(24) + DBID(3)*DK(4)*VALL
VALL = G3ID(55)*G3ID(39) + G3ID(58)*G3ID(42) + G3ID(61)*G3ID(45)
GGID(25) = GGID(25) + DBID(3)*DK(5)*VALL
VALL = G3ID(28)*G3ID(56)*G3ID(12) + G3ID(31)*G3ID(59)*G3ID(15) + G3ID(34)*G3ID(62)*G3ID(18)
GGID(26) = GGID(26) + DBID(3)*DK(6)*VALL
VALL = G3ID(56)*G3ID(39) + G3ID(59)*G3ID(42) + G3ID(62)*G3ID(45)
GGID(27) = GGID(27) + DBID(3)*DK(7)*VALL
VALL = G3ID(28)*G3ID(66) + G3ID(31)*G3ID(69) + G3ID(34)*G3ID(72)
GGID(28) = GGID(28) + DBID(3)*DK(8)*VALL
VALL = G3ID(29)*G3ID(66) + G3ID(32)*G3ID(69) + G3ID(35)*G3ID(72)
GGID(29) = GGID(29) + DBID(3)*DK(9)*VALL
VALL = G3ID(28)*G3ID(29)*G3ID(39) + G3ID(31)*G3ID(32)*G3ID(42) + G3ID(34)*G3ID(35)*G3ID(45)
GGID(30) = GGID(30) + DBID(3)*DK(10)*VALL
ENDIF


                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG


               JLOC=LOCJ+MINJ-1

               ! TRANSFORM TO SPHERICAL
T1(1) = a1114*GGID(1) + a6114*GGID(6)
T1(2) = a5214*GGID(5) - a5214*GGID(7)
T1(3) = a1314*GGID(1) + a6314*GGID(6) + a8314*GGID(8)
T1(4) = GGID(3) + a5414*GGID(5) + a5414*GGID(7)
T1(5) = a1314*GGID(2) + a6314*GGID(4) + a8314*GGID(9)
T1(6) = GGID(10)
T1(7) = a4714*GGID(4) - a1114*GGID(2)

T1(8) = a1114*GGID(11) + a6114*GGID(16)
T1(9) = a5214*GGID(15) - a5214*GGID(17)
T1(10) = a1314*GGID(11) + a6314*GGID(16) + a8314*GGID(18)
T1(11) = GGID(13) + a5414*GGID(15) +  a5414*GGID(17)
T1(12) = a1314*GGID(12) + a6314*GGID(14) + a8314*GGID(19)
T1(13) = GGID(20)
T1(14) = a4714*GGID(14) - a1114*GGID(12)

T1(15) = a1114*GGID(21) + a6114*GGID(26)
T1(16) = a5214*GGID(25) - a5214*GGID(27)
T1(17) = a1314*GGID(21) +  a6314*GGID(26) + a8314*GGID(28)
T1(18) = GGID(23) +  a5414*GGID(25) + a5414*GGID(27)
T1(19) = a1314*GGID(22) +  a6314*GGID(24) + a8314*GGID(29)
T1(20) = GGID(30)
T1(21) = a4714*GGID(24) - a1114*GGID(22)

if(isL) THEN
T1(22) = a1114*GGID(31) + a6114*GGID(36)
T1(23) = a5214*GGID(35) - a5214*GGID(37)
T1(24) = a1314*GGID(31) + a6314*GGID(36) + a8314*GGID(38)
T1(25) = GGID(33) + a5414*GGID(35) + a5414*GGID(37)
T1(26) = a1314*GGID(32) + a6314*GGID(34) + a8314*GGID(39)
T1(27) = GGID(40)
T1(28) = a4714*GGID(34) - a1114*GGID(32)
ENDIF

            
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO JJ=1,NJ
                     JBF = JLOC+JJ
                     LIJ = LNKS+(JJ-1)*NKS
                     I32(LOCI,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                     I32(JBF,LOCI,IauxStart+LNKS-1) = T1(LIJ) 
                  ENDDO
               ENDDO

           ENDDO !ISH
         ENDDO !JSH
      ENDDO !KSH
!$omp end parallel do

      END SUBROUTINE


      SUBROUTINE RIMP2_X_FORM_I32_X01 &
                (I32,TOL,LOCKT_init, &
                 NSHELL,MXEX,EX,KATOM,KTYPE,KMIN,KMAX, &
                 KNG,KSTART,KLOC,C,NBASIS,NddiChunk,MXBSH, &
                 NAUXSH,MXEXAUX,EXAUX,KAUXAT,KAUXTY, &
                 KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO, &
                 LddiAuxShStart,LddiAuxShEnd,ISIZE, &
                 KAUX_ELSE,N_ELSE)


      use omp_lib

      use gpuGlobalRimp2Eng,only: zero,half,one

      use gpuGlobalRimp2Eng,only: PI252,RLN10, &
                                  MXLTOT,ITOLRI, &
                                  LX,LY,LZ, &
                                  DAux, &
                                  MXATM, &
                                  MIXS,LOCSPH, &
                                  TLL

      use shellProcessing,only: I_S_SHL,I_P_SHL,I_D_SHL, &
                                N_S_SHL,N_P_SHL,N_D_SHL

      use shellProcessing,only: CCS,CCP
      use shellpairs,only: sp_PAV_PRE, &
                           sp_P_PRE,   &
                           sp_DUM0_PRE,&
                           sp_DUM_PRE, &
                           sp_AB_PRE,  &
                           sp_VAL_PRE, &
                           LOCsp,   &
                           N_sp_PRE


      implicit none
      ! 
      integer,intent(in) :: KMIN(NSHELL),KMAX(NSHELL),KNG(NSHELL),KSTART(NSHELL),&
                            KLOC(NSHELL),KATOM(NSHELL),KTYPE(NSHELL)
      integer,intent(in) :: KAUXST(NAUXSH),KAUXAT(NAUXSH),KAUXTY(NAUXSH),KAUXNG(NAUXSH), &
                            KAUXLO(NAUXSH),KAUXMI(NAUXSH),KAUXMX(NAUXSH),NAUXSH
      integer,intent(in) :: NSHELL,NBASIS,MXEX,MXEXAUX,NddiChunk,MXBSH
      integer,intent(in) :: N_ELSE,KAUX_ELSE(N_ELSE)
      integer,intent(in) :: LddiAuxShStart,LddiAuxShEnd
      ! 
      ! COMMON /ROOTgpu  /
      double precision :: X,U(13),W(13)
      integer :: NROOTS
      
      ! OUTPUT
      double precision,allocatable :: DK(:)
      double precision :: VALL

      ! BUFFER
      double precision :: CC(3), EX(MXEX),EXAUX(MXEXAUX), &
                          P(3),PAV(3),CPV(3),               &
                          A1(3,13),B1(13),C1(13),           &
                          A2(3,13),B2(13),F00(13)

      double precision :: GGID(100)
      double precision :: G2ID(728)
      double precision :: G3ID(2688)
      ! double precision :: DBID(784)
      double precision :: DBID(4)
      double precision :: T1(100)

      integer :: LLJ(3,28),LLK(3,28)

      double precision :: VAL(3)

      double precision :: I32(NBASIS,NBASIS,NddiChunk)

      double precision :: C(3,MXATM)

      logical :: FlgSphAux

      integer :: KAUXSH,KAT,LK,NK,NGK,MINK,MAXK, &
                 LOCK,MINKT,MAXKT,LOCKT,K1,NKS, &
                 LOCKT_init,IauxStart

      integer :: ISH,NGI, &
                 LOCI,I1,ILOC,IG, &
                 JSH,NJ,MINJ, &
                 NGJ,LJ,LOCJ,J1,JLOC,JG

      integer :: LTOT,NLJ


      double precision :: AK,AB,AIRAB,EXPB,RR,RHO
      double precision :: DUM,DUM0,DUM2
      double precision :: U2,T2
      double precision :: VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2
      double precision :: AJINV2,AIJINV2,AIJINVSQ,AIINV2,AIJINV,AIINV,AJINV
      double precision :: FACTOR,TOL

      integer :: I,J,K,JNJ,II,LL,IJ,KJ,LIJ,KG,LNKS,KK,JJ
      integer :: NJX,NKX,NJY,NKY,NJZ,NKZ
      integer :: I3,N3,N3I,N3B,N3IJ,IA
      integer :: IDX,IDZ,IDY
      integer :: IBF,JBF,III,JJJ,iijj,JI
      integer :: I_ELSE,INDEX,ISIZE,IR,IJK,KNK,INI

         

         ! ~~~ Start ~~~



      IF(N_ELSE.EQ.0) RETURN

      ALLOCATE(DK(28*ISIZE))

!$omp parallel do collapse(2) default(none) &
!$omp shared(N_S_SHL,N_P_SHL,I_S_SHL,I_P_SHL) &
!$omp shared(EXAUX,KAUXAT,KAUXTY,KAUXMI,KAUXMX,KAUXNG,KAUXST,KAUXLO)    &
!$omp shared(EX,KATOM,C,KTYPE,KMIN,KNG,KSTART,KLOC,NSHELL)         &
!$omp shared(MIXS,TLL,DAux,LOCSPH,TOL)     &
!$omp shared(LX,LY,LZ,LddiAuxShStart,LddiAuxShEnd,lockt_init)           &
!$omp shared(KAUX_ELSE,N_ELSE) &
!$omp shared(CCS,CCP) &
!$omp shared(I32) &
!$omp shared(sp_PAV_PRE,sp_P_PRE,sp_DUM0_PRE,sp_DUM_PRE) &
!$omp shared(sp_AB_PRE,sp_VAL_PRE,LOCsp,N_sp_PRE) &
!$omp private(VALL,G2ID,G3ID,GGID,DBID) &
!$omp private(CC,KAUXSH,KAT,LK,NK,NGK,MINK,MAXK,K1,LOCK,             &
!$omp         ISH,NGI,I1,LOCI,                   &
!$omp         JSH,MINJ,NJ,NGJ,J1,LOCJ,                   &
!$omp         NKS,MINKT,MAXKT,LOCKT,                  &
!$omp         DK,T1,IauxStart,INDEX, &
!$omp        ILOC,JLOC,NLJ,LNKS,IBF,JBF,LIJ,KJ,IJ) &
!$omp private(LTOT) & 
!$omp private(VAL,IG,AIRAB) &
!$omp private(JG,AB,P,PAV,CPV,RR,DUM,DUM0,DUM2) &
!$omp private(X,U,W,NROOTS,AK,RHO,A1,B1,C1,A2,B2,F00) &
!$omp private(LL,II,KG,I,J,K,JI,iijj) &
!$omp private(U2,T2,VAL1,VAL2,ABKINV,ABKINV2,ABKINVSQ,AKINV,AKINV2,ABINV2) &
!$omp private(LLJ,LLK) &
!$omp private(KNK,INI,JNJ) &
!$omp private(ajinv2,aijinv2,aijinvsq,aiinv2,aijinv,aiinv,ajinv) &
!$omp private(NJX,NKX,NJY,NKY,NJZ,NKZ) &
!$omp private(I3,N3,N3I,N3B,N3IJ,IDX,IDZ,IDY,IJK,FACTOR) 



         ! DO ISH = 1,NSHELL
         !    DO JSH = 1,ISH

DO III =1, N_S_SHL
   DO JJJ = 1,N_P_SHL
      ISH = I_S_SHL(III)
      JSH = I_P_SHL(JJJ)

            iijj = (III-1)*N_P_SHL + JJJ

               NGI   = KNG(ISH)
               I1    = KSTART(ISH)
               LOCI  = KLOC(ISH)-1
   

               MINJ  = KMIN(JSH)
               NJ    = 5 - MINJ
               NGJ   = KNG(JSH)
               J1    = KSTART(JSH)
               LOCJ  = KLOC(JSH)-MINJ
   
               DO J=MINJ,4
                  JNJ=J-MINJ+1
                  LLJ(1,JNJ) = LX(J)
                  LLJ(2,JNJ) = LY(J)
                  LLJ(3,JNJ) = LZ(J)
               ENDDO
   
            VAL(1:3) = sp_VAL_PRE(1:3,iijj)


! K-SHELL (AUX)
! DO KAUXSH=1,NAUXSH
      ! DO KAUXSH=LddiAuxShStart,LddiAuxShEnd
      DO I_ELSE=1,N_ELSE
         ! DO ISH = 1,NSHELL
         KAUXSH = KAUX_ELSE(I_ELSE)


         KAT = KAUXAT(KAUXSH)
         CC(1) = C(1,KAT)
         CC(2) = C(2,KAT)
         CC(3) = C(3,KAT)
         LK = KAUXTY(KAUXSH)-1

         MINK  = KAUXMI(KAUXSH)
         MAXK  = KAUXMX(KAUXSH)
         NK    = MAXK-MINK+1
         NGK   = KAUXNG(KAUXSH)
         K1    = KAUXST(KAUXSH)
         LOCK  = KAUXLO(KAUXSH)-MINK
         INDEX = MINK+LK

         DO K=MINK,MAXK
            KNK=K-MINK+1
            LLK(1,KNK) = LX(K)
            LLK(2,KNK) = LY(K)
            LLK(3,KNK) = LZ(K)
         ENDDO

         ! SPHERICAL TRANSFORMATION
         MINKT = MIXS(1,INDEX)
         MAXKT = MIXS(2,INDEX)
         NKS = MAXKT - MINKT + 1
         
         ! AUX POINTER FOR I32
         IauxStart = LOCSPH(KAUXSH)
         IauxStart = IauxStart-LOCKT_init+1

               ! DENSITY FACTOR
               DO K=1,NK
                  DK(K)=DAux(KAUXSH,1,K)
               ENDDO

               ! TOTAL ANG MOM & ROOTS
               LTOT = 1+LK
               NROOTS = LTOT/2+1

               ! ZERO OUT INTEGRAL ARRAY
               DO II=1,NJ*NK
                  GGID(II)=zero
               ENDDO
            JI = 0
               ! PRIMITIVE IN I-SHELL
               DO IG = 1, NGI
                  ! PRIMITIVE IN J-SHELL
                  DO JG = 1, NGJ
               JI = JI + 1
                  AB = sp_AB_PRE(LOCsp(iijj)+JI)
                  DUM = sp_DUM_PRE(LOCsp(iijj)+JI)
                     IF (DUM > TOL) CYCLE
                  CPV(1:3) = sp_P_PRE(1:3,LOCsp(iijj)+JI)
                  PAV(1:3) = sp_PAV_PRE(1:3,LOCsp(iijj)+JI)
                     CPV(1:3) = CC(1:3)-CPV(1:3)
                     RR = CPV(1)*CPV(1) + CPV(2)*CPV(2) + CPV(3)*CPV(3)
                  DUM0 = sp_DUM0_PRE(LOCsp(iijj)+JI)


                     DUM2 = DUM0*CCS(IG,III)
                     DO J=1,NJ
                        DBID(J) = DUM2*CCP(J,JG,JJJ)
                     ENDDO


                     ! PRIMITIVE IN K-SHELL
                     DO KG = 1, NGK
                        AK = EXAUX(K1+KG-1)
                        RHO = AB*AK/(AB+AK)
                        X = RHO*RR

                        ! RYS ROOTS AND WEIGHT
                        IF(NROOTS.EQ.1) THEN
                           CALL RT1_gpu(X,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.2) THEN
                           CALL RT2_gpu(X,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.3) THEN
                           CALL RT3_gpu(X,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.4) THEN
                           CALL ROOT4_gpu(X,U,W,NROOTS)
                        ELSEIF(NROOTS.EQ.5) THEN
                           CALL ROOT5_gpu(X,U,W,NROOTS)                     
                        ELSEIF(NROOTS.GE.6) THEN
                           CALL ROOT6_gpu(X,U,W,NROOTS)                     
                        ENDIF
! I32_AO_BOYS_gpu
                        AIJINV = one/(AB+AK)
                        RHO = AB*AK*AIJINV
                        AIINV  = one/AB
                        AJINV  = one/AK
                        AIINV2 = half*AIINV
                        AJINV2 = half*AJINV
                        AIJINV2 = half*AIJINV
                        AIJINVSQ = SQRT(AIJINV)

                        DO IR = 1, NROOTS
                           U(IR) = U(IR)*RHO
                           U(IR) = U(IR)/(RHO+U(IR))
                           VAL1 = RHO*AIINV*U(IR)
                           VAL2 = RHO*AJINV*U(IR)
                           A1(1:3,IR) = PAV(1:3)+VAL1*CPV(1:3)
                           A2(1:3,IR) = -VAL2*CPV(1:3)
                           B1(IR) = AIINV2-AIINV2*VAL1
                           B2(IR) = AJINV2-AJINV2*VAL2
                           C1(IR) = AIJINV2*U(IR)
                           F00(IR) = AIJINVSQ*W(IR)
                           G2ID(1 + 3*(IR-1)) = one
                           G2ID(2 + 3*(IR-1)) = one
                           G2ID(3 + 3*(IR-1)) = F00(IR)
                        ENDDO

! I32_AO_R1_gpu
                        DO IR = 1, NROOTS
                           G2ID(1+(IR-1)*3+3*NROOTS) = A1(1,IR)
                           G2ID(2+(IR-1)*3+3*NROOTS) = A1(2,IR)
                           G2ID(3+(IR-1)*3+3*NROOTS) = A1(3,IR)*F00(IR)            
                        ENDDO
! I32_AO_TRIPLET_gpu
                        IF (LK.EQ.0) GOTO 333
                        !!!!!!!!!!!!!!!!!!!!!
                        N3=3*NROOTS
                        N3B=9*NROOTS

                        DO IR = 1, NROOTS
                           G2ID(1+3*(IR-1)+N3B) = A2(1,IR)
                           G2ID(2+3*(IR-1)+N3B) = A2(2,IR)
                           G2ID(3+3*(IR-1)+N3B) = A2(3,IR)*F00(IR)
                        END DO

                        DO IR=1,NROOTS
                           DO K=1,3
                              G2ID(K+3*(IR-1)+N3+N3B) = &
                                       A1(K,IR)*G2ID(K+3*(IR-1)+N3B) &
                                       + C1(IR)*G2ID(K+3*(IR-1))
                           ENDDO
                        ENDDO


                        IF(LK.EQ.1) GOTO 333
                        !!!!!!!!!!!!!!!!!!!!

                        DO J=2,LK
                           DO IR=1,NROOTS
                              DO K=1,3
                                 G2ID(K+3*(IR-1)+N3B*J) = &
                                          A2(K,IR)*G2ID(K+3*(IR-1)+N3B*(J-1)) &
                                    + (J-1)*B2(IR)*G2ID(K+3*(IR-1)+N3B*(J-2))
                                 G2ID(K+3*(IR-1)+N3+N3B*J) = &
                                          A1(K,IR)*G2ID(K+3*(IR-1)+N3B*J) &
                                        + J*C1(IR)*G2ID(K+3*(IR-1)+N3B*(J-1))
                              ENDDO
                           ENDDO
                        ENDDO

  333 CONTINUE
! I32_AO_PRODXYZ_gpu
                        N3=3*NROOTS
                        N3I=3*NROOTS
                        N3B=9*NROOTS
                        N3IJ=9*NROOTS
                        
                        DO KK = 0, LK
                           DO IR=1,NROOTS
                              DO IA=1,3
                                 G3ID(IA+3*(IR-1)+N3IJ*KK) = G2ID(IA+3*(IR-1)+N3B*KK)
                              ENDDO
                           ENDDO

                           DO IR=1,NROOTS
                              DO IA=1,3
                                 G2ID(IA+3*(IR-1)+N3B*KK) = &
                                            VAL(IA)*G2ID(IA+3*(IR-1)+N3B*KK) &
                                                  + G2ID(IA+3*(IR-1)+N3+N3B*KK)
                              ENDDO
                           ENDDO
                        ENDDO !KK


                        DO KK=0,LK
                           DO IR=1,NROOTS
                              DO IA=1,3
                                 G3ID(IA+3*(IR-1)+N3I+N3IJ*KK) = G2ID(IA+3*(IR-1)+N3B*KK)
                              ENDDO
                           ENDDO
                        ENDDO

                        IJ = 0
                        IJK = 0
                        DO J = 1, NJ
                           NJX = LLJ(1,J)
                           NJY = LLJ(2,J)
                           NJZ = LLJ(3,J)
                           IJ = IJ+1

                           FACTOR=PI252*DBID(IJ)

                           DO K = 1, NK
                              NKX = LLK(1,K)
                              NKY = LLK(2,K)
                              NKZ = LLK(3,K)
                              VALL = zero
                              DO IR = 1, NROOTS
                                 I3=3*(IR-1)
                                 IDX = I3 + N3I*NJX + N3IJ*NKX
                                 IDY = I3 + N3I*NJY + N3IJ*NKY
                                 IDZ = I3 + N3I*NJZ + N3IJ*NKZ
                                 VALL = VALL + G3ID(1+IDX)*G3ID(2+IDY)*G3ID(3+IDZ)
                              ENDDO
                              IJK = IJK+1
                              GGID(IJK) = GGID(IJK) + FACTOR*DK(K)*VALL
                           ENDDO

                        ENDDO


                     ENDDO !KG
                  ENDDO !JG
               ENDDO !IG


               ILOC=LOCI
               JLOC=LOCJ+MINJ-1

               ! TRANSFORM TO SPHERICAL
               DO J = 1,NJ
                  DO I=1,NKS               
                     IJ = (J-1)*NKS + I              
                     T1(IJ) = zero
                     DO K=1,NK
                        KJ = (J-1)*NK + K
                        T1(IJ) = T1(IJ) + TLL(K,I,INDEX)*GGID(KJ)
                     ENDDO
                  ENDDO
               ENDDO
            
               ! COPY INTEGRAL GG(P|MN) TO I32
               NLJ = NKS*NJ
               DO LNKS=1,NKS
                  DO JJ=1,NJ
                     IBF = ILOC+1
                     JBF = JLOC+JJ
                     LIJ = LNKS+(JJ-1)*NKS
                     I32(IBF,JBF,IauxStart+LNKS-1) = T1(LIJ) 
                     I32(JBF,IBF,IauxStart+LNKS-1) = T1(LIJ) 
                  ENDDO
               ENDDO

           ENDDO !ISH
         ENDDO !JSH
      ENDDO !KSH
!$omp end parallel do

      DEALLOCATE(DK)

      END SUBROUTINE




