    call add_free_functional(MGGA_X_group,MGGA_X_TM_name,XC_MGGA_X_TM,.true.)
    call add_free_functional(MGGA_X_group,MGGA_X_TPSS_name,XC_MGGA_X_TPSS,.true.)
    call add_free_functional(MGGA_X_group,MGGA_X_VT84_name,XC_MGGA_X_VT84,.true.)
    if(allocated(GGA_C_group)) then
      call GGA_C_group%destroy
      deallocate(GGA_C_group)
    end if
    if(allocated(GGA_X_group)) then
      call GGA_X_group%destroy
      deallocate(GGA_X_group)
    end if
    if(allocated(GGA_XC_group)) then
      call GGA_XC_group%destroy
      deallocate(GGA_XC_group)
    end if
    if(allocated(HGGA_X_group)) then
      call HGGA_X_group%destroy
      deallocate(HGGA_X_group)
    end if
    if(allocated(HGGA_XC_group)) then
      call HGGA_XC_group%destroy
      deallocate(HGGA_XC_group)
    end if
    if(allocated(HLDA_XC_group)) then
      call HLDA_XC_group%destroy
      deallocate(HLDA_XC_group)
    end if
    if(allocated(HMGGA_X_group)) then
      call HMGGA_X_group%destroy
      deallocate(HMGGA_X_group)
    end if
    if(allocated(HMGGA_XC_group)) then
      call HMGGA_XC_group%destroy
      deallocate(HMGGA_XC_group)
    end if
    if(allocated(LDA_C_group)) then
      call LDA_C_group%destroy
      deallocate(LDA_C_group)
    end if
    if(allocated(LDA_X_group)) then
      call LDA_X_group%destroy
      deallocate(LDA_X_group)
    end if
    if(allocated(LDA_XC_group)) then
      call LDA_XC_group%destroy
      deallocate(LDA_XC_group)
    end if
    if(allocated(MGGA_C_group)) then
      call MGGA_C_group%destroy
      deallocate(MGGA_C_group)
    end if
    if(allocated(MGGA_X_group)) then
      call MGGA_X_group%destroy
      deallocate(MGGA_X_group)
    end if
    if(allocated(MGGA_XC_group)) then
      call MGGA_XC_group%destroy
      deallocate(MGGA_XC_group)
    end if
  end subroutine libxc_choose_functionals
end module libxc
