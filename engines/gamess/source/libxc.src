        dhfunc     = .true.
        HFEX       = 0.5_fp
        MP2        = 0.128_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                XC_MGGA_X_SCAN,1.00_fp-HFEX)
        call functional_%add_functional(                XC_MGGA_C_SCAN,1.00_fp-MP2)
      case("PBE-QIDH")
        dhfunc     = .true.
        HFEX       = 0.693391_fp
        MP2        = 0.128_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                  XC_GGA_X_PBE,1.00_fp-HFEX)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp-MP2)
      case("TPSS-QIDH")
        needtau = .true.
        dhfunc     = .true.
        HFEX       = 0.693391_fp
        MP2        = 0.128_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                XC_MGGA_X_TPSS,1.00_fp-HFEX)
        call functional_%add_functional(                XC_MGGA_C_TPSS,1.00_fp-MP2)
      case("SCAN-QIDH")
        needtau = .true.
        dhfunc     = .true.
        HFEX       = 0.693391_fp
        MP2        = 0.128_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                XC_MGGA_X_SCAN,1.00_fp-HFEX)
        call functional_%add_functional(                XC_MGGA_C_SCAN,1.00_fp-MP2)
      case("PBE0-2")
        dhfunc     = .true.
        HFEX       = 0.793701_fp
        MP2        = 0.5_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                  XC_GGA_X_PBE,1.00_fp-HFEX)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp-MP2)
      case("TPSS0-2")
        needtau = .true.
        dhfunc     = .true.
        HFEX       = 0.793701_fp
        MP2        = 0.5_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                XC_MGGA_X_TPSS,1.00_fp-HFEX)
        call functional_%add_functional(                XC_MGGA_C_TPSS,1.00_fp-MP2)
      case("SCAN0-2")
        needtau = .true.
        dhfunc     = .true.
        HFEX       = 0.793701_fp
        MP2        = 0.5_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                XC_MGGA_X_SCAN,1.00_fp-HFEX)
        call functional_%add_functional(                XC_MGGA_C_SCAN,1.00_fp-MP2)
      case("B2-PLYP", "B2PLYP")
        dhfunc     = .true.
        HFEX       = 0.53_fp
        MP2        = 0.27_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                  XC_GGA_X_B88,1.00_fp-HFEX) !Becke88
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp-MP2) !Lee-Yang-Parr
      case("B2GP-PLYP", "B2GPPLYP")
        dhfunc     = .true.
        HFEX       = 0.65_fp
        MP2        = 0.36_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                  XC_GGA_X_B88,1.00_fp-HFEX) !Becke88
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp-MP2) !Lee-Yang-Parr
      case("B2T-PLYP", "B2TPLYP")
        dhfunc     = .true.
        HFEX       = 0.60_fp
        MP2        = 0.31_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                  XC_GGA_X_B88,1.00_fp-HFEX) !Becke88
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp-MP2) !Lee-Yang-Parr
      case("B2K-PLYP", "B2KPLYP")
        dhfunc     = .true.
        HFEX       = 0.42_fp
        MP2        = 0.72_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                  XC_GGA_X_B88,1.00_fp-HFEX) !Becke88
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp-MP2) !Lee-Yang-Parr
      case("MPW2-PLYP", "MPW2PLYP")
        dhfunc     = .true.
        HFEX       = 0.53_fp
        MP2        = 0.27_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                XC_GGA_X_MPW91,1.00_fp-HFEX) !mPW91
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp-MP2) !Lee-Yang-Parr
      case("MPWK-PLYP", "MPWKPLYP")
        dhfunc     = .true.
        HFEX       = 0.42_fp
        MP2        = 0.72_fp
        chf        = HFEX
        cmp2       = MP2
        c2same     = MP2
        c2opp      = MP2
        call functional_%add_functional(                XC_GGA_X_MPW91,1.00_fp-HFEX) !mPW91
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp-MP2) !Lee-Yang-Parr
      case default
        !It will be good, if someone write procedure for parsing of functional names, like PBE-1-PBE or PBE-0 or S+PBE-3-LYP+VWN-RPA
        call show_message("Unrecognized functional name: " // funcname)
        call show_message("Please, check the documentation about this functional or")
        call show_message(" implement it to LibXC [https://gitlab.com/libxc/libxc],")
        call show_message("   and, then, to GAMESS-LibXC interface")
        call show_message(ABORTING, WITH_ABORT)
    end select
    ! No one of functionals was not selected
    if(.not.functional_%can_calculate()) then
      call show_message("No one functional was not selected!")
      call show_message("Please, check the input!")
      call show_message(ABORTING, WITH_ABORT)
    end if
    chf = HFEX
    cmp2 = MP2
#ifndef OQP
    DFTTYP(3)  = HFEX
    DFTTYP(14) = MP2
#endif
    ! Print information about non-local part of functionals
    call show_message(" ")
    if(.not.camflag) then
      call show_message("(A,ES16.8E2)", "The global hybrid part:                ", HFEX)
    else
      call show_message("CAM-corrected functional is called")
      call show_message("Yanai's notation of CAM parameters is used")
      call show_message("(A,ES16.8E2)", "The global hybrid part:                ", alpha)
      call show_message("(A,ES16.8E2)", "Additional long-range hybrid part:     ", beta)
      call show_message("(A,ES16.8E2)", "Range-saparated factor:                ", mu)
    end if
    if(dhfunc) then
      call show_message(" ")
      call show_message("Double-hybrid functional is called")
      call show_message("(A,ES16.8E2)", "Same-spin MP2 correlation factor:      ", c2same)
      call show_message("(A,ES16.8E2)", "Opposite-spin MP2 correlation factor:  ", c2opp)
    end if
    call show_message(" ")
    ! deallocate reader of section
    if(.not.present(functional)) then
      if(allocated(LibXC_group)) then
        call LibXC_group%destroy
        deallocate(LibXC_group)
      end if
    end if
  end subroutine libxc_input
  !
  !*MODULE libxc DECK libxc_input
  !> @brief  Destroy internal variables of functional
  !> @author Igor S. Gerasimov
  !> @date   Dec, 2020 - Initial release -
  subroutine libxc_destroy()
    call functional_%destroy
  end subroutine libxc_destroy
  !
  !*MODULE libxc DECK libxc_calc
  !> @brief  Performing DFT calculations using libxc at one point
  !>         (Analog of CALCEXC)
  !> @author Igor S. Gerasimov
  !> @date   July, 2019
  !> @params WEIGHT - (in)  weight of point (FTOTWT)
  !> @params RHOA   - (in)  alpha-density at point
  !> @params RHOB   - (in)  beta-density at point
  !> @params GRD_A  - (in)  gradients of electron density for Alpha spin
  !> @params GRD_B  - (in)  gradients of electron density for Beta spin
  !> @params TAU_A  - (in)  local kinetic energies of electron density for Alpha spin
  !> @params TAU_B  - (in)  local kinetic energies of electron density for Beta spin
  !> @params XALPHA - (out) LDA exchange energy (full energy)
  !> @params XGRD   - (out) GGA exchange energy (always is zero)
  !> @params ECF    - (out) correlation energy  (always is zero)
  !> @params VXCA   - (out) gradient of energy by alpha-density
  !> @params VXCB   - (out) gradient of energy by beta-density
  !> @params DUM_A  - (out) gradient of energy by normed gradient of electron density for Alpha spin
  !> @params DUM_B  - (out) gradient of energy by normed gradient of electron density for Beta spin
  !> @params DMGGA  - (out) gradient of energy by local kinetic energies for Alpha spin
  !> @params DMGGB  - (out) gradient of energy by local kinetic energies for Beta spin
  subroutine libxc_calc(WEIGHT,       &
                RHOA, RHOB,           &
                GRDAA, GRDAB, GRDBB,  &
                GRADXA,GRADYA,GRADZA, &
                GRADXB,GRADYB,GRADZB, &
                TAUXA,TAUYA,TAUZA,    &
                TAUXB,TAUYB,TAUZB,    &
                XALPHA,XGRD,ECF,      &
                VXCA,VXCB,            &
                DUMAX,DUMAY,DUMAZ,    &
                DUMBX,DUMBY,DUMBZ,    &
                DMGGA, DMGGB)
    use metagga, only: needtau
    real(kind=fp), intent(in)  :: WEIGHT
    real(kind=fp), intent(in)  :: RHOA, RHOB
    real(kind=fp), intent(in)  :: GRDAA, GRDAB, GRDBB
    real(kind=fp), intent(in)  :: GRADXA,GRADYA,GRADZA,GRADXB,GRADYB,GRADZB
    real(kind=fp), intent(in)  :: TAUXA,TAUYA,TAUZA,TAUXB,TAUYB,TAUZB
    real(kind=fp), intent(out) :: XALPHA,XGRD,ECF
    real(kind=fp), intent(out) :: VXCA,VXCB
    real(kind=fp), intent(out) :: DUMAX,DUMAY,DUMAZ,DUMBX,DUMBY,DUMBZ
    real(kind=fp), intent(out) :: DMGGA, DMGGB
    !internal variables
    real(kind=fp), dimension(1) :: energy
    real(kind=fp), dimension(2) :: rho, tau, dEdrho, dEdtau, lapl, dEdlapl
    real(kind=fp), dimension(3) :: sigma, dEdsigma
    ! Create arrays for LibXC
    rho(1)   = rhoa
    rho(2)   = rhob
    sigma(1) = grdaa
    sigma(2) = grdab
    sigma(3) = grdbb
    ! In the case, if needtau == .false., tauxa+tauya+tauza = 0
    if(needtau) then
      tau(1)   = abs(0.5_fp*(tauxa+tauya+tauza))
      tau(2)   = abs(0.5_fp*(tauxb+tauyb+tauzb))
    else
      tau = 0.0_fp
    end if
    ! GAMESS-US can not calculate laplacian, set array to zero
    lapl     = 0.0_fp
    ! calculate DFT functional
    call functional_%calc_evxc(1, rho, sigma, tau, lapl, energy, &
      dEdrho, dEdsigma, dEdtau, dEdlapl)
    ! Myltiply energy to weight for numerical integration
    energy = energy * weight

    ECF    = 0.0_fp
    XGRD   = 0.0_fp
    ! Total energy of LibXC functionals
    XALPHA = energy(1)
    ! Alpha density
    VXCA   = dEdrho(1)
    DUMAX  = 2.0_fp*(dEdsigma(1)*GRADXA)+(dEdsigma(2)*GRADXB)
    DUMAY  = 2.0_fp*(dEdsigma(1)*GRADYA)+(dEdsigma(2)*GRADYB)
    DUMAZ  = 2.0_fp*(dEdsigma(1)*GRADZA)+(dEdsigma(2)*GRADZB)
    ! Beta density
    VXCB   = dEdrho(2)
    DUMBX  = 2.0_fp*(dEdsigma(3)*GRADXB)+(dEdsigma(2)*GRADXA)
    DUMBY  = 2.0_fp*(dEdsigma(3)*GRADYB)+(dEdsigma(2)*GRADYA)
    DUMBZ  = 2.0_fp*(dEdsigma(3)*GRADZB)+(dEdsigma(2)*GRADZA)
    ! Derivatives of energy by local kinetic densities
    dmgga  = dEdtau(1) / 2.0_fp
    dmggb  = dEdtau(2) / 2.0_fp
  end subroutine libxc_calc
  !
  !*MODULE libxc DECK libxc_calc_2D
  !> @brief  Perform TD-DFT calculations using libxc (without 3rd derivatives)
  !>         (Analog of any TDFUNC subroutine)
  !> @detail All points produce one call of LibXC interface
  !> @author Igor S. Gerasimov
  !> @date   Sep, 2019
  !> @params WaveType    - (in)  Type of wavefunction: restricted (1) or unrestricted (2). integer value
  !> @params NGridPoints - (in)  count of grid points (also maxgrd)
  !> @params NPoints     - (in)  count of points
  !> @params DerivLength - (in)  Size of array of derivatives energy by rho/grad/tau
  !> @params EXC         - (out) total energy
  !> @params EnergyPoint - (out) energies at each point
  !> @params DerivsPoint - (out) derivatives energy at each point
  !> @params dRho        - (in)  rho and gradients rho at each point
  !> @params dTau        - (in)  tau of rho at each point
  !> @params weight      - (in)  weight of point at each point
  !> @params MinRho      - (in)  except point where rho less that MinRho
  !> @params StartPoint  - (in)  The first point, which needed to work (Needed for parallel runs, I think)
  !> @params EndPoint    - (in)  The last point, which needed to work (Needed for parallel runs, I think)
  subroutine libxc_TD_2D(WaveType, NGridPoints, NPoints, DerivLength, EXC, EnergyPoint, DerivsPoint, &
                        dRho, dTau, weight, MinRho, StartPoint, EndPoint)
    USE cderix, ONLY: IRA,IRB,IGA,IGB,IGC,ITA,ITB,IRARA,IRARB,         &
                      IRAGA,IRAGB,IRAGC,IRATA,IRATB,IRBRB,IRBGA,IRBGB, &
                      IRBGC,IRBTA,IRBTB,IGAGA,IGAGB,IGAGC,IGATA,IGATB, &
                      IGBGB,IGBGC,IGBTA,IGBTB,IGCGC,IGCTA,IGCTB,ITATA, &
                      ITATB,ITBTB
    use metagga, only: needtau
    integer,       intent(in)  :: WaveType
    integer,       intent(in)  :: NGridPoints
    integer,       intent(in)  :: NPoints
    integer,       intent(in)  :: DerivLength
    real(kind=fp), intent(out) :: EXC
    real(kind=fp), dimension(NPoints),                intent(out) :: EnergyPoint
    real(kind=fp), dimension(NPoints,DerivLength),    intent(out) :: DerivsPoint
    real(kind=fp), dimension(NGridPoints,4,WaveType), intent(in)  :: dRho
    real(kind=fp), dimension(NGridPoints,WaveType),   intent(in)  :: dTau
    real(kind=fp), dimension(NGridPoints),            intent(in)  :: weight
    real(kind=fp), intent(in)  :: MinRho
    integer,       intent(in)  :: StartPoint
    integer,       intent(in)  :: EndPoint
    ! internal variables
    real(kind=fp)                       :: dxa, dya, dza, dxb, dyb, dzb
    real(kind=fp), dimension(:), allocatable :: energy
    real(kind=fp), dimension(:), allocatable :: rho, tau, lapl, dEdrho, dEdtau, dEdlapl
    real(kind=fp), dimension(:), allocatable :: sigma, dEdsigma, d2Edrho2, d2Edtau2, d2Edlapl2
    real(kind=fp), dimension(:), allocatable :: d2Edrhotau, d2Edrholapl, d2Edlapltau
    real(kind=fp), dimension(:), allocatable :: d2Edsigma2, d2Edrhosigma, d2Edsigmatau, d2Edsigmalapl
    ! iterators
    integer :: GridPoint, i, j, distance
    ! Setting outputting variables to zero
    EXC = 0
    EnergyPoint = 0
    DerivsPoint = 0

    ! Writing arrays for LibXC
    distance = EndPoint - StartPoint + 1
    associate(D => distance)
      allocate(energy(D))
      allocate(rho(2*D), tau(2*D), lapl(2*D), dEdrho(2*D), dEdtau(2*D), dEdlapl(2*D))
      allocate(sigma(3*D), dEdsigma(3*D), d2Edrho2(3*D), d2Edtau2(3*D), d2Edlapl2(3*D))
      allocate(d2Edrhotau(4*D), d2Edrholapl(4*D), d2Edlapltau(4*D))
      allocate(d2Edsigma2(6*D), d2Edrhosigma(6*D), d2Edsigmatau(6*D), d2Edsigmalapl(6*D))
    end associate
    do GridPoint = StartPoint, EndPoint
      i = GridPoint - StartPoint + 1
      j = GridPoint - StartPoint
      ! getting of rho
      rho(j * 2 + 1)   = dRho(GridPoint,1,1)
      rho(j * 2 + 2)   = dRho(GridPoint,1,WaveType)
      ! I hope that points with very low value of total density will be excluded in libxc
      dxa              = dRho(GridPoint,2,1)
      dya              = dRho(GridPoint,3,1)
      dza              = dRho(GridPoint,4,1)
      dxb              = dRho(GridPoint,2,WaveType)
      dyb              = dRho(GridPoint,3,WaveType)
      dzb              = dRho(GridPoint,4,WaveType)
      ! Calculate normed gradients
      sigma(j * 3 + 1) = dxa*dxa + dya*dya + dza*dza
      sigma(j * 3 + 2) = dxa*dxb + dya*dyb + dza*dzb
      sigma(j * 3 + 3) = dxb*dxb + dyb*dyb + dzb*dzb
      ! Getting of tau
      if(needtau) then
        tau(j * 2 + 1)   = abs(dTau(GridPoint,1))
        tau(j * 2 + 2)   = abs(dTau(GridPoint,WaveType))
      end if
    end do
    if(.not.needtau) then
      tau = 0.0_fp
    end if
    ! GAMESS-US can not calculate laplacian, set array to zero
    lapl     = 0.0_fp
    ! calculate DFT functional in all points
    call functional_%calc_evfxc(distance, rho, sigma, tau, lapl, energy, dEdrho, dEdsigma, dEdtau, dEdlapl, &
      d2Edrho2, d2Edsigma2, d2Edtau2, d2Edlapl2, &
      d2Edrhosigma, d2Edrhotau, d2Edrholapl, d2Edsigmatau, d2Edsigmalapl, d2Edlapltau)

    ! Getting values of energy and it derivatives from LibXC arrays
    do GridPoint = StartPoint, EndPoint
      i = GridPoint - StartPoint + 1
      j = GridPoint - StartPoint
      !Skipping regions with low rho, gradient and tau
      if(rho(j * 2 + 1) + rho(j * 2 + 2) .lt. MinRho) cycle
!
!     STORE TOTAL ENERGY
!
      EXC = EXC + energy(i) * weight(i)
!
!     STORE FUNCTIONAL ENERGY
!
      EnergyPoint(i) = EnergyPoint(i) + energy(i)
!
!     STORE FIRST FUNCTIONAL DERIVATIVE
!
      DerivsPoint (i,IRA)   = DerivsPoint (i,IRA)   + dEdrho(j * 2 + 1)
      DerivsPoint (i,IRB)   = DerivsPoint (i,IRB)   + dEdrho(j * 2 + 2)
      DerivsPoint (i,IGA)   = DerivsPoint (i,IGA)   + dEdsigma(j * 3 + 1)
      DerivsPoint (i,IGB)   = DerivsPoint (i,IGB)   + dEdsigma(j * 3 + 3)
      DerivsPoint (i,IGC)   = DerivsPoint (i,IGC)   + dEdsigma(j * 3 + 2)
      DerivsPoint (i,ITA)   = DerivsPoint (i,ITA)   + dEdtau(j * 2 + 1)
      DerivsPoint (i,ITB)   = DerivsPoint (i,ITB)   + dEdtau(j * 2 + 2)
!
!     STORE SECOND FUNCTIONAL DERIVATIVE
!
      DerivsPoint (i,IRARA) = DerivsPoint (i,IRARA) + d2Edrho2(j * 3 + 1)
      DerivsPoint (i,IRARB) = DerivsPoint (i,IRARB) + d2Edrho2(j * 3 + 2)
      DerivsPoint (i,IRAGA) = DerivsPoint (i,IRAGA) + d2Edrhosigma(j * 6 + 1)
      DerivsPoint (i,IRAGB) = DerivsPoint (i,IRAGB) + d2Edrhosigma(j * 6 + 3)
      DerivsPoint (i,IRAGC) = DerivsPoint (i,IRAGC) + d2Edrhosigma(j * 6 + 2)
      DerivsPoint (i,IRATA) = DerivsPoint (i,IRATA) + d2Edrhotau(j * 4 + 1)
      DerivsPoint (i,IRATB) = DerivsPoint (i,IRATB) + d2Edrhotau(j * 4 + 2)
      DerivsPoint (i,IRBRB) = DerivsPoint (i,IRBRB) + d2Edrho2(j * 3 + 3)
      DerivsPoint (i,IRBGA) = DerivsPoint (i,IRBGA) + d2Edrhosigma(j * 6 + 4)
      DerivsPoint (i,IRBGB) = DerivsPoint (i,IRBGB) + d2Edrhosigma(j * 6 + 6)
      DerivsPoint (i,IRBGC) = DerivsPoint (i,IRBGC) + d2Edrhosigma(j * 6 + 5)
      DerivsPoint (i,IRBTA) = DerivsPoint (i,IRBTA) + d2Edrhotau(j * 4 + 3)
      DerivsPoint (i,IRBTB) = DerivsPoint (i,IRBTB) + d2Edrhotau(j * 4 + 4)
      DerivsPoint (i,IGAGA) = DerivsPoint (i,IGAGA) + d2Edsigma2(j * 6 + 1)
      DerivsPoint (i,IGAGB) = DerivsPoint (i,IGAGB) + d2Edsigma2(j * 6 + 3)
      DerivsPoint (i,IGAGC) = DerivsPoint (i,IGAGC) + d2Edsigma2(j * 6 + 2)
      DerivsPoint (i,IGATA) = DerivsPoint (i,IGATA) + d2Edsigmatau(j * 6 + 1)
      DerivsPoint (i,IGATB) = DerivsPoint (i,IGATB) + d2Edsigmatau(j * 6 + 2)
      DerivsPoint (i,IGBGB) = DerivsPoint (i,IGBGB) + d2Edsigma2(j * 6 + 6)
      DerivsPoint (i,IGBGC) = DerivsPoint (i,IGBGC) + d2Edsigma2(j * 6 + 5)
      DerivsPoint (i,IGBTA) = DerivsPoint (i,IGBTA) + d2Edsigmatau(j * 6 + 5)
      DerivsPoint (i,IGBTB) = DerivsPoint (i,IGBTB) + d2Edsigmatau(j * 6 + 6)
      DerivsPoint (i,IGCGC) = DerivsPoint (i,IGCGC) + d2Edsigma2(j * 6 + 4)
      DerivsPoint (i,IGCTA) = DerivsPoint (i,IGCTA) + d2Edsigmatau(j * 6 + 3)
      DerivsPoint (i,IGCTB) = DerivsPoint (i,IGCTB) + d2Edsigmatau(j * 6 + 4)
      DerivsPoint (i,ITATA) = DerivsPoint (i,ITATA) + d2Edtau2(j * 3 + 1)
      DerivsPoint (i,ITATB) = DerivsPoint (i,ITATB) + d2Edtau2(j * 3 + 2)
      DerivsPoint (i,ITBTB) = DerivsPoint (i,ITBTB) + d2Edtau2(j * 3 + 3)
    end do
    deallocate(rho, sigma, tau, lapl, energy, dEdrho, dEdsigma, dEdtau, dEdlapl, &
      d2Edrho2, d2Edsigma2, d2Edtau2, d2Edlapl2, &
      d2Edrhosigma, d2Edrhotau, d2Edrholapl, d2Edsigmatau, d2Edsigmalapl, d2Edlapltau)
  end subroutine libxc_TD_2D
  !
  !*MODULE libxc DECK libxc_TD_3D
  !> @brief  Perform TD-DFT calculations using libxc
  !>         (Analog of any TDFUNC subroutine)
  !> @detail All points produce one call of LibXC interface
  !>         For determining a shifting like (j * 3 + 3) see libxc/scripts/maple2c_new.pl @derivatives.
  !> @author Igor S. Gerasimov
  !> @date   Sep, 2019
  !> @params WaveType    - (in)  Type of wavefunction: restricted (1) or unrestricted (2). integer value
  !> @params NGridPoints - (in)  count of grid points (also maxgrd)
  !> @params NPoints     - (in)  count of points
  !> @params DerivLength - (in)  Size of array of derivatives energy by rho/grad/tau
  !> @params EXC         - (out) total energy
  !> @params EnergyPoint - (out) energies at each point
  !> @params DerivsPoint - (out) derivatives energy at each point
  !> @params dRho        - (in)  rho and gradients rho at each point
  !> @params dTau        - (in)  tau of rho at each point
  !> @params weight      - (in)  weight of point at each point
  !> @params MinRho      - (in)  except point where rho less that MinRho
  !> @params StartPoint  - (in)  The first point, which needed to work (Needed for parallel runs, I think)
  !> @params EndPoint    - (in)  The last point, which needed to work (Needed for parallel runs, I think)
  subroutine libxc_TD_3D(WaveType, NGridPoints, NPoints, DerivLength, EXC, EnergyPoint, DerivsPoint, &
                         dRho, dTau, weight, MinRho, StartPoint, EndPoint)
    USE cderix, ONLY: IRA,IRB,IGA,IGB,IGC,ITA,ITB,IRARA,IRARB,         &
                      IRAGA,IRAGB,IRAGC,IRATA,IRATB,IRBRB,IRBGA,IRBGB, &
                      IRBGC,IRBTA,IRBTB,IGAGA,IGAGB,IGAGC,IGATA,IGATB, &
                      IGBGB,IGBGC,IGBTA,IGBTB,IGCGC,IGCTA,IGCTB,ITATA, &
                      ITATB,ITBTB,IRARARA,IRARARB,IRARAGA,IRARAGB,     &
                      IRARAGC,IRARATA,IRARATB,IRARBRB,IRARBGA,IRARBGB, &
                      IRARBGC,IRARBTA,IRARBTB,IRAGAGA,IRAGAGB,IRAGAGC, &
                      IRAGATA,IRAGATB,IRAGBGB,IRAGBGC,IRAGBTA,IRAGBTB, &
                      IRAGCGC,IRAGCTA,IRAGCTB,IRATATA,IRATATB,IRATBTB, &
                      IRBRBRB,IRBRBGA,IRBRBGB,IRBRBGC,IRBRBTA,IRBRBTB, &
                      IRBGAGA,IRBGAGB,IRBGAGC,IRBGATA,IRBGATB,IRBGBGB, &
                      IRBGBGC,IRBGBTA,IRBGBTB,IRBGCGC,IRBGCTA,IRBGCTB, &
                      IRBTATA,IRBTATB,IRBTBTB,IGAGAGA,IGAGAGB,IGAGAGC, &
                      IGAGATA,IGAGATB,IGAGBGB,IGAGBGC,IGAGBTA,IGAGBTB, &
                      IGAGCGC,IGAGCTA,IGAGCTB,IGATATA,IGATATB,IGATBTB, &
                      IGBGBGB,IGBGBGC,IGBGBTA,IGBGBTB,IGBGCGC,IGBGCTA, &
                      IGBGCTB,IGBTATA,IGBTATB,IGBTBTB,IGCGCGC,IGCGCTA, &
                      IGCGCTB,IGCTATA,IGCTATB,IGCTBTB,ITATATA,ITATATB, &
                      ITATBTB,ITBTBTB
    use metagga, only: needtau
    integer,       intent(in)  :: WaveType
    integer,       intent(in)  :: NGridPoints
    integer,       intent(in)  :: NPoints
    integer,       intent(in)  :: DerivLength
    real(kind=fp), intent(out) :: EXC
    real(kind=fp), dimension(NPoints),                intent(out) :: EnergyPoint
    real(kind=fp), dimension(NPoints,DerivLength),    intent(out) :: DerivsPoint
    real(kind=fp), dimension(NGridPoints,4,WaveType), intent(in)  :: dRho
    real(kind=fp), dimension(NGridPoints,WaveType),   intent(in)  :: dTau
    real(kind=fp), dimension(NGridPoints),            intent(in)  :: weight
    real(kind=fp), intent(in)  :: MinRho
    integer,       intent(in)  :: StartPoint
    integer,       intent(in)  :: EndPoint
    ! internal variables
    real(kind=fp) :: dxa, dya, dza, dxb, dyb, dzb
    real(kind=fp), dimension(:), allocatable :: energy
    real(kind=fp), dimension(:), allocatable :: rho, tau, lapl, dEdrho, dEdtau, dEdlapl
    real(kind=fp), dimension(:), allocatable :: sigma, dEdsigma, d2Edrho2, d2Edtau2, d2Edlapl2
    real(kind=fp), dimension(:), allocatable :: d2Edrhotau, d2Edrholapl, d2Edlapltau
    real(kind=fp), dimension(:), allocatable :: d2Edsigma2, d2Edrhosigma, d2Edsigmatau, d2Edsigmalapl
    ! for third derivatives
    real(kind=fp), dimension(:), allocatable :: d3Edrho3, d3Edtau3, d3Edlapl3
    real(kind=fp), dimension(:), allocatable :: d3Edrho2tau, d3Edrhotau2, d3Edrho2lapl, d3Edrholapl2, d3Edlapl2tau, d3Edlapltau2
    real(kind=fp), dimension(:), allocatable :: d3Edrholapltau
    real(kind=fp), dimension(:), allocatable :: d3Edrho2sigma, d3Edsigmatau2, d3Edsigmalapl2
    real(kind=fp), dimension(:), allocatable :: d3Edsigma3
    real(kind=fp), dimension(:), allocatable :: d3Edrhosigma2, d3Edrhosigmatau, d3Edsigma2tau, d3Edrhosigmalapl, &
                                                d3Edsigma2lapl, d3Edsigmalapltau
    ! iterators
    integer :: GridPoint, i, j, distance
    ! Setting outputting variables to zero
    EXC = 0
    EnergyPoint = 0
    DerivsPoint = 0
    ! Writing arrays for LibXC
    distance = EndPoint - StartPoint + 1
    associate(D => distance)
      allocate(energy(D))
      allocate(rho(2*D), tau(2*D), lapl(2*D), dEdrho(2*D), dEdtau(2*D), dEdlapl(2*D))
      allocate(sigma(3*D), dEdsigma(3*D), d2Edrho2(3*D), d2Edtau2(3*D), d2Edlapl2(3*D))
      allocate(d2Edrhotau(4*D), d2Edrholapl(4*D), d2Edlapltau(4*D))
      allocate(d2Edsigma2(6*D), d2Edrhosigma(6*D), d2Edsigmatau(6*D), d2Edsigmalapl(6*D))
      allocate(d3Edrho3(4*D), d3Edtau3(4*D), d3Edlapl3(4*D))
      allocate(d3Edrho2tau(6*D), d3Edrhotau2(6*D), d3Edrho2lapl(6*D), d3Edrholapl2(6*D), d3Edlapl2tau(6*D), d3Edlapltau2(6*D))
      allocate(d3Edrholapltau(8*D))
      allocate(d3Edrho2sigma(9*D), d3Edsigmatau2(9*D), d3Edsigmalapl2(9*D))
      allocate(d3Edsigma3(10*D))
      allocate(d3Edrhosigma2(12*D), d3Edrhosigmatau(12*D), d3Edsigma2tau(12*D), d3Edrhosigmalapl(12*D))
      allocate(d3Edsigma2lapl(12*D), d3Edsigmalapltau(12*D))
    end associate
    do GridPoint = StartPoint, EndPoint
      i = GridPoint - StartPoint + 1
      j = GridPoint - StartPoint
      ! getting of rho
      rho(j * 2 + 1)   = dRho(GridPoint,1,1)
      rho(j * 2 + 2)   = dRho(GridPoint,1,WaveType)
      ! I hope that points with very low value of total density will be excluded in libxc
      dxa              = dRho(GridPoint,2,1)
      dya              = dRho(GridPoint,3,1)
      dza              = dRho(GridPoint,4,1)
      dxb              = dRho(GridPoint,2,WaveType)
      dyb              = dRho(GridPoint,3,WaveType)
      dzb              = dRho(GridPoint,4,WaveType)
      ! Calculate normed gradients
      sigma(j * 3 + 1) = dxa*dxa + dya*dya + dza*dza
      sigma(j * 3 + 2) = dxa*dxb + dya*dyb + dza*dzb
      sigma(j * 3 + 3) = dxb*dxb + dyb*dyb + dzb*dzb
      ! Getting of tau
      if(needtau) then
        tau(j * 2 + 1)   = abs(dTau(GridPoint,1))
        tau(j * 2 + 2)   = abs(dTau(GridPoint,WaveType))
      end if
    end do
    if(.not.needtau) then
      tau = 0.0_fp
    end if
    ! GAMESS-US can not calculate laplacian, set array to zero
    lapl     = 0.0_fp
    ! calculate DFT functional in all points
    call functional_%calc_xc(distance, rho, sigma, tau, lapl, energy, dEdrho, dEdsigma, dEdlapl, dEdtau, &
      d2Edrho2, d2Edrhosigma, d2Edrholapl, d2Edrhotau,                                           &
      d2Edsigma2, d2Edsigmalapl, d2Edsigmatau, d2Edlapl2, d2Edlapltau, d2Edtau2,                 &
      d3Edrho3, d3Edrho2sigma, d3Edrho2lapl, d3Edrho2tau, d3Edrhosigma2, d3Edrhosigmalapl,       &
      d3Edrhosigmatau, d3Edrholapl2, d3Edrholapltau, d3Edrhotau2, d3Edsigma3, d3Edsigma2lapl,    &
      d3Edsigma2tau, d3Edsigmalapl2, d3Edsigmalapltau, d3Edsigmatau2, d3Edlapl3, d3Edlapl2tau,   &
      d3Edlapltau2, d3Edtau3)

    ! Getting values of energy and it derivatives from LibXC arrays
    do GridPoint = StartPoint, EndPoint
      i = GridPoint - StartPoint + 1
      j = GridPoint - StartPoint
      !Skipping regions with low rho, gradient and tau
      if(rho(j * 2 + 1) + rho(j * 2 + 2) .lt. MinRho) cycle
!
!     STORE TOTAL ENERGY
!
      EXC = EXC + energy(i) * weight(i)
!
!     STORE FUNCTIONAL ENERGY
!
      EnergyPoint(i) = EnergyPoint(i) + energy(i)
!
!     STORE FIRST FUNCTIONAL DERIVATIVE
!
      DerivsPoint (i,IRA)   = DerivsPoint (i,IRA)   + dEdrho(j * 2 + 1)
      DerivsPoint (i,IRB)   = DerivsPoint (i,IRB)   + dEdrho(j * 2 + 2)
      DerivsPoint (i,IGA)   = DerivsPoint (i,IGA)   + dEdsigma(j * 3 + 1)
      DerivsPoint (i,IGB)   = DerivsPoint (i,IGB)   + dEdsigma(j * 3 + 3)
      DerivsPoint (i,IGC)   = DerivsPoint (i,IGC)   + dEdsigma(j * 3 + 2)
      DerivsPoint (i,ITA)   = DerivsPoint (i,ITA)   + dEdtau(j * 2 + 1)
      DerivsPoint (i,ITB)   = DerivsPoint (i,ITB)   + dEdtau(j * 2 + 2)
!
!     STORE SECOND FUNCTIONAL DERIVATIVE
!
      DerivsPoint (i,IRARA) = DerivsPoint (i,IRARA) + d2Edrho2(j * 3 + 1)
      DerivsPoint (i,IRARB) = DerivsPoint (i,IRARB) + d2Edrho2(j * 3 + 2)
      DerivsPoint (i,IRAGA) = DerivsPoint (i,IRAGA) + d2Edrhosigma(j * 6 + 1)
      DerivsPoint (i,IRAGB) = DerivsPoint (i,IRAGB) + d2Edrhosigma(j * 6 + 3)
      DerivsPoint (i,IRAGC) = DerivsPoint (i,IRAGC) + d2Edrhosigma(j * 6 + 2)
      DerivsPoint (i,IRATA) = DerivsPoint (i,IRATA) + d2Edrhotau(j * 4 + 1)
      DerivsPoint (i,IRATB) = DerivsPoint (i,IRATB) + d2Edrhotau(j * 4 + 2)
      DerivsPoint (i,IRBRB) = DerivsPoint (i,IRBRB) + d2Edrho2(j * 3 + 3)
      DerivsPoint (i,IRBGA) = DerivsPoint (i,IRBGA) + d2Edrhosigma(j * 6 + 4)
      DerivsPoint (i,IRBGB) = DerivsPoint (i,IRBGB) + d2Edrhosigma(j * 6 + 6)
      DerivsPoint (i,IRBGC) = DerivsPoint (i,IRBGC) + d2Edrhosigma(j * 6 + 5)
      DerivsPoint (i,IRBTA) = DerivsPoint (i,IRBTA) + d2Edrhotau(j * 4 + 3)
      DerivsPoint (i,IRBTB) = DerivsPoint (i,IRBTB) + d2Edrhotau(j * 4 + 4)
      DerivsPoint (i,IGAGA) = DerivsPoint (i,IGAGA) + d2Edsigma2(j * 6 + 1)
      DerivsPoint (i,IGAGB) = DerivsPoint (i,IGAGB) + d2Edsigma2(j * 6 + 3)
      DerivsPoint (i,IGAGC) = DerivsPoint (i,IGAGC) + d2Edsigma2(j * 6 + 2)
      DerivsPoint (i,IGATA) = DerivsPoint (i,IGATA) + d2Edsigmatau(j * 6 + 1)
      DerivsPoint (i,IGATB) = DerivsPoint (i,IGATB) + d2Edsigmatau(j * 6 + 2)
      DerivsPoint (i,IGBGB) = DerivsPoint (i,IGBGB) + d2Edsigma2(j * 6 + 6)
      DerivsPoint (i,IGBGC) = DerivsPoint (i,IGBGC) + d2Edsigma2(j * 6 + 5)
      DerivsPoint (i,IGBTA) = DerivsPoint (i,IGBTA) + d2Edsigmatau(j * 6 + 5)
      DerivsPoint (i,IGBTB) = DerivsPoint (i,IGBTB) + d2Edsigmatau(j * 6 + 6)
      DerivsPoint (i,IGCGC) = DerivsPoint (i,IGCGC) + d2Edsigma2(j * 6 + 4)
      DerivsPoint (i,IGCTA) = DerivsPoint (i,IGCTA) + d2Edsigmatau(j * 6 + 3)
      DerivsPoint (i,IGCTB) = DerivsPoint (i,IGCTB) + d2Edsigmatau(j * 6 + 4)
      DerivsPoint (i,ITATA) = DerivsPoint (i,ITATA) + d2Edtau2(j * 3 + 1)
      DerivsPoint (i,ITATB) = DerivsPoint (i,ITATB) + d2Edtau2(j * 3 + 2)
      DerivsPoint (i,ITBTB) = DerivsPoint (i,ITBTB) + d2Edtau2(j * 3 + 3)
!
!     STORE THIRD FUNCTIONAL DERIVATIVE
!
      DerivsPoint (i,IRARARA) = DerivsPoint (i,IRARARA) + d3Edrho3(j * 4 + 1)
      DerivsPoint (i,IRARARB) = DerivsPoint (i,IRARARB) + d3Edrho3(j * 4 + 2)
      DerivsPoint (i,IRARAGA) = DerivsPoint (i,IRARAGA) + d3Edrho2sigma(j * 9 + 1)
      DerivsPoint (i,IRARAGB) = DerivsPoint (i,IRARAGB) + d3Edrho2sigma(j * 9 + 3)
      DerivsPoint (i,IRARAGC) = DerivsPoint (i,IRARAGC) + d3Edrho2sigma(j * 9 + 2)
      DerivsPoint (i,IRARATA) = DerivsPoint (i,IRARATA) + d3Edrho2tau(j * 6 + 1)
      DerivsPoint (i,IRARATB) = DerivsPoint (i,IRARATB) + d3Edrho2tau(j * 6 + 2)
      DerivsPoint (i,IRARBRB) = DerivsPoint (i,IRARBRB) + d3Edrho3(j * 4 + 3)
      DerivsPoint (i,IRARBGA) = DerivsPoint (i,IRARBGA) + d3Edrho2sigma(j * 9 + 4)
      DerivsPoint (i,IRARBGB) = DerivsPoint (i,IRARBGB) + d3Edrho2sigma(j * 9 + 6)
      DerivsPoint (i,IRARBGC) = DerivsPoint (i,IRARBGC) + d3Edrho2sigma(j * 9 + 5)
      DerivsPoint (i,IRARBTA) = DerivsPoint (i,IRARBTA) + d3Edrho2tau(j * 6 + 3)
      DerivsPoint (i,IRARBTB) = DerivsPoint (i,IRARBTB) + d3Edrho2tau(j * 6 + 4)
      DerivsPoint (i,IRAGAGA) = DerivsPoint (i,IRAGAGA) + d3Edrhosigma2(j * 12 + 1)
      DerivsPoint (i,IRAGAGB) = DerivsPoint (i,IRAGAGB) + d3Edrhosigma2(j * 12 + 3)
      DerivsPoint (i,IRAGAGC) = DerivsPoint (i,IRAGAGC) + d3Edrhosigma2(j * 12 + 2)
      DerivsPoint (i,IRAGATA) = DerivsPoint (i,IRAGATA) + d3Edrhosigmatau(j * 12 + 1)
      DerivsPoint (i,IRAGATB) = DerivsPoint (i,IRAGATB) + d3Edrhosigmatau(j * 12 + 2)
      DerivsPoint (i,IRAGBGB) = DerivsPoint (i,IRAGBGB) + d3Edrhosigma2(j * 12 + 6)
      DerivsPoint (i,IRAGBGC) = DerivsPoint (i,IRAGBGC) + d3Edrhosigma2(j * 12 + 5)
      DerivsPoint (i,IRAGBTA) = DerivsPoint (i,IRAGBTA) + d3Edrhosigmatau(j * 12 + 5)
      DerivsPoint (i,IRAGBTB) = DerivsPoint (i,IRAGBTB) + d3Edrhosigmatau(j * 12 + 6)
      DerivsPoint (i,IRAGCGC) = DerivsPoint (i,IRAGCGC) + d3Edrhosigma2(j * 12 + 4)
      DerivsPoint (i,IRAGCTA) = DerivsPoint (i,IRAGCTA) + d3Edrhosigmatau(j * 12 + 3)
      DerivsPoint (i,IRAGCTB) = DerivsPoint (i,IRAGCTB) + d3Edrhosigmatau(j * 12 + 4)
      DerivsPoint (i,IRATATA) = DerivsPoint (i,IRATATA) + d3Edrhotau2(j * 6 + 1)
      DerivsPoint (i,IRATATB) = DerivsPoint (i,IRATATB) + d3Edrhotau2(j * 6 + 2)
      DerivsPoint (i,IRATBTB) = DerivsPoint (i,IRATBTB) + d3Edrhotau2(j * 6 + 3)
      DerivsPoint (i,IRBRBRB) = DerivsPoint (i,IRBRBRB) + d3Edrho3(j * 4 + 4)
      DerivsPoint (i,IRBRBGA) = DerivsPoint (i,IRBRBGA) + d3Edrho2sigma(j * 9 + 7)
      DerivsPoint (i,IRBRBGB) = DerivsPoint (i,IRBRBGB) + d3Edrho2sigma(j * 9 + 9)
      DerivsPoint (i,IRBRBGC) = DerivsPoint (i,IRBRBGC) + d3Edrho2sigma(j * 9 + 8)
      DerivsPoint (i,IRBRBTA) = DerivsPoint (i,IRBRBTA) + d3Edrho2tau(j * 6 + 5)
      DerivsPoint (i,IRBRBTB) = DerivsPoint (i,IRBRBTB) + d3Edrho2tau(j * 6 + 6)
      DerivsPoint (i,IRBGAGA) = DerivsPoint (i,IRBGAGA) + d3Edrhosigma2(j * 12 + 7)
      DerivsPoint (i,IRBGAGB) = DerivsPoint (i,IRBGAGB) + d3Edrhosigma2(j * 12 + 9)
      DerivsPoint (i,IRBGAGC) = DerivsPoint (i,IRBGAGC) + d3Edrhosigma2(j * 12 + 8)
      DerivsPoint (i,IRBGATA) = DerivsPoint (i,IRBGATA) + d3Edrhosigmatau(j * 12 + 7)
      DerivsPoint (i,IRBGATB) = DerivsPoint (i,IRBGATB) + d3Edrhosigmatau(j * 12 + 8)
      DerivsPoint (i,IRBGBGB) = DerivsPoint (i,IRBGBGB) + d3Edrhosigma2(j * 12 + 12)
      DerivsPoint (i,IRBGBGC) = DerivsPoint (i,IRBGBGC) + d3Edrhosigma2(j * 12 + 11)
      DerivsPoint (i,IRBGBTA) = DerivsPoint (i,IRBGBTA) + d3Edrhosigmatau(j * 12 + 11)
      DerivsPoint (i,IRBGBTB) = DerivsPoint (i,IRBGBTB) + d3Edrhosigmatau(j * 12 + 12)
      DerivsPoint (i,IRBGCGC) = DerivsPoint (i,IRBGCGC) + d3Edrhosigma2(j * 12 + 10)
      DerivsPoint (i,IRBGCTA) = DerivsPoint (i,IRBGCTA) + d3Edrhosigmatau(j * 12 + 9)
      DerivsPoint (i,IRBGCTB) = DerivsPoint (i,IRBGCTB) + d3Edrhosigmatau(j * 12 + 10)
      DerivsPoint (i,IRBTATA) = DerivsPoint (i,IRBTATA) + d3Edrhotau2(j * 6 + 4)
      DerivsPoint (i,IRBTATB) = DerivsPoint (i,IRBTATB) + d3Edrhotau2(j * 6 + 5)
      DerivsPoint (i,IRBTBTB) = DerivsPoint (i,IRBTBTB) + d3Edrhotau2(j * 6 + 6)
      DerivsPoint (i,IGAGAGA) = DerivsPoint (i,IGAGAGA) + d3Edsigma3(j * 10 + 1)
      DerivsPoint (i,IGAGAGB) = DerivsPoint (i,IGAGAGB) + d3Edsigma3(j * 10 + 3)
      DerivsPoint (i,IGAGAGC) = DerivsPoint (i,IGAGAGC) + d3Edsigma3(j * 10 + 2)
      DerivsPoint (i,IGAGATA) = DerivsPoint (i,IGAGATA) + d3Edsigma2tau(j * 12 + 1)
      DerivsPoint (i,IGAGATB) = DerivsPoint (i,IGAGATB) + d3Edsigma2tau(j * 12 + 2)
      DerivsPoint (i,IGAGBGB) = DerivsPoint (i,IGAGBGB) + d3Edsigma3(j * 10 + 6)
      DerivsPoint (i,IGAGBGC) = DerivsPoint (i,IGAGBGC) + d3Edsigma3(j * 10 + 5)
      DerivsPoint (i,IGAGBTA) = DerivsPoint (i,IGAGBTA) + d3Edsigma2tau(j * 12 + 5)
      DerivsPoint (i,IGAGBTB) = DerivsPoint (i,IGAGBTB) + d3Edsigma2tau(j * 12 + 6)
      DerivsPoint (i,IGAGCGC) = DerivsPoint (i,IGAGCGC) + d3Edsigma3(j * 10 + 4)
      DerivsPoint (i,IGAGCTA) = DerivsPoint (i,IGAGCTA) + d3Edsigma2tau(j * 12 + 3)
      DerivsPoint (i,IGAGCTB) = DerivsPoint (i,IGAGCTB) + d3Edsigma2tau(j * 12 + 4)
      DerivsPoint (i,IGATATA) = DerivsPoint (i,IGATATA) + d3Edsigmatau2(j * 9 + 1)
      DerivsPoint (i,IGATATB) = DerivsPoint (i,IGATATB) + d3Edsigmatau2(j * 9 + 2)
      DerivsPoint (i,IGATBTB) = DerivsPoint (i,IGATBTB) + d3Edsigmatau2(j * 9 + 3)
      DerivsPoint (i,IGBGBGB) = DerivsPoint (i,IGBGBGB) + d3Edsigma3(j * 10 + 10)
      DerivsPoint (i,IGBGBGC) = DerivsPoint (i,IGBGBGC) + d3Edsigma3(j * 10 + 9)
      DerivsPoint (i,IGBGBTA) = DerivsPoint (i,IGBGBTA) + d3Edsigma2tau(j * 12 + 11)
      DerivsPoint (i,IGBGBTB) = DerivsPoint (i,IGBGBTB) + d3Edsigma2tau(j * 12 + 12)
      DerivsPoint (i,IGBGCGC) = DerivsPoint (i,IGBGCGC) + d3Edsigma3(j * 10 + 8)
      DerivsPoint (i,IGBGCTA) = DerivsPoint (i,IGBGCTA) + d3Edsigma2tau(j * 12 + 9)
      DerivsPoint (i,IGBGCTB) = DerivsPoint (i,IGBGCTB) + d3Edsigma2tau(j * 12 + 10)
      DerivsPoint (i,IGBTATA) = DerivsPoint (i,IGBTATA) + d3Edsigmatau2(j * 9 + 7)
      DerivsPoint (i,IGBTATB) = DerivsPoint (i,IGBTATB) + d3Edsigmatau2(j * 9 + 8)
      DerivsPoint (i,IGBTBTB) = DerivsPoint (i,IGBTBTB) + d3Edsigmatau2(j * 9 + 9)
      DerivsPoint (i,IGCGCGC) = DerivsPoint (i,IGCGCGC) + d3Edsigma3(j * 10 + 7)
      DerivsPoint (i,IGCGCTA) = DerivsPoint (i,IGCGCTA) + d3Edsigma2tau(j * 12 + 7)
      DerivsPoint (i,IGCGCTB) = DerivsPoint (i,IGCGCTB) + d3Edsigma2tau(j * 12 + 8)
      DerivsPoint (i,IGCTATA) = DerivsPoint (i,IGCTATA) + d3Edsigmatau2(j * 9 + 4)
      DerivsPoint (i,IGCTATB) = DerivsPoint (i,IGCTATB) + d3Edsigmatau2(j * 9 + 5)
      DerivsPoint (i,IGCTBTB) = DerivsPoint (i,IGCTBTB) + d3Edsigmatau2(j * 9 + 6)
      DerivsPoint (i,ITATATA) = DerivsPoint (i,ITATATA) + d3Edtau3(j * 4 + 1)
      DerivsPoint (i,ITATATB) = DerivsPoint (i,ITATATB) + d3Edtau3(j * 4 + 2)
      DerivsPoint (i,ITATBTB) = DerivsPoint (i,ITATBTB) + d3Edtau3(j * 4 + 3)
      DerivsPoint (i,ITBTBTB) = DerivsPoint (i,ITBTBTB) + d3Edtau3(j * 4 + 4)
    end do
    deallocate(rho, sigma, tau, lapl, energy, dEdrho, dEdsigma, dEdlapl, dEdtau, &
      d2Edrho2, d2Edrhosigma, d2Edrholapl, d2Edrhotau,                                           &
      d2Edsigma2, d2Edsigmalapl, d2Edsigmatau, d2Edlapl2, d2Edlapltau, d2Edtau2,                 &
      d3Edrho3, d3Edrho2sigma, d3Edrho2lapl, d3Edrho2tau, d3Edrhosigma2, d3Edrhosigmalapl,       &
      d3Edrhosigmatau, d3Edrholapl2, d3Edrholapltau, d3Edrhotau2, d3Edsigma3, d3Edsigma2lapl,    &
      d3Edsigma2tau, d3Edsigmalapl2, d3Edsigmalapltau, d3Edsigmatau2, d3Edlapl3, d3Edlapl2tau,   &
      d3Edlapltau2, d3Edtau3)
  end subroutine libxc_TD_3D
  !
  !*MODULE libxc DECK add_free_functional
  !> @brief  add functionals from libxc_choose_functionals for avoiding many repeated code
  !> @author Igor S. Gerasimov
  !> @date   March, 2020 - Initial release -
  !> @date   July, 2021 Using messages module
  !> @params section         - (in) class pair object which contains inputted keys of section
  !> @params section_name    - (in) name of section
  !> @params functional_name - (in) functional name
  !> @params functional_code - (in) functional LibXC ID (C_INT)
  !> @params needtau         - (in,optional) flag for tau-dependent meta-GGA functionals
  subroutine add_free_functional(section, functional_name, functional_code, needtau)
    use messages, only: show_message, WITH_ABORT
    use ISO_C_Binding, only: C_INT
    use mod_nameio, only: input_group
    use metagga, only: NT => needtau
    implicit none
    character(len=*), parameter :: IN          = " in ", &
                                   READ_ERROR  = " was not successful read!", &
                                   CHECK_INPUT = "Please, check the input!"
    class(input_group), allocatable, intent(inout) :: section
    character(len=*),                intent(in)    :: functional_name
    integer(C_INT),                  intent(in)    :: functional_code
    logical,            optional,    intent(in)    :: needtau
    ! internal variables
    real(kind=fp) :: coefficient
    integer :: error
    call section%get_value(functional_name,coefficient,error,-1E+07_fp)
    if(error .eq. 1) then
      call show_message(functional_name//IN//section%name//READ_ERROR)
      call show_message(CHECK_INPUT)
      call show_message(ABORTING, WITH_ABORT)
    else if(error .eq. 0) then
      call functional_%add_functional(functional_code,coefficient)
    end if
    if(present(needtau)) then
      if(needtau) NT = needtau
    end if
  end subroutine add_free_functional
  !
  !*MODULE libxc DECK libxc_input
  !> @brief  codegenerated subroutine for choosing functionals from available in LibXC
  !> @detail If you want to modify it, please, edit $GMS_PATH/tools/libxc/gen_all.py
  !>
  !> @author $GMS_PATH/tools/libxc/gen_all.py
  !>
  !> @date   July,     2019 Create subroutine
  !> @date   April,    2020 Update to LibXC 5.0.0
  !> @date   June,     2021 Update to LibXC-5.1.5
  !> @date   July,     2021 Add read_unit argument
