!*MODULE libxc
!> @brief  The head of libxc driver
!> @author Igor S. Gerasimov
!> @date   July, 2019 - Initial release -
!> @date   July, 2021 Making internal subroutines private
!> @todo   add LC-, CAM- free coefficient functionals
!> @todo   add meta-GGA functionals with laplacian of electron density
module libxc
  use xc_f03_lib_m
  use functionals, only: functional
  use prec,        only: fp
  implicit none
  private
#ifdef OQP
  logical, parameter :: use_libxc = .TRUE.
#else
  logical :: use_libxc = .FALSE.
#endif
  character(len=*), parameter :: ABORTING = "Aborting from LibXC interface..."
  type(functional) :: functional_
  public :: use_libxc
  public :: libxc_input, libxc_calc, libxc_TD_2D, libxc_TD_3D, libxc_destroy
contains
  !
  !*MODULE libxc DECK libxc_input
  !> @brief  setting up of using libxc functionals
  !>         (Analog of INPGDFT)
  !> @detail
  !          For adding a new functional:
  !           1) search code of interested functional that is a part of LibXC (like PBEX has code 101 and PBEC has code 130)
  !           2) Determine coefficients of each needed coefficients (as for example PBE-0.1: 0.1HF + 0.9PBEX + 1.0PBEC)
  !           3) Create a name of your functional (like PBEH). It can has any symbol excepting newline and space.
  !           4) Do not forget to set flag needtau=.true. if your functional need it.
  !
  !           the example of code:
  !             case("PBEH", "PBE-0.1") !two variant of names
  !                 HFEX = 0.10_fp !0.1HF exchange
  !                 call functional_%add_functional(XC_GGA_X_PBE,0.9_fp) !PBE_X*0.9
  !                 call functional_%add_functional(XC_GGA_C_PBE,1.0_fp) !PBE_C*1.0
  !> @author Igor S. Gerasimov
  !> @date   July, 2019 - Initial release -
  !> @date   July, 2021 Using messages module
  !>                    Adding optional arguments
  !> @params read_unit  (in,optional) logical unit of input file
  !> @params functional (in,optional) functional's name
  subroutine libxc_input(read_unit, functional)
    use messages, only: show_message, WITH_ABORT
#ifndef OQP
    use comm_DFTPAR, only: DFTTYP
#endif
    use metagga,    only: needtau
    use mod_nameio, only: input_group
    use dhdft,      only: chf, cmp2, &
                    c2same => c2s, &
                    c2opp => c2t, &
                    dhfunc
    use camdft,     only: alpha => cam_alpha, &
                    beta => cam_beta, &
                    mu => cam_mu, &
                    camflag

    !
    ! input's arguments
    integer, intent(in), optional :: read_unit
    character(len=*),    optional :: functional
    !
    ! Functional names
    character(len=:), allocatable :: funcname
    !
    ! Reader
    class(input_group), allocatable :: LibXC_group
    integer                         :: error
    ! LibXC strings
    character(len=1024) :: LibXC_DOI, LibXC_reference, LibXC_version

    real(kind=fp) :: HFEX,MP2,MP2SS,MP2OP,CAMMU,CAMALPHA,CAMBETA
    HFEX = 0.0_fp

    if(.not.use_libxc) then
      call show_message("USING LIBXC INTERFACE WITHOUT DFTTYP=USELIBXC!")
      call show_message("ABORT CALCULATION!", WITH_ABORT)
    end if

    if(present(read_unit).and.present(functional)) then
      call show_message("read_unit and functional variables are passed into LibXC interface!", WITH_ABORT)
    else if(present(read_unit)) then ! OK
    else if(present(functional)) then ! OK
    else ! no one is presented
      call show_message("no one of read_unit and functional variables are passed into LibXC interface!", WITH_ABORT)
    end if

    call xc_f03_reference(LibXC_reference)
    call xc_f03_reference_doi(LibXC_DOI)
    call xc_f03_version_string(LibXC_version)

    call show_message(" ") !empty line
    call show_message(" The LibXC " // trim(LibXC_version) // " version is used!")
    call show_message(" ") !empty line
    call show_message(" THE FOLLOWING PAPERS SHOULD BE CITED WHEN USING LIBXC INTERFACE:")
    call show_message(" " // trim(LibXC_reference))
    call show_message(" DOI: " // trim(LibXC_DOI))
    call show_message(" and")
    call show_message(" Igor S. Gerasimov, Federico Zahariev, Sarom S. Leang, Anton Tesliuk, Mark S. Gordon, Michael G. Medvedev,")
    call show_message(" Introducing LibXC into GAMESS (US),")
    call show_message(" Mendeleev Commun., 2021, 31, 302–305")
    call show_message(" DOI: 10.1016/j.mencom.2021.05.008")
    call show_message(" ") !empty line
    call show_message(" The information about selected functionals:")

    if(.not.present(functional)) then
      allocate(LibXC_group)
      if(present(read_unit)) then
        call LibXC_group%read_section(read_unit, "LIBXC", &
          (/ "FUNCTIONAL", "HFEX      ", "MP2       ", "MP2SS     ",  "MP2OS     " /))
        call LibXC_group%get_value("FUNCTIONAL",funcname,error)
        if(error .ne. 0) then
          call show_message("$LIBXC: The FUNCTIONAL keyword is not found! Assume FUNCTIONAL=MIXED!")
          funcname = "MIXED"
        end if
      end if
    else
      funcname = functional
    end if
    select case(funcname)
      ! If FUNCTIONAL is not presented or equals to MIXED:
      case ("", "MIXED")
        !read HFEX (ratio of exact exchange)
        call LibXC_group%get_value("HFEX",HFEX,error,0.0_fp)
        if(error .eq. 0) then
          chf = HFEX
          call show_message("(A,ES16.8E2)", "The ratio of exact exchange (HFEX) is: ", HFEX)
        end if
        ! read MP2 (ratio of non-local MP2 correlation)
        call LibXC_group%get_value("MP2",MP2,error,0.0_fp)
        if(error .eq. 0) then
          dhfunc =.true.
          cmp2   = MP2
          c2same = MP2
          c2opp  = MP2
          call show_message("(A,ES16.8E2)", "The ratio of non-local correlation (MP2) is: ", MP2)
        end if
        ! read MP2SS (ratio on non-local same-spin MP2 correlation)
        call LibXC_group%get_value("MP2SS",MP2SS,error,0.0_fp)
        if(error .eq. 0) then
          dhfunc =.true.
          c2same = MP2SS
          call show_message("(A,ES16.8E2)", "The ratio of same-spin non-local correlation (MP2SS) is: ", MP2SS)
        end if
        ! read MP2OS (ratio on non-local opposite-spin MP2 correlation)
        call LibXC_group%get_value("MP2OS",MP2OP,error,0.0_fp)
        if(error .eq. 0) then
          dhfunc =.true.
          c2opp  = MP2OP
          call show_message("(A,ES16.8E2)", "The ratio of opposite-spin non-local correlation (MP2OS) is: ", MP2OP)
        end if
        ! the MP2OS == MP2SS means, that SCS-MP2 is not needed:
        if((MP2OP .eq. MP2SS) .and. (MP2OP .ne. 0.00_fp)) then
          MP2        = MP2OP
          cmp2       = MP2
          c2same     = MP2
          c2opp      = MP2
          call show_message("(A,ES16.8E2)", "The ratio of opposite-spin and same-spin non-local correlation is equals," // &
              " and their value is ", MP2)
        end if
        ! Inputting of CAM leads to error. The libxc should be modified
        call LibXC_group%get_value("CAMALPHA",CAMALPHA,error,0.0_fp)
        if(error .eq. 0) then
          camflag = .true.
          alpha   = CAMALPHA
          call show_message("CAM coefficients are not supported yet!")
          call show_message(ABORTING, WITH_ABORT)
        end if
        ! Inputting of CAM leads to error. The libxc should be modified
        call LibXC_group%get_value("CAMBETA",CAMBETA,error,0.0_fp)
        if(error .eq. 0) then
          camflag = .true.
          beta    = CAMBETA
          call show_message("CAM coefficients are not supported yet!")
          call show_message(ABORTING, WITH_ABORT)
        end if
        ! Inputting of CAM leads to error. The libxc should be modified
        call LibXC_group%get_value("CAMMU",CAMMU,error,0.0_fp)
        if(error .eq. 0) then
          camflag = .true.
          mu      = CAMMU
          call show_message("CAM coefficients are not supported yet!")
          call show_message(ABORTING, WITH_ABORT)
        end if
        ! read other LibXC sections
        if(present(read_unit)) then
          call libxc_choose_functionals(read_unit)
        else
          call show_message("Calling of MIXED functional requires input group!", WITH_ABORT)
        endif
      case("SLATER")
        call functional_%add_functional(                      XC_LDA_X,1.00_fp) !SLATER_X
      case("TETER")
        call functional_%add_functional(             XC_LDA_XC_TETER93,1.00_fp) !TETER93_XC
      case("KSDT")
        call functional_%add_functional(                XC_LDA_XC_KSDT,1.00_fp) !KSDT_XC
      case("CORRKSDT")
        call functional_%add_functional(            XC_LDA_XC_CORRKSDT,1.00_fp)
      case("GDSMFB")
        call functional_%add_functional(              XC_LDA_XC_GDSMFB,1.00_fp) !GDSMFB_XC
      case("ZLP-20")
        call functional_%add_functional(                 XC_LDA_XC_ZLP,1.00_fp) !ZLP_XC (LDA)
      case("PBE", "PBEPBE")
        call functional_%add_functional(                  XC_GGA_X_PBE,1.00_fp) !PBE_X
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp) !PBE_C
      case("REVPBE")
        call functional_%add_functional(                XC_GGA_X_PBE_R,1.00_fp) !PBE_R_X
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp) !PBE_C
      case("RPBE")
        call functional_%add_functional(                 XC_GGA_X_RPBE,1.00_fp) !RPBE_X
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp) !PBE_C
      case("PW91")
        call functional_%add_functional(                 XC_GGA_X_PW91,1.00_fp)
        call functional_%add_functional(                 XC_GGA_C_PW91,1.00_fp)
      case("AM05")
        call functional_%add_functional(                 XC_GGA_X_AM05,1.00_fp)
        call functional_%add_functional(                 XC_GGA_C_AM05,1.00_fp)
      case("PBESOL")
        call functional_%add_functional(              XC_GGA_X_PBE_SOL,1.00_fp) !PBEsol_X
        call functional_%add_functional(              XC_GGA_C_PBE_SOL,1.00_fp) !PBEsol_C
      case("WC")
        call functional_%add_functional(                   XC_GGA_X_WC,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
      case("CHACHIYO")
        call functional_%add_functional(             XC_GGA_X_CHACHIYO,1.00_fp)
        call functional_%add_functional(             XC_GGA_C_CHACHIYO,1.00_fp)
      case("BLYP")
        call functional_%add_functional(                  XC_GGA_X_B88,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp)
      case("OLYP")
        call functional_%add_functional(                 XC_GGA_X_OPTX,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_LYP,1.00_fp)
      case("XLYP")
        call functional_%add_functional(                XC_GGA_XC_XLYP,1.00_fp)
      case("KT1")
        call functional_%add_functional(                 XC_GGA_XC_KT1,1.00_fp)
      case("KT2")
        call functional_%add_functional(                 XC_GGA_XC_KT2,1.00_fp)
      case("KT3")
        call functional_%add_functional(                 XC_GGA_XC_KT3,1.00_fp)
      case("TH1")
        call functional_%add_functional(                 XC_GGA_XC_TH1,1.00_fp)
      case("TH2")
        call functional_%add_functional(                 XC_GGA_XC_TH2,1.00_fp)
      case("TH3")
        call functional_%add_functional(                 XC_GGA_XC_TH3,1.00_fp)
      case("TH4")
        call functional_%add_functional(                 XC_GGA_XC_TH4,1.00_fp)
      case("HCTH93")
        call functional_%add_functional(             XC_GGA_XC_HCTH_93,1.00_fp)
      case("HCTH120")
        call functional_%add_functional(            XC_GGA_XC_HCTH_120,1.00_fp)
      case("HCTH147")
        call functional_%add_functional(            XC_GGA_XC_HCTH_147,1.00_fp)
      case("HCTH407")
        call functional_%add_functional(            XC_GGA_XC_HCTH_407,1.00_fp)
      case("HCTH407+", "HCTH407P")
        call functional_%add_functional(           XC_GGA_XC_HCTH_407P,1.00_fp)
      case("HCTH-A")
        call functional_%add_functional(               XC_GGA_X_HCTH_A,1.00_fp)
        call functional_%add_functional(               XC_GGA_C_HCTH_A,1.00_fp)
      case("HCTH-P14")
        call functional_%add_functional(            XC_GGA_XC_HCTH_P14,1.00_fp)
      case("HCTH-P76")
        call functional_%add_functional(            XC_GGA_XC_HCTH_P76,1.00_fp)
      case("PBE1W")
        call functional_%add_functional(               XC_GGA_XC_PBE1W,1.00_fp)
      case("MPWLYP1W")
        call functional_%add_functional(            XC_GGA_XC_MPWLYP1W,1.00_fp)
      case("PBELYP1W")
        call functional_%add_functional(            XC_GGA_XC_PBELYP1W,1.00_fp)
      case("GAM")
        call functional_%add_functional(                  XC_GGA_X_GAM,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_GAM,1.00_fp)
      case("MOHLYP")
        call functional_%add_functional(              XC_GGA_XC_MOHLYP,1.00_fp)
      case("MOHLYP-2", "MOHLYP2")
        call functional_%add_functional(             XC_GGA_XC_MOHLYP2,1.00_fp)
      case("SOGGA11")
        call functional_%add_functional(              XC_GGA_X_SOGGA11,1.00_fp)
        call functional_%add_functional(              XC_GGA_C_SOGGA11,1.00_fp)
      case("N12")
        call functional_%add_functional(                  XC_GGA_C_N12,1.00_fp)
        call functional_%add_functional(                  XC_GGA_X_N12,1.00_fp)
      case("HLE16")
        call functional_%add_functional(               XC_GGA_XC_HLE16,1.00_fp)
      case("EDF1")
        call functional_%add_functional(                XC_GGA_XC_EDF1,1.00_fp)
      case("LB07")
        camflag   = .true.
        call functional_%add_functional(            XC_HYB_GGA_XC_LB07,1.00_fp, alpha=alpha, beta=beta, omega=mu)
      case("NCAP")
        call functional_%add_functional(                XC_GGA_XC_NCAP,1.00_fp)
      case("HTBS")
        call functional_%add_functional(                 XC_GGA_X_HTBS,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
      case("PKZB")
        call functional_%add_functional(                XC_MGGA_X_PKZB,1.00_fp)
        call functional_%add_functional(                XC_MGGA_C_PKZB,1.00_fp)
        needtau = .true.
      case("TPSS")
        call functional_%add_functional(                XC_MGGA_X_TPSS,1.00_fp)
        call functional_%add_functional(                XC_MGGA_C_TPSS,1.00_fp)
        needtau = .true.
      case("REVTPSS")
        call functional_%add_functional(             XC_MGGA_X_REVTPSS,1.00_fp)
        call functional_%add_functional(             XC_MGGA_C_REVTPSS,1.00_fp)
        needtau = .true.
      case("MODTPSS")
        call functional_%add_functional(             XC_MGGA_X_MODTPSS,1.00_fp)
        call functional_%add_functional(                XC_MGGA_C_TPSS,1.00_fp)
        needtau = .true.
      case("TPSSLOC", "TPSS-LOC")
        call functional_%add_functional(                XC_MGGA_X_TPSS,1.00_fp)
        call functional_%add_functional(             XC_MGGA_C_TPSSLOC,1.00_fp)
        needtau = .true.
      case("RTPSS")
        call functional_%add_functional(               XC_MGGA_X_RTPSS,1.00_fp)
        call functional_%add_functional(              XC_GGA_C_REGTPSS,1.00_fp)
        needtau = .true.
      case("REGTPSS")
        call functional_%add_functional(             XC_MGGA_X_REGTPSS,1.00_fp)
        call functional_%add_functional(              XC_GGA_C_REGTPSS,1.00_fp)
        needtau = .true.
      case("MVS")
        call functional_%add_functional(                 XC_MGGA_X_MVS,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("MVSB")
        call functional_%add_functional(                XC_MGGA_X_MVSB,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("MVSB*", "MVSBS")
        call functional_%add_functional(               XC_MGGA_X_MVSBS,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("MS0")
        call functional_%add_functional(                 XC_MGGA_X_MS0,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("MS1")
        call functional_%add_functional(                 XC_MGGA_X_MS1,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("MS2")
        call functional_%add_functional(                 XC_MGGA_X_MS2,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("MS2B")
        call functional_%add_functional(                XC_MGGA_X_MS2B,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("MS2B*", "MS2BS")
        call functional_%add_functional(               XC_MGGA_X_MS2BS,1.00_fp)
        call functional_%add_functional(                  XC_GGA_C_PBE,1.00_fp)
        needtau = .true.
      case("SCAN")
        call functional_%add_functional(                XC_MGGA_X_SCAN,1.00_fp)
        call functional_%add_functional(                XC_MGGA_C_SCAN,1.00_fp)
        needtau = .true.
      case("RSCAN", "REGSCAN")
        call functional_%add_functional(               XC_MGGA_X_RSCAN,1.00_fp)
        call functional_%add_functional(               XC_MGGA_C_RSCAN,1.00_fp)
        needtau = .true.
      case("RPPSCAN", "R++SCAN")
        call functional_%add_functional(             XC_MGGA_X_RPPSCAN,1.00_fp)
        call functional_%add_functional(             XC_MGGA_C_RPPSCAN,1.00_fp)
        needtau = .true.
      case("R2SCAN")
        call functional_%add_functional(              XC_MGGA_X_R2SCAN,1.00_fp)
        call functional_%add_functional(              XC_MGGA_C_R2SCAN,1.00_fp)
        needtau = .true.
      case("R2SCAN01")
        call functional_%add_functional(            XC_MGGA_X_R2SCAN01,1.00_fp)
        call functional_%add_functional(            XC_MGGA_C_R2SCAN01,1.00_fp)
        needtau = .true.
      case("R4SCAN")
        call functional_%add_functional(              XC_MGGA_X_R4SCAN,1.00_fp)
        call functional_%add_functional(              XC_MGGA_C_R2SCAN,1.00_fp)
        needtau = .true.
      case("REVSCAN")
        call functional_%add_functional(             XC_MGGA_X_REVSCAN,1.00_fp)
        call functional_%add_functional(             XC_MGGA_C_REVSCAN,1.00_fp)
        needtau = .true.
      case("TASK")
        call functional_%add_functional(                XC_MGGA_X_TASK,1.00_fp)
        call functional_%add_functional(                   XC_LDA_C_PW,1.00_fp)
        needtau = .true.
      case("TM")
        call functional_%add_functional(                  XC_MGGA_X_TM,1.00_fp)
        call functional_%add_functional(                  XC_MGGA_C_TM,1.00_fp)
        needtau = .true.
      case("REVTM")
        call functional_%add_functional(               XC_MGGA_X_REVTM,1.00_fp)
        call functional_%add_functional(               XC_MGGA_C_REVTM,1.00_fp)
        needtau = .true.
      case("REGTM")
        call functional_%add_functional(               XC_MGGA_X_REGTM,1.00_fp)
        call functional_%add_functional(                  XC_MGGA_C_TM,1.00_fp)
        needtau = .true.
      case("RREGTM")
        call functional_%add_functional(               XC_MGGA_X_REGTM,1.00_fp)
        call functional_%add_functional(              XC_MGGA_C_RREGTM,1.00_fp)
        needtau = .true.
      case("MGGAC")
        call functional_%add_functional(               XC_MGGA_X_MGGAC,1.00_fp)
        call functional_%add_functional(                XC_GGA_C_MGGAC,1.00_fp)
        needtau = .true.
      case("RMGGAC")
        call functional_%add_functional(               XC_MGGA_X_MGGAC,1.00_fp)
        call functional_%add_functional(              XC_MGGA_C_RMGGAC,1.00_fp)
        needtau = .true.
      case("TAUHCTH", "THCTH")
        call functional_%add_functional(            XC_MGGA_X_TAU_HCTH,1.00_fp)
        call functional_%add_functional(             XC_GGA_C_TAU_HCTH,1.00_fp)
        needtau = .true.
      case("VSXC")
        call functional_%add_functional(                XC_MGGA_X_GVT4,1.00_fp)
        call functional_%add_functional(                XC_MGGA_C_VSXC,1.00_fp)
        needtau = .true.
      case("TPSSLYP1W")
        call functional_%add_functional(          XC_MGGA_XC_TPSSLYP1W,1.00_fp)
        needtau = .true.
      case("M06-L", "M06L")
        call functional_%add_functional(               XC_MGGA_X_M06_L,1.00_fp)
        call functional_%add_functional(               XC_MGGA_C_M06_L,1.00_fp)
        needtau = .true.
      case("REVM06-L", "REVM06L")
        call functional_%add_functional(            XC_MGGA_X_REVM06_L,1.00_fp)
        call functional_%add_functional(            XC_MGGA_C_REVM06_L,1.00_fp)
        needtau = .true.
      case("M11-L", "M11L")
        camflag = .true.
        call functional_%add_functional(               XC_MGGA_X_M11_L,1.00_fp, alpha=alpha, beta=beta, omega=mu)
        call functional_%add_functional(               XC_MGGA_C_M11_L,1.00_fp)
        needtau = .true.
      case("MN12-L", "MN12L")
        call functional_%add_functional(              XC_MGGA_X_MN12_L,1.00_fp)
        call functional_%add_functional(              XC_MGGA_C_MN12_L,1.00_fp)
        needtau = .true.
      case("MN15-L", "MN15L")
