  subroutine gpu_tdhf_apb_j01_SSSS(l1,l2,ia,da,FA,cutoff, &
       len1,len2,len3,len4,nintn,qq4,DSH,NSH2,nteams,limitthread,cmax,nxyz,& 
    CO,RFINC,FGRID,XGRID,RMR,KTYPE,KLOC,KMIN,KMAX,KSTART,KNG,EX,CS,CP) 

      use comm_NSHEL_sp, only: NSHELL
      USE comm_FMTTBL, only: RXINC,TMAX
      use comm_INTAC2, only: EI1,EI2,CUX
    USE omp_lib
    USE prec, ONLY: fp
    use mod_shell_index
    use mod_dirfck_tdhf_apb, only: GPU_GENR70_dirfck_tdhf_APB
      use mx_limits, only: mxgtot,mxgsh,mxg2,mxsh
      use mod_jtype1
  use mod_xint_scrn, only: nij01, nbraJ01, xintBJ01
  implicit none

    double precision, parameter :: one=1.00D+00, zero=0.00D+00, HALF=0.5D+00,&
    memMB=1024*1024, F04=4.00D+00, eight=8.00D+00

    COMMON /par   / me,master,nproc,ibtyp,iptim,goparr,dskwrk,maswrk
        INTEGER :: me,master,nproc,ibtyp,iptim
        LOGICAL :: dskwrk, maswrk, goparr


    INTEGER, INTENT(IN) :: l1,l2,nsh2,nxyz,len1,len2,len3,len4,ia(l1)
    INTEGER, INTENT(IN) :: nteams,limitthread
    double precision, INTENT(IN) :: cutoff, cmax(mxgtot),dsh(nsh2)
    double precision, INTENT(IN) :: da(l2*nxyz) 
    double precision, INTENT(INOUT) :: FA(l2*nxyz)
    integer, intent(inout) :: NINTN
    double precision :: qq4

    double precision :: scutij,denmax,cutoff_denmax
    integer :: niijj,i_tmp,iijjkkll,iijj_tmp,kkll_tmp, &
    iijj,kkll,ii_TMP,jj_TMP,kk_TMP,ll_TMP,ii,jj,kk,ll, IQUART ,NQUARTS

    integer :: NCHUNK,nshell_start_,nshell_end_
    double precision :: gpople(256)
    integer :: LPOPI,LPOPJ,LPOPK,LPOPL

    double precision, INTENT(IN) :: CO(MXSH,3)
  integer, parameter :: NTX=4, NPF=450, NGRD=7, NPX=1000, MXQT=16
  double precision, INTENT(IN) :: FGRID(0:NTX,0:NPF,0:NGRD)
  double precision, INTENT(IN) :: XGRID(0:NTX,0:NPX)
  double precision, INTENT(IN) :: RFINC(0:NGRD), RMR(MXQT)
  double precision, INTENT(IN) :: ex(mxgtot),cs(mxgtot),cp(mxgtot)
  integer, INTENT(IN) :: kstart(mxsh),ktype(mxsh),kng(mxsh),  &
                  kloc(mxsh),kmin(mxsh),kmax(mxsh)

niijj=nij01
denmax = maxval(DSH)*F04
if(denmax.gt.1.0D00) denmax=1.0D00
cutoff_denmax = cutoff/denmax

  NQUARTS=niijj
   call gpu_mpi_slice_nshell(nproc,NQUARTS,me,nshell_start_, nshell_end_)

  LPOPI=64; LPOPJ=16; LPOPK= 4; LPOPL= 1;

!$omp target teams distribute parallel do simd collapse(2) &
!$omp num_teams(nteams) thread_limit(limitthread)  &
!$omp private(i_tmp,iijjkkll,iijj_tmp,kkll_tmp) &
!$omp private(iijj,kkll,ii_TMP,jj_TMP,kk_TMP,ll_TMP) &
!$omp private(ii,jj,kk,ll) &
!$omp shared(I_S_SHL) &
!$omp shared(xintBJ01) private(IQUART) &
!$omp shared(nbraJ01) &
!$omp shared(IA,DA) &
!$omp shared(CO,KTYPE,KLOC,KMIN,KMAX,KSTART,KNG,EX,CS,CP) &
!$omp shared(RFINC,FGRID,XGRID,RMR,CMAX) &
!$omp shared(FA) &
!$omp private(gpople) 

   DO iijj_tmp=nshell_start_, nshell_end_
   DO kkll_tmp=1,niijj
    if(kkll_tmp.gt.iijj_tmp) cycle
      !if(xintBJ01(iijj_TMP)*xintBJ01(kkll_TMP) .lt. cutoff_denmax) cycle

   iijj = nbraJ01(iijj_tmp)-1
   kkll = nbraJ01(kkll_tmp)-1

   ii_TMP = (1 + sqrt(one+eight*iijj))/2
   jj_TMP = iijj - ii_TMP*(ii_TMP-1)/2 + 1

   kk_TMP = (1 + sqrt(one+eight*kkll))/2
   ll_TMP = kkll - kk_TMP*(kk_TMP-1)/2 + 1

   ii = I_S_SHL(ii_TMP)
   jj = I_S_SHL(jj_TMP)
   kk = I_S_SHL(kk_TMP)
   ll = I_S_SHL(ll_TMP)   
      
      call GPU_GENR70_jtype1(QQ4,II,JJ,KK,LL,CO,KSTART,KNG,&
      EX,CS,CMAX,RFINC,FGRID,gpople,EI1,EI2,CUX,RXINC,TMAX)

 call GPU_GENR70_dirfck_tdhf_APB(IA,DA,FA,NXYZ,II,JJ,KK,LL,ONE,ONE,&
 CUTOFF,KLOC,KMIN,KMAX,L1,L2,LPOPI,LPOPJ,LPOPK,LPOPL,GPOPLE)

      
    END DO 
    END DO 
!$omp end target teams distribute parallel do simd  

  return
    end
  SUBROUTINE gpu_tdhf_apb_j02_PSSS(l1,l2,ia,da,FA,cutoff, &
       len1,len2,len3,len4,nintn,qq4,DSH,NSH2,nteams,limitthread,cmax,nxyz,& 
    CO,RFINC,FGRID,XGRID,RMR,KTYPE,KLOC,KMIN,KMAX,KSTART,KNG,EX,CS,CP) 

      use comm_NSHEL_sp, only: NSHELL
      USE comm_FMTTBL, only: RXINC,TMAX
      use comm_INTAC2, only: EI1,EI2,CUX
    USE omp_lib
    USE prec, ONLY: fp
    use mod_shell_index
    use mod_dirfck_tdhf_apb, only: GPU_GENR70_dirfck_tdhf_APB
      use mx_limits, only: mxgtot,mxgsh,mxg2,mxsh
      use mod_jtype2
 use mod_xint_scrn, only: nij02, nbraJ02, xintBJ02, &
     nkl02, nketJ02,xintKJ02
  implicit none

    double precision, parameter :: one=1.00D+00, zero=0.00D+00, HALF=0.5D+00,&
    memMB=1024*1024, F04=4.00D+00, eight=8.00D+00

    COMMON /par   / me,master,nproc,ibtyp,iptim,goparr,dskwrk,maswrk
        INTEGER :: me,master,nproc,ibtyp,iptim
        LOGICAL :: dskwrk, maswrk, goparr


    INTEGER, INTENT(IN) :: l1,l2,nsh2,nxyz,len1,len2,len3,len4,ia(l1)
    INTEGER, INTENT(IN) :: nteams,limitthread
    double precision, INTENT(IN) :: cutoff, cmax(mxgtot),dsh(nsh2)
    double precision, INTENT(IN) :: da(l2*nxyz) 
    double precision, INTENT(INOUT) :: FA(l2*nxyz)
    integer, intent(inout) :: NINTN
    double precision :: qq4

    double precision :: scutij,denmax,cutoff_denmax
    integer :: niijj,i_tmp,iijjkkll,iijj_tmp,kkll_tmp, &
    iijj,kkll,ii_TMP,jj_TMP,kk_TMP,ll_TMP,ii,jj,kk,ll, nkkll,NQUARTS

    integer :: NCHUNK,nshell_start_,nshell_end_
    double precision :: gpople(256)
    integer :: LPOPI,LPOPJ,LPOPK,LPOPL

    double precision, INTENT(IN) :: CO(MXSH,3)
  integer, parameter :: NTX=4, NPF=450, NGRD=7, NPX=1000, MXQT=16
  double precision, INTENT(IN) :: FGRID(0:NTX,0:NPF,0:NGRD)
  double precision, INTENT(IN) :: XGRID(0:NTX,0:NPX)
  double precision, INTENT(IN) :: RFINC(0:NGRD), RMR(MXQT)
  double precision, INTENT(IN) :: ex(mxgtot),cs(mxgtot),cp(mxgtot)
  integer, INTENT(IN) :: kstart(mxsh),ktype(mxsh),kng(mxsh),  &
                  kloc(mxsh),kmin(mxsh),kmax(mxsh)


denmax = maxval(DSH)*F04
if(denmax.gt.1.0D00) denmax=1.0D00
cutoff_denmax = cutoff/denmax

niijj=nij02
  NQUARTS=niijj
   call gpu_mpi_slice_nshell(nproc,NQUARTS,me,nshell_start_, nshell_end_)

  LPOPI=64; LPOPJ=16; LPOPK= 4; LPOPL= 1;
 
!$omp target teams distribute parallel do simd  collapse(2) &
!$omp num_teams(nteams) thread_limit(limitthread)  &
!$omp private(i_tmp,iijjkkll,iijj_tmp,kkll_tmp) &
!$omp private(iijj,kkll,ii_TMP,jj_TMP,kk_TMP,ll_TMP) &
!$omp private(ii,jj,kk,ll) &
!$omp shared(I_S_SHL,I_P_SHL) &
!$omp shared(NBRAJ02,NKETJ02) &
!$omp shared(IA,DA,CUTOFF) &
!$omp shared(CO,KTYPE,KLOC,KMIN,KMAX,KSTART,KNG,EX,CS,CP) &
!$omp shared(RFINC,FGRID,XGRID,RMR,CMAX) &
!$omp shared(FA) &
!$omp private(gpople) 
   DO iijj_tmp=nshell_start_, nshell_end_
   DO kkll_tmp=1,nkl02

   iijj = NBRAJ02(iijj_tmp)-1
   kkll = NKETJ02(kkll_tmp)-1

   ii_TMP = (1 + sqrt(1.0+8.0*iijj))/2
   jj_TMP = iijj - ii_TMP*(ii_TMP-1)/2 + 1

   ll_TMP = mod(kkll,N_P_SHL) + 1
   kk_TMP = kkll/N_P_SHL + 1

   ii = I_S_SHL(ii_TMP)
   jj = I_S_SHL(jj_TMP)
   kk = I_S_SHL(kk_TMP)
   ll = I_P_SHL(ll_TMP)

      call GPU_GENR70_jtype2(QQ4,II,JJ,KK,LL,CO,KSTART,KNG,&
      EX,CS,CP,CMAX,RFINC,FGRID,XGRID,gpople,EI1,EI2,CUX,RXINC,TMAX)

 call GPU_GENR70_dirfck_tdhf_APB(IA,DA,FA,NXYZ,II,JJ,KK,LL,ONE,ONE,&
 CUTOFF,KLOC,KMIN,KMAX,L1,L2,LPOPI,LPOPJ,LPOPK,LPOPL,GPOPLE)

    END DO 
    END DO 
!$omp end target teams distribute parallel do simd  

  return
    end
