!module constants
!    IMPLICIT NONE
!    double precision, parameter :: ZERO = 0.0D+00
!    double precision, parameter :: HALF = 0.5D+00
!    double precision, parameter :: ONE = 1.0D+00
!    double precision, parameter :: TWO = 2.0D+00
!    double precision, parameter :: THREE = 3.0D+00
!    double precision, parameter :: FOUR = 4.0D+00
!    double precision, parameter :: PI = FOUR*ATAN(ONE)
!    double precision, parameter :: sqrt_PI = SQRT(PI)
!! Below is the constant values used in int2b.src. int2r.src
!    DOUBLE PRECISION, PARAMETER :: ZER=0.0D+00
!    DOUBLE PRECISION, PARAMETER :: PT5=0.5D+00
!    DOUBLE PRECISION, PARAMETER :: PT7=0.7D+00
!    DOUBLE PRECISION, PARAMETER :: PT9=0.9D+00
!    DOUBLE PRECISION, PARAMETER :: TEN=10.0D+00
!end module constants

!  MODULE params_SPD
!  IMPLICIT NONE
!   DOUBLE PRECISION, PARAMETER :: F02=2.0D+00
!   DOUBLE PRECISION, PARAMETER :: F03=3.0D+00
!   DOUBLE PRECISION, PARAMETER :: F04=4.0D+00
!   DOUBLE PRECISION, PARAMETER :: F05=5.0D+00
!   DOUBLE PRECISION, PARAMETER :: F06=6.0D+00
!   DOUBLE PRECISION, PARAMETER :: F07=7.0D+00
!   DOUBLE PRECISION, PARAMETER :: F10=1.0D+01
!   DOUBLE PRECISION, PARAMETER :: F15=1.5D+01
!   DOUBLE PRECISION, PARAMETER :: F21=2.1D+01
!   DOUBLE PRECISION, PARAMETER :: F28=2.8D+01
!   DOUBLE PRECISION, PARAMETER :: F210=2.1D+02
!   DOUBLE PRECISION, PARAMETER :: F420=4.2D+02
!
!   DOUBLE PRECISION, PARAMETER :: PI4=0.78539816339744831D+00
!!                PITO52=(PI +PI )*PI * SQRT(PI )
!   DOUBLE PRECISION, PARAMETER :: PITO52=34.986836655249726D+00
!   DOUBLE PRECISION, PARAMETER :: SQRT3=1.732050807568877D+00
!   DOUBLE PRECISION, PARAMETER :: ACYCUT=1.0D-10
!   DOUBLE PRECISION, PARAMETER :: TENM12=1.0D-12
!
!    double precision, parameter :: ZERO = 0.0D+00
!    double precision, parameter :: HALF = 0.5D+00
!    double precision, parameter :: ONE = 1.0D+00
!    double precision, parameter :: TWO = 2.0D+00
!    double precision, parameter :: THREE = 3.0D+00
!    double precision, parameter :: FOUR = 4.0D+00
!    double precision, parameter :: PI = FOUR*ATAN(ONE)
!    double precision, parameter :: sqrt_PI = SQRT(PI)
!! Below is the constant values used in int2b.src. int2r.src
!    DOUBLE PRECISION, PARAMETER :: ZER=0.0D+00
!    DOUBLE PRECISION, PARAMETER :: PT5=0.5D+00
!    DOUBLE PRECISION, PARAMETER :: PT7=0.7D+00
!    DOUBLE PRECISION, PARAMETER :: PT9=0.9D+00
!    DOUBLE PRECISION, PARAMETER :: TEN=10.0D+00
!  end MODULE params_SPD
