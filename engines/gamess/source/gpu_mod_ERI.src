  MODULE comm_INTAC2
  IMPLICIT NONE
  DOUBLE PRECISION :: EI1,EI2,CUX
  COMMON /INTAC2/ EI1,EI2,CUX
  !DOUBLE PRECISION, parameter :: EI1=   9.9999999999999990E-014
  !DOUBLE PRECISION, parameter ::  EI2=  1.0000000000000001E-015
  !DOUBLE PRECISION, parameter ::  CUX=  57.564499999999995
  end MODULE comm_INTAC2

  MODULE comm_NSHEL_sp
  use mx_limits, only: mxgtot,mxsh
  USE prec, ONLY: fp
  IMPLICIT NONE
  COMMON /NSHEL / ex(mxgtot),cs(mxgtot),cp(mxgtot),cd(mxgtot),     &
                  cf(mxgtot),cg(mxgtot),ch(mxgtot),ci(mxgtot),     &
                  kstart(mxsh),katom(mxsh),ktype(mxsh),kng(mxsh),  &
                  kloc(mxsh),kmin(mxsh),kmax(mxsh),nshell
  INTEGER :: kstart,katom,ktype,kng,kloc,kmin,kmax,nshell
  REAL(KIND=fp) :: ex,cs,cp,cd,cf,cg,ch,ci
  END MODULE comm_NSHEL_sp

  MODULE comm_FMTTBL
  IMPLICIT NONE
  integer, parameter :: NTX=4, NPF=450, NGRD=7, NPX=1000, MXQT=16
  integer :: NORD
  double precision :: RXINC
  double precision :: TMAX 
  double precision :: FGRID(0:NTX,0:NPF,0:NGRD)
  double precision :: XGRID(0:NTX,0:NPX)
  double precision :: RFINC(0:NGRD), RMR(MXQT),TLGM(0:MXQT)
  COMMON /FMTTBL/ FGRID,XGRID,TMAX,RFINC,RXINC,RMR,TLGM,NORD
  end MODULE comm_FMTTBL

  MODULE DATA_IDPOP
  IMPLICIT NONE
      INTEGER :: IDPOP(4,10)
      DATA IDPOP/0,0,0,0,216,36,6,1,432,72,12,2,648,108,18,3,&
                 0,0,0,0,216,36,6,1,432,72,12,2,648,108,18,3,&
                 864,144,24,4,1080,180,30,5/
  END MODULE DATA_IDPOP

  MODULE DATAgenr_SP
  IMPLICIT NONE
! data for DPPS, DSPP, DPPP, DDPP cases
  integer, dimension(4,4) :: INS, INI
  DATA INS/ 0, 0, 0, 1,  0, 0, 0, 1,  0, 0, 1, 2,  1, 1, 2, 3/
  DATA INI/ 0, 0, 1, 1,  0, 0, 1, 1,  1, 1, 2, 2,  1, 1, 2, 2/
  end MODULE DATAgenr_SP

  MODULE DATAgenr_SPD
  IMPLICIT NONE
  integer, dimension(6,4) :: INS, INI
! data for DSDS, DPDS, DDDS, DPDP, DDDP cases
      DATA INS/ 0, 1, 3, 0, 1, 2,  0, 1, 3, 0, 1, 2,  0, 3, 5, 1, 2, 4,&
                1, 4, 6, 2, 3, 5/
      DATA INI/ 0, 2, 2, 1, 1, 2,  0, 2, 2, 1, 1, 2,  1, 3, 3, 2, 2, 3,&
                1, 3, 3, 2, 2, 3/
  end MODULE DATAgenr_SPD

  MODULE DATAgenr_DD
  IMPLICIT NONE
! data for DDDD case
  integer, dimension(6,6) :: INS, INI
      DATA INS/ 0, 1, 3, 0, 1, 2,  1, 6, 8, 3, 4, 7,  3, 8,10, 5, 6, 9,&
                0, 3, 5, 1, 2, 4,  1, 4, 6, 2, 3, 5,  2, 7, 9, 4, 5, 8/
      DATA INI/ 0, 2, 2, 1, 1, 2,  2, 4, 4, 3, 3, 4,  2, 4, 4, 3, 3, 4,&
                1, 3, 3, 2, 2, 3,  1, 3, 3, 2, 2, 3,  2, 4, 4, 3, 3, 4/
  end MODULE DATAgenr_DD

  MODULE DATAgenr_SPDD
  IMPLICIT NONE
  integer, dimension(10,10) :: INS, INI
  data ins/0, 0, 0, 1, 0, 1,  3, 0, 1, 2, &
           0, 0, 0, 1, 0, 1,  3, 0, 1, 2, &
           0, 0, 1, 2, 0, 3,  5, 1, 2, 4, &
           1, 1, 2, 3, 1, 4,  6, 2, 3, 5, &
           0, 0, 0, 1, 0, 1,  3, 0, 1, 2, &
           1, 1, 3, 4, 1, 6,  8, 3, 4, 7, &
           3, 3, 5, 6, 3, 8, 10, 5, 6, 9, &
           0, 0, 1, 2, 0, 3,  5, 1, 2, 4, &
           1, 1, 2, 3, 1, 4,  6, 2, 3, 5, &
           2, 2, 4, 5, 2, 7,  9, 4, 5, 8 / 
  data ini/0, 0, 1, 1, 0, 2, 2, 1, 1, 2, & 
           0, 0, 1, 1, 0, 2, 2, 1, 1, 2, & 
           1, 1, 2, 2, 1, 3, 3, 2, 2, 3, & 
           1, 1, 2, 2, 1, 3, 3, 2, 2, 3, & 
           0, 0, 1, 1, 0, 2, 2, 1, 1, 2, & 
           2, 2, 3, 3, 2, 4, 4, 3, 3, 4, & 
           2, 2, 3, 3, 2, 4, 4, 3, 3, 4, & 
           1, 1, 2, 2, 1, 3, 3, 2, 2, 3, & 
           1, 1, 2, 2, 1, 3, 3, 2, 2, 3, & 
           2, 2, 3, 3, 2, 4, 4, 3, 3, 4/  
  END MODULE DATAgenr_SPDD

