   set NEOOBJ="$NEOOBJ neosym.o neotrn.o neovib.o neoepc.o"
   set NEOOBJ="$NEOOBJ neogradient.o neodft.o"
   echo "   Nuclear Electron Orbital object files are $NEOOBJ"
else
   set NEOOBJ='neostb.o'
   echo "   Nuclear Electron Orbital code skipped, using dummy file $NEOOBJ"
endif
#
if ($RISM == true) then
   set RSMOBJ=" rsm_mod.o rsm_fftdrv.o rsm_ios.o rsm_main.o rsm_lninp.o"
   set RSMOBJ="$RSMOBJ rsm_uninp.o rsm_rsmutl.o rsm_sddutl.o rsm_cprsm.o"
   set RSMOBJ="$RSMOBJ rsm_sddint.o rsm_gms_main.o rsm_gms_cc.o rsm_gms_cphf.o"
   set RSMOBJ="$RSMOBJ rsm_gms_nmr.o rsm_gms_ci.o rsm_gms_getdat.o rsm_gms_mcscf.o"
   set RSMOBJ="$RSMOBJ rsm_gms_td.o rsm_gms_conicl.o rsm_gms_gmspar.o"
   set RSMOBJ="$RSMOBJ rsm_gms_mp2.o"
   echo "   RISM files are $RSMOBJ"
