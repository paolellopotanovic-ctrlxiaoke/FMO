echo " "
echo $STANDARD_GAMESS_OBJ1
echo $STANDARD_GAMESS_OBJ2
echo $STANDARD_GAMESS_OBJ3
echo $STANDARD_GAMESS_OBJ4
echo $OPENMP_GAMESS_OBJ
echo $OPENMP_OFFLOAD_GAMESS_OBJ
echo $LIBXC
echo $LIBXC_FLAGS
echo $MDI
echo $MDI_FLAGS
#
echo " "
echo "Choices for some optional plug-in codes are"
