   set RSMOBJ="rsmstop.o"
   echo "   RISM-SCF-cSED code skipped, using dummy file $RSMOBJ"
endif
#   Writing out numpy arrays
set NPY_OBJ=''
if ($?NPY) then
   if ($NPY == true) set NPY_OBJ='npy.o'
endif
#

if ($HPCCHEM == true) then 
if ("$GMS_HPCCHEM_CUDA" == "true" ) then
 set GMS_HPCCHEM_MAGMA = false
endif 
set HPCCHEM_LIBS="-L$GMS_HPCCHEM_PATH/lib -lhpcchem"

if ("$GMS_HPCCHEM_CUDA" == "true" ) then
echo "   Using HPCCHEM add-in C++ code for Nvidia/CUDA GPUs."
   set HPCCHEM_LIBS="$HPCCHEM_LIBS -lz"
   set HPCCHEM_LIBS="$HPCCHEM_LIBS -lstdc++"
   set HPCCHEM_LIBS="$HPCCHEM_LIBS -L$GMS_HPC_CUDA_PATH/lib64 -lcudart -lcublas -lcudadevrt -lcusparse -lcusolver"
else if ("$GMS_HPCCHEM_CUDA" == "false" && "$GMS_HPCCHEM_MAGMA" == "false") then 
echo "   Using HPCCHEM add-in C++ code for AMD GPUs."
set HPCCHEM_LIBS="$HPCCHEM_LIBS -lz"
set HPCCHEM_LIBS="$HPCCHEM_LIBS -lstdc++"
set HPCCHEM_LIBS="$HPCCHEM_LIBS -L$GMS_HPC_ROCM_PATH/lib -lhipsolver -lhipsparse -lhipblas -lrocsolver -lrocsparse -lrocblas "
else if ("$GMS_HPCCHEM_CUDA" == "false" && "$GMS_HPCCHEM_MAGMA" == "true") then 
echo "Using hpcchem amd gpus + magma"
set HPCCHEM_LIBS="$HPCCHEM_LIBS -lz"
set HPCCHEM_LIBS="$HPCCHEM_LIBS -lstdc++"
set HPCCHEM_LIBS="$HPCCHEM_LIBS -L$GMS_HPC_ROCM_PATH/lib -lhipsolver -lhipsparse -lhipblas -lrocsolver -lrocsparse -lrocblas "
set HPCCHEM_LIBS="$HPCCHEM_LIBS -L$GMS_HPC_ROCM_PATH -lrccl -lamdhip64"
set HPCCHEM_LIBS="$HPCCHEM_LIBS -L$GMS_HPC_MAGMA_PATH/lib -lmagma "
else 
set HPCCHEM_LIBS=""
endif 
else
set HPCCHEM_LIBS=""
endif 
#
#   NBO is turned off with nbostb.o dummy substitute in GAMESS distribution.
if ($NBO == true) then
   set NBOOBJ=$NBOLIB
   echo "   Natural Bond Orbital (NBO) code is taken from library"
   echo "        $NBOOBJ"
else
   set NBOOBJ='nbostb.o'
   echo "   Natural Bond Orbital (NBO) code skipped, using dummy file $NBOOBJ"
endif
#
#   MPQC is turned off with mpqcst.o dummy substitute in GAMESS distribution.
if ($MPQC == true) then
   # Make sure MPQC and LIBINT are present in $GMS_BUILD_DIR
   if !(-e $GMS_BUILD_DIR/mpqc/lib/libmpqcinit.a || \
        -e $GMS_BUILD_DIR/libint-gamess/lib/libint1.a) then
      echo "   ERROR! MPQC AND/OR LIBINT COULD NOT BE FOUND IN THE GAMESS BUILD DIRECTORY: $GMS_BUILD_DIR/" >> /dev/stderr
      exit
   endif
   # prepend path to MPQC libraries
   set MPQCLIBS = "$GMS_BUILD_DIR/mpqc/src/bin/pt2r12/libpt2r12gamess.a"
   foreach LIB_NAME (libmpqcinit.a libSCmbptr12.a libSClmp2.a libSClibint2.a \
                     libSCmbpt.a libSCscf.a libSClcao.a libSCdistarray4.a \
                     libSCwfn.a libSCmmisc.a libSCintv3.a libSCbasis.a \
                     libSCoint3.a libSCmolecule.a libSCisosurf.a libSCsymmetry.a \
                     libSCrender.a libSCoptimize.a libSCscmat.a libSCgroup.a \
                     libSCmisc.a libSCstate.a libSCkeyval.a libSCclass.a \
                     libSCcontainer.a libSCref.a libSCoptions.a)
      set MPQCLIBS = "$MPQCLIBS $GMS_BUILD_DIR/mpqc/lib/$LIB_NAME"
   end
   #LIBINT libraries
   set LIBINT = "-L$GMS_BUILD_DIR/libint/lib -lint2 -lm -ldl"
   #LIBRARIES
   switch ($GMS_MATHLIB)
      case mkl:
         set LIBRARIES = "-Wl,--start-group $LIBRARIES -Wl,--end-group -lstdc++"
         breaksw
      case acml:
         set LIBRARIES="$GMS_MATHLIB_PATH/libacml.a -lm -lstdc++"
         breaksw
      case atlas-so:
      case atlas:
         set LIBRARIES = "$LIBRARIES  -llapack -lstdc++"
         breaksw
      case none:
         echo 'system math library is required' >> /dev/stderr
         exit 4
         breaksw
   endsw
   # The system math libraries must contain LAPACK: remove GAMESS LAPACK
   set LAPACK=''
   set MPQCOBJ=''
   echo "   MPQC libraries are $MPQCLIBS"
   echo "   LIBINT2 libraries are $LIBINT"
else
   set MPQCOBJ='mpqcst.o'
   set MPQCLIBS=''
   set LIBINT=''
   echo "   MPQC code skipped, using dummy file $MPQCOBJ"
endif
#
#   VM2 is turned off with vm2_stub.o dummy substitute in GAMESS distribution.
if ($GMS_VM2 == true) then
   set VM2OBJ=$VM2LIB
   echo "   VeraChem's VM2 package is taken from library"
   echo "        $VM2OBJ"
else
   set VM2OBJ='vm2_stub.o'
   echo "   VM2 code skipped, using dummy file $VM2OBJ"
endif
#
echo " "
echo "   The message passing libraries searched are"
echo $MSG_LIBRARIES
echo " "
echo "   Other libraries, including math libraries, to be searched are"
echo $LIBRARIES
echo $LAPACK
echo " "
#
#    Optional user specified additional libraries and/or object files:
#
if ($?GMS_EXTRA_OBJS) then
   echo "   User specified libraries and/or object files:"
   echo "$GMS_EXTRA_OBJS"
else
   set GMS_EXTRA_OBJS=''
endif

#
#   link GAMESS, using objects/library information as collected above
#   =================================================================
#   Insert a "set echo" line to see the full link command in the log file,
#   which may result in too long a line to display for some vi/c-shells.
#   Hence it has been printed out piecemeal, but in order, just above.
#
echo "Linker messages (if any) follow..."
if ($GMS_TARGET == win64) then
   if ($GMS_FORTRAN == ifort || $GMS_FORTRAN == oneapi-ifort || $GMS_FORTRAN == oneapi-ifx) then
      set GMS_BUILD_DIR=`cygpath -d "$GMS_BUILD_DIR"`
   endif
endif
chdir $GMS_BUILD_DIR/object
#
# older versions of rocm might need this! 
if ($GMS_HPC_SYSTEM_TARGET == crusher && $GMS_HPCCHEM == true && $GMS_OPENMP_OFFLOAD == false) then 
set LDR = CC
endif 
set echo
$LDR  $EXTRA_LINK_FLAGS:q -o $GMS_BUILD_DIR/$EXE.$VERNO.x $LDOPTS \
      $GMS_DEBUG_LINK_FLAGS \
      -I$GMS_BUILD_DIR/object \
      gamess.o gamess_version.o unport.o util.o \
      $STANDARD_GAMESS_OBJ1 \
      $STANDARD_GAMESS_OBJ2 \
      $STANDARD_GAMESS_OBJ3 \
      $STANDARD_GAMESS_OBJ4 \
      $LIBXC \
      $MDI \
      $QMMMOBJ $VBOBJ $NEOOBJ $NBOOBJ $RSMOBJ \
      $NPY_OBJ $VM2OBJ \
      $GMS_EXTRA_OBJS \
      $HPCCHEM_GAMESS_OBJ \
      $HPCCHEM_LIBS \
      $OPENMP_GAMESS_OBJ \
      $OPENMP_OFFLOAD_GAMESS_OBJ \
      $MPQCOBJ $MPQCLIBS $LIBINT \
      $LIBRARIES $LAPACK $MATHLIBS $MSG_LIBRARIES \
      $LIBXC_FLAGS \
      $MDI_FLAGS
#
set rc=$status
#
#   give the installer a simple thumbs up or down on success
#
unset echo
chdir ..
if ((-x $EXE.$VERNO.x) && ($rc == 0)) then
   echo " "
   echo The linking of GAMESS to binary $EXE.$VERNO.x was successful.
   set rc=0
else
   echo " "
   echo Unfortunately, there was an error while linking GAMESS.
   set rc=1
   if ($LAPACK_WARNING == true) then
      echo "*******************************************************"
      echo "*                      N O T I C E                    *"
      echo "*******************************************************"
      echo ""
      echo "GAMESS now requires a LAPACK library for compilation."
      echo "Your math library may already provide this library."
      echo "However, if you receive an error during linking about"
      echo "undefined references to dsygst and dspev then you"
      echo "will need to link to a LAPACK library."
      echo ""
      echo "You can try compiling the Netlib LAPACK library from"
      echo "scratch by one of the following two options below:"
      echo ""
      echo " 1. (Requires CMake)"
      echo ""
      echo "       ./tools/lapack/download-lapack.csh"
      echo "       make -j lapack"
      echo ""
      echo " 2. (Does not require CMake)"
      echo ""
      echo "       make -j lapack USE_CMAKE=false"
      echo ""
      echo "Or provide a valid GMS_LAPACK_LINK_LINE in install.info"
      echo "to an installation of LAPACK (compiled with 8-byte integer)"
      echo "already on your 64-bit system."
      echo ""
      echo "For example:"
      echo ""
      echo 'setenv GMS_LAPACK_LINK_LINE "-L/path/to/lapack/library -llapack"'
      echo ""
      echo "You do not need to specify GMS_LAPACK_LINK_LINE if you"
      echo "decide to do option 1. or 2."
      echo "*******************************************************"
   endif
endif
time
exit $rc
