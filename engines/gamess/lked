#!/bin/tcsh -f
#
#  5 Dec 2014 - script to "link-edit" a GAMESS executable
#
#  Invoke this job by 'lked EXE VERNO >& lked.log &'
#    EXE is normally 'gamess',
#    VERNO is the next version number, e.g. 01, 02, 03, ...
#    This produces executable "EXE.VERNO.x", e.g. gamess.01.x
#
#  Please send your issues to the GAMESS public
#  issue tracker on GitHub:
#  https://github.com/gms-bbg/gamess-issues/issues
#
unset echo
if (-e install.info) then
   source install.info
else
   echo "Please run 'config' first, to set up GAMESS compiling information" >> /dev/stderr
   exit 4
endif
#
#  Allow debug flags during linking
#
if ($?GMS_DEBUG_LINK_FLAGS == 0) then
   set GMS_DEBUG_LINK_FLAGS=''
endif
#
if (($GMS_HPC_SYSTEM_TARGET == crusher || $GMS_HPC_SYSTEM_TARGET == frontier ) && ($GMS_HPCCHEM == true)) then
   # older versions of rocm migth need this!
   #set EXTRA_LINK_FLAGS="--rocm-path=$GMS_HPC_ROCM_PATH --hip-link "
   set GMS_HPCCHEM_CUDA=false
   set EXTRA_LINK_FLAGS=''
else
   set EXTRA_LINK_FLAGS=''
endif
#
set EXTRA_MPI_LIB_FLAGS=''
#
#  the configuration file read just above provides the next two variables,
#  and some others that are used below.
#
set TARGET=$GMS_TARGET
set MATHLIBS=''
chdir $GMS_BUILD_DIR
#
if (!($?GMS_BG_MODEL)) set GMS_BG_MODEL=' '
#
#    ---- and now the script begins...
#
set FAILED=0
set EXE=$1
set VERNO=$2
if (null$EXE == null) set EXE=gamess
if (null$VERNO == null) set VERNO=00
date
#
echo GAMESS will be linked into the binary file $EXE.$VERNO.x.
#
#  Optional Valence Bond method, using VB2000 code --or-- XMVB code
#
if ($GMS_PHI != none) set VB2000=false
if ($GMS_OPENMP == true) set VB2000=false
#
#   Optional C++ code, running on CPUs, and possibly Nvidia/CUDA GPUs
#         see ~/gamess/libcchem/aaa.readme.1st for more information
#

if ( $GMS_HPCCHEM == false) then 
  set HPCCHEM=false
else 
  set HPCCHEM=$GMS_HPCCHEM
  #set EXE=gamess.hpc
endif
#
#   Optional MPQC interface
#
set MPQC=false
#   Optional interface to VeraChem's VM2 package
#
#   choose compiler and math library options for each system
#   ========================================================
#   these consist of
#       LDR       - the name of the loader (usually a compiler).
#       LDOPTS    - options, such as asking for a load map.
#       LIBRARIES - extra system libraries which must be searched.
#       LAPACK    - default: set to '${GMS_PATH}/3rd-party/lib/liblapack64.a'
#                 - set to blank to take LAPACK from a math lib
#   In principle, the 'config' step has captured enough information
#   about library locations that no user need change anything below.
#
set LAPACK_WARNING=false
if (($GMS_MATHLIB == none) && (-f $GMS_PATH/3rd-party/lib/liblapack64.a)) then
   set GMS_LAPACK_LINK_LINE="$GMS_PATH/3rd-party/lib/liblapack64.a"
else if  (($GMS_MATHLIB == essl) && (-f $GMS_PATH/3rd-party/lib/liblapack64.a)) then
   set GMS_LAPACK_LINK_LINE="$GMS_PATH/3rd-party/lib/liblapack64.a"
else if  (($GMS_MATHLIB == LibSci) && (-f $GMS_PATH/3rd-party/lib/liblapack64.a)) then
   set GMS_LAPACK_LINK_LINE="$GMS_PATH/3rd-party/lib/liblapack64.a"
else
   set LAPACK_WARNING=true
endif
#
set LAPACK="${GMS_LAPACK_LINK_LINE}"
#
#   HPE Cray Series:
#
if ($TARGET =~ hpe-*) then
   # If your load a PrgEnv-(aocc,cray,gnu,intel-nvidia) the LDR (Loader) will
   # be 'ftn'. However, we also account for situations where the user
   # what want to unload a PrgEnv and load a compiler directly. In those
   # situations we specify the LDR explicitly.
   set LDR = $GMS_FORTRAN

   if ( $?CRAY_FTN_VERSION ) then
      set GMS_HPE_CRAY_COMP = cray
   endif

   if ( $?INTEL_VERSION ) then
      set GMS_HPE_CRAY_COMP = intel
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "INTEL") set LDR = ifort
      endif
   endif

   if ( $?GNU_VERSION ) then
      set GMS_HPE_CRAY_COMP = gnu
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "GNU") set LDR = gfortran
      endif
   endif

   if ( $?NVIDIA_VERSION ) then
      set GMS_HPE_CRAY_COMP = nvidia
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "NVIDIA") set LDR = nvfortran
      endif
   endif

   if ( $?AOCC_VERSION ) then
      set GMS_HPE_CRAY_COMP = aocc
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "AOCC") set LD = flang
      endif
   endif

   if ( $?CRAY_AMD_COMPILER_VERSION ) then
      set GMS_HPE_CRAY_COMP = rocm
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "AMD") set FC = amdflang
      endif
   endif

   # Previous Cray platforms there has been a need to also take into
   # account the CPU target. We have found that $CRAY_CPU_TARGET is
   # typically available when a PrgEnv is loaded. However, $CPU seems
   # to always be avilable.
   if  ( $?CRAY_CPU_TARGET ) then
      set GMS_HPE_CRAY_ARCH = $CRAY_CPU_TARGET
   else
      set GMS_HPE_CRAY_ARCH = $CPU
   endif

   # Placeholder in case we need to handle things differently based on the compiler
   switch ($GMS_HPE_CRAY_COMP)
      case gnu:
         set LDOPTS='-m64'
         if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -lgomp"
         breaksw
      case intel:
         set LDOPTS='-i8'
         if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -qopenmp"
         breaksw
      case cray:
         set LDOPTS='-s default64'
         if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -lcraymp"
         breaksw
      case nvidia:
         set LDOPTS='-i8 -m64 -mcmodel=medium'
         if ($GMS_OPENMP_OFFLOAD == true) then
            set LDOPTS="$LDOPTS -mp=gpu -gpu=cc80,lineinfo -Minfo=mp,accel"
            set LDOPTS="$LDOPTS -g -traceback"
         else if ($GMS_OPENMP == true) then
            set LDOPTS="$LDOPTS -mp -Minfo=mp"
         endif
         if ($GMS_MPI_LIB != craycs) set LDOPTS="$LDOPTS -lgfortran"
         breaksw
      case rocm:
         set LDOPTS='-m64 -fdefault-integer-8'
         if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -fopenmp"
         breaksw
      default:
         breaksw
   endsw

   # Placeholder in case we need to handle things differently based on the CPU architecture
   switch ($GMS_HPE_CRAY_ARCH)
      case x86-rome:
      case x86_64:
      default:
         set LDOPTS = "$LDOPTS"
         breaksw
   endsw

   # Linking Cray's math library
   if ($GMS_HPC_SYSTEM_TARGET == perlmutter) then
      if ($GMS_OPENMP == true) then
         set MATHLIBS="-L$GMS_MATHLIB_PATH/lib -lsci_${GMS_HPE_CRAY_COMP}_mp"
      else
         set MATHLIBS="-L$GMS_MATHLIB_PATH/lib -lsci_${GMS_HPE_CRAY_COMP}"
      endif
   else
      set MATHLIBS=""
   endif

   # Linking message passing libraries
   if ( $?CRAY_MPICH_VERSION ) then
      echo "Linking Cray MPICH libraries"
      if ( "$CRAY_MPICH_PREFIX" =~ "$CRAY_MPICH_BASEDIR/amd"*    ) set MPILIBS="-L$CRAY_MPICH_PREFIX/lib -lmpi"
      if ( "$CRAY_MPICH_PREFIX" =~ "$CRAY_MPICH_BASEDIR/aocc"*   ) set MPILIBS="-L$CRAY_MPICH_PREFIX/lib -lmpi"
      if ( "$CRAY_MPICH_PREFIX" =~ "$CRAY_MPICH_BASEDIR/nvidia"* ) set MPILIBS="-L$CRAY_MPICH_PREFIX/lib -lmpi"
      if ( "$CRAY_MPICH_PREFIX" =~ "$CRAY_MPICH_BASEDIR/gnu"*    ) set MPILIBS="-L$CRAY_MPICH_PREFIX/lib -lmpi"
      if ( "$CRAY_MPICH_PREFIX" =~ "$CRAY_MPICH_BASEDIR/intel"*  ) set MPILIBS="-L$CRAY_MPICH_PREFIX/lib -lmpi"
      if ( "$CRAY_MPICH_PREFIX" =~ "$CRAY_MPICH_BASEDIR/cray"*   ) set MPILIBS="-L$CRAY_MPICH_PREFIX/lib -lmpi"
   else if ( $?MPT_VERSION ) then
      echo "Linking SGI MPT libraries"
      set MPILIBS="-L$MPI_ROOT/lib -lmpi"
   else if ( $?I_MPI_ROOT ) then
      echo "Linking Intel MPI libraries"
      set MPILIBS="-L$I_MPI_ROOT/lib"
      set MPILIBS="$MPILIBS -lmpifort -lrt"
      set MPILIBS="$MPILIBS -L$I_MPI_ROOT/lib/release"
      set MPILIBS="$MPILIBS -lmpi"
   endif

   # TODO: Linking other math libraries instead of using Cray's math library

   set LIBRARIES="$MATHLIBS $MPILIBS"

   if ($GMS_USE_HIPFORT == true) then
      set ARCH=amdgcn
      set LIBRARIES="${HIPFORT_HOME}/lib/libhipfort-${ARCH}.a -L${ROCM_PATH}/lib -lhipblas -lamdhip64 -Wl,-rpath=${ROCM_PATH}/lib ${LIBRARIES}"
   endif

   if ($USE_CUBLAS == true) then
      if ($GMS_HPC_SYSTEM_TARGET == polaris) then
         set LIBRARIES="-cudalib=cublas,cusolver ${LIBRARIES}"
      else
         set LIBRARIES="-L$CUDA_HOME/lib64 -cudalib=cublas,cusolver ${LIBRARIES}"
      endif
   endif
endif

#
# Cray XT
#
if ($TARGET == cray-xt) then
   #         this will be set to 'ftn' by the configuration step
   set LDR=$GMS_FORTRAN

   #         two choices not included in the configuration step
   #         These must match 'comp' and 'compddi', and loaded software modules.
   #            valid choices: intel, cray, pgi
   set GMS_XT_COMP = 'pgi'
   #            valid choices: i7, barcelona, shanghai, or blank
   set GMS_XT_ARCH = ' '

   set LDOPTS='-default64'

   switch ($GMS_XT_COMP)
      case pgi:
         set LDOPTS="$LDOPTS -i8 -mcmodel=medium"
         breaksw
      case intel:
      case cray:
      default:
         breaksw
   endsw

   switch ($GMS_XT_ARCH)
      case barcelona:
         set LDOPTS = "$LDOPTS -tp barcelona-64 -Mfpmisalign"
         breaksw
      case shanghai:
         set LDOPTS = "$LDOPTS -tp shanghai-64 -Mfpmisalign"
         breaksw
      case i7:
         set LDOPTS = "$LDOPTS -tp x64"
         breaksw
      default:
         set LDOPTS = "$LDOPTS"
         breaksw
   endsw
   set LIBRARIES="-L/cray/iss/park_bench/lib -lfpmpi64-cnl"
   set LIBRARIES=" "
   set LIBRARIES="$LIBRARIES -lhugetlbfs"
   #
   # ------------------------ -lfast_mv ------------------------------
   # use -lfast_mv for faster evaluation of the exponential function.
   # -lfast_mv must come after the objects, yet before -lm or -lacml
   # performance improvement will vary.
   # not used by default, since it is so far a non-standard module.
   # ------------------------ -lfast_mv ------------------------------
   #
endif
#
#   Various IBM sections follow.
#   To see length of common blocks and subroutine sizes,
#     add "-Wl,-bmap:../lked.sizes" to LDOPTS.
#   The following will pick out the huge common blocks:
#          a) grep -i " cm " lked.sizes >& filtered
#          b) vi filtered
#             :%s/^/ /
#             :wq     (pushes subroutine names above column72)
#          c) strip72   (Mike's program on Si.FI)
#               input=filtered
#               output=stripped
#          d) vi stripped
#             :%s/^     //
#             :wq    (no blanks in column 1)
#          e) sort +1 -d stripped >& sorted
#          f) keep only the end of 'sorted'
#
#   To avoid use of dynamic link libraries, if xlfrte is absent,
#     add "-Wl,-bnso -Wl,-bI:/lib/syscalls.exp" to LDOPTS.
#
#   The fast math library from IBM is called ESSL:
#   1. Power2 has a different ESSL name, -lessl2, which we don't
#      any longer try to detect since few Power2 systems remain.
#   2. If you don't have ESSL, a fallback is to remove the 32 bit
#      wrapper hack in "comp" (search on DASUM), repeat compall,
#      and set BLAS to "libblas64.a" and LIBRARIES to blank below.
#
if ($TARGET == ibm64) then
   set LIBRARIES=""
   set MATHLIBS="-L$GMS_MATHLIB_PATH/lib64 -lessl6464"
   if ($GMS_OPENMP_OFFLOAD == true) then
      if ($GMS_USE_HIPFORT == true) then
         set MATHLIBS="${MATHLIBS}"
      else
         if ($GMS_FORTRAN == xlf) then
            set MATHLIBS="${MATHLIBS} -L${CUDA_DIR}/lib64/ -lcublas -lcusolver"
         endif
         if ($GMS_FORTRAN == nvfortran) then
            set MATHLIBS="${MATHLIBS} -L${CUDA_DIR}/lib64/ -cudalib=cublas,cusolver"
         endif
      endif
   endif
   if ($GMS_FORTRAN == xlf) then
      set LDR='xlf_r'
      if(`uname` == AIX) then
         set LDOPTS="-bbigtoc -q64 -Wl,-m -Wl,-bloadmap:$GMS_BUILD_DIR/lked.map"
      else
         set LDOPTS="-L$GMS_XL_PATH/xlsmp/5.1.1/lib -lxlsmp -lgfortran -g -q64 -lxlf90_r -qintsize=8"

      endif
      if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -qsmp=omp"
      if ($GMS_OPENMP_OFFLOAD == true) set LDOPTS="$LDOPTS -qoffload"
   else if ($GMS_FORTRAN == nvfortran) then
      set LDR="$GMS_FORTRAN"
      set LDOPTS=''
      set FORTLIBS=''
      if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -mp"
      if ($GMS_OPENMP_OFFLOAD == true) set LDOPTS="${LDOPTS} -fast -Minline -mp=gpu -DSETDEVICEID -Minfo=mp,accel -i8 -gpu=cc70"
   else if ($GMS_FORTRAN == gfortran) then
      set LDR='gfortran'
      set LDOPTS=''
      if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -fopenmp"
   else if (($GMS_FORTRAN == pgfortran) || ($GMS_FORTRAN == pgf77)) then
      set LDR="$GMS_FORTRAN"
      set LDOPTS='-g77libs'
      set FORTLIBS=''
   else
      echo "Un-addressed compiler option $GMS_FORTRAN under target $TARGET" >> /dev/stderr
      exit 1
   endif

   set MATHLIBS="$MATHLIBS -L$GMS_XL_PATH/xlf/16.1.1/lib/ -lxlf90_r -lxlfmath"
   # also adding in norm2 since XLF2008 doesn't support norm2 right now.
   if ($GMS_FORTRAN == xlf) then
      if ($GMS_OPENMP == true) then
         set MATHLIBS="$MATHLIBS norm2.o"
      endif
   endif
endif
#
# Cray XC
#
if ($TARGET == cray-xc) then
   if ($GMS_HPC_SYSTEM_TARGET == cori) then
      set FC = 'ftn'
      #
      if ( $?INTEL_VERSION ) then
         set GMS_HPE_CRAY_COMP = intel
         if ( $?PE_ENV ) then
            if ( $PE_ENV != "INTEL") set FC = ifort
         endif
      endif
      #
      if ( $?GNU_VERSION ) then
         set GMS_HPE_CRAY_COMP = gnu
         if ( $?PE_ENV ) then
            if ( $PE_ENV != "GNU") set FC = gfortran
         endif
      endif
      #
      if  ( $?CRAY_CPU_TARGET ) then
         set GMS_HPE_CRAY_ARCH = $CRAY_CPU_TARGET
      else
         set GMS_HPE_CRAY_ARCH = $CPU
      endif
      #
      set LDR=$FC
      set MATHLIBS=""
      set LDOPTS=""

      # Placeholder in case we need to handle things differently based on the compiler
      switch ($GMS_HPE_CRAY_COMP)
         case intel:
            if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -qopenmp"
            set LIBRARIES=' '
            set LDOPTS = "-i8 -mcmodel=medium $LDOPTS"
            breaksw
         case gnu:
            if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -lgomp"
            set LIBRARIES=' '
            set LDOPTS = "$LDOPTS"
            breaksw
         default:
            echo "Please spell your FORTRAN compiler name correctly." >> /dev/stderr
            exit 4
            breaksw
      endsw

      # Placeholder in case we need to handle things differently based on the CPU architecture
      switch ($GMS_HPE_CRAY_ARCH)
         case x86-rome:
         case x86_64:
         default:
            set LDOPTS = "$LDOPTS"
            breaksw
      endsw

      # Linking Cray's math library
      set MATHLIBS="-L$GMS_MATHLIB_PATH/lib -lsci_$GMS_HPE_CRAY_COMP"

      # Linking message passing libraries
      if ( $?CRAY_MPICH2_VER ) then
         echo "Linking Cray MPICH libraries"
         set MATHLIBS="$MATHLIBS -lsci_${GMS_HPE_CRAY_COMP}_mpi"
         set MPILIBS=""
         if ( "$CRAY_MPICH2_DIR" =~ "$CRAY_MPICH_BASEDIR/mpich-gnu"*    ) set MPILIBS="-L$CRAY_MPICH2_DIR/lib -lmpich"
         if ( "$CRAY_MPICH2_DIR" =~ "$CRAY_MPICH_BASEDIR/mpich-intel"*  ) set MPILIBS="-L$CRAY_MPICH2_DIR/lib -lmpichf90_intel"
         if ( "$CRAY_MPICH2_DIR" =~ "$CRAY_MPICH_BASEDIR/mpich-cray"*   ) set MPILIBS="-L$CRAY_MPICH2_DIR/lib -lmpich"
      endif
      #
      if ( $?I_MPI_ROOT ) then
         set LDR=mpiifort
         echo "Linking Intel MPI libraries"
         set MPILIBS="-L$I_MPI_ROOT/lib"
         set MPILIBS="$MPILIBS -lmpifort -lrt"
         set MPILIBS="$MPILIBS -L$I_MPI_ROOT/lib/release"
         set MPILIBS="$MPILIBS -lmpi"
      endif

      # TODO: Linking other math libraries instead of using Cray's math library

      set LIBRARIES="$MATHLIBS $MPILIBS"

   else
      #         this will be set to 'ftn' by the configuration step
      set LDR=$GMS_FORTRAN
      set MATHLIBS=""
      #
      # Need to read these variables from config
      set GMS_XC_COMP = 'intel'
      set GMS_IFORT_VERNO = '16'
      #
      switch ($GMS_XC_COMP)
         case intel:
            if ( $?GMS_HPC_SYSTEM_TARGET ) then
               if ( $GMS_HPC_SYSTEM_TARGET == onyx ) then
                  if ($GMS_PHI == none) set LDOPTS='-i8 -xCORE-AVX2'
                  if ($GMS_PHI == knl)  set LDOPTS='-i8 -xMIC-AVX512'
               endif
               #
               if ( $GMS_HPC_SYSTEM_TARGET == theta ) then
                  if ($GMS_PHI == knl) set LDOPTS='-i8 -xMIC-AVX512'
               endif
            endif
            set LIBRARIES=' '
            if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -qopenmp"
            breaksw
         default:
            echo "Please spell your FORTRAN compiler name correctly." >> /dev/stderr
            exit 4
            breaksw
      endsw
   endif
endif
#
#   ------ Fujitsu PrimeHPC on A64FX cpus -----
#
if ($TARGET == fj-a64fx) then
   if (($GMS_DDI_COMM == mpi) || ($GMS_DDI_COMM == mixed)) then
      switch ($GMS_FORTRAN)
         case frt:
            set LDR='mpifrt'
            breaksw
         case frtpx:
            set LDR='mpifrtpx'
            breaksw
         default:
            echo "don't know how to use a $TARGET compiler named $GMS_FORTRAN with $GMS_DDI_COMM"
            exit 4
            breaksw
      endsw
   else
      set LDR=$GMS_FORTRAN
   endif
   if ($GMS_OPENMP == true) then
      set LDOPTS="-Kopenmp"
   else
      set LDOPTS=' '
   endif
#   if ($GMS_MSUAUTO == true) set LDOPTS="$LDOPTS -Kcmodel=large"
   set LIBRARIES=''
#
endif
#
#   Linux has become the standard Unix flavor, and thus blossomed into
#   the usual Unix confusion: multiple FORTRAN compilers, multiple
#   math libraries, and since there is no vendor, or even one main
#   distribution, the software is installed at random locations.
#   Hence, the 'config' script will have asked many questions to get the
#   compiler, math library, version numbers, and appropriate path names.
#
#   ------ Linux on 64 bit chips -----
#
if ($TARGET == linux64) then
   #
   #  settings which depend on the FORTRAN:
   #
   switch ($GMS_FORTRAN)
      case acfl:
      case armflang:
         set LDR='armflang'
         set LDOPTS=' '
         set FORTLIBS=' '
         if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -fopenmp"
         breaksw
      case aocc:
         set LDR='flang'
         set LDOPTS=' '
         set FORTLIBS=' '
         if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -mp"
         if ($GMS_HPC_SYSTEM_TARGET == nautilus) set LDOPTS="$LDOPTS -mp"
         breaksw
      case gfortran:
         set LDR='gfortran'
         set LDOPTS=' '
         set FORTLIBS=' '
         if ($GMS_OPENMP == true)    set LDOPTS="$LDOPTS -fopenmp"
         breaksw
      case flang-new:
         set LDR='flang-new'
         set LDOPTS=' '
         set FORTLIBS=' '
         if ($GMS_OPENMP == true)    set LDOPTS="$LDOPTS -fopenmp"
         breaksw
      case oneapi-ifort:
      case ifort:
         if ($GMS_DDI_COMM != sockets) then
            if ($GMS_MPI_LIB == impi) then
               set LDR='mpiifort'
            else
               set LDR='ifort'
            endif
         else
             set LDR='ifort'
         endif
         set LDOPTS='-i8'  # -Wl,-M generates a load map
         #            this auxiliary library seems to have disappeared in ifort 10
         if (`uname` == Darwin) then
            set FORTLIBS="-lm -ldl -L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib"
         else
            set FORTLIBS=' '
         endif
         #
         if ($GMS_IFORT_VERNO < 10) set FORTLIBS='-Vaxlib'
         if ($GMS_PHI == knl) then
            set LDOPTS="$LDOPTS -xMIC-AVX512"
         else if ($GMS_PHI == knc) then
            set LDOPTS="$LDOPTS -mmic"
         endif
         if ($GMS_OPENMP == true) then
            if ($GMS_IFORT_VERNO > 13) then
               set LDOPTS="$LDOPTS -qopenmp"
            else
               set LDOPTS="$LDOPTS -openmp"
            endif
         endif
         breaksw
      case oneapi-ifx:
         set LDR='ifx'
         set LDOPTS='-i8'
         if (`uname` == Darwin) then
            set FORTLIBS="-lm -ldl -L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib"
         else
            set FORTLIBS=' '
         endif
         #
         if ($GMS_OPENMP == true) then
            set LDOPTS="$LDOPTS -fiopenmp -fopenmp-targets=spir64"
         endif
         breaksw
      case nvfortran:
         if ($GMS_MPI_LIB == hpcx) then
            set LDR="mpifort"
         else
            set LDR="$GMS_FORTRAN"
         endif
         set LDOPTS="-i8 "
         set FORTLIBS=' '
         if ($GMS_OPENMP == true) set LDOPTS="$LDOPTS -mp"
         if ($GMS_OPENMP_OFFLOAD == true) set LDOPTS="$LDOPTS -mp=gpu"
         breaksw
      case pgfortran:
      case pgf77:
         set LDR="$GMS_FORTRAN"
         if ( `uname` == Darwin ) then
            set LDOPTS="$GMS_LIN_FLAGS -i8               "
         else
            set LDOPTS="$GMS_LIN_FLAGS -i8 -mcmodel=medium"
         endif
         if ($GMS_L64_OPT == testing) then
            set LDOPTS="$LDOPTS $GMS_PGI_OPT $GMS_IPA_OPT"
         else
            set LDOPTS="$LDOPTS -fastsse"
         endif
         set LDOPTS="$LDOPTS "
         set FORTLIBS=' '
         breaksw
      default:
         echo "don't know how to use a linux64 compiler named $GMS_FORTRAN" >> /dev/stderr
         exit 4
         breaksw
   endsw
   #
   #  settings which depend on the math library: mkl, atlas, acml, none
   #
   switch ($GMS_MATHLIB)

      case mkl:
         set mpath=$GMS_MATHLIB_PATH
         set mklver=$GMS_MKL_VERNO

         if ($GMS_PHI != none) set mklver=${mklver}-so
         switch ($mklver)
            case 8:
               set MATHLIBS="-L$mpath -lmkl_lapack64 -lmkl -lguide -lpthread"
               breaksw
            case 9:
               set MATHLIBS="-L$mpath -lmkl_lapack   -lmkl -lguide -lpthread"
               breaksw
               breaksw
            case 10:
            case 11:
            case 12:
            case oneapi:
               # next are a static link, in single-threaded mode (serial BLAS).
               # The choices preclude any need to
               #     a) install .so shared object libraries on every node,
               #     b) define LD_LIBRARY_PATH to find the .so libraries, or
               #     c) define MKL_NUM_THREADS=1
               # If desired, there is a single-threaded shared object link below.
               # Note, there's now a gfortran-specific compiler interface library.
               set iflib=intel
               if (($GMS_FORTRAN == gfortran) || ($GMS_FORTRAN == aocc)) set iflib=gf
               set MATHLIBS="-Wl,--start-group"
               set MATHLIBS="$MATHLIBS $mpath/libmkl_${iflib}_ilp64.a "
               set MATHLIBS="$MATHLIBS $mpath/libmkl_core.a "
               if ($GMS_THREADED_BLAS == true) then
                  set MATHLIBS="$MATHLIBS $mpath/libmkl_gnu_thread.a "
                  set MATHLIBS="$MATHLIBS -Wl,--end-group -lgomp"
               else
                  set MATHLIBS="$MATHLIBS $mpath/libmkl_sequential.a "
                  set MATHLIBS="$MATHLIBS -Wl,--end-group"
               endif
               if (`uname` == Darwin) then
                  set MATHLIBS="${MKLROOT}/lib/libmkl_intel_ilp64.a ${MKLROOT}/lib/libmkl_sequential.a ${MKLROOT}/lib/libmkl_core.a"
               endif
               if ($GMS_OPENMP == true) set MATHLIBS="$MATHLIBS -ldl"
               if ($GMS_OPENMP_OFFLOAD == true) then
                 set MATHLIBS="-fsycl ${MKLROOT}/lib/intel64/libmkl_sycl.a $MATHLIBS -lsycl -lOpenCL -lstdc++ -lpthread -lm"
               endif
               if (($GMS_FORTRAN == gfortran) || ($GMS_FORTRAN == aocc)) then
                  set MATHLIBS="$MATHLIBS -ldl"
               endif
               breaksw
            case 10-so:
            case 11-so:
            case 12-so:
            case oneapi-so:
               #  next one chooses dynamic linking (so= shared object libs)
               #  Just hand edit GMS_MKL_VERNO in your 'install.info' to use this.
               #  run-time libs (and LD_LIBRARY_PATH) needed on every compute node!
               #  note that it does force single-threaded usage.
               set iflib=intel
               if (($GMS_FORTRAN == gfortran) || ($GMS_FORTRAN == aocc)) set iflib=gf
                  set MATHLIBS="-L$mpath -lmkl_${iflib}_ilp64 -lmkl_sequential -lmkl_core"
                  if ($GMS_VM2 == true ) set MATHLIBS=" $MATHLIBS -lmpi_ilp64 -lpthread -lm -ilp64"
                  if (($GMS_FORTRAN == ifort) || ($GMS_FORTRAN =~ oneapi-*)) then
                     if ($GMS_PHI != none) then
                        # not necessarily right thing to do
                        #                set MATHLIBS="-mkl"
                     else if ($GMS_OPENMP == true) then
                        set MATHLIBS="-mkl"
                     endif
                  endif
                  if (($GMS_FORTRAN == gfortran) || ($GMS_FORTRAN == aocc)) then
                     if ($GMS_PHI == knc) then
                        echo "INVALID OPTION: GMS_FORTRAN=gfortran AND GMS_PHI=knc" >> /dev/stderr
                        exit 4
                     else if ($GMS_OPENMP == true) then
                        set MATHLIBS="-Wl,--no-as-needed -L$mpath -lmkl_${iflib}_ilp64 -lmkl_gnu_thread -lmkl_core -lpthread -lm -ldl"
                     endif
                  endif
               breaksw
            default:
               echo "unknown version number for MKL/linux64" >> /dev/stderr
               echo "please edit 'lked' to select the right 64 bit MKL libraries." >> /dev/stderr
               exit
               breaksw
         endsw
         breaksw

      case atlas:
         #     If the ATLAS comes with static libraries, link to them,
         #     so that only the compile node has to have the libraries.
         #     Otherwise, attempt a link against shared object libs.
         #     Alas, recent RPMs for Atlas have only .so libraries.
         #
         #     Most RPM versions of Atlas come w/o proper setup to use them.
         #     For example, your 'root' account should probably do the
         #     following soft links:
         #          chdir /usr/lib64/atlas
         #          ln -s libatlas.so.3.0        libatlas.so
         #          ln -s libblas.so.3.0         libblas.so
         #          ln -s libcblas.so.3.0        libcblas.so
         #          ln -s libf77blas.so.3.0      libf77blas.so
         #          ln -s liblapack_atlas.so.3.0 liblapack.so
         #          ln -s liblapack.so.3.0       liblapack.so
         #     It is strange the RPM's don't do these soft links for us.
         if (-e $GMS_MATHLIB_PATH/lib/libf77blas.a) then
            echo "case 1 $GMS_MATHLIB_PATH"
            set MATHLIBS="$GMS_MATHLIB_PATH/lib/libf77blas.a"
            set MATHLIBS="$MATHLIBS $GMS_MATHLIB_PATH/lib/libatlas.a"
            set MATHLIBS="$MATHLIBS $GMS_MATHLIB_PATH/lib/libcblas.a"
         else
            echo "case 2 $GMS_MATHLIB_PATH"
            set MATHLIBS="-L$GMS_MATHLIB_PATH -lf77blas -latlas"
         endif

         breaksw
      case atlas-so:
         set MATHLIBS="-L$GMS_MATHLIB_PATH/lib -lf77blas -latlas"

         breaksw
      case acml:
         #     do a static link so that only compile node needs to install ACML
         set MATHLIBS="$GMS_MATHLIB_PATH/libacml.a"
         #     if you want to try a dynamic link, use this:
         #---set MATHLIBS="-L$GMS_MATHLIB_PATH -lacml -lacml_mv"
         breaksw

      case nvblas:
         set MATHLIBS=""
         set MATHLIBS="${MATHLIBS} -L$GMS_MATHLIB_PATH -lblas_ilp64 -llapack_ilp64"
         breaksw

      case pgiblas:
         # As of PGI 19.10, pgiblas must be linked with -fopenmp.
         # This would suggest that the threaded version of OpenBLAS is being
         # used.
         set MATHLIBS=""

         if ((-e $GMS_MATHLIB_PATH/libblas.a) ) then
            set MATHLIBS="${MATHLIBS} $GMS_MATHLIB_PATH/libblas.a"
         else
            set MATHLIBS="${MATHLIBS} -L$GMS_MATHLIB_PATH -lblas"
         endif

         if (($GMS_OPENMP == false) && ($GMS_FORTRAN == gfortran)) set MATHLIBS="${MATHLIBS} -fopenmp"

         breaksw

      case openblas:
         set MATHLIBS=""

            if (-e $GMS_MATHLIB_PATH/libopenblas64.a) then
               set openblaslib=$GMS_MATHLIB_PATH/libopenblas64.a
            else if (-e $GMS_MATHLIB_PATH/libopenblas.a) then
               set openblaslib=$GMS_MATHLIB_PATH/libopenblas.a
            else
               echo "The directory $GMS_MATHLIB_PATH does not contain either libopenblas64.a or libopenblas.a" >> /dev/stderr
               exit 4
            endif
            switch ($GMS_FORTRAN)
               case gfortran:
                  echo " "
                  echo "Checking whether $openblaslib uses 64-bit integers."
                  echo " "

                  set echo
                  $GMS_FORTRAN -fdefault-integer-8 -finit-integer=-9223372036854775808 -fopenmp $GMS_PATH/tools/test_dgesv.f90 $openblaslib -o $GMS_BUILD_DIR/test_dgesv
                  $GMS_BUILD_DIR/test_dgesv
                  set rc=$status
                  unset echo

                  if ($rc != 0) then
                     echo "Could not verify that $openblaslib uses 64-bit integers." >> /dev/stderr
                     exit 4
                  endif

                  rm $GMS_BUILD_DIR/test_dgesv
                  unset rc
                  breaksw
               case aocc:
                  # Needed if OpenBLAS was compiled with GNU
                  set MATHLIBS="$MATHLIBS -lgfortran"
                  breaksw
               default:
                  breaksw
            endsw
            set MATHLIBS="${MATHLIBS} $openblaslib"
            unset openblaslib

         if ($GMS_FORTRAN == nvfortran) set MATHLIBS="${MATHLIBS} -lgfortran"
         breaksw
      case openblas-so:
         set MATHLIBS="-L$GMS_MATHLIB_PATH -lopenblas"
         breaksw

      case aocl:
         if ($GMS_THREADED_BLAS == true) then
            if (-f $GMS_MATHLIB_PATH/libblis-mt.a) then
               set MATHLIBS="-L$GMS_MATHLIB_PATH -lblis-mt"
            endif
         else
            if (-f $GMS_MATHLIB_PATH/libblis.a) then
               set MATHLIBS="-L$GMS_MATHLIB_PATH -lblis"
            endif
         endif
         set MATHLIBS="$MATHLIBS -L$GMS_AMD_FLAME_PATH -lflame"
         breaksw

      case armpl:
         # note that we link the 64-bit version!
         set LAPACK=""
         if (-e $GMS_MATHLIB_PATH/libarmpl_lp64.a) then
            set MATHLIBS="$GMS_MATHLIB_PATH/libarmpl_ilp64.a -lrt"
         else
            set MATHLIBS="-L$GMS_MATHLIB_PATH -larmpl_ilp64"
         endif
         breaksw

      case nvpl:
         set LAPACK=""
         set MATHLIBS="-L$GMS_MATHLIB_PATH -lnvpl_blas_lp64_seq -lnvpl_lapack_ilp64_seq"
         breaksw

      case none:
      default:
         echo "Warning.  No math library was found, you should install one."
         echo "    MP2 calculations speed up about 2x with a math library."
         echo "CCSD(T) calculations speed up about 5x with a math library."
         set MATHLIBS="$GMS_PATH/3rd-party/lib/libblas64.a"
         breaksw
   endsw
   #
   if ($GMS_OPENMP_OFFLOAD == true) then
      if ($USE_CUBLAS == true) then
         if ($?NVBLAS_ROOT) then
            set MATHLIBS="${MATHLIBS} -L$NVBLAS_ROOT/lib64 -cudalib=cublas,cusolver"
         endif
         if ($?CUDA_HOME) then
            set MATHLIBS="${MATHLIBS} -L$CUDA_HOME/lib64 -cudalib=cublas,cusolver"
         endif
      endif
   endif
   #
   set LIBRARIES="$FORTLIBS $MATHLIBS"
   #
endif
#
#      MacIntosh
#
#      The incantation to link to Apple's BLAS library is rather strange.
#      The math library is Apple's veclib framework,
#      which is part of a larger framework called Accelerate.
#
#      Older sytems may need to link against the "SystemStubs library"
#      Even older systems (e.g. 10.3) may need this changed to -lcc_dynamic
#
if ($TARGET == mac64) then
   set LDR=$GMS_FORTRAN
   set MATHLIBS=""
   if ($GMS_MAC_OSX_VERNO == 11) then
      set LDOPTS=''
   else
      set LDOPTS='-m64'
   endif
   switch ($GMS_MAC_OSX_VERNO)
      #     the Accelerate framework is the new standard
      case 10.8:
      case 10.9:
      case 10.10:
      case 10.11:
      case 10.12:
      case 10.13:
      case 10.14:
      case 10.15:
      case 11.0:
      case 11.1:
      case 11.2:
      case 11:
         set LIBRARIES='-Wl,-framework -Wl,Accelerate'
      breaksw
   endsw
endif
#
#   ------ Windows on 64 bit chips -----
#
if ($TARGET == win64) then
   #
   #  settings which depend on the FORTRAN: pgfortran, ifort
   #
   #  WS2_32.Lib is needed for WinSock
   #
   set LIBRARIES="WS2_32.lib"
   #
   switch ($GMS_FORTRAN)
      case oneapi-ifort:
      case oneapi-ifx:
      case ifort:
         if ($GMS_FORTRAN == oneapi-ifx) then
            set LDR = "ifx"
         else
            set LDR = "ifort"
         endif
         set EXTRA_LINK_FLAGS="-Qlocation,link,$VCToolsInstallDir/bin/Hostx64/x64"
         set LDOPTS="$GMS_WIN_TP -integer-size:64 -Qzero"
         if ($GMS_WIN_OPT == baseline)        set LDOPTS="$LDOPTS -Od $GMS_WIN_FLAGS"
         if ($GMS_WIN_OPT == linux)           set LDOPTS="$LDOPTS -O2 $GMS_WIN_FLAGS"
         if ($GMS_WIN_OPT == samara)          set LDOPTS="$LDOPTS -O3 $GMS_WIN_FLAGS"
         if ($GMS_WIN_OPT == fast)            set LDOPTS="$LDOPTS -fast $GMS_WIN_FLAGS"
         if ($GMS_WIN_OPT == testing)         set LDOPTS="$LDOPTS $GMS_INT_OPT $GMS_IPO_OPT $GMS_WIN_FLAGS"
         breaksw
      case pgfortran:
         set LDR = "$GMS_FORTRAN"
         set LDOPTS="$GMS_WIN_FLAGS -m64 -i8 -Bstatic"
         if ($GMS_WIN_OPT == baseline)        set LDOPTS="$LDOPTS -O0                             $GMS_WIN_TP"
         #     if ($GMS_WIN_OPT == linux)           set LDOPTS="$LDOPTS -fastsse -Mipa=fast,safe        $GMS_WIN_TP"
         if ($GMS_WIN_OPT == linux)           set LDOPTS="$LDOPTS -fastsse                        $GMS_WIN_TP"
         #     if ($GMS_WIN_OPT == samara)          set LDOPTS="$LDOPTS -O3      -Mipa=fast,safe        $GMS_WIN_TP"
         if ($GMS_WIN_OPT == samara)          set LDOPTS="$LDOPTS -O3                             $GMS_WIN_TP"
         #     if ($GMS_WIN_OPT == fast)            set LDOPTS="$LDOPTS -fastsse -Mipa=fast,inline,safe $GMS_WIN_TP"
         if ($GMS_WIN_OPT == fast)            set LDOPTS="$LDOPTS -fastsse                        $GMS_WIN_TP"
         if ($GMS_WIN_OPT == testing)         set LDOPTS="$LDOPTS $GMS_PGI_OPT $GMS_IPA_OPT       $GMS_WIN_TP"
         #
         #     For more detailed information as to which flags are being used
         #     by the compiler during the build - uncomment the line below.
         #
         #     set LDOPTS="$LDOPTS -v"
         #
         if ($GMS_OPENMP == true) then
            set LDOPTS="$LDOPTS -mp"
         endif
         breaksw
      default:
      echo "Please spell your win64 compiler correctly." >> /dev/stderr
         exit 4
         breaksw
   endsw
   #
   #  settings which depend on the math library: mkl, acml, blas, none
   #
   switch ($GMS_MATHLIB)
      case mkl:
         if ($GMS_FORTRAN == pgfortran) then
            set GMS_MATHLIB_DOSPATH=`cygpath -d $GMS_MATHLIB_PATH:q`
            set MATHLIBS="-Wl,-libpath:$GMS_MATHLIB_DOSPATH:q mkl_intel_ilp64.lib mkl_sequential.lib mkl_core.lib"
            #set MATHLIBS="-Wl,-libpath:$GMS_MATHLIB_DOSPATH:q mkl_blas95_ilp64.lib mkl_intel_ilp64.lib mkl_sequential.lib mkl_core.lib"
            echo "Using Intel's MKL libraries: $LIBRARIES"
         endif
         if ($GMS_FORTRAN == ifort) then
            set MATHLIBS="mkl_blas95_ilp64.lib mkl_intel_ilp64.lib mkl_sequential.lib mkl_core.lib"
            echo "Using Intel's MKL libraries: $LIBRARIES"
         endif
         if ($GMS_FORTRAN == oneapi-ifort) then
            set MATHLIBS="mkl_scalapack_ilp64.lib mkl_intel_ilp64.lib mkl_sequential.lib mkl_core.lib mkl_blacs_intelmpi_ilp64.lib impi.lib"
            echo "Using Intel's MKL libraries: $LIBRARIES"
         endif
         if ($GMS_FORTRAN == oneapi-ifx) then
            set MATHLIBS="mkl_blas95_ilp64.lib mkl_intel_ilp64.lib mkl_sequential.lib mkl_core.lib"
            set BLAS=' '
            echo "Using Intel's MKL libraries: $LIBRARIES"
         endif
         breaksw
      case acml:
         if ($GMS_FORTRAN == pgfortran) then
            set MATHLIBS="-Bdynamic -Macml"
            echo "Using ACML blas libraries"
         endif
         if ($GMS_FORTRAN == ifort) then
            set MATHLIBS="$GMS_MATHLIB_PATH:q libacml.lib"
            echo "Using ACML blas libraries"
         endif
         breaksw
      case blas:
         if ($GMS_FORTRAN == pgfortran) then
            set MATHLIBS="-Bstatic -lblas"
            echo "Using PGI's 64-bit blas"
         else if ($GMS_FORTRAN == ifort) then
            set MATHLIBS="$GMS_MATHLIB_PATH:q libblas.lib"
            echo "Using PGI's 64-bit blas"
         endif
         breaksw
      case none:
      default:
         echo "Using Netlib BLAS and LAPACK libraries"
         set MATHLIBS="$GMS_PATH/3rd-party/lib/libblas64.a"
         breaksw
   endsw
   #
endif
#
#   Choose the message passing libraries, MSG_LIBRARIES.
#   ====================================================
#
#      In all cases, the Distributed Data Interface has been
#      compiled to a library archive, with the name ../ddi/libddi.a,
#      where we must look first.  Depending on the machine DDI has
#      several implementations and may be looking for
#         TCP/IP sockets, SHMEM, MPI, or LAPI/MPI
#      so here we select the specific low level system libraries.
#
switch ($TARGET)
   #             TCP/IP sockets interface (most systems)
   case fj-a64fx:
   case ibm64:
   case linux64:
   case mac64:
      #
      #                   set up Spectrum MPI usage on 64-bit IBM clusters.
      set MPILIBS=''
      if ($TARGET == ibm64) then
         set MPILIBS="-L$GMS_MPI_PATH/lib -L/usr/lib -L/usr/lib64"
         #set MPILIBS="$MPILIBS -lmpi_ibm_usempi -lmpi_ibm_mpifh -lmpi_ibm -lgfortran"
         #set MPILIBS="$MPILIBS -pthread -lmpiprofilesupport -lmpi_ibm_mpifh  -lmpi_ibm -libverbs"
         if ($GMS_HPC_SYSTEM_TARGET == generic) then
            set MPILIBS="$MPILIBS -lmpiprofilesupport -lmpi_mpifh  -lmpi_ibm -libverbs"
         else if (($GMS_HPC_SYSTEM_TARGET == summit) || ($GMS_HPC_SYSTEM_TARGET == hokulea)) then
            set MPILIBS="$MPILIBS -lmpiprofilesupport -lmpi_ibm_mpifh  -lmpi_ibm -libverbs"
         endif
      endif
      #                   set up MPI usage on 64-bit linux clusters.
      if (($TARGET == fj-a64fx) && (($GMS_DDI_COMM == mpi) || ($GMS_DDI_COMM == mixed))) then
         switch ($GMS_MPI_LIB)
            case fj-mpi:
#              Fujitsu MPI is based on OpenMPI so all flags are similar to linux64/openmpi case

                  set MPILIBS="-L$GMS_MPI_PATH/lib64"
                  set MPILIBS="$MPILIBS -lmpi"

               breaksw
            default:
               echo "lked script has unknown MPI software requested" >> /dev/stderr
               exit 4
               breaksw
         endsw
      endif
      if (($TARGET == linux64) && (($GMS_DDI_COMM == mpi) || ($GMS_DDI_COMM == mixed))) then
         switch ($GMS_MPI_LIB)
            case impi:
               if ($GMS_PHI == knc) set MPILIBS="-L$GMS_MPI_PATH/mic/lib"
               if ( -d $GMS_MPI_PATH/lib64 ) then
                  #
                  # Pre-2019 Intel directory structure for MPI includes
                  #
                  set MPILIBS="-L$GMS_MPI_PATH/lib64"
                  set MPILIBS="$MPILIBS -lmpi -lmpigf -lmpigi -lrt"
               else if (-d $GMS_MPI_PATH/intel64/lib) then
                  #
                  # 2019 Intel directory structure for MPI includes
                  #
                  set MPILIBS="-L$GMS_MPI_PATH/intel64/lib"
                  set MPILIBS="$MPILIBS -lmpifort -lrt"
                  set MPILIBS="$MPILIBS -L$GMS_MPI_PATH/intel64/lib/release"
                  set MPILIBS="$MPILIBS -lmpi "
               else if (-d $GMS_MPI_PATH/lib) then
                  set MPILIBS="-L$GMS_MPI_PATH/lib"
                  set MPILIBS="$MPILIBS -lmpifort -lrt"
                  set MPILIBS="$MPILIBS -L$GMS_MPI_PATH/lib/release"
                  set MPILIBS="$MPILIBS -lmpi "
               else
                  echo "Intel MPI library not found!" >> /dev/stderr
                  exit 4
               endif

               breaksw
            case spectrum:
               set MPILIBS="-L$GMS_MPI_PATH/lib -L/usr/lib -L/usr/lib64"
               #set MPILIBS="$MPILIBS -lmpi_ibm_usempi -lmpi_ibm_mpifh -lmpi_ibm -lgfortran"
               set MPILIBS="$MPILIBS -pthread -lmpiprofilesupport -lmpi_ibm_mpifh  -lmpi_ibm -libverbs"
               breaksw
            case mpich:
            case mpich2:
               set MPILIBS="-L$GMS_MPI_PATH/lib"
               if ( `uname` == Darwin ) then
                  set MPILIBS="$MPILIBS -lmpi -lmpl -lmpich     "
               else
                  set MPILIBS="$MPILIBS -lmpi -lmpl -lmpich -lmpifort -lrt"
               endif
               breaksw
            case mvapich:
            case mvapich2:
               switch ($GMS_MPI_SOFTWARE_VERNO)
                  #
                  #                    early versions needed the user to specify three
                  #                    basic libraries from MVAPICH2, and to follow that
                  #                    up with explicit OFED libraries.
                  #                    These are a bit tricky, being both a function of the
                  #                    Infiniband type, and to at least some extent, maybe
                  #                    also the MVAPICH2 version.
                  #                    E-mail us if you have trouble with MVAPICH2 linking!
                  case 1.4:
                  case 1.5:
                  case 1.6:
                  case 1.7:
                  case 1.8:
                  case 1.9:
                     #                          several of our older clusters allow a static link
                     set MPILIBS="$GMS_MPI_PATH/lib/libmpich.a"
                     set MPILIBS="$MPILIBS $GMS_MPI_PATH/lib/libopa.a"
                     set MPILIBS="$MPILIBS $GMS_MPI_PATH/lib/libmpl.a"
                     #                          but you can try a .so link if you like:
                     #--set MPILIBS="-L$GMS_MPI_PATH/lib -lmpich -lopa -lmpl"
                     #
                     #                   QLogic Infiniband likes to look at its
                     #                   its "path scale messaging" PSM library.
                     #                   Mellanux Infiniband does not need this library,
                     #                   and it can be an error to name if non-existent.
                     #
                     if (-e /usr/lib64/libpsm_infinipath.so) then
                        set MPILIBS="$MPILIBS -L/usr/lib64 -lpsm_infinipath"
                     endif
                     #
                     #                   Append OFED's libs to the end of the MVAPICH2 list,
                     #                   one particular cluster needed to look into -libnetdisc.
                     #                   Finally, allow it to peek into the runtime/thread libs
                     #
                     set OFEDLIST="-libverbs -lrdmacm -libumad"
                     if (-e $GMS_OFED_PATH/libibnetdisc.so ) then
                        set OFEDLIST="$OFEDLIST -libnetdisc"
                     endif
                     set MPILIBS="$MPILIBS -L$GMS_OFED_PATH $OFEDLIST"
                     set MPILIBS="$MPILIBS -lrt -lpthread"
                     breaksw
                     #
                     #                       as of version 2.0, MVAPICH2 seems to have a simple
                     #                       link list, just its own two libs.  It then finds
                     #                       the requisite OFED libraries all on its own.
                     #                       On our 2.1 cluster, DDI linked to various libs:
                     #                           xml2, ibmad, rdmacm, ibumad, ibverbs, rt
                     #                       without any need to specify them here.
                  case 2.0:
                  case 2.1:
                  case 2.3.7-*:
                  default:
                     set MPILIBS="-L$GMS_MPI_PATH/lib -lmpifort -lmpi"
                     set MPILIBS="$MPILIBS -lpthread"
                     breaksw
               endsw
               breaksw
            case hpcx:
            case openmpi:

                  if ( -d $GMS_MPI_PATH/lib64 ) then
                     set MPILIBS="-L$GMS_MPI_PATH/lib64"
                  else
                     set MPILIBS="-L$GMS_MPI_PATH/lib"
                  endif
                  set MPILIBS="$MPILIBS -lmpi"
                  if (($GMS_OPENMP == true) && ($GMS_FORTRAN == nvfortran)) set MPILIBS="$MPILIBS -lopen-pal -lopen-rte"

               breaksw
            case mpt:
               set MPILIBS="-L$GMS_MPI_PATH/lib"
               set MPILIBS="$MPILIBS -lmpi"
               breaksw
            case myrinet:
               # very old information, perhaps not correct anymore.
