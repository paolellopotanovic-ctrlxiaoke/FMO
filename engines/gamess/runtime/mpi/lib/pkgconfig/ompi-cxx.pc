Name: Open MPI
Description: Portable high-performance MPI implementation
Version: 4.1.7rc1
URL: http://www.open-mpi.org/
#
hpcx_home=/opt/hpcx
prefix=${hpcx_home}/ompi
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib
pkgincludedir=${includedir}/openmpi
#
# Note that -lopen-pal and all the EXTRA_LIBS are only necessary when
# static linking (they're pulled in by libopen-rte.so's implicit
# dependencies), so only list these in Libs.private.
#
Libs: -L${libdir}    -Wl,-rpath -Wl,${libdir}  -Wl,--enable-new-dtags  -lmpi
Libs.private: -lopen-rte -lopen-pal -lm  -lz
#
Cflags: -I${includedir} -I${includedir}/openmpi -I${pkgincludedir}/opal/mca/hwloc/hwloc201/hwloc/include -I${pkgincludedir}/opal/mca/event/libevent2022/libevent -I${pkgincludedir}/opal/mca/event/libevent2022/libevent/include    
