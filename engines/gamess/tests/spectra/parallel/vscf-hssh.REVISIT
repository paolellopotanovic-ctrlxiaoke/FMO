!    hydrogen persulfide...HSSH...CCD has 60 AOs generating 56 MOs
!
!    Answers (in a RESTART) should match the line marked with the arrow.
!
! mode/symmetry:  nu4  nu3  nu2  nu6  nu1  nu5                   dynamo p=8
!                  a    a    a    b    a    b             #E's     (secs)
!      harmonic:  447  530  917  920 2752 2756  full MP2    13        34
!              using internal coordinates:
! DIRECT 2 mode:  423  519  909  906 2657 2659   RI-MP2   3937     3,569
! DIRECT 3 mode:  264  340  592  595 1392 1365   RI-MP2  85857    17,789
!  QFF   2 mode:  420  519  909  905 2673 2677   RI-MP2    217       202
!  QFF   2 mode:  421  519  909  906 2669 2673  CCSD(T)*   217     3,454
!             using Cartesian coordinates:
! DIRECT 2 mode:  413  520  900  802 2641 2607   RI-MP2   3937     3,568
! DIRECT 3 mode:  400  496  880  882 2645 2601   RI-MP2  85857    80,597 <---
!  QFF   2 mode:  387  521  899  902 2645 2617   RI-MP2    217       203
!  QFF   2 mode:  390  520  899  902 2638 2612  CCSD(T)*   217     3,452
!                        using experiment:
!                 416  510  882  886 2513 2577
!
!  * Note that the CCSD(T) run was made with MP2 structure and hessian!!!
!  So of course this doesn't really say what the CCSD(T) result actually is.
!
!   Because the restart data is saved, this run does the direct
!   3-mode coupling line, with little time required, except solving.
!
!   This run takes 266 seconds on 2.66 GHz Cloverton (14 July 2016)
!
!  experiments:
!    M.K.Wilson, R.M.Badger  J.Chem.Phys. 17, 1232-1236(1949)
!        nu3(a)  510 Raman, liquid     calculation shows this is SS stretch
!        nu2(a)  882 Raman, liquid           these two are HSS bends
!        nu6(b)  886 IR, gas
!        nu1(a) 2513 Raman, liquid           these two are SH stretches
!        nu5(b) 2577 IR, gas
!    B.P.Winnewisser, M.Winnewisser Z.Naturforsch 23a, 832(1968)
!        nu4(a)  416 microwave, gas          which is the torsion
!    See G.Winnewisser, K.M.T.Yamada  Vib.Spectrosc. 1, 263-272(1991)
!    for similar microwave work, and cis/trans barrier heights.
!
 $contrl scftyp=rhf runtyp=vscf mplevl=2 cctyp=none    nzvar=6 ispher=1 $end
x$contrl                        mplevl=0 cctyp=ccsd(t) $end
 $system mwords=5 memddi=5 $end

 $basis  gbasis=ccd $end
 $guess  guess=huckel $end
 $scf    dirscf=.true. $end
 $trans  dirtrf=.true. $end
 $mp2    code=rimp2 $end
 $auxbas cabnam=ccd $end

x$vscf   petyp=direct ncoup=2 dmdr=.true. intcrd=.true. inttyp=2 $end
x$vscf   petyp=direct ncoup=3 dmdr=.true. intcrd=.true. inttyp=2 $end
x$vscf   petyp=qff    ncoup=2 dmdr=.true. intcrd=.true. inttyp=2 $end

x$vscf   petyp=direct ncoup=2 dmdr=.true. intcrd=.f. $end
 $vscf   petyp=direct ncoup=3 dmdr=.true. intcrd=.f. readv=.true. $end
x$vscf   petyp=qff    ncoup=2 dmdr=.true. intcrd=.f. $end

 $zmat   izmat(1)=1,1,2,   1,1,3,   1,2,4,
                  2,3,1,2,   2,4,2,1,   3,3,1,2,4   $END
 $data
