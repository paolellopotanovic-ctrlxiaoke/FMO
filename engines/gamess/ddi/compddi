   (set echo; $CC $CFLAGS -pthread $DDI_OPTS -o ../ddikick.x ddikick.o libddikick.a $CLIBS)
   echo " "
   echo "Don't forget to move ddikick.x up one directory level,"
   echo "by a   'mv ddikick.x ..'   command."
   echo " "
   set nonomatch
   foreach file (*.o)
           if (-f "$file" && -w "$file") rm "$file"
   end
   unset nonomatch
   unset file
   if (-f libddikick.a && -w libddikick.a) rm libddikick.a
   chdir ..
endif

# ------------------------------------------------------------ #
# End of compile script, run "ranlib" on the library and exit. #
# ------------------------------------------------------------ #
finishOK:

ranlib $RANLIB_FLAGS libddi.a

echo "DDI compilation ended successfully."
#rm -f src/*.o
date
time
exit

#    if something bad happens, remove all binary files,
#    to make sure the user realizes compddi crashed out.
bombout:
echo " "
echo "DDI compilation did not finish correctly, please fix, and try again"
echo " "
chdir ..
if (-f libddi.a && -w libddi.a)         rm libddi.a
if (-f kickoff/libddikick.a && -w kickoff/libddikick.a) rm kickoff/libddikick.a
if (-f ddikick.x && -w ddikick.x)       rm ddikick.x
if (-f ddi_test.x && -w ddi_test.x)     rm ddi_test.x
if (-f ddi_server.x && -w ddi_server.x) rm ddi_server.x
set nonomatch
foreach file (src/*.o)
        if (-f "$file" && -w "$file") rm "$file"
end
foreach file (kickoff/*.o)
        if (-f "$file" && -w "$file") rm "$file"
end
foreach file (test/*.o)
        if (-f "$file" && -w "$file") rm "$file"
end
foreach file (server/*.o)
        if (-f "$file" && -w "$file") rm "$file"
end
unset nonomatch
unset file
date
time
exit 8
