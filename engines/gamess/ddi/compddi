#!/inspire/ssd/tenant_predefaa-9a1b-4522-bb10-8850f313be13/global_user/3078-linziqian/ai-vs-physics-ross2023/envs/openfe/bin/tcsh -f
#
# 27 Mar 2014 - script to compile the Distributed Data Interface (DDI)
#
#     This produces a library 'libddi.a' which GAMESS links against,
#     and perhaps, a process kickoff program called 'ddikick.x' and
#     perhaps a test program 'ddi_test.x'.
#
# Please send your issues to the GAMESS public
# issue tracker on GitHub:
# https://github.com/gms-bbg/gamess-issues/issues
#
if (-e install.info) then
   source install.info
else if (-e ../install.info) then
   source ../install.info
else
   echo "Please run 'config' first, to set up GAMESS compiling information" >> /dev/stderr
   exit 4
endif
#
set EXTRA_FLAGS=''
if($GMS_HPCCHEM == true && $GMS_HPCCHEM_USE_DATA_SERVERS == true) then 
set EXTRA_FLAGS=''
else if ($GMS_HPCCHEM == true && $GMS_HPCCHEM_USE_DATA_SERVERS == false) then 
set EXTRA_FLAGS='-DDDI_NO_DATA_SERVERS'
endif 
#
# TO use DDI large messages (e.g., >2GB) you need to set the flag to be DDI_MSG_FACTOR>1.
# The value of the flag should be an integer value and it is used to divide the current message
# by that value to ensure it fits into the "count" limit of MPI. Common usage:
#
# set EXTRA_FLAGS='-DDDI_MSG_FACTOR=8'
#
# additionally a threashold value is set in src/common.h : DDI_LG_MSG_THRESHOLD
# so only messages greater than the threshold are set up to transfer with the DDI_MSG_FACTOR.
#
# NOTE: This feature does NOT work for 32-bit architectures which can not address memory >2GB.
#
# the configuration file read just above provides the next two variables,
# and several other GMS_XXX values that will be used further down.
#
set TARGET=$GMS_TARGET
chdir $GMS_PATH/ddi
#
#  The following "numbers" make choices based primarily on 'config' values,
#  such as the machine target, and communication layer.
#  A human might want to review some of these selections, particularly #2,
#  but if you don't understand something, leave it alone.
#
#  1. Choose DDI communication layer, the only legal values are
#              sockets,mixed,mpi,shmem,lapi,armci
#     Please note that the correct choice is very often "sockets"!
#
#     Use 'serial' to use DDI stubs and build a DDI-free serial binary of GAMESS
#     Use 'sockets' if a TCP/IP stack is available.
#                   Choosing 'sockets' will produce a process kickoff
#                   program 'ddikick.x', as well as the DDI library.
#                   Every Unix has TCP/IP for its Ethernet, and "sockets"
#                   is an highly rational choice for Ethernet clusters.
#     Use 'mixed' or 'mpi' for MPI-based high performance networks.
#           'mixed' uses almost entirely MPI-1 calls, but uses a few
#                   TCP/IP sockets to avoid some of MPI's polling, often
#                   resulting in better wall clock times than 100% MPI.
#             'mpi' runs use 100% MPI-1 calls, but this often bogs down
#                   in polling, and can be much slower than 'mixed'.
#                         Read about MPI in ~/gamess/ddi/readme.ddi
#                         before choosing either 'mixed' or 'mpi'.
#     Use     'mpi' for the IBM Blue Gene/P platform.
#     Use     'mpi' for the Cray XT series.
#     Use     'mpi' for the SGI Altix or ICE, with its 'mpt' MPI library.
#     Use   'armci' only if you like experimenting (not supported well)
#
#     Clusters should use TCP/IP sockets on networks up to and including GE,
#     but probably should use 'mpi' on networks like Infiniband.
#
#  As of Feb. 2011, 'config' usually sets GMS_DDI_COMM to 'sockets'.
#       However, target 'linux64' may set GMS_DDI_COMM to 'mpi',
#  along with collecting information about which flavor of mpi,
#  where the MPI library is located, and so forth.
#
set COMM = $GMS_DDI_COMM
#
#     high end machines are just hardwired as follows.  Don't change them.
#
if ($COMM =~ serial*) then
   echo "##########################################################"
   echo "# DDI communication target is 'serial'. Using DDI-stubs. #"
   echo "# DDI does not need to be compiled.                      #"
   echo "##########################################################"
   cd $GMSPATH
   ./comp serial
   exit 0
endif
if ($TARGET =~ hpe-*)       set COMM=mpi
if ($TARGET == cray-xt)     set COMM=mpi
if ($TARGET == cray-xc)     set COMM=mpi
if ($TARGET == ibm64)       set COMM=mpi

#  2. DDI node sizes
#     a. Maximum number of processors (cores) in your SMP enclosures
#     b. Maximum number of nodes (number of physical SMP enclosures)
#
#        It is OK if these values are larger than your system!
#
set MAXCPUS=128
set MAXNODES=32
#
# core affinity for sockets
# (i.e., run each compute GAMESS process on a fixed core)
# Set SOC_AFF to "no" if your OS does not provide the standard routine,
# which is sched_setaffinit (e.g., you have linking errors).
#
set SOC_AFF=no
#
# VeraChem
#
if ($GMS_VM2 == true) then
   set MAXCPUS=32
   set MAXNODES=1024
endif
#
if ($GMS_PHI != none) then
   set MAXCPUS=512
   set MAXNODES=64
endif
#
# ARM64
#
if (`uname -p` == aarch64) then
   set MAXCPUS=256
   set MAXNODES=10
endif
#
#      you might want to bump MAXCPUS or MAXNODES to match your HPE Cray system
if ($TARGET =~ hpe-*) then
   if ($GMS_HPC_SYSTEM_TARGET == narwhal) then
      set MAXCPUS=128
      set MAXNODES=2176
   else if ($GMS_HPC_SYSTEM_TARGET == perlmutter) then
      set MAXCPUS=128
      set MAXNODES=128
   else if ($GMS_HPC_SYSTEM_TARGET == polaris) then
      set MAXCPUS=64
      set MAXNODES=560
   else if ($GMS_HPC_SYSTEM_TARGET == crusher) then
      set MAXCPUS=64
      set MAXNODES=192
   else if ($GMS_HPC_SYSTEM_TARGET == frontier) then
      set MAXCPUS=64
      set MAXNODES=9408
   else
      set MAXCPUS=128
      set MAXNODES=128
   endif
endif
#
#      you might want to bump MAXCPUS or MAXNODES to match your XT
if ($TARGET == cray-xt) then
   set MAXCPUS=12
   set MAXNODES=1024
endif
#
# match your XC
if ($TARGET == cray-xc) then
   set MAXCPUS=256
   set MAXNODES=100000
   if ( $?GMS_HPC_SYSTEM_TARGET ) then
      if ( $GMS_HPC_SYSTEM_TARGET == cori ) then
         # This should give us the high-end on the number of CPU (or threads) for cori haswell
         #
         # Intel Xeon E5-2698v3 Haswell nodes
         #     - 32 cores/node
         #     - 2 hyper-threads/core
         #     - 4,810 total nodes
         #     - 1932 total nodes
         #
         set MAXCPUS=64
         set MAXNODES=1932
      endif
      #
      if ( $GMS_HPC_SYSTEM_TARGET == onyx ) then
         # This should give us the high-end on the number of CPU (or threads) for onyx
         #
         # Intel Xeon E5-2699v4 Broadwell nodes (standard/large memory)
         #     - 44 cores/node
         #     - 4,810 total nodes (standard memory)
         #     - 4 total nodes (large memory)
         # Intel Xeon Phi 7230 Knights Landing nodes (KNL)
         #     - 64 cores/node
         #     - 4 hardware threads/core
         #     - 256 hardware threads total
         #     - 32 nodes
         #
         set MAXCPUS=256
         set MAXNODES=4810
      endif
      #
      if ( $GMS_HPC_SYSTEM_TARGET == theta ) then
         # This should give us the high-end on the number of CPU (or threads) for theta
         #
         # Intel Xeon Phi 7230 Knights Landing nodes
         #     - 64 cores/node
         #     - 4 hardware threads/core
         #     - 256 hardware threads total
         #     - 4,392 nodes
         #
         set MAXCPUS=256
         set MAXNODES=4392
      endif
   endif
endif
#
#      you might want to bump MAXNODES or MAXCPUS to match your BG/Q
#      the P named Mira at Argonne Nat. Lab. has 64 cores, and 49152 nodes,
#      but runs on it are usually done with only 16 cores to quadruple
#      the memory per core.
if ($TARGET == fj-a64fx) then
   set MAXCPUS=48
   set MAXNODES=1024
endif

if ($TARGET == ibm64) then
   set MAXCPUS=168
   set MAXNODES=4608
endif

if ($TARGET == linux64) then
   if ( $GMS_HPC_SYSTEM_TARGET == nautilus ) then
     set MAXCPUS=128
     set MAXNODES=1350
   endif
endif

#  3. Use System V-style shared-memory and semaphores
#        Please see the file readme.ddi for checking and changing
#        System V shared memory/IPC limits for your particular OS.
#        Turn System V memory off if:
#        1) if you are unable to adjust system limits to higher values,
#           which requires cooperation from the 'root' account.
#        2) on some systems with micro-kernels, SysV may be taboo.
#        3) if SysV is just missing, e.g. in Cygwin under Windows.
#
set SYSV = true
if ($COMM == armci)      set SYSV=false
if ($TARGET == win64)    set SYSV=false

#  4. Incomplete POSIX replacement for System V code
#     Always leave SYSV above true, as we continue to use SYSV semaphores!
#        Choose the next as 'sysv'  to use System V shared memory.
#        Choose the next as 'posix' to use POSIX    shared memory.
set SHMTYPE=$GMS_SHMTYPE

#  5. If using MPI, select the path to the include file mpi.h
#     This part is for Linux clusters, where there are many different
#     MPI libraries, and they may be installed almost anywhere.
#
#     For example, Intel MPI version 3.2 installed at the default
#     place would want to define something like
#        set MPI_INCLUDE_PATH = '/opt/intel/impi/3.2/include64'
#     Other scripting changes related to compiling and linking for
#     an MPI library are the "fge hack" in 'comp', and setting up
#     the message libraries in 'lked'.
#     Execution of GAMESS over MPI is left up to the user's ability
#     to modify 'rungms', based on the information about each MPI
#     contained in 'readme.ddi'!
#
set MPI_INCLUDE_PATH = ''
#
#           big iron knows where its MPI is going to be found!
#           initialize this variable (to anything) so we will skip
#           setups for various MPI flavors (mpich2/impi/...) below.
if ($TARGET =~ hpe-*) then
   if (  $?CRAY_MPICH_VERSION ) then
      set GMS_MPI_LIB=HPE-Cray-MPI
   else if ( $?MPT_VERSION ) then
      set GMS_MPI_LIB=mpt
      set GMS_MPI_PATH=$MPI_ROOT
   else if ( $?I_MPI_ROOT ) then
      set GMS_MPI_LIB=impi
      set GMS_MPI_PATH=$I_MPI_ROOT
      endif
   endif
endif
if ($TARGET == cray-xt) set GMS_MPI_LIB=Cray-XT-MPI
if ($TARGET == cray-xc) set GMS_MPI_LIB=Cray-XC-MPI
#
#   This is the end of the user selectable "numbered" options!
#
#
# ------------------------------------------------------------------------- #
# Troubleshooting -- If you should run into any errors while compiling,
# check the following lists of common failures.
#
# 1) socklen_t is not defined.  Uncomment the following line.
#    set SOCKLEN_T = "-Dsocklen_t=int"
#
# 2) turn on debugging output.  set DEBUG_LEVEL to the level of debugging.
#    0 ==> Debugging (e.g. arg checking) compiled in, but no extra output.
#          Note that 0 selects more debugging than the normal compilation.
#    1 ==> Minimum debugging output.
#    5 ==> Standard debugging output.
#   10 ==> Significantly more output.
#   15 ==> Even more ... probably best to avoid this one.
#    One can also call DDI_DEBUG(level) to set the desired level
#    around a troublesome piece of code.
#    Uncomment the following line to enable more argument checking:
#
#    set DEBUG_LEVEL=0
#
# 3) If you want debugging output from only a particular CPU.
#    set DEBUG_CPU=RANK
#    set DEBUG_CPU=0
#
# 4) To make all point to point send/recv messages fully synchronous,
#    add the flag "-DSOC_SYNC" somewhere below, if TCP/IP, of course.
#
# ------------------------------------------------------------------------- #

# ------------------------------------------------------------------------- #
# Here is an index of the options that can be defined to the C compiler
#
# -DDDI_SOC  -- use sockets; requires ddikick if mpi is not used.
# -DDDI_MPI  -- use MPI; must be kicked off with MPI kickoff;
#               assumes 1:1 mapping of compute processes and data servers
# -DDDI_LAPI -- use LAPI for distributed data operations; kickoff using
#               the poe command; NO data servers
# -DUSE_SYSV -- make use of shared-memory, choosing this requires
#    one of the suboptions -DUSE_SHMEM_SYSV or -DUSE_SHMEM_POSIX
#
# -DMACHINE              -- defines the target architecture
# -D_32_BIT              -- specifies a 32-bit machine (64-bit default)
# -DINT_SIZE=(int,long)  -- defines the size of a FORTRAN integer
# -D_UNDERSCORES=(0,1,2) -- number of underscores on a FORTRAN object
# -DF77_UPPERCASE        -- use UPPERCASE names for FORTRAN objects
#
# ------------------------------------------------------------------------- #


echo "       Building the Distributed Data Interface library"
echo "           started at `date`"
echo " "
echo "Compiling for machine type $TARGET,"
echo "using communication model $COMM,"
echo "System V shared memory option set $SYSV,"
echo "with maxima of $MAXCPUS processors/node and $MAXNODES nodes."
echo " "
echo "This compilation should produce the DDI library libddi.a"
#
if ($COMM == sockets) echo "This compilation should also produce the kick-off program ddikick.x"
#
echo " "
#
if (($GMS_DDI_COMM == mpi) || ($GMS_DDI_COMM == mixed)) then
   switch ($GMS_MPI_LIB)
      case impi:
         if ($GMS_TARGET == win64) then
            set MPI_INCLUDE_PATH = "$GMS_MPI_PATH/include"
         else
            if (-f $GMS_MPI_PATH/include/mpi.h ) set MPI_INCLUDE_PATH = "$GMS_MPI_PATH/include"
            if (-f $GMS_MPI_PATH/include64/mpi.h ) set MPI_INCLUDE_PATH = "$GMS_MPI_PATH/include64"
            if (-f $GMS_MPI_PATH/intel64/include/mpi.h ) set MPI_INCLUDE_PATH = "$GMS_MPI_PATH/intel64/include"
            if ($GMS_PHI == knc) set MPI_INCLUDE_PATH = "$GMS_MPI_PATH/mic/include"
         endif
         breaksw
      case fj-mpi:
      case hpcx:
         goto skip_mpi_setup
         breaksw
      case mpich:
      case mpich2:
      case mpt:
      case mvapich:
      case mvapich2:
      case myrinet:
      case openmpi:
         if ($?MPI_INCLUDE) then
            set MPI_INCLUDE_PATH = "$MPI_INCLUDE"
         else
            set MPI_INCLUDE_PATH = "$GMS_MPI_PATH/include"
         endif
         breaksw
         #            MicroSoft MPI uses a compiler flag, set below, not a pathname
      case msmpi:
         if(($GMS_FORTRAN == pgf77) || ($GMS_FORTRAN == pgfortran) || ($GMS_FORTRAN == ifort)) set MPI_INCLUDE_PATH = " "
         goto skip_mpi_setup
         breaksw
         #            big machines will find their mpi.f, don't check it.
      case IBM-BlueGene-MPI:
      case HPE-Cray-MPI:
         goto skip_mpi_setup
         breaksw
      case Cray-XT-MPI:
         goto skip_mpi_setup
         breaksw
      case Cray-XC-MPI:
         goto skip_mpi_setup
         breaksw
      case spectrum:
         set MPI_INCLUDE_PATH = "$GMS_MPI_PATH/include"
         breaksw
      default:
         echo "unknown MPI software requested" >> /dev/stderr
         exit 4
         breaksw
   endsw
   #         Double check that a valid path to MPI was provided.
   #         Checking omitted in comp/lked as probably compddi will be run 1st.
   if (-e "$MPI_INCLUDE_PATH/mpi.h") then
      echo "The MPI-1 software library to be used is $GMS_MPI_LIB,"
      echo "with the include file 'mpi.h' at $MPI_INCLUDE_PATH"
   else
      echo "Something is wrong with your MPI definitions in 'config'," >> /dev/stderr
      echo "since there is no such file $MPI_INCLUDE_PATH/mpi.h" >> /dev/stderr
      exit 4
   endif
endif
#
skip_mpi_setup:

echo " "

# ------------- set options forced by the choices made above ------------- #

# --------------------- #
# Communication Options #
# --------------------- #
if($COMM == sockets) then
   set DDI_COMM = '-DDDI_SOC'
     if($SOC_AFF == yes) set DDI_COMM = '-DDDI_SOC -DSOC_AFF'
endif

if($COMM == mixed) then
   set DDI_COMM = '-DDDI_MPI -DDDI_SOC'
endif

if($COMM == mpi) then
   set DDI_COMM = '-DDDI_MPI'
endif

if($COMM == armci) then
   set DDI_COMM = "-DDDI_MPI -DDDI_ARMCI"
   set DDI_COMM = "$DDI_COMM -DDDI_ARMCI_IMPLICIT_NBPUT"
   set DDI_COMM = "$DDI_COMM -DDDI_ARMCI_IMPLICIT_NBGET"
   set DDI_COMM = "$DDI_COMM -DDDI_ARMCI_IMPLICIT_NBACC"
   set DDI_COMM = "$DDI_COMM -DDDI_ARMCI_IMPLICIT_WAIT"
endif


# ---------------------- #
# System V Shared-Memory #
# ---------------------- #
if($SYSV == true) then
   set DDI_COMM = "$DDI_COMM -DUSE_SYSV"
   if ($SHMTYPE == sysv)  set DDI_COMM="$DDI_COMM -DUSE_SHMEM_SYSV"
   if ($SHMTYPE == posix) set DDI_COMM="$DDI_COMM -DUSE_SHMEM_POSIX"
endif


# --------------------- #
# Troubleshooting Flags #
# --------------------- #
set DDI_OPTS = "$DDI_COMM"
set DDI_OPTS = "$DDI_OPTS -DMAX_SMP_PROCS=$MAXCPUS -DMAX_NODES=$MAXNODES"

# 1) socklen_t
if($?SOCKLEN_T == 0) set SOCKLEN_T = " "
set DDI_OPTS = "$DDI_OPTS $SOCKLEN_T"

# 2) debugging options
if($?DEBUG_LEVEL == 0) then
   set DEBUG_LEVEL = ""
else
   set DEBUG_LEVEL = "-DDDI_DEBUG=$DEBUG_LEVEL"
endif
set DDI_OPTS = "$DDI_OPTS $DEBUG_LEVEL"

# 3) debugging a particular cpu
if($?DEBUG_CPU == 0) then
   set DEBUG_CPU = ""
else
   set DEBUG_CPU = "-DDDI_DEBUG_CPU=$DEBUG_CPU"
endif
set DDI_OPTS = "$DDI_OPTS $DEBUG_CPU"


# ------------- start of machine specific option selection -------------- #

unset CFLAGS

# -------- #
# HPE Cray #
# -------- #
if ($TARGET =~ hpe-*) then
   #
   set CC='cc'
   #
   if ( $?CRAY_FTN_VERSION ) then
      set GMS_HPE_CRAY_COMP = cray
   endif
   #
   if ( $?INTEL_VERSION ) then
      set GMS_HPE_CRAY_COMP = intel
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "INTEL") set CC = icc
      endif
   endif
   #
   if ( $?GNU_VERSION ) then
      set GMS_HPE_CRAY_COMP = gnu
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "GNU") set CC = gcc
      endif
   endif
   #
   if ( $?NVIDIA_VERSION ) then
      set GMS_HPE_CRAY_COMP = nvidia
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "NVIDIA") set CC = nvcc
      endif
   endif
   #
   if ( $?AOCC_VERSION ) then
      set GMS_HPE_CRAY_COMP = aocc
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "AOCC") set CC = clang
      endif
   endif
   #
   if ( $?CRAY_AMD_COMPILER_VERSION ) then
      set GMS_HPE_CRAY_COMP = rocm
      if ( $?PE_ENV ) then
         if ( $PE_ENV != "AMD") set FC = amdflang
      endif
   endif
   #
   if  ( $?CRAY_CPU_TARGET ) then
      set GMS_HPE_CRAY_ARCH = $CRAY_CPU_TARGET
   else
      set GMS_HPE_CRAY_ARCH = $CPU
   endif
   #
   if ( $?CRAY_MPICH_VERSION ) then
      if (( $GMS_HPC_SYSTEM_TARGET == crusher   ) || \
          ( $GMS_HPC_SYSTEM_TARGET == frontier  ) || \
          ( $GMS_HPC_SYSTEM_TARGET == perlmutter) || \
          ( $GMS_HPC_SYSTEM_TARGET == polaris   )) then
         set CFLAGS="-DLINUX64 -DUSE_MPI_BARRIER -I$CRAY_MPICH_PREFIX/include"
      else
         set CFLAGS="-DLINUX64 -DCRAY_MPI -DUSE_MPI_BARRIER -I$CRAY_MPICH_PREFIX/include"
      endif
   else if ( $?MPT_VERSION ) then
      set CFLAGS="-DLINUX64 -DUSE_MPI_BARRIER -I$MPI_ROOT/include"
   else if ( $?I_MPI_ROOT ) then
      set CFLAGS="-DLINUX64 -DUSE_MPI_BARRIER -I$I_MPI_ROOT/include"
   endif
   #
   switch ($GMS_HPE_CRAY_COMP)
      case cray:
         set CFLAGS="$CFLAGS -O3"
         breaksw
      case intel:
         set CFLAGS="$CFLAGS -O3 -m64 -fstrict-aliasing"
         breaksw
      case gnu:
         set CFLAGS="$CFLAGS -O3 -m64 -fstrict-aliasing"
         set CLIBS="-lpthread"
         if ($SHMTYPE == posix) set CLIBS="$CLIBS -lrt"
         set CFLAGS = "$CFLAGS -Dgetarg_=_gfortran_getarg_i4"
         set CFLAGS = "$CFLAGS -Diargc_=_gfortran_iargc"
         breaksw
      case nvidia:
         set CFLAGS="$CFLAGS -O3 -m64 -mcmodel=medium -fstrict-aliasing"
         set CLIBS=""
         set CLIBS="-lpthread"
         if ($SHMTYPE == posix) set CLIBS="$CLIBS -lrt"
        #Commented out because it may not be needed under NVIDIA HPC SDK
        #set CFLAGS = "$CFLAGS -Dgetarg_=_gfortran_getarg_i4"
        #set CFLAGS = "$CFLAGS -Diargc_=_gfortran_iargc"
         breaksw
      case aocc:
         set CFLAGS=""
         echo "Need to define CFLAGS"
         exit 1
         breaksw
      case rocm:
         set CFLAGS="$CFLAGS -O3 -m64 -fstrict-aliasing"
         breaksw
      default:
         echo "Invalid HPE Cray compiler"
         exit 1
         breaksw
   endsw

   switch ($GMS_HPE_CRAY_ARCH)
      case x86-rome:
      case x86_64:
      default:
         set CFLAGS = "$CFLAGS"
         breaksw
   endsw

   set AR_FLAGS     = 'cr'
   set RANLIB_FLAGS = ' '
   set F77_OPTS = "-DINT_SIZE=long -D_UNDERSCORES=1"
endif

# ------- #
# Cray XT #
# ------- #
if ($TARGET == cray-xt) then
   echo "---------------"
   echo "Loaded modules:"
   echo "---------------"
   module list

   #         two choices not included in the configuration step
   #         These must match 'comp' and 'lked', and loaded software modules.
   #         valid choices: gnu (Ran's choice), intel, cray, pgi
   set GMS_XT_COMP = 'pgi'
   #            valid choices: i7, barcelona, shanghai, or blank
   set GMS_XT_ARCH = ' '

   set CC='cc'
   set CFLAGS='-DLINUX64 -DCRAY_MPI -DUSE_MPI_BARRIER -I./'

   switch ($GMS_XT_COMP)
      case pgi:
         set CFLAGS="$CFLAGS -O3 -mcmodel=medium -fastsse -Mfpmisalign"
         breaksw
      case gnu:
         set CFLAGS="$CFLAGS -O3 -m64 -fstrict-aliasing"
         breaksw
      case intel:
      case cray:
      default:
         set CFLAGS="$CFLAGS -O3"
         breaksw
   endsw

   switch ($GMS_XT_ARCH)
      case barcelona:
         set CFLAGS = "$CFLAGS -tp barcelona-64 -Mfpmisalign"
         breaksw
      case shanghai:
         set CFLAGS = "$CFLAGS -tp shanghai-64 -Mfpmisalign"
         breaksw
      case i7:
         set CFLAGS = "$CFLAGS -tp x64"
         breaksw
      default:
         breaksw
   endsw

   set AR_FLAGS     = 'cr'
   set RANLIB_FLAGS = ' '
   set F77_OPTS = "-DINT_SIZE=long -D_UNDERSCORES=1"
endif

# ------- #
# Cray XC #
# ------- #
if ($TARGET == cray-xc) then
   echo "---------------"
   echo "Loaded modules:"
   echo "---------------"
   module list

   # ftn from intall.info
   set FORTRAN=$GMS_FORTRAN
   #
   #        Itan2 does not allow -m32/-m64 flags, it's all 64 bit pointers.
   #
   set ARCH='-m64'
   if (`uname -p` == ia64) set ARCH=''

   set GMS_XC_COMP = 'intel'

   set CC='cc'
   set CFLAGS = "-dynamic -mcmodel=large -DLINUX $ARCH -O3 -fstrict-aliasing -I./"
   set CLIBS  = "-lpthread"

   if ( $?GMS_HPC_SYSTEM_TARGET ) then
      if ( $GMS_HPC_SYSTEM_TARGET == cori ) then
         if ($?I_MPI_ROOT) then
            set CC='mpiicc'
            set CFLAGS="-mcmodel=large -DLINUX $ARCH -O3 -fstrict-aliasing"
         endif
      endif
      #
      if ( $GMS_HPC_SYSTEM_TARGET == onyx ) then
