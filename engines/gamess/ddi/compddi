# ---------------------------------------------- #
# Linux for 64 bit PCs (both AMD and Intel chips #
# ---------------------------------------------- #
#       note that DDI is in C, so FORTRAN below is not used except for a
#       test program.  The compiler name also lets this script choose the
#       the number of trailing underscores needed, but more importantly,
#       deals with gfortran's use of names prefixed by _gfortran_ in its
#       library of FORTRAN callable routines.
#
#       Note that in all cases, we use the gcc compiler from GNU for
#       the compilation of DDI, even if a non-GNU FORTRAN is used.
#
if($TARGET == linux64) then

   set FORTRAN=$GMS_FORTRAN   # might be gfortran, ifort, pgf77
   #
   #        Itan2 does not allow -m32/-m64 flags, it's all 64 bit pointers.
   #
   set ARCH='-m64'
   if (`uname -p` == ia64) set ARCH=''
   if (`uname -p` == aarch64) set ARCH='-mcpu=native'

   set CC = 'gcc'
   set CFLAGS = "-DLINUX $ARCH -O3 -fstrict-aliasing -I./"

   if ($GMS_DDI_COMM == mpi) then
      if ($GMS_MPI_LIB == hpcx) then
         set CC = 'mpicc'
         set CFLAGS = "-DLINUX $ARCH -O3 -fstrict-aliasing"
      endif
   endif

   set CLIBS  = "-lpthread"

   if ($GMS_PHI == knc) then
      set CC='icc'
      set CFLAGS="$CFLAGS -mmic"
   endif

   if ($SHMTYPE == posix) set CLIBS="$CLIBS -lrt"

   switch ($FORTRAN)
      case acfl:
         set CC = 'armclang'
         set NumUS=1
         set CFLAGS = "$CFLAGS -Wno-int-conversion"
         set FORT_FLAGS = "-O2 $ARCH -i8 -std=legacy"
         breaksw
      case armflang:
         set CC = 'armclang'
        #set CFLAGS = "$CFLAGS -Dgetarg_=getarg"
         set CFLAGS = "$CFLAGS -Wno-int-conversion"
         set NumUS=1
         set FORT_FLAGS = "-O2 $ARCH -i8 -std=legacy"
         breaksw
      case aocc:
         set CC = 'clang'
         set CFLAGS = "$CFLAGS -Wno-error=int-conversion"
         set NumUS=1
         set FORT_FLAGS = "-O2 $ARCH -fdefault-integer-8"
         breaksw
      case gfortran:
         set CFLAGS = "$CFLAGS -Dgetarg_=_gfortran_getarg_i4"
         set CFLAGS = "$CFLAGS -Diargc_=_gfortran_iargc"
         set NumUS=1
         set FORT_FLAGS = "-O2 $ARCH -fdefault-integer-8 -std=legacy"
         breaksw
      case nvfortran:
      case pgfortran:
      case pgf77:
         set NumUS=1
         if ( `uname` == Darwin ) then
            set FORT_FLAGS = "-O2 $ARCH -i8"
         else
            if ( $GMS_ARCH == aarch64) then
               set CFLAGS = "$CFLAGS -mcmodel=large"
               set FORT_FLAGS = "-O2 $ARCH -i8 -mcmodel=large"
            else
               set CFLAGS = "$CFLAGS -mcmodel=medium"
               set FORT_FLAGS = "-O2 $ARCH -i8 -mcmodel=medium"
            endif
         endif
         breaksw
      case oneapi-ifx:
         set CC = 'icx'
         set FORTRAN = 'ifx'
         set NumUS=1
         set FORT_FLAGS = "-O2 -i8"
         if ($GMS_VM2 == true) set EXTRA_FLAGS = "-DDDI_NO_DATA_SERVERS"
         breaksw
      case oneapi-ifort:
      case ifort:
         set NumUS=1
         set FORT_FLAGS = "-O2 -i8"
         if ($GMS_PHI == knc) set FORT_FLAGS="$FORT_FLAGS -mmic"
         #
         if ($GMS_VM2 == true) set EXTRA_FLAGS = "-DDDI_NO_DATA_SERVERS"
         breaksw
      case flang-new:
         set CC = 'clang'
         set NumUS=1
         set FORT_FLAGS = "-O2 $ARCH -fdefault-integer-8"
         breaksw
      default:
         echo "Please spell your linux64 FORTRAN compiler correctly."
         exit 4
   endsw

   set F77_OPTS = "-DINT_SIZE=long -D_UNDERSCORES=$NumUS"

   set AR_FLAGS     = 'cr'
   set RANLIB_FLAGS = ' '

   if ((`uname` == Darwin) && ($FORTRAN =~ oneapi-*)) then # Intel tools can't find system libraries for macOS
      set FORT_LIBS = "-L/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib"
   else
      set FORT_LIBS = ' '
   endif
endif


